@page "/Account/AccessDenied"
@using Microsoft.AspNetCore.Authorization
@using HawalaExchange.Web.Services
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>دسترسی غیرمجاز</PageTitle>

<div class="container py-5">
    <div class="modern-card mx-auto text-center p-5" style="max-width:620px">
        <i class="bi bi-shield-lock text-danger" style="font-size:3rem"></i>
        <h3 class="mt-3">اجازه دسترسی ندارید</h3>
        <p class="text-muted">این بخش برای نقش یا نوع حساب شما مجاز نیست.</p>
        <AuthorizeView Context="accessDeniedUser">
            <a class="btn-modern btn-primary-modern d-inline-flex" href="@LoginDestination.Home(accessDeniedUser.User.HasClaim("platform_user", "true"), NavigationManager.BaseUri)">بازگشت به صفحه اصلی</a>
        </AuthorizeView>
    </div>
</div>
