@page "/Account/ForgotPassword"
@layout BlankLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using HawalaExchange.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<link rel="stylesheet" href="css/login.css" />

<PageTitle>فراموشی رمز عبور | سیستم مدیریت صرافی</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <!-- ========================================= -->
        <!-- RIGHT SIDE - BRANDING WITH ZOOM LOGO -->
        <!-- ========================================= -->
        <div class="login-right-brand">
            <!-- Background Logo with Zoom In/Out Animation -->
            <div class="bg-logo">
                <img src="images/logo.png" alt="لوگو پس‌زمینه" />
            </div>

            <div class="brand-content">
                <div class="brand-logo-wrapper">
                    <div class="brand-logo">
                        <img src="images/logo.png" alt="لوگو" />
                    </div>
                    <div>
                        <h1 class="brand-title-main">سیستم مدیریت صرافی</h1>
                        <p class="brand-subtitle">حواله‌ها و تراکنش‌های ارزی</p>
                    </div>
                </div>

                <h2 class="brand-tagline">
                    مدیریت پول خود را<br />
                    <span>هر جایی که هستید</span>
                </h2>
                <p class="brand-description">
                    شما می‌توانید پول خود را در هر مکان و زمانی مدیریت کنید
                </p>

                <div class="brand-features">
                    <div class="feature-item">
                        <i class="bi bi-shield-check"></i>
                        <span>امنیت بالا</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-clock-history"></i>
                        <span>مدیریت لحظه‌ای</span>
                    </div>
                    <div class="feature-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>گزارش‌گیری پیشرفته</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- LEFT SIDE - FORM WITH BACKGROUND LOGO -->
        <!-- ========================================= -->
        <div class="login-left-form">
            <!-- Background Logo with Zoom In/Out Animation -->
            <div class="bg-logo-left">
                <img src="images/logo.png" alt="لوگو پس‌زمینه" />
            </div>

            <div class="login-form-container">
                <!-- Modern Form Box -->
                <div class="form-box">
                    <!-- Form Header -->
                    <div class="form-header">
                        <div class="welcome-text">بازیابی رمز عبور</div>
                        <h2 class="form-title">فراموشی رمز عبور</h2>
                        <p class="form-subtitle">ایمیل خود را وارد کنید تا لینک بازیابی برای شما ارسال شود.</p>
                    </div>

                    <!-- Success Message -->
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success-custom" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@successMessage</span>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => { errorMessage = null; StateHasChanged(); }">&times;</button>
                        </div>
                    }

                    <!-- Forgot Password Form -->
                    <EditForm EditContext="editContext" OnValidSubmit="OnValidSubmitAsync" method="post">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" role="alert" />

                        <!-- Email -->
                        <div class="form-group">
                            <label class="form-label">آدرس ایمیل</label>
                            <div class="input-group-modern @(editContext.GetValidationMessages(() => Input.Email).Any() ? "error" : "")">
                                <span class="input-icon">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>
                                <InputText @bind-Value="Input.Email"
                                           id="Input.Email"
                                           class="form-control-modern"
                                           autocomplete="email"
                                           aria-required="true"
                                           placeholder="ایمیل خود را وارد کنید" />
                            </div>
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-signin" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>در حال ارسال...</span>
                            }
                            else
                            {
                                <span>ارسال لینک بازیابی</span>
                                <i class="bi bi-send-fill"></i>
                            }
                        </button>
                    </EditForm>

                    <!-- Back to Login Link -->
                    <div class="back-link">
                        <span>رمز عبور خود را به یاد آوردید؟</span>
                        <a href="/Account/Login">وارد شوید</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private string? successMessage;
    private EditContext editContext = default!;
    private bool isLoading = false;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new EditContext(Input);
    }

    private async Task OnValidSubmitAsync()
    {
        if (isLoading) return;

        if (!editContext.Validate())
        {
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
            {
                // Don't reveal that the user does not exist or is not confirmed
                successMessage = "اگر ایمیل شما در سیستم ثبت شده باشد، لینک بازیابی رمز عبور برای شما ارسال خواهد شد.";
                StateHasChanged();
                return;
            }

            // Generate password reset token
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });

            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

            successMessage = "لینک بازیابی رمز عبور با موفقیت به ایمیل شما ارسال شد.";
            Input.Email = "";
            editContext = new EditContext(Input);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ارسال ایمیل: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "آدرس ایمیل الزامی است")]
        [EmailAddress(ErrorMessage = "لطفاً یک آدرس ایمیل معتبر وارد کنید")]
        public string Email { get; set; } = "";
    }
}