@page "/Account/ForgotPassword"
@layout BlankLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using HawalaExchange.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>فراموشی رمز عبور | سیستم مدیریت صرافی</PageTitle>

<style>
    /* =========================================
               LOGIN CONTAINER
            ========================================= */
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-color, #f4f7fb);
        padding: 20px;
        font-family: 'Segoe UI', 'Vazir', Tahoma, sans-serif;
        direction: rtl;
    }

    .login-wrapper {
        display: flex;
        width: 100%;
        max-width: 1100px;
        min-height: 620px;
        background: var(--card-bg, #ffffff);
        border-radius: var(--radius-xl, 24px);
        box-shadow: var(--shadow-lg, 0 20px 60px rgba(0,0,0,0.08));
        overflow: hidden;
        transition: var(--transition, all 0.3s ease);
    }

    /* =========================================
               سمت چپ - بخش برندینگ
            ========================================= */
    .login-left {
        flex: 1.1;
        background: linear-gradient(145deg, #0a1628 0%, #162d50 50%, #1a3d6b 100%);
        padding: 45px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -30%;
            width: 80%;
            height: 80%;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 50%;
            pointer-events: none;
        }

        .login-left::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -20%;
            width: 60%;
            height: 60%;
            background: rgba(255, 255, 255, 0.015);
            border-radius: 50%;
            pointer-events: none;
        }

    .login-brand {
        position: relative;
        z-index: 1;
    }

    .brand-icon {
        width: 64px;
        height: 64px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #fff;
        margin-bottom: 18px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .brand-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
        color: #ffffff;
    }

    .brand-subtitle {
        font-size: 0.9rem;
        opacity: 0.6;
        font-weight: 300;
        max-width: 280px;
        line-height: 1.5;
    }

    .login-features {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin: 28px 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(255, 255, 255, 0.05);
        padding: 10px 16px;
        border-radius: var(--radius-sm, 8px);
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: var(--transition, all 0.3s ease);
    }

        .feature-item:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(-4px);
        }

    .feature-icon {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .feature-text h6 {
        font-size: 0.8rem;
        font-weight: 600;
        margin: 0 0 2px 0;
    }

    .feature-text p {
        font-size: 0.65rem;
        opacity: 0.6;
        margin: 0;
    }

    .login-footer {
        position: relative;
        z-index: 1;
        font-size: 0.65rem;
        opacity: 0.4;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 14px;
    }

    /* =========================================
               سمت راست - بخش فرم
            ========================================= */
    .login-right {
        flex: 1;
        padding: 40px 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--card-bg, #ffffff);
    }

    .login-form-container {
        width: 100%;
        max-width: 380px;
    }

    .form-header {
        margin-bottom: 28px;
    }

    .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--primary-light, #e6f0ff);
        color: var(--primary-color, #0061f2);
        padding: 3px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .form-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-color, #1d2939);
        margin: 0 0 4px 0;
    }

    .form-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted, #667085);
        margin: 0;
    }

    /* =========================================
               فیلدهای فرم
            ========================================= */
    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 500;
        font-size: 0.8rem;
        color: var(--text-color, #1d2939);
        margin-bottom: 4px;
    }

        .form-label i {
            color: var(--text-muted, #667085);
            margin-right: 6px;
        }

    .input-group-modern {
        display: flex;
        align-items: center;
        background: #f7f8fc;
        border: 2px solid #e8ecf2;
        border-radius: var(--radius-sm, 10px);
        transition: var(--transition, all 0.3s ease);
        overflow: hidden;
    }

        .input-group-modern:focus-within {
            border-color: var(--primary-color, #0061f2);
            box-shadow: 0 0 0 3px rgba(0, 97, 242, 0.06);
            background: #fff;
        }

        .input-group-modern.error {
            border-color: #dc3545;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.06);
        }

    .input-icon {
        padding: 0 12px;
        color: var(--text-muted, #667085);
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .form-control-modern {
        flex: 1;
        border: none;
        padding: 11px 12px 11px 0;
        font-size: 0.85rem;
        background: transparent;
        outline: none;
        color: var(--text-color, #1d2939);
        width: 100%;
    }

        .form-control-modern::placeholder {
            color: #b0baca;
            font-size: 0.8rem;
        }

    /* =========================================
               دکمه ارسال
            ========================================= */
    .btn-signin {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: var(--radius-sm, 10px);
        background: var(--primary-gradient, linear-gradient(135deg, #0061f2, #0050c8));
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition, all 0.3s ease);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-signin:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0, 97, 242, 0.3);
        }

        .btn-signin:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-signin:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .btn-signin i {
            font-size: 1rem;
        }

    /* =========================================
               لینک بازگشت به ورود
            ========================================= */
    .back-link {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted, #667085);
        margin-top: 16px;
    }

        .back-link a {
            color: var(--primary-color, #0061f2);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition, all 0.3s ease);
        }

            .back-link a:hover {
                text-decoration: underline;
                color: var(--primary-dark, #0050c8);
            }

    /* =========================================
               هشدار موفقیت
            ========================================= */
    .alert-success-custom {
        padding: 12px 16px;
        border-radius: var(--radius-sm, 10px);
        background: #d1fae5;
        color: #065f46;
        border-right: 4px solid #10b981;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
    }

        .alert-success-custom i {
            font-size: 1.2rem;
            color: #10b981;
        }

    /* =========================================
               RESPONSIVE
            ========================================= */
    @@media (max-width: 992px) {
        .login-wrapper {
            flex-direction: column;
            max-width: 480px;
            min-height: auto;
        }

        .login-left {
            padding: 30px 30px 25px;
            min-height: 240px;
            justify-content: center;
        }

        .login-features {
            display: none;
        }

        .login-footer {
            margin-top: 10px;
        }

        .login-right {
            padding: 28px 30px 35px;
        }

        .brand-title {
            font-size: 1.4rem;
        }

        .brand-icon {
            width: 50px;
            height: 50px;
            font-size: 24px;
        }

        .form-title {
            font-size: 1.4rem;
        }
    }

    @@media (max-width: 576px) {
        .login-page {
            padding: 10px;
        }

        .login-left {
            padding: 20px 18px;
            min-height: 180px;
        }

        .login-right {
            padding: 18px 16px 25px;
        }

        .login-form-container {
            max-width: 100%;
        }

        .form-title {
            font-size: 1.2rem;
        }

        .form-subtitle {
            font-size: 0.75rem;
        }

        .login-wrapper {
            border-radius: var(--radius-md, 16px);
        }

        .btn-signin {
            padding: 11px;
            font-size: 0.85rem;
        }

        .form-control-modern {
            padding: 9px 10px 9px 0;
            font-size: 0.8rem;
        }

        .input-icon {
            padding: 0 10px;
            font-size: 0.85rem;
        }

        .brand-title {
            font-size: 1.2rem;
        }

        .brand-subtitle {
            font-size: 0.75rem;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            font-size: 20px;
            margin-bottom: 12px;
        }

        .back-link {
            font-size: 0.75rem;
        }
    }
</style>

<div class="login-page">
    <div class="login-wrapper">
        <!-- ========================================= -->
        <!-- سمت چپ - بخش تصویر و برندینگ -->
        <!-- ========================================= -->
        <div class="login-left">
            <div class="login-brand">
                <div class="brand-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <h1 class="brand-title">سیستم مدیریت صرافی</h1>
                <p class="brand-subtitle">سیستم مدیریت حواله‌ها و تراکنش‌های ارزی</p>
            </div>

            <div class="login-features">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="feature-text">
                        <h6>امنیت بالا</h6>
                        <p>سیستم با بالاترین سطح امنیت</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="feature-text">
                        <h6>مدیریت لحظه‌ای</h6>
                        <p>پیگیری و مدیریت تراکنش‌ها در زمان واقعی</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="feature-text">
                        <h6>گزارش‌گیری پیشرفته</h6>
                        <p>گزارش‌های دقیق و تحلیلی از عملکرد</p>
                    </div>
                </div>
            </div>

            <div class="login-footer">
                <span>© 2026 سیستم مدیریت صرافی - تمامی حقوق محفوظ است</span>
            </div>
        </div>

        <!-- ========================================= -->
        <!-- سمت راست - بخش فرم -->
        <!-- ========================================= -->
        <div class="login-right">
            <div class="login-form-container">
                <!-- هدر فرم -->
                <div class="form-header">
                    <div class="welcome-badge">
                        <i class="bi bi-key"></i>
                        بازیابی رمز عبور
                    </div>
                    <h2 class="form-title">فراموشی رمز عبور</h2>
                    <p class="form-subtitle">ایمیل خود را وارد کنید تا لینک بازیابی برای شما ارسال شود.</p>
                </div>

                <!-- پیام موفقیت -->
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert-success-custom" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@successMessage</span>
                    </div>
                }

                <!-- پیام خطا -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px; font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="() => { errorMessage = null; StateHasChanged(); }"></button>
                    </div>
                }

                <!-- فرم فراموشی رمز عبور -->
                <EditForm EditContext="editContext" OnValidSubmit="OnValidSubmitAsync" method="post">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <!-- ایمیل -->
                    <div class="form-group">
                        <label class="form-label" for="Input.Email">
                            <i class="bi bi-envelope"></i> آدرس ایمیل
                        </label>
                        <div class="input-group-modern @(editContext.GetValidationMessages(() => Input.Email).Any() ? "error" : "")">
                            <span class="input-icon"><i class="bi bi-envelope"></i></span>
                            <InputText @bind-Value="Input.Email"
                                       id="Input.Email"
                                       class="form-control-modern"
                                       autocomplete="email"
                                       aria-required="true"
                                       placeholder="ایمیل خود را وارد کنید" />
                        </div>
                        <ValidationMessage For="() => Input.Email" class="text-danger" />
                    </div>

                    <!-- دکمه ارسال -->
                    <button type="submit" class="btn-signin" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>در حال ارسال...</span>
                        }
                        else
                        {
                            <span>ارسال لینک بازیابی <i class="bi bi-send"></i></span>
                        }
                    </button>
                </EditForm>

                <!-- لینک بازگشت به صفحه ورود -->
                <div class="back-link">
                    <span>رمز عبور خود را به یاد آوردید؟</span>
                    <a href="/Account/Login">وارد شوید</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;
    private string? successMessage;
    private EditContext editContext = default!;
    private bool isLoading = false;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new EditContext(Input);
    }

    private async Task OnValidSubmitAsync()
    {
        if (isLoading) return;

        if (!editContext.Validate())
        {
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
            {
                // Don't reveal that the user does not exist or is not confirmed
                successMessage = "اگر ایمیل شما در سیستم ثبت شده باشد، لینک بازیابی رمز عبور برای شما ارسال خواهد شد.";
                StateHasChanged();
                return;
            }

            // Generate password reset token
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });

            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

            successMessage = "لینک بازیابی رمز عبور با موفقیت به ایمیل شما ارسال شد.";
            Input.Email = "";
            editContext = new EditContext(Input);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ارسال ایمیل: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "آدرس ایمیل الزامی است")]
        [EmailAddress(ErrorMessage = "لطفاً یک آدرس ایمیل معتبر وارد کنید")]
        public string Email { get; set; } = "";
    }
}