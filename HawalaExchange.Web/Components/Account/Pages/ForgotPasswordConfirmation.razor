@page "/Account/ForgotPasswordConfirmation"
@layout BlankLayout

<PageTitle>بررسی ایمیل | سیستم مدیریت صرافی</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <RecoveryBrandPanel />
        <div class="login-left-form">
            <div class="bg-logo-left"><img src="images/logo.png" alt="لوگو پس‌زمینه" /></div>
            <div class="login-form-container">
                <div class="form-box text-center">
                    <div class="recovery-status-icon success"><i class="bi bi-envelope-check-fill"></i></div>
                    <div class="form-header">
                        <h2 class="form-title">ایمیل خود را بررسی کنید</h2>
                        <p class="form-subtitle mt-3">
                            اگر این ایمیل در سیستم ثبت شده باشد، لینک تعیین رمز جدید برای آن ارسال شده است.
                        </p>
                    </div>
                    <div class="alert alert-success-custom text-start" role="status">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>اگر پیام را ندیدید، پوشهٔ Spam یا Junk را نیز بررسی کنید.</span>
                    </div>
                    <a class="btn-signin text-decoration-none" href="/Account/Login">
                        <span>بازگشت به صفحهٔ ورود</span><i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
