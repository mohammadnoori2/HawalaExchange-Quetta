@page "/Account/InvalidPasswordReset"
@layout BlankLayout

<PageTitle>لینک نامعتبر | سیستم مدیریت صرافی</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <RecoveryBrandPanel />
        <div class="login-left-form">
            <div class="bg-logo-left"><img src="images/logo.png" alt="لوگو پس‌زمینه" /></div>
            <div class="login-form-container">
                <div class="form-box text-center">
                    <div class="recovery-status-icon danger"><i class="bi bi-link-45deg"></i></div>
                    <div class="form-header">
                        <h2 class="form-title">لینک بازیابی معتبر نیست</h2>
                        <p class="form-subtitle mt-3">این لینک ناقص، منقضی یا قبلاً استفاده شده است. لطفاً لینک جدید درخواست کنید.</p>
                    </div>
                    <a class="btn-signin text-decoration-none" href="/Account/ForgotPassword">
                        <span>درخواست لینک جدید</span><i class="bi bi-arrow-clockwise"></i>
                    </a>
                    <div class="back-link"><a href="/Account/Login">بازگشت به صفحهٔ ورود</a></div>
                </div>
            </div>
        </div>
    </div>
</div>
