@page "/Account/ResetPasswordConfirmation"
@layout BlankLayout

<PageTitle>تغییر رمز موفق | سیستم مدیریت صرافی</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <RecoveryBrandPanel />
        <div class="login-left-form">
            <div class="bg-logo-left"><img src="images/logo.png" alt="لوگو پس‌زمینه" /></div>
            <div class="login-form-container">
                <div class="form-box text-center">
                    <div class="recovery-status-icon success"><i class="bi bi-check-circle-fill"></i></div>
                    <div class="form-header">
                        <h2 class="form-title">رمز عبور تغییر کرد</h2>
                        <p class="form-subtitle mt-3">اکنون می‌توانید با رمز عبور جدید وارد سیستم شوید.</p>
                    </div>
                    <a class="btn-signin text-decoration-none" href="/Account/Login">
                        <span>ورود به سیستم</span><i class="bi bi-box-arrow-in-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
