@inherits LayoutComponentBase

<div class="page app-shell">
    <input type="checkbox" id="mobile-nav-toggle" class="mobile-menu-toggle" aria-label="نمایش منوی اصلی" aria-controls="app-sidebar" aria-expanded="false" />
    <label for="mobile-nav-toggle" class="mobile-menu-button" aria-label="باز یا بسته کردن منوی اصلی">
        <i class="bi bi-list mobile-menu-open-icon" aria-hidden="true"></i>
        <i class="bi bi-x-lg mobile-menu-close-icon" aria-hidden="true"></i>
    </label>
    <label for="mobile-nav-toggle" class="mobile-menu-backdrop" aria-label="بستن منوی اصلی"></label>

    <aside id="app-sidebar" class="sidebar" aria-label="منوی اصلی">
        <NavMenu />
    </aside>

    <main class="app-main">
        <ImpersonationBanner />
        <SubscriptionStatusBanner />
        <AuthorizeView Policy="TenantAccess">
            <PermissionView Permission="CashAlerts.View"><CashBalanceAlertBanner /></PermissionView>
        </AuthorizeView>
        <article class="content app-content px-0">
            <PermissionPageGuard>@Body</PermissionPageGuard>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
