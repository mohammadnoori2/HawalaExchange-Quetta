            <!-- اطلاعات کاربر جاری با منوی dropdown در انتهای منو -->
            <AuthorizeView>
                <Authorized>
                    <div class="user-dropdown-container">
                        <button type="button" class="user-info-card" @onclick="ToggleUserMenu" aria-expanded="@userMenuOpen">
                            <div class="user-avatar">
                                @{
                                    var userName = context.User.FindFirst("local_user_name")?.Value ?? "کاربر";
                                    var initial = userName.Length > 0 ? userName.Substring(0, Math.Min(2, userName.Length)).ToUpper() : "??";
                                    @initial
                                }
                            </div>
                            <div class="user-details">
                                <span class="user-name">@context.User.FindFirst("local_user_name")?.Value</span>
                                <span class="user-role">
                                    @{
                                        var roles = context.User.FindAll(ClaimTypes.Role).Select(c => c.Value);
                                        @string.Join(", ", roles)
                                    }
                                </span>
                            </div>
                            <span class="dropdown-arrow bi bi-chevron-down @(userMenuOpen ? "open" : string.Empty)"></span>
