</div>
@code {
    private string? currentUrl;
    private bool isAuthenticated;
    private bool userMenuOpen;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            isAuthenticated = authState.User?.Identity?.IsAuthenticated ?? false;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        userMenuOpen = false;
        StateHasChanged();
    }

    private bool IsSectionActive(string section) => section switch
    {
        "hawala" => IsCurrentPath("hawala-transactions", "hawala-receive", "hawala-pending"),
        "accounting" => IsCurrentPath("ledger", "transfers", "capital-investment", "expenses", "deposit-withdraw"),
        "settings" => IsCurrentPath("branches", "payment-locations", "users", "currencies", "exchangerates", "account-limits", "cash-balance-alerts", "company-settings"),
        "reports" => IsCurrentPath("reports"),
        _ => false
    };

    private bool IsCurrentPath(params string[] paths) =>
        paths.Any(path => currentUrl?.StartsWith(path, StringComparison.OrdinalIgnoreCase) == true);

    private void ToggleUserMenu()
    {
        userMenuOpen = !userMenuOpen;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
