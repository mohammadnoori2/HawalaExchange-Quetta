@code {
    private string? currentUrl;
    private string currentUserDisplayName = "کاربر";
    private string? currentUserEmail;
    private string? currentUserProfileImageUrl;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            currentUserDisplayName = authState.User.FindFirst("local_user_name")?.Value ?? "کاربر";
            currentUserEmail = authState.User.FindFirst(ClaimTypes.Email)?.Value;

            var userIdValue = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (long.TryParse(userIdValue, out var userId))
            {
                await using var context = await DbContextFactory.CreateDbContextAsync();
                var user = await context.Users
                    .IgnoreQueryFilters()
                    .AsNoTracking()
                    .FirstOrDefaultAsync(x => x.Id == userId);
                if (user is not null)
                {
                    currentUserDisplayName = string.IsNullOrWhiteSpace(user.FullName)
                        ? user.LocalUserName
                        : user.FullName;
                    currentUserEmail = user.Email;
                    currentUserProfileImageUrl = string.IsNullOrWhiteSpace(user.ProfileImagePath)
                        ? null
                        : FileService.GetFileUrl(user.ProfileImagePath);
                }
            }
        }
    }

    private static string GetInitials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0)
            return "ک";
        return string.Concat(words.Take(2).Select(x => x[0]));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private bool IsSectionActive(string section) => section switch
    {
        "hawala" => IsCurrentPath("hawala-transactions", "hawala-receive", "hawala-pending"),
        "accounting" => IsCurrentPath("ledger", "capital-investment", "expenses"),
        "settings" => IsCurrentPath("branches", "payment-locations", "users", "currencies", "exchangerates", "account-limits", "cash-balance-alerts", "company-settings"),
        "reports" => IsCurrentPath("reports"),
        _ => false
    };

    private bool IsCurrentPath(params string[] paths) =>
        paths.Any(path => currentUrl?.StartsWith(path, StringComparison.OrdinalIgnoreCase) == true);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
