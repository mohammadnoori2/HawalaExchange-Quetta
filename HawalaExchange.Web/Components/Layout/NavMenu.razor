</div>

<script>
    // تغییر وضعیت منو (برای کلیک)
    function toggleSubMenu(subMenuId, element) {
        var subMenu = document.getElementById(subMenuId);
        if (subMenu) {
            if (subMenu.classList.contains('open')) {
                subMenu.classList.remove('open');
                var toggleIcon = element.querySelector('.toggle-icon');
                if (toggleIcon) {
                    toggleIcon.classList.remove('open');
                }
                element.classList.remove('active');
            } else {
                subMenu.classList.add('open');
                var toggleIcon = element.querySelector('.toggle-icon');
                if (toggleIcon) {
                    toggleIcon.classList.add('open');
                }
                element.classList.add('active');
            }
        }
    }

    // تغییر وضعیت منوی کاربر
    function toggleUserDropdown() {
        var dropdown = document.getElementById('userDropdownMenu');
        var arrow = document.querySelector('.dropdown-arrow');
        if (dropdown) {
            if (dropdown.classList.contains('open')) {
                dropdown.classList.remove('open');
                if (arrow) arrow.classList.remove('open');
            } else {
                dropdown.classList.add('open');
                if (arrow) arrow.classList.add('open');
                // بستن منوی قبلی باز شده
                var allSubMenus = document.querySelectorAll('.sub-menu');
                allSubMenus.forEach(function(menu) {
                    if (menu.id !== 'userDropdownMenu') {
                        menu.classList.remove('open');
                    }
                });
            }
        }
    }

    // بستن منو با کلیک خارج از آن
    document.addEventListener('click', function(event) {
        var container = document.querySelector('.user-dropdown-container');
        if (container && !container.contains(event.target)) {
            var dropdown = document.getElementById('userDropdownMenu');
            var arrow = document.querySelector('.dropdown-arrow');
            if (dropdown && dropdown.classList.contains('open')) {
                dropdown.classList.remove('open');
                if (arrow) arrow.classList.remove('open');
            }
        }
    });
</script>

