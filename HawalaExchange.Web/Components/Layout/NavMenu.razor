            <!-- اطلاعات کاربر جاری با منوی dropdown در انتهای منو -->
            <AuthorizeView>
                <Authorized>
                    <div class="user-dropdown-container">
                        <div class="user-info-card" onclick="toggleUserDropdown()">
                            <div class="user-avatar">
                                @{
                                    var userName = context.User.Identity?.Name ?? "کاربر";
                                    var initial = userName.Length > 0 ? userName.Substring(0, Math.Min(2, userName.Length)).ToUpper() : "??";
                                    @initial
                                }
                            </div>
                            <div class="user-details">
                                <span class="user-name">@context.User.Identity?.Name</span>
                                <span class="user-role">
                                    @{
                                        var roles = context.User.FindAll(ClaimTypes.Role).Select(c => c.Value);
                                        @string.Join(", ", roles)
                                    }
                                </span>
                            </div>
                            <span class="dropdown-arrow bi bi-chevron-down"></span>
                        </div>

                        <!-- منوی dropdown کاربر -->
                        <div class="user-dropdown-menu" id="userDropdownMenu">
                            <div class="user-dropdown-header">
                                <div class="user-dropdown-avatar">
                                    @{
                                        var userName2 = context.User.Identity?.Name ?? "کاربر";
                                        var initial2 = userName2.Length > 0 ? userName2.Substring(0, Math.Min(2, userName2.Length)).ToUpper() : "??";
                                        @initial2
                                    }
                                </div>
                                <div class="user-dropdown-info">
                                    <span class="user-dropdown-name">@context.User.Identity?.Name</span>
                                    <span class="user-dropdown-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                                </div>
                            </div>
