@page "/accounts"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject ILedgerService LedgerService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-fluid mt-4" dir="rtl">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #0061f2, #0050c8);">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h4 class="mb-0">
                    <i class="bi bi-wallet2 me-2"></i> مدیریت حساب‌ها
                </h4>
                <button class="btn btn-light btn-lg" @onclick="() => OpenCreateModal()">
                    <i class="bi bi-plus-circle"></i> حساب جدید
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- نوار جستجو -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="جستجوی حساب‌ها (کد، نام، مرجع)..."
                               @bind="searchTerm" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" @onclick="() => ClearSearch()" type="button">
                            <i class="bi bi-x-circle"></i> پاک کردن
                        </button>
                    </div>
                </div>
                <div class="col-md-4 text-start">
                    <span class="badge bg-info fs-6 p-2">
                        <i class="bi bi-list-ul"></i> تعداد: @filteredAccounts.Count
                    </span>
                </div>
            </div>

            <!-- جدول حساب‌ها -->
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">کد حساب</th>
                            <th scope="col">نام حساب</th>
                            <th scope="col">نوع حساب</th>
                            <th scope="col">مرجع</th>
                            <th scope="col">تاریخ ایجاد</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col" style="min-width: 180px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && accounts == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredAccounts.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block"></i>
                                    <span class="fs-5">هیچ حسابی یافت نشد</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = 1;
                            @foreach (var account in filteredAccounts)
                            {
                                <tr class="@(account.IsArchived ? "table-secondary" : "")">
                                    <td>@rowIndex</td>
                                    <td><strong>@account.AccountCode</strong></td>
                                    <td>@account.AccountName</td>
                                    <td>
                                        <span class="badge @GetAccountTypeBadge(account.AccountType) px-3 py-2">
                                            @GetAccountTypeName(account.AccountType)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(account.ReferenceType))
                                        {
                                            <small>
                                                <span class="badge bg-light text-dark">@GetReferenceTypeName(account.ReferenceType)</span>
                                                <span class="fw-bold">@account.ReferenceId</span>
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td dir="ltr" class="text-start">@account.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (account.IsArchived)
                                        {
                                            <span class="badge bg-secondary px-3 py-2">بایگانی شده</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">فعال</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- دکمه مشاهده حساب -->
                                            <button class="btn btn-outline-info" @onclick="() => ViewAccount(account.Id)" title="مشاهده حساب">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (!account.IsArchived)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(account.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => ShowArchiveConfirm(account.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => ShowUnarchiveConfirm(account.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش حساب -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش حساب" : "ایجاد حساب جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @successMessage
                        </div>
                    }

                    @if (!isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            کد حساب به‌صورت خودکار بر اساس نوع حساب تولید می‌شود.
                        </div>
                    }

                    <!-- سوئیچ فعال‌سازی موجودی اولیه (فقط در حالت ایجاد) -->
                    @if (!isEditMode)
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="HasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- بخش مشخصات حساب -->
                    @if (!currentAccount.HasInitialBalance || isEditMode)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-person"></i> نام حساب <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control @(string.IsNullOrEmpty(currentAccount.AccountName) ? "is-invalid" : "")"
                                       @bind="currentAccount.AccountName" placeholder="نام حساب را وارد کنید" />
                                <div class="invalid-feedback">نام حساب الزامی است</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-tag"></i> نوع حساب <span class="text-danger">*</span>
                                </label>
                                <select class="form-select @(string.IsNullOrEmpty(currentAccount.AccountType) ? "is-invalid" : "")"
                                        value="@currentAccount.AccountType"
                                        @onchange="(ChangeEventArgs e) => { currentAccount.AccountType = e.Value?.ToString() ?? string.Empty; OnAccountTypeChanged(); }">
                                    <option value="">انتخاب نوع</option>
                                    <option value="Cash">نقدی</option>
                                    <option value="Bank">بانکی</option>
                                    <option value="Customer">مشتری</option>
                                    <option value="Correspondent">نماینده</option>
                                    <option value="Income">درآمد</option>
                                    <option value="Expense">هزینه</option>
                                    <option value="Equity">سرمایه</option>
                                </select>
                                <div class="invalid-feedback">نوع حساب الزامی است</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-link"></i> نوع مرجع
                                </label>
                                <select class="form-select" @bind="currentAccount.ReferenceType">
                                    <option value="">بدون مرجع</option>
                                    <option value="Customer">مشتری</option>
                                    <option value="Correspondent">نماینده</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-hash"></i> شناسه مرجع
                                </label>
                                @if (IsReferenceTypeSelected())
                                {
                                    <select class="form-select" @bind="currentAccount.ReferenceId">
                                        <option value="">انتخاب @(currentAccount.ReferenceType == "Customer" ? "مشتری" : "نماینده")</option>
                                        @if (currentAccount.ReferenceType == "Customer")
                                        {
                                            @foreach (var customer in customers)
                                            {
                                                <option value="@customer.Id">@customer.FullName (@customer.CustomerCode)</option>
                                            }
                                        }
                                        else if (currentAccount.ReferenceType == "Correspondent")
                                        {
                                            @foreach (var correspondent in correspondents)
                                            {
                                                <option value="@correspondent.Id">@correspondent.Name (@correspondent.Code)</option>
                                            }
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="number" class="form-control" @bind="currentAccount.ReferenceId"
                                           placeholder="شناسه مرجع را وارد کنید" />
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle"></i>
                            مشخصات حساب در هنگام ثبت موجودی اولیه مخفی شده است. پس از ثبت موجودی‌ها، حساب ایجاد خواهد شد.
                        </div>
                    }

                    <!-- بخش ثبت موجودی اولیه -->
                    @if (!isEditMode && currentAccount.HasInitialBalance)
                    {
                        <div class="card mt-3 border-primary">
                            <div class="card-header bg-primary text-white">
                                <i class="bi bi-wallet2"></i> ثبت موجودی اولیه
                            </div>
                            <div class="card-body">
                                @if (initialBalances.Any())
                                {
                                    <div class="table-responsive mb-3">
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>واحد پولی</th>
                                                    <th>مقدار</th>
                                                    <th>نوع</th>
                                                    <th>توضیحات</th>
                                                    <th>عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in initialBalances)
                                                {
                                                    var currency = currencies.FirstOrDefault(c => c.Id == item.CurrencyId);
                                                    <tr>
                                                        <td>@(currency?.Name ?? "نامشخص") (@(currency?.Code ?? ""))</td>
                                                        <td>@item.Amount.ToString("N2")</td>
                                                        <td>
                                                            <span class="badge @(item.Direction == "Debit" ? "bg-danger" : "bg-success")">
                                                                @(item.Direction == "Debit" ? "بدهکار" : "بستانکار")
                                                            </span>
                                                        </td>
                                                        <td>@item.Description</td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveInitialBalance(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <td colspan="2"><strong>جمع کل</strong></td>
                                                    <td colspan="3">
                                                        @{
                                                            var totalDebit = initialBalances.Where(b => b.Direction == "Debit").Sum(b => b.Amount);
                                                            var totalCredit = initialBalances.Where(b => b.Direction == "Credit").Sum(b => b.Amount);
                                                        }
                                                        <span class="text-danger">بدهکار: @totalDebit.ToString("N2")</span>
                                                        |
                                                        <span class="text-success">بستانکار: @totalCredit.ToString("N2")</span>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">هیچ موجودی اولیه‌ای ثبت نشده است.</div>
                                }

                                <hr />

                                <!-- فرم افزودن موجودی جدید -->
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">واحد پولی <span class="text-danger">*</span></label>
                                        <select class="form-select @(newInitialBalance.CurrencyId == 0 ? "is-invalid" : "")" @bind="newInitialBalance.CurrencyId">
                                            <option value="0">انتخاب کنید</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name (@currency.Code)</option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">واحد پولی الزامی است</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">مقدار <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control @(newInitialBalance.Amount <= 0 ? "is-invalid" : "")"
                                               @bind="newInitialBalance.Amount" step="0.01" min="0" />
                                        <div class="invalid-feedback">مقدار باید بزرگ‌تر از صفر باشد</div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">نوع <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.Direction">
                                            <option value="Debit">بدهکار</option>
                                            <option value="Credit">بستانکار</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold">توضیحات</label>
                                        <input type="text" class="form-control" @bind="newInitialBalance.Description" placeholder="اختیاری" />
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn btn-success w-100" @onclick="AddInitialBalance" disabled="@(!CanAddInitialBalance())">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info mt-2">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش حساب (کد: <strong>@currentAccount.AccountCode</strong>)</small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => SaveAccount()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال تأیید بایگانی/خروج از بایگانی -->
<!-- ============================================================ -->
@if (showConfirmModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- ✅ مودال نمایش حساب -->
<!-- ============================================================ -->
@if (showAccountModal && selectedAccount != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-wallet2 me-2"></i> حساب: @selectedAccount.AccountName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseAccountModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- اطلاعات خلاصه حساب -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">کد حساب</span>
                                <span class="info-value">@selectedAccount.AccountCode</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نام حساب</span>
                                <span class="info-value">@selectedAccount.AccountName</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نوع حساب</span>
                                <span class="info-value">@GetAccountTypeName(selectedAccount.AccountType)</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    @if (selectedAccount.IsArchived)
                                    {
                                        <span class="badge bg-secondary">بایگانی شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">فعال</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نوع مرجع</span>
                                <span class="info-value">@(string.IsNullOrEmpty(selectedAccount.ReferenceType) ? "—" : GetReferenceTypeName(selectedAccount.ReferenceType))</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">شناسه مرجع</span>
                                <span class="info-value">@(selectedAccount.ReferenceId?.ToString() ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">سری کد</span>
                                <span class="info-value">
                                    @{
                                        var prefix = selectedAccount.AccountCode.Length > 0 ? selectedAccount.AccountCode[0].ToString() : "";
                                        var seriesName = prefix switch
                                        {
                                            "1" => "نقدی/بانک/دارایی",
                                            "2" => "کارگزاران/نمایندگان",
                                            "3" => "درآمد",
                                            "4" => "هزینه",
                                            "5" => "سرمایه",
                                            "6" => "مشتریان",
                                            _ => "سایر"
                                        };
                                    }
                                    <span class="badge bg-primary">سری @prefix</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">تاریخ ایجاد</span>
                                <span class="info-value" dir="ltr">@selectedAccount.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ جمع‌بندی موجودی با نمایش بدهکار/بستانکار -->
                    <div class="card mb-4">
                        <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1a7a3a); color: white; border-radius: 8px 8px 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-calculator me-2"></i> جمع‌بندی موجودی به تفکیک ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isBalanceLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (balanceSummary.Any())
                            {
                               
                                    

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>واحد پولی</th>
                                                <th>وضعیت</th>
                                                <th>مقدار</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceSummary)
                                            {
                                                var status = item.Balance > 0 ? "طلبکار" : (item.Balance < 0 ? "بدهکار" : "تسویه");
                                                var badgeClass = item.Balance > 0 ? "bg-success" : (item.Balance < 0 ? "bg-danger" : "bg-secondary");
                                                <tr>
                                                    <td><strong>@item.CurrencyCode</strong></td>
                                                    <td>
                                                        <span class="badge @badgeClass px-3 py-2">@status</span>
                                                    </td>
                                                    <td class="fw-bold fs-5 @(item.Balance != 0 ? (item.Balance > 0 ? "text-sucess" : "text-danger") : "text-muted")">
                                                        @Math.Abs(item.Balance).ToString("N2")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-inbox fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این حساب یافت نشد.</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- لیست تراکنش‌های دفتر کل -->
                    <div class="card">
                        <div class="card-header" style="background: linear-gradient(135deg, #6c757d, #5a6268); color: white; border-radius: 8px 8px 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i> لیست تراکنش‌های دفتر کل
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isLedgerLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (ledgerEntries.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>تاریخ</th>
                                                <th>شماره تراکنش</th>
                                                <th>نوع تراکنش</th>
                                                <th>واحد پولی</th>
                                                <th>طلبکار</th>
                                                <th>بدهکار</th>
                                                <th>توضیحات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in ledgerEntries)
                                            {
                                                <tr>
                                                    <td>@entry.Id</td>
                                                    <td dir="ltr">@entry.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                                    <td>@entry.TransactionNo</td>
                                                    <td>
                                                        <span class="badge @GetTransactionTypeBadge(entry.TransactionType)">
                                                            @GetTransactionTypeName(entry.TransactionType)
                                                        </span>
                                                    </td>
                                                    <td><span class="badge bg-info">@entry.CurrencyCode</span></td>
                                                    <td class="text-success fw-bold">@(entry.TalabKar > 0 ? entry.TalabKar.ToString("N2") : "-")</td>
                                                    <td class="text-danger fw-bold">@(entry.BadehKar > 0 ? entry.BadehKar.ToString("N2") : "-")</td>
                                                    <td>@entry.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-journal fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این حساب ثبت نشده است.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseAccountModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌های اصلی =====
    private List<AccountDto> accounts = new();
    private List<AccountDto> filteredAccounts = new();
    private List<CustomerDto> customers = new();
    private List<CorrespondentDto> correspondents = new();
    private List<CurrencyDto> currencies = new();

    // ===== جستجو =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchAccounts();
            }
        }
    }

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showAccountModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;

    // ===== اطلاعات عملیات بایگانی =====
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;

    // ===== پیام‌ها و خطاها =====
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // ===== حساب انتخاب‌شده برای جزئیات =====
    private AccountDto? selectedAccount = null;

    // ===== متغیرهای مربوط به مودال نمایش حساب =====
    private bool isBalanceLoading = false;
    private bool isLedgerLoading = false;
    private List<BalanceDto> balanceSummary = new();
    private List<LedgerEntryDto> ledgerEntries = new();

    // ===== DTO جاری =====
    private CreateAccountDto currentAccount = new();

    // ===== موجودی‌های اولیه (موقت) =====
    private List<InitialBalanceDto> initialBalances = new();
    private InitialBalanceDto newInitialBalance = new();
    private bool _hasInitialBalance;

    private bool HasInitialBalance
    {
        get => _hasInitialBalance;
        set
        {
            if (_hasInitialBalance != value)
            {
                _hasInitialBalance = value;
                currentAccount.HasInitialBalance = value;
                ToggleInitialBalanceSection();
            }
        }
    }

    // ========== متدهای بارگذاری داده ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadCustomersAndCorrespondents();
        await LoadCurrencies();
    }

    private async Task LoadAccounts()
    {
        try
        {
            isLoading = true;
            var result = await AccountService.GetAllAsync();
            accounts = result.ToList();
            filteredAccounts = accounts;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCustomersAndCorrespondents()
    {
        try
        {
            customers = (await CustomerService.GetAllAsync()).ToList();
            correspondents = (await CorrespondentService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری مشتریان/نمایندگان: {ex.Message}");
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    // ========== متدهای جستجو ==========

    private void SearchAccounts()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredAccounts = accounts;
        }
        else
        {
            var term = _searchTerm.Trim();
            filteredAccounts = accounts.Where(a =>
                a.AccountCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.AccountName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (a.ReferenceType != null && a.ReferenceType.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (a.ReferenceId.HasValue && a.ReferenceId.Value.ToString().Contains(term))
            ).ToList();
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredAccounts = accounts;
        StateHasChanged();
    }

    // ========== متدهای مربوط به موجودی اولیه ==========

    private bool CanAddInitialBalance()
    {
        return newInitialBalance.CurrencyId > 0 && newInitialBalance.Amount > 0;
    }

    private void AddInitialBalance()
    {
        if (!CanAddInitialBalance()) return;

        if (initialBalances.Any(b => b.CurrencyId == newInitialBalance.CurrencyId))
        {
            validationErrors.Add("این واحد پولی قبلاً ثبت شده است.");
            StateHasChanged();
            return;
        }

        initialBalances.Add(new InitialBalanceDto
        {
            CurrencyId = newInitialBalance.CurrencyId,
            Amount = newInitialBalance.Amount,
            Direction = newInitialBalance.Direction,
            Description = newInitialBalance.Description
        });

        newInitialBalance = new InitialBalanceDto();
        StateHasChanged();
    }

    private void RemoveInitialBalance(InitialBalanceDto item)
    {
        initialBalances.Remove(item);
        StateHasChanged();
    }

    private void ToggleInitialBalanceSection()
    {
        if (!currentAccount.HasInitialBalance)
        {
            initialBalances.Clear();
        }
        StateHasChanged();
    }

    // ========== متدهای مربوط به نوع حساب و مرجع ==========

    private bool IsReferenceTypeSelected()
    {
        return currentAccount.ReferenceType == "Customer" || currentAccount.ReferenceType == "Correspondent";
    }

    private async Task OnAccountTypeChanged()
    {
        if (!isEditMode && !string.IsNullOrEmpty(currentAccount.AccountType))
        {
            if (currentAccount.AccountType == "Customer")
                currentAccount.ReferenceType = "Customer";
            else if (currentAccount.AccountType == "Correspondent")
                currentAccount.ReferenceType = "Correspondent";
            else
                currentAccount.ReferenceType = null;

            currentAccount.ReferenceId = null;
            await GetSuggestedCode();
        }
        StateHasChanged();
    }

    private async Task GetSuggestedCode()
    {
        try
        {
            if (!string.IsNullOrEmpty(currentAccount.AccountType))
            {
                var suggestedCode = await AccountService.GetNextAccountCodeAsync(currentAccount.AccountType);
                currentAccount.AccountCode = suggestedCode;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در دریافت کد پیشنهادی: {ex.Message}");
        }
    }

    // ========== متدهای باز و بسته کردن مودال‌ها ==========

    private async Task OpenCreateModal()
    {
        currentAccount = new CreateAccountDto();
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        initialBalances.Clear();
        newInitialBalance = new InitialBalanceDto();
        HasInitialBalance = false;

        await LoadCurrencies();
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var account = await AccountService.GetByIdAsync(id);
            if (account != null)
            {
                currentAccount = new CreateAccountDto
                {
                    AccountCode = account.AccountCode,
                    AccountName = account.AccountName,
                    AccountType = account.AccountType,
                    ReferenceType = account.ReferenceType,
                    ReferenceId = account.ReferenceId,
                    HasInitialBalance = false,
                    InitialBalances = null
                };
                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void CloseAccountModal()
    {
        showAccountModal = false;
        selectedAccount = null;
        balanceSummary.Clear();
        ledgerEntries.Clear();
        validationErrors.Clear();
        StateHasChanged();
    }

    // ========== متد ذخیره‌سازی ==========

    private async Task SaveAccount()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentAccount.AccountName))
            validationErrors.Add("نام حساب الزامی است");
        if (string.IsNullOrWhiteSpace(currentAccount.AccountType))
            validationErrors.Add("نوع حساب الزامی است");

        if (!string.IsNullOrEmpty(currentAccount.ReferenceType) && !currentAccount.ReferenceId.HasValue)
            validationErrors.Add($"لطفاً یک {GetReferenceTypeName(currentAccount.ReferenceType)} انتخاب کنید");

        if (currentAccount.HasInitialBalance && !initialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateAccountDto
                {
                    AccountName = currentAccount.AccountName,
                    ReferenceType = currentAccount.ReferenceType,
                    ReferenceId = currentAccount.ReferenceId
                };
                await AccountService.UpdateAsync(editId, updateRequest);
                successMessage = "حساب با موفقیت ویرایش شد";
            }
            else
            {
                if (currentAccount.HasInitialBalance)
                {
                    currentAccount.InitialBalances = initialBalances.ToList();
                }

                await AccountService.CreateAsync(currentAccount);
                successMessage = "حساب با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadAccounts();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای بایگانی ==========

    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await AccountService.ArchiveAsync(confirmId);
                successMessage = "حساب با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await AccountService.UnarchiveAsync(confirmId);
                successMessage = "حساب با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== ✅ متد مشاهده حساب ==========

    private async Task ViewAccount(long accountId)
    {
        try
        {
            balanceSummary.Clear();
            ledgerEntries.Clear();
            validationErrors.Clear();
            isBalanceLoading = true;
            isLedgerLoading = true;

            selectedAccount = await AccountService.GetByIdAsync(accountId);
            if (selectedAccount == null)
            {
                validationErrors.Add("حساب مورد نظر یافت نشد.");
                isBalanceLoading = false;
                isLedgerLoading = false;
                StateHasChanged();
                return;
            }

            showAccountModal = true;
            StateHasChanged();

            await LoadAccountData(selectedAccount.Id);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات حساب: {ex.Message}");
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAccountData(long accountId)
    {
        try
        {
            isBalanceLoading = true;
            isLedgerLoading = true;
            StateHasChanged();

            var balanceResult = await LedgerService.GetAccountBalancesAsync(accountId);
            balanceSummary = balanceResult.ToList();

            var ledgerResult = await LedgerService.GetEntriesByAccountAsync(accountId);
            ledgerEntries = ledgerResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های حساب: {ex.Message}");
        }
        finally
        {
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

    // ========== توابع کمکی ==========

    private string GetAccountTypeBadge(string type)
    {
        return type?.ToLower() switch
        {
            "cash" => "bg-info",
            "bank" => "bg-primary",
            "customer" => "bg-success",
            "correspondent" => "bg-warning text-dark",
            "income" => "bg-success",
            "expense" => "bg-danger",
            "equity" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    private string GetAccountTypeName(string type)
    {
        return type?.ToLower() switch
        {
            "cash" => "نقدی",
            "bank" => "بانکی",
            "customer" => "مشتری",
            "correspondent" => "نماینده",
            "income" => "درآمد",
            "expense" => "هزینه",
            "equity" => "سرمایه",
            _ => type ?? "نامشخص"
        };
    }

    private string GetReferenceTypeName(string type)
    {
        return type?.ToLower() switch
        {
            "customer" => "مشتری",
            "correspondent" => "نماینده",
            _ => type ?? "نامشخص"
        };
    }

    private string GetTransactionTypeBadge(string type)
    {
        return type?.ToLower() switch
        {
            "exchange" => "bg-primary",
            "hawalasend" => "bg-info",
            "hawalareceive" => "bg-success",
            "transfer" => "bg-warning",
            "expense" => "bg-danger",
            "adjustment" => "bg-secondary",
            "openingbalance" => "bg-dark",
            _ => "bg-light"
        };
    }

    private string GetTransactionTypeName(string type)
    {
        return type?.ToLower() switch
        {
            "exchange" => "تبدیل ارز",
            "hawalasend" => "حواله فرستاده",
            "hawalareceive" => "حواله دریافت",
            "transfer" => "انتقال",
            "expense" => "هزینه",
            "adjustment" => "تعدیل",
            "openingbalance" => "موجودی اولیه",
            _ => type ?? "نامشخص"
        };
    }
}