@page "/accounts"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject ILedgerService LedgerService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-wallet2"></i>
                مدیریت حساب‌ها
                <span class="page-subtitle">لیست و جستجوی حساب‌ها</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> حساب جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <div class="stat-number">@accounts.Count</div>
                        <div class="stat-label">تعداد حساب‌ها</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@accounts.Count(a => !a.IsArchived)</div>
                        <div class="stat-label">حساب‌های فعال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning">
                        <i class="bi bi-archive"></i>
                    </div>
                    <div>
                        <div class="stat-number">@accounts.Count(a => a.IsArchived)</div>
                        <div class="stat-label">بایگانی شده</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div>
                        <div class="stat-number">@accounts.Select(a => a.AccountType).Distinct().Count()</div>
                        <div class="stat-label">انواع حساب</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجو (کد، نام، مرجع)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- فیلتر نوع حساب -->
                <div class="filter-selector">
                    <select class="form-select form-select-sm"
                            @bind="filterAccountType" @bind:event="oninput">
                        <option value="">همه انواع</option>
                        <option value="Cash">نقدی</option>
                        <option value="Bank">بانکی</option>
                        <option value="Customer">مشتری</option>
                        <option value="Correspondent">نماینده</option>
                        <option value="Income">درآمد</option>
                        <option value="Expense">هزینه</option>
                        <option value="Equity">سرمایه</option>
                    </select>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredAccounts.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "AccountCode" ? "active" : "")" @onclick="@(() => SortBy("AccountCode"))">
                                کد حساب
                                @if (sortColumn == "AccountCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AccountName" ? "active" : "")" @onclick="@(() => SortBy("AccountName"))">
                                نام حساب
                                @if (sortColumn == "AccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AccountType" ? "active" : "")" @onclick="@(() => SortBy("AccountType"))">
                                نوع حساب
                                @if (sortColumn == "AccountType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "ReferenceType" ? "active" : "")" @onclick="@(() => SortBy("ReferenceType"))">
                                مرجع
                                @if (sortColumn == "ReferenceType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CreatedAt" ? "active" : "")" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ ایجاد
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && accounts == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedAccounts.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ حسابی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن حساب جدید، دکمه "حساب جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredAccounts.Count : pageSize) + 1;
                            @foreach (var account in pagedAccounts)
                            {
                                <tr class="@(account.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-bold text-primary">@account.AccountCode</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@account.AccountName</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern @GetAccountTypeBadge(account.AccountType)">
                                            @GetAccountTypeName(account.AccountType)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(account.ReferenceType))
                                        {
                                            <small>
                                                <span class="badge-modern badge-secondary">@GetReferenceTypeName(account.ReferenceType)</span>
                                                <span class="fw-bold ms-1">@account.ReferenceId</span>
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td dir="ltr">@account.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (account.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-check-circle"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewAccount(account.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (!account.IsArchived)
                                            {
                                                <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(account.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="action-btn action-btn-archive" @onclick="() => ShowArchiveConfirm(account.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn action-btn-unarchive" @onclick="() => ShowUnarchiveConfirm(account.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedAccounts.Count</strong> از <strong>@filteredAccounts.Count</strong> حساب
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-check-circle"></i> فعال: @accounts.Count(a => !a.IsArchived)
                </span>
                <span class="badge-modern badge-secondary">
                    <i class="bi bi-archive"></i> بایگانی: @accounts.Count(a => a.IsArchived)
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش حساب -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش حساب" : "ایجاد حساب جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- راهنما -->
                    @if (!isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            کد حساب به‌صورت خودکار بر اساس نوع حساب تولید می‌شود.
                        </div>
                    }

                    <!-- سوئیچ موجودی اولیه (فقط ایجاد) -->
                    @if (!isEditMode)
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="HasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- اطلاعات حساب -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-wallet2 me-2"></i> اطلاعات حساب
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (!currentAccount.HasInitialBalance || isEditMode)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-person text-muted me-1"></i> نام حساب <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control"
                                               @bind="currentAccount.AccountName" placeholder="نام حساب را وارد کنید" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-tag text-muted me-1"></i> نوع حساب <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-select"
                                                @bind="currentAccount.AccountType"
                                                @bind:after="OnAccountTypeChanged">
                                            <option value="">انتخاب نوع</option>
                                            <option value="Cash">نقدی</option>
                                            <option value="Bank">بانکی</option>
                                            <option value="Customer">مشتری</option>
                                            <option value="Correspondent">نماینده</option>
                                            <option value="Income">درآمد</option>
                                            <option value="Expense">هزینه</option>
                                            <option value="Equity">سرمایه</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-link text-muted me-1"></i> نوع مرجع
                                        </label>
                                        <select class="form-select" @bind="currentAccount.ReferenceType">
                                            <option value="">بدون مرجع</option>
                                            <option value="Customer">مشتری</option>
                                            <option value="Correspondent">نماینده</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-hash text-muted me-1"></i> شناسه مرجع
                                        </label>
                                        @if (IsReferenceTypeSelected())
                                        {
                                            <select class="form-select" @bind="currentAccount.ReferenceId">
                                                <option value="">انتخاب @(currentAccount.ReferenceType == "Customer" ? "مشتری" : "نماینده")</option>
                                                @if (currentAccount.ReferenceType == "Customer")
                                                {
                                                    @foreach (var customer in customers)
                                                    {
                                                        <option value="@customer.Id">@customer.FullName (@customer.CustomerCode)</option>
                                                    }
                                                }
                                                else if (currentAccount.ReferenceType == "Correspondent")
                                                {
                                                    @foreach (var correspondent in correspondents)
                                                    {
                                                        <option value="@correspondent.Id">@correspondent.Name (@correspondent.Code)</option>
                                                    }
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="number" class="form-control" @bind="currentAccount.ReferenceId"
                                                   placeholder="شناسه مرجع را وارد کنید" />
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-info-circle"></i>
                                    مشخصات حساب در هنگام ثبت موجودی اولیه مخفی شده است. پس از ثبت موجودی‌ها، حساب ایجاد خواهد شد.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- بخش ثبت موجودی اولیه -->
                    @if (!isEditMode && currentAccount.HasInitialBalance)
                    {
                        <div class="modern-card mb-4">
                            <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1a7a3a);">
                                <h6 class="text-white">
                                    <i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه
                                </h6>
                            </div>
                            <div class="card-body">
                                <!-- لیست موجودی‌های ثبت شده -->
                                @if (initialBalances.Any())
                                {
                                    <div class="table-scroll-wrapper mb-3">
                                        <table class="table-modern table-striped-modern">
                                            <thead>
                                                <tr>
                                                    <th>واحد پولی</th>
                                                    <th>مقدار</th>
                                                    <th>نوع</th>
                                                    <th>توضیحات</th>
                                                    <th style="min-width:50px;">عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in initialBalances)
                                                {
                                                    var currency = currencies.FirstOrDefault(c => c.Id == item.CurrencyId);
                                                    <tr>
                                                        <td>@(currency?.Name ?? "نامشخص") (@(currency?.Code ?? ""))</td>
                                                        <td>@item.Amount.ToString("N2")</td>
                                                        <td>
                                                            <span class="badge-modern @(item.Direction == "Debit" ? "badge-danger" : "badge-success")">
                                                                @(item.Direction == "Debit" ? "بدهکار" : "بستانکار")
                                                            </span>
                                                        </td>
                                                        <td>@item.Description</td>
                                                        <td>
                                                            <button class="action-btn action-btn-delete" @onclick="() => RemoveInitialBalance(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="2"><strong>جمع کل</strong></td>
                                                    <td colspan="3">
                                                        @{
                                                            var totalDebit = initialBalances.Where(b => b.Direction == "Debit").Sum(b => b.Amount);
                                                            var totalCredit = initialBalances.Where(b => b.Direction == "Credit").Sum(b => b.Amount);
                                                        }
                                                        <span class="text-danger">بدهکار: @totalDebit.ToString("N2")</span>
                                                        |
                                                        <span class="text-success">بستانکار: @totalCredit.ToString("N2")</span>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">هیچ موجودی اولیه‌ای ثبت نشده است.</div>
                                }

                                <hr />

                                <!-- فرم افزودن موجودی جدید -->
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">واحد پولی <span class="text-danger">*</span></label>
                                        <select class="form-select @(_isBalanceSubmitted && newInitialBalance.CurrencyId == 0 ? "is-invalid" : "")"
                                                @bind="newInitialBalance.CurrencyId">
                                            <option value="0">انتخاب کنید</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name (@currency.Code)</option>
                                            }
                                        </select>
                                        @if (_isBalanceSubmitted && newInitialBalance.CurrencyId == 0)
                                        {
                                            <div class="invalid-feedback">واحد پولی را انتخاب کنید</div>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">مقدار <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control @(_isBalanceSubmitted && newInitialBalance.Amount <= 0 ? "is-invalid" : "")"
                                               @bind="newInitialBalance.Amount" step="0.01" min="0" />
                                        @if (_isBalanceSubmitted && newInitialBalance.Amount <= 0)
                                        {
                                            <div class="invalid-feedback">مقدار باید بزرگ‌تر از صفر باشد</div>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">نوع <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.Direction">
                                            <option value="Debit">بدهکار</option>
                                            <option value="Credit">بستانکار</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">توضیحات</label>
                                        <input type="text" class="form-control" @bind="newInitialBalance.Description" placeholder="اختیاری" />
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn btn-success-modern btn-modern w-100" @onclick="AddInitialBalance" disabled="@(!CanAddInitialBalance())">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش حساب با کد: <strong>@currentAccount.AccountCode</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveAccount()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

