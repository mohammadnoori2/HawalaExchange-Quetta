@page "/accounts"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Application.Services
@using HawalaExchange.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Authorization
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject ILedgerService LedgerService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>مدیریت حساب‌ها</PageTitle>

<div class="page-wrapper accounts-page-compact">
    <AppPageHeader Title="مدیریت حساب‌ها"
                   Subtitle="لیست و جستجوی حساب‌ها"
                   Icon="bi-wallet2">
        <Stats>
            <PageHeaderStats AriaLabel="آمار حساب‌ها">
                <PageHeaderStat Label="مجموع" Value="@accounts.Count" Icon="bi-wallet2" />
                <PageHeaderStat Label="فعال" Value="@accounts.Count(a => !a.IsArchived)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="بایگانی" Value="@accounts.Count(a => a.IsArchived)" Icon="bi-archive" Tone="danger" />
                <PageHeaderStat Label="نوع حساب" Value="@accounts.Select(a => a.AccountType).Distinct().Count()" Icon="bi-collection" Tone="info" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <ArchiveViewToggle @bind-ShowArchived="showArchived"
                               ArchivedCount="@accounts.Count(a => a.IsArchived)"
                               @bind-ShowArchived:after="ArchiveViewChanged" />
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> حساب جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر حساب‌ها"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(filterAccountType))"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با کد، نام یا مرجع..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter"
                    aria-label="نوع حساب"
                    @bind="filterAccountType"
                    @bind:event="oninput">
                <option value="">همه انواع</option>
                <option value="Cash">نقدی</option>
                <option value="Bank">بانکی</option>
                <option value="Customer">مشتری</option>
                <option value="Correspondent">نماینده</option>
                <option value="Income">درآمد</option>
                <option value="Expense">هزینه</option>
                <option value="Equity">سرمایه</option>
            </select>
        </QuickFilters>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredAccounts.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern accounts-table-compact">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "AccountCode" ? "active" : "")" @onclick="@(() => SortBy("AccountCode"))">
                                کد حساب
                                @if (sortColumn == "AccountCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AccountName" ? "active" : "")" @onclick="@(() => SortBy("AccountName"))">
                                نام حساب
                                @if (sortColumn == "AccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AccountType" ? "active" : "")" @onclick="@(() => SortBy("AccountType"))">
                                نوع حساب
                                @if (sortColumn == "AccountType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "ReferenceType" ? "active" : "")" @onclick="@(() => SortBy("ReferenceType"))">
                                مرجع
                                @if (sortColumn == "ReferenceType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CreatedAt" ? "active" : "")" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ ایجاد
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && accounts == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedAccounts.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ حسابی یافت نشد</span>
                                        <p class="text-muted small">@(showArchived ? "هیچ حسابی در بایگانی وجود ندارد." : "برای افزودن حساب جدید، دکمه «حساب جدید» را انتخاب کنید.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredAccounts.Count : pageSize) + 1;
                            @foreach (var account in pagedAccounts)
                            {
                                <tr class="@(account.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-bold text-primary">@account.AccountCode</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@account.AccountName</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern @GetAccountTypeBadge(account.AccountType)">
                                            @GetAccountTypeName(account.AccountType)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(account.ReferenceType))
                                        {
                                            <small>
                                                <span class="badge-modern badge-secondary">@GetReferenceTypeName(account.ReferenceType)</span>
                                                <span class="fw-bold ms-1">@account.ReferenceId</span>
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td><AppDateTime Value="@account.CreatedAt" /></td>
                                    <td>
                                        @if (account.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-check-circle"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات حساب {account.AccountName}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ViewAccount(account.Id)">
                                                <i class="bi bi-eye text-primary"></i>
                                                مشاهده حساب
                                            </button>
                                            @if (account.IsArchived)
                                            {
                                                <div class="operation-menu-divider"></div>
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowUnarchiveConfirm(account.Id)">
                                                    <i class="bi bi-arrow-counterclockwise text-success"></i>
                                                    خروج از بایگانی
                                                </button>
                                            }
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedAccounts.Count</strong> از <strong>@filteredAccounts.Count</strong> حساب
                </span>

                <!-- صفحه‌بندی -->
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد حساب در هر صفحه" />
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش حساب -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش حساب" : "ایجاد حساب جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات حساب -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-wallet2 me-2"></i> اطلاعات حساب
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold d-flex align-items-center gap-1">
                                            <i class="bi bi-person text-muted"></i>
                                            <span class="d-inline-flex align-items-baseline flex-nowrap gap-1 text-nowrap">
                                                نام حساب <span class="text-danger d-inline-block flex-shrink-0">*</span>
                                            </span>
                                        </label>
                                        <input type="text" class="form-control"
                                               @bind="currentAccount.AccountName" placeholder="نام حساب را وارد کنید" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold d-flex align-items-center gap-1">
                                            <i class="bi bi-tag text-muted"></i>
                                            <span class="d-inline-flex align-items-baseline flex-nowrap gap-1 text-nowrap">
                                                نوع حساب <span class="text-danger d-inline-block flex-shrink-0">*</span>
                                            </span>
                                        </label>
                                        <select class="form-select"
                                                @bind="currentAccount.AccountType"
                                                @bind:after="OnAccountTypeChanged">
                                            <option value="">انتخاب نوع</option>
                                            <option value="Cash">نقدی</option>
                                            <option value="Bank">بانکی</option>
                                            <option value="Customer">مشتری</option>
                                            <option value="Correspondent">نماینده</option>
                                            <option value="Income">درآمد</option>
                                            <option value="Expense">هزینه</option>
                                            <option value="Equity">سرمایه</option>
                                        </select>
                                    </div>
                            </div>

                            <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-link text-muted me-1"></i> نوع مرجع
                                        </label>
                                        <select class="form-select" @bind="currentAccount.ReferenceType">
                                            <option value="">بدون مرجع</option>
                                            <option value="Customer">مشتری</option>
                                            <option value="Correspondent">نماینده</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-hash text-muted me-1"></i> شناسه مرجع
                                        </label>
                                        @if (IsReferenceTypeSelected())
                                        {
                                            <select class="form-select" @bind="currentAccount.ReferenceId">
                                                <option value="">انتخاب ...</option>
                                                @if (currentAccount.ReferenceType == "Customer")
                                                {
                                                    @foreach (var customer in AvailableCustomers)
                                                    {
                                                        <option value="@customer.Id">@customer.FullName (@customer.CustomerCode)</option>
                                                    }
                                                    @if (!AvailableCustomers.Any())
                                                    {
                                                        <option disabled>همه مشتریان فعال حساب دارند</option>
                                                    }
                                                }
                                                else if (currentAccount.ReferenceType == "Correspondent")
                                                {
                                                    @foreach (var correspondent in AvailableCorrespondents)
                                                    {
                                                        <option value="@correspondent.Id">@correspondent.Name (@correspondent.Code)</option>
                                                    }
                                                    @if (!AvailableCorrespondents.Any())
                                                    {
                                                        <option disabled>همه نمایندگی‌های فعال حساب دارند</option>
                                                    }
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="number" class="form-control" @bind="currentAccount.ReferenceId"
                                                   placeholder="شناسه مرجع را وارد کنید" />
                                        }
                                    </div>
                            </div>
                        </div>
                    </div>

                    <!-- سوئیچ موجودی اولیه (فقط ایجاد) -->
                    @if (!isEditMode)
                    {
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="custom-switch-inline">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="HasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle text-primary me-1"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- بخش ثبت موجودی اولیه -->
                    @if (!isEditMode && currentAccount.HasInitialBalance)
                    {
                        <div class="modern-card mb-4">
                            <div class="card-header">
                                <h6 class="text-primary">
                                    <i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="initial-balance-grid">
                                    @foreach (var item in initialBalances)
                                    {
                                        var itemCurrency = currencies.FirstOrDefault(c => c.Id == item.CurrencyId);
                                        var itemIsIncomplete = _isBalanceSubmitted && !IsEmptyInitialBalance(item) && !IsCompleteInitialBalance(item);
                                        <div class="initial-balance-item">
                                            <div class="initial-balance-controls @(itemIsIncomplete ? "initial-balance-invalid" : string.Empty)">
                                                <select class="initial-balance-currency" @bind="item.CurrencyId" aria-label="واحد پولی موجودی اولیه">
                                                    <option value="0">انتخاب ارز</option>
                                                    @foreach (var currency in currencies)
                                                    {
                                                        <option value="@currency.Id">@currency.Name</option>
                                                    }
                                                </select>

                                                <MoneyInput class="initial-balance-amount-input" @bind-Value="item.Amount" min="0" placeholder="مبلغ" />

                                                <select class="initial-balance-direction @(item.Direction == "Debit" ? "is-debit" : "is-credit")"
                                                        @bind="item.Direction" aria-label="نوع موجودی اولیه">
                                                    <option value="Debit">بدهکار</option>
                                                    <option value="Credit">طلبکار</option>
                                                </select>
                                            </div>
                                            @if (item.Amount > 0)
                                            {
                                                <small class="initial-balance-words">
                                                    @DariNumberToWords.ToWords(item.Amount) @(itemCurrency?.Name ?? string.Empty)
                                                </small>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="initial-balance-actions">
                                    <button type="button" class="initial-balance-icon-button initial-balance-delete"
                                            title="حذف آخرین ارز" aria-label="حذف آخرین ارز"
                                            disabled="@(initialBalances.Count == 0)"
                                            @onclick="RemoveLastInitialBalance">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <button type="button" class="initial-balance-icon-button initial-balance-add"
                                            title="افزودن ارز دیگر" aria-label="افزودن ارز دیگر"
                                            @onclick="AddInitialBalanceRow">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>

                                @if (_isBalanceSubmitted && initialBalances.Any(b => !IsEmptyInitialBalance(b) && !IsCompleteInitialBalance(b)))
                                {
                                    <small class="text-danger d-block mt-1">ارز و مبلغ بزرگ‌تر از صفر را کامل وارد کنید.</small>
                                }
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش حساب با کد: <strong>@currentAccount.AccountCode</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveAccount()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال تأیید بایگانی/خروج از بایگانی -->
<!-- ============================================================ -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- کامپوننت مودال جزییات حساب -->
<!-- ============================================================ -->
@code {
    // ===== لیست‌های اصلی =====
    private List<AccountDto> accounts = new();
    private List<AccountDto> filteredAccounts = new();
    private List<CustomerDto> customers = new();
    private List<CorrespondentDto> correspondents = new();

    private List<CurrencyDto> currencies = new();

    // ===== جستجو و فیلتر =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchAccounts();
            }
        }
    }

    private string _filterAccountType = string.Empty;
    private bool showArchived;
    private string filterAccountType
    {
        get => _filterAccountType;
        set
        {
            if (_filterAccountType != value)
            {
                _filterAccountType = value;
                SearchAccounts();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 20;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private List<AccountDto> pagedAccounts
    {
        get
        {
            // حساب صندوق اصلی همیشه اول، سپس سایر حساب‌های سیستمی و بعد حساب‌های وابسته.
            // مرتب‌سازی انتخابی کاربر فقط داخل هر گروه اعمال می‌شود.
            var prioritized = filteredAccounts.OrderBy(GetAccountDisplayPriority);
            List<AccountDto> sorted;
            switch (sortColumn)
            {
                case "AccountCode":
                    sorted = sortAscending ? prioritized.ThenBy(a => a.AccountCode).ToList() : prioritized.ThenByDescending(a => a.AccountCode).ToList();
                    break;
                case "AccountName":
                    sorted = sortAscending ? prioritized.ThenBy(a => a.AccountName).ToList() : prioritized.ThenByDescending(a => a.AccountName).ToList();
                    break;
                case "AccountType":
                    sorted = sortAscending ? prioritized.ThenBy(a => a.AccountType).ToList() : prioritized.ThenByDescending(a => a.AccountType).ToList();
                    break;
                case "ReferenceType":
                    sorted = sortAscending ? prioritized.ThenBy(a => a.ReferenceType).ToList() : prioritized.ThenByDescending(a => a.ReferenceType).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? prioritized.ThenBy(a => a.CreatedAt).ToList() : prioritized.ThenByDescending(a => a.CreatedAt).ToList();
                    break;
                default:
                    sorted = prioritized.ThenByDescending(a => a.CreatedAt).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredAccounts.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showAccountModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private bool returnToAccountDetailsAfterEdit = false;
    private bool returnToAccountDetailsAfterArchive = false;

    // ===== اطلاعات عملیات بایگانی =====
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;

    // ===== پیام‌ها و خطاها =====
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // ===== حساب انتخاب‌شده برای جزئیات =====
    private AccountDto? selectedAccount = null;

    // ===== DTO جاری =====
    private CreateAccountDto currentAccount = new();

    private IEnumerable<CustomerDto> AvailableCustomers => customers.Where(customer =>
        !accounts.Any(account =>
            account.ReferenceType == "Customer" &&
            account.ReferenceId == customer.Id &&
            (!isEditMode || account.Id != editId)));

    private IEnumerable<CorrespondentDto> AvailableCorrespondents => correspondents.Where(correspondent =>
        !accounts.Any(account =>
            account.ReferenceType == "Correspondent" &&
            account.ReferenceId == correspondent.Id &&
            (!isEditMode || account.Id != editId)));

    // ===== موجودی‌های اولیه (موقت) =====
    private List<InitialBalanceDto> initialBalances = new();
    private bool _hasInitialBalance = true;
    private bool _isBalanceSubmitted = false;

    private bool HasInitialBalance
    {
        get => _hasInitialBalance;
        set
        {
            if (_hasInitialBalance != value)
            {
                _hasInitialBalance = value;
                currentAccount.HasInitialBalance = value;
                if (!value)
                {
                    initialBalances.Clear();
                    _isBalanceSubmitted = false;
                }
                else if (initialBalances.Count == 0)
                {
                    initialBalances.Add(new InitialBalanceDto());
                }
            }
        }
    }

    // ========== متدهای بارگذاری داده ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadAccounts();

    }

    private async Task LoadLookupData()
    {
        try
        {
            customers = (await CustomerService.GetAllAsync()).Where(x => !x.IsArchived).ToList();
            correspondents = (await CorrespondentService.GetAllAsync()).Where(x => !x.IsArchived).ToList();

            var currencyResult = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = currencyResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            isLoading = true;
            var result = await AccountService.GetAllAsync();
            accounts = result.ToList();
            SearchAccounts();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای جستجو و فیلتر ==========

    private void SearchAccounts()
    {
        var query = accounts.Where(a => a.IsArchived == showArchived);

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(a =>
                a.AccountCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.AccountName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (a.ReferenceType != null && a.ReferenceType.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (a.ReferenceId.HasValue && a.ReferenceId.Value.ToString().Contains(term))
            );
        }

        if (!string.IsNullOrEmpty(_filterAccountType))
        {
            query = query.Where(a => a.AccountType == _filterAccountType);
        }

        filteredAccounts = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterAccountType = string.Empty;
        filteredAccounts = accounts.Where(a => a.IsArchived == showArchived).ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ArchiveViewChanged()
    {
        SearchAccounts();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ========== متدهای مربوط به موجودی اولیه ==========

    private static bool IsEmptyInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId <= 0 && item.Amount <= 0 && string.IsNullOrWhiteSpace(item.Description);
    }

    private static bool IsCompleteInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId > 0 && item.Amount > 0;
    }

    private void AddInitialBalanceRow()
    {
        _isBalanceSubmitted = true;
        validationErrors.RemoveAll(error => error == "این واحد پولی قبلاً ثبت شده است.");

        if (initialBalances.Any(item => !IsCompleteInitialBalance(item)))
        {
            StateHasChanged();
            return;
        }

        if (initialBalances
            .GroupBy(item => item.CurrencyId)
            .Any(group => group.Count() > 1))
        {
            validationErrors.Add("این واحد پولی قبلاً ثبت شده است.");
            StateHasChanged();
            return;
        }

        initialBalances.Add(new InitialBalanceDto());
        _isBalanceSubmitted = false;
        StateHasChanged();
    }

    private void RemoveLastInitialBalance()
    {
        if (initialBalances.Count > 0)
            initialBalances.RemoveAt(initialBalances.Count - 1);

        if (initialBalances.Count == 0 && currentAccount.HasInitialBalance)
            initialBalances.Add(new InitialBalanceDto());

        _isBalanceSubmitted = false;
        StateHasChanged();
    }

    // ========== متدهای مربوط به نوع حساب و مرجع ==========

    private bool IsReferenceTypeSelected()
    {
        return currentAccount.ReferenceType == "Customer" || currentAccount.ReferenceType == "Correspondent";
    }

    private async Task OnAccountTypeChanged()
    {
        if (!isEditMode && !string.IsNullOrEmpty(currentAccount.AccountType))
        {
            if (currentAccount.AccountType == "Customer")
                currentAccount.ReferenceType = "Customer";
            else if (currentAccount.AccountType == "Correspondent")
                currentAccount.ReferenceType = "Correspondent";
            else
                currentAccount.ReferenceType = null;

            currentAccount.ReferenceId = null;
            await GetSuggestedCode();
        }
        StateHasChanged();
    }

    private async Task GetSuggestedCode()
    {
        try
        {
            if (!string.IsNullOrEmpty(currentAccount.AccountType))
            {
                var suggestedCode = await AccountService.GetNextAccountCodeAsync(currentAccount.AccountType);
                currentAccount.AccountCode = suggestedCode;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در دریافت کد پیشنهادی: {ex.Message}");
        }
    }

    // ========== متدهای باز و بسته کردن مودال‌ها ==========

    private void OpenCreateModal()
    {
        returnToAccountDetailsAfterEdit = false;
        currentAccount = new CreateAccountDto();
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        initialBalances.Clear();
        _hasInitialBalance = false;
        HasInitialBalance = true;
        _isBalanceSubmitted = false;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var account = await AccountService.GetByIdAsync(id);
            if (account != null)
            {
                currentAccount = new CreateAccountDto
                {
                    AccountCode = account.AccountCode,
                    AccountName = account.AccountName,
                    AccountType = account.AccountType,
                    ReferenceType = account.ReferenceType,
                    ReferenceId = account.ReferenceId,
                    HasInitialBalance = false,
                    InitialBalances = null
                };
                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        if (returnToAccountDetailsAfterEdit && selectedAccount != null)
            showAccountModal = true;

        returnToAccountDetailsAfterEdit = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        if (returnToAccountDetailsAfterArchive && selectedAccount != null)
            showAccountModal = true;

        returnToAccountDetailsAfterArchive = false;
        StateHasChanged();
    }

    // ========== متد ذخیره‌سازی ==========

    private async Task SaveAccount()
    {
        validationErrors.Clear();
        successMessage = string.Empty;
        var enteredInitialBalances = initialBalances
            .Where(item => !IsEmptyInitialBalance(item))
            .ToList();

        if (string.IsNullOrWhiteSpace(currentAccount.AccountName))
            validationErrors.Add("نام حساب الزامی است");
        if (string.IsNullOrWhiteSpace(currentAccount.AccountType))
            validationErrors.Add("نوع حساب الزامی است");

        if (!string.IsNullOrEmpty(currentAccount.ReferenceType) && !currentAccount.ReferenceId.HasValue)
            validationErrors.Add($"لطفاً یک {GetReferenceTypeName(currentAccount.ReferenceType)} انتخاب کنید");

        if (currentAccount.HasInitialBalance && !enteredInitialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (currentAccount.HasInitialBalance && enteredInitialBalances.Any(item => !IsCompleteInitialBalance(item)))
            validationErrors.Add("ارز و مبلغ تمام موجودی‌های اولیه را کامل کنید");

        if (currentAccount.HasInitialBalance && enteredInitialBalances
            .Where(item => item.CurrencyId > 0)
            .GroupBy(item => item.CurrencyId)
            .Any(group => group.Count() > 1))
            validationErrors.Add("هر ارز را فقط یک‌بار در موجودی اولیه وارد کنید");

        if (validationErrors.Any())
        {
            _isBalanceSubmitted = currentAccount.HasInitialBalance;
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();
            var shouldReturnToDetails = isEditMode && returnToAccountDetailsAfterEdit;
            var accountIdToReopen = editId;

            if (isEditMode)
            {
                var updateRequest = new UpdateAccountDto
                {
                    AccountName = currentAccount.AccountName,
                    ReferenceType = currentAccount.ReferenceType,
                    ReferenceId = currentAccount.ReferenceId
                };
                await AccountService.UpdateAsync(editId, updateRequest);
                successMessage = "حساب با موفقیت ویرایش شد";
            }
            else
            {
                if (currentAccount.HasInitialBalance)
                {
                    currentAccount.InitialBalances = enteredInitialBalances;
                }

                await AccountService.CreateAsync(currentAccount);
                successMessage = "حساب با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadAccounts();

            if (shouldReturnToDetails)
                await ReopenAccountDetails(accountIdToReopen);

            returnToAccountDetailsAfterEdit = false;
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای بایگانی ==========

    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        var accountIdToReopen = confirmId;
        var shouldReturnToDetails = returnToAccountDetailsAfterArchive;

        try
        {
            if (confirmActionType == "archive")
            {
                await AccountService.ArchiveAsync(confirmId);
                successMessage = "حساب با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await AccountService.UnarchiveAsync(confirmId);
                successMessage = "حساب با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadAccounts();

            if (shouldReturnToDetails)
                await ReopenAccountDetails(accountIdToReopen);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
            if (shouldReturnToDetails && selectedAccount != null)
                showAccountModal = true;
        }
        finally
        {
            returnToAccountDetailsAfterArchive = false;
            StateHasChanged();
        }
    }

    // ========== متد مشاهده حساب ==========

    private void ViewAccount(long accountId)
    {
        NavigationManager.NavigateTo($"/accounts/{accountId}");
    }

    private async Task EditAccountFromDetails(long accountId)
    {
        showAccountModal = false;
        returnToAccountDetailsAfterEdit = true;
        await OpenEditModal(accountId);
    }

    private Task ToggleArchiveFromDetails(long accountId)
    {
        showAccountModal = false;
        returnToAccountDetailsAfterArchive = true;

        var account = accounts.FirstOrDefault(x => x.Id == accountId) ?? selectedAccount;
        if (account?.IsArchived == true)
            ShowUnarchiveConfirm(accountId);
        else
            ShowArchiveConfirm(accountId);

        return Task.CompletedTask;
    }

    private async Task ReopenAccountDetails(long accountId)
    {
        selectedAccount = await AccountService.GetByIdAsync(accountId);
        showAccountModal = selectedAccount != null;
    }

    // ========== توابع کمکی ==========

    private static int GetAccountDisplayPriority(AccountDto account)
    {
        if (IsMainCashAccount(account))
            return 0;

        return IsSystemAccount(account) ? 1 : 2;
    }

    private static bool IsMainCashAccount(AccountDto account) =>
        IsSystemAccount(account) &&
        (string.Equals(account.AccountCode, "1001", StringComparison.OrdinalIgnoreCase) ||
         (string.Equals(account.AccountType, "Cash", StringComparison.OrdinalIgnoreCase) &&
          string.Equals(account.AccountName?.Trim(), "صندوق", StringComparison.OrdinalIgnoreCase)));

    private static bool IsSystemAccount(AccountDto account) =>
        string.IsNullOrWhiteSpace(account.ReferenceType) &&
        !account.ReferenceId.HasValue;

    private string GetAccountTypeBadge(string type)
    {
        return type?.ToLower() switch
        {
            "cash" => "badge-info",
            "bank" => "badge-primary",
            "customer" => "badge-success",
            "correspondent" => "badge-warning",
            "income" => "badge-success",
            "expense" => "badge-danger",
            "equity" => "badge-dark",
            _ => "badge-secondary"
        };
    }

    private string GetAccountTypeName(string type) => AppDisplayText.AccountType(type);

    private string GetReferenceTypeName(string type) => AppDisplayText.ReferenceType(type);

    private string GetTransactionTypeBadge(string type)
    {
        return type?.ToLower() switch
        {
            "exchange" => "badge-primary",
            "hawalasend" => "badge-info",
            "hawalareceive" => "badge-success",
            "transfer" => "badge-warning",
            "expense" => "badge-danger",
            "adjustment" => "badge-secondary",
            "openingbalance" => "badge-dark",
            _ => "badge-light"
        };
    }

    private string GetTransactionTypeName(string type) => AppDisplayText.TransactionType(type);
}
