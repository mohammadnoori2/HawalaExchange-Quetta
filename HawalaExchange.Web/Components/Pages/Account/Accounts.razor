<!-- ============================================================ -->
<!-- مودال نمایش حساب -->
<!-- ============================================================ -->
@if (showAccountModal && selectedAccount != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-wallet2 me-2"></i> جزئیات حساب
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseAccountModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- خطاها -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- اطلاعات خلاصه حساب -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">کد حساب</span>
                                <span class="info-value">@selectedAccount.AccountCode</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نام حساب</span>
                                <span class="info-value">@selectedAccount.AccountName</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نوع حساب</span>
                                <span class="info-value">@GetAccountTypeName(selectedAccount.AccountType)</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    @if (selectedAccount.IsArchived)
                                    {
                                        <span class="badge-modern badge-archived">بایگانی شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern badge-active">فعال</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نوع مرجع</span>
                                <span class="info-value">@(string.IsNullOrEmpty(selectedAccount.ReferenceType) ? "—" : GetReferenceTypeName(selectedAccount.ReferenceType))</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">شناسه مرجع</span>
                                <span class="info-value">@(selectedAccount.ReferenceId?.ToString() ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">سری کد</span>
                                <span class="info-value">
                                    @{
                                        var prefix = selectedAccount.AccountCode.Length > 0 ? selectedAccount.AccountCode[0].ToString() : "";
                                    }
                                    <span class="badge-modern badge-info">سری @prefix</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">تاریخ ایجاد</span>
                                <span class="info-value" dir="ltr">@selectedAccount.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <!-- جمع‌بندی موجودی -->
                    <div class="modern-card mb-4">
                        <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1a7a3a);">
                            <h6 class="text-white">
                                <i class="bi bi-calculator me-2"></i> جمع‌بندی موجودی به تفکیک ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isBalanceLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (balanceSummary.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table-modern">
                                        <thead>
                                            <tr>
                                                <th>واحد پولی</th>
                                                <th>وضعیت</th>
                                                <th>مقدار</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceSummary)
                                            {
                                                var status = item.Balance > 0 ? "طلبکار" : (item.Balance < 0 ? "بدهکار" : "تسویه");
                                                var badgeClass = item.Balance > 0 ? "badge-success" : (item.Balance < 0 ? "badge-danger" : "badge-secondary");
                                                <tr>
                                                    <td><strong>@item.CurrencyCode</strong></td>
                                                    <td>
                                                        <span class="badge-modern @badgeClass">@status</span>
                                                    </td>
                                                    <td class="fw-bold fs-5 @(item.Balance != 0 ? (item.Balance > 0 ? "text-success" : "text-danger") : "text-muted")">
                                                        @Math.Abs(item.Balance).ToString("N2")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty-state py-3">
                                    <i class="bi bi-inbox"></i>
                                    <span class="text-muted">هیچ تراکنشی برای این حساب یافت نشد</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- لیست تراکنش‌های دفتر کل -->
                    <div class="modern-card">
                        <div class="card-header" style="background: linear-gradient(135deg, #6c757d, #5a6268);">
                            <h6 class="text-white">
                                <i class="bi bi-list-ul me-2"></i> لیست تراکنش‌های دفتر کل
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isLedgerLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (ledgerEntries.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table-modern table-striped-modern">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>تاریخ</th>
                                                <th>شماره تراکنش</th>
                                                <th>نوع تراکنش</th>
                                                <th>واحد پولی</th>
                                                <th>طلبکار</th>
                                                <th>بدهکار</th>
                                                <th>توضیحات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in ledgerEntries)
                                            {
                                                <tr>
                                                    <td>@entry.Id</td>
                                                    <td dir="ltr">@entry.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                                    <td>@entry.TransactionNo</td>
                                                    <td>
                                                        <span class="badge-modern @GetTransactionTypeBadge(entry.TransactionType)">
                                                            @GetTransactionTypeName(entry.TransactionType)
                                                        </span>
                                                    </td>
                                                    <td><span class="badge-modern badge-info">@entry.CurrencyCode</span></td>
                                                    <td class="text-success fw-bold">@(entry.TalabKar > 0 ? entry.TalabKar.ToString("N2") : "-")</td>
                                                    <td class="text-danger fw-bold">@(entry.BadehKar > 0 ? entry.BadehKar.ToString("N2") : "-")</td>
                                                    <td>@entry.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty-state py-3">
                                    <i class="bi bi-journal"></i>
                                    <span class="text-muted">هیچ تراکنشی برای این حساب ثبت نشده است</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseAccountModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌های اصلی =====
    private List<AccountDto> accounts = new();
    private List<AccountDto> filteredAccounts = new();
    private List<CustomerDto> customers = new();
    private List<CorrespondentDto> correspondents = new();
    private List<CurrencyDto> currencies = new();

    // ===== جستجو و فیلتر =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchAccounts();
            }
        }
    }

    private string _filterAccountType = string.Empty;
    private string filterAccountType
    {
        get => _filterAccountType;
        set
        {
            if (_filterAccountType != value)
            {
                _filterAccountType = value;
                SearchAccounts();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private List<AccountDto> pagedAccounts
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredAccounts;
            switch (sortColumn)
            {
                case "AccountCode":
                    sorted = sortAscending ? filteredAccounts.OrderBy(a => a.AccountCode).ToList() : filteredAccounts.OrderByDescending(a => a.AccountCode).ToList();
                    break;
                case "AccountName":
                    sorted = sortAscending ? filteredAccounts.OrderBy(a => a.AccountName).ToList() : filteredAccounts.OrderByDescending(a => a.AccountName).ToList();
                    break;
                case "AccountType":
                    sorted = sortAscending ? filteredAccounts.OrderBy(a => a.AccountType).ToList() : filteredAccounts.OrderByDescending(a => a.AccountType).ToList();
                    break;
                case "ReferenceType":
                    sorted = sortAscending ? filteredAccounts.OrderBy(a => a.ReferenceType).ToList() : filteredAccounts.OrderByDescending(a => a.ReferenceType).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? filteredAccounts.OrderBy(a => a.CreatedAt).ToList() : filteredAccounts.OrderByDescending(a => a.CreatedAt).ToList();
                    break;
                default:
                    sorted = filteredAccounts.OrderByDescending(a => a.CreatedAt).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredAccounts.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showAccountModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;

    // ===== اطلاعات عملیات بایگانی =====
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;

    // ===== پیام‌ها و خطاها =====
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // ===== حساب انتخاب‌شده برای جزئیات =====
    private AccountDto? selectedAccount = null;

    // ===== متغیرهای مربوط به مودال نمایش حساب =====
    private bool isBalanceLoading = false;
    private bool isLedgerLoading = false;
    private List<BalanceDto> balanceSummary = new();
    private List<LedgerEntryDto> ledgerEntries = new();

    // ===== DTO جاری =====
    private CreateAccountDto currentAccount = new();

    // ===== موجودی‌های اولیه (موقت) =====
    private List<InitialBalanceDto> initialBalances = new();
    private InitialBalanceDto newInitialBalance = new();
    private bool _hasInitialBalance;
    private bool _isBalanceSubmitted = false;

    private bool HasInitialBalance
    {
        get => _hasInitialBalance;
        set
        {
            if (_hasInitialBalance != value)
            {
                _hasInitialBalance = value;
                currentAccount.HasInitialBalance = value;
                if (!value)
                {
                    initialBalances.Clear();
                    _isBalanceSubmitted = false;
                }
            }
        }
    }

    // ========== متدهای بارگذاری داده ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadAccounts();
    }

    private async Task LoadLookupData()
    {
        try
        {
            customers = (await CustomerService.GetAllAsync()).ToList();
            correspondents = (await CorrespondentService.GetAllAsync()).ToList();

            var currencyResult = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = currencyResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            isLoading = true;
            var result = await AccountService.GetAllAsync();
            accounts = result.ToList();
            filteredAccounts = accounts;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای جستجو و فیلتر ==========

    private void SearchAccounts()
    {
        var query = accounts.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(a =>
                a.AccountCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                a.AccountName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (a.ReferenceType != null && a.ReferenceType.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (a.ReferenceId.HasValue && a.ReferenceId.Value.ToString().Contains(term))
            );
        }

        if (!string.IsNullOrEmpty(_filterAccountType))
        {
            query = query.Where(a => a.AccountType == _filterAccountType);
        }

        filteredAccounts = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterAccountType = string.Empty;
        filteredAccounts = accounts;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ========== متدهای مربوط به موجودی اولیه ==========

    private bool CanAddInitialBalance()
    {
        return newInitialBalance.CurrencyId > 0 && newInitialBalance.Amount > 0;
    }

    private void AddInitialBalance()
    {
        _isBalanceSubmitted = true;

        if (!CanAddInitialBalance())
        {
            StateHasChanged();
            return;
        }

        if (initialBalances.Any(b => b.CurrencyId == newInitialBalance.CurrencyId))
        {
            validationErrors.Add("این واحد پولی قبلاً ثبت شده است.");
            StateHasChanged();
            return;
        }

        initialBalances.Add(new InitialBalanceDto
        {
            CurrencyId = newInitialBalance.CurrencyId,
            Amount = newInitialBalance.Amount,
            Direction = newInitialBalance.Direction,
            Description = newInitialBalance.Description
        });

        // ریست کردن فرم
        newInitialBalance = new InitialBalanceDto();
        _isBalanceSubmitted = false;
        StateHasChanged();
    }

    private void RemoveInitialBalance(InitialBalanceDto item)
    {
        initialBalances.Remove(item);
        StateHasChanged();
    }

    // ========== متدهای مربوط به نوع حساب و مرجع ==========

    private bool IsReferenceTypeSelected()
    {
        return currentAccount.ReferenceType == "Customer" || currentAccount.ReferenceType == "Correspondent";
    }

    private async Task OnAccountTypeChanged()
    {
        if (!isEditMode && !string.IsNullOrEmpty(currentAccount.AccountType))
        {
            if (currentAccount.AccountType == "Customer")
                currentAccount.ReferenceType = "Customer";
            else if (currentAccount.AccountType == "Correspondent")
                currentAccount.ReferenceType = "Correspondent";
            else
                currentAccount.ReferenceType = null;

            currentAccount.ReferenceId = null;
            await GetSuggestedCode();
        }
        StateHasChanged();
    }

    private async Task GetSuggestedCode()
    {
        try
        {
            if (!string.IsNullOrEmpty(currentAccount.AccountType))
            {
                var suggestedCode = await AccountService.GetNextAccountCodeAsync(currentAccount.AccountType);
                currentAccount.AccountCode = suggestedCode;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در دریافت کد پیشنهادی: {ex.Message}");
        }
    }

    // ========== متدهای باز و بسته کردن مودال‌ها ==========

    private void OpenCreateModal()
    {
        currentAccount = new CreateAccountDto();
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        initialBalances.Clear();
        newInitialBalance = new InitialBalanceDto();
        HasInitialBalance = false;
        _isBalanceSubmitted = false;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var account = await AccountService.GetByIdAsync(id);
            if (account != null)
            {
                currentAccount = new CreateAccountDto
                {
                    AccountCode = account.AccountCode,
                    AccountName = account.AccountName,
                    AccountType = account.AccountType,
                    ReferenceType = account.ReferenceType,
                    ReferenceId = account.ReferenceId,
                    HasInitialBalance = false,
                    InitialBalances = null
                };
                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void CloseAccountModal()
    {
        showAccountModal = false;
        selectedAccount = null;
        balanceSummary.Clear();
        ledgerEntries.Clear();
        validationErrors.Clear();
        StateHasChanged();
    }

    // ========== متد ذخیره‌سازی ==========

    private async Task SaveAccount()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentAccount.AccountName))
            validationErrors.Add("نام حساب الزامی است");
        if (string.IsNullOrWhiteSpace(currentAccount.AccountType))
            validationErrors.Add("نوع حساب الزامی است");

        if (!string.IsNullOrEmpty(currentAccount.ReferenceType) && !currentAccount.ReferenceId.HasValue)
            validationErrors.Add($"لطفاً یک {GetReferenceTypeName(currentAccount.ReferenceType)} انتخاب کنید");

        if (currentAccount.HasInitialBalance && !initialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateAccountDto
                {
                    AccountName = currentAccount.AccountName,
                    ReferenceType = currentAccount.ReferenceType,
                    ReferenceId = currentAccount.ReferenceId
                };
                await AccountService.UpdateAsync(editId, updateRequest);
                successMessage = "حساب با موفقیت ویرایش شد";
            }
            else
            {
                if (currentAccount.HasInitialBalance)
                {
                    currentAccount.InitialBalances = initialBalances.ToList();
                }

                await AccountService.CreateAsync(currentAccount);
                successMessage = "حساب با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadAccounts();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای بایگانی ==========

    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این حساب را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await AccountService.ArchiveAsync(confirmId);
                successMessage = "حساب با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await AccountService.UnarchiveAsync(confirmId);
                successMessage = "حساب با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ========== متد مشاهده حساب ==========

    private async Task ViewAccount(long accountId)
    {
        try
        {
            balanceSummary.Clear();
            ledgerEntries.Clear();
            validationErrors.Clear();
            isBalanceLoading = true;
            isLedgerLoading = true;

            selectedAccount = await AccountService.GetByIdAsync(accountId);
            if (selectedAccount == null)
            {
                validationErrors.Add("حساب مورد نظر یافت نشد.");
                isBalanceLoading = false;
                isLedgerLoading = false;
                StateHasChanged();
                return;
            }

            showAccountModal = true;
            StateHasChanged();

            await LoadAccountData(selectedAccount.Id);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات حساب: {ex.Message}");
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAccountData(long accountId)
    {
        try
        {
            isBalanceLoading = true;
            isLedgerLoading = true;
            StateHasChanged();

            var balanceResult = await LedgerService.GetAccountBalancesAsync(accountId);
            balanceSummary = balanceResult.ToList();

            var ledgerResult = await LedgerService.GetEntriesByAccountAsync(accountId);
            ledgerEntries = ledgerResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های حساب: {ex.Message}");
        }
        finally
        {
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

