@page "/account-limits"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject IAccountBadehkarLimitService AccountLimitService
@inject IAccountService AccountService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>سقف بدهکاری</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="سقف بدهکاری مشتریان و نمایندگی‌ها"
                   Subtitle="تعیین بیشترین بدهکاری مجاز هر حساب به تفکیک ارز"
                   Icon="bi-credit-card-2-front">
        <Stats>
            <PageHeaderStats AriaLabel="آمار سقف بدهکاری">
                <PageHeaderStat Label="کل" Value="@limits.Count" Icon="bi-credit-card-2-front" />
                <PageHeaderStat Label="فعال" Value="@limits.Count(l => l.IsActive)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="غیرفعال" Value="@limits.Count(l => !l.IsActive)" Icon="bi-slash-circle" Tone="danger" />
                <PageHeaderStat Label="بالاتر از سقف" Value="@limits.Count(l => l.IsActive && l.IsOverLimit)" Icon="bi-exclamation-triangle" Tone="warning" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> سقف جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر سقف بدهکاری"
                      HasActiveFilters="@HasActiveFilters"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با نام حساب یا کد ارز..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter"
                    aria-label="وضعیت سقف بدهکاری"
                    @bind="filterStatus"
                    @bind:event="oninput">
                <option value="">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </QuickFilters>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredLimits.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "AccountName" ? "active" : "")" @onclick="@(() => SortBy("AccountName"))">
                                حساب
                                @if (sortColumn == "AccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("CurrencyCode"))">
                                ارز
                                @if (sortColumn == "CurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>نوع حساب</th>
                            <th class="sortable-header @(sortColumn == "BadehkarLimit" ? "active" : "")" @onclick="@(() => SortBy("BadehkarLimit"))">
                                سقف بدهکاری
                                @if (sortColumn == "BadehkarLimit")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CurrentDebt" ? "active" : "")" @onclick="@(() => SortBy("CurrentDebt"))">
                                بدهکاری فعلی
                                @if (sortColumn == "CurrentDebt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AvailableDebt" ? "active" : "")" @onclick="@(() => SortBy("AvailableDebt"))">
                                ظرفیت باقی‌مانده
                                @if (sortColumn == "AvailableDebt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>وضعیت</th>
                            <th>ایجاد کننده</th>
                            <th class="sortable-header @(sortColumn == "CreatedAt" ? "active" : "")" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ ایجاد
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && limits == null)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedLimits.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ محدودیتی یافت نشد</span>
                                        <p class="text-muted small">@(HasActiveFilters ? "فیلترها را تغییر دهید یا پاک کنید." : "برای افزودن سقف بدهکاری جدید، دکمه «سقف جدید» را انتخاب کنید.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredLimits.Count : pageSize) + 1;
                            @foreach (var limit in pagedLimits)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-semibold">@limit.AccountName</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@limit.CurrencyCode</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern @(limit.AccountType == "نمایندگی" ? "badge-info" : "badge-active")">
                                            @limit.AccountType
                                        </span>
                                    </td>
                                    <td dir="ltr" class="fw-bold text-primary">@MoneyFormatHelper.Format(limit.BadehkarLimit)</td>
                                    <td dir="ltr" class="fw-bold @(limit.IsOverLimit ? "text-danger" : "")">
                                        @MoneyFormatHelper.Format(limit.CurrentDebt)
                                    </td>
                                    <td dir="ltr" class="fw-bold @(limit.AvailableDebt == 0 ? "text-danger" : "text-success")">
                                        @MoneyFormatHelper.Format(limit.AvailableDebt)
                                    </td>
                                    <td>
                                        @if (limit.IsActive && limit.IsOverLimit)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-exclamation-triangle"></i> بالاتر از سقف
                                            </span>
                                        }
                                        else if (limit.IsActive)
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-slash-circle"></i> غیرفعال
                                            </span>
                                        }
                                    </td>
                                    <td>@(limit.CreatedByName ?? "-")</td>
                                    <td><AppDateTime Value="@limit.CreatedAt" /></td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات سقف بدهکاری {limit.Id}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => OpenEditModal(limit.Id)">
                                                <i class="bi bi-pencil text-primary"></i>
                                                ویرایش
                                            </button>
                                            @if (limit.IsActive)
                                            {
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowDeactivateConfirm(limit.Id)">
                                                    <i class="bi bi-slash-circle"></i>
                                                    غیرفعال‌سازی
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowActivateConfirm(limit.Id)">
                                                    <i class="bi bi-check-circle text-success"></i>
                                                    فعال‌سازی
                                                </button>
                                            }
                                            <div class="operation-menu-divider"></div>
                                            <button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" @onclick="() => ShowDeleteConfirm(limit.Id)">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </button>
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedLimits.Count</strong> از <strong>@filteredLimits.Count</strong> محدودیت
                </span>

                <!-- صفحه‌بندی -->
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد سقف بدهکاری در هر صفحه" />
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش محدودیت -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش محدودیت" : "ایجاد محدودیت جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-credit-card-2-front me-2"></i> اطلاعات محدودیت
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person-badge text-muted me-1"></i> حساب <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@(accounts.FirstOrDefault(a => a.Id == currentLimit.AccountId)?.AccountName ?? "نامشخص")" disabled readonly />
                                        <small class="text-muted">حساب قابل تغییر نیست</small>
                                    }
                                    else
                                    {
                                        <AccountSearchSelect Accounts="@accounts"
                                                             @bind-Value="currentLimit.AccountId"
                                                             Placeholder="جستجوی حساب..." />
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-coin text-muted me-1"></i> ارز <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@(currencies.FirstOrDefault(c => c.Id == currentLimit.CurrencyId)?.Code ?? "نامشخص")" disabled readonly />
                                        <small class="text-muted">ارز قابل تغییر نیست</small>
                                    }
                                    else
                                    {
                                        <select class="form-select"
                                                @bind="currentLimit.CurrencyId">
                                            <option value="0">انتخاب ارز</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-credit-card text-muted me-1"></i> سقف بدهکاری <span class="text-danger">*</span>
                                    </label>
                                    <MoneyInput class="form-control"
                                                @bind-Value="currentLimit.BadehkarLimit" placeholder="مقدار سقف را وارد کنید" />
                                    <small class="text-muted">مقدار صفر یعنی این حساب اجازه بدهکار شدن ندارد.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش محدودیت برای حساب: <strong>@(accounts.FirstOrDefault(a => a.Id == currentLimit.AccountId)?.AccountName ?? "نامشخص")</strong> و ارز: <strong>@(currencies.FirstOrDefault(c => c.Id == currentLimit.CurrencyId)?.Code ?? "نامشخص")</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveLimit()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید فعال/غیرفعال‌سازی -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDeleteModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این محدودیت را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDeleteModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountBadehkarLimitDto> limits = new();
    private List<AccountBadehkarLimitDto> filteredLimits = new();
    private List<AccountDto> accounts = new();
    private List<CurrencyDto> currencies = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchLimits();
            }
        }
    }

    private string _filterStatus = "";
    private string filterStatus
    {
        get => _filterStatus;
        set
        {
            if (_filterStatus != value)
            {
                _filterStatus = value;
                SearchLimits();
            }
        }
    }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchTerm)
        || !string.IsNullOrWhiteSpace(_filterStatus);

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private List<AccountBadehkarLimitDto> pagedLimits
    {
        get
        {
            var sorted = filteredLimits;
            switch (sortColumn)
            {
                case "AccountName":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.AccountName).ToList() : filteredLimits.OrderByDescending(l => l.AccountName).ToList();
                    break;
                case "CurrencyCode":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.CurrencyCode).ToList() : filteredLimits.OrderByDescending(l => l.CurrencyCode).ToList();
                    break;
                case "BadehkarLimit":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.BadehkarLimit).ToList() : filteredLimits.OrderByDescending(l => l.BadehkarLimit).ToList();
                    break;
                case "CurrentDebt":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.CurrentDebt).ToList() : filteredLimits.OrderByDescending(l => l.CurrentDebt).ToList();
                    break;
                case "AvailableDebt":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.AvailableDebt).ToList() : filteredLimits.OrderByDescending(l => l.AvailableDebt).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? filteredLimits.OrderBy(l => l.CreatedAt).ToList() : filteredLimits.OrderByDescending(l => l.CreatedAt).ToList();
                    break;
                default:
                    sorted = filteredLimits.OrderByDescending(l => l.CreatedAt).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredLimits.Count / pageSize);

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool currentLimitIsActive = true;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private long deleteId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private CreateAccountBadehkarLimitDto currentLimit = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadLimits();
    }

    private async Task LoadLookupData()
    {
        try
        {
            accounts = (await AccountService.GetAllAsync())
                .Where(IsEligibleAccount)
                .OrderBy(a => a.AccountType == "Correspondent" ? 1 : 0)
                .ThenBy(a => a.AccountName)
                .ToList();
            currencies = (await CurrencyService.GetAllAsync())
                .Where(c => c.IsActive)
                .OrderBy(c => c.Code)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadLimits()
    {
        try
        {
            isLoading = true;
            var result = await AccountLimitService.GetAllAsync();
            limits = result.ToList();
            SearchLimits();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری محدودیت‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchLimits()
    {
        var query = limits.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(l =>
                (l.AccountName != null && l.AccountName.ToLower().Contains(term)) ||
                (l.AccountType != null && l.AccountType.ToLower().Contains(term)) ||
                (l.CurrencyCode != null && l.CurrencyCode.ToLower().Contains(term))
            );
        }

        if (!string.IsNullOrEmpty(_filterStatus))
        {
            var isActive = bool.Parse(_filterStatus);
            query = query.Where(l => l.IsActive == isActive);
        }

        filteredLimits = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterStatus = "";
        filteredLimits = limits;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentLimit = new CreateAccountBadehkarLimitDto
        {
            AccountId = 0,
            CurrencyId = 0,
            BadehkarLimit = 0
        };
        isEditMode = false;
        currentLimitIsActive = true;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var limit = await AccountLimitService.GetByIdAsync(id);
            if (limit != null)
            {
                currentLimit = new CreateAccountBadehkarLimitDto
                {
                    AccountId = limit.AccountId,
                    CurrencyId = limit.CurrencyId,
                    BadehkarLimit = limit.BadehkarLimit
                };
                isEditMode = true;
                currentLimitIsActive = limit.IsActive;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری محدودیت: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task SaveLimit()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (currentLimit.AccountId == 0)
            validationErrors.Add("انتخاب حساب الزامی است");
        if (currentLimit.CurrencyId == 0)
            validationErrors.Add("انتخاب ارز الزامی است");
        if (currentLimit.BadehkarLimit < 0)
            validationErrors.Add("سقف بدهکاری نمی‌تواند منفی باشد");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateAccountBadehkarLimitDto
                {
                    BadehkarLimit = currentLimit.BadehkarLimit,
                    IsActive = currentLimitIsActive
                };
                await AccountLimitService.UpdateAsync(editId, updateRequest);
                successMessage = "محدودیت با موفقیت ویرایش شد";
            }
            else
            {
                await AccountLimitService.CreateAsync(currentLimit);
                successMessage = "محدودیت با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadLimits();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static bool IsEligibleAccount(AccountDto account) =>
        !account.IsArchived &&
        (account.AccountType is "Customer" or "Correspondent" ||
         account.ReferenceType is "Customer" or "Correspondent");

    private static string GetAccountTypeLabel(AccountDto account) =>
        account.AccountType == "Correspondent" || account.ReferenceType == "Correspondent"
            ? "نمایندگی"
            : "مشتری";

    private void ShowDeactivateConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "deactivate";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این محدودیت را غیرفعال کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowActivateConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "activate";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این محدودیت را فعال کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "deactivate")
            {
                await AccountLimitService.DeactivateAsync(confirmId);
                successMessage = "محدودیت با موفقیت غیرفعال شد";
            }
            else if (confirmActionType == "activate")
            {
                await AccountLimitService.ActivateAsync(confirmId);
                successMessage = "محدودیت با موفقیت فعال شد";
            }

            showConfirmModal = false;
            await LoadLimits();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await AccountLimitService.DeleteAsync(deleteId);
            successMessage = "محدودیت با موفقیت حذف شد";
            showDeleteModal = false;
            await LoadLimits();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
