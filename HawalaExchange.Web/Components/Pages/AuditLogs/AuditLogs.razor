@page "/auditlogs"
@attribute [Authorize(Roles = "Admin")]

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Helpers
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IAuditLogService AuditLogService
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<AuditLogs> Logger
@rendermode InteractiveServer

<PageTitle>لاگ‌های سیستم</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="لاگ‌های سیستم"
                   Subtitle="هر پروسس در یک ردیف؛ تمام تغییرات وابسته در جزئیات همان ردیف"
                   Icon="bi-clock-history">
        <Stats>
            <PageHeaderStats AriaLabel="آمار لاگ‌ها">
                <PageHeaderStat Label="کل" Value="@statisticsTotal" Icon="bi-clock-history" />
                <PageHeaderStat Label="ایجاد" Value="@createCount" Icon="bi-plus-circle" Tone="success" />
                <PageHeaderStat Label="ویرایش" Value="@updateCount" Icon="bi-pencil" Tone="info" />
                <PageHeaderStat Label="حذف" Value="@deleteCount" Icon="bi-trash" Tone="danger" />
                <PageHeaderStat Label="لغو" Value="@cancelCount" Icon="bi-x-circle" Tone="warning" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <button type="button" class="btn-modern btn-primary-modern btn-rounded" @onclick="LoadLogs">
                <i class="bi bi-arrow-clockwise"></i> بروزرسانی
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر لاگ‌ها"
                      HasActiveFilters="@HasActiveFilters"
                      ActiveFilterCount="@ActiveFilterCount"
                      Reset="ResetFilters">
        <SearchContent>
            <input class="form-control"
                   placeholder="جستجو در نام کاربر، بخش، شناسه یا جزئیات تغییر..."
                   @bind="searchTerm" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" aria-label="کاربر"
                    @bind="filterUserId" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                <option value="">همه کاربران</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.FullName (@user.UserName)</option>
                }
            </select>
            <select class="form-select compact-quick-filter" aria-label="نوع عملیات"
                    @bind="filterAction" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                <option value="">همه عملیات</option>
                <option value="CREATE">ایجاد</option>
                <option value="UPDATE">ویرایش</option>
                <option value="DELETE">حذف</option>
                <option value="CANCEL">لغو</option>
                <option value="REVERSE">برگشت عملیات مالی</option>
            </select>
        </QuickFilters>
        <AdvancedFilters>
            <div class="compact-filter-field">
                <label class="form-label">بخش سیستم</label>
                <select class="form-select" @bind="filterTable" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                    <option value="">همه بخش‌ها</option>
                    @foreach (var table in tables)
                    {
                        <option value="@table">@AuditLogDisplayHelper.EntityName(table)</option>
                    }
                </select>
            </div>
            <div class="compact-filter-field">
                <label class="form-label">از تاریخ</label>
                <PersianDatePicker @bind-Value="fromDate" @bind-Value:after="OnFilterChangedAsync"
                                   IncludeTime="true" AllowEmpty="true" Placeholder="تاریخ و زمان شروع" />
            </div>
            <div class="compact-filter-field">
                <label class="form-label">تا تاریخ</label>
                <PersianDatePicker @bind-Value="toDate" @bind-Value:after="OnFilterChangedAsync"
                                   IncludeTime="true" AllowEmpty="true" Placeholder="تاریخ و زمان پایان" />
            </div>
        </AdvancedFilters>
    </CompactFilterBar>

    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info"><i class="bi bi-list-ul"></i> @totalCount</span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th class="sortable-header @(sortColumn == "UserName" ? "active" : "")" @onclick="@(() => SortBy("UserName"))">کاربر @(SortIcon("UserName"))</th>
                            <th class="sortable-header @(sortColumn == "Action" ? "active" : "")" @onclick="@(() => SortBy("Action"))">عملیات @(SortIcon("Action"))</th>
                            <th class="sortable-header @(sortColumn == "TableName" ? "active" : "")" @onclick="@(() => SortBy("TableName"))">بخش @(SortIcon("TableName"))</th>
                            <th class="sortable-header @(sortColumn == "RecordId" ? "active" : "")" @onclick="@(() => SortBy("RecordId"))">شماره @(SortIcon("RecordId"))</th>
                            <th>خلاصه کار انجام‌شده</th>
                            <th class="sortable-header @(sortColumn == "CreatedAt" ? "active" : "")" @onclick="@(() => SortBy("CreatedAt"))">تاریخ و زمان @(SortIcon("CreatedAt"))</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && !filteredLogs.Any())
                        {
                            <tr><td colspan="8" class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-muted mt-2">در حال بارگذاری لاگ‌ها...</p></td></tr>
                        }
                        else if (!filteredLogs.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ لاگی یافت نشد</span>
                                        <p class="text-muted small">@(HasActiveFilters ? "فیلترها را تغییر دهید یا پاک کنید." : "هنوز رویدادی در سیستم ثبت نشده است.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (currentPage - 1) * EffectivePageSize + 1;
                            @foreach (var log in filteredLogs)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td><span class="fw-semibold">@(log.UserName ?? "سیستم")</span></td>
                                    <td><span class="badge-modern @GetActionBadge(log.Action)">@GetActionName(log.Action)</span></td>
                                    <td><span class="fw-semibold">@AuditLogDisplayHelper.EntityName(log.TableName)</span></td>
                                    <td dir="ltr">#@log.RecordId</td>
                                    <td><span title="@AuditLogDisplayHelper.Summary(log)">@AuditLogDisplayHelper.Summary(log)</span></td>
                                    <td><AppDateTime Value="@log.CreatedAt" /></td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات لاگ {log.Id}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ViewLog(log)">
                                                <i class="bi bi-eye text-primary"></i> مشاهده جزئیات
                                            </button>
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">نمایش <strong>@filteredLogs.Count</strong> از <strong>@totalCount</strong> لاگ</span>
                <CompactPagination CurrentPage="currentPage" TotalPages="totalPages" PageChanged="GoToPage" />
            </div>
            <PageSizeSelector @bind-Value="pageSize" @bind-CurrentPage="currentPage"
                              Changed="OnPageSizeChangedAsync" PersistenceKey="auditlogs"
                              AriaLabel="تعداد لاگ در هر صفحه" />
        </div>
    </div>
</div>

@if (showDetailModal && selectedLog != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color:rgba(0,0,0,.5);backdrop-filter:blur(4px)" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white"><i class="bi bi-clock-history me-2"></i> جزئیات کامل تغییر</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="بستن" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-3"><strong>کاربر:</strong> @(selectedLog.UserName ?? "سیستم")</div>
                        <div class="col-md-3"><strong>عملیات:</strong> @GetActionName(selectedLog.Action)</div>
                        <div class="col-md-3"><strong>بخش:</strong> @AuditLogDisplayHelper.EntityName(selectedLog.TableName)</div>
                        <div class="col-md-3"><strong>شماره:</strong> <span dir="ltr">@selectedLog.RecordId</span></div>
                        <div class="col-12"><strong>زمان:</strong> <AppDateTime Value="@selectedLog.CreatedAt" /></div>
                    </div>

                    <div class="table-responsive border rounded">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>چه چیزی تغییر کرد؟</th><th>قبل از تغییر</th><th>بعد از تغییر</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var change in SelectedChanges)
                                {
                                    <tr>
                                        <td class="fw-semibold">@change.FieldName</td>
                                        <td class="text-danger text-break">@(change.OldValue ?? "—")</td>
                                        <td class="text-success text-break">@(change.NewValue ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseDetailModal"><i class="bi bi-x-circle"></i> بستن</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AuditLogDto> filteredLogs = [];
    private List<UserDto> users = [];
    private List<string> tables = [];
    private DateTime fromDate = DateTime.MinValue;
    private DateTime toDate = DateTime.MinValue;
    private long? filterUserId;
    private string filterAction = "";
    private string filterTable = "";
    private string searchTerm = "";
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private int statisticsTotal;
    private int createCount;
    private int updateCount;
    private int deleteCount;
    private int cancelCount;
    private string sortColumn = "CreatedAt";
    private bool sortAscending;
    private bool isLoading;
    private bool showDetailModal;
    private AuditLogDto? selectedLog;
    private CancellationTokenSource? filterChangeCts;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(searchTerm) || filterUserId.HasValue ||
        !string.IsNullOrWhiteSpace(filterAction) || !string.IsNullOrWhiteSpace(filterTable) ||
        fromDate != DateTime.MinValue || toDate != DateTime.MinValue;
    private int ActiveFilterCount => (!string.IsNullOrWhiteSpace(searchTerm) ? 1 : 0) + (filterUserId.HasValue ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(filterAction) ? 1 : 0) + (!string.IsNullOrWhiteSpace(filterTable) ? 1 : 0) +
        (fromDate != DateTime.MinValue ? 1 : 0) + (toDate != DateTime.MinValue ? 1 : 0);
    private int EffectivePageSize => pageSize == 0 ? Math.Max(totalCount, 1) : pageSize;
    private IReadOnlyList<AuditFieldChange> SelectedChanges => selectedLog == null ? [] : AuditLogDisplayHelper.GetChanges(selectedLog);

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadTables();
        await LoadLogs();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await UserManager.Users.Where(x => x.IsActive).OrderBy(x => x.FullName)
                .Select(x => new UserDto { Id = x.Id, UserName = x.UserName, FullName = x.FullName, Email = x.Email, IsActive = x.IsActive, CreatedAt = x.CreatedAt })
                .ToListAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading audit users"); }
    }

    private async Task LoadTables()
    {
        try
        {
            tables = (await AuditLogService.GetDistinctTablesAsync())
                .OrderBy(AuditLogDisplayHelper.EntityName)
                .ToList();
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading audit tables"); }
    }

    private async Task LoadLogs()
    {
        try
        {
            isLoading = true;
            var result = await AuditLogService.GetFilteredLogsAsync(new AuditLogFilterDto
            {
                FromDate = fromDate == DateTime.MinValue ? null : fromDate,
                ToDate = toDate == DateTime.MinValue ? null : toDate,
                UserId = filterUserId,
                Action = string.IsNullOrWhiteSpace(filterAction) ? null : filterAction,
                TableName = string.IsNullOrWhiteSpace(filterTable) ? null : filterTable,
                SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                PageNumber = currentPage,
                PageSize = pageSize == 0 ? int.MaxValue : pageSize,
                SortColumn = sortColumn,
                SortDirection = sortAscending ? "asc" : "desc"
            });
            filteredLogs = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = Math.Max(result.TotalPages, 1);
            var stats = await AuditLogService.GetStatisticsAsync();
            statisticsTotal = stats.TotalLogs;
            createCount = stats.CreateCount;
            updateCount = stats.UpdateCount;
            deleteCount = stats.DeleteCount;
            cancelCount = stats.CancelCount;
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading audit logs"); }
        finally { isLoading = false; }
    }

    private async Task OnFilterChangedAsync()
    {
        filterChangeCts?.Cancel();
        filterChangeCts?.Dispose();
        filterChangeCts = new CancellationTokenSource();
        try { await Task.Delay(180, filterChangeCts.Token); }
        catch (OperationCanceledException) { return; }
        currentPage = 1;
        await LoadLogs();
    }

    private async Task ResetFilters()
    {
        searchTerm = filterAction = filterTable = "";
        filterUserId = null;
        fromDate = toDate = DateTime.MinValue;
        currentPage = 1;
        await LoadLogs();
    }

    private async Task OnPageSizeChangedAsync() { currentPage = 1; await LoadLogs(); }
    private async Task GoToPage(int page) { if (page < 1 || page > totalPages || page == currentPage) return; currentPage = page; await LoadLogs(); }
    private void SortBy(string column) { sortAscending = sortColumn == column ? !sortAscending : true; sortColumn = column; currentPage = 1; _ = LoadLogs(); }
    private MarkupString SortIcon(string column) => sortColumn == column ? (MarkupString)$"<i class='bi {(sortAscending ? "bi-chevron-up" : "bi-chevron-down")}'></i>" : default;
    private void ViewLog(AuditLogDto log) { selectedLog = log; showDetailModal = true; }
    private void CloseDetailModal() { selectedLog = null; showDetailModal = false; }
    private static string GetActionName(string? action) => action?.ToUpperInvariant() == "REVERSE" ? "برگشت عملیات مالی" : AppDisplayText.AuditAction(action?.ToUpperInvariant());
    private static string GetActionBadge(string? action) => action?.ToUpperInvariant() switch
    {
        "CREATE" => "badge-success", "UPDATE" => "badge-info", "DELETE" => "badge-danger",
        "CANCEL" => "badge-warning", "REVERSE" => "badge-secondary", _ => "badge-light"
    };
}
