@page "/branches"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IBranchService BranchService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-fluid mt-4" dir="rtl">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #0061f2, #0050c8);">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h4 class="mb-0">
                    <i class="bi bi-building me-2"></i> مدیریت شعبه‌ها
                </h4>
                <button class="btn btn-light btn-lg" @onclick="() => OpenCreateModal()">
                    <i class="bi bi-plus-circle"></i> شعبه جدید
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- نوار جستجو -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="جستجوی شعبه‌ها (کد، نام، تلفن، آدرس)..."
                               @bind="searchTerm" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" @onclick="() => ClearSearch()" type="button">
                            <i class="bi bi-x-circle"></i> پاک کردن
                        </button>
                    </div>
                </div>
                <div class="col-md-4 text-start">
                    <span class="badge bg-info fs-6 p-2">
                        <i class="bi bi-list-ul"></i> تعداد: @filteredBranches.Count
                    </span>
                </div>
            </div>

            <!-- جدول شعبه‌ها -->
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">کد شعبه</th>
                            <th scope="col">نام شعبه</th>
                            <th scope="col">شماره تلفن</th>
                            <th scope="col">آدرس</th>
                            <th scope="col">تاریخ ایجاد</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col" style="min-width: 150px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && branches == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredBranches.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block"></i>
                                    <span class="fs-5">هیچ شعبه‌ای یافت نشد</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = 1;
                            @foreach (var branch in filteredBranches)
                            {
                                <tr class="@(branch.IsArchived ? "table-secondary" : "")">
                                    <td>@rowIndex</td>
                                    <td><strong>@branch.Code</strong></td>
                                    <td>@branch.Name</td>
                                    <td dir="ltr">@branch.PhoneNumber</td>
                                    <td>@branch.Address</td>
                                    <td dir="ltr" class="text-start">@branch.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (branch.IsArchived)
                                        {
                                            <span class="badge bg-secondary px-3 py-2">بایگانی شده</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">فعال</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (!branch.IsArchived)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(branch.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => ShowArchiveConfirm(branch.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => ShowUnarchiveConfirm(branch.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش شعبه -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش شعبه" : "ایجاد شعبه جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @successMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-hash"></i> کد شعبه <span class="text-danger">*</span>
                            </label>
                            @if (isEditMode)
                            {
                                <input type="text" class="form-control bg-light" value="@currentBranch.Code" disabled readonly />
                                <small class="text-muted">کد شعبه قابل ویرایش نیست</small>
                            }
                            else
                            {
                                <input type="text" class="form-control @(string.IsNullOrEmpty(currentBranch.Code) ? "is-invalid" : "")"
                                       @bind="currentBranch.Code" placeholder="مثال: BR-001" />
                                <div class="invalid-feedback">کد شعبه الزامی است</div>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-person"></i> نام شعبه <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control @(string.IsNullOrEmpty(currentBranch.Name) ? "is-invalid" : "")"
                                   @bind="currentBranch.Name" placeholder="نام شعبه را وارد کنید" />
                            <div class="invalid-feedback">نام شعبه الزامی است</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-phone"></i> شماره تلفن
                            </label>
                            <input type="text" class="form-control" @bind="currentBranch.PhoneNumber" placeholder="مثال: 0780 123 456" dir="ltr" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-geo-alt"></i> آدرس
                            </label>
                            <input type="text" class="form-control" @bind="currentBranch.Address" placeholder="آدرس کامل" />
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info mt-2">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش شعبه با کد: <strong>@currentBranch.Code</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => SaveBranch()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید بایگانی/خروج از بایگانی -->
@if (showConfirmModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BranchDto> branches = new();
    private List<BranchDto> filteredBranches = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchBranches();
            }
        }
    }

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // استفاده از CreateBranchDto برای هر دو حالت (برای ویرایش، کد را جداگانه نگه می‌داریم)
    private CreateBranchDto currentBranch = new();
    private string? branchCodeDisplay; // برای نمایش کد در حالت ویرایش

    protected override async Task OnInitializedAsync()
    {
        await LoadBranches();
    }

    private async Task LoadBranches()
    {
        try
        {
            isLoading = true;
            var result = await BranchService.GetAllAsync();
            branches = result.ToList();
            filteredBranches = branches;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری شعبه‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchBranches()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredBranches = branches;
        }
        else
        {
            var term = _searchTerm.Trim();
            filteredBranches = branches.Where(b =>
                b.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                b.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (b.PhoneNumber != null && b.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (b.Address != null && b.Address.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredBranches = branches;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentBranch = new CreateBranchDto();
        branchCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var branch = await BranchService.GetByIdAsync(id);
            if (branch != null)
            {
                // ذخیره کد برای نمایش
                branchCodeDisplay = branch.Code;

                currentBranch = new CreateBranchDto
                {
                    Code = branch.Code, // کد برای نمایش در حالت ویرایش (غیرقابل ویرایش)
                    Name = branch.Name,
                    PhoneNumber = branch.PhoneNumber,
                    Address = branch.Address
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری شعبه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task SaveBranch()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        // اعتبارسنجی
        if (!isEditMode && string.IsNullOrWhiteSpace(currentBranch.Code))
            validationErrors.Add("کد شعبه الزامی است");
        if (string.IsNullOrWhiteSpace(currentBranch.Name))
            validationErrors.Add("نام شعبه الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateBranchDto
                {
                    Code = currentBranch.Code, // کد را ارسال می‌کنیم، ولی سرویس نباید آن را تغییر دهد
                    Name = currentBranch.Name,
                    PhoneNumber = currentBranch.PhoneNumber,
                    Address = currentBranch.Address,
                    IsArchived = false // بایگانی از طریق دکمه جداگانه مدیریت می‌شود
                };
                await BranchService.UpdateAsync(editId, updateRequest);
                successMessage = "شعبه با موفقیت ویرایش شد";
            }
            else
            {
                await BranchService.CreateAsync(currentBranch);
                successMessage = "شعبه با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadBranches();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این شعبه را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این شعبه را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await BranchService.ArchiveAsync(confirmId); // فرض می‌کنیم در BaseService وجود دارد
                successMessage = "شعبه با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                // متد UnarchiveAsync باید در سرویس تعریف شود – فرض می‌کنیم وجود دارد
                // در غیر این صورت، یک متد Update با تنظیم IsArchived = false
                // می‌توانید آن را در IBranchService اضافه کنید
                await BranchService.UnarchiveAsync(confirmId);
                successMessage = "شعبه با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadBranches();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}