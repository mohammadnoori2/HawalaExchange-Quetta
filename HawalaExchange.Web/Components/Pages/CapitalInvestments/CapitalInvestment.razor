@page "/capital-investment"

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ICapitalInvestmentService CapitalInvestmentService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject ICompanySettingService CompanySettingService

@rendermode InteractiveServer

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-cash-stack"></i>
                سرمایه و برداشت مالک
                <span class="page-subtitle">افزایش سرمایه و برداشت شخصی مالک، جدا از مصارف صرافی</span>
            </h5>
        </div>

        <div class="page-actions">
            <button class="btn-modern btn-danger-modern btn-rounded" @onclick="OpenWithdrawalModal" disabled="@isLoading">
                <i class="bi bi-box-arrow-up"></i> برداشت مالک
            </button>
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle"></i>
                ثبت سرمایه جدید
            </button>
        </div>
    </div>

    @if (validationErrors.Any() && !showModal)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    <div class="modern-card mt-3 p-3">
        <h6>خلاصه به تفکیک ارز</h6>
        <GlobalDataGrid class="table table-sm mb-0">
            <thead><tr><th>ارز</th><th>سرمایه واردشده</th><th>برداشت مالک</th><th>خالص سرمایه ثبت‌شده</th></tr></thead>
            <tbody>
                @foreach (var group in investments.Where(x => !x.CancelledAt.HasValue).GroupBy(x => x.CurrencyCode))
                {
                    var added = group.Where(x => !x.IsWithdrawal).Sum(x => x.Amount);
                    var withdrawn = group.Where(x => x.IsWithdrawal).Sum(x => x.Amount);
                    <tr><td>@group.Key</td><td dir="ltr">@MoneyFormatHelper.Format(added)</td><td dir="ltr">@MoneyFormatHelper.Format(withdrawn)</td><td dir="ltr">@MoneyFormatHelper.Format(added - withdrawn)</td></tr>
                }
            </tbody>
        </GlobalDataGrid>
        <small class="text-muted">این خالص فقط شامل سرمایه و برداشت‌های ثبت‌شده است؛ مفاد و مانده افتتاحیه را شامل نمی‌شود.</small>
    </div>
    <div class="table-card mt-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-list-ul"></i>
                    تاریخچه سرمایه و برداشت مالک
                </h6>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list"></i>
                    @investments.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th>تاریخ</th>
                            <th>نوع / وضعیت</th>
                            <th>ارز</th>
                            <th>مبلغ</th>
                            <th>ارزش سرمایه / بهای برداشت</th>
                            <th>صندوق / بانک</th>
                            <th>حساب سرمایه / برداشت مالک</th>
                            <th>توضیحات</th>
                            <th class="text-center" style="width:140px;">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (isLoading && !investments.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                    <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                </td>
                            </tr>
                        }
                        else if (!investments.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    هیچ سرمایه یا برداشتی ثبت نشده است.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;

                            @foreach (var item in investments)
                            {
                                <tr>
                                    <td>@index</td>

                                    <td dir="ltr">
                                        <AppDateTime Value="@item.InvestmentDate" />
                                    </td>
                                    <td>
                                        @(item.IsWithdrawal ? "برداشت مالک" : "افزایش سرمایه")
                                        @if (item.CancelledAt.HasValue)
                                        { <div class="small text-danger">لغوشده — <AppDateTime Value="item.CancelledAt" /></div> }
                                    </td>

                                    <td>
                                        <span class="badge-modern badge-secondary">
                                            @item.CurrencyCode
                                        </span>
                                    </td>

                                    <td dir="ltr" class="fw-bold text-primary">
                                        @MoneyFormatHelper.Format(item.Amount)
                                    </td>
                                    <td dir="ltr">
                                        @MoneyFormatHelper.Format(item.ProfitCurrencyAmount ?? 0)
                                        <span class="badge-modern badge-info">@item.ProfitCurrencyCode</span>
                                    </td>

                                    <td>
                                        @item.ReceivingAccountName
                                    </td>

                                    <td>
                                        @item.CapitalAccountName
                                    </td>

                                    <td>
                                        @(item.Description ?? "-")
                                    </td>

                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات ثبت سرمایه {item.Id}")">
                                            @if (!item.IsWithdrawal)
                                            {
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => EditInvestment(item.Id)">
                                                <i class="bi bi-pencil text-primary"></i>
                                                ویرایش
                                            </button>
                                            <div class="operation-menu-divider"></div>
                                            }
                                            @if (!item.CancelledAt.HasValue)
                                            {
                                            <button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" @onclick="() => AskDelete(item.Id)">
                                                <i class="bi bi-trash"></i>
                                                @(item.IsWithdrawal ? "لغو برداشت (ثبت معکوس)" : "حذف")
                                            </button>
                                            }
                                        </AppActionMenu>
                                    </td>
                                </tr>

                                index++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content capital-investment-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(model.IsWithdrawal ? "ثبت برداشت مالک" : isEditMode ? "ویرایش سرمایه" : "ثبت سرمایه جدید")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="modern-card mb-3">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-cash-stack"></i>
                                @(model.IsWithdrawal ? "معلومات برداشت مالک" : "معلومات سرمایه")
                            </h6>
                        </div>

                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        ارز <span class="text-danger">*</span>
                                    </label>

                                    <select class="form-select" @bind="model.CurrencyId">
                                        <option value="0">انتخاب ارز</option>

                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">
                                                @currency.Name
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        @(model.IsWithdrawal ? "مبلغ برداشت" : "مبلغ سرمایه") <span class="text-danger">*</span>
                                    </label>

                                    <MoneyInput class="form-control"
                                                @bind-Value="model.Amount"
                                                placeholder="مثلاً 100,000" />
                                </div>

                                @if (!model.IsWithdrawal)
                                {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        ارز محاسبه مفاد <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" @bind="model.ProfitCurrencyId">
                                        <option value="0">انتخاب ارز</option>
                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">@currency.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        ارزش افتتاحیه <span class="text-danger">*</span>
                                    </label>
                                    <MoneyInput class="form-control"
                                                @bind-Value="model.ProfitCurrencyAmount"
                                                placeholder="ارزش توافقی، بدون نرخ مرجع" />
                                    <small class="text-muted">بهای توافقی سرمایه در ارز محاسبه مفاد</small>
                                </div>
                                }
                                else
                                {
                                    <div class="col-12 alert alert-info">برداشت مصرف نیست و مفاد را کاهش نمی‌دهد. بهای آن در ارز اصلی با بهای تمام‌شدهٔ موجودی محاسبه می‌شود، نه نرخ دلخواه. لغو برداشت با ثبت معکوس انجام می‌شود.</div>
                                }

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        @(model.IsWithdrawal ? "حساب پرداخت‌کننده" : "حساب دریافت‌کننده") <span class="text-danger">*</span>
                                    </label>

                                     <AccountSearchSelect Accounts="@receivingAccounts"
                                                          @bind-Value="model.ReceivingAccountId"
                                                          ShowAccountCode="false"
                                                          Placeholder="جستجوی حساب دریافت‌کننده..." />

                                    <small class="text-muted">معمولاً صندوق یا حساب بانکی</small>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        حساب سرمایه مالک <span class="text-danger">*</span>
                                    </label>

                                     <AccountSearchSelect Accounts="@capitalAccounts"
                                                          @bind-Value="model.CapitalAccountId"
                                                          ShowAccountCode="false"
                                                          Placeholder="جستجوی حساب سرمایه..." />

                                    <small class="text-muted">معمولاً حساب سرمایه مالک</small>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        تاریخ و زمان
                                    </label>

                                    <PersianDatePicker @bind-Value="investmentDateLocal"
                                                       IncludeTime="true"
                                                       Placeholder="انتخاب تاریخ شمسی" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        توضیحات
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           @bind="model.Description"
                                           placeholder="مثلاً سرمایه ابتدایی مالک" />
                                </div>
                            </div>

                            <div class="alert alert-info mb-0">
                                <strong>سند حسابداری:</strong>

                                <div class="mt-2">
                                    @(model.IsWithdrawal ? "حساب برداشت مالک بدهکار و صندوق/بانک طلبکار می‌شود. حساب برداشت، جداگانه زیر حقوق مالکانه ایجاد می‌شود و مصرف نیست." : "حساب دریافت‌کننده بدهکار می‌شود و حساب سرمایه طلبکار می‌شود.")
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="Save"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi @(isEditMode ? "bi-pencil" : "bi-save")"></i>
                        }

                        @(model.IsWithdrawal ? "ثبت برداشت مالک" : isEditMode ? "ویرایش سرمایه" : "ثبت سرمایه")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @(DeletingWithdrawal ? "تأیید لغو برداشت" : "تأیید حذف")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CancelDelete"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>

                    <p class="fs-5">
                        @(DeletingWithdrawal ? "آیا برداشت مالک با ثبت معکوس لغو شود؟" : "آیا مطمئن هستید که می‌خواهید این ثبت سرمایه را حذف کنید؟")
                    </p>

                    <p class="text-muted small">
                        @(DeletingWithdrawal ? "ثبت اصلی محفوظ می‌ماند و مبلغ با ثبت معکوس به صندوق/بانک برمی‌گردد؛ این لغو باید با برگشت واقعی پول همراه باشد." : "با حذف آن، لیجرهای مربوط به این سرمایه نیز حذف می‌شود.")
                    </p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CancelDelete">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-danger-modern"
                            @onclick="ConfirmDelete"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                        }

                        @(DeletingWithdrawal ? "لغو برداشت" : "حذف")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CreateCapitalInvestmentDto model = new();

    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();
    private List<AccountDto> receivingAccounts = new();
    private List<AccountDto> capitalAccounts = new();
    private List<CapitalInvestmentDto> investments = new();
    private long defaultProfitCurrencyId;

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private bool isLoading = false;

    private bool showModal = false;
    private bool isEditMode = false;
    private long editId = 0;

    private bool showDeleteConfirm = false;
    private long deleteId = 0;
    private bool DeletingWithdrawal => investments.Any(x => x.Id == deleteId && x.IsWithdrawal);

    private DateTime investmentDateLocal = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadInvestments();
        ResetForm();
    }

    private async Task LoadData()
    {
        try
        {
            currencies = (await CurrencyService.GetActiveCurrenciesAsync()).ToList();
            var companySetting = await CompanySettingService.GetAsync();
            defaultProfitCurrencyId = currencies
                .FirstOrDefault(x => x.Id == companySetting.DefaultProfitCurrencyId)?.Id ?? 0;

            accounts = (await AccountService.GetAllAsync())
                .Where(x => !x.IsArchived)
                .ToList();

            receivingAccounts = accounts
                .Where(x => x.AccountType == "Cash" || x.AccountType == "Bank")
                .OrderBy(x => x.AccountCode)
                .ToList();

            capitalAccounts = accounts
                .Where(x => x.AccountType == "Equity" && !x.AccountCode.StartsWith("OWNER-DRAW-", StringComparison.Ordinal))
                .OrderBy(x => x.AccountCode)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات اولیه: {ex.Message}");
        }
    }

    private async Task LoadInvestments()
    {
        try
        {
            investments = await CapitalInvestmentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری لیست سرمایه‌ها: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        ResetForm();
        showModal = true;
    }

    private void OpenWithdrawalModal()
    {
        ResetForm();
        model.IsWithdrawal = true;
        model.Description = "برداشت مالک";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        validationErrors.Clear();
    }

    private void ResetForm()
    {
        isEditMode = false;
        editId = 0;

        var afn = currencies.FirstOrDefault(x =>
            x.Code.Equals("AFN", StringComparison.OrdinalIgnoreCase));

        var cash = receivingAccounts.FirstOrDefault(x =>
            x.AccountType == "Cash");

        var ownerCapital = capitalAccounts.FirstOrDefault(x =>
            x.AccountCode == "5001" ||
            x.AccountName.Contains("Capital", StringComparison.OrdinalIgnoreCase) ||
            x.AccountName.Contains("سرمایه", StringComparison.OrdinalIgnoreCase));

        model = new CreateCapitalInvestmentDto
        {
            CurrencyId = afn?.Id ?? 0,
            ProfitCurrencyId = defaultProfitCurrencyId,
            ProfitCurrencyAmount = 0,
            ReceivingAccountId = cash?.Id ?? 0,
            CapitalAccountId = ownerCapital?.Id ?? 0,
            InvestmentDate = DateTime.UtcNow,
            Description = "ثبت سرمایه مالک"
        };

        investmentDateLocal = DateTime.Now;
        validationErrors.Clear();
        successMessage = string.Empty;
    }

    private async Task EditInvestment(long id)
    {
        try
        {
            validationErrors.Clear();
            successMessage = string.Empty;

            var investment = await CapitalInvestmentService.GetByIdAsync(id);

            if (investment == null)
            {
                validationErrors.Add("ثبت سرمایه یافت نشد.");
                return;
            }

            model = new CreateCapitalInvestmentDto
            {
                CurrencyId = investment.CurrencyId,
                Amount = investment.Amount,
                ProfitCurrencyId = investment.ProfitCurrencyId ?? 0,
                ProfitCurrencyAmount = investment.ProfitCurrencyAmount ?? 0,
                ReceivingAccountId = investment.ReceivingAccountId,
                CapitalAccountId = investment.CapitalAccountId,
                InvestmentDate = investment.InvestmentDate,
                Description = investment.Description
            };

            investmentDateLocal = investment.InvestmentDate.ToLocalTime();

            isEditMode = true;
            editId = id;
            showModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری سرمایه برای ویرایش: {ex.Message}");
        }
    }

    private async Task Save()
    {
        if (isLoading) return;
        validationErrors.Clear();
        successMessage = string.Empty;

        ValidateForm();

        if (validationErrors.Any())
            return;

        try
        {
            isLoading = true;

            model.InvestmentDate = investmentDateLocal.ToUniversalTime();

            if (isEditMode)
            {
                var updateDto = new UpdateCapitalInvestmentDto
                {
                    CurrencyId = model.CurrencyId,
                    Amount = model.Amount,
                    ProfitCurrencyId = model.ProfitCurrencyId,
                    ProfitCurrencyAmount = model.ProfitCurrencyAmount,
                    ReceivingAccountId = model.ReceivingAccountId,
                    CapitalAccountId = model.CapitalAccountId,
                    InvestmentDate = model.InvestmentDate,
                    Description = model.Description
                };

                await CapitalInvestmentService.UpdateAsync(editId, updateDto);
                successMessage = "ثبت سرمایه با موفقیت ویرایش شد.";
            }
            else
            {
                await CapitalInvestmentService.CreateAsync(model);
                successMessage = model.IsWithdrawal ? "برداشت مالک با ثبت حسابداری مستقل ثبت شد." : "سرمایه با موفقیت در دفتر کل ثبت شد.";
            }

            await LoadInvestments();

            showModal = false;
            ResetForm();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره سرمایه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ValidateForm()
    {
        if (model.CurrencyId <= 0)
            validationErrors.Add("انتخاب ارز الزامی است.");

        if (model.Amount <= 0)
            validationErrors.Add("مبلغ سرمایه باید بزرگتر از صفر باشد.");

        if (model.ProfitCurrencyId <= 0)
            validationErrors.Add("انتخاب ارز محاسبه مفاد الزامی است.");

        if (!model.IsWithdrawal && model.ProfitCurrencyAmount <= 0)
            validationErrors.Add("ارزش افتتاحیه سرمایه باید بزرگتر از صفر باشد.");

        if (model.ReceivingAccountId <= 0)
            validationErrors.Add("انتخاب حساب دریافت‌کننده الزامی است.");

        if (model.CapitalAccountId <= 0)
            validationErrors.Add("انتخاب حساب سرمایه الزامی است.");

        if (model.ReceivingAccountId == model.CapitalAccountId)
            validationErrors.Add("حساب دریافت‌کننده و حساب سرمایه نمی‌تواند یکی باشد.");
    }

    private void AskDelete(long id)
    {
        deleteId = id;
        showDeleteConfirm = true;
        validationErrors.Clear();
        successMessage = string.Empty;
    }

    private void CancelDelete()
    {
        deleteId = 0;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            validationErrors.Clear();
            successMessage = string.Empty;

            isLoading = true;

            await CapitalInvestmentService.DeleteAsync(deleteId);

            successMessage = DeletingWithdrawal ? "برداشت مالک با ثبت معکوس لغو شد؛ سابقه محفوظ است." : "ثبت سرمایه با موفقیت حذف شد.";

            if (isEditMode && editId == deleteId)
            {
                ResetForm();
                showModal = false;
            }

            showDeleteConfirm = false;
            deleteId = 0;

            await LoadInvestments();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف سرمایه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
