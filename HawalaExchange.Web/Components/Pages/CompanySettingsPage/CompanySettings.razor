@page "/company-settings"

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject ICompanySettingService CompanySettingService
@inject ICurrencyService CurrencyService
@inject IFileService FileService

@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-building"></i>
                تنظیمات شرکت
                <span class="page-subtitle">تنظیم معلومات شرکت و ارز اصلی محاسبه مفاد و ضرر</span>
            </h5>
        </div>
    </div>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    <div class="modern-card">
        <div class="card-header">
            <h6 class="text-primary mb-0">
                <i class="bi bi-gear"></i>
                معلومات عمومی شرکت
            </h6>
        </div>

        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="text-muted mt-2">در حال بارگذاری تنظیمات...</p>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            نام شرکت <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.CompanyName"
                               placeholder="مثلاً صرافی نمونه" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            شماره تماس
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.PhoneNumber"
                               placeholder="مثلاً 0700000000" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            شماره واتساپ
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.WhatsAppNumber"
                               placeholder="مثلاً 93700000000" />

                        <small class="text-muted">
                            برای لینک واتساپ، بهتر است کد کشور هم نوشته شود.
                        </small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            نام کاربری تلگرام
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.TelegramUserName"
                               placeholder="مثلاً mycompany" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">
                            آدرس شرکت
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.Address"
                               placeholder="آدرس کامل شرکت" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            ارز اصلی محاسبه مفاد و ضرر <span class="text-danger">*</span>
                        </label>

                        <select class="form-select" @bind="setting.DefaultProfitCurrencyId">
                            <option value="">انتخاب ارز اصلی</option>
                            @foreach (var currency in activeCurrencies)
                            {
                                <option value="@currency.Id">@currency.Code - @currency.Name</option>
                            }
                        </select>

                        <small class="text-muted">
                            بهای تمام‌شده، مفاد و ضرر تبدیل‌های جدید با این ارز محاسبه می‌شود؛ در فرم تبدیل پول دیگر نیاز به انتخاب آن نیست.
                        </small>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            لوگوی شرکت
                        </label>

                        <InputFile class="form-control"
                                   OnChange="OnLogoUpload"
                                   accept="image/*" />

                        <small class="text-muted">
                            فرمت‌های مجاز: jpg, png, jpeg. حداکثر ۵ مگابایت.
                        </small>

                        @if (!string.IsNullOrWhiteSpace(setting.LogoPath))
                        {
                            <div class="mt-3 d-flex align-items-center gap-3">
                                <img src="@setting.LogoPath"
                                     style="width: 90px; height: 90px; object-fit: contain; border: 1px solid #ddd; border-radius: 10px; padding: 6px;" />

                                <div>
                                    <a href="@setting.LogoPath"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                        مشاهده لوگو
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger ms-2"
                                            @onclick="RemoveLogo">
                                        <i class="bi bi-trash"></i>
                                        حذف لوگو
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            مسیر لوگو
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="setting.LogoPath"
                               placeholder="/uploads/company/logo.png" />

                        <small class="text-muted">
                            اگر لوگو را دستی در سرور گذاشتید، مسیر آن را اینجا وارد کنید.
                        </small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">
                            متن پایین رسید
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  @bind="setting.FooterNote"
                                  placeholder="مثلاً تشکر از اعتماد شما"></textarea>
                    </div>
                </div>

                <div class="alert alert-info">
                    <strong>استفاده:</strong>
                    معلومات شرکت در رسیدها نمایش داده می‌شود و ارز اصلی در محاسبه بهای تمام‌شده، مفاد و ضرر تبدیل‌های جدید استفاده می‌گردد.
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="LoadSetting">
                        <i class="bi bi-arrow-clockwise"></i>
                        بازنشانی
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="Save"
                            disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }

                        ذخیره تنظیمات
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CompanySettingDto setting = new();
    private List<CurrencyDto> activeCurrencies = new();

    private List<string> validationErrors = new();

    private string successMessage = string.Empty;

    private bool isLoading = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSetting();
    }

    private async Task LoadSetting()
    {
        try
        {
            isLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;

            activeCurrencies = (await CurrencyService.GetActiveCurrenciesAsync())
                .OrderBy(x => x.Code)
                .ToList();
            setting = await CompanySettingService.GetAsync();

            if (!setting.DefaultProfitCurrencyId.HasValue)
            {
                setting.DefaultProfitCurrencyId = activeCurrencies
                    .FirstOrDefault(x =>
                        x.Code.Equals("AFN", StringComparison.OrdinalIgnoreCase))?.Id
                    ?? activeCurrencies.FirstOrDefault()?.Id;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری تنظیمات شرکت: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(setting.CompanyName))
            validationErrors.Add("نام شرکت الزامی است.");

        if (!setting.DefaultProfitCurrencyId.HasValue ||
            activeCurrencies.All(x => x.Id != setting.DefaultProfitCurrencyId.Value))
        {
            validationErrors.Add("انتخاب یک ارز فعال به عنوان ارز اصلی محاسبه مفاد و ضرر الزامی است.");
        }

        if (validationErrors.Any())
            return;

        try
        {
            isSaving = true;

            setting = await CompanySettingService.SaveAsync(setting);

            successMessage = "تنظیمات شرکت با موفقیت ذخیره شد.";
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره تنظیمات شرکت: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task OnLogoUpload(InputFileChangeEventArgs e)
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        var file = e.File;

        if (file == null)
            return;

        try
        {
            if (file.Size > 5 * 1024 * 1024)
            {
                validationErrors.Add("حجم لوگو نباید بیشتر از ۵ مگابایت باشد.");
                return;
            }

            if (!file.ContentType.StartsWith("image/"))
            {
                validationErrors.Add("فایل لوگو باید عکس باشد.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);

            var result = await FileService.UploadFileAsync(stream, file.Name, "company-logo");

            if (!result.Success)
            {
                validationErrors.Add("آپلود لوگو موفق نشد.");
                return;
            }

            setting.LogoPath = result.FilePath;

            successMessage = "لوگو با موفقیت آپلود شد. برای ثبت نهایی، دکمه ذخیره تنظیمات را کلیک کنید.";
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در آپلود لوگو: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RemoveLogo()
    {
        try
        {
            validationErrors.Clear();
            successMessage = string.Empty;

            if (!string.IsNullOrWhiteSpace(setting.LogoPath))
            {
                await FileService.DeleteFileAsync(setting.LogoPath);
            }

            setting.LogoPath = null;

            successMessage = "لوگو حذف شد. برای ثبت نهایی، دکمه ذخیره تنظیمات را کلیک کنید.";
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف لوگو: {ex.Message}");
        }
    }
}
