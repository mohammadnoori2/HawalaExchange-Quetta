@page "/correspondents/{CorrespondentId:long}/commission"
@page "/correspondents/{CorrespondentId:long}/outgoing-commission"
@page "/commissions/{CorrespondentId:long}"
@page "/correspondents/{CorrespondentId:long}/forwarding-commission"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject ICorrespondentService CorrespondentService
@inject ICorrespondentCommissionService CommissionService
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@(isOrigin ? "کمیشن ارسالی به نمایندگی‌ها" : isOutgoing ? "کمیشن پرداختی به نمایندگی‌ها" : "کمیشن حواله‌های دریافتی")</PageTitle>

<div class="page-wrapper" dir="rtl">
    <AppPageHeader Title="@(isOrigin ? "کمیشن ارسالی به نمایندگی‌ها" : isOutgoing ? "کمیشن پرداختی به نمایندگی‌ها" : "کمیشن حواله‌های دریافتی")"
                   Subtitle="@(isOrigin ? "درآمد ارسال مجدد به تفکیک محل پرداخت در حساب نمایندگی فرستنده" : isOutgoing ? "هزینه شرکت و طلب نمایندگی مقصد، به تفکیک محل پرداخت و ارز" : "درآمد دریافت حواله با نرخ پایان روز نمایندگی فرستنده")"
                   Icon="bi-calculator">
        <Actions>
            <button class="btn-modern btn-light-modern" @onclick="BackToCorrespondent">
                <i class="bi bi-arrow-right"></i> بازگشت به نمایندگی
            </button>
        </Actions>
    </AppPageHeader>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@success</div>
    }

    @if (loadingPage)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (correspondent == null)
    {
        <div class="alert alert-warning">نمایندگی یافت نشد.</div>
    }
    else
    {
        <div class="modern-card mb-4">
            <div class="card-header"><h6 class="text-primary mb-0"><i class="bi bi-building me-2"></i>@correspondent.Name (@correspondent.Code)</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">از تاریخ</label>
                        <PersianDatePicker @bind-Value="request.PeriodFrom" @bind-Value:after="InvalidatePreview" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">تا تاریخ</label>
                        <PersianDatePicker @bind-Value="request.PeriodTo" @bind-Value:after="InvalidatePreview" />
                    </div>
                    @if (!isOrigin && !isOutgoing)
                    {
                    <div class="col-md-3">
                        <label class="form-label fw-bold">کمیشن USD هر لک از مبنای دالری</label>
                        <MoneyInput class="form-control" DecimalPlaces="2" @bind-Value="request.CommissionPerLakhAfn" @bind-Value:after="InvalidatePreview" />
                    </div>
                    }
                </div>
                <div class="alert alert-info mt-3 mb-0">
                    @if (isOutgoing)
                    {
                        <span>برای هر محل پرداخت، کمیشن هر لک AFN و USD را جدا وارد کنید؛ نرخ محل‌های مختلف می‌تواند متفاوت باشد. مقصد به همان ارز طلبکار و حساب هزینه شرکت بدهکار می‌شود؛ بدهی برای فرستنده ثبت نمی‌شود.</span>
                    }
                    else if (isOrigin)
                    {
                        <span>فقط مبلغ واقعاً ارسال‌شده به نمایندگی‌ها، به تفکیک محل پرداخت، محاسبه می‌شود. محل پرداخت خود صرافی شامل نیست. نرخ تبدیل، نرخ پایان روز حواله اصلی در همین نمایندگی فرستنده است؛ بازه تاریخ مربوط به روز ارسال است.</span>
                    }
                    else
                    {
                        <span>تمام حواله‌های دریافتی واجد شرایط محاسبه می‌شوند. مبلغ افغانی هر حواله با نرخ پایان روز همان حواله در همین نمایندگی فرستنده به دالر تبدیل می‌شود.</span>
                    }
                </div>
                <div class="mt-3">
                    <button class="btn-modern btn-primary-modern" disabled="@(busy || calculating)" @onclick="LoadPreview">
                        @if (calculating)
                        { <span class="spinner-border spinner-border-sm ms-1" aria-hidden="true"></span><span>در حال محاسبه...</span> }
                        else
                        { <i class="bi bi-search"></i><span>@(preview is not null && (isOutgoing || isOrigin) ? "بازمحاسبه با نرخ‌های واردشده" : "نمایش حواله‌های محاسبه‌نشده")</span> }
                    </button>
                </div>
            </div>
        </div>

        @if (isOutgoing && request.LocationCurrencyRates.Count > 0)
        {
            <div class="modern-card mb-4 p-3">
                <h6 class="fw-bold">کمیشن هر لک به تفکیک محل پرداخت و ارز در نمایندگی مقصد</h6>
                <p class="text-muted small">نرخ‌ها برای همین محاسبه اعمال می‌شوند. پس از تغییر هر نرخ، «بازمحاسبه» را بزنید و سپس ثبت حسابداری کنید.</p>
                <div class="table-responsive"><table class="table table-sm align-middle">
                    <thead><tr><th>محل پرداخت</th><th>ارز</th><th>تعداد حواله</th><th>مجموع مبلغ</th><th>کمیشن هر لک</th><th>کمیشن</th></tr></thead>
                    <tbody>@foreach (var currencyRate in request.LocationCurrencyRates)
                    {
                        <tr><td>@currencyRate.PaymentLocationName</td><td>@currencyRate.CurrencyCode</td><td>@currencyRate.HawalaCount</td>
                            <td dir="ltr">@currencyRate.TotalAmount.ToString("N2") @currencyRate.CurrencyCode</td>
                            <td style="width:180px"><input type="number" lang="en" min="0.0001" step="0.0001" class="form-control"
                                   @bind="currencyRate.PerLakhRate" @bind:after="InvalidatePreview" /></td>
                            <td dir="ltr">@(calculated ? currencyRate.CommissionAmount.ToString("N2") : "—") @currencyRate.CurrencyCode</td></tr>
                    }</tbody>
                </table></div>
            </div>
        }

        @if (isOrigin && request.PaymentLocationRates.Count > 0)
        {
            var amountsByLocation = preview?.Items
                .GroupBy(x => x.PaymentLocationId ?? 0)
                .ToDictionary(group => group.Key, group => new
                {
                    Afn = group.Where(x => x.CurrencyCode == "AFN").Sum(x => x.SourceAmount),
                    Usd = group.Where(x => x.CurrencyCode == "USD").Sum(x => x.SourceAmount)
                });
            <div class="modern-card mb-4 p-3">
                <h6 class="fw-bold">کمیشن ارسالی به نمایندگی‌ها به تفکیک محل پرداخت</h6>
                <p class="text-muted small">مبلغ دلاری هر لک را برای هر محل وارد کرده و سپس باز‌محاسبه کنید.</p>
                <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div>
                        <label class="form-label" for="origin-rate-for-all">کمیشن USD هر لک برای همه</label>
                        <input id="origin-rate-for-all" type="number" lang="en" min="0.0001" step="0.0001" class="form-control" @bind="originRateForAll" />
                    </div>
                    <button class="btn btn-outline-primary" disabled="@busy" @onclick="ApplyOriginRateToAll">اعمال به همه</button>
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle">
                    <thead><tr><th>محل پرداخت</th><th>حواله</th><th>مجموع افغانی (AFN)</th><th>مجموع دالر (USD)</th><th>مبلغ مبنا USD</th><th>کمیشن USD هر لک</th><th>کمیشن USD</th></tr></thead>
                    <tbody>@foreach (var locationRate in request.PaymentLocationRates)
                    {
                        var amounts = amountsByLocation?.GetValueOrDefault(locationRate.PaymentLocationId);
                        <tr><td>@locationRate.PaymentLocationName</td><td>@locationRate.HawalaCount</td>
                            <td dir="ltr">@((amounts?.Afn ?? 0m).ToString("N2")) AFN</td>
                            <td dir="ltr">@((amounts?.Usd ?? 0m).ToString("N2")) USD</td>
                            <td dir="ltr">@locationRate.TotalDebitUsd.ToString("N2")</td>
                            <td><input type="number" lang="en" min="0.0001" step="0.0001" class="form-control" @bind="locationRate.PerLakhRate" @bind:after="InvalidatePreview" /></td>
                            <td dir="ltr">@(calculated ? locationRate.TotalCommissionUsd.ToString("N2") : "—")</td></tr>
                    }</tbody>
                </table></div>
            </div>
        }

        @if (preview != null)
        {
            @if (preview.Items.Any(x => x.SourceAmount < 0))
            { <div class="alert alert-info">حواله‌های لغوشده با سهم کمیشن ثبت‌شدهٔ قبلی کسر می‌شوند؛ نرخ جدید روی آن‌ها اعمال نمی‌شود.</div> }
            @if (preview.HawalaCount == 0)
            {
                <div class="modern-card mb-4 p-4 text-muted">@(isOrigin ? "حوالهٔ واجد شرایط برای کمیشن ارسالی وجود ندارد؛ محل پرداخت خود صرافی شامل نیست." : "در این دوره حواله محاسبه‌نشده‌ای وجود ندارد.")</div>
            }

            @if (calculated && preview.HawalaCount > 0)
            {
                @if (isOrigin)
                {
                    <CommissionCurrencySummary Items="preview.Items" />
                }
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><div class="modern-card p-3"><small>تعداد حواله</small><h4>@preview.HawalaCount</h4></div></div>
                    @if (!isOutgoing && !isOrigin)
                    {
                        <div class="col-md-3"><div class="modern-card p-3"><small>مجموع حواله‌های دریافتی (USD)</small><h4 dir="ltr">@preview.TotalSourceUsd.ToString("N2") USD</h4></div></div>
                        <div class="col-md-3"><div class="modern-card p-3"><small>مجموع حواله‌های دریافتی (AFN)</small><h4 dir="ltr">@preview.TotalSourceAfn.ToString("N2") AFN</h4></div></div>
                    }
                    @if (!isOutgoing)
                    { <div class="col-md-3"><div class="modern-card p-3"><small>مجموع مبنا (USD)</small><h4>@preview.TotalBaseAfn.ToString("N2")</h4></div></div> }
                    @if (isOutgoing)
                    {
                        <div class="col-md-3"><div class="modern-card p-3"><small>مجموع حواله‌های ارسالی (USD)</small><h4>@preview.TotalSourceUsd.ToString("N2")</h4></div></div>
                        <div class="col-md-3"><div class="modern-card p-3"><small>مجموع حواله‌های ارسالی (AFN)</small><h4>@preview.TotalSourceAfn.ToString("N2")</h4></div></div>
                        <div class="col-md-3"><div class="modern-card p-3"><small>طلب مقصد (AFN)</small><h4>@preview.TotalCommissionAfn.ToString("N2")</h4></div></div>
                        <div class="col-md-3"><div class="modern-card p-3"><small>طلب مقصد (USD)</small><h4>@preview.TotalCommissionUsd.ToString("N2")</h4></div></div>
                    }
                    else
                    {
                        @if (!isOrigin)
                        { <div class="col-md-3"><div class="modern-card p-3"><small>کمیشن هر لک (USD)</small><h4>@request.CommissionPerLakhAfn.ToString("N2")</h4></div></div> }
                        <div class="col-md-3"><div class="modern-card p-3"><small>کمیشن نهایی (USD)</small><h4>@preview.TotalCommissionUsd.ToString("N2")</h4></div></div>
                    }
                </div>

                <div class="table-card mb-4">
                    <div class="table-card-body"><div class="table-scroll-wrapper">
                        <GlobalDataGrid class="table-modern table-striped-modern">
                            <thead><tr><th>نمبر</th><th>تاریخ</th>@if (isOutgoing || isOrigin){<th>محل پرداخت</th><th>کمیشن هر لک</th>}<th>مبلغ</th>@if (!isOutgoing){<th>روز نرخ</th><th>نرخ روز USD/AFN</th><th>مبنای USD</th>}<th>@(isOutgoing ? "کمیشن به ارز اصلی" : "سهم کمیشن USD")</th></tr></thead>
                            <tbody>
                            @foreach (var item in preview.Items)
                            {
                                <tr><td>@item.HawalaNumber</td><td>@DisplayDates.Date(item.HawalaDate)</td>
                                    @if (isOutgoing || isOrigin)
                                    {
                                        <td>@item.PaymentLocationName</td><td dir="ltr">@item.PerLakhRate.ToString("N2")</td>
                                    }
                                    <td dir="ltr">@item.SourceAmount.ToString("N2") @item.CurrencyCode</td>
                                    @if (isOutgoing)
                                    {
                                        <td dir="ltr">@item.CommissionAfn.ToString("N2") @item.CurrencyCode</td>
                                    }
                                    else
                                    {
                                        <td>@DisplayDates.Date(item.ValuationDate)</td><td dir="ltr">@item.SourceToAfnRate.ToString("N4")</td>
                                        <td dir="ltr">@item.AfnEquivalent.ToString("N2") USD</td><td dir="ltr">@item.CommissionAfn.ToString("N2") USD</td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </GlobalDataGrid>
                    </div></div>
                </div>

                <div class="alert alert-warning d-flex justify-content-between align-items-center">
                    <span>@(isOutgoing
                        ? $"پس از تأیید، مقصد {preview.TotalCommissionAfn:N2} AFN و {preview.TotalCommissionUsd:N2} USD طلبکار و هزینه شرکت ثبت می‌شود؛ فرستنده بدهکار نمی‌شود."
                        : $"پس از تأیید، نمایندگی فرستنده {preview.TotalCommissionUsd:N2} USD بدهکار و درآمد کمیشن ثبت می‌شود.")</span>
                    <button class="btn-modern btn-success-modern" disabled="@busy" @onclick="PostBatch">
                        <i class="bi bi-check2-circle"></i> تأیید و ثبت حسابداری
                    </button>
                </div>
            }
        }

        <div class="modern-card mt-4">
            <div class="card-header"><h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>تاریخچه محاسبات</h6></div>
            <div class="card-body">
                @if (history.Count == 0)
                {
                    <div class="text-muted">هنوز محاسبه‌ای ثبت نشده است.</div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-hover align-middle">
                        <thead><tr><th>دوره</th><th>حواله</th><th>کمیشن</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                        <tbody>@foreach (var batch in history)
                        {
                            <tr><td>@DisplayDates.Date(batch.PeriodFrom) تا @DisplayDates.Date(batch.PeriodTo)</td><td>@batch.HawalaCount</td>
                                <td>@if (isOutgoing)
                                    {<span>@batch.TotalCommissionAfn.ToString("N2") AFN / @batch.TotalCommissionUsd.ToString("N2") USD</span>}
                                    else
                                    {<span>@batch.TotalCommissionUsd.ToString("N2") USD</span>}</td>
                                <td><span class="badge @(batch.Status == "Posted" ? "bg-success" : "bg-secondary")">@(batch.Status == "Posted" ? "ثبت‌شده" : "برگشت‌شده")</span></td>
                                <td><div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="() => ShowDetails(batch.Id)">
                                        <i class="bi bi-eye"></i> جزئیات
                                    </button>
                                    @if (batch.Status == "Posted")
                                    {<button class="btn btn-sm btn-outline-danger" @onclick="() => SelectReverse(batch.Id)">برگشت</button>}
                                </div></td></tr>
                            @if (isOrigin && batch.LocationSummaries.Count > 0)
                            {
                                <tr><td colspan="5" class="bg-light">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var location in batch.LocationSummaries)
                                        {
                                            <span class="badge text-bg-light border text-dark">@location.PaymentLocationName: @location.TotalCommissionUsd.ToString("N2") USD (@location.HawalaCount حواله)</span>
                                        }
                                    </div>
                                </td></tr>
                            }
                        }</tbody>
                    </table></div>
                }
            </div>
        </div>
    }
</div>

@if (selectedDetails != null)
{
    var detailsOrigin = selectedDetails.CommissionScope is "Origin" or "Forwarding";
    var detailsOutgoing = selectedDetails.HawalaType == "HawalaSend" && !detailsOrigin;
    var legacyOutgoing = detailsOutgoing && selectedDetails.AccountingVersion < 2;
    <div class="modal show d-block" style="background:rgba(0,0,0,.5)" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">جزئیات محاسبه کمیشن #@selectedDetails.Id</h5>
                    <small class="text-muted">@selectedDetails.CorrespondentName — @DisplayDates.Date(selectedDetails.PeriodFrom) تا @DisplayDates.Date(selectedDetails.PeriodTo)</small>
                </div>
                <button type="button" class="btn-close" @onclick="CloseDetails"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">نوع محاسبه</small><div class="fw-bold">@(detailsOrigin ? "کمیشن ارسالی به نمایندگی‌ها" : detailsOutgoing ? "کمیشن پرداختی به نمایندگی‌ها" : "کمیشن حواله‌های دریافتی")</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">تعداد حواله</small><div class="fw-bold">@selectedDetails.HawalaCount</div></div></div>
                    @if (selectedDetails.CommissionScope == "Standard")
                    { <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">کمیشن هر لک</small><div class="fw-bold">@selectedDetails.CommissionPerLakhAfn.ToString("N2")</div></div></div> }
                    <div class="col-md-3"><div class="border rounded p-3"><small class="text-muted">وضعیت</small><div><span class="badge @(selectedDetails.Status == "Posted" ? "bg-success" : "bg-secondary")">@(selectedDetails.Status == "Posted" ? "ثبت‌شده" : "برگشت‌شده")</span></div></div></div>
                    @if (!detailsOutgoing && !detailsOrigin)
                    {
                        <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">مجموع حواله‌های دریافتی USD</small><div class="fw-bold" dir="ltr">@selectedDetails.TotalSourceUsd.ToString("N2") USD</div></div></div>
                        <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">مجموع حواله‌های دریافتی AFN</small><div class="fw-bold" dir="ltr">@selectedDetails.TotalSourceAfn.ToString("N2") AFN</div></div></div>
                    }
                    @if (detailsOutgoing)
                    {
                        <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">مجموع حواله‌های ارسالی USD</small><div class="fw-bold">@selectedDetails.TotalSourceUsd.ToString("N2") USD</div></div></div>
                        <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">مجموع حواله‌های ارسالی AFN</small><div class="fw-bold">@selectedDetails.TotalSourceAfn.ToString("N2") AFN</div></div></div>
                    }
                    @if (!detailsOutgoing || legacyOutgoing)
                    { <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">@(legacyOutgoing ? "بدهی فرستنده در ثبت قبلی" : "مبنای محاسبه")</small><div class="fw-bold">@selectedDetails.TotalBaseAfn.ToString("N2") USD</div></div></div> }
                    <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">کمیشن AFN</small><div class="fw-bold">@selectedDetails.TotalCommissionAfn.ToString("N2") AFN</div></div></div>
                    <div class="col-md-4"><div class="border rounded p-3"><small class="text-muted">کمیشن USD</small><div class="fw-bold">@selectedDetails.TotalCommissionUsd.ToString("N2") USD</div></div></div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3"><small class="text-muted d-block">سند اصلی</small><strong>@selectedDetails.PostingTransactionNo</strong></div>
                    <div class="col-md-3"><small class="text-muted d-block">ثبت‌کننده</small><strong>@selectedDetails.CreatedByName</strong></div>
                    <div class="col-md-3"><small class="text-muted d-block">زمان ثبت</small><strong>@DisplayDates.DateTime(selectedDetails.CreatedAt, true)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(selectedDetails.ReversalTransactionNo))
                    {
                        <div class="col-md-3"><small class="text-muted d-block">سند برگشت</small><strong>@selectedDetails.ReversalTransactionNo</strong></div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedDetails.ReversalReason))
                {
                    <div class="alert alert-secondary"><strong>دلیل برگشت:</strong> @selectedDetails.ReversalReason</div>
                }

                @if (detailsOutgoing)
                {
                    <h6 class="fw-bold mb-3">کمیشن به تفکیک محل پرداخت، ارز و نرخ ثبت‌شده</h6>
                    <div class="table-responsive mb-4"><table class="table table-sm table-bordered align-middle">
                        <thead><tr><th>محل پرداخت</th><th>ارز</th><th>تعداد</th><th>مجموع مبلغ</th><th>کمیشن هر لک</th><th>کمیشن</th></tr></thead>
                        <tbody>@foreach (var location in selectedDetails.Items
                            .GroupBy(x => new { x.PaymentLocationId, x.PaymentLocationName, x.CurrencyCode, x.PerLakhRate })
                            .OrderBy(x => x.Key.PaymentLocationName).ThenBy(x => x.Key.CurrencyCode).ThenBy(x => x.Key.PerLakhRate))
                        {
                            <tr><td>@location.Key.PaymentLocationName</td><td>@location.Key.CurrencyCode</td><td>@location.Count()</td>
                                <td dir="ltr">@location.Sum(x => x.SourceAmount).ToString("N2") @location.Key.CurrencyCode</td>
                                <td dir="ltr">@location.Key.PerLakhRate.ToString("N2")</td>
                                <td dir="ltr">@location.Sum(x => x.CommissionAfn).ToString("N2") @location.Key.CurrencyCode</td></tr>
                        }</tbody>
                    </table></div>
                }

                @if (detailsOrigin)
                {
                    <CommissionCurrencySummary Items="selectedDetails.Items" />
                    <h6 class="fw-bold mb-3">خلاصه به تفکیک محل پرداخت</h6>
                    <div class="table-responsive mb-4"><table class="table table-sm table-bordered align-middle">
                        <thead><tr><th>محل پرداخت</th><th>تعداد</th><th>مجموع افغانی (AFN)</th><th>مجموع دالر (USD)</th><th>مبنای USD</th><th>کمیشن USD</th></tr></thead>
                        <tbody>@foreach (var location in selectedDetails.Items
                            .GroupBy(x => new { x.PaymentLocationId, x.PaymentLocationName })
                            .OrderBy(x => x.Key.PaymentLocationName))
                        {
                            <tr><td>@location.Key.PaymentLocationName</td><td>@location.Count()</td>
                                <td dir="ltr">@location.Where(x => x.CurrencyCode == "AFN").Sum(x => x.SourceAmount).ToString("N2") AFN</td>
                                <td dir="ltr">@location.Where(x => x.CurrencyCode == "USD").Sum(x => x.SourceAmount).ToString("N2") USD</td>
                                <td dir="ltr">@location.Sum(x => x.AfnEquivalent).ToString("N2")</td>
                                <td dir="ltr">@location.Sum(x => x.CommissionAfn).ToString("N2")</td></tr>
                        }</tbody>
                    </table></div>
                }

                <h6 class="fw-bold mb-3">جزئیات تمام حواله‌ها</h6>
                <div class="table-responsive mb-4"><table class="table table-sm table-hover align-middle">
                    <thead><tr><th>نمبر</th><th>تاریخ</th>@if (detailsOutgoing || detailsOrigin){<th>منبع حواله</th><th>محل پرداخت</th><th>کمیشن هر لک</th>}<th>مبلغ</th>@if (!detailsOutgoing || legacyOutgoing){<th>روز نرخ</th><th>نرخ روز</th>}<th>@(detailsOutgoing ? "کمیشن" : "مبنای USD")</th>@if (!detailsOutgoing || legacyOutgoing){<th>@(legacyOutgoing ? "معادل USD در ثبت قبلی" : "سهم کمیشن USD")</th>}<th>وضعیت</th></tr></thead>
                    <tbody>@foreach (var item in selectedDetails.Items)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary" : null)">
                            <td>@item.HawalaNumber</td><td>@DisplayDates.Date(item.HawalaDate)</td>
                            @if (detailsOutgoing || detailsOrigin)
                            {
                                <td><span class="badge @(item.SourceType == "OwnOffice" ? "bg-primary" : "bg-info text-dark")">@item.SourceName</span></td>
                                <td>@item.PaymentLocationName</td><td dir="ltr">@item.PerLakhRate.ToString("N2")</td>
                            }
                            <td dir="ltr">@item.SourceAmount.ToString("N2") @item.CurrencyCode</td>
                            @if (!detailsOutgoing || legacyOutgoing)
                            { <td>@DisplayDates.Date(item.ValuationDate)</td><td dir="ltr">@item.SourceToAfnRate.ToString("N4")</td> }
                            @if (detailsOutgoing)
                            {
                                <td dir="ltr">@item.CommissionAfn.ToString("N2") @item.CurrencyCode</td>
                                @if (legacyOutgoing) { <td dir="ltr">@item.AfnEquivalent.ToString("N2") USD</td> }
                            }
                            else
                            {
                                <td dir="ltr">@item.AfnEquivalent.ToString("N4") USD</td><td dir="ltr">@item.CommissionAfn.ToString("N4") USD</td>
                            }
                            <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "فعال" : "برگشت‌شده/کسرشده")</span></td>
                        </tr>
                    }</tbody>
                </table></div>

                <h6 class="fw-bold mb-3">ثبت‌های حسابداری</h6>
                <div class="table-responsive"><table class="table table-sm table-bordered align-middle">
                    <thead><tr><th>سند</th><th>حساب</th><th>ارز</th><th>طلبکار</th><th>بدهکار</th><th>شرح</th></tr></thead>
                    <tbody>@foreach (var entry in selectedDetails.LedgerEntries)
                    {
                        <tr><td>@entry.TransactionNo</td><td>@entry.AccountCode — @entry.AccountName</td><td>@entry.CurrencyCode</td>
                            <td dir="ltr">@entry.TalabKar.ToString("N2")</td><td dir="ltr">@entry.BadehKar.ToString("N2")</td><td>@entry.Description</td></tr>
                    }</tbody>
                </table></div>
            </div>
            <div class="modal-footer"><button class="btn btn-light" @onclick="CloseDetails">بستن</button></div>
        </div></div>
    </div>
}

@if (reverseBatchId.HasValue)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,.5)" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">برگشت محاسبه کمیشن</h5></div>
            <div class="modal-body"><label class="form-label">دلیل برگشت</label><textarea class="form-control" @bind="reverseReason"></textarea></div>
            <div class="modal-footer"><button class="btn btn-light" @onclick="CancelReverse">انصراف</button><button class="btn btn-danger" disabled="@busy" @onclick="ReverseBatch">تأیید برگشت</button></div>
        </div></div>
    </div>
}

@code {
    [Parameter] public long CorrespondentId { get; set; }
    private CorrespondentDto? correspondent;
    private CorrespondentCommissionPreviewRequestDto request = new();
    private CorrespondentCommissionPreviewDto? preview;
    private List<CorrespondentCommissionBatchDto> history = [];
    private bool loadingPage = true;
    private bool busy;
    private bool calculating;
    private bool calculated;
    private string error = string.Empty;
    private string success = string.Empty;
    private CorrespondentCommissionBatchDto? selectedDetails;
    private long? reverseBatchId;
    private string reverseReason = string.Empty;
    private bool isOutgoing;
    private bool isOrigin;
    private decimal originRateForAll = 400m;
    private string loadedPage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isOutgoing = Navigation.Uri.Contains("/outgoing-commission", StringComparison.OrdinalIgnoreCase);
        isOrigin = Navigation.Uri.Contains("/commissions/", StringComparison.OrdinalIgnoreCase) ||
                   Navigation.Uri.Contains("/forwarding-commission", StringComparison.OrdinalIgnoreCase);
        var pageKey = $"{CorrespondentId}:{(isOrigin ? "Forwarding" : isOutgoing ? "Destination" : "Incoming")}";
        if (loadedPage == pageKey) return;
        loadedPage = pageKey;
        loadingPage = true;
        preview = null;
        calculated = false;
        selectedDetails = null;
        error = success = string.Empty;
        correspondent = await CorrespondentService.GetByIdAsync(CorrespondentId);
        request = new CorrespondentCommissionPreviewRequestDto
        {
            CorrespondentId = CorrespondentId, PeriodFrom = DateTime.Today.AddMonths(-1),
            PeriodTo = DateTime.Today, CommissionPerLakhAfn = isOutgoing ? 200m : 400m,
            HawalaType = isOutgoing || isOrigin ? "HawalaSend" : "HawalaReceive",
            CommissionScope = isOrigin ? "Forwarding" : isOutgoing ? "Destination" : "Incoming"
        };
        await LoadHistory();
        loadingPage = false;
    }

    private async Task LoadPreview()
    {
        if (busy || calculating) return;
        error = string.Empty;
        success = string.Empty;
        busy = true;
        calculating = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            calculated = false;
            var previousCurrencyRates = request.LocationCurrencyRates
                .ToDictionary(x => (x.PaymentLocationId, x.CurrencyId), x => x.PerLakhRate);
            var previousLocationRates = request.PaymentLocationRates.ToDictionary(x => x.PaymentLocationId, x => x.PerLakhRate);
            preview = await CommissionService.PreviewAsync(request);
            request.Rates = preview.Rates;
            if (isOutgoing)
                request.LocationCurrencyRates = preview.LocationCurrencyRates.Select(x =>
                {
                    x.PerLakhRate = previousCurrencyRates.GetValueOrDefault((x.PaymentLocationId, x.CurrencyId));
                    return x;
                }).ToList();
            if (isOrigin)
                request.PaymentLocationRates = preview.PaymentLocationRates
                    .Where(x => x.PaymentLocationId > 0).Select(x =>
                    {
                        x.PerLakhRate = previousLocationRates.GetValueOrDefault(
                            x.PaymentLocationId, request.CommissionPerLakhAfn);
                        return x;
                    }).ToList();
            calculated = isOutgoing ? request.LocationCurrencyRates.All(x => x.PerLakhRate > 0) && request.LocationCurrencyRates.Count > 0
                : isOrigin ? request.PaymentLocationRates.All(x => x.PerLakhRate > 0) && request.PaymentLocationRates.Count > 0
                : true;
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            calculating = false;
            busy = false;
        }
    }

    private async Task PostBatch()
    {
        await Execute(async () =>
        {
            var result = await CommissionService.PostAsync(request);
            success = $"کمیشن دوره‌ای با شماره {result.Id} با موفقیت ثبت شد.";
            preview = null; calculated = false;
            await LoadHistory();
        });
    }

    private void SelectReverse(long id) { reverseBatchId = id; reverseReason = string.Empty; }
    private void ApplyOriginRateToAll()
    {
        if (originRateForAll <= 0)
        {
            error = "کمیشن هر لک باید بزرگ‌تر از صفر باشد.";
            return;
        }
        error = string.Empty;
        request.CommissionPerLakhAfn = originRateForAll;
        foreach (var location in request.PaymentLocationRates)
            location.PerLakhRate = originRateForAll;
        InvalidatePreview();
    }
    private void InvalidatePreview() { calculated = false; }
    private async Task ShowDetails(long id) => await Execute(async () =>
        selectedDetails = await CommissionService.GetDetailsAsync(id));
    private void CloseDetails() => selectedDetails = null;
    private void BackToCorrespondent() => Navigation.NavigateTo($"/correspondents/{CorrespondentId}");
    private void CancelReverse() { reverseBatchId = null; reverseReason = string.Empty; }
    private async Task ReverseBatch()
    {
        if (!reverseBatchId.HasValue) return;
        await Execute(async () =>
        {
            await CommissionService.ReverseAsync(reverseBatchId.Value, reverseReason);
            success = "محاسبه کمیشن و سند حسابداری آن برگشت داده شد.";
            CancelReverse(); await LoadHistory();
        });
    }

    private async Task LoadHistory() => history = (await CommissionService.GetHistoryAsync(CorrespondentId))
        .Where(x => isOrigin ? x.CommissionScope is "Origin" or "Forwarding"
            : x.HawalaType == request.HawalaType && x.CommissionScope is not ("Origin" or "Forwarding")).ToList();
    private async Task Execute(Func<Task> action)
    {
        if (busy) return;
        error = string.Empty; success = string.Empty; busy = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try { await action(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
