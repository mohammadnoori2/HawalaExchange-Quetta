@page "/correspondents/{CorrespondentId:long}"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager

<PageTitle>@(correspondent == null ? "مشاهده نمایندگی" : correspondent.Name)</PageTitle>

<div class="page-wrapper correspondent-details-page">
    @if (isLoading)
    {
        <div class="correspondent-page-state">
            <div class="spinner-border text-primary" role="status"></div>
            <span>در حال بارگذاری نمایندگی...</span>
        </div>
    }
    else if (correspondent == null)
    {
        <div class="correspondent-page-state correspondent-page-error">
            <h5>نمایندگی یافت نشد</h5>
            <p>@pageError</p>
            <button class="btn btn-primary" @onclick="BackToList">بازگشت به نمایندگی‌ها</button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success correspondent-page-alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(pageError))
        {
            <div class="alert alert-danger correspondent-page-alert">
                @pageError
                <button type="button" class="btn-close" @onclick="() => pageError = string.Empty"></button>
            </div>
        }

        <header class="correspondent-page-header">
            <div class="correspondent-title">
                <h5>مشاهده نمایندگی</h5>
                <span>@correspondent.Name · @correspondent.Code</span>
            </div>
            <div class="correspondent-header-actions">
                <a class="btn btn-sm btn-primary" href="@($"/correspondents/{CorrespondentId}/status")">وضعیت نمایندگی</a>
                @if (!correspondent.IsArchived)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="OpenEdit">ویرایش نمایندگی</button>
                }
                <button class="btn btn-sm @(correspondent.IsArchived ? "btn-outline-success" : "btn-outline-danger")"
                        @onclick="OpenArchiveConfirmation">
                    @(correspondent.IsArchived ? "خروج از بایگانی" : "بایگانی نمایندگی")
                </button>
                <button class="btn btn-sm btn-light border" @onclick="BackToList">بازگشت</button>
            </div>
        </header>

        <div class="correspondent-profile-grid">
            <div><span>کد نمایندگی</span><strong>@correspondent.Code</strong></div>
            <div><span>نام نمایندگی</span><strong>@correspondent.Name</strong></div>
            <div><span>کشور</span><strong>@(correspondent.Country ?? "—")</strong></div>
            <div><span>شهر</span><strong>@(correspondent.City ?? "—")</strong></div>
            <div><span>شماره تلفن</span><strong dir="ltr">@(correspondent.PhoneNumber ?? "—")</strong></div>
            <div><span>آدرس</span><strong>@(correspondent.Address ?? "—")</strong></div>
            <div><span>ارز توافقی</span><strong>@(correspondent.SettlementCurrencyCode ?? "بدون ارز توافقی")</strong></div>
            <div>
                <span>وضعیت</span>
                <strong class="@(correspondent.IsArchived ? "text-danger" : "text-success")">
                    @(correspondent.IsArchived ? "بایگانی" : "فعال")
                </strong>
            </div>
            <div><span>تاریخ ایجاد</span><strong dir="ltr">@PersianDateHelper.ToPersianDateTime12(correspondent.CreatedAt)</strong></div>
        </div>

        @if (correspondent.IsArchived)
        {
            <div class="alert alert-warning py-2 mb-2">این نمایندگی بایگانی است؛ حواله‌های قبلی قابل مشاهده‌اند، اما برای ثبت حواله جدید ابتدا آن را از بایگانی خارج کنید.</div>
        }

        <div class="correspondent-hawala-sections">
            <div class="correspondent-hawala-tabs" role="tablist" aria-label="نوع حواله‌های نمایندگی">
                <button type="button"
                        class="@(activeHawalaType == "HawalaSend" ? "active" : null)"
                        @onclick='() => SelectHawalaType("HawalaSend")'>
                    حواله‌های ارسالی
                </button>
                <button type="button"
                        class="@(activeHawalaType == "HawalaReceive" ? "active" : null)"
                        @onclick='() => SelectHawalaType("HawalaReceive")'>
                    حواله‌های دریافتی
                </button>
            </div>

            @if (activeHawalaType == "HawalaSend")
            {
                <CorrespondentHawalaPanel @key="@($"send-{CorrespondentId}")"
                                          CorrespondentId="@CorrespondentId"
                                          HawalaType="HawalaSend"
                                          Title="حواله‌های ارسالی"
                                          SingularTitle="حواله ارسالی"
                                          CanCreate="@(!correspondent.IsArchived)" />
            }
            else
            {
                <CorrespondentHawalaPanel @key="@($"receive-{CorrespondentId}")"
                                          CorrespondentId="@CorrespondentId"
                                          HawalaType="HawalaReceive"
                                          Title="حواله‌های دریافتی"
                                          SingularTitle="حواله دریافتی"
                                          CanCreate="@(!correspondent.IsArchived)" />
            }
        </div>
    }
</div>

@if (showEditModal && correspondent != null)
{
    <div class="modal show d-block correspondent-action-overlay" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content correspondent-action-modal">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">ویرایش نمایندگی</h5>
                        <small>@correspondent.Code</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (editErrors.Any())
                    {
                        <div class="alert alert-danger py-2">
                            @foreach (var error in editErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نام نمایندگی</label>
                            <input class="form-control" @bind="editModel.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">کشور</label>
                            <input class="form-control" @bind="editModel.Country" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">شهر</label>
                            <input class="form-control" @bind="editModel.City" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">شماره تلفن</label>
                            <input class="form-control" @bind="editModel.PhoneNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">آدرس</label>
                            <input class="form-control" @bind="editModel.Address" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">ارز توافقی</label>
                            <select class="form-select" @bind="editModel.SettlementCurrencyId">
                                <option value="">بدون ارز توافقی</option>
                                @foreach (var currency in currencies)
                                {
                                    <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                }
                            </select>
                            <div class="form-text">اگر انتخاب نشود، تبدیل ارز برای این نمایندگی غیرفعال می‌ماند.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">یادداشت</label>
                            <textarea class="form-control" rows="2" @bind="editModel.Remarks"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light border" @onclick="CloseEdit">انصراف</button>
                    <button class="btn btn-primary" disabled="@isSaving" @onclick="SaveEditAsync">
                        @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showArchiveConfirmation && correspondent != null)
{
    <div class="modal show d-block correspondent-action-overlay" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content correspondent-action-modal">
                <div class="modal-header">
                    <h5 class="modal-title">تأیید عملیات</h5>
                    <button type="button" class="btn-close" @onclick="CloseArchiveConfirmation"></button>
                </div>
                <div class="modal-body">
                    @(correspondent.IsArchived ? "نمایندگی از بایگانی خارج شود؟" : "نمایندگی بایگانی شود؟")
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light border" @onclick="CloseArchiveConfirmation">انصراف</button>
                    <button class="btn @(correspondent.IsArchived ? "btn-success" : "btn-danger")"
                            disabled="@isSaving"
                            @onclick="ToggleArchiveAsync">
                        @(correspondent.IsArchived ? "خروج از بایگانی" : "بایگانی")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long CorrespondentId { get; set; }

    private CorrespondentDto? correspondent;
    private List<CurrencyDto> currencies = [];
    private UpdateCorrespondentDto editModel = new();
    private readonly List<string> editErrors = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showEditModal;
    private bool showArchiveConfirmation;
    private string pageError = string.Empty;
    private string successMessage = string.Empty;
    private long? loadedCorrespondentId;
    private string activeHawalaType = "HawalaSend";

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCorrespondentId == CorrespondentId)
            return;
        loadedCorrespondentId = CorrespondentId;
        await LoadCorrespondentAsync();
    }

    private async Task LoadCorrespondentAsync()
    {
        try
        {
            isLoading = true;
            activeHawalaType = "HawalaSend";
            pageError = string.Empty;
            correspondent = await CorrespondentService.GetByIdAsync(CorrespondentId);
            currencies = (await CurrencyService.GetActiveCurrenciesAsync()).OrderBy(x => x.Code).ToList();
            if (correspondent == null)
                pageError = "نمایندگی مورد نظر وجود ندارد یا حذف شده است.";
        }
        catch (Exception ex)
        {
            correspondent = null;
            pageError = $"بارگذاری نمایندگی انجام نشد: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToList() => NavigationManager.NavigateTo("/correspondents");
    private void SelectHawalaType(string hawalaType) => activeHawalaType = hawalaType;

    private void OpenEdit()
    {
        if (correspondent == null)
            return;
        editErrors.Clear();
        editModel = new UpdateCorrespondentDto
        {
            Code = correspondent.Code,
            Name = correspondent.Name,
            Country = correspondent.Country,
            City = correspondent.City,
            PhoneNumber = correspondent.PhoneNumber,
            Address = correspondent.Address,
            Remarks = correspondent.Remarks,
            SettlementCurrencyId = correspondent.SettlementCurrencyId,
            IsArchived = correspondent.IsArchived
        };
        showEditModal = true;
    }

    private void CloseEdit()
    {
        showEditModal = false;
        editErrors.Clear();
    }

    private async Task SaveEditAsync()
    {
        if (correspondent == null)
            return;
        editErrors.Clear();
        if (string.IsNullOrWhiteSpace(editModel.Name))
        {
            editErrors.Add("نام نمایندگی الزامی است.");
            return;
        }
        try
        {
            isSaving = true;
            await CorrespondentService.UpdateAsync(correspondent.Id, editModel);
            showEditModal = false;
            successMessage = "تغییرات نمایندگی ذخیره شد.";
            await LoadCorrespondentAsync();
        }
        catch (Exception ex)
        {
            editErrors.Add($"ذخیره تغییرات انجام نشد: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenArchiveConfirmation() => showArchiveConfirmation = true;
    private void CloseArchiveConfirmation() => showArchiveConfirmation = false;

    private async Task ToggleArchiveAsync()
    {
        if (correspondent == null)
            return;
        try
        {
            isSaving = true;
            if (correspondent.IsArchived)
            {
                await CorrespondentService.UnarchiveAsync(correspondent.Id);
                successMessage = "نمایندگی از بایگانی خارج شد.";
            }
            else
            {
                await CorrespondentService.ArchiveAsync(correspondent.Id);
                successMessage = "نمایندگی بایگانی شد.";
            }
            showArchiveConfirmation = false;
            await LoadCorrespondentAsync();
        }
        catch (Exception ex)
        {
            pageError = $"عملیات بایگانی انجام نشد: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
