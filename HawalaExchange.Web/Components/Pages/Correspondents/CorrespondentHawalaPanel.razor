    private async Task OnFilterChangedAsync()
    {
        filterChangeCts?.Cancel();
        filterChangeCts?.Dispose();
        filterChangeCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(150, filterChangeCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        currentPage = 1;
        await LoadHawalasAsync();
    }

    private IReadOnlyList<HawalaDto> SelectedSettlementHawalas => selectedSettlementHawalas.Values.ToList();

    private void ToggleSettlementSelection(HawalaDto hawala, bool selected)
    {
        if (selected)
        {
            selectedSettlementIds.Add(hawala.Id);
            selectedSettlementHawalas[hawala.Id] = hawala;
        }
        else
        {
            selectedSettlementIds.Remove(hawala.Id);
            selectedSettlementHawalas.Remove(hawala.Id);
        }
    }

    private void OpenSettlement() => showSettlementModal = true;

    private Task HandleSettlementVisibility(bool visible)
    {
        showSettlementModal = visible;
        return Task.CompletedTask;
    }

    private async Task HandleSettlementConvertedAsync(CorrespondentSettlementResultDto result)
    {
        selectedSettlementIds.Clear();
        selectedSettlementHawalas.Clear();
        var details = result.Items.Count == 0
            ? "تبدیل به ارز توافقی ثبت شد."
            : string.Join("؛ ", result.Items.Select(item =>
                $"{MoneyFormatHelper.Format(item.SourceAmount)} {item.SourceCurrencyCode} با نرخ {AmountValueHelper.Format(item.ExchangeRate)} " +
                $"به {MoneyFormatHelper.Format(item.TargetAmount)} {item.TargetCurrencyCode} تبدیل شد"));
        successMessage = $"{result.HawalaCount} حواله تبدیل شد: {details}";
        await LoadHawalasAsync();
    }

    private async Task ResetFiltersAsync()
    {
        searchTerm = string.Empty;
        statusFilter = string.Empty;
        currentPage = 1;
        await LoadHawalasAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        var targetPage = Math.Clamp(page, 1, Math.Max(totalPages, 1));
        if (targetPage == currentPage)
            return;

        currentPage = targetPage;
        await LoadHawalasAsync();
    }

    private void ClearErrors() => errors.Clear();

    private static string GetStatusClass(string status) => status switch
    {
        "Paid" => "status-paid",
        "Cancel" => "status-cancelled",
        _ => "status-pending"
    };

    private static string GetSettlementRowClass(HawalaDto hawala) => hawala.SettlementState switch
    {
        "Pending" => "settlement-pending-row",
        "Converted" => "settlement-converted-row",
        _ => string.Empty
    };

    private static string GetPaymentLocation(HawalaDto hawala)
    {
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName) &&
            !string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
            return $"{hawala.PaymentLocationName} - {hawala.PaymentLocationAddress}";
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName))
            return hawala.PaymentLocationName;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
            return hawala.PaymentLocationAddress;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocation))
            return hawala.PaymentLocation;
        return "—";
    }
