@page "/correspondents/{CorrespondentId:long}/status"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICorrespondentService CorrespondentService
@inject IAccountService AccountService
@inject IHawalaService HawalaService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>@(correspondent == null ? "وضعیت نمایندگی" : $"وضعیت {correspondent.Name}")</PageTitle>

<div class="page-wrapper entity-details-page">
    @if (isLoading)
    {
        <div class="entity-page-state">
            <div class="spinner-border text-primary" role="status"></div>
            <span>در حال بارگذاری نمایندگی...</span>
        </div>
    }
    else if (correspondent == null || accountForView == null)
    {
        <div class="entity-page-state entity-page-error">
            <h5>نمایندگی یافت نشد</h5>
            <p>@pageError</p>
            <button class="btn btn-primary" @onclick="BackToCorrespondents">بازگشت به نمایندگی‌ها</button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success entity-page-alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
            </div>
        }

        <AccountDetailsModal IsVisible="true"
                             PageMode="true"
                             Account="@accountForView"
                             ViewTitle="وضعیت نمایندگی"
                             ViewSubtitle="@($"{correspondent.Name} · {correspondent.Code}")"
                             EditButtonText="ویرایش نمایندگی"
                             ArchiveButtonText="بایگانی نمایندگی"
                             UnarchiveButtonText="خروج از بایگانی"
                             BackButtonText="بازگشت به حواله‌ها"
                             ShowAccountFacts="false"
                             ShowFinancialActions="@(correspondentAccount != null)"
                             ActionEntityArchived="@correspondent.IsArchived"
                             IsVisibleChanged="HandleVisibilityChanged"
                             OnEditRequested="OpenEdit"
                             OnArchiveToggleRequested="OpenArchiveConfirmation">
            <HeaderActions>
                <a class="btn btn-sm btn-outline-secondary" href="@($"/correspondents/{CorrespondentId}")">حواله‌های نمایندگی</a>
                <a class="btn btn-sm btn-outline-secondary" href="#correspondent-range">محدوده حواله‌ها</a>
            </HeaderActions>
            <ProfileSummary>
                <div class="entity-profile-grid mb-2">
                    <div class="entity-profile-item"><span>کد نمایندگی</span><strong>@correspondent.Code</strong></div>
                    <div class="entity-profile-item"><span>نام نمایندگی</span><strong>@correspondent.Name</strong></div>
                    <div class="entity-profile-item"><span>کشور</span><strong>@(correspondent.Country ?? "—")</strong></div>
                    <div class="entity-profile-item"><span>شهر</span><strong>@(correspondent.City ?? "—")</strong></div>
                    <div class="entity-profile-item"><span>شماره تلفن</span><strong dir="ltr">@(correspondent.PhoneNumber ?? "—")</strong></div>
                    <div class="entity-profile-item"><span>آدرس</span><strong>@(correspondent.Address ?? "—")</strong></div>
                    <div class="entity-profile-item">
                        <span>وضعیت</span>
                        <strong class="@(correspondent.IsArchived ? "text-danger" : "text-success")">
                            @(correspondent.IsArchived ? "بایگانی" : "فعال")
                        </strong>
                    </div>
                    <div class="entity-profile-item"><span>تاریخ ایجاد</span><strong dir="ltr">@PersianDateHelper.ToPersianDateTime12(correspondent.CreatedAt)</strong></div>
                </div>
                @if (correspondentAccount == null)
                {
                    <div class="alert alert-warning py-2 mb-2">برای این نمایندگی حسابی افتتاح نشده است؛ عملیات مالی در دسترس نیست.</div>
                }
            </ProfileSummary>
            <AdditionalContent>
                <section id="correspondent-range" class="modern-card correspondent-range-card mb-2">
                    <div class="card-header correspondent-range-header">
                        <h6 class="text-white mb-0">محدوده حواله‌های نمایندگی</h6>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(rangeError))
                        {
                            <div class="alert alert-danger py-2">@rangeError</div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label">نوع حواله</label>
                                <select class="form-select form-select-sm" @bind="rangeFilter.HawalaType">
                                    <option value="HawalaSend">حواله ارسالی</option>
                                    <option value="HawalaReceive">حواله دریافتی</option>
                                    <option value="HawalaOther">حواله متفرقه</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label">نوع محدوده</label>
                                <select class="form-select form-select-sm" @bind="rangeFilter.RangeType">
                                    <option value="Number">بر اساس نمبر حواله</option>
                                    <option value="Date">بر اساس تاریخ حواله</option>
                                </select>
                            </div>
                            @if (rangeFilter.RangeType == "Number")
                            {
                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">نمبر شروع</label>
                                    <input type="number" min="1" class="form-control form-control-sm" @bind="rangeFilter.StartNumber" />
                                </div>
                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">نمبر ختم</label>
                                    <input type="number" min="1" class="form-control form-control-sm" @bind="rangeFilter.EndNumber" />
                                </div>
                            }
                            else
                            {
                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">تاریخ شروع</label>
                                    <PersianDatePicker @bind-Value="rangeStartDate" IncludeTime="false" Placeholder="تاریخ شروع" />
                                </div>
                                <div class="col-lg-2 col-md-4">
                                    <label class="form-label">تاریخ ختم</label>
                                    <PersianDatePicker @bind-Value="rangeEndDate" IncludeTime="false" Placeholder="تاریخ ختم" />
                                </div>
                            }
                            <div class="col-lg-2 col-md-4 d-flex gap-2">
                                <button class="btn btn-sm btn-primary flex-fill" @onclick="LoadRangeReport" disabled="@rangeLoading">
                                    @(rangeLoading ? "در حال نمایش..." : "نمایش")
                                </button>
                            </div>
                        </div>

                        @if (rangeResult != null)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                                <span class="small fw-semibold">تعداد حواله‌ها: @rangeResult.Hawalas.Count</span>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="ExportRangePdf"
                                        disabled="@(rangePdfLoading || rangeResult.Hawalas.Count == 0)">
                                    @(rangePdfLoading ? "در حال ایجاد..." : "خروجی PDF")
                                </button>
                            </div>

                            <div id="correspondentRangeReport">
                                <div class="range-report-heading">
                                    <h5>گزارش محدوده حواله‌های نمایندگی</h5>
                                    <div class="range-report-facts">
                                        <span><strong>نمایندگی:</strong> @correspondent.Name</span>
                                        <span><strong>کد:</strong> @correspondent.Code</span>
                                        <span><strong>نوع حواله:</strong> @rangeReportHawalaType</span>
                                        <span><strong>محدوده:</strong> @rangeReportDescription</span>
                                    </div>
                                </div>

                                <div class="table-responsive mb-3">
                                    <table class="table table-sm table-hover align-middle hawala-range-table">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>نمبر حواله</th>
                                                <th>تاریخ</th>
                                                <th>فرستنده</th>
                                                <th>گیرنده</th>
                                                <th>محل پرداخت</th>
                                                <th>مبلغ</th>
                                                <th>ارز</th>
                                                <th>کارمزد</th>
                                                <th>ارز کارمزد</th>
                                                <th>کارمزد نمایندگی</th>
                                                <th>ارز کارمزد نمایندگی</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (rangeResult.Hawalas.Count == 0)
                                            {
                                                <tr><td colspan="12" class="text-center text-muted py-3">در این محدوده حواله‌ای یافت نشد.</td></tr>
                                            }
                                            else
                                            {
                                                var reportIndex = 1;
                                                @foreach (var hawala in rangeResult.Hawalas)
                                                {
                                                    <tr>
                                                        <td>@reportIndex</td>
                                                        <td class="fw-bold">@hawala.Number</td>
                                                        <td dir="ltr">@PersianDateHelper.ToPersianDate(hawala.CreatedAt)</td>
                                                        <td>@GetFullName(hawala.SenderName, hawala.SenderFatherName)</td>
                                                        <td>@GetFullName(hawala.ReceiverName, hawala.ReceiverFatherName)</td>
                                                        <td>@GetRangePaymentLocation(hawala)</td>
                                                        <td class="fw-bold" dir="ltr">@MoneyFormatHelper.Format(hawala.FromAmount)</td>
                                                        <td>@hawala.FromCurrencyCode</td>
                                                        <td dir="ltr">@(hawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.CommissionAmount.Value) : "—")</td>
                                                        <td>@(hawala.CommissionCurrencyCode ?? "—")</td>
                                                        <td dir="ltr">@(hawala.AgentCommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.AgentCommissionAmount.Value) : "—")</td>
                                                        <td>@(hawala.AgentCommissionCurrencyCode ?? "—")</td>
                                                    </tr>
                                                    reportIndex++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <h6 class="fw-bold mb-2">خلاصه حساب در محدوده</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>ارز</th>
                                                <th>مجموع بدهکار</th>
                                                <th>مجموع طلبکار</th>
                                                <th>بیلانس محدوده</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (rangeResult.Summaries.Count == 0)
                                            {
                                                <tr><td colspan="4" class="text-center text-muted">برای این محدوده رکورد حساب نمایندگی وجود ندارد.</td></tr>
                                            }
                                            else
                                            {
                                                @foreach (var summary in rangeResult.Summaries)
                                                {
                                                    <tr>
                                                        <td class="fw-bold">@summary.CurrencyCode</td>
                                                        <td class="text-danger fw-bold" dir="ltr">@MoneyFormatHelper.Format(summary.TotalDebit)</td>
                                                        <td class="text-success fw-bold" dir="ltr">@MoneyFormatHelper.Format(summary.TotalCredit)</td>
                                                        <td class="fw-bold @(summary.Balance < 0 ? "text-danger" : "text-primary")" dir="ltr">@MoneyFormatHelper.Format(summary.Balance)</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </AdditionalContent>
        </AccountDetailsModal>
    }
</div>

@if (showEditModal && correspondent != null)
{
    <div class="modal show d-block entity-action-overlay" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content entity-action-modal">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">ویرایش نمایندگی</h5>
                        <small>@correspondent.Code</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (editErrors.Any())
                    {
                        <div class="alert alert-danger py-2">
                            @foreach (var error in editErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نام نمایندگی</label>
                            <input class="form-control" @bind="editModel.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">کشور</label>
                            <input class="form-control" @bind="editModel.Country" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">شهر</label>
                            <input class="form-control" @bind="editModel.City" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">شماره تلفن</label>
                            <input class="form-control" @bind="editModel.PhoneNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">آدرس</label>
                            <input class="form-control" @bind="editModel.Address" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">یادداشت</label>
                            <textarea class="form-control" rows="2" @bind="editModel.Remarks"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light border" @onclick="CloseEdit">انصراف</button>
                    <button class="btn btn-primary" disabled="@isSaving" @onclick="SaveEdit">
                        @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showArchiveConfirmation && correspondent != null)
{
    <div class="modal show d-block entity-action-overlay" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content entity-action-modal">
                <div class="modal-header">
                    <h5 class="modal-title">تأیید عملیات</h5>
                    <button type="button" class="btn-close" @onclick="CloseArchiveConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@(correspondent.IsArchived ? "نمایندگی از بایگانی خارج شود؟" : "نمایندگی بایگانی شود؟")</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light border" @onclick="CloseArchiveConfirmation">انصراف</button>
                    <button class="btn @(correspondent.IsArchived ? "btn-success" : "btn-danger")"
                            disabled="@isSaving"
                            @onclick="ToggleArchive">
                        @(correspondent.IsArchived ? "خروج از بایگانی" : "بایگانی")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long CorrespondentId { get; set; }

    private CorrespondentDto? correspondent;
    private AccountDto? correspondentAccount;
    private AccountDto? accountForView;
    private UpdateCorrespondentDto editModel = new();
    private readonly List<string> editErrors = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showEditModal;
    private bool showArchiveConfirmation;
    private string pageError = string.Empty;
    private string successMessage = string.Empty;
    private long? loadedCorrespondentId;

    private CorrespondentHawalaRangeFilterDto rangeFilter = new();
    private CorrespondentHawalaRangeResultDto? rangeResult;
    private DateTime rangeStartDate = DateTime.Today.AddMonths(-1);
    private DateTime rangeEndDate = DateTime.Today;
    private bool rangeLoading;
    private bool rangePdfLoading;
    private string rangeError = string.Empty;
    private string rangeReportHawalaType = string.Empty;
    private string rangeReportDescription = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCorrespondentId == CorrespondentId)
            return;

        loadedCorrespondentId = CorrespondentId;
        await LoadCorrespondent();
    }

    private async Task LoadCorrespondent()
    {
        try
        {
            isLoading = true;
            pageError = string.Empty;
            correspondent = await CorrespondentService.GetByIdAsync(CorrespondentId);
            if (correspondent == null)
            {
                pageError = "نمایندگی مورد نظر وجود ندارد یا حذف شده است.";
                return;
            }

            correspondentAccount = (await AccountService.GetByReferenceAsync("Correspondent", CorrespondentId)).FirstOrDefault();
            accountForView = correspondentAccount ?? new AccountDto
            {
                Id = 0,
                AccountCode = "—",
                AccountName = correspondent.Name,
                AccountType = "Correspondent",
                ReferenceType = "Correspondent",
                ReferenceId = correspondent.Id,
                IsActive = !correspondent.IsArchived,
                IsArchived = correspondent.IsArchived,
                CreatedAt = correspondent.CreatedAt
            };

            ResetRangeFilter();
        }
        catch (Exception ex)
        {
            correspondent = null;
            accountForView = null;
            pageError = $"خطا در بارگذاری نمایندگی: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetRangeFilter()
    {
        rangeFilter = new CorrespondentHawalaRangeFilterDto
        {
            CorrespondentId = CorrespondentId,
            HawalaType = "HawalaSend",
            RangeType = "Number"
        };
        rangeStartDate = DateTime.Today.AddMonths(-1);
        rangeEndDate = DateTime.Today;
        rangeResult = null;
        rangeError = string.Empty;
    }

    private Task HandleVisibilityChanged(bool visible)
    {
        if (!visible)
            BackToHawalas();
        return Task.CompletedTask;
    }

    private void BackToCorrespondents() => NavigationManager.NavigateTo("/correspondents");
    private void BackToHawalas() => NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}");

    private Task OpenEdit(long _)
    {
        if (correspondent == null)
            return Task.CompletedTask;

        editErrors.Clear();
        editModel = new UpdateCorrespondentDto
        {
            Code = correspondent.Code,
            Name = correspondent.Name,
            Country = correspondent.Country,
            City = correspondent.City,
            PhoneNumber = correspondent.PhoneNumber,
            Address = correspondent.Address,
            Remarks = correspondent.Remarks,
            IsArchived = correspondent.IsArchived
        };
        showEditModal = true;
        return Task.CompletedTask;
    }

    private void CloseEdit()
    {
        showEditModal = false;
        editErrors.Clear();
    }

    private async Task SaveEdit()
    {
        if (correspondent == null)
            return;

        editErrors.Clear();
        if (string.IsNullOrWhiteSpace(editModel.Name))
            editErrors.Add("نام نمایندگی الزامی است.");
        if (editErrors.Any())
            return;

        try
        {
            isSaving = true;
            await CorrespondentService.UpdateAsync(correspondent.Id, editModel);
            showEditModal = false;
            successMessage = "تغییرات نمایندگی ذخیره شد.";
            await LoadCorrespondent();
        }
        catch (Exception ex)
        {
            editErrors.Add($"ذخیره تغییرات انجام نشد: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task OpenArchiveConfirmation(long _)
    {
        showArchiveConfirmation = true;
        return Task.CompletedTask;
    }

    private void CloseArchiveConfirmation() => showArchiveConfirmation = false;

    private async Task ToggleArchive()
    {
        if (correspondent == null)
            return;

        try
        {
            isSaving = true;
            if (correspondent.IsArchived)
            {
                await CorrespondentService.UnarchiveAsync(correspondent.Id);
                successMessage = "نمایندگی از بایگانی خارج شد.";
            }
            else
            {
                await CorrespondentService.ArchiveAsync(correspondent.Id);
                successMessage = "نمایندگی بایگانی شد.";
            }

            showArchiveConfirmation = false;
            await LoadCorrespondent();
        }
        catch (Exception ex)
        {
            pageError = $"عملیات بایگانی انجام نشد: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task LoadRangeReport()
    {
        rangeError = string.Empty;
        rangeResult = null;

        if (rangeFilter.RangeType == "Date")
        {
            rangeFilter.StartDate = rangeStartDate;
            rangeFilter.EndDate = rangeEndDate;
            rangeFilter.StartNumber = null;
            rangeFilter.EndNumber = null;
        }
        else
        {
            rangeFilter.StartDate = null;
            rangeFilter.EndDate = null;
        }

        try
        {
            rangeLoading = true;
            rangeResult = await HawalaService.GetCorrespondentRangeAsync(rangeFilter);
            rangeReportHawalaType = GetRangeHawalaTypeName(rangeFilter.HawalaType);
            rangeReportDescription = GetRangeDescription();
        }
        catch (Exception ex)
        {
            rangeError = ex.Message;
        }
        finally
        {
            rangeLoading = false;
        }
    }

    private async Task ExportRangePdf()
    {
        if (rangeResult == null || rangeResult.Hawalas.Count == 0 || correspondent == null)
        {
            rangeError = "برای خروجی PDF باید ابتدا محدوده‌ای دارای حواله را نمایش دهید.";
            return;
        }

        try
        {
            rangePdfLoading = true;
            rangeError = string.Empty;
            var safeCode = string.Concat(correspondent.Code
                .Where(character => char.IsLetterOrDigit(character) || character is '-' or '_'));
            var fileName = $"hawala-range-{safeCode}-{DateTime.Now:yyyyMMdd-HHmmss}";
            var exported = await JS.InvokeAsync<bool>("hawalaTools.printPdfElement", "correspondentRangeReport", fileName);
            if (!exported)
                rangeError = "پنجره خروجی باز نشد. لطفاً اجازه باز شدن پنجره جدید را در مرورگر فعال کنید.";
        }
        catch (Exception ex)
        {
            rangeError = $"خطا در ایجاد خروجی PDF: {ex.Message}";
        }
        finally
        {
            rangePdfLoading = false;
        }
    }

    private string GetRangeDescription()
    {
        if (rangeFilter.RangeType == "Date")
            return $"{PersianDateHelper.ToPersianDate(rangeStartDate)} تا {PersianDateHelper.ToPersianDate(rangeEndDate)}";

        return $"{rangeFilter.StartNumber?.ToString() ?? "—"} تا {rangeFilter.EndNumber?.ToString() ?? "—"}";
    }

    private static string GetRangeHawalaTypeName(string hawalaType) => hawalaType switch
    {
        "HawalaSend" => "حواله ارسالی",
        "HawalaReceive" => "حواله دریافتی",
        "HawalaOther" => "حواله متفرقه",
        _ => hawalaType
    };

    private static string GetRangePaymentLocation(HawalaDto hawala)
    {
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName))
            return hawala.PaymentLocationName;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
            return hawala.PaymentLocationAddress;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocation))
            return hawala.PaymentLocation;

        return "—";
    }

    private static string GetFullName(string? name, string? fatherName)
    {
        var parts = new[] { name?.Trim(), fatherName?.Trim() }
            .Where(part => !string.IsNullOrWhiteSpace(part));
        var fullName = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(fullName) ? "—" : fullName;
    }
}
