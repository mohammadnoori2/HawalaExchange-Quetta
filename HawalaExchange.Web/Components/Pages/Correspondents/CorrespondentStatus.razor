@page "/correspondents/{CorrespondentId:long}/status"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared.Modals
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICorrespondentService CorrespondentService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@(correspondent == null ? "وضعیت نمایندگی" : $"وضعیت {correspondent.Name}")</PageTitle>

<div class="page-wrapper entity-details-page">
    @if (isLoading)
    {
        <div class="entity-page-state">
            <div class="spinner-border text-primary" role="status"></div>
            <span>در حال بارگذاری نمایندگی...</span>
        </div>
    }
    else if (correspondent == null || accountForView == null)
    {
        <div class="entity-page-state entity-page-error">
            <h5>نمایندگی یافت نشد</h5>
            <p>@pageError</p>
            <button class="btn btn-primary" @onclick="BackToCorrespondents">بازگشت به نمایندگی‌ها</button>
        </div>
    }
    else
    {
        <AccountDetailsModal IsVisible="true"
                             PageMode="true"
                             Account="@accountForView"
                             ViewTitle="وضعیت نمایندگی"
                             ViewSubtitle="@($"{correspondent.Name} · {correspondent.Code}")"
                             BackButtonText="بازگشت به حواله‌ها"
                             ShowAccountFacts="false"
                             ShowFinancialActions="false"
                             ShowBackButton="false"
                             ActionEntityArchived="@correspondent.IsArchived"
                             InitialBalances="@initialBalances"
                             InitialOperationsPage="@initialOperationsPage"
                             IsVisibleChanged="HandleVisibilityChanged">
            <ProfileSummary>
                @if (correspondentAccount == null)
                {
                    <div class="alert alert-warning py-2 mb-2">برای این نمایندگی حسابی افتتاح نشده است؛ عملیات مالی در دسترس نیست.</div>
                }
            </ProfileSummary>
        </AccountDetailsModal>
    }
</div>

@code {
    [Parameter] public long CorrespondentId { get; set; }

    private CorrespondentDto? correspondent;
    private AccountDto? correspondentAccount;
    private AccountDto? accountForView;
    private IReadOnlyList<BalanceDto>? initialBalances;
    private AccountOperationsPageDto? initialOperationsPage;
    private bool isLoading = true;
    private string pageError = string.Empty;
    private long? loadedCorrespondentId;
    private CancellationTokenSource? pageLoadCts;
    private int pageLoadVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCorrespondentId == CorrespondentId)
            return;

        pageLoadCts?.Cancel();
        pageLoadCts?.Dispose();
        pageLoadCts = new CancellationTokenSource();
        loadedCorrespondentId = CorrespondentId;
        await LoadCorrespondentAsync(pageLoadCts.Token);
    }

    private async Task LoadCorrespondentAsync(CancellationToken cancellationToken = default)
    {
        var loadVersion = ++pageLoadVersion;
        try
        {
            isLoading = true;
            pageError = string.Empty;
            var page = await CorrespondentService.GetStatusPageAsync(CorrespondentId, cancellationToken);
            if (loadVersion != pageLoadVersion)
                return;
            if (page == null)
            {
                correspondent = null;
                pageError = "نمایندگی مورد نظر وجود ندارد یا حذف شده است.";
                return;
            }

            correspondent = page.Correspondent;
            initialBalances = page.Balances;
            initialOperationsPage = page.Operations;
            correspondentAccount = page.AccountId.HasValue
                ? CreateAccountForView(page.AccountId.Value, correspondent)
                : null;
            accountForView = correspondentAccount ?? new AccountDto
            {
                Id = 0,
                AccountCode = "—",
                AccountName = correspondent.Name,
                AccountType = "Correspondent",
                ReferenceType = "Correspondent",
                ReferenceId = correspondent.Id,
                IsActive = !correspondent.IsArchived,
                IsArchived = correspondent.IsArchived,
                CreatedAt = correspondent.CreatedAt
            };
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            correspondent = null;
            accountForView = null;
            pageError = $"خطا در بارگذاری نمایندگی: {ex.Message}";
        }
        finally
        {
            if (loadVersion == pageLoadVersion)
                isLoading = false;
        }
    }

    private static AccountDto CreateAccountForView(long accountId, CorrespondentDto source) => new()
    {
        Id = accountId,
        AccountCode = source.Code,
        AccountName = source.Name,
        AccountType = "Correspondent",
        ReferenceType = "Correspondent",
        ReferenceId = source.Id,
        IsActive = !source.IsArchived,
        IsArchived = source.IsArchived,
        CreatedAt = source.CreatedAt
    };

    private Task HandleVisibilityChanged(bool visible)
    {
        if (!visible)
            NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}");

        return Task.CompletedTask;
    }

    private void BackToCorrespondents() => NavigationManager.NavigateTo("/correspondents");

    public void Dispose()
    {
        pageLoadCts?.Cancel();
        pageLoadCts?.Dispose();
    }
}
