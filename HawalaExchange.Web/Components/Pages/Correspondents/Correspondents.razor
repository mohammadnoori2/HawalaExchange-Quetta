@page "/correspondents"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-globe-americas"></i>
                مدیریت نمایندگان (حواله‌داران)
                <span class="page-subtitle">لیست و جستجوی نمایندگان</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> نماینده جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-globe-americas"></i>
                    </div>
                    <div>
                        <div class="stat-number">@correspondents.Count</div>
                        <div class="stat-label">تعداد نمایندگان</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@correspondents.Count(c => !c.IsArchived)</div>
                        <div class="stat-label">فعال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger">
                        <i class="bi bi-archive"></i>
                    </div>
                    <div>
                        <div class="stat-number">@correspondents.Count(c => c.IsArchived)</div>
                        <div class="stat-label">بایگانی شده</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-number">@correspondents.Count(c => c.CreatedAt.Date == DateTime.Today)</div>
                        <div class="stat-label">ایجاد امروز</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجوی نمایندگان (کد، نام، کشور، شهر، تلفن)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredCorrespondents.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "Code" ? "active" : "")" @onclick="@(() => SortBy("Code"))">
                                کد
                                @if (sortColumn == "Code")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "Name" ? "active" : "")" @onclick="@(() => SortBy("Name"))">
                                نام
                                @if (sortColumn == "Name")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "Country" ? "active" : "")" @onclick="@(() => SortBy("Country"))">
                                کشور
                                @if (sortColumn == "Country")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "City" ? "active" : "")" @onclick="@(() => SortBy("City"))">
                                شهر
                                @if (sortColumn == "City")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>تلفن</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && correspondents == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedCorrespondents.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ نماینده‌ای یافت نشد</span>
                                        <p class="text-muted small">برای افزودن نماینده جدید، دکمه "نماینده جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredCorrespondents.Count : pageSize) + 1;
                            @foreach (var correspondent in pagedCorrespondents)
                            {
                                <tr class="@(correspondent.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@correspondent.Code</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar avatar-primary">
                                                @correspondent.Name?.Substring(0, Math.Min(2, correspondent.Name?.Length ?? 0)).ToUpper()
                                            </div>
                                            <span class="fw-semibold">@correspondent.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@correspondent.Country</span>
                                    </td>
                                    <td>@correspondent.City</td>
                                    <td>
                                        <span class="phone-number">@correspondent.PhoneNumber</span>
                                    </td>
                                    <td>
                                        @if (correspondent.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            @if (!correspondent.IsArchived)
                                            {
                                                <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(correspondent.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="action-btn action-btn-archive" @onclick="() => ShowArchiveConfirm(correspondent.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn action-btn-unarchive" @onclick="() => ShowUnarchiveConfirm(correspondent.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedCorrespondents.Count</strong> از <strong>@filteredCorrespondents.Count</strong> نماینده
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-check-circle-fill"></i> فعال: @correspondents.Count(c => !c.IsArchived)
                </span>
                <span class="badge-modern badge-archived">
                    <i class="bi bi-archive-fill"></i> بایگانی: @correspondents.Count(c => c.IsArchived)
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش نماینده (با قابلیت موجودی اولیه) -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش نماینده" : "ایجاد نماینده جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات نماینده -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-person-badge me-2"></i> اطلاعات نماینده
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash text-muted me-1"></i> کد نماینده <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@correspondentCodeDisplay" disabled readonly />
                                        <small class="text-muted">کد نماینده قابل ویرایش نیست</small>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control"
                                               @bind="currentCorrespondent.Code" placeholder="مثال: AG-001" />
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person text-muted me-1"></i> نام نماینده <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCorrespondent.Name" placeholder="نام نماینده" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-flag text-muted me-1"></i> کشور
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.Country" placeholder="مثال: افغانستان" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo text-muted me-1"></i> شهر
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.City" placeholder="مثال: کابل" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-phone text-muted me-1"></i> شماره تلفن
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.PhoneNumber" placeholder="مثال: ۰۷۸۰ ۱۲۳ ۴۵۶" dir="ltr" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo-alt text-muted me-1"></i> آدرس
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.Address" placeholder="آدرس کامل" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <textarea class="form-control" @bind="currentCorrespondent.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                                </div>
                            </div>

                            <!-- ===== سوئیچ موجودی اولیه (فقط در حالت ایجاد) ===== -->
                            @if (!isEditMode)
                            {
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="hasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle text-success me-1"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-info-circle"></i> با ایجاد نماینده، یک حساب با نوع <strong>نماینده</strong> به‌طور خودکار ساخته می‌شود.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    <small>موجودی اولیه فقط در زمان ایجاد نماینده قابل ثبت است.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ===== بخش ثبت موجودی اولیه (فقط در حالت ایجاد و زمانی که سوئیچ فعال باشد) ===== -->
                    @if (!isEditMode && hasInitialBalance)
                    {
                        <div class="modern-card mb-4" style="border-right: 4px solid var(--primary-color);">
                            <div class="card-header">
                                <h6 class="text-primary">
                                    <i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه
                                </h6>
                            </div>
                            <div class="card-body">
                                <!-- جدول موجودی‌های ثبت‌شده -->
                                @if (initialBalances.Any())
                                {
                                    <div class="table-scroll-wrapper mb-3">
                                        <table class="table-modern table-striped-modern">
                                            <thead>
                                                <tr>
                                                    <th>واحد پولی</th>
                                                    <th>مقدار</th>
                                                    <th>نوع</th>
                                                    <th>حساب طرف مقابل</th>
                                                    <th>توضیحات</th>
                                                    <th class="text-center">عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in initialBalances)
                                                {
                                                    var currency = currencies.FirstOrDefault(c => c.Id == item.CurrencyId);
                                                    var account = accounts.FirstOrDefault(a => a.Id == item.OppositeAccountId);
                                                    <tr>
                                                        <td>@(currency?.Name ?? "نامشخص") (@(currency?.Code ?? ""))</td>
                                                        <td class="fw-bold">@item.Amount.ToString("N2")</td>
                                                        <td>
                                                            <span class="badge-modern @(item.Direction == "Debit" ? "badge-danger" : "badge-success")">
                                                                @(item.Direction == "Debit" ? "بدهکار" : "بستانکار")
                                                            </span>
                                                        </td>
                                                        <td>@(account?.AccountName ?? "نامشخص")</td>
                                                        <td>@item.Description</td>
                                                        <td class="text-center">
                                                            <button class="action-btn action-btn-delete" @onclick="() => RemoveInitialBalance(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">هیچ موجودی اولیه‌ای ثبت نشده است.</div>
                                }

                                <hr />

                                <!-- فرم اضافه کردن موجودی جدید -->
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small">واحد پولی <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.CurrencyId">
                                            <option value="0">انتخاب کنید</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name (@currency.Code)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">مقدار <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" @bind="newInitialBalance.Amount" step="0.01" min="0" placeholder="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">نوع <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.Direction">
                                            <option value="Debit">بدهکار</option>
                                            <option value="Credit">بستانکار</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small">حساب طرف مقابل <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.OppositeAccountId">
                                            <option value="0">انتخاب حساب</option>
                                            @foreach (var acc in accounts)
                                            {
                                                <option value="@acc.Id">@acc.AccountName (@acc.AccountCode)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">توضیحات</label>
                                        <input type="text" class="form-control" @bind="newInitialBalance.Description" placeholder="اختیاری" />
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn-modern btn-success-modern w-100" @onclick="AddInitialBalance" disabled="@(!CanAddInitialBalance())">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش نماینده با کد: <strong>@correspondentCodeDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveCorrespondent()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید بایگانی/خروج از بایگانی -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌ها =====
    private List<CorrespondentDto> correspondents = new();
    private List<CorrespondentDto> filteredCorrespondents = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();

    // ===== جستجو، صفحه‌بندی و مرتب‌سازی =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchCorrespondents();
            }
        }
    }

    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "Code";
    private bool sortAscending = true;

    private List<CorrespondentDto> pagedCorrespondents
    {
        get
        {
            var sorted = filteredCorrespondents;
            switch (sortColumn)
            {
                case "Code":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Code).ToList() : filteredCorrespondents.OrderByDescending(c => c.Code).ToList();
                    break;
                case "Name":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Name).ToList() : filteredCorrespondents.OrderByDescending(c => c.Name).ToList();
                    break;
                case "Country":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Country).ToList() : filteredCorrespondents.OrderByDescending(c => c.Country).ToList();
                    break;
                case "City":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.City).ToList() : filteredCorrespondents.OrderByDescending(c => c.City).ToList();
                    break;
                default:
                    sorted = filteredCorrespondents.OrderByDescending(c => c.Code).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredCorrespondents.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private string? correspondentCodeDisplay;

    private CreateCorrespondentDto currentCorrespondent = new();

    // ===== متغیرهای موجودی اولیه =====
    private bool hasInitialBalance = false;
    private List<InitialBalanceDto> initialBalances = new();
    private InitialBalanceDto newInitialBalance = new();

    // ===== متدهای بارگذاری =====
    protected override async Task OnInitializedAsync()
    {
        await LoadCorrespondents();
        await LoadCurrencies();
        await LoadAccounts();
    }

    private async Task LoadCorrespondents()
    {
        try
        {
            isLoading = true;
            var result = await CorrespondentService.GetAllAsync();
            correspondents = result.ToList();
            filteredCorrespondents = correspondents;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نمایندگان: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            accounts = result.Where(a => !a.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    // ===== جستجو =====
    private void SearchCorrespondents()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredCorrespondents = correspondents;
        }
        else
        {
            var term = _searchTerm.Trim().ToLower();
            filteredCorrespondents = correspondents.Where(c =>
                c.Code.ToLower().Contains(term) ||
                c.Name.ToLower().Contains(term) ||
                (c.Country != null && c.Country.ToLower().Contains(term)) ||
                (c.City != null && c.City.ToLower().Contains(term)) ||
                (c.PhoneNumber != null && c.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredCorrespondents = correspondents;
        currentPage = 1;
        StateHasChanged();
    }

    // ===== صفحه‌بندی و مرتب‌سازی =====
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ===== متدهای موجودی اولیه =====
    private bool CanAddInitialBalance()
    {
        return newInitialBalance.CurrencyId > 0 &&
               newInitialBalance.Amount > 0 &&
               newInitialBalance.OppositeAccountId > 0;
    }

    private void AddInitialBalance()
    {
        if (!CanAddInitialBalance()) return;

        if (initialBalances.Any(b => b.CurrencyId == newInitialBalance.CurrencyId))
        {
            validationErrors.Add("این واحد پولی قبلاً ثبت شده است.");
            StateHasChanged();
            return;
        }

        initialBalances.Add(new InitialBalanceDto
        {
            CurrencyId = newInitialBalance.CurrencyId,
            Amount = newInitialBalance.Amount,
            Direction = newInitialBalance.Direction,
            OppositeAccountId = newInitialBalance.OppositeAccountId,
            Description = newInitialBalance.Description
        });

        newInitialBalance = new InitialBalanceDto();
        StateHasChanged();
    }

    private void RemoveInitialBalance(InitialBalanceDto item)
    {
        initialBalances.Remove(item);
        StateHasChanged();
    }

    // ===== باز و بسته کردن مودال‌ها =====
    private void OpenCreateModal()
    {
        currentCorrespondent = new CreateCorrespondentDto();
        correspondentCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        hasInitialBalance = false;
        initialBalances.Clear();
        newInitialBalance = new InitialBalanceDto();
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var correspondent = await CorrespondentService.GetByIdAsync(id);
            if (correspondent != null)
            {
                correspondentCodeDisplay = correspondent.Code;
                currentCorrespondent = new CreateCorrespondentDto
                {
                    Code = correspondent.Code,
                    Name = correspondent.Name,
                    Country = correspondent.Country,
                    City = correspondent.City,
                    PhoneNumber = correspondent.PhoneNumber,
                    Address = correspondent.Address,
                    Remarks = correspondent.Remarks
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
                hasInitialBalance = false;
                initialBalances.Clear();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نماینده: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    // ===== ذخیره‌سازی =====
    private async Task SaveCorrespondent()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (!isEditMode && string.IsNullOrWhiteSpace(currentCorrespondent.Code))
            validationErrors.Add("کد نماینده الزامی است");
        if (string.IsNullOrWhiteSpace(currentCorrespondent.Name))
            validationErrors.Add("نام نماینده الزامی است");
        if (hasInitialBalance && !initialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCorrespondentDto
                {
                    Code = currentCorrespondent.Code,
                    Name = currentCorrespondent.Name,
                    Country = currentCorrespondent.Country,
                    City = currentCorrespondent.City,
                    PhoneNumber = currentCorrespondent.PhoneNumber,
                    Address = currentCorrespondent.Address,
                    Remarks = currentCorrespondent.Remarks,
                    IsArchived = false
                };
                await CorrespondentService.UpdateAsync(editId, updateRequest);
                successMessage = "نماینده با موفقیت ویرایش شد";
            }
            else
            {
                if (hasInitialBalance && initialBalances.Any())
                {
                    currentCorrespondent.HasInitialBalance = true;
                    currentCorrespondent.InitialBalances = initialBalances.ToList();
                }
                else
                {
                    currentCorrespondent.HasInitialBalance = false;
                    currentCorrespondent.InitialBalances = null;
                }

                await CorrespondentService.CreateAsync(currentCorrespondent);
                successMessage = "نماینده با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadCorrespondents();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===== بایگانی =====
    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await CorrespondentService.ArchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await CorrespondentService.UnarchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadCorrespondents();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}