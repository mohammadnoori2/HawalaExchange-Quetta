@page "/correspondents"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject IHawalaService HawalaService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>مدیریت نمایندگی‌ها</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="مدیریت نمایندگی‌ها"
                   Subtitle="لیست و جستجوی نمایندگی‌ها"
                   Icon="bi-globe-americas">
        <Stats>
            <PageHeaderStats AriaLabel="آمار نمایندگی‌ها">
                <PageHeaderStat Label="کل" Value="@correspondents.Count" Icon="bi-globe-americas" />
                <PageHeaderStat Label="فعال" Value="@correspondents.Count(c => !c.IsArchived)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="بایگانی" Value="@correspondents.Count(c => c.IsArchived)" Icon="bi-archive" Tone="danger" />
                <PageHeaderStat Label="امروز" Value="@correspondents.Count(c => c.CreatedAt.Date == DateTime.Today)" Icon="bi-clock-history" Tone="info" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <ArchiveViewToggle @bind-ShowArchived="showArchived"
                               ArchivedCount="@correspondents.Count(c => c.IsArchived)"
                               @bind-ShowArchived:after="ArchiveViewChanged" />
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> نماینده جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجوی نمایندگی‌ها"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm))"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با کد، نام، کشور، شهر یا تلفن..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredCorrespondents.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "Name" ? "active" : "")" @onclick="@(() => SortBy("Name"))">
                                نام
                                @if (sortColumn == "Name")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "Country" ? "active" : "")" @onclick="@(() => SortBy("Country"))">
                                کشور
                                @if (sortColumn == "Country")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "City" ? "active" : "")" @onclick="@(() => SortBy("City"))">
                                شهر
                                @if (sortColumn == "City")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>تلفن</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && correspondents == null)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedCorrespondents.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ نماینده‌ای یافت نشد</span>
                                        <p class="text-muted small">@(showArchived ? "هیچ نمایندگی‌ای در بایگانی وجود ندارد." : "برای افزودن نمایندگی جدید، دکمه «نماینده جدید» را انتخاب کنید.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredCorrespondents.Count : pageSize) + 1;
                            @foreach (var correspondent in pagedCorrespondents)
                            {
                                <tr class="@(correspondent.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-semibold">@correspondent.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@correspondent.Country</span>
                                    </td>
                                    <td>@correspondent.City</td>
                                    <td>
                                        <span class="phone-number">@correspondent.PhoneNumber</span>
                                    </td>
                                    <td>
                                        @if (correspondent.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات نمایندگی {correspondent.Name}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ViewCorrespondent(correspondent.Id)">
                                                <i class="bi bi-eye text-primary"></i>
                                                مشاهده نمایندگی
                                            </button>
                                            @if (correspondent.IsArchived)
                                            {
                                                <div class="operation-menu-divider"></div>
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowUnarchiveConfirm(correspondent.Id)">
                                                    <i class="bi bi-arrow-counterclockwise text-success"></i>
                                                    خروج از بایگانی
                                                </button>
                                            }
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedCorrespondents.Count</strong> از <strong>@filteredCorrespondents.Count</strong> نماینده
                </span>

                <!-- صفحه‌بندی -->
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد نمایندگی در هر صفحه" />
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش نماینده (با قابلیت موجودی اولیه) -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content correspondent-entry-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش نماینده" : "ایجاد نماینده جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات نماینده -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-person-badge me-2"></i> اطلاعات نماینده
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @if (isEditMode)
                                {
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-hash text-muted me-1"></i> کد نماینده
                                        </label>
                                        <input type="text" class="form-control bg-light" value="@correspondentCodeDisplay" disabled readonly />
                                        <small class="text-muted">کد نماینده قابل ویرایش نیست</small>
                                    </div>
                                }
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person text-muted me-1"></i> نام نماینده <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCorrespondent.Name" placeholder="نام نماینده" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-flag text-muted me-1"></i> کشور
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.Country" placeholder="مثال: افغانستان" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo text-muted me-1"></i> شهر
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.City" placeholder="مثال: کابل" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-phone text-muted me-1"></i> شماره تلفن
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.PhoneNumber" placeholder="مثال: ۰۷۸۰ ۱۲۳ ۴۵۶" dir="ltr" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo-alt text-muted me-1"></i> آدرس
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCorrespondent.Address" placeholder="آدرس کامل" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-currency-exchange text-muted me-1"></i> ارز توافقی
                                    </label>
                                    <select class="form-select" @bind="currentCorrespondent.SettlementCurrencyId">
                                        <option value="">بدون ارز توافقی</option>
                                        @foreach (var currency in currencies.OrderBy(x => x.Name))
                                        {
                                            <option value="@currency.Id">@currency.Name</option>
                                        }
                                    </select>
                                    <div class="form-text">اختیاری است و بعداً نیز قابل تعیین می‌باشد.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <textarea class="form-control" @bind="currentCorrespondent.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                                </div>
                            </div>

                            <!-- ===== سوئیچ موجودی اولیه (فقط در حالت ایجاد) ===== -->
                            @if (!isEditMode)
                            {
                                <div class="custom-switch-inline mt-3">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="HasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle text-primary me-1"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    <small>موجودی اولیه فقط در زمان ایجاد نماینده قابل ثبت است.</small>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ===== بخش ثبت موجودی اولیه (فقط در حالت ایجاد و زمانی که سوئیچ فعال باشد) ===== -->
                    @if (!isEditMode && hasInitialBalance)
                    {
                        <div class="modern-card mb-4">
                            <div class="card-header">
                                <h6 class="text-primary">
                                    <i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="correspondent-initial-balance-grid">
                                    @foreach (var item in initialBalances)
                                    {
                                        var itemCurrency = currencies.FirstOrDefault(currency => currency.Id == item.CurrencyId);
                                        var itemIsIncomplete = initialBalanceValidationAttempted && !IsEmptyInitialBalance(item) && !IsCompleteInitialBalance(item);
                                        <div class="correspondent-initial-balance-item" @key="item">
                                            <div class="correspondent-initial-balance-controls @(itemIsIncomplete ? "correspondent-initial-balance-invalid" : string.Empty)">
                                                <select class="correspondent-initial-balance-currency" @bind="item.CurrencyId" aria-label="واحد پولی موجودی اولیه">
                                                    <option value="0">انتخاب ارز</option>
                                                    @foreach (var currency in currencies)
                                                    {
                                                        <option value="@currency.Id">@currency.Name</option>
                                                    }
                                                </select>

                                                <MoneyInput class="correspondent-initial-balance-amount" @bind-Value="item.Amount" min="0" placeholder="مبلغ" />

                                                <select class="correspondent-initial-balance-direction @(item.Direction == "Debit" ? "is-debit" : "is-credit")"
                                                        @bind="item.Direction" aria-label="نوع موجودی اولیه">
                                                    <option value="Debit">بدهکار</option>
                                                    <option value="Credit">طلبکار</option>
                                                </select>

                                                <div class="correspondent-initial-balance-account @(itemIsIncomplete && item.OppositeAccountId <= 0 ? "correspondent-initial-balance-invalid" : string.Empty)">
                                                    <AccountSearchSelect Accounts="@accounts"
                                                                         @bind-Value="item.OppositeAccountId"
                                                                         Placeholder="حساب طرف مقابل"
                                                                         ShowAccountCode="false"
                                                                         ShowBalanceSummary="false" />
                                                </div>
                                            </div>

                                            @if (item.Amount > 0)
                                            {
                                                <small class="correspondent-initial-balance-words">
                                                    @DariNumberToWords.ToWords(item.Amount) @(itemCurrency?.Name ?? string.Empty)
                                                </small>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="correspondent-initial-balance-actions">
                                    <button type="button" class="correspondent-initial-balance-icon correspondent-initial-balance-delete"
                                            title="حذف آخرین ارز" aria-label="حذف آخرین ارز"
                                            disabled="@(initialBalances.Count == 0)" @onclick="RemoveLastInitialBalance">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <button type="button" class="correspondent-initial-balance-icon"
                                            title="افزودن ارز دیگر" aria-label="افزودن ارز دیگر" @onclick="AddInitialBalanceRow">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(initialBalanceError))
                                {
                                    <small class="text-danger d-block mt-2">@initialBalanceError</small>
                                }
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش نماینده با کد: <strong>@correspondentCodeDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveCorrespondent()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال گزارش محدوده حواله‌های نمایندگی -->
@if (showRangeModal && selectedRangeCorrespondent != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header modal-header-primary">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-card-list me-2"></i>
                        محدوده حواله‌های @selectedRangeCorrespondent.Name
                        <small class="ms-2">(@selectedRangeCorrespondent.Code)</small>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRangeModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(rangeError))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>@rangeError
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">نوع حواله</label>
                                    <select class="form-select" @bind="rangeFilter.HawalaType">
                                        <option value="HawalaSend">حواله ارسالی</option>
                                        <option value="HawalaReceive">حواله دریافتی</option>
                                        <option value="HawalaOther">حواله متفرقه</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">نوع محدوده</label>
                                    <select class="form-select" @bind="rangeFilter.RangeType">
                                        <option value="Number">بر اساس شماره حواله</option>
                                        <option value="Date">بر اساس تاریخ حواله</option>
                                    </select>
                                </div>

                                @if (rangeFilter.RangeType == "Number")
                                {
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">شماره شروع</label>
                                        <input type="number" min="1" class="form-control" @bind="rangeFilter.StartNumber" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">شماره ختم</label>
                                        <input type="number" min="1" class="form-control" @bind="rangeFilter.EndNumber" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">تاریخ شروع</label>
                                        <PersianDatePicker @bind-Value="rangeStartDate" IncludeTime="false" Placeholder="تاریخ شروع" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold">تاریخ ختم</label>
                                        <PersianDatePicker @bind-Value="rangeEndDate" IncludeTime="false" Placeholder="تاریخ ختم" />
                                    </div>
                                }

                                <div class="col-md-2">
                                    <button class="btn-modern btn-primary-modern w-100" @onclick="LoadRangeReport" disabled="@rangeLoading">
                                        @if (rangeLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-search"></i>
                                        }
                                        نمایش
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (rangeResult != null)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">تعداد حواله‌ها: <span class="badge bg-primary">@rangeResult.Hawalas.Count</span></h6>
                            <button type="button"
                                    class="btn-modern btn-danger-modern"
                                    @onclick="ExportRangePdf"
                                    disabled="@(rangePdfLoading || rangeResult.Hawalas.Count == 0)">
                                @if (rangePdfLoading)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-pdf"></i>
                                }
                                خروجی PDF
                            </button>
                        </div>

                        <div id="correspondentRangeReport">
                            <div class="range-report-header">
                                <h4 class="fw-bold mb-3">گزارش محدوده حواله‌های نمایندگی</h4>
                                <div class="row g-2 mb-4">
                                    <div class="col-md-3"><strong>نمایندگی:</strong> @selectedRangeCorrespondent.Name</div>
                                    <div class="col-md-3"><strong>کد:</strong> @selectedRangeCorrespondent.Code</div>
                                    <div class="col-md-3"><strong>نوع حواله:</strong> @rangeReportHawalaType</div>
                                    <div class="col-md-3"><strong>محدوده:</strong> @rangeReportDescription</div>
                                </div>
                            </div>

                            <div class="table-responsive mb-4">
                                <GlobalDataGrid class="table table-hover align-middle hawala-range-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>شماره حواله</th>
                                            <th>تاریخ</th>
                                            <th>نام کامل فرستنده</th>
                                            <th>نام کامل گیرنده</th>
                                            <th>محل پرداخت</th>
                                            <th>مقدار حواله</th>
                                            <th>ارز حواله</th>
                                            <th>کارمزد</th>
                                            <th>ارز کارمزد</th>
                                            <th>کارمزد نمایندگی</th>
                                            <th>ارز کارمزد نمایندگی</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (rangeResult.Hawalas.Count == 0)
                                        {
                                            <tr><td colspan="12" class="text-center text-muted py-4">در این محدوده حواله‌ای یافت نشد.</td></tr>
                                        }
                                        else
                                        {
                                            var reportIndex = 1;
                                            @foreach (var hawala in rangeResult.Hawalas)
                                            {
                                                <tr>
                                                    <td>@reportIndex</td>
                                                    <td class="fw-bold">@hawala.Number</td>
                                                    <td><AppDateTime Value="@hawala.CreatedAt" /></td>
                                                    <td>@GetFullName(hawala.SenderName, hawala.SenderFatherName)</td>
                                                    <td>@GetFullName(hawala.ReceiverName, hawala.ReceiverFatherName)</td>
                                                    <td>@GetRangePaymentLocation(hawala)</td>
                                                    <td class="fw-bold" dir="ltr">@MoneyFormatHelper.Format(hawala.FromAmount)</td>
                                                    <td>@hawala.FromCurrencyCode</td>
                                                    <td dir="ltr">@(hawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.CommissionAmount.Value) : "-")</td>
                                                    <td>@(hawala.CommissionCurrencyCode ?? "-")</td>
                                                    <td dir="ltr">@(hawala.AgentCommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.AgentCommissionAmount.Value) : "-")</td>
                                                    <td>@(hawala.AgentCommissionCurrencyCode ?? "-")</td>
                                                </tr>
                                                reportIndex++;
                                            }
                                        }
                                    </tbody>
                                </GlobalDataGrid>
                            </div>

                            <h6 class="fw-bold mb-3"><i class="bi bi-calculator me-2"></i>خلاصه لیجر در محدوده</h6>
                            <div class="table-responsive">
                                <GlobalDataGrid class="table table-bordered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>ارز</th>
                                            <th>مجموع بدهکار</th>
                                            <th>مجموع طلبکار</th>
                                            <th>بیلانس محدوده</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (rangeResult.Summaries.Count == 0)
                                        {
                                            <tr><td colspan="4" class="text-center text-muted">برای این محدوده رکورد لیجر نمایندگی وجود ندارد.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var summary in rangeResult.Summaries)
                                            {
                                                <tr>
                                                    <td class="fw-bold">@summary.CurrencyCode</td>
                                                    <td class="text-danger fw-bold" dir="ltr">@MoneyFormatHelper.Format(summary.TotalDebit)</td>
                                                    <td class="text-success fw-bold" dir="ltr">@MoneyFormatHelper.Format(summary.TotalCredit)</td>
                                                    <td class="fw-bold @(summary.Balance < 0 ? "text-danger" : "text-primary")" dir="ltr">@MoneyFormatHelper.Format(summary.Balance)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </GlobalDataGrid>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseRangeModal">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید بایگانی/خروج از بایگانی -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌ها =====
    private List<CorrespondentDto> correspondents = new();
    private List<CorrespondentDto> filteredCorrespondents = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();

    // ===== جستجو، صفحه‌بندی و مرتب‌سازی =====
    private string _searchTerm = string.Empty;
    private bool showArchived;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchCorrespondents();
            }
        }
    }

    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "Code";
    private bool sortAscending = true;

    private List<CorrespondentDto> pagedCorrespondents
    {
        get
        {
            var sorted = filteredCorrespondents;
            switch (sortColumn)
            {
                case "Code":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Code).ToList() : filteredCorrespondents.OrderByDescending(c => c.Code).ToList();
                    break;
                case "Name":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Name).ToList() : filteredCorrespondents.OrderByDescending(c => c.Name).ToList();
                    break;
                case "Country":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.Country).ToList() : filteredCorrespondents.OrderByDescending(c => c.Country).ToList();
                    break;
                case "City":
                    sorted = sortAscending ? filteredCorrespondents.OrderBy(c => c.City).ToList() : filteredCorrespondents.OrderByDescending(c => c.City).ToList();
                    break;
                default:
                    sorted = filteredCorrespondents.OrderByDescending(c => c.Code).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredCorrespondents.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showRangeModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private string? correspondentCodeDisplay;
    private bool rangeLoading = false;
    private bool rangePdfLoading = false;
    private string rangeError = string.Empty;
    private CorrespondentDto? selectedRangeCorrespondent;
    private CorrespondentHawalaRangeFilterDto rangeFilter = new();
    private CorrespondentHawalaRangeResultDto? rangeResult;
    private DateTime rangeStartDate = DateTime.Today.AddMonths(-1);
    private DateTime rangeEndDate = DateTime.Today;
    private string rangeReportHawalaType = string.Empty;
    private string rangeReportDescription = string.Empty;

    private CreateCorrespondentDto currentCorrespondent = new();

    // ===== متغیرهای موجودی اولیه =====
    private bool hasInitialBalance = true;
    private List<InitialBalanceDto> initialBalances = new();
    private bool initialBalanceValidationAttempted;
    private string initialBalanceError = string.Empty;

    private bool HasInitialBalance
    {
        get => hasInitialBalance;
        set
        {
            hasInitialBalance = value;
            if (!value)
            {
                initialBalances.Clear();
                initialBalanceValidationAttempted = false;
                initialBalanceError = string.Empty;
            }
            else if (initialBalances.Count == 0)
            {
                initialBalances.Add(NewInitialBalance());
            }
        }
    }

    // ===== متدهای بارگذاری =====
    protected override async Task OnInitializedAsync()
    {
        await LoadCorrespondents();
        await LoadCurrencies();
        await LoadAccounts();
    }

    private async Task LoadCorrespondents()
    {
        try
        {
            isLoading = true;
            var result = await CorrespondentService.GetAllAsync();
            correspondents = result.ToList();
            SearchCorrespondents();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نمایندگان: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            accounts = result.Where(a => !a.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    // ===== جستجو =====
    private void SearchCorrespondents()
    {
        var query = correspondents.Where(c => c.IsArchived == showArchived);
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(c =>
                c.Code.ToLower().Contains(term) ||
                c.Name.ToLower().Contains(term) ||
                (c.Country != null && c.Country.ToLower().Contains(term)) ||
                (c.City != null && c.City.ToLower().Contains(term)) ||
                (c.PhoneNumber != null && c.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }
        filteredCorrespondents = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredCorrespondents = correspondents.Where(c => c.IsArchived == showArchived).ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ArchiveViewChanged()
    {
        SearchCorrespondents();
    }

    // ===== صفحه‌بندی و مرتب‌سازی =====
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ===== متدهای موجودی اولیه =====
    private static bool IsEmptyInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId <= 0 &&
               item.Amount <= 0 &&
               item.OppositeAccountId <= 0 &&
               string.IsNullOrWhiteSpace(item.Description);
    }

    private static bool IsCompleteInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId > 0 &&
               item.Amount > 0 &&
               item.OppositeAccountId > 0;
    }

    private void AddInitialBalanceRow()
    {
        initialBalanceValidationAttempted = true;
        initialBalanceError = string.Empty;

        if (initialBalances.Any(item => !IsCompleteInitialBalance(item)))
        {
            initialBalanceError = "برای افزودن موجودی، ارز، مبلغ بزرگ‌تر از صفر و حساب طرف مقابل را کامل کنید.";
            return;
        }

        if (initialBalances.GroupBy(item => item.CurrencyId).Any(group => group.Count() > 1))
        {
            initialBalanceError = "برای این ارز قبلاً موجودی اولیه افزوده شده است.";
            return;
        }

        initialBalances.Add(NewInitialBalance());
        initialBalanceValidationAttempted = false;
    }

    private void RemoveLastInitialBalance()
    {
        if (initialBalances.Count > 0)
            initialBalances.RemoveAt(initialBalances.Count - 1);

        if (hasInitialBalance && initialBalances.Count == 0)
            initialBalances.Add(NewInitialBalance());

        initialBalanceValidationAttempted = false;
        initialBalanceError = string.Empty;
    }

    private static InitialBalanceDto NewInitialBalance() => new() { Direction = "Debit" };

    // ===== باز و بسته کردن مودال‌ها =====
    private void OpenCreateModal()
    {
        currentCorrespondent = new CreateCorrespondentDto();
        correspondentCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        initialBalances.Clear();
        hasInitialBalance = false;
        HasInitialBalance = true;
        initialBalanceValidationAttempted = false;
        initialBalanceError = string.Empty;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var correspondent = await CorrespondentService.GetByIdAsync(id);
            if (correspondent != null)
            {
                correspondentCodeDisplay = correspondent.Code;
                currentCorrespondent = new CreateCorrespondentDto
                {
                    Name = correspondent.Name,
                    Country = correspondent.Country,
                    City = correspondent.City,
                    PhoneNumber = correspondent.PhoneNumber,
                    Address = correspondent.Address,
                    Remarks = correspondent.Remarks,
                    SettlementCurrencyId = correspondent.SettlementCurrencyId
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
                hasInitialBalance = false;
                initialBalances.Clear();
                initialBalanceValidationAttempted = false;
                initialBalanceError = string.Empty;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نماینده: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void ViewCorrespondent(long correspondentId)
    {
        NavigationManager.NavigateTo($"/correspondents/{correspondentId}");
    }

    private void OpenRangeModal(CorrespondentDto correspondent)
    {
        selectedRangeCorrespondent = correspondent;
        rangeFilter = new CorrespondentHawalaRangeFilterDto
        {
            CorrespondentId = correspondent.Id,
            HawalaType = "HawalaSend",
            RangeType = "Number"
        };
        rangeStartDate = DateTime.Today.AddMonths(-1);
        rangeEndDate = DateTime.Today;
        rangeResult = null;
        rangeError = string.Empty;
        rangeReportHawalaType = string.Empty;
        rangeReportDescription = string.Empty;
        showRangeModal = true;
    }

    private void CloseRangeModal()
    {
        showRangeModal = false;
        selectedRangeCorrespondent = null;
        rangeResult = null;
        rangeError = string.Empty;
        rangeReportHawalaType = string.Empty;
        rangeReportDescription = string.Empty;
    }

    private async Task LoadRangeReport()
    {
        rangeError = string.Empty;
        rangeResult = null;

        if (rangeFilter.RangeType == "Date")
        {
            rangeFilter.StartDate = rangeStartDate;
            rangeFilter.EndDate = rangeEndDate;
            rangeFilter.StartNumber = null;
            rangeFilter.EndNumber = null;
        }
        else
        {
            rangeFilter.StartDate = null;
            rangeFilter.EndDate = null;
        }

        try
        {
            rangeLoading = true;
            rangeResult = await HawalaService.GetCorrespondentRangeAsync(rangeFilter);
            rangeReportHawalaType = GetRangeHawalaTypeName(rangeFilter.HawalaType);
            rangeReportDescription = GetRangeDescription();
        }
        catch (Exception ex)
        {
            rangeError = ex.Message;
        }
        finally
        {
            rangeLoading = false;
        }
    }

    private async Task ExportRangePdf()
    {
        if (rangeResult == null || rangeResult.Hawalas.Count == 0 || selectedRangeCorrespondent == null)
        {
            rangeError = "برای خروجی PDF باید ابتدا محدوده‌ای دارای حواله را نمایش دهید.";
            return;
        }

        try
        {
            rangePdfLoading = true;
            rangeError = string.Empty;
            var safeCode = string.Concat(selectedRangeCorrespondent.Code
                .Where(character => char.IsLetterOrDigit(character) || character is '-' or '_'));
            var fileName = $"hawala-range-{safeCode}-{DateTime.Now:yyyyMMdd-HHmmss}";
            var exported = await JS.InvokeAsync<bool>(
                "hawalaTools.printPdfElement",
                "correspondentRangeReport",
                fileName);

            if (!exported)
                rangeError = "پنجره خروجی باز نشد. لطفاً اجازه باز شدن پنجره جدید را در مرورگر فعال کنید.";
        }
        catch (Exception ex)
        {
            rangeError = $"خطا در ایجاد خروجی PDF: {ex.Message}";
        }
        finally
        {
            rangePdfLoading = false;
        }
    }

    private string GetRangeDescription()
    {
        if (rangeFilter.RangeType == "Date")
            return $"{PersianDateHelper.ToPersianDate(rangeStartDate)} تا {PersianDateHelper.ToPersianDate(rangeEndDate)}";

        return $"{rangeFilter.StartNumber?.ToString() ?? "-"} تا {rangeFilter.EndNumber?.ToString() ?? "-"}";
    }

    private static string GetRangeHawalaTypeName(string hawalaType) => AppDisplayText.HawalaType(hawalaType);

    private static string GetRangePaymentLocation(HawalaDto hawala)
    {
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName))
            return hawala.PaymentLocationName;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
            return hawala.PaymentLocationAddress;
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocation))
            return hawala.PaymentLocation;

        return "-";
    }

    private static string GetFullName(string? name, string? fatherName)
    {
        var parts = new[] { name?.Trim(), fatherName?.Trim() }
            .Where(part => !string.IsNullOrWhiteSpace(part));
        var fullName = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(fullName) ? "-" : fullName;
    }

    // ===== ذخیره‌سازی =====
    private async Task SaveCorrespondent()
    {
        validationErrors.Clear();
        successMessage = string.Empty;
        initialBalanceError = string.Empty;

        var enteredInitialBalances = initialBalances
            .Where(item => !IsEmptyInitialBalance(item))
            .ToList();

        if (string.IsNullOrWhiteSpace(currentCorrespondent.Name))
            validationErrors.Add("نام نماینده الزامی است");
        if (hasInitialBalance && !enteredInitialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        var hasIncompleteInitialBalance = hasInitialBalance &&
                                          enteredInitialBalances.Any(item => !IsCompleteInitialBalance(item));
        if (hasIncompleteInitialBalance)
        {
            initialBalanceError = "اطلاعات موجودی اولیه کامل نیست؛ ارز، مبلغ بزرگ‌تر از صفر و حساب طرف مقابل را وارد کنید.";
            validationErrors.Add(initialBalanceError);
        }

        if (hasInitialBalance && enteredInitialBalances
            .Where(item => item.CurrencyId > 0)
            .GroupBy(item => item.CurrencyId)
            .Any(group => group.Count() > 1))
        {
            initialBalanceError = "برای هر ارز فقط یک موجودی اولیه وارد کنید.";
            validationErrors.Add(initialBalanceError);
        }

        if (validationErrors.Any())
        {
            initialBalanceValidationAttempted = hasInitialBalance;
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCorrespondentDto
                {
                    Code = correspondentCodeDisplay ?? string.Empty,
                    Name = currentCorrespondent.Name,
                    Country = currentCorrespondent.Country,
                    City = currentCorrespondent.City,
                    PhoneNumber = currentCorrespondent.PhoneNumber,
                    Address = currentCorrespondent.Address,
                    Remarks = currentCorrespondent.Remarks,
                    SettlementCurrencyId = currentCorrespondent.SettlementCurrencyId,
                    IsArchived = false
                };
                await CorrespondentService.UpdateAsync(editId, updateRequest);
                successMessage = "نماینده با موفقیت ویرایش شد";
            }
            else
            {
                if (hasInitialBalance && enteredInitialBalances.Any())
                {
                    currentCorrespondent.HasInitialBalance = true;
                    currentCorrespondent.InitialBalances = enteredInitialBalances.ToList();
                }
                else
                {
                    currentCorrespondent.HasInitialBalance = false;
                    currentCorrespondent.InitialBalances = null;
                }

                await CorrespondentService.CreateAsync(currentCorrespondent);
                successMessage = "نماینده با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadCorrespondents();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===== بایگانی =====
    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await CorrespondentService.ArchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await CorrespondentService.UnarchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadCorrespondents();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
