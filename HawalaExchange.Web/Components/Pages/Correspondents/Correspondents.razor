@page "/correspondents"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject ICorrespondentService CorrespondentService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-fluid mt-4" dir="rtl">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #0061f2, #0050c8);">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h4 class="mb-0">
                    <i class="bi bi-globe-americas me-2"></i> مدیریت نمایندگان (حواله‌داران)
                </h4>
                <button class="btn btn-light btn-lg" @onclick="() => OpenCreateModal()">
                    <i class="bi bi-plus-circle"></i> نماینده جدید
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- نوار جستجو -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="جستجوی نمایندگان (کد، نام، کشور، شهر، تلفن)..."
                               @bind="searchTerm" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" @onclick="() => ClearSearch()" type="button">
                            <i class="bi bi-x-circle"></i> پاک کردن
                        </button>
                    </div>
                </div>
                <div class="col-md-4 text-start">
                    <span class="badge bg-info fs-6 p-2">
                        <i class="bi bi-list-ul"></i> تعداد: @filteredCorrespondents.Count
                    </span>
                </div>
            </div>

            <!-- جدول نمایندگان -->
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">کد</th>
                            <th scope="col">نام</th>
                            <th scope="col">کشور</th>
                            <th scope="col">شهر</th>
                            <th scope="col">تلفن</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col" style="min-width: 150px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && correspondents == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredCorrespondents.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block"></i>
                                    <span class="fs-5">هیچ نماینده‌ای یافت نشد</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = 1;
                            @foreach (var correspondent in filteredCorrespondents)
                            {
                                <tr class="@(correspondent.IsArchived ? "table-secondary" : "")">
                                    <td>@rowIndex</td>
                                    <td><strong>@correspondent.Code</strong></td>
                                    <td>@correspondent.Name</td>
                                    <td>@correspondent.Country</td>
                                    <td>@correspondent.City</td>
                                    <td dir="ltr">@correspondent.PhoneNumber</td>
                                    <td>
                                        @if (correspondent.IsArchived)
                                        {
                                            <span class="badge bg-secondary px-3 py-2">بایگانی شده</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">فعال</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (!correspondent.IsArchived)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(correspondent.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => ShowArchiveConfirm(correspondent.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-warning" @onclick="() => ShowUnarchiveConfirm(correspondent.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش نماینده -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش نماینده" : "ایجاد نماینده جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @successMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-hash"></i> کد نماینده <span class="text-danger">*</span>
                            </label>
                            @if (isEditMode)
                            {
                                <input type="text" class="form-control bg-light" value="@correspondentCodeDisplay" disabled readonly />
                                <small class="text-muted">کد نماینده قابل ویرایش نیست</small>
                            }
                            else
                            {
                                <input type="text" class="form-control @(string.IsNullOrEmpty(currentCorrespondent.Code) ? "is-invalid" : "")"
                                       @bind="currentCorrespondent.Code" placeholder="مثال: AG-001" />
                                <div class="invalid-feedback">کد نماینده الزامی است</div>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-person"></i> نام نماینده <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control @(string.IsNullOrEmpty(currentCorrespondent.Name) ? "is-invalid" : "")"
                                   @bind="currentCorrespondent.Name" placeholder="نام نماینده" />
                            <div class="invalid-feedback">نام نماینده الزامی است</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-flag"></i> کشور
                            </label>
                            <input type="text" class="form-control" @bind="currentCorrespondent.Country" placeholder="مثال: افغانستان" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-geo"></i> شهر
                            </label>
                            <input type="text" class="form-control" @bind="currentCorrespondent.City" placeholder="مثال: کابل" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-phone"></i> شماره تلفن
                            </label>
                            <input type="text" class="form-control" @bind="currentCorrespondent.PhoneNumber" placeholder="مثال: 0780 123 456" dir="ltr" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-geo-alt"></i> آدرس
                            </label>
                            <input type="text" class="form-control" @bind="currentCorrespondent.Address" placeholder="آدرس کامل" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-chat"></i> توضیحات
                            </label>
                            <textarea class="form-control" @bind="currentCorrespondent.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info mt-2">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش نماینده با کد: <strong>@correspondentCodeDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => SaveCorrespondent()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید بایگانی/خروج از بایگانی -->
@if (showConfirmModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CorrespondentDto> correspondents = new();
    private List<CorrespondentDto> filteredCorrespondents = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchCorrespondents();
            }
        }
    }

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private string? correspondentCodeDisplay;

    private CreateCorrespondentDto currentCorrespondent = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCorrespondents();
    }

    private async Task LoadCorrespondents()
    {
        try
        {
            isLoading = true;
            var result = await CorrespondentService.GetAllAsync();
            correspondents = result.ToList();
            filteredCorrespondents = correspondents;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نمایندگان: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchCorrespondents()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredCorrespondents = correspondents;
        }
        else
        {
            var term = _searchTerm.Trim().ToLower();
            filteredCorrespondents = correspondents.Where(c =>
                c.Code.ToLower().Contains(term) ||
                c.Name.ToLower().Contains(term) ||
                (c.Country != null && c.Country.ToLower().Contains(term)) ||
                (c.City != null && c.City.ToLower().Contains(term)) ||
                (c.PhoneNumber != null && c.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredCorrespondents = correspondents;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentCorrespondent = new CreateCorrespondentDto();
        correspondentCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var correspondent = await CorrespondentService.GetByIdAsync(id);
            if (correspondent != null)
            {
                correspondentCodeDisplay = correspondent.Code;
                currentCorrespondent = new CreateCorrespondentDto
                {
                    Code = correspondent.Code,
                    Name = correspondent.Name,
                    Country = correspondent.Country,
                    City = correspondent.City,
                    PhoneNumber = correspondent.PhoneNumber,
                    Address = correspondent.Address,
                    Remarks = correspondent.Remarks
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نماینده: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task SaveCorrespondent()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        // اعتبارسنجی
        if (!isEditMode && string.IsNullOrWhiteSpace(currentCorrespondent.Code))
            validationErrors.Add("کد نماینده الزامی است");
        if (string.IsNullOrWhiteSpace(currentCorrespondent.Name))
            validationErrors.Add("نام نماینده الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCorrespondentDto
                {
                    Code = currentCorrespondent.Code,
                    Name = currentCorrespondent.Name,
                    Country = currentCorrespondent.Country,
                    City = currentCorrespondent.City,
                    PhoneNumber = currentCorrespondent.PhoneNumber,
                    Address = currentCorrespondent.Address,
                    Remarks = currentCorrespondent.Remarks,
                    IsArchived = false // بایگانی از دکمه جداگانه مدیریت می‌شود
                };
                await CorrespondentService.UpdateAsync(editId, updateRequest);
                successMessage = "نماینده با موفقیت ویرایش شد";
            }
            else
            {
                await CorrespondentService.CreateAsync(currentCorrespondent);
                successMessage = "نماینده با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadCorrespondents();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نماینده را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await CorrespondentService.ArchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await CorrespondentService.UnarchiveAsync(confirmId);
                successMessage = "نماینده با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadCorrespondents();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}