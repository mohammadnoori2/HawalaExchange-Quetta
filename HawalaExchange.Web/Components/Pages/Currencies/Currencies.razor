@page "/currencies"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>مدیریت ارزها</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="مدیریت ارزها"
                   Subtitle="لیست و جستجوی ارزها"
                   Icon="bi-currency-exchange">
        <Stats>
            <PageHeaderStats AriaLabel="آمار ارزها">
                <PageHeaderStat Label="کل" Value="@currencies.Count" Icon="bi-currency-exchange" />
                <PageHeaderStat Label="فعال" Value="@currencies.Count(c => c.IsActive)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="غیرفعال" Value="@currencies.Count(c => !c.IsActive)" Icon="bi-slash-circle" Tone="danger" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> ارز جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر ارزها"
                      HasActiveFilters="@HasActiveFilters"
                      Reset="ResetFilters">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با کد، نام یا سمبل..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter"
                    aria-label="وضعیت ارز"
                    @bind="statusFilter"
                    @bind:event="oninput"
                    @bind:after="ApplyFilters">
                <option value="">همه وضعیت‌ها</option>
                <option value="Active">فعال</option>
                <option value="Inactive">غیرفعال</option>
            </select>
        </QuickFilters>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredCurrencies.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "Name" ? "active" : "")" @onclick="@(() => SortBy("Name"))">
                                نام
                                @if (sortColumn == "Name")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>سمبل</th>
                            <th>تعداد اعشار</th>
                            <th>اولویت نرخ</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && currencies == null)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedCurrencies.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ ارزی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن ارز جدید، دکمه "ارز جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredCurrencies.Count : pageSize) + 1;
                            @foreach (var currency in pagedCurrencies)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-semibold">@currency.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@currency.Symbol</span>
                                    </td>
                                    <td>@currency.DecimalPlaces</td>
                                    <td>@currency.QuotationPriority</td>
                                    <td>
                                        @if (currency.IsActive)
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-slash-circle"></i> غیرفعال
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات ارز {currency.Code}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => OpenEditModal(currency.Id)">
                                                <i class="bi bi-pencil text-primary"></i>
                                                ویرایش
                                            </button>
                                            @if (currency.IsActive)
                                            {
                                                <div class="operation-menu-divider"></div>
                                                <button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" @onclick="() => ShowDeactivateConfirm(currency.Id)">
                                                    <i class="bi bi-slash-circle"></i>
                                                    غیرفعال‌سازی
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="operation-menu-divider"></div>
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowActivateConfirm(currency.Id)">
                                                    <i class="bi bi-check-circle text-success"></i>
                                                    فعال‌سازی
                                                </button>
                                            }
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedCurrencies.Count</strong> از <strong>@filteredCurrencies.Count</strong> ارز
                </span>

                <!-- صفحه‌بندی -->
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد ارز در هر صفحه" />
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش ارز -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content currency-entry-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش ارز" : "ایجاد ارز جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات ارز -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-currency-exchange me-2"></i> اطلاعات ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash text-muted me-1"></i> کد ارز <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@currencyCodeDisplay" disabled readonly />
                                        <small class="text-muted">کد ارز قابل ویرایش نیست</small>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control"
                                               @bind="currentCurrency.Code" placeholder="مثال: USD" />
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-tag text-muted me-1"></i> نام ارز <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCurrency.Name" placeholder="مثال: دلار آمریکا" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-currency-dollar text-muted me-1"></i> سمبل (نماد)
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCurrency.Symbol" placeholder="مثال: $" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-123 text-muted me-1"></i> تعداد اعشار
                                    </label>
                                    <input type="text"
                                           class="form-control currency-decimal-places"
                                           @bind="DecimalPlacesInput"
                                           @bind:event="oninput"
                                           inputmode="numeric"
                                           maxlength="1" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">اولویت پایه نرخ</label>
                                    <input type="number" class="form-control"
                                           @bind="currentCurrency.QuotationPriority" min="1" />
                                    <small class="text-muted">عدد کمتر یعنی ارز در جفت‌ارز، پایه قرار می‌گیرد.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش ارز: <strong>@currencyCodeDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveCurrency()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید فعال/غیرفعال‌سازی -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CurrencyDto> currencies = new();
    private List<CurrencyDto> filteredCurrencies = new();

    private string _searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(statusFilter);
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "Code";
    private bool sortAscending = true;

    private List<CurrencyDto> pagedCurrencies
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredCurrencies;
            switch (sortColumn)
            {
                case "Code":
                    sorted = sortAscending ? filteredCurrencies.OrderBy(c => c.Code).ToList() : filteredCurrencies.OrderByDescending(c => c.Code).ToList();
                    break;
                case "Name":
                    sorted = sortAscending ? filteredCurrencies.OrderBy(c => c.Name).ToList() : filteredCurrencies.OrderByDescending(c => c.Name).ToList();
                    break;
                default:
                    sorted = filteredCurrencies.OrderByDescending(c => c.Code).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredCurrencies.Count / pageSize);

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private string? currencyCodeDisplay;

    private CreateCurrencyDto currentCurrency = new();

    private string DecimalPlacesInput
    {
        get => currentCurrency.DecimalPlaces.ToString();
        set
        {
            var digit = value?.FirstOrDefault(character => character is >= '0' and <= '8') ?? '\0';
            currentCurrency.DecimalPlaces = digit == '\0' ? 0 : digit - '0';
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            isLoading = true;
            var result = await CurrencyService.GetAllAsync();
            currencies = result.ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = currencies.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(currency =>
                currency.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                currency.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (currency.Symbol?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        query = statusFilter switch
        {
            "Active" => query.Where(currency => currency.IsActive),
            "Inactive" => query.Where(currency => !currency.IsActive),
            _ => query
        };

        filteredCurrencies = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        statusFilter = string.Empty;
        filteredCurrencies = currencies;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentCurrency = new CreateCurrencyDto { QuotationPriority = 1000 };
        currencyCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var currency = await CurrencyService.GetByIdAsync(id);
            if (currency != null)
            {
                currencyCodeDisplay = currency.Code;
                currentCurrency = new CreateCurrencyDto
                {
                    Code = currency.Code,
                    Name = currency.Name,
                    Symbol = currency.Symbol,
                    DecimalPlaces = currency.DecimalPlaces,
                    QuotationPriority = currency.QuotationPriority
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارز: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task SaveCurrency()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (!isEditMode && string.IsNullOrWhiteSpace(currentCurrency.Code))
            validationErrors.Add("کد ارز الزامی است");
        if (string.IsNullOrWhiteSpace(currentCurrency.Name))
            validationErrors.Add("نام ارز الزامی است");
        if (currentCurrency.DecimalPlaces < 0)
            validationErrors.Add("تعداد اعشار نمی‌تواند منفی باشد");
        if (currentCurrency.QuotationPriority <= 0)
            validationErrors.Add("اولویت نرخ باید بزرگتر از صفر باشد");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCurrencyDto
                {
                    Name = currentCurrency.Name,
                    Symbol = currentCurrency.Symbol,
                    DecimalPlaces = currentCurrency.DecimalPlaces,
                    QuotationPriority = currentCurrency.QuotationPriority,
                    IsActive = true
                };
                await CurrencyService.UpdateAsync(editId, updateRequest);
                successMessage = "ارز با موفقیت ویرایش شد";
            }
            else
            {
                await CurrencyService.CreateAsync(currentCurrency);
                successMessage = "ارز با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadCurrencies();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDeactivateConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "deactivate";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این ارز را غیرفعال کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowActivateConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "activate";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این ارز را فعال کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "deactivate")
            {
                await CurrencyService.DeactivateAsync(confirmId);
                successMessage = "ارز با موفقیت غیرفعال شد";
            }
            else if (confirmActionType == "activate")
            {
                await CurrencyService.ActivateAsync(confirmId);
                successMessage = "ارز با موفقیت فعال شد";
            }

            showConfirmModal = false;
            await LoadCurrencies();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
