    // ===== مشاهده حساب =====
    private void ViewAccount(long customerId)
    {
        NavigationManager.NavigateTo($"/customers/{customerId}");
    }

    private async Task CreateAccountForReceiver(CustomerDto customer)
    {
        if (HasCustomerAccount(customer.Id) || creatingAccountCustomerId != 0)
            return;

        pageOperationMessage = string.Empty;
        pageOperationError = string.Empty;
        try
        {
            creatingAccountCustomerId = customer.Id;
            await AccountService.CreateAsync(new CreateAccountDto
            {
                AccountType = "Customer",
                AccountName = $"مشتری: {customer.FullName}",
                ReferenceType = "Customer",
                ReferenceId = customer.Id,
                HasInitialBalance = false
            });

            await LoadAccounts();
            await LoadCustomers();
            pageOperationMessage = $"حساب {customer.FullName} ساخته شد و اکنون در تب مشتریان قرار دارد.";
        }
        catch (Exception ex)
        {
            pageOperationError = $"ایجاد حساب انجام نشد: {ex.Message}";
        }
        finally
        {
            creatingAccountCustomerId = 0;
            StateHasChanged();
        }
    }

    private async Task LoadAccountData(long customerId)
    {
        try
        {
            isBalanceLoading = true;
            isLedgerLoading = true;
            StateHasChanged();

            var accounts = await AccountService.GetByReferenceAsync("Customer", customerId);
            var customerAccount = accounts.FirstOrDefault();

            if (customerAccount == null)
            {
                validationErrors.Add("حساب مرتبط با این مشتری یافت نشد.");
                isBalanceLoading = false;
                isLedgerLoading = false;
                StateHasChanged();
                return;
            }

            var balanceResult = await LedgerService.GetAccountBalancesAsync(customerAccount.Id);
            balanceSummary = balanceResult.ToList();

            var ledgerResult = await LedgerService.GetCustomerLedgerAsync(customerId);
            ledgerEntries = ledgerResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های حساب: {ex.Message}");
        }
        finally
        {
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

