@page "/customers"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@inject ICustomerService CustomerService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject ILedgerService LedgerService
@inject ITransactionService TransactionService
@inject IFileService FileService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>مدیریت مشتریان</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="مدیریت مشتریان"
                   Subtitle="لیست و جستجوی مشتریان"
                   Icon="bi-people-fill">
        <Stats>
            <PageHeaderStats AriaLabel="آمار مشتریان">
                <PageHeaderStat Label="کل" Value="@activeTypeCustomers.Count" Icon="bi-people" />
                <PageHeaderStat Label="فعال" Value="@activeTypeCustomers.Count(c => !c.IsArchived)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="بایگانی" Value="@activeTypeCustomers.Count(c => c.IsArchived)" Icon="bi-archive" Tone="danger" />
                <PageHeaderStat Label="امروز" Value="@activeTypeCustomers.Count(c => c.CreatedAt.ToLocalTime().Date == DateTime.Today)" Icon="bi-clock-history" Tone="info" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <ArchiveViewToggle @bind-ShowArchived="showArchived"
                               ArchivedCount="@activeTypeCustomers.Count(c => c.IsArchived)"
                               @bind-ShowArchived:after="ArchiveViewChanged" />
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> @(IsRegisteredReceiverTab ? "گیرنده جدید" : "مشتری جدید")
            </button>
        </Actions>
    </AppPageHeader>

    <div class="customer-type-tabs" role="tablist" aria-label="نوع اشخاص ثبت‌شده">
        <button type="button"
                class="@(!IsRegisteredReceiverTab ? "active" : null)"
                @onclick='() => SelectCustomerType("Customers")'>
            مشتریان
        </button>
        <button type="button"
                class="@(IsRegisteredReceiverTab ? "active" : null)"
                @onclick='() => SelectCustomerType("RegisteredReceivers")'>
            گیرندگان ثبت‌شده
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(pageOperationMessage))
    {
        <div class="alert alert-success py-2">@pageOperationMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(pageOperationError))
    {
        <div class="alert alert-danger py-2">@pageOperationError</div>
    }

    <CompactFilterBar AriaLabel="@(IsRegisteredReceiverTab ? "جستجوی گیرندگان ثبت‌شده" : "جستجوی مشتریان")"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm))"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با کد، نام، نام پدر، تلفن یا تذکره..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredCustomers.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "CustomerCode" ? "active" : "")" @onclick="@(() => SortBy("CustomerCode"))">
                                کد مشتری
                                @if (sortColumn == "CustomerCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "FullName" ? "active" : "")" @onclick="@(() => SortBy("FullName"))">
                                نام کامل
                                @if (sortColumn == "FullName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>نام پدر</th>
                            <th>شماره تلفن</th>
                            <th>شماره تذکره</th>
                            <th>آدرس</th>
                            <th>وضعیت</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && customers == null)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedCustomers.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">@(IsRegisteredReceiverTab ? "هیچ گیرندهٔ ثبت‌شده‌ای یافت نشد" : "هیچ مشتری‌ای یافت نشد")</span>
                                        <p class="text-muted small">@GetEmptyStateDescription()</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredCustomers.Count : pageSize) + 1;
                            @foreach (var customer in pagedCustomers)
                            {
                                <tr class="@(customer.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@customer.CustomerCode</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@customer.FullName</span>
                                    </td>
                                    <td>@(customer.FatherName ?? "—")</td>
                                    <td>
                                        <span class="phone-number">@customer.PhoneNumber</span>
                                    </td>
                                    <td>@customer.TazkiraNumber</td>
                                    <td>
                                        <span class="overflow-ellipsis">@customer.Address</span>
                                    </td>
                                    <td>
                                        @if (customer.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات مشتری {customer.FullName}")">
                                            @if (HasCustomerAccount(customer.Id))
                                            {
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ViewAccount(customer.Id)">
                                                    <i class="bi bi-eye text-primary"></i>
                                                    مشاهده مشتری
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => OpenEditModal(customer.Id)">
                                                    <i class="bi bi-pencil text-primary"></i>
                                                    ویرایش مشخصات
                                                </button>
                                                @if (!customer.IsArchived)
                                                {
                                                    <button type="button" class="operation-menu-item" role="menuitem"
                                                            disabled="@(creatingAccountCustomerId == customer.Id)"
                                                            @onclick="() => CreateAccountForReceiver(customer)">
                                                        <i class="bi bi-wallet2 text-success"></i>
                                                        ایجاد حساب مشتری
                                                    </button>
                                                }
                                            }
                                            @if (customer.IsArchived)
                                            {
                                                <div class="operation-menu-divider"></div>
                                                <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ShowUnarchiveConfirm(customer.Id)">
                                                    <i class="bi bi-arrow-counterclockwise text-success"></i>
                                                    خروج از بایگانی
                                                </button>
                                            }
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedCustomers.Count</strong> از <strong>@filteredCustomers.Count</strong> @(IsRegisteredReceiverTab ? "گیرندهٔ ثبت‌شده" : "مشتری")
                </span>

                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد مشتری در هر صفحه" />
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش مشتری -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @GetCustomerModalTitle()
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-person-badge me-2"></i> اطلاعات مشتری
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold d-flex align-items-center gap-1">
                                        <i class="bi bi-person text-muted"></i>
                                        <span class="d-inline-flex align-items-baseline flex-nowrap gap-1 text-nowrap">
                                            نام کامل <span class="text-danger d-inline-block flex-shrink-0">*</span>
                                        </span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCustomer.FullName" placeholder="نام و نام خانوادگی" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person-vcard text-muted me-1"></i> نام پدر
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCustomer.FatherName" placeholder="نام پدر" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-phone text-muted me-1"></i> شماره تلفن
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCustomer.PhoneNumber" placeholder="مثال: ۰۷۸۰ ۱۲۳ ۴۵۶" dir="ltr" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-card-text text-muted me-1"></i> شماره تذکره
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCustomer.TazkiraNumber" placeholder="شماره تذکره" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person-square text-muted me-1"></i> عکس مشتری
                                    </label>
                                    <InputFile class="form-control" OnChange="OnCustomerPhotoUpload" accept="image/*" />
                                    @if (!string.IsNullOrWhiteSpace(currentCustomer.PhotoPath))
                                    {
                                        <a class="small d-inline-block mt-2" href="@FileService.GetFileUrl(currentCustomer.PhotoPath)" target="_blank">مشاهده عکس</a>
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-card-image text-muted me-1"></i> عکس تذکره
                                    </label>
                                    <InputFile class="form-control" OnChange="OnCustomerTazkiraUpload" accept="image/*" />
                                    @if (!string.IsNullOrWhiteSpace(currentCustomer.TazkiraImagePath))
                                    {
                                        <a class="small d-inline-block mt-2" href="@FileService.GetFileUrl(currentCustomer.TazkiraImagePath)" target="_blank">مشاهده عکس تذکره</a>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo-alt text-muted me-1"></i> آدرس
                                    </label>
                                    <textarea class="form-control" @bind="currentCustomer.Address" rows="2" placeholder="آدرس کامل"></textarea>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <textarea class="form-control" @bind="currentCustomer.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                                </div>
                            </div>

                        </div>
                    </div>

                    @if (!isEditMode && !IsRegisteredReceiverTab)
                    {
                        <div class="modern-card mb-4">
                            <div class="card-header">
                                <h6 class="text-primary"><i class="bi bi-shield-check me-2"></i> سقف بدهکاری</h6>
                            </div>
                            <div class="card-body">
                                <DebtLimitFields Limits="currentCustomer.DebtLimits" Currencies="currencies" />
                            </div>
                        </div>

                        <div class="customer-initial-balance-switch">
                            <input class="form-check-input" type="checkbox" id="customerHasInitialBalance" @bind="HasInitialBalance" />
                            <label class="form-check-label fw-bold" for="customerHasInitialBalance">
                                <i class="bi bi-plus-circle text-primary me-1"></i> افزودن موجودی اولیه
                            </label>
                        </div>

                        @if (hasInitialBalance)
                        {
                            <div class="modern-card customer-initial-balance-card mt-2 mb-4">
                                <div class="card-header">
                                    <h6 class="text-primary"><i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه</h6>
                                </div>
                                <div class="card-body">
                                    <div class="customer-initial-balance-grid">
                                        @foreach (var item in initialBalances)
                                        {
                                            var itemCurrency = currencies.FirstOrDefault(currency => currency.Id == item.CurrencyId);
                                            var itemIsIncomplete = initialBalanceValidationAttempted && !IsEmptyInitialBalance(item) && !IsCompleteInitialBalance(item);
                                            <div class="customer-initial-balance-item" @key="item">
                                                <div class="customer-initial-balance-controls @(itemIsIncomplete ? "customer-initial-balance-invalid" : string.Empty)">
                                                    <select class="customer-initial-balance-currency" @bind="item.CurrencyId" aria-label="واحد پولی موجودی اولیه">
                                                        <option value="0">انتخاب ارز</option>
                                                        @foreach (var currency in currencies)
                                                        {
                                                            <option value="@currency.Id">@currency.Name</option>
                                                        }
                                                    </select>

                                                    <MoneyInput class="customer-initial-balance-amount" @bind-Value="item.Amount" min="0" placeholder="مبلغ" />

                                                    <select class="customer-initial-balance-direction @(item.Direction == "Debit" ? "is-debit" : "is-credit")"
                                                            @bind="item.Direction" aria-label="نوع موجودی اولیه">
                                                        <option value="Debit">بدهکار</option>
                                                        <option value="Credit">طلبکار</option>
                                                    </select>

                                                    <div class="customer-initial-balance-account @(itemIsIncomplete && item.OppositeAccountId <= 0 ? "customer-initial-balance-invalid" : string.Empty)">
                                                        <AccountSearchSelect Accounts="@accounts"
                                                                             @bind-Value="item.OppositeAccountId"
                                                                             Placeholder="حساب طرف مقابل"
                                                                             ShowBalanceSummary="false" />
                                                    </div>
                                                </div>

                                                @if (item.Amount > 0)
                                                {
                                                    <small class="customer-initial-balance-words">
                                                        @DariNumberToWords.ToWords(item.Amount) @(itemCurrency?.Name ?? string.Empty)
                                                    </small>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="customer-initial-balance-actions">
                                        <button type="button" class="customer-initial-balance-icon customer-initial-balance-delete"
                                                title="حذف آخرین ارز" aria-label="حذف آخرین ارز"
                                                disabled="@(initialBalances.Count == 0)" @onclick="RemoveLastInitialBalance">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button type="button" class="customer-initial-balance-icon"
                                                title="افزودن ارز دیگر" aria-label="افزودن ارز دیگر" @onclick="AddInitialBalanceRow">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(initialBalanceError))
                                    {
                                        <small class="text-danger d-block mt-2">@initialBalanceError</small>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (isEditMode)
                    {
                        <div class="alert alert-warning mt-2">
                            <i class="bi bi-info-circle"></i>
                            <small>موجودی اولیه فقط در زمان ایجاد مشتری قابل ثبت است. برای تغییر موجودی، از بخش تراکنش‌ها استفاده کنید.</small>
                        </div>
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveCustomer()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : IsRegisteredReceiverTab ? "ایجاد گیرنده" : "افتتاح حساب")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال تأیید بایگانی/خروج از بایگانی -->
<!-- ============================================================ -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال نمایش حساب مشتری -->
<!-- ============================================================ -->
@if (showAccountModal && selectedCustomer != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-wallet2 me-2"></i> حساب مشتری: @selectedCustomer.FullName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseAccountModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">کد مشتری</span>
                                <span class="info-value">@selectedCustomer.CustomerCode</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نام کامل</span>
                                <span class="info-value">@selectedCustomer.FullName</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">شماره تلفن</span>
                                <span class="info-value">@(selectedCustomer.PhoneNumber ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    @if (selectedCustomer.IsArchived)
                                    {
                                        <span class="badge-modern badge-archived">بایگانی شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern badge-active">فعال</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card mb-4">
                        <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1a7a3a); color: white; border-radius: var(--radius-md) var(--radius-md) 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-calculator me-2"></i> جمع‌بندی موجودی به تفکیک ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isBalanceLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (balanceSummary.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <GlobalDataGrid class="table-modern">
                                        <thead>
                                            <tr>
                                                <th>واحد پولی</th>
                                                <th>مانده</th>
                                                <th>وضعیت</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceSummary)
                                            {
                                                <tr>
                                                    <td><strong>@GetCurrencyName(item.CurrencyCode)</strong></td>
                                                    <td class="@(item.Balance >= 0 ? "text-success" : "text-danger") fw-bold fs-5">
                                                        @MoneyFormatHelper.Format(item.Balance)
                                                    </td>
                                                    <td class="@(item.Balance >= 0 ? "text-success" : "text-danger") fw-bold fs-5">
                                                        @(item.Balance >= 0 ? "طلبکار" : "بدهکار")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </GlobalDataGrid>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-inbox fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این مشتری یافت نشد.</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="card-header" style="background: linear-gradient(135deg, #6c757d, #5a6268); color: white; border-radius: var(--radius-md) var(--radius-md) 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i> لیست تراکنش‌های دفتر کل
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isLedgerLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (ledgerEntries.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <GlobalDataGrid class="table-modern table-striped-modern">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>تاریخ</th>
                                                <th>واحد پولی</th>
                                                <th>طلبکار</th>
                                                <th>بدهکار</th>
                                                <th>توضیحات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in ledgerEntries)
                                            {
                                                <tr>
                                                    <td>@entry.Id</td>
                                                    <td><AppDateTime Value="@entry.CreatedAt" /></td>
                                                    <td><span class="badge-modern badge-info">@GetCurrencyName(entry.CurrencyCode)</span></td>
                                                    <td class="text-success fw-bold">@(entry.TalabKar > 0 ? MoneyFormatHelper.Format(entry.TalabKar) : "-")</td>
                                                    <td class="text-danger fw-bold">@(entry.BadehKar > 0 ? MoneyFormatHelper.Format(entry.BadehKar) : "-")</td>
                                                    <td>@entry.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </GlobalDataGrid>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-journal fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این مشتری ثبت نشده است.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseAccountModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- ✅ مودال برداشت/پرداخت (جدید) -->
<!-- ============================================================ -->
@if (showFinancialModal && selectedCustomerForFinancial != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #6f42c1, #5a32a3);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-cash-coin me-2"></i> رسید / برد
                        <span class="text-white-50 small">@selectedCustomerForFinancial.FullName</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseFinancialModal()"></button>
                </div>
                <div class="modal-body">
                    @if (financialErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in financialErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(financialSuccessMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @financialSuccessMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">نوع تراکنش <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="financialTransaction.TransactionType">
                                <option value="Withdraw">برد از حساب</option>
                                <option value="Deposit">رسید به حساب</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">حساب طرف مقابل <span class="text-danger">*</span></label>
                            <AccountSearchSelect Accounts="@accounts"
                                                 @bind-Value="financialTransaction.AccountId"
                                                 Placeholder="جستجوی حساب طرف مقابل..." />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">واحد پولی <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="financialTransaction.CurrencyId">
                                <option value="0">انتخاب کنید</option>
                                @foreach (var curr in currencies)
                                {
                                    <option value="@curr.Id">@curr.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">مقدار <span class="text-danger">*</span></label>
                            <MoneyInput class="form-control" @bind-Value="financialTransaction.Amount" min="0" placeholder="0" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">توضیحات</label>
                            <textarea class="form-control" @bind="financialTransaction.Description" rows="2" placeholder="توضیحات اختیاری"></textarea>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle"></i>
                        <strong>برد:</strong> از حساب مشتری کم می‌شود و به حساب طرف مقابل اضافه می‌شود.
                        <br />
                        <strong>رسید:</strong> به حساب مشتری اضافه می‌شود و از حساب طرف مقابل کم می‌شود.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseFinancialModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-success-modern" @onclick="() => SubmitFinancialTransaction()" disabled="@isFinancialSubmitting">
                        @if (isFinancialSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        ثبت تراکنش
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌ها =====
    private List<CustomerDto> customers = new();
    private List<CustomerDto> filteredCustomers = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();
    private readonly HashSet<long> customerIdsWithAccounts = [];
    private string activeCustomerType = "Customers";
    private long creatingAccountCustomerId;
    private string pageOperationMessage = string.Empty;
    private string pageOperationError = string.Empty;

    private bool IsRegisteredReceiverTab => activeCustomerType == "RegisteredReceivers";
    private List<CustomerDto> activeTypeCustomers => customers
        .Where(customer => IsRegisteredReceiverTab
            ? !HasCustomerAccount(customer.Id)
            : HasCustomerAccount(customer.Id))
        .ToList();

    // ===== جستجو =====
    private string _searchTerm = string.Empty;
    private bool showArchived;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchCustomers();
            }
        }
    }

    // ===== صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "FullName";
    private bool sortAscending = true;

    private List<CustomerDto> pagedCustomers
    {
        get
        {
            var sorted = filteredCustomers;
            switch (sortColumn)
            {
                case "CustomerCode":
                    sorted = sortAscending ? filteredCustomers.OrderBy(c => c.CustomerCode).ToList() : filteredCustomers.OrderByDescending(c => c.CustomerCode).ToList();
                    break;
                case "FullName":
                    sorted = sortAscending ? filteredCustomers.OrderBy(c => c.FullName).ToList() : filteredCustomers.OrderByDescending(c => c.FullName).ToList();
                    break;
                default:
                    sorted = filteredCustomers.OrderByDescending(c => c.CreatedAt).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredCustomers.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showAccountModal = false;
    private bool showFinancialModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // ===== موجودی اولیه =====
    private bool hasInitialBalance = true;
    private List<InitialBalanceDto> initialBalances = new();
    private bool initialBalanceValidationAttempted = false;
    private string initialBalanceError = string.Empty;

    private bool HasInitialBalance
    {
        get => hasInitialBalance;
        set
        {
            hasInitialBalance = value;
            if (!value)
            {
                initialBalances.Clear();
                initialBalanceValidationAttempted = false;
                initialBalanceError = string.Empty;
            }
            else if (initialBalances.Count == 0)
            {
                initialBalances.Add(new InitialBalanceDto());
            }
        }
    }

    // ===== متغیرهای کمکی =====
    private CreateCustomerDto currentCustomer = new();

    // ===== متغیرهای مربوط به مودال نمایش حساب =====
    private CustomerDto? selectedCustomer = null;
    private bool isBalanceLoading = false;
    private bool isLedgerLoading = false;
    private List<BalanceDto> balanceSummary = new();
    private List<LedgerEntryDto> ledgerEntries = new();

    // ===== ✅ متغیرهای مربوط به مودال برداشت/پرداخت =====
    private bool isFinancialSubmitting = false;
    private List<string> financialErrors = new();
    private string financialSuccessMessage = string.Empty;
    private CustomerDto? selectedCustomerForFinancial = null;
    private FinancialTransactionDto financialTransaction = new();

    // ===== ✅ کلاس DTO داخلی برای تراکنش مالی =====
    public class FinancialTransactionDto
    {
        public long CustomerId { get; set; }
        public string TransactionType { get; set; } = "Withdraw";
        public long AccountId { get; set; }
        public long CurrencyId { get; set; }
        public decimal Amount { get; set; }
        public string? Description { get; set; }
    }

    // ===== بارگذاری داده‌ها =====
    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadCustomers();
        await LoadCurrencies();
    }

    private async Task LoadCustomers()
    {
        try
        {
            isLoading = true;
            var result = await CustomerService.GetAllAsync();
            customers = result.ToList();
            SearchCustomers();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری مشتریان: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            var allAccounts = result.ToList();
            customerIdsWithAccounts.Clear();
            foreach (var account in allAccounts.Where(account =>
                         account.ReferenceId.HasValue &&
                         (string.Equals(account.ReferenceType, "Customer", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(account.AccountType, "Customer", StringComparison.OrdinalIgnoreCase))))
            {
                customerIdsWithAccounts.Add(account.ReferenceId!.Value);
            }

            accounts = allAccounts.Where(a => !a.IsArchived).ToList();
            SearchCustomers();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    // ===== جستجو =====
    private void SearchCustomers()
    {
        var query = activeTypeCustomers.Where(c => c.IsArchived == showArchived);
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(c =>
                c.CustomerCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                c.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (c.FatherName != null && c.FatherName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (c.PhoneNumber != null && c.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (c.TazkiraNumber != null && c.TazkiraNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (c.Address != null && c.Address.Contains(term, StringComparison.OrdinalIgnoreCase))
            );
        }
        filteredCustomers = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredCustomers = activeTypeCustomers.Where(c => c.IsArchived == showArchived).ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ArchiveViewChanged()
    {
        SearchCustomers();
    }

    private void SelectCustomerType(string customerType)
    {
        if (activeCustomerType == customerType)
            return;

        activeCustomerType = customerType;
        showArchived = false;
        _searchTerm = string.Empty;
        pageOperationMessage = string.Empty;
        pageOperationError = string.Empty;
        currentPage = 1;
        SearchCustomers();
    }

    private bool HasCustomerAccount(long customerId) => customerIdsWithAccounts.Contains(customerId);

    private string GetEmptyStateDescription()
    {
        if (showArchived)
            return IsRegisteredReceiverTab
                ? "هیچ گیرندهٔ ثبت‌شده‌ای در بایگانی وجود ندارد."
                : "هیچ مشتری‌ای در بایگانی وجود ندارد.";

        return IsRegisteredReceiverTab
            ? "مشخصات گیرندگان هنگام اجرای حواله در این بخش ذخیره می‌شود."
            : "برای افزودن مشتری جدید، دکمه «مشتری جدید» را انتخاب کنید.";
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ===== باز و بسته کردن مودال‌ها (ایجاد/ویرایش) =====
    private void OpenCreateModal()
    {
        currentCustomer = new CreateCustomerDto
        {
            OpenAccount = !IsRegisteredReceiverTab
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        initialBalances.Clear();
        hasInitialBalance = false;
        HasInitialBalance = !IsRegisteredReceiverTab;
        initialBalanceValidationAttempted = false;
        initialBalanceError = string.Empty;
        StateHasChanged();
    }

    private string GetCustomerModalTitle()
    {
        if (isEditMode)
            return IsRegisteredReceiverTab ? "ویرایش گیرندهٔ ثبت‌شده" : "ویرایش مشتری";

        return IsRegisteredReceiverTab ? "ایجاد گیرندهٔ جدید" : "ایجاد مشتری جدید";
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var customer = await CustomerService.GetByIdAsync(id);
            if (customer != null)
            {
                currentCustomer = new CreateCustomerDto
                {
                    FullName = customer.FullName,
                    FatherName = customer.FatherName,
                    PhoneNumber = customer.PhoneNumber,
                    TazkiraNumber = customer.TazkiraNumber,
                    PhotoPath = customer.PhotoPath,
                    TazkiraImagePath = customer.TazkiraImagePath,
                    Address = customer.Address,
                    Remarks = customer.Remarks
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
                hasInitialBalance = false;
                initialBalances.Clear();
                initialBalanceValidationAttempted = false;
                initialBalanceError = string.Empty;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری مشتری: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void CloseAccountModal()
    {
        showAccountModal = false;
        selectedCustomer = null;
        balanceSummary.Clear();
        ledgerEntries.Clear();
        validationErrors.Clear();
        StateHasChanged();
    }

    // ===== موجودی اولیه =====
    private static bool IsEmptyInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId <= 0 &&
               item.Amount <= 0 &&
               item.OppositeAccountId <= 0 &&
               string.IsNullOrWhiteSpace(item.Description);
    }

    private static bool IsCompleteInitialBalance(InitialBalanceDto item)
    {
        return item.CurrencyId > 0 && item.Amount > 0 && item.OppositeAccountId > 0;
    }

    private void AddInitialBalanceRow()
    {
        initialBalanceValidationAttempted = true;
        initialBalanceError = string.Empty;

        if (initialBalances.Any(item => !IsCompleteInitialBalance(item)))
        {
            initialBalanceError = "برای افزودن موجودی، ارز، مبلغ بزرگ‌تر از صفر و حساب طرف مقابل را کامل کنید.";
            return;
        }

        if (initialBalances.GroupBy(item => item.CurrencyId).Any(group => group.Count() > 1))
        {
            initialBalanceError = "برای این ارز قبلاً موجودی اولیه افزوده شده است؛ ردیف قبلی را حذف یا همان را استفاده کنید.";
            return;
        }

        initialBalances.Add(new InitialBalanceDto());
        initialBalanceValidationAttempted = false;
    }

    private void RemoveLastInitialBalance()
    {
        if (initialBalances.Count > 0)
            initialBalances.RemoveAt(initialBalances.Count - 1);

        if (hasInitialBalance && initialBalances.Count == 0)
            initialBalances.Add(new InitialBalanceDto());

        initialBalanceValidationAttempted = false;
        initialBalanceError = string.Empty;
    }

    private static InitialBalanceDto CopyInitialBalance(InitialBalanceDto source)
    {
        return new InitialBalanceDto
        {
            CurrencyId = source.CurrencyId,
            Amount = source.Amount,
            Direction = source.Direction,
            OppositeAccountId = source.OppositeAccountId
        };
    }

    // ===== ذخیره‌سازی مشتری =====
    private async Task SaveCustomer()
    {
        validationErrors.Clear();
        successMessage = string.Empty;
        initialBalanceError = string.Empty;

        if (string.IsNullOrWhiteSpace(currentCustomer.FullName))
            validationErrors.Add("نام کامل الزامی است");

        if (currentCustomer.DebtLimits.Any(limit => limit.CurrencyId <= 0 && limit.BadehkarLimit > 0))
            validationErrors.Add("برای مبلغ سقف بدهکاری، ارز را نیز انتخاب کنید");

        if (currentCustomer.DebtLimits
            .Where(limit => limit.CurrencyId > 0)
            .GroupBy(limit => limit.CurrencyId)
            .Any(group => group.Count() > 1))
            validationErrors.Add("برای هر ارز فقط یک سقف بدهکاری وارد کنید");

        var enteredInitialBalances = initialBalances
            .Where(item => !IsEmptyInitialBalance(item))
            .ToList();

        var hasIncompleteInitialBalance = hasInitialBalance &&
                                          enteredInitialBalances.Any(item => !IsCompleteInitialBalance(item));
        initialBalanceValidationAttempted = hasInitialBalance &&
                                            (!enteredInitialBalances.Any() || hasIncompleteInitialBalance);

        if (hasInitialBalance && !enteredInitialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (hasIncompleteInitialBalance)
        {
            initialBalanceError = "اطلاعات موجودی اولیه کامل نیست؛ ارز، مبلغ بزرگ‌تر از صفر و حساب طرف مقابل را وارد کنید.";
            validationErrors.Add(initialBalanceError);
        }

        var hasDuplicateCurrency = hasInitialBalance &&
                                   enteredInitialBalances
                                       .Where(item => item.CurrencyId > 0)
                                       .GroupBy(item => item.CurrencyId)
                                       .Any(group => group.Count() > 1);
        if (hasDuplicateCurrency)
        {
            initialBalanceError = "برای ارز انتخاب‌شده قبلاً یک ردیف موجودی اولیه وجود دارد.";
            validationErrors.Add(initialBalanceError);
        }

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCustomerDto
                {
                    FullName = currentCustomer.FullName,
                    FatherName = currentCustomer.FatherName,
                    PhoneNumber = currentCustomer.PhoneNumber,
                    TazkiraNumber = currentCustomer.TazkiraNumber,
                    PhotoPath = currentCustomer.PhotoPath,
                    TazkiraImagePath = currentCustomer.TazkiraImagePath,
                    Address = currentCustomer.Address,
                    Remarks = currentCustomer.Remarks,
                    IsArchived = false
                };
                await CustomerService.UpdateAsync(editId, updateRequest);
                successMessage = "مشتری با موفقیت ویرایش شد";
            }
            else
            {
                currentCustomer.DebtLimits = currentCustomer.DebtLimits
                    .Where(limit => limit.CurrencyId > 0)
                    .Select(limit => new DebtLimitInputDto
                    {
                        CurrencyId = limit.CurrencyId,
                        BadehkarLimit = limit.BadehkarLimit,
                        IsEnabled = true
                    })
                    .ToList();

                var balancesToSave = enteredInitialBalances
                    .Select(CopyInitialBalance)
                    .ToList();

                if (hasInitialBalance && balancesToSave.Any())
                {
                    currentCustomer.HasInitialBalance = true;
                    currentCustomer.InitialBalances = balancesToSave;
                }
                else
                {
                    currentCustomer.HasInitialBalance = false;
                    currentCustomer.InitialBalances = null;
                }

                await CustomerService.CreateAsync(currentCustomer);
                successMessage = "مشتری با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadAccounts();
            await LoadCustomers();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnCustomerPhotoUpload(InputFileChangeEventArgs e)
    {
        var path = await UploadCustomerImageAsync(e.File, "photos");
        if (path != null)
            currentCustomer.PhotoPath = path;
    }

    private async Task OnCustomerTazkiraUpload(InputFileChangeEventArgs e)
    {
        var path = await UploadCustomerImageAsync(e.File, "tazkira");
        if (path != null)
            currentCustomer.TazkiraImagePath = path;
    }

    private async Task<string?> UploadCustomerImageAsync(IBrowserFile file, string category)
    {
        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var result = await FileService.UploadFileAsync(stream, file.Name, $"customers/{category}");
            if (result.Success)
                return result.FilePath;

            validationErrors.Add(result.ErrorMessage ?? "آپلود عکس ناموفق بود.");
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در آپلود عکس: {ex.Message}");
        }

        return null;
    }

