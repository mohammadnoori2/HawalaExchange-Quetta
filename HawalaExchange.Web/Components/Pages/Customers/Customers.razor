@page "/customers"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject ICustomerService CustomerService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject ILedgerService LedgerService
@inject ITransactionService TransactionService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-people-fill"></i>
                مدیریت مشتریان
                <span class="page-subtitle">لیست و جستجوی مشتریان</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> مشتری جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="stat-number">@customers.Count</div>
                        <div class="stat-label">تعداد مشتریان</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@customers.Count(c => !c.IsArchived)</div>
                        <div class="stat-label">فعال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger">
                        <i class="bi bi-archive"></i>
                    </div>
                    <div>
                        <div class="stat-number">@customers.Count(c => c.IsArchived)</div>
                        <div class="stat-label">بایگانی شده</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-number">@customers.Count(c => c.CreatedAt.Date == DateTime.Today)</div>
                        <div class="stat-label">ایجاد امروز</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجوی مشتریان (کد، نام، تلفن، تذکره)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredCustomers.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th style="min-width: 120px;">کد مشتری</th>
                            <th style="min-width: 150px;">نام کامل</th>
                            <th style="min-width: 130px;">شماره تلفن</th>
                            <th style="min-width: 120px;">شماره تذکره</th>
                            <th style="min-width: 150px;">آدرس</th>
                            <th style="min-width: 100px;">وضعیت</th>
                            <th style="min-width: 260px;" class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && customers == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedCustomers.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ مشتری‌ای یافت نشد</span>
                                        <p class="text-muted small">برای افزودن مشتری جدید، دکمه "مشتری جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredCustomers.Count : pageSize) + 1;
                            @foreach (var customer in pagedCustomers)
                            {
                                <tr class="@(customer.IsArchived ? "table-row-archived" : "")">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@customer.CustomerCode</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar avatar-primary">
                                                @customer.FullName?.Substring(0, Math.Min(2, customer.FullName?.Length ?? 0)).ToUpper()
                                            </div>
                                            <span class="fw-semibold">@customer.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="phone-number">@customer.PhoneNumber</span>
                                    </td>
                                    <td>@customer.TazkiraNumber</td>
                                    <td>
                                        <span class="overflow-ellipsis">@customer.Address</span>
                                    </td>
                                    <td>
                                        @if (customer.IsArchived)
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-archive"></i> بایگانی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewAccount(customer.Id)" title="مشاهده حساب">
                                                <i class="bi bi-wallet2"></i>
                                            </button>
                                            @if (!customer.IsArchived)
                                            {
                                                <!-- ✅ دکمه برداشت/پرداخت (جدید) -->
                                                <button class="action-btn action-btn-financial" @onclick="() => OpenFinancialModal(customer.Id, customer.FullName)" title="برداشت/پرداخت">
                                                    <i class="bi bi-cash-coin"></i>
                                                </button>
                                                <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(customer.Id)" title="ویرایش">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="action-btn action-btn-archive" @onclick="() => ShowArchiveConfirm(customer.Id)" title="بایگانی">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn action-btn-unarchive" @onclick="() => ShowUnarchiveConfirm(customer.Id)" title="خروج از بایگانی">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            <button class="action-btn action-btn-transaction" @onclick="() => ViewTransactions(customer.Id)" title="تراکنش‌ها">
                                                <i class="bi bi-journal"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedCustomers.Count</strong> از <strong>@filteredCustomers.Count</strong> مشتری
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-check-circle-fill"></i> فعال: @customers.Count(c => !c.IsArchived)
                </span>
                <span class="badge-modern badge-archived">
                    <i class="bi bi-archive-fill"></i> بایگانی: @customers.Count(c => c.IsArchived)
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش مشتری (همانند قبل) -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش مشتری" : "ایجاد مشتری جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-person-badge me-2"></i> اطلاعات مشتری
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash text-muted me-1"></i> کد مشتری
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@customerCodeDisplay" disabled readonly />
                                        <small class="text-muted">کد مشتری قابل ویرایش نیست</small>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control bg-light" value="به‌طور خودکار تولید می‌شود" disabled readonly />
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person text-muted me-1"></i> نام کامل <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentCustomer.FullName" placeholder="نام و نام خانوادگی" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-phone text-muted me-1"></i> شماره تلفن
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCustomer.PhoneNumber" placeholder="مثال: ۰۷۸۰ ۱۲۳ ۴۵۶" dir="ltr" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-card-text text-muted me-1"></i> شماره تذکره
                                    </label>
                                    <input type="text" class="form-control" @bind="currentCustomer.TazkiraNumber" placeholder="شماره تذکره" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo-alt text-muted me-1"></i> آدرس
                                    </label>
                                    <textarea class="form-control" @bind="currentCustomer.Address" rows="2" placeholder="آدرس کامل"></textarea>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <textarea class="form-control" @bind="currentCustomer.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                                </div>
                            </div>

                            @if (!isEditMode)
                            {
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="hasInitialBalance"
                                           @bind="hasInitialBalance" />
                                    <label class="form-check-label fw-bold" for="hasInitialBalance">
                                        <i class="bi bi-plus-circle text-success me-1"></i> افزودن موجودی اولیه
                                    </label>
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-info-circle"></i> با ایجاد مشتری، یک حساب با نوع <strong>مشتری</strong> به‌طور خودکار ساخته می‌شود.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    <small>موجودی اولیه فقط در زمان ایجاد مشتری قابل ثبت است. برای تغییر موجودی، از بخش تراکنش‌ها استفاده کنید.</small>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!isEditMode && hasInitialBalance)
                    {
                        <div class="modern-card mb-4" style="border-right: 4px solid var(--primary-color);">
                            <div class="card-header">
                                <h6 class="text-primary">
                                    <i class="bi bi-wallet2 me-2"></i> ثبت موجودی اولیه
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (initialBalances.Any())
                                {
                                    <div class="table-scroll-wrapper mb-3">
                                        <table class="table-modern table-striped-modern">
                                            <thead>
                                                <tr>
                                                    <th>واحد پولی</th>
                                                    <th>مقدار</th>
                                                    <th>نوع</th>
                                                    <th>حساب طرف مقابل</th>
                                                    <th>توضیحات</th>
                                                    <th class="text-center">عملیات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in initialBalances)
                                                {
                                                    var currency = currencies.FirstOrDefault(c => c.Id == item.CurrencyId);
                                                    var account = accounts.FirstOrDefault(a => a.Id == item.OppositeAccountId);
                                                    <tr>
                                                        <td>@(currency?.Name ?? "نامشخص") (@(currency?.Code ?? ""))</td>
                                                        <td class="fw-bold">@item.Amount.ToString("N2")</td>
                                                        <td>
                                                            <span class="badge-modern @(item.Direction == "Debit" ? "badge-danger" : "badge-success")">
                                                                @(item.Direction == "Debit" ? "بدهکار" : "بستانکار")
                                                            </span>
                                                        </td>
                                                        <td>@(account?.AccountName ?? "نامشخص")</td>
                                                        <td>@item.Description</td>
                                                        <td class="text-center">
                                                            <button class="action-btn action-btn-delete" @onclick="() => RemoveInitialBalance(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">هیچ موجودی اولیه‌ای ثبت نشده است.</div>
                                }

                                <hr />

                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small">واحد پولی <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.CurrencyId">
                                            <option value="0">انتخاب کنید</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name (@currency.Code)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">مقدار <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" @bind="newInitialBalance.Amount" step="0.01" min="0" placeholder="0" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">نوع <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.Direction">
                                            <option value="Debit">بدهکار</option>
                                            <option value="Credit">بستانکار</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold small">حساب طرف مقابل <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="newInitialBalance.OppositeAccountId">
                                            <option value="0">انتخاب حساب</option>
                                            @foreach (var acc in accounts)
                                            {
                                                <option value="@acc.Id">@acc.AccountName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold small">توضیحات</label>
                                        <input type="text" class="form-control" @bind="newInitialBalance.Description" placeholder="اختیاری" />
                                    </div>
                                    <div class="col-md-1">
                                        <button class="btn-modern btn-success-modern w-100" @onclick="AddInitialBalance" disabled="@(!CanAddInitialBalance())">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش مشتری با کد: <strong>@customerCodeDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveCustomer()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال تأیید بایگانی/خروج از بایگانی -->
<!-- ============================================================ -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال نمایش حساب مشتری -->
<!-- ============================================================ -->
@if (showAccountModal && selectedCustomer != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-wallet2 me-2"></i> حساب مشتری: @selectedCustomer.FullName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseAccountModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">کد مشتری</span>
                                <span class="info-value">@selectedCustomer.CustomerCode</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">نام کامل</span>
                                <span class="info-value">@selectedCustomer.FullName</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">شماره تلفن</span>
                                <span class="info-value">@(selectedCustomer.PhoneNumber ?? "—")</span>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    @if (selectedCustomer.IsArchived)
                                    {
                                        <span class="badge-modern badge-archived">بایگانی شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern badge-active">فعال</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card mb-4">
                        <div class="card-header" style="background: linear-gradient(135deg, #28a745, #1a7a3a); color: white; border-radius: var(--radius-md) var(--radius-md) 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-calculator me-2"></i> جمع‌بندی موجودی به تفکیک ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isBalanceLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (balanceSummary.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table-modern">
                                        <thead>
                                            <tr>
                                                <th>واحد پولی</th>
                                                <th>مانده</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceSummary)
                                            {
                                                <tr>
                                                    <td><strong>@item.CurrencyCode</strong></td>
                                                    <td class="@(item.Balance >= 0 ? "text-primary" : "text-danger") fw-bold fs-5">
                                                        @item.Balance.ToString("N2")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-inbox fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این مشتری یافت نشد.</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="card-header" style="background: linear-gradient(135deg, #6c757d, #5a6268); color: white; border-radius: var(--radius-md) var(--radius-md) 0 0;">
                            <h6 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i> لیست تراکنش‌های دفتر کل
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (isLedgerLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (ledgerEntries.Any())
                            {
                                <div class="table-scroll-wrapper">
                                    <table class="table-modern table-striped-modern">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>تاریخ</th>
                                                <th>واحد پولی</th>
                                                <th>طلبکار</th>
                                                <th>بدهکار</th>
                                                <th>توضیحات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in ledgerEntries)
                                            {
                                                <tr>
                                                    <td>@entry.Id</td>
                                                    <td dir="ltr">@entry.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                                    <td><span class="badge-modern badge-info">@entry.CurrencyCode</span></td>
                                                    <td class="text-danger fw-bold">@(entry.TalabKar > 0 ? entry.TalabKar.ToString("N2") : "-")</td>
                                                    <td class="text-success fw-bold">@(entry.BadehKar > 0 ? entry.BadehKar.ToString("N2") : "-")</td>
                                                    <td>@entry.Description</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3">
                                    <i class="bi bi-journal fs-2 d-block"></i>
                                    <span>هیچ تراکنشی برای این مشتری ثبت نشده است.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseAccountModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- ✅ مودال برداشت/پرداخت (جدید) -->
<!-- ============================================================ -->
@if (showFinancialModal && selectedCustomerForFinancial != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #6f42c1, #5a32a3);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-cash-coin me-2"></i> برداشت/پرداخت
                        <span class="text-white-50 small">@selectedCustomerForFinancial.FullName</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseFinancialModal()"></button>
                </div>
                <div class="modal-body">
                    @if (financialErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in financialErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(financialSuccessMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @financialSuccessMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">نوع تراکنش <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="financialTransaction.TransactionType">
                                <option value="Withdraw">برداشت از حساب</option>
                                <option value="Deposit">پرداخت به حساب</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">حساب طرف مقابل <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="financialTransaction.AccountId">
                                <option value="0">انتخاب حساب</option>
                                @foreach (var acc in accounts)
                                {
                                    <option value="@acc.Id">@acc.AccountName (@acc.AccountCode)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">واحد پولی <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="financialTransaction.CurrencyId">
                                <option value="0">انتخاب کنید</option>
                                @foreach (var curr in currencies)
                                {
                                    <option value="@curr.Id">@curr.Name (@curr.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">مقدار <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="financialTransaction.Amount" step="0.01" min="0" placeholder="0" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label fw-bold">توضیحات</label>
                            <textarea class="form-control" @bind="financialTransaction.Description" rows="2" placeholder="توضیحات اختیاری"></textarea>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle"></i>
                        <strong>برداشت:</strong> از حساب مشتری کم می‌شود و به حساب طرف مقابل اضافه می‌شود.
                        <br />
                        <strong>پرداخت:</strong> به حساب مشتری اضافه می‌شود و از حساب طرف مقابل کم می‌شود.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseFinancialModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-success-modern" @onclick="() => SubmitFinancialTransaction()" disabled="@isFinancialSubmitting">
                        @if (isFinancialSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        ثبت تراکنش
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌ها =====
    private List<CustomerDto> customers = new();
    private List<CustomerDto> filteredCustomers = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();

    // ===== جستجو =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchCustomers();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "FullName";
    private bool sortAscending = true;

    private List<CustomerDto> pagedCustomers
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredCustomers;
            switch (sortColumn)
            {
                case "CustomerCode":
                    sorted = sortAscending ? filteredCustomers.OrderBy(c => c.CustomerCode).ToList() : filteredCustomers.OrderByDescending(c => c.CustomerCode).ToList();
                    break;
                case "FullName":
                    sorted = sortAscending ? filteredCustomers.OrderBy(c => c.FullName).ToList() : filteredCustomers.OrderByDescending(c => c.FullName).ToList();
                    break;
                default:
                    sorted = filteredCustomers.OrderByDescending(c => c.CreatedAt).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool showAccountModal = false;
    private bool showFinancialModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private string confirmActionType = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    // ===== موجودی اولیه =====
    private bool hasInitialBalance = false;
    private List<InitialBalanceDto> initialBalances = new();
    private InitialBalanceDto newInitialBalance = new();

    // ===== متغیرهای کمکی =====
    private string? customerCodeDisplay = null;
    private CreateCustomerDto currentCustomer = new();

    // ===== متغیرهای مربوط به مودال نمایش حساب =====
    private CustomerDto? selectedCustomer = null;
    private bool isBalanceLoading = false;
    private bool isLedgerLoading = false;
    private List<BalanceDto> balanceSummary = new();
    private List<LedgerEntryDto> ledgerEntries = new();

    // ===== ✅ متغیرهای مربوط به مودال برداشت/پرداخت =====
    private bool isFinancialSubmitting = false;
    private List<string> financialErrors = new();
    private string financialSuccessMessage = string.Empty;
    private CustomerDto? selectedCustomerForFinancial = null;
    private FinancialTransactionDto financialTransaction = new();

    // ===== ✅ کلاس DTO داخلی برای تراکنش مالی =====
    public class FinancialTransactionDto
    {
        public long CustomerId { get; set; }
        public string TransactionType { get; set; } = "Withdraw";
        public long AccountId { get; set; }
        public long CurrencyId { get; set; }
        public decimal Amount { get; set; }
        public string? Description { get; set; }
    }

    // ===== بارگذاری داده‌ها =====
    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadCurrencies();
        await LoadAccounts();
    }

    private async Task LoadCustomers()
    {
        try
        {
            isLoading = true;
            var result = await CustomerService.GetAllAsync();
            customers = result.ToList();
            filteredCustomers = customers;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری مشتریان: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            accounts = result.Where(a => !a.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    // ===== جستجو =====
    private void SearchCustomers()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredCustomers = customers;
        }
        else
        {
            var term = _searchTerm.Trim();
            filteredCustomers = customers.Where(c =>
                c.CustomerCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                c.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (c.PhoneNumber != null && c.PhoneNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (c.TazkiraNumber != null && c.TazkiraNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (c.Address != null && c.Address.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredCustomers = customers;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ===== باز و بسته کردن مودال‌ها (ایجاد/ویرایش) =====
    private void OpenCreateModal()
    {
        currentCustomer = new CreateCustomerDto();
        customerCodeDisplay = null;
        isEditMode = false;
        editId = 0;
        successMessage = string.Empty;
        showModal = true;
        hasInitialBalance = false;
        initialBalances.Clear();
        newInitialBalance = new InitialBalanceDto();
        validationErrors.Clear();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var customer = await CustomerService.GetByIdAsync(id);
            if (customer != null)
            {
                customerCodeDisplay = customer.CustomerCode;
                currentCustomer = new CreateCustomerDto
                {
                    FullName = customer.FullName,
                    PhoneNumber = customer.PhoneNumber,
                    TazkiraNumber = customer.TazkiraNumber,
                    Address = customer.Address,
                    Remarks = customer.Remarks
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
                hasInitialBalance = false;
                initialBalances.Clear();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری مشتری: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private void CloseAccountModal()
    {
        showAccountModal = false;
        selectedCustomer = null;
        balanceSummary.Clear();
        ledgerEntries.Clear();
        validationErrors.Clear();
        StateHasChanged();
    }

    // ===== موجودی اولیه =====
    private bool CanAddInitialBalance()
    {
        return newInitialBalance.CurrencyId > 0 &&
               newInitialBalance.Amount > 0 &&
               newInitialBalance.OppositeAccountId > 0;
    }

    private void AddInitialBalance()
    {
        if (!CanAddInitialBalance()) return;

        if (initialBalances.Any(b => b.CurrencyId == newInitialBalance.CurrencyId))
        {
            validationErrors.Add("این واحد پولی قبلاً ثبت شده است.");
            StateHasChanged();
            return;
        }

        initialBalances.Add(new InitialBalanceDto
        {
            CurrencyId = newInitialBalance.CurrencyId,
            Amount = newInitialBalance.Amount,
            Direction = newInitialBalance.Direction,
            OppositeAccountId = newInitialBalance.OppositeAccountId,
            Description = newInitialBalance.Description
        });

        newInitialBalance = new InitialBalanceDto();
        StateHasChanged();
    }

    private void RemoveInitialBalance(InitialBalanceDto item)
    {
        initialBalances.Remove(item);
        StateHasChanged();
    }

    // ===== ذخیره‌سازی مشتری =====
    private async Task SaveCustomer()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentCustomer.FullName))
            validationErrors.Add("نام کامل الزامی است");

        if (hasInitialBalance && !initialBalances.Any())
            validationErrors.Add("حداقل یک موجودی اولیه باید ثبت شود");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateCustomerDto
                {
                    FullName = currentCustomer.FullName,
                    PhoneNumber = currentCustomer.PhoneNumber,
                    TazkiraNumber = currentCustomer.TazkiraNumber,
                    Address = currentCustomer.Address,
                    Remarks = currentCustomer.Remarks,
                    IsArchived = false
                };
                await CustomerService.UpdateAsync(editId, updateRequest);
                successMessage = "مشتری با موفقیت ویرایش شد";
            }
            else
            {
                if (hasInitialBalance && initialBalances.Any())
                {
                    currentCustomer.HasInitialBalance = true;
                    currentCustomer.InitialBalances = initialBalances.ToList();
                }
                else
                {
                    currentCustomer.HasInitialBalance = false;
                    currentCustomer.InitialBalances = null;
                }

                await CustomerService.CreateAsync(currentCustomer);
                successMessage = "مشتری با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadCustomers();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===== بایگانی =====
    private void ShowArchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "archive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این مشتری را بایگانی کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private void ShowUnarchiveConfirm(long id)
    {
        confirmId = id;
        confirmActionType = "unarchive";
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این مشتری را از بایگانی خارج کنید؟";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (confirmActionType == "archive")
            {
                await CustomerService.ArchiveAsync(confirmId);
                successMessage = "مشتری با موفقیت بایگانی شد";
            }
            else if (confirmActionType == "unarchive")
            {
                await CustomerService.UnarchiveAsync(confirmId);
                successMessage = "مشتری با موفقیت از بایگانی خارج شد";
            }

            showConfirmModal = false;
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ===== مشاهده حساب =====
    private async Task ViewAccount(long customerId)
    {
        try
        {
            balanceSummary.Clear();
            ledgerEntries.Clear();
            validationErrors.Clear();
            isBalanceLoading = true;
            isLedgerLoading = true;

            selectedCustomer = await CustomerService.GetByIdAsync(customerId);
            if (selectedCustomer == null)
            {
                validationErrors.Add("مشتری مورد نظر یافت نشد.");
                isBalanceLoading = false;
                isLedgerLoading = false;
                StateHasChanged();
                return;
            }

            showAccountModal = true;
            StateHasChanged();

            await LoadAccountData(selectedCustomer.Id);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات حساب: {ex.Message}");
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAccountData(long customerId)
    {
        try
        {
            isBalanceLoading = true;
            isLedgerLoading = true;
            StateHasChanged();

            var accounts = await AccountService.GetByReferenceAsync("Customer", customerId);
            var customerAccount = accounts.FirstOrDefault();

            if (customerAccount == null)
            {
                validationErrors.Add("حساب مرتبط با این مشتری یافت نشد.");
                isBalanceLoading = false;
                isLedgerLoading = false;
                StateHasChanged();
                return;
            }

            var balanceResult = await LedgerService.GetAccountBalancesAsync(customerAccount.Id);
            balanceSummary = balanceResult.ToList();

            var ledgerResult = await LedgerService.GetCustomerLedgerAsync(customerId);
            ledgerEntries = ledgerResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های حساب: {ex.Message}");
        }
        finally
        {
            isBalanceLoading = false;
            isLedgerLoading = false;
            StateHasChanged();
        }
    }

    // ===== مشاهده تراکنش‌ها =====
    private void ViewTransactions(long id)
    {
        NavigationManager.NavigateTo($"/customers/{id}/transactions");
    }

    // ================================================================
    // ✅ متدهای جدید برای برداشت/پرداخت
    // ================================================================

    private void OpenFinancialModal(long customerId, string customerName)
    {
        selectedCustomerForFinancial = new CustomerDto
        {
            Id = customerId,
            FullName = customerName
        };
        financialTransaction = new FinancialTransactionDto
        {
            CustomerId = customerId,
            TransactionType = "Withdraw",
            AccountId = 0,
            CurrencyId = 0,
            Amount = 0
        };
        financialErrors.Clear();
        financialSuccessMessage = string.Empty;
        showFinancialModal = true;
        StateHasChanged();
    }

    private void CloseFinancialModal()
    {
        showFinancialModal = false;
        selectedCustomerForFinancial = null;
        financialTransaction = new FinancialTransactionDto();
        financialErrors.Clear();
        financialSuccessMessage = string.Empty;
        StateHasChanged();
    }

    private async Task SubmitFinancialTransaction()
    {
        financialErrors.Clear();
        financialSuccessMessage = string.Empty;

        // اعتبارسنجی
        if (financialTransaction.AccountId == 0)
            financialErrors.Add("لطفاً حساب طرف مقابل را انتخاب کنید.");
        if (financialTransaction.CurrencyId == 0)
            financialErrors.Add("لطفاً واحد پولی را انتخاب کنید.");
        if (financialTransaction.Amount <= 0)
            financialErrors.Add("مقدار باید بزرگ‌تر از صفر باشد.");

        if (financialErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isFinancialSubmitting = true;
            StateHasChanged();

            // ۱. ایجاد تراکنش از نوع Adjustment با استفاده از TransactionService.CreateAsync
            var createTransactionDto = new CreateTransactionDto
            {
                TransactionType = "Adjustment",
                BranchId = 1, // مقدار پیش‌فرض – از تنظیمات دریافت کنید
                CustomerId = financialTransaction.CustomerId,
                CustomerFullName = selectedCustomerForFinancial?.FullName,
                Remarks = financialTransaction.Description ?? $"{(financialTransaction.TransactionType == "Withdraw" ? "برداشت" : "پرداخت")} از/به حساب مشتری",
                TransactionDetails = new List<CreateTransactionDetailDto>()
            };

            var transaction = await TransactionService.CreateAsync(createTransactionDto);

            // ۲. دریافت حساب مشتری
            var customerAccount = (await AccountService.GetByReferenceAsync("Customer", financialTransaction.CustomerId)).FirstOrDefault();
            if (customerAccount == null)
            {
                financialErrors.Add("حساب مشتری یافت نشد.");
                return;
            }

            // ۳. دریافت حساب طرف مقابل
            var oppositeAccount = await AccountService.GetByIdAsync(financialTransaction.AccountId);
            if (oppositeAccount == null)
            {
                financialErrors.Add("حساب طرف مقابل یافت نشد.");
                return;
            }

            // ۴. ثبت ورودی‌های دفتر کل با استفاده از LedgerService.CreateLedgerEntryAsync
            decimal customerTalabKar = 0, customerBadehKar = 0;
            decimal oppositeTalabKar = 0, oppositeBadehKar = 0;

            if (financialTransaction.TransactionType == "Withdraw") // برداشت
            {

                customerBadehKar = financialTransaction.Amount; // مشتری بستانکار
                oppositeTalabKar = financialTransaction.Amount; // حساب طرف مقابل بدهکار
            }
            else if (financialTransaction.TransactionType == "Deposit") // پرداخت
            {
                customerTalabKar = financialTransaction.Amount; // مشتری بدهکار
                oppositeBadehKar = financialTransaction.Amount; // حساب طرف مقابل بستانکار
            }

            // ورودی مشتری
            await LedgerService.CreateLedgerEntryAsync(new CreateLedgerEntryDto
            {
                TransactionId = transaction.Id,
                AccountId = customerAccount.Id,
                CurrencyId = financialTransaction.CurrencyId,
                TalabKar = customerTalabKar,
                BadehKar = customerBadehKar,
                Description = $"{(financialTransaction.TransactionType == "Withdraw" ? "برداشت" : "پرداخت")} از/به حساب مشتری"
            });

            // ورودی طرف مقابل
            await LedgerService.CreateLedgerEntryAsync(new CreateLedgerEntryDto
            {
                TransactionId = transaction.Id,
                AccountId = oppositeAccount.Id,
                CurrencyId = financialTransaction.CurrencyId,
                TalabKar = oppositeTalabKar,
                BadehKar = oppositeBadehKar,
                Description = $"طرف مقابل {(financialTransaction.TransactionType == "Withdraw" ? "برداشت" : "پرداخت")} مشتری"
            });

            financialSuccessMessage = $"تراکنش با موفقیت ثبت شد. شماره: {transaction.TransactionNo}";
            await Task.Delay(1500);
            CloseFinancialModal();
            await LoadCustomers();
        }
        catch (Exception ex)
        {
            financialErrors.Add($"خطا در ثبت تراکنش: {ex.Message}");
        }
        finally
        {
            isFinancialSubmitting = false;
            StateHasChanged();
        }
    }
