@page "/deposit-withdraw"

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Components.Shared.Modals
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization

@inject IAccountMoneyOperationService AccountMoneyOperationService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService

@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper" dir="rtl">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-arrow-down-up"></i>
                رسید / برد
                <span class="page-subtitle">ثبت و مدیریت پول‌های رسیده و برده‌شده از حساب‌ها در دفتر کل</span>
            </h5>
        </div>

        <PageHeaderStats AriaLabel="آمار رسید و برد">
            <PageHeaderStat Label="کل" Value="@operations.Count" Icon="bi-list-ul" />
            <PageHeaderStat Label="رسید" Value="@(operations.Count(x => x.OperationType == "Deposit"))" Icon="bi-arrow-down-circle" Tone="success" />
            <PageHeaderStat Label="برد" Value="@(operations.Count(x => x.OperationType == "Withdraw"))" Icon="bi-arrow-up-circle" Tone="danger" />
            <PageHeaderStat Label="امروز" Value="@(operations.Count(x => x.OperationDate.ToLocalTime().Date == DateTime.Today))" Icon="bi-calendar-check" Tone="info" />
        </PageHeaderStats>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle"></i>
                عملیات جدید
            </button>
        </div>
    </div>

    <CompactFilterBar AriaLabel="جستجو و فیلتر عملیات حساب"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(filterOperationType) || filterCurrencyId != 0)"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با حساب، ارز یا توضیحات..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" @bind="filterOperationType" @bind:event="oninput">
                <option value="">همه عملیات</option>
                <option value="Deposit">رسید</option>
                <option value="Withdraw">برد</option>
            </select>
            <select class="form-select compact-quick-filter" @bind="filterCurrencyId" @bind:event="oninput">
                <option value="0">همه ارزها</option>
                @foreach (var currency in currencies)
                {
                    <option value="@currency.Id">@currency.Code - @currency.Name</option>
                }
            </select>
        </QuickFilters>
    </CompactFilterBar>

    @if (validationErrors.Any() && !showModal)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>

                    <PageSizeSelector @bind-Value="pageSize"
                                      @bind-CurrentPage="currentPage" />
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i>
                    @filteredOperations.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>

                            <th class="sortable-header @(sortColumn == "OperationType" ? "active" : "")"
                                @onclick="@(() => SortBy("OperationType"))">
                                نوع
                                @if (sortColumn == "OperationType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>

                            <th class="sortable-header @(sortColumn == "Amount" ? "active" : "")"
                                @onclick="@(() => SortBy("Amount"))">
                                مبلغ
                                @if (sortColumn == "Amount")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>

                            <th class="sortable-header @(sortColumn == "CurrencyCode" ? "active" : "")"
                                @onclick="@(() => SortBy("CurrencyCode"))">
                                ارز
                                @if (sortColumn == "CurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>

                            <th class="sortable-header @(sortColumn == "OperationDate" ? "active" : "")"
                                @onclick="@(() => SortBy("OperationDate"))">
                                تاریخ
                                @if (sortColumn == "OperationDate")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>

                            <th>حساب انتخاب‌شده</th>
                            <th>حساب صندوق/بانک</th>
                            <th>توضیحات</th>
                            <th class="text-center" style="min-width: 160px;">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (isLoading && !operations.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedOperations.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ عملیات رسید یا برد یافت نشد</span>
                                        <p class="text-muted small">برای افزودن عملیات جدید، دکمه "عملیات جدید" را کلیک کنید.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredOperations.Count : pageSize) + 1;

                            @foreach (var item in pagedOperations)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-muted">@rowIndex</span>
                                    </td>

                                    <td>
                                        <span class="badge-modern @GetOperationBadge(item.OperationType)">
                                            @GetOperationTypeName(item.OperationType)
                                        </span>
                                    </td>

                                    <td dir="ltr" class="fw-bold @(item.OperationType == "Deposit" ? "text-success" : "text-danger")">
                                        @MoneyFormatHelper.Format(item.Amount)
                                    </td>

                                    <td>
                                        <span class="badge-modern badge-info">
                                            @item.CurrencyCode
                                        </span>
                                    </td>

                                    <td dir="ltr">
                                        @PersianDateHelper.ToPersianDateTime12(item.OperationDate)
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.AccountName
                                        </span>
                                        <small class="text-muted d-block">
                                            @item.AccountCode
                                        </small>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.CashOrBankAccountName
                                        </span>
                                        <small class="text-muted d-block">
                                            @item.CashOrBankAccountCode
                                        </small>
                                    </td>

                                    <td>
                                        @(item.Description ?? "-")
                                    </td>

                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view"
                                                    @onclick="() => ViewOperation(item.Id)"
                                                    title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>

                                            <button class="action-btn action-btn-edit"
                                                    @onclick="() => OpenEditModal(item.Id)"
                                                    title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button class="action-btn action-btn-delete"
                                                    @onclick="() => ShowDeleteConfirm(item.Id)"
                                                    title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedOperations.Count</strong>
                    از <strong>@filteredOperations.Count</strong> عملیات
                </span>

                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-arrow-down-circle"></i>
                    رسید: @operations.Count(x => x.OperationType == "Deposit")
                </span>

                <span class="badge-modern badge-danger">
                    <i class="bi bi-arrow-up-circle"></i>
                    برد: @operations.Count(x => x.OperationType == "Withdraw")
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ===== کامپوننت مودال واریز/برداشت ===== -->
<DepositWithdrawModal IsVisible="@showModal"
                      IsVisibleChanged="@((bool value) => { showModal = value; StateHasChanged(); })"
                      IsEditMode="@isEditMode"
                      EditId="@editId"
                      EditData="@editOperationData"
                      OnSaveSuccess="@OnOperationSaved"
                      OnEditSuccess="@OnOperationEdited" />

<!-- ===== مودال مشاهده جزئیات ===== -->
@if (showDetailModal && selectedOperation != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i>
                        جزئیات رسید یا برد
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDetailModal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نوع عملیات</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetOperationBadge(selectedOperation.OperationType)">
                                        @GetOperationTypeName(selectedOperation.OperationType)
                                    </span>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">مبلغ</span>
                                <span class="info-value fw-bold" dir="ltr">
                                    @MoneyFormatHelper.Format(selectedOperation.Amount)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">ارز</span>
                                <span class="info-value">@selectedOperation.CurrencyCode</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">حساب انتخاب‌شده</span>
                                <span class="info-value">
                                    @selectedOperation.AccountName
                                    <small class="text-muted d-block">@selectedOperation.AccountCode</small>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">حساب صندوق/بانک</span>
                                <span class="info-value">
                                    @selectedOperation.CashOrBankAccountName
                                    <small class="text-muted d-block">@selectedOperation.CashOrBankAccountCode</small>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">تاریخ</span>
                                <span class="info-value" dir="ltr">
                                    @PersianDateHelper.ToPersianDateTime12(selectedOperation.OperationDate)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">توضیحات</span>
                                <span class="info-value">@(selectedOperation.Description ?? "-")</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3 mb-0">
                        <strong>لیجر مربوطه:</strong>

                        @if (selectedOperation.OperationType == "Deposit")
                        {
                            <div class="mt-2" dir="ltr">
                                Cash/Bank: TalabKar |
                                Selected Account: BadehKar
                            </div>
                        }
                        else
                        {
                            <div class="mt-2" dir="ltr">
                                Selected Account: TalabKar |
                                Cash/Bank: BadehKar
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseDetailModal">
                        <i class="bi bi-x-circle"></i>
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ===== مودال تأیید حذف ===== -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        تأیید حذف
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDeleteModal"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>

                    <p class="fs-5">
                        آیا مطمئن هستید که می‌خواهید این عملیات را حذف کنید؟
                    </p>

                    <p class="text-muted small">
                        با حذف آن، ورودی‌های دفتر کل مربوط به این عملیات نیز حذف می‌شوند.
                    </p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseDeleteModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-danger-modern"
                            @onclick="ConfirmDelete"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                        }

                        تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountMoneyOperationDto> operations = new();
    private List<AccountMoneyOperationDto> filteredOperations = new();

    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchOperations();
            }
        }
    }

    private string _filterOperationType = string.Empty;
    private string filterOperationType
    {
        get => _filterOperationType;
        set
        {
            if (_filterOperationType != value)
            {
                _filterOperationType = value;
                SearchOperations();
            }
        }
    }

    private long _filterCurrencyId = 0;
    private long filterCurrencyId
    {
        get => _filterCurrencyId;
        set
        {
            if (_filterCurrencyId != value)
            {
                _filterCurrencyId = value;
                SearchOperations();
            }
        }
    }

    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "OperationDate";
    private bool sortAscending = false;

    // ===== متغیرهای مودال =====
    private bool showModal = false;
    private bool isEditMode = false;
    private long editId = 0;
    private CreateAccountMoneyOperationDto? editOperationData = null;

    // ===== متغیرهای سایر مودال‌ها =====
    private bool showDetailModal = false;
    private bool showDeleteModal = false;
    private bool isLoading = false;
    private long deleteId = 0;

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private AccountMoneyOperationDto? selectedOperation = null;

    private List<AccountMoneyOperationDto> pagedOperations
    {
        get
        {
            var sorted = filteredOperations;

            switch (sortColumn)
            {
                case "OperationType":
                    sorted = sortAscending
                        ? filteredOperations.OrderBy(x => x.OperationType).ToList()
                        : filteredOperations.OrderByDescending(x => x.OperationType).ToList();
                    break;

                case "Amount":
                    sorted = sortAscending
                        ? filteredOperations.OrderBy(x => x.Amount).ToList()
                        : filteredOperations.OrderByDescending(x => x.Amount).ToList();
                    break;

                case "CurrencyCode":
                    sorted = sortAscending
                        ? filteredOperations.OrderBy(x => x.CurrencyCode).ToList()
                        : filteredOperations.OrderByDescending(x => x.CurrencyCode).ToList();
                    break;

                case "OperationDate":
                    sorted = sortAscending
                        ? filteredOperations.OrderBy(x => x.OperationDate).ToList()
                        : filteredOperations.OrderByDescending(x => x.OperationDate).ToList();
                    break;

                default:
                    sorted = filteredOperations
                        .OrderByDescending(x => x.OperationDate)
                        .ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages =>
        pageSize == 0
            ? 1
            : (int)Math.Ceiling((double)filteredOperations.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadOperations();
    }

    private async Task LoadLookupData()
    {
        try
        {
            currencies = (await CurrencyService.GetActiveCurrenciesAsync()).ToList();
            accounts = (await AccountService.GetAllAsync())
                .Where(x => !x.IsArchived)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadOperations()
    {
        try
        {
            isLoading = true;

            var result = await AccountMoneyOperationService.GetAllAsync();

            operations = result.ToList();
            filteredOperations = operations.ToList();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری عملیات‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchOperations()
    {
        var query = operations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();

            query = query.Where(x =>
                (!string.IsNullOrWhiteSpace(x.AccountName) &&
                 x.AccountName.ToLower().Contains(term)) ||

                (!string.IsNullOrWhiteSpace(x.AccountCode) &&
                 x.AccountCode.ToLower().Contains(term)) ||

                (!string.IsNullOrWhiteSpace(x.CashOrBankAccountName) &&
                 x.CashOrBankAccountName.ToLower().Contains(term)) ||

                (!string.IsNullOrWhiteSpace(x.CashOrBankAccountCode) &&
                 x.CashOrBankAccountCode.ToLower().Contains(term)) ||

                (!string.IsNullOrWhiteSpace(x.CurrencyCode) &&
                 x.CurrencyCode.ToLower().Contains(term)) ||

                (!string.IsNullOrWhiteSpace(x.Description) &&
                 x.Description.ToLower().Contains(term))
            );
        }

        if (!string.IsNullOrWhiteSpace(_filterOperationType))
        {
            query = query.Where(x => x.OperationType == _filterOperationType);
        }

        if (_filterCurrencyId > 0)
        {
            query = query.Where(x => x.CurrencyId == _filterCurrencyId);
        }

        filteredOperations = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterOperationType = string.Empty;
        _filterCurrencyId = 0;
        filteredOperations = operations.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        currentPage = 1;
        StateHasChanged();
    }

    // ===== متدهای مودال ایجاد/ویرایش =====

    private void OpenCreateModal()
    {
        isEditMode = false;
        editId = 0;
        editOperationData = null;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var operation = await AccountMoneyOperationService.GetByIdAsync(id);

            if (operation == null)
            {
                validationErrors.Add("عملیات یافت نشد.");
                return;
            }

            editOperationData = new CreateAccountMoneyOperationDto
            {
                OperationType = operation.OperationType,
                OperationDate = operation.OperationDate,
                AccountId = operation.AccountId,
                CashOrBankAccountId = operation.CashOrBankAccountId,
                CurrencyId = operation.CurrencyId,
                Amount = operation.Amount,
                Description = operation.Description
            };

            isEditMode = true;
            editId = id;
            showModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری عملیات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnOperationSaved(CreateAccountMoneyOperationDto newOperation)
    {
        await LoadOperations();
        StateHasChanged();
    }

    private async Task OnOperationEdited(long id)
    {
        await LoadOperations();
        StateHasChanged();
    }

    // ===== متدهای سایر مودال‌ها =====

    private async Task ViewOperation(long id)
    {
        try
        {
            isLoading = true;

            selectedOperation = await AccountMoneyOperationService.GetByIdAsync(id);
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedOperation = null;
        StateHasChanged();
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        validationErrors.Clear();
        successMessage = string.Empty;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteId = 0;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        try
        {
            isLoading = true;

            await AccountMoneyOperationService.DeleteAsync(deleteId);

            successMessage = "عملیات با موفقیت حذف شد.";
            showDeleteModal = false;
            deleteId = 0;

            await LoadOperations();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetOperationTypeName(string operationType)
    {
        return operationType switch
        {
            "Deposit" => "رسید",
            "Withdraw" => "برد",
            _ => "عملیات رسید یا برد"
        };
    }

    private string GetOperationBadge(string operationType)
    {
        return operationType switch
        {
            "Deposit" => "badge-success",
            "Withdraw" => "badge-danger",
            _ => "badge-secondary"
        };
    }
}
