@page "/documents"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IDocumentService DocumentService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-file-earmark"></i>
                مدیریت اسناد
                <span class="page-subtitle">لیست و جستجوی اسناد</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenUploadModal()">
                <i class="bi bi-cloud-arrow-up"></i> آپلود سند جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-file-earmark"></i>
                    </div>
                    <div>
                        <div class="stat-number">@documents.Count</div>
                        <div class="stat-label">تعداد اسناد</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>
                    <div>
                        <div class="stat-number">@documents.Count(d => d.ContentType == "application/pdf")</div>
                        <div class="stat-label">PDF</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-file-earmark-image"></i>
                    </div>
                    <div>
                        <div class="stat-number">@documents.Count(d => d.ContentType.StartsWith("image/"))</div>
                        <div class="stat-label">تصاویر</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-number">@documents.Count(d => d.UploadedAt.Date == DateTime.Today)</div>
                        <div class="stat-label">آپلود امروز</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجو (نام فایل، نوع موجودیت)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- فیلتر نوع موجودیت -->
                <div class="filter-selector">
                    <select class="form-select form-select-sm" 
                    @bind="filterEntityType" @bind:event="oninput">
                        <option value="">همه نوع‌ها</option>
                        <option value="Transaction">تراکنش</option>
                        <option value="Customer">مشتری</option>
                        <option value="Correspondent">نماینده</option>
                        <option value="Account">حساب</option>
                    </select>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredDocuments.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "FileName" ? "active" : "")" @onclick="@(() => SortBy("FileName"))">
                                نام فایل
                                @if (sortColumn == "FileName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "EntityType" ? "active" : "")" @onclick="@(() => SortBy("EntityType"))">
                                نوع موجودیت
                                @if (sortColumn == "EntityType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>شناسه موجودیت</th>
                            <th>نوع محتوا</th>
                            <th class="sortable-header @(sortColumn == "UploadedAt" ? "active" : "")" @onclick="@(() => SortBy("UploadedAt"))">
                                تاریخ آپلود
                                @if (sortColumn == "UploadedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && documents == null)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedDocuments.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ سندی یافت نشد</span>
                                        <p class="text-muted small">برای آپلود سند جدید، دکمه "آپلود سند جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredDocuments.Count : pageSize) + 1;
                            @foreach (var doc in pagedDocuments)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @GetFileIcon(doc.ContentType) text-primary"></i>
                                            <span class="fw-semibold overflow-ellipsis" style="max-width: 200px;">@doc.FileName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-modern @GetEntityTypeBadge(doc.EntityType)">
                                            @GetEntityTypeName(doc.EntityType)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="customer-code">@doc.EntityId</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@doc.ContentType</span>
                                    </td>
                                    <td dir="ltr">@doc.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewDocument(doc.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="action-btn action-btn-print" @onclick="() => DownloadDocument(doc.Id)" title="دانلود">
                                                <i class="bi bi-download"></i>
                                            </button>
                                            <button class="action-btn action-btn-delete" @onclick="() => ShowDeleteConfirm(doc.Id)" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedDocuments.Count</strong> از <strong>@filteredDocuments.Count</strong> سند
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-file-earmark-pdf"></i> PDF: @documents.Count(d => d.ContentType == "application/pdf")
                </span>
                <span class="badge-modern badge-success">
                    <i class="bi bi-file-earmark-image"></i> تصاویر: @documents.Count(d => d.ContentType.StartsWith("image/"))
                </span>
            </div>
        </div>
    </div>
</div>

<!-- مودال آپلود سند -->
@if (showUploadModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-cloud-arrow-up me-2"></i> آپلود سند جدید
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseUploadModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات آپلود -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-cloud-upload me-2"></i> اطلاعات سند
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-tag text-muted me-1"></i> نوع موجودیت <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select"
                                            @bind="uploadDto.EntityType">
                                        <option value="">انتخاب نوع</option>
                                        <option value="Transaction">تراکنش</option>
                                        <option value="Customer">مشتری</option>
                                        <option value="Correspondent">نماینده</option>
                                        <option value="Account">حساب</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash text-muted me-1"></i> شناسه موجودیت <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control"
                                           @bind="uploadDto.EntityId" placeholder="شناسه موجودیت" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-file-earmark text-muted me-1"></i> انتخاب فایل <span class="text-danger">*</span>
                                    </label>
                                    <InputFile class="form-control" OnChange="HandleFileSelected" />
                                    @if (!string.IsNullOrEmpty(selectedFileName))
                                    {
                                        <div class="mt-1 text-success">
                                            <i class="bi bi-check-circle"></i> @selectedFileName
                                        </div>
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-file-earmark-text text-muted me-1"></i> نوع محتوا (اختیاری)
                                    </label>
                                    <input type="text" class="form-control" @bind="uploadDto.ContentType" placeholder="مثال: application/pdf" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseUploadModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => UploadDocument()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-arrow-up"></i>
                        }
                        آپلود
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDeleteModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این سند را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است و فایل از سرور حذف خواهد شد.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDeleteModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DocumentDto> documents = new();
    private List<DocumentDto> filteredDocuments = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchDocuments();
            }
        }
    }

    private string _filterEntityType = "";
    private string filterEntityType
    {
        get => _filterEntityType;
        set
        {
            if (_filterEntityType != value)
            {
                _filterEntityType = value;
                SearchDocuments();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "UploadedAt";
    private bool sortAscending = false;

    private List<DocumentDto> pagedDocuments
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredDocuments;
            switch (sortColumn)
            {
                case "FileName":
                    sorted = sortAscending ? filteredDocuments.OrderBy(d => d.FileName).ToList() : filteredDocuments.OrderByDescending(d => d.FileName).ToList();
                    break;
                case "EntityType":
                    sorted = sortAscending ? filteredDocuments.OrderBy(d => d.EntityType).ToList() : filteredDocuments.OrderByDescending(d => d.EntityType).ToList();
                    break;
                case "UploadedAt":
                    sorted = sortAscending ? filteredDocuments.OrderBy(d => d.UploadedAt).ToList() : filteredDocuments.OrderByDescending(d => d.UploadedAt).ToList();
                    break;
                default:
                    sorted = filteredDocuments.OrderByDescending(d => d.UploadedAt).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredDocuments.Count / pageSize);

    private bool showUploadModal = false;
    private bool showDeleteModal = false;
    private bool isLoading = false;
    private long deleteId = 0;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private UploadDocumentDto uploadDto = new();
    private string selectedFileName = "";
    private byte[]? fileContent;
    private string? selectedContentType;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        try
        {
            isLoading = true;
            var result = await DocumentService.GetAllAsync();
            documents = result.ToList();
            filteredDocuments = documents;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اسناد: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchDocuments()
    {
        var query = documents.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(d =>
                d.FileName.ToLower().Contains(term) ||
                d.EntityType.ToLower().Contains(term)
            );
        }

        if (!string.IsNullOrEmpty(_filterEntityType))
        {
            query = query.Where(d => d.EntityType == _filterEntityType);
        }

        filteredDocuments = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterEntityType = "";
        filteredDocuments = documents;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenUploadModal()
    {
        uploadDto = new UploadDocumentDto
        {
            EntityType = "",
            EntityId = 0,
            FileName = "",
            ContentType = ""
        };
        selectedFileName = "";
        fileContent = null;
        validationErrors.Clear();
        successMessage = string.Empty;
        showUploadModal = true;
        StateHasChanged();
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        StateHasChanged();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            selectedFileName = file.Name;
            selectedContentType = file.ContentType;

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
            fileContent = memoryStream.ToArray();
        }
    }

    private async Task UploadDocument()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(uploadDto.EntityType))
            validationErrors.Add("نوع موجودیت الزامی است");
        if (uploadDto.EntityId == 0)
            validationErrors.Add("شناسه موجودیت الزامی است");
        if (fileContent == null || fileContent.Length == 0)
            validationErrors.Add("انتخاب فایل الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            uploadDto.FileName = selectedFileName;
            uploadDto.ContentType = selectedContentType ?? "";
            uploadDto.FileContent = fileContent;

            await DocumentService.UploadDocumentAsync(uploadDto);
            successMessage = "سند با موفقیت آپلود شد";

            showUploadModal = false;
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در آپلود: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewDocument(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var doc = await DocumentService.GetDocumentByIdAsync(id);
            if (doc == null)
            {
                validationErrors.Add("سند یافت نشد.");
                return;
            }

            var fileBytes = await DocumentService.DownloadDocumentAsync(id);
            var base64 = Convert.ToBase64String(fileBytes);
            var contentType = doc.ContentType ?? "application/octet-stream";

            await JSRuntime.InvokeVoidAsync("viewFile", base64, contentType);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در باز کردن فایل: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadDocument(long id)
    {
        try
        {
            isLoading = true;
            var fileBytes = await DocumentService.DownloadDocumentAsync(id);
            var doc = await DocumentService.GetDocumentByIdAsync(id);
            if (doc == null)
            {
                validationErrors.Add("سند یافت نشد");
                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);
            var contentType = doc.ContentType ?? "application/octet-stream";
            await JSRuntime.InvokeVoidAsync("downloadFile", base64, doc.FileName, contentType);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در دانلود: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await DocumentService.DeleteDocumentAsync(deleteId);
            successMessage = "سند با موفقیت حذف شد";
            showDeleteModal = false;
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetFileIcon(string contentType)
    {
        if (string.IsNullOrEmpty(contentType)) return "bi-file-earmark";

        if (contentType == "application/pdf") return "bi-file-earmark-pdf";
        if (contentType.StartsWith("image/")) return "bi-file-earmark-image";
        if (contentType.Contains("word")) return "bi-file-earmark-word";
        if (contentType.Contains("excel") || contentType.Contains("spreadsheet")) return "bi-file-earmark-excel";
        if (contentType.Contains("zip") || contentType.Contains("compressed")) return "bi-file-earmark-zip";

        return "bi-file-earmark";
    }

    private string GetEntityTypeBadge(string entityType)
    {
        return entityType switch
        {
            "Transaction" => "badge-primary",
            "Customer" => "badge-success",
            "Correspondent" => "badge-info",
            "Account" => "badge-warning",
            _ => "badge-secondary"
        };
    }

    private string GetEntityTypeName(string entityType)
    {
        return entityType switch
        {
            "Transaction" => "تراکنش",
            "Customer" => "مشتری",
            "Correspondent" => "نماینده",
            "Account" => "حساب",
            _ => entityType ?? "نامشخص"
        };
    }
}