@page "/exchangerates"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IExchangeRateService ExchangeRateService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-fluid mt-4" dir="rtl">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, #0061f2, #0050c8);">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h4 class="mb-0">
                    <i class="bi bi-arrow-left-right me-2"></i> مدیریت نرخ‌های ارز
                </h4>
                <button class="btn btn-light btn-lg" @onclick="() => OpenCreateModal()">
                    <i class="bi bi-plus-circle"></i> نرخ جدید
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- نوار جستجو -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="جستجوی نرخ‌ها (کد ارز مبدأ یا مقصد)..."
                               @bind="searchTerm" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" @onclick="() => ClearSearch()" type="button">
                            <i class="bi bi-x-circle"></i> پاک کردن
                        </button>
                    </div>
                </div>
                <div class="col-md-4 text-start">
                    <span class="badge bg-info fs-6 p-2">
                        <i class="bi bi-list-ul"></i> تعداد: @filteredRates.Count
                    </span>
                </div>
            </div>

            <!-- جدول نرخ‌ها -->
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">از ارز</th>
                            <th scope="col">به ارز</th>
                            <th scope="col">نرخ خرید</th>
                            <th scope="col">نرخ فروش</th>
                            <th scope="col">تاریخ مؤثر</th>
                            <th scope="col">ایجاد کننده</th>
                            <th scope="col" style="min-width: 150px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && rates == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredRates.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block"></i>
                                    <span class="fs-5">هیچ نرخ ارزی یافت نشد</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = 1;
                            @foreach (var rate in filteredRates)
                            {
                                <tr>
                                    <td>@rowIndex</td>
                                    <td><strong>@rate.FromCurrencyCode</strong></td>
                                    <td><strong>@rate.ToCurrencyCode</strong></td>
                                    <td dir="ltr">@rate.BuyRate.ToString("N2")</td>
                                    <td dir="ltr">@rate.SellRate.ToString("N2")</td>
                                    <td dir="ltr">@rate.EffectiveDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@rate.CreatedByName</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(rate.Id)" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => ShowDeleteConfirm(rate.Id)" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش نرخ ارز -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش نرخ ارز" : "ایجاد نرخ ارز جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @successMessage
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-arrow-right"></i> از ارز <span class="text-danger">*</span>
                            </label>
                            @if (isEditMode)
                            {
                                <input type="text" class="form-control bg-light" value="@(currencies.FirstOrDefault(c => c.Id == currentRate.FromCurrencyId)?.Code ?? "نامشخص")" disabled readonly />
                                <small class="text-muted">ارز مبدأ قابل تغییر نیست</small>
                            }
                            else
                            {
                                <select class="form-select @(currentRate.FromCurrencyId == 0 ? "is-invalid" : "")"
                                        @bind="currentRate.FromCurrencyId">
                                    <option value="0">انتخاب ارز مبدأ</option>
                                    @foreach (var currency in currencies)
                                    {
                                        <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                    }
                                </select>
                                <div class="invalid-feedback">انتخاب ارز مبدأ الزامی است</div>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-arrow-left"></i> به ارز <span class="text-danger">*</span>
                            </label>
                            @if (isEditMode)
                            {
                                <input type="text" class="form-control bg-light" value="@(currencies.FirstOrDefault(c => c.Id == currentRate.ToCurrencyId)?.Code ?? "نامشخص")" disabled readonly />
                                <small class="text-muted">ارز مقصد قابل تغییر نیست</small>
                            }
                            else
                            {
                                <select class="form-select @(currentRate.ToCurrencyId == 0 ? "is-invalid" : "")"
                                        @bind="currentRate.ToCurrencyId">
                                    <option value="0">انتخاب ارز مقصد</option>
                                    @foreach (var currency in currencies)
                                    {
                                        <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                    }
                                </select>
                                <div class="invalid-feedback">انتخاب ارز مقصد الزامی است</div>
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-coin"></i> نرخ خرید <span class="text-danger">*</span>
                            </label>
                            <input type="number" step="0.0001" class="form-control @(currentRate.BuyRate <= 0 ? "is-invalid" : "")"
                                   @bind="currentRate.BuyRate" placeholder="مثال: 75.5" />
                            <div class="invalid-feedback">نرخ خرید باید بزرگتر از صفر باشد</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-coin"></i> نرخ فروش <span class="text-danger">*</span>
                            </label>
                            <input type="number" step="0.0001" class="form-control @(currentRate.SellRate <= 0 ? "is-invalid" : "")"
                                   @bind="currentRate.SellRate" placeholder="مثال: 76.0" />
                            <div class="invalid-feedback">نرخ فروش باید بزرگتر از صفر باشد</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-calendar-date"></i> تاریخ مؤثر <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" class="form-control @(currentRate.EffectiveDate == default ? "is-invalid" : "")"
                                   @bind="currentRate.EffectiveDate" />
                            <div class="invalid-feedback">تاریخ مؤثر الزامی است</div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info mt-2">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش نرخ ارز از <strong>@(currencies.FirstOrDefault(c => c.Id == currentRate.FromCurrencyId)?.Code ?? "نامشخص")</strong> به <strong>@(currencies.FirstOrDefault(c => c.Id == currentRate.ToCurrencyId)?.Code ?? "نامشخص")</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => SaveRate()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showConfirmModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ExchangeRateDto> rates = new();
    private List<ExchangeRateDto> filteredRates = new();
    private List<CurrencyDto> currencies = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchRates();
            }
        }
    }

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private CreateExchangeRateDto currentRate = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadRates();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetAllAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadRates()
    {
        try
        {
            isLoading = true;
            var result = await ExchangeRateService.GetAllAsync();
            rates = result.ToList();
            filteredRates = rates;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نرخ‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchRates()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredRates = rates;
        }
        else
        {
            var term = _searchTerm.Trim().ToLower();
            filteredRates = rates.Where(r =>
                r.FromCurrencyCode.ToLower().Contains(term) ||
                r.ToCurrencyCode.ToLower().Contains(term)
            ).ToList();
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filteredRates = rates;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentRate = new CreateExchangeRateDto
        {
            EffectiveDate = DateTime.Now,
            FromCurrencyId = 0,
            ToCurrencyId = 0,
            BuyRate = 0,
            SellRate = 0
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var rate = await ExchangeRateService.GetByIdAsync(id);
            if (rate != null)
            {
                currentRate = new CreateExchangeRateDto
                {
                    FromCurrencyId = rate.FromCurrencyId,
                    ToCurrencyId = rate.ToCurrencyId,
                    BuyRate = rate.BuyRate,
                    SellRate = rate.SellRate,
                    EffectiveDate = rate.EffectiveDate
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نرخ ارز: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task SaveRate()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        // اعتبارسنجی
        if (currentRate.FromCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مبدأ الزامی است");
        if (currentRate.ToCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مقصد الزامی است");
        if (currentRate.FromCurrencyId == currentRate.ToCurrencyId)
            validationErrors.Add("ارز مبدأ و مقصد نمی‌توانند یکسان باشند");
        if (currentRate.BuyRate <= 0)
            validationErrors.Add("نرخ خرید باید بزرگتر از صفر باشد");
        if (currentRate.SellRate <= 0)
            validationErrors.Add("نرخ فروش باید بزرگتر از صفر باشد");
        if (currentRate.EffectiveDate == default)
            validationErrors.Add("تاریخ مؤثر الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateExchangeRateDto
                {
                    BuyRate = currentRate.BuyRate,
                    SellRate = currentRate.SellRate,
                    EffectiveDate = currentRate.EffectiveDate
                };
                await ExchangeRateService.UpdateAsync(editId, updateRequest);
                successMessage = "نرخ ارز با موفقیت ویرایش شد";
            }
            else
            {
                // در حالت ایجاد، CreatedBy از سرویس (که کاربر فعلی است) مقداردهی می‌شود.
                await ExchangeRateService.CreateAsync(currentRate);
                successMessage = "نرخ ارز با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadRates();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirm(long id)
    {
        confirmId = id;
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نرخ ارز را حذف کنید؟ این عملیات قابل بازگشت نیست.";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            await ExchangeRateService.DeleteAsync(confirmId);
            successMessage = "نرخ ارز با موفقیت حذف شد";
            showConfirmModal = false;
            await LoadRates();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}