@page "/exchangerates"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject IExchangeRateService ExchangeRateService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>مدیریت نرخ‌های ارز</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="مدیریت نرخ‌های ارز"
                   Subtitle="لیست و جستجوی نرخ‌های ارز"
                   Icon="bi-arrow-left-right">
        <Stats>
            <PageHeaderStats AriaLabel="آمار نرخ‌های ارز">
                <PageHeaderStat Label="کل" Value="@rates.Count" Icon="bi-arrow-left-right" />
                <PageHeaderStat Label="امروز" Value="@rates.Count(r => r.EffectiveDate.Date == DateTime.Today)" Icon="bi-clock-history" Tone="info" />
                <PageHeaderStat Label="هفته" Value="@rates.Count(r => r.EffectiveDate > DateTime.Now.AddDays(-7))" Icon="bi-calendar-check" Tone="success" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> نرخ جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر نرخ‌های ارز"
                      HasActiveFilters="@HasActiveFilters"
                      ActiveFilterCount="@AdvancedFilterCount"
                      Reset="ResetFilters">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با ارز مبدأ یا مقصد..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter"
                    aria-label="ارز مبدأ"
                    @bind="fromCurrencyFilter"
                    @bind:event="oninput"
                    @bind:after="ApplyFilters">
                <option value="">همه ارزهای مبدأ</option>
                @foreach (var currency in currencies.OrderBy(currency => currency.Code))
                {
                    <option value="@currency.Code">@currency.Code</option>
                }
            </select>
            <select class="form-select compact-quick-filter"
                    aria-label="ارز مقصد"
                    @bind="toCurrencyFilter"
                    @bind:event="oninput"
                    @bind:after="ApplyFilters">
                <option value="">همه ارزهای مقصد</option>
                @foreach (var currency in currencies.OrderBy(currency => currency.Code))
                {
                    <option value="@currency.Code">@currency.Code</option>
                }
            </select>
        </QuickFilters>
        <AdvancedFilters>
            <div class="compact-filter-field">
                <label class="form-label">از تاریخ مؤثر</label>
                <PersianDatePicker @bind-Value="fromDateFilter"
                                   @bind-Value:after="ApplyFilters"
                                   IncludeTime="false"
                                   AllowEmpty="true"
                                   Placeholder="انتخاب تاریخ" />
            </div>
            <div class="compact-filter-field">
                <label class="form-label">تا تاریخ مؤثر</label>
                <PersianDatePicker @bind-Value="toDateFilter"
                                   @bind-Value:after="ApplyFilters"
                                   IncludeTime="false"
                                   AllowEmpty="true"
                                   Placeholder="انتخاب تاریخ" />
            </div>
        </AdvancedFilters>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredRates.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "FromCurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("FromCurrencyCode"))">
                                از ارز
                                @if (sortColumn == "FromCurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "ToCurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("ToCurrencyCode"))">
                                به ارز
                                @if (sortColumn == "ToCurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "BuyRate" ? "active" : "")" @onclick="@(() => SortBy("BuyRate"))">
                                نرخ خرید
                                @if (sortColumn == "BuyRate")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "SellRate" ? "active" : "")" @onclick="@(() => SortBy("SellRate"))">
                                نرخ فروش
                                @if (sortColumn == "SellRate")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "EffectiveDate" ? "active" : "")" @onclick="@(() => SortBy("EffectiveDate"))">
                                تاریخ مؤثر
                                @if (sortColumn == "EffectiveDate")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>ایجاد کننده</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && rates == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedRates.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ نرخ ارزی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن نرخ جدید، دکمه "نرخ جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredRates.Count : pageSize) + 1;
                            @foreach (var rate in pagedRates)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@rate.FromCurrencyCode</span>
                                    </td>
                                    <td>
                                        <span class="customer-code">@rate.ToCurrencyCode</span>
                                    </td>
                                    <td dir="ltr" class="fw-bold text-primary">@MoneyFormatHelper.Format(rate.BuyRate)</td>
                                    <td dir="ltr" class="fw-bold text-success">@MoneyFormatHelper.Format(rate.SellRate)</td>
                                    <td><AppDateTime Value="@rate.EffectiveDate" /></td>
                                    <td>@rate.CreatedByName</td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات نرخ {rate.FromCurrencyCode} به {rate.ToCurrencyCode}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => OpenEditModal(rate.Id)">
                                                <i class="bi bi-pencil text-primary"></i>
                                                ویرایش
                                            </button>
                                            <div class="operation-menu-divider"></div>
                                            <button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" @onclick="() => ShowDeleteConfirm(rate.Id)">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </button>
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedRates.Count</strong> از <strong>@filteredRates.Count</strong> نرخ
                </span>

                <!-- صفحه‌بندی -->
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد نرخ در هر صفحه" />
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش نرخ ارز -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content exchange-rate-entry-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش نرخ ارز" : "ایجاد نرخ ارز جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات نرخ ارز -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-currency-exchange me-2"></i> اطلاعات نرخ ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-right text-muted me-1"></i> از ارز <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@(currencies.FirstOrDefault(c => c.Id == currentRate.FromCurrencyId)?.Name ?? "نامشخص")" disabled readonly />
                                        <small class="text-muted">ارز مبدأ قابل تغییر نیست</small>
                                    }
                                    else
                                    {
                                        <select class="form-select"
                                                @bind="currentRate.FromCurrencyId">
                                            <option value="0">انتخاب ارز مبدأ</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name</option>
                                            }
                                        </select>
                                    }
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-left text-muted me-1"></i> به ارز <span class="text-danger">*</span>
                                    </label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@(currencies.FirstOrDefault(c => c.Id == currentRate.ToCurrencyId)?.Name ?? "نامشخص")" disabled readonly />
                                        <small class="text-muted">ارز مقصد قابل تغییر نیست</small>
                                    }
                                    else
                                    {
                                        <select class="form-select"
                                                @bind="currentRate.ToCurrencyId">
                                            <option value="0">انتخاب ارز مقصد</option>
                                            @foreach (var currency in currencies)
                                            {
                                                <option value="@currency.Id">@currency.Name</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-coin text-muted me-1"></i> نرخ خرید <span class="text-danger">*</span>
                                    </label>
                                    <MoneyInput DecimalPlaces="4" class="form-control"
                                                @bind-Value="currentRate.BuyRate" placeholder="مثال: 75.5" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-coin text-muted me-1"></i> نرخ فروش <span class="text-danger">*</span>
                                    </label>
                                    <MoneyInput DecimalPlaces="4" class="form-control"
                                                @bind-Value="currentRate.SellRate" placeholder="مثال: 76.0" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-calendar-date text-muted me-1"></i> تاریخ مؤثر <span class="text-danger">*</span>
                                    </label>
                                    <div class="exchange-rate-date-field">
                                        <PersianDatePicker @bind-Value="currentRate.EffectiveDate"
                                                           IncludeTime="true"
                                                           Placeholder="انتخاب تاریخ و زمان" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش نرخ ارز از <strong>@(currencies.FirstOrDefault(c => c.Id == currentRate.FromCurrencyId)?.Code ?? "نامشخص")</strong> به <strong>@(currencies.FirstOrDefault(c => c.Id == currentRate.ToCurrencyId)?.Code ?? "نامشخص")</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveRate()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseConfirmModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseConfirmModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ExchangeRateDto> rates = new();
    private List<ExchangeRateDto> filteredRates = new();
    private List<CurrencyDto> currencies = new();

    private string _searchTerm = string.Empty;
    private string fromCurrencyFilter = string.Empty;
    private string toCurrencyFilter = string.Empty;
    private DateTime fromDateFilter = DateTime.MinValue;
    private DateTime toDateFilter = DateTime.MinValue;
    private int AdvancedFilterCount =>
        (fromDateFilter != DateTime.MinValue ? 1 : 0) +
        (toDateFilter != DateTime.MinValue ? 1 : 0);
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrWhiteSpace(fromCurrencyFilter) ||
        !string.IsNullOrWhiteSpace(toCurrencyFilter) ||
        AdvancedFilterCount > 0;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "EffectiveDate";
    private bool sortAscending = false;

    private List<ExchangeRateDto> pagedRates
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredRates;
            switch (sortColumn)
            {
                case "FromCurrencyCode":
                    sorted = sortAscending ? filteredRates.OrderBy(r => r.FromCurrencyCode).ToList() : filteredRates.OrderByDescending(r => r.FromCurrencyCode).ToList();
                    break;
                case "ToCurrencyCode":
                    sorted = sortAscending ? filteredRates.OrderBy(r => r.ToCurrencyCode).ToList() : filteredRates.OrderByDescending(r => r.ToCurrencyCode).ToList();
                    break;
                case "BuyRate":
                    sorted = sortAscending ? filteredRates.OrderBy(r => r.BuyRate).ToList() : filteredRates.OrderByDescending(r => r.BuyRate).ToList();
                    break;
                case "SellRate":
                    sorted = sortAscending ? filteredRates.OrderBy(r => r.SellRate).ToList() : filteredRates.OrderByDescending(r => r.SellRate).ToList();
                    break;
                case "EffectiveDate":
                    sorted = sortAscending ? filteredRates.OrderBy(r => r.EffectiveDate).ToList() : filteredRates.OrderByDescending(r => r.EffectiveDate).ToList();
                    break;
                default:
                    sorted = filteredRates.OrderByDescending(r => r.EffectiveDate).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredRates.Count / pageSize);

    private bool showModal = false;
    private bool showConfirmModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long confirmId = 0;
    private string confirmMessage = string.Empty;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private CreateExchangeRateDto currentRate = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadRates();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetAllAsync();
            currencies = result.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری ارزها: {ex.Message}");
        }
    }

    private async Task LoadRates()
    {
        try
        {
            isLoading = true;
            var result = await ExchangeRateService.GetAllAsync();
            rates = result.ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نرخ‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = rates.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(rate =>
                rate.FromCurrencyCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                rate.ToCurrencyCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (rate.CreatedByName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(fromCurrencyFilter))
            query = query.Where(rate => string.Equals(rate.FromCurrencyCode, fromCurrencyFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(toCurrencyFilter))
            query = query.Where(rate => string.Equals(rate.ToCurrencyCode, toCurrencyFilter, StringComparison.OrdinalIgnoreCase));
        if (fromDateFilter != DateTime.MinValue)
            query = query.Where(rate => rate.EffectiveDate.Date >= fromDateFilter.Date);
        if (toDateFilter != DateTime.MinValue)
            query = query.Where(rate => rate.EffectiveDate.Date <= toDateFilter.Date);

        filteredRates = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        fromCurrencyFilter = string.Empty;
        toCurrencyFilter = string.Empty;
        fromDateFilter = DateTime.MinValue;
        toDateFilter = DateTime.MinValue;
        filteredRates = rates;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentRate = new CreateExchangeRateDto
        {
            EffectiveDate = DateTime.Now,
            FromCurrencyId = 0,
            ToCurrencyId = 0,
            BuyRate = 0,
            SellRate = 0
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var rate = await ExchangeRateService.GetByIdAsync(id);
            if (rate != null)
            {
                currentRate = new CreateExchangeRateDto
                {
                    FromCurrencyId = rate.FromCurrencyId,
                    ToCurrencyId = rate.ToCurrencyId,
                    BuyRate = rate.BuyRate,
                    SellRate = rate.SellRate,
                    EffectiveDate = rate.EffectiveDate
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری نرخ ارز: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        StateHasChanged();
    }

    private async Task SaveRate()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (currentRate.FromCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مبدأ الزامی است");
        if (currentRate.ToCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مقصد الزامی است");
        if (currentRate.FromCurrencyId == currentRate.ToCurrencyId)
            validationErrors.Add("ارز مبدأ و مقصد نمی‌توانند یکسان باشند");
        if (currentRate.BuyRate <= 0)
            validationErrors.Add("نرخ خرید باید بزرگتر از صفر باشد");
        if (currentRate.SellRate <= 0)
            validationErrors.Add("نرخ فروش باید بزرگتر از صفر باشد");
        if (currentRate.EffectiveDate == default)
            validationErrors.Add("تاریخ مؤثر الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateExchangeRateDto
                {
                    BuyRate = currentRate.BuyRate,
                    SellRate = currentRate.SellRate,
                    EffectiveDate = currentRate.EffectiveDate
                };
                await ExchangeRateService.UpdateAsync(editId, updateRequest);
                successMessage = "نرخ ارز با موفقیت ویرایش شد";
            }
            else
            {
                await ExchangeRateService.CreateAsync(currentRate);
                successMessage = "نرخ ارز با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadRates();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirm(long id)
    {
        confirmId = id;
        confirmMessage = "آیا مطمئن هستید که می‌خواهید این نرخ ارز را حذف کنید؟ این عملیات قابل بازگشت نیست.";
        showConfirmModal = true;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            await ExchangeRateService.DeleteAsync(confirmId);
            successMessage = "نرخ ارز با موفقیت حذف شد";
            showConfirmModal = false;
            await LoadRates();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
