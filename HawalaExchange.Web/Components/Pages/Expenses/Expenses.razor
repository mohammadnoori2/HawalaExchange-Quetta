@page "/expenses"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IExpenseService ExpenseService
@inject ITransactionService TransactionService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-cash-stack"></i>
                مدیریت هزینه‌ها
                <span class="page-subtitle">لیست و جستجوی هزینه‌ها</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> هزینه جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="stat-number">@expenses.Count</div>
                        <div class="stat-label">تعداد هزینه‌ها</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-number">@expenses.Count(e => e.ExpenseDate.Date == DateTime.Today)</div>
                        <div class="stat-label">هزینه‌های امروز</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div>
                        <div class="stat-number">@expenses.Count(e => e.ExpenseDate > DateTime.Now.AddDays(-7))</div>
                        <div class="stat-label">هفته گذشته</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning">
                        <i class="bi bi-coin"></i>
                    </div>
                    <div>
                        <div class="stat-number">@expenses.Sum(e => e.Amount).ToString("N0")</div>
                        <div class="stat-label">مجموع هزینه‌ها</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجو (عنوان، ارز، توضیحات)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- فیلتر ارز -->
                <div class="filter-selector">
                    <select class="form-select form-select-sm" 
                            @bind="filterCurrencyId" @bind:event="oninput">
                        <option value="0">همه ارزها</option>
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                        }
                    </select>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredExpenses.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "Title" ? "active" : "")" @onclick="@(() => SortBy("Title"))">
                                عنوان
                                @if (sortColumn == "Title")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "Amount" ? "active" : "")" @onclick="@(() => SortBy("Amount"))">
                                مبلغ
                                @if (sortColumn == "Amount")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("CurrencyCode"))">
                                ارز
                                @if (sortColumn == "CurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "ExpenseDate" ? "active" : "")" @onclick="@(() => SortBy("ExpenseDate"))">
                                تاریخ
                                @if (sortColumn == "ExpenseDate")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>تراکنش مرتبط</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && expenses == null)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedExpenses.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ هزینه‌ای یافت نشد</span>
                                        <p class="text-muted small">برای افزودن هزینه جدید، دکمه "هزینه جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredExpenses.Count : pageSize) + 1;
                            @foreach (var expense in pagedExpenses)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-semibold">@expense.Title</span>
                                    </td>
                                    <td dir="ltr" class="fw-bold text-danger">@expense.Amount.ToString("N2")</td>
                                    <td>
                                        <span class="badge-modern badge-info">@expense.CurrencyCode</span>
                                    </td>
                                    <td dir="ltr">@expense.ExpenseDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <a href="/transactions/@expense.TransactionId" target="_blank" class="text-primary">
                                            <i class="bi bi-box-arrow-up-right"></i> @expense.TransactionId
                                        </a>
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewExpense(expense.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(expense.Id)" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="action-btn action-btn-delete" @onclick="() => ShowDeleteConfirm(expense.Id)" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedExpenses.Count</strong> از <strong>@filteredExpenses.Count</strong> هزینه
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-calendar-check"></i> امروز: @expenses.Count(e => e.ExpenseDate.Date == DateTime.Today)
                </span>
                <span class="badge-modern badge-success">
                    <i class="bi bi-calendar-week"></i> هفته گذشته: @expenses.Count(e => e.ExpenseDate > DateTime.Now.AddDays(-7))
                </span>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش هزینه -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش هزینه" : "ایجاد هزینه جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات هزینه -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-cash-stack me-2"></i> اطلاعات هزینه
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-tag text-muted me-1"></i> عنوان <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control"
                                           @bind="currentExpense.Title" placeholder="عنوان هزینه" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-cash-stack text-muted me-1"></i> مبلغ <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" step="0.01" class="form-control"
                                           @bind="currentExpense.Amount" placeholder="مبلغ هزینه" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-coin text-muted me-1"></i> ارز <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select"
                                            @bind="currentExpense.CurrencyId">
                                        <option value="0">انتخاب ارز</option>
                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-calendar-date text-muted me-1"></i> تاریخ هزینه
                                    </label>
                                    <input type="datetime-local" class="form-control" @bind="currentExpense.ExpenseDate" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-receipt text-muted me-1"></i> تراکنش مرتبط <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select"
                                            @bind="currentExpense.TransactionId">
                                        <option value="0">انتخاب تراکنش</option>
                                        @foreach (var transaction in transactions)
                                        {
                                            <option value="@transaction.Id">@transaction.TransactionNo - @transaction.CustomerFullName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <input type="text" class="form-control" @bind="currentExpense.Description" placeholder="توضیحات اضافی" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش هزینه با شناسه: <strong>@editId</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveExpense()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال مشاهده جزئیات هزینه -->
@if (showDetailModal && selectedExpense != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i> جزئیات هزینه
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">عنوان</span>
                                <span class="info-value">@selectedExpense.Title</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">مبلغ</span>
                                <span class="info-value text-danger fw-bold">@selectedExpense.Amount.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">ارز</span>
                                <span class="info-value">@selectedExpense.CurrencyCode</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">تاریخ</span>
                                <span class="info-value">@selectedExpense.ExpenseDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">تراکنش مرتبط</span>
                                <span class="info-value">
                                    <a href="/transactions/@selectedExpense.TransactionId" target="_blank" class="text-primary">
                                        <i class="bi bi-box-arrow-up-right"></i> @selectedExpense.TransactionId
                                    </a>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">توضیحات</span>
                                <span class="info-value">@(selectedExpense.Description ?? "-")</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDetailModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDeleteModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این هزینه را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است و ورودی‌های دفتر کل مربوطه نیز حذف خواهند شد.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDeleteModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ExpenseDto> expenses = new();
    private List<ExpenseDto> filteredExpenses = new();
    private List<TransactionDto> transactions = new();
    private List<CurrencyDto> currencies = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchExpenses();
            }
        }
    }

    private long _filterCurrencyId = 0;
    private long filterCurrencyId
    {
        get => _filterCurrencyId;
        set
        {
            if (_filterCurrencyId != value)
            {
                _filterCurrencyId = value;
                SearchExpenses();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "ExpenseDate";
    private bool sortAscending = false;

    private List<ExpenseDto> pagedExpenses
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredExpenses;
            switch (sortColumn)
            {
                case "Title":
                    sorted = sortAscending ? filteredExpenses.OrderBy(e => e.Title).ToList() : filteredExpenses.OrderByDescending(e => e.Title).ToList();
                    break;
                case "Amount":
                    sorted = sortAscending ? filteredExpenses.OrderBy(e => e.Amount).ToList() : filteredExpenses.OrderByDescending(e => e.Amount).ToList();
                    break;
                case "CurrencyCode":
                    sorted = sortAscending ? filteredExpenses.OrderBy(e => e.CurrencyCode).ToList() : filteredExpenses.OrderByDescending(e => e.CurrencyCode).ToList();
                    break;
                case "ExpenseDate":
                    sorted = sortAscending ? filteredExpenses.OrderBy(e => e.ExpenseDate).ToList() : filteredExpenses.OrderByDescending(e => e.ExpenseDate).ToList();
                    break;
                default:
                    sorted = filteredExpenses.OrderByDescending(e => e.ExpenseDate).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredExpenses.Count / pageSize);

    private bool showModal = false;
    private bool showDetailModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long deleteId = 0;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private ExpenseDto? selectedExpense = null;

    private CreateExpenseDto currentExpense = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadExpenses();
    }

    private async Task LoadLookupData()
    {
        try
        {
            var transactionResult = await TransactionService.GetAllAsync();
            transactions = transactionResult.ToList();

            var currencyResult = await CurrencyService.GetAllAsync();
            currencies = currencyResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadExpenses()
    {
        try
        {
            isLoading = true;
            var result = await ExpenseService.GetAllAsync();
            expenses = result.ToList();
            filteredExpenses = expenses;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری هزینه‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchExpenses()
    {
        var query = expenses.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(e =>
                e.Title.ToLower().Contains(term) ||
                e.CurrencyCode.ToLower().Contains(term) ||
                (e.Description != null && e.Description.ToLower().Contains(term))
            );
        }

        if (_filterCurrencyId > 0)
        {
            query = query.Where(e => e.CurrencyId == _filterCurrencyId);
        }

        filteredExpenses = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterCurrencyId = 0;
        filteredExpenses = expenses;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentExpense = new CreateExpenseDto
        {
            TransactionId = 0,
            CurrencyId = 0,
            Amount = 0,
            Title = "",
            ExpenseDate = DateTime.Now,
            Description = ""
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var expense = await ExpenseService.GetByIdAsync(id);
            if (expense != null)
            {
                currentExpense = new CreateExpenseDto
                {
                    TransactionId = expense.TransactionId,
                    CurrencyId = expense.CurrencyId,
                    Amount = expense.Amount,
                    Title = expense.Title,
                    ExpenseDate = expense.ExpenseDate,
                    Description = expense.Description
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری هزینه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveExpense()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentExpense.Title))
            validationErrors.Add("عنوان هزینه الزامی است");
        if (currentExpense.Amount <= 0)
            validationErrors.Add("مبلغ باید بزرگتر از صفر باشد");
        if (currentExpense.CurrencyId == 0)
            validationErrors.Add("انتخاب ارز الزامی است");
        if (currentExpense.TransactionId == 0)
            validationErrors.Add("انتخاب تراکنش الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                await ExpenseService.UpdateExpenseAsync(editId, currentExpense);
                successMessage = "هزینه با موفقیت ویرایش شد";
            }
            else
            {
                await ExpenseService.CreateExpenseAsync(currentExpense);
                successMessage = "هزینه با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadExpenses();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewExpense(long id)
    {
        try
        {
            isLoading = true;
            selectedExpense = await ExpenseService.GetByIdAsync(id);
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedExpense = null;
        StateHasChanged();
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await ExpenseService.DeleteExpenseAsync(deleteId);
            successMessage = "هزینه با موفقیت حذف شد";
            showDeleteModal = false;
            await LoadExpenses();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}