@page "/correspondents/{CorrespondentId:long}/hawala-import"
@page "/correspondents/{CorrespondentId:long}/hawala-import/preview/{PreviewBatchId:long}"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Application.Services
@using Microsoft.Data.SqlClient
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IHawalaImportService HawalaImportService
@inject IHawalaService HawalaService
@inject ICorrespondentService CorrespondentService
@inject HawalaExchange.Web.Services.UiReferenceDataCache ReferenceDataCache
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>@(IsPreviewPage ? "پیش‌نمایش و تأیید فایل حواله‌ها" : "آپلود گروهی حواله‌های دریافتی")</PageTitle>

<div class="page-wrapper @(IsPreviewPage ? "import-preview-workspace" : string.Empty)" dir="rtl">
    <AppPageHeader Title="@(IsPreviewPage ? "پیش‌نمایش و تأیید فایل" : "آپلود گروهی حواله‌های دریافتی")"
                   Subtitle="@(IsPreviewPage ? $"محیط مستقل بررسی فایل {preview?.FileName ?? string.Empty}" : "انتخاب فایل Excel و مشاهده تاریخچه آپلودها")"
                   Icon="@(IsPreviewPage ? "bi-layout-text-window-reverse" : "bi-file-earmark-spreadsheet")">
        <Actions>
            @if (IsPreviewPage)
            { <button class="btn btn-outline-secondary" disabled="@isBusy" @onclick="BackToImport"><i class="bi bi-arrow-right ms-1"></i>بازگشت به آپلودها</button> }
            else
            { <button class="btn btn-outline-secondary" disabled="@isBusy" title="@(isBusy ? "تا پایان عملیات ثبت منتظر بمانید." : null)" @onclick="BackToCorrespondent"><i class="bi bi-arrow-right ms-1"></i>بازگشت به نمایندگی</button> }
        </Actions>
    </AppPageHeader>

    @if (importError is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading mb-1">@importError.Title</h5>
                    <div>@importError.Message</div>
                    @if (!string.IsNullOrWhiteSpace(importError.LastStage))
                    { <div class="small mt-2"><strong>آخرین مرحله:</strong> @importError.LastStage</div> }
                    @if (importError.Actions.Count > 0)
                    {
                        <div class="mt-2"><strong>برای رفع مشکل:</strong></div>
                        <ol class="mb-0 mt-1">
                            @foreach (var action in importError.Actions)
                            { <li>@action</li> }
                        </ol>
                    }
                    @if (!string.IsNullOrWhiteSpace(importError.TechnicalMessage))
                    {
                        <details class="mt-2"><summary class="small">جزئیات فنی برای پشتیبانی</summary><code class="d-block mt-1 text-wrap" dir="ltr">@importError.TechnicalMessage</code></details>
                    }
                </div>
                <button type="button" class="btn-close" aria-label="بستن" @onclick="() => importError = null"></button>
            </div>
        </div>
    }
    @if (!IsPreviewPage && result is not null)
    {
        <div class="alert alert-success mt-3 mb-0">
            <h5 class="alert-heading">آپلود با موفقیت ثبت شد</h5>
            <div>@result.ImportedCount.ToString("N0") حواله دریافتی و @result.GeneratedSendCount.ToString("N0") حواله ارسالی ثبت گردید.</div>
            @if (result.MissingCommissionCount > 0)
            { <div class="mt-1">@result.MissingCommissionCount.ToString("N0") حواله ارسالی بدون کمیشن و در حالت انتظار قرار گرفت.</div> }
        </div>
        <div class="row g-3 mt-0">
            <div class="col-lg-4"><div class="card h-100 border-success"><div class="card-body">
                <small class="text-muted">تمام حواله‌های دریافتی</small><div class="fs-4 fw-bold">@result.ImportedCount.ToString("N0")</div>
                @foreach (var total in result.ReceivedTotals)
                { <div class="d-flex justify-content-between border-top pt-1 mt-1"><span>@total.CurrencyCode</span><strong dir="ltr">@total.Amount.ToString("N0")</strong></div> }
            </div></div></div>
            <div class="col-lg-4"><div class="card h-100 border-primary"><div class="card-body">
                <small class="text-muted">حواله‌های ارسالی خودکار</small><div class="fs-4 fw-bold">@result.GeneratedSendCount.ToString("N0")</div>
                @foreach (var total in result.SentTotals)
                { <div class="d-flex justify-content-between border-top pt-1 mt-1"><span>@total.CurrencyCode</span><strong dir="ltr">@total.Amount.ToString("N0")</strong></div> }
            </div></div></div>
            <div class="col-lg-4"><div class="card h-100 border-secondary"><div class="card-body">
                <small class="text-muted">اجراشده در دفتر خود ما</small><div class="fs-4 fw-bold">@result.OwnOfficeCount.ToString("N0")</div>
                @foreach (var total in result.OwnOfficeTotals)
                { <div class="d-flex justify-content-between border-top pt-1 mt-1"><span>@total.CurrencyCode</span><strong dir="ltr">@total.Amount.ToString("N0")</strong></div> }
            </div></div></div>
        </div>
        @if (result.DestinationSummaries.Count > 0)
        {
            <div class="card shadow-sm mt-3"><div class="card-header"><strong>تفکیک حواله‌های ارسالی بر اساس نمایندگی مسئول</strong></div>
                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>نمایندگی</th><th>تعداد حواله</th><th>مجموع به تفکیک ارز</th></tr></thead>
                    <tbody>@foreach (var summary in result.DestinationSummaries)
                    {
                        <tr><td><strong>@summary.CorrespondentName</strong></td><td>@summary.HawalaCount.ToString("N0")</td><td>
                            @foreach (var total in summary.Totals)
                            { <span class="badge text-bg-primary ms-2">@total.Amount.ToString("N0") @total.CurrencyCode (@total.RowCount.ToString("N0"))</span> }
                        </td></tr>
                    }</tbody>
                </table></div>
            </div>
        }
    }

    @if (!IsPreviewPage)
    {
    <div class="card shadow-sm mt-3"><div class="card-body"><div class="row g-3 align-items-end">
        <div class="col-lg-9">
            <label class="form-label">فایل Excel بدون عنوان ستون</label>
            <InputFile class="form-control" OnChange="PreviewFileAsync" accept=".xlsx" disabled="@(isBusy || preview is not null)" />
            <div class="form-text">ستون‌ها: شماره، رفرنس، فرستنده، گیرنده، محل پرداخت، مبلغ، ارز، کمیشن عامل پرداخت (اختیاری)، ارز کمیشن (اختیاری). اگر ارز کمیشن خالی باشد، ارز حواله استفاده می‌شود.</div>
        </div>
        <div class="col-lg-3">@if (preview is not null){<button class="btn btn-outline-secondary w-100" @onclick="Reset" disabled="@isBusy"><i class="bi bi-arrow-repeat ms-1"></i>انتخاب فایل دیگر</button>}</div>
    </div></div></div>
    }

    @if (isBusy)
    {
        <div class="card shadow-sm mt-3"><div class="card-body py-4">
            <div class="d-flex justify-content-between align-items-center mb-2"><strong>@progressMessage</strong><span dir="ltr">@progressPercent%</span></div>
            <div class="progress" style="height: 1.25rem;" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @($"{progressPercent}%")">@progressPercent%</div>
            </div>
        </div></div>
    }
    else if (IsPreviewPage && preview is not null)
    {
        <div class="preview-stage mt-3">
        <div class="preview-stage-banner">
            <div><span class="preview-step">مرحله نهایی</span><h4 class="mb-1 mt-2">بررسی، تعیین مسئول و ثبت فایل</h4><div class="text-muted">هیچ حواله‌ای تا زمان فشردن «تأیید و ثبت» وارد سیستم نمی‌شود.</div></div>
            <div class="text-start"><div class="fw-bold">@preview.FileName</div><small>@preview.CorrespondentName</small></div>
        </div>
        <div class="alert alert-info mt-3 mb-0">محل پرداخت خود صرافی را برای این فایل مشخص کنید. ردیف‌های آن فقط دریافتی ثبت می‌شوند؛ برای سایر محل‌ها حواله ارسالی جفت‌شده ساخته می‌شود.</div>
        <div class="card shadow-sm mt-3"><div class="card-body row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-bold" for="ownImportLocation">محل پرداخت خود صرافی</label>
                <select id="ownImportLocation" class="form-select" value="@selectedOwnLocationName" @onchange="ChangeOwnLocation">
                    <option value="">انتخاب کنید</option>
                    @if (!string.IsNullOrWhiteSpace(preview.OwnPaymentLocationName) &&
                        !preview.PaymentLocations.Any(x => x.PaymentLocationId == preview.OwnPaymentLocationId))
                    { <option value="@preview.OwnPaymentLocationName">@preview.OwnPaymentLocationName (محل ثبت‌شده دفتر)</option> }
                    @foreach (var location in preview.PaymentLocations)
                    { <option value="@location.Name">@location.Name</option> }
                </select>
                @if (!preview.OwnPaymentLocationId.HasValue)
                { <small class="text-muted">محل دفتر در تنظیمات شرکت ثبت نشده است؛ انتخاب این‌جا فقط برای همین فایل است.</small> }
                else if (!string.IsNullOrWhiteSpace(selectedOwnLocationName) &&
                    !IsOwnLocation(preview.OwnPaymentLocationName))
                { <small class="text-warning-emphasis">این انتخاب با محل دفتر در تنظیمات شرکت متفاوت است و فقط روی همین فایل اثر می‌گذارد.</small> }
            </div>
        </div></div>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><div class="card card-body"><small class="text-muted">تمام ردیف‌ها</small><strong class="fs-4">@preview.RowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body border-success"><small class="text-muted">معتبر</small><strong class="fs-4 text-success">@preview.ValidRowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body border-danger"><small class="text-muted">دارای خطا</small><strong class="fs-4 text-danger">@preview.InvalidRowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body"><small class="text-muted">حواله‌های ارسالی</small><strong class="fs-4">@preview.Rows.Count(IsOutgoing).ToString("N0")</strong></div></div>
        </div>

        @if (ValidationIssueGroups.Count > 0)
        {
            <div class="card shadow-sm mt-3 border-danger">
                <div class="card-header bg-danger-subtle text-danger-emphasis"><strong><i class="bi bi-exclamation-octagon ms-1"></i>خطاهای فایل و روش اصلاح</strong></div>
                <div class="card-body">
                    <p class="mb-3">موارد زیر را در فایل Excel اصلاح کنید، فایل را ذخیره نمایید و سپس «انتخاب فایل دیگر» را بزنید.</p>
                    <div class="list-group list-group-flush">
                        @foreach (var issue in ValidationIssueGroups)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex flex-wrap justify-content-between gap-2">
                                    <strong class="text-danger">@issue.Message</strong>
                                    <span class="badge text-bg-danger">@issue.RowNumbers.Count.ToString("N0") ردیف</span>
                                </div>
                                <div class="small mt-1"><strong>ردیف‌های Excel:</strong> @FormatRowNumbers(issue.RowNumbers)</div>
                                <div class="small text-muted mt-1"><strong>راه اصلاح:</strong> @GetValidationGuidance(issue.Message)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (preview.MissingLocations.Count > 0)
        {
            <div class="card shadow-sm mt-3 border-warning"><div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center"><strong>محل‌های پرداخت جدید</strong><button type="button" class="btn btn-sm btn-outline-dark" @onclick="ToggleAllLocations">@(AllLocationsSelected ? "لغو انتخاب همه" : "انتخاب همه")</button></div><div class="card-body">
                <p class="mb-1">ایجاد این محل‌های پرداخت را تأیید کنید:</p>
                <p class="small text-muted mb-2">اگر نامی فقط از نظر املا با محل موجود تفاوت دارد، آن را ایجاد نکنید؛ نام محل را در Excel دقیقاً مانند نام ثبت‌شده اصلاح و فایل را دوباره انتخاب کنید.</p><div class="row g-2">
                @foreach (var location in preview.MissingLocations)
                { <div class="col-md-4"><label class="form-check border rounded p-2 pe-5 w-100"><input class="form-check-input" type="checkbox" checked="@locationsToCreate.Contains(location)" @onchange="args => ToggleSet(locationsToCreate, location, args)" /><span class="form-check-label">@location</span></label></div> }
                </div>
            </div></div>
        }

        @if (preview.PaymentLocations.Any(x => !IsOwnLocation(x.Name)))
        {
            <div class="card shadow-sm mt-3 border-warning"><div class="card-header bg-warning-subtle"><strong>نمایندگی مسئول هر محل پرداخت</strong></div><div class="card-body">
                <p class="mb-2">برای هر محل، نمایندگی موجود را انتخاب کنید یا ایجاد نمایندگی جدید را صریحاً تأیید کنید. چند محل می‌توانند یک نمایندگی مسئول داشته باشند.</p><div class="row g-2">
                @foreach (var location in preview.PaymentLocations.Where(x => !IsOwnLocation(x.Name)))
                {
                    <div class="col-lg-6"><div class="border rounded p-2 h-100">
                        <label class="form-label fw-bold" for="@($"destination-{location.Name}")">@location.Name</label>
                        @if (!location.PaymentLocationId.HasValue){<span class="badge bg-warning text-dark me-2">محل جدید</span>}
                        @if (location.ResponsibleCorrespondentId.HasValue){<span class="badge bg-info text-dark me-2">مسئول ثبت‌شده</span>}
                        @if (location.ResponsibleCorrespondentId.HasValue)
                        { <div class="form-control bg-light">@location.ResponsibleCorrespondentName</div> }
                        else
                        {
                            <HawalaImportCorrespondentSelect Correspondents="@activeCorrespondents"
                                PlannedNames="@plannedNewCorrespondents.Values"
                                CreateName="@location.Name" Value="@DestinationChoice(location.Name)"
                                ValueChanged="choice => ChangeDestination(location.Name, choice)" />
                        }
                    </div></div>
                }
                </div>
            </div></div>
        }

        @if (preview.Rows.Any(x => x.RequiresOutgoingHawala))
        {
            <div class="card shadow-sm mt-3"><div class="card-header"><strong>اعمال کمیشن یکسان روی تمام حواله‌های ارسالی</strong></div><div class="card-body row g-2 align-items-end">
                <div class="col-md-4"><label class="form-label">مبلغ کمیشن</label><InputNumber class="form-control" @bind-Value="bulkCommissionAmount" /></div>
                <div class="col-md-4"><label class="form-label">ارز کمیشن</label><select class="form-select" @bind="bulkCommissionCurrencyId"><option value="0">ارز خود هر حواله</option>@foreach (var currency in currencies){<option value="@currency.Id">@currency.Code - @currency.Name</option>}</select></div>
                <div class="col-md-4"><button class="btn btn-outline-primary w-100" @onclick="ApplyBulkCommission" disabled="@(bulkCommissionAmount is not > 0)">اعمال به همه حواله‌های ارسالی</button></div>
            </div></div>
        }

        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center"><div><strong>پیش‌نمایش فایل</strong> — @preview.CorrespondentName</div><button class="btn btn-success" @onclick="ConfirmAsync" disabled="@(!CanConfirm)" title="@ConfirmDisabledReason"><i class="bi bi-check2-circle ms-1"></i>تأیید و ثبت</button></div>
            @if (!CanConfirm){<div class="alert alert-warning rounded-0 mb-0">@ConfirmDisabledReason</div>}
            <div class="table-responsive" style="max-height: 560px;"><table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light sticky-top"><tr><th>ردیف</th><th>شماره / رفرنس</th><th>فرستنده / گیرنده</th><th>محل پرداخت</th><th>مبلغ</th><th>نوع ثبت</th><th>کمیشن عامل پرداخت</th><th>ارز کمیشن</th><th>بررسی</th></tr></thead>
                <tbody><Virtualize Items="@preview.Rows" Context="row" ItemSize="58" SpacerElement="tr">
                    <tr class="@(row.IsValid ? string.Empty : "table-danger")">
                        <td>@row.ExcelRowNumber</td><td><strong>@row.HawalaNumber</strong><br/><small>@row.ReferenceNumber</small></td><td>@row.SenderName<br/><small>@row.ReceiverName</small></td>
                        <td>@row.PaymentLocationText @if (!row.PaymentLocationId.HasValue){<span class="badge bg-warning text-dark">جدید</span>}</td><td dir="ltr">@row.Amount?.ToString("N0") @row.CurrencyCode</td>
                        <td>@if (row.RequiresOutgoingHawala){<span class="badge bg-primary">دریافتی + ارسالی</span><div class="small mt-1">به @(row.DestinationCorrespondentName ?? row.PaymentLocationText)</div>}else{<span class="badge bg-secondary">فقط دریافتی</span>}</td>
                        <td>@if (row.RequiresOutgoingHawala){<InputNumber class="form-control form-control-sm" @bind-Value="row.AgentCommissionAmount" placeholder="اختیاری"/>}else{<span>—</span>}</td>
                        <td>@if (row.RequiresOutgoingHawala){<select class="form-select form-select-sm" @bind="row.AgentCommissionCurrencyId"><option value="">انتخاب ارز</option>@foreach (var currency in currencies){<option value="@currency.Id">@currency.Code</option>}</select>}else{<span>—</span>}</td>
                        <td>@if (row.IsValid){<span class="text-success"><i class="bi bi-check-circle"></i> معتبر</span>}else{<span class="text-danger">@row.ValidationErrors</span>}</td>
                    </tr>
                </Virtualize></tbody>
            </table></div>
        </div>
        </div>
    }

    @if (!IsPreviewPage)
    {
    <div class="card shadow-sm mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-clock-history ms-1"></i>تاریخچه تمام فایل‌های آپلودشده</strong>
            <button class="btn btn-sm btn-outline-secondary" disabled="@isHistoryBusy" @onclick="LoadHistoryAsync">
                <i class="bi bi-arrow-clockwise ms-1"></i>تازه‌سازی
            </button>
        </div>
        @if (isHistoryBusy && importHistory.Count == 0)
        { <div class="card-body text-muted">در حال بارگذاری تاریخچه...</div> }
        else if (importHistory.Count == 0)
        { <div class="card-body text-muted">هنوز فایلی آپلود نشده است.</div> }
        else
        {
            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>فایل</th><th>نمایندگی فرستنده</th><th>تعداد ردیف</th><th>وضعیت</th><th>کاربر</th><th>زمان</th><th></th></tr></thead>
                <tbody>@foreach (var item in importHistory)
                {
                    <tr class="@(selectedHistory?.BatchId == item.BatchId ? "table-primary" : string.Empty)">
                        <td><strong>@item.FileName</strong></td><td>@item.SourceCorrespondentName</td>
                        <td>@item.RowCount.ToString("N0")</td><td><span class="badge @HistoryStatusClass(item.Status)">@HistoryStatusText(item.Status)</span></td>
                        <td>@item.UploadedBy</td><td><AppDateTime Value="@(item.ConfirmedAt ?? item.CreatedAt)" /></td>
                        <td><div class="btn-group btn-group-sm" role="group" aria-label="عملیات فایل آپلود">
                            <button class="btn btn-outline-primary" disabled="@isHistoryBusy" @onclick="() => OpenHistoryDetailsAsync(item.BatchId)">جزئیات</button>
                            <button class="btn btn-outline-danger" title="حذف فایل و تمام حواله‌های آن" disabled="@isHistoryBusy" @onclick="() => AskDeleteBatch(item)"><i class="bi bi-trash"></i></button>
                        </div></td>
                    </tr>
                }</tbody>
            </table></div>
        }
    </div>

    @if (selectedHistory is not null)
    {
        <div class="card shadow-sm mt-3 border-primary">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div><strong>جزئیات آپلود: @selectedHistory.FileName</strong><div class="small text-muted">@selectedHistory.SourceCorrespondentName · @selectedHistory.RowCount.ToString("N0") ردیف</div></div>
                <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseHistoryDetails"></button>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><div class="border rounded p-2"><small class="text-muted">حواله دریافتی ثبت‌شده</small><div class="fs-5 fw-bold">@selectedHistory.ImportedCount.ToString("N0")</div>@foreach(var total in selectedHistory.ReceivedTotals){<span class="badge text-bg-success ms-1">@total.Amount.ToString("N0") @total.CurrencyCode</span>}</div></div>
                    <div class="col-md-4"><div class="border rounded p-2"><small class="text-muted">حواله ارسالی خودکار</small><div class="fs-5 fw-bold">@selectedHistory.GeneratedSendCount.ToString("N0")</div>@foreach(var total in selectedHistory.SentTotals){<span class="badge text-bg-primary ms-1">@total.Amount.ToString("N0") @total.CurrencyCode</span>}</div></div>
                    <div class="col-md-4"><div class="border rounded p-2"><small class="text-muted">اجرا در دفتر خود ما</small><div class="fs-5 fw-bold">@selectedHistory.OwnOfficeCount.ToString("N0")</div>@foreach(var total in selectedHistory.Groups.FirstOrDefault(x => x.IsOwnOffice)?.Totals ?? []){<span class="badge text-bg-secondary ms-1">@total.Amount.ToString("N0") @total.CurrencyCode</span>}</div></div>
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>نمایندگی/محل اجرا</th><th>تعداد حواله</th><th>مجموع به تفکیک ارز</th><th></th></tr></thead>
                    <tbody>@foreach (var group in selectedHistory.Groups)
                    {
                        <tr class="@(selectedHistoryGroup == group ? "table-info" : string.Empty)">
                            <td><strong>@group.CorrespondentName</strong>@if(group.IsOwnOffice){<span class="badge text-bg-secondary me-2">دفتر</span>}</td>
                            <td>@group.HawalaCount.ToString("N0")</td><td>@foreach(var total in group.Totals){<span class="badge @(group.IsOwnOffice ? "text-bg-secondary" : "text-bg-primary") ms-1">@total.Amount.ToString("N0") @total.CurrencyCode</span>}</td>
                            <td><button class="btn btn-sm btn-outline-info" @onclick="() => selectedHistoryGroup = group">جزئیات حواله‌ها</button></td>
                        </tr>
                    }</tbody>
                </table></div>
            </div>
        </div>
    }

    @if (selectedHistoryGroup is not null)
    {
        <div class="modal d-block history-hawala-modal" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-info-subtle">
                    <div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-building fs-4 text-info-emphasis"></i><h5 class="modal-title mb-0">@selectedHistoryGroup.CorrespondentName</h5>
                            <span class="badge @(selectedHistoryGroup.IsOwnOffice ? "text-bg-secondary" : "text-bg-primary")">@(selectedHistoryGroup.IsOwnOffice ? "دفتر خود ما" : "نمایندگی مسئول")</span></div>
                        <div class="small text-muted mt-1">حواله‌های مربوط به همین نمایندگی از فایل «@selectedHistory?.FileName»</div>
                    </div>
                    <button type="button" class="btn-close" aria-label="بستن" @onclick="() => selectedHistoryGroup = null"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-3 border-bottom bg-light">
                        <div class="row g-3">
                            <div class="col-md-3"><div class="history-summary-box"><small>تعداد حواله‌ها</small><strong>@selectedHistoryGroup.HawalaCount.ToString("N0")</strong></div></div>
                            @foreach (var total in selectedHistoryGroup.Totals)
                            { <div class="col-md-3"><div class="history-summary-box"><small>مجموع @total.CurrencyCode</small><strong dir="ltr">@total.Amount.ToString("N0")</strong><span>@total.RowCount.ToString("N0") حواله</span></div></div> }
                        </div>
                        <div class="alert alert-info py-2 mt-3 mb-0">
                            @if (selectedHistoryGroup.IsOwnOffice)
                            { <span>این حواله‌ها در دفتر خود ما اجرا شده‌اند و حواله ارسالی خودکار ندارند.</span> }
                            else
                            { <span>برای این ردیف‌ها حواله دریافتی ثبت شده و حواله ارسالی خودکار به نمایندگی <strong>@selectedHistoryGroup.CorrespondentName</strong> ساخته شده است.</span> }
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 58vh;"><table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top"><tr><th>ردیف</th><th>شماره و رفرنس</th><th>فرستنده و گیرنده</th><th>محل پرداخت</th><th>مبلغ</th><th>نوع ثبت</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                        <tbody>@foreach (var hawala in selectedHistoryGroup.Hawalas)
                        {
                            <tr><td><span class="badge text-bg-light border">@hawala.ExcelRowNumber</span></td>
                                <td><strong>@hawala.HawalaNumber</strong><br/><small class="text-muted">@hawala.ReferenceNumber</small></td>
                                <td><div><i class="bi bi-person-up ms-1 text-muted"></i>@hawala.SenderName</div><small><i class="bi bi-person-down ms-1 text-muted"></i>@hawala.ReceiverName</small></td>
                                <td>@hawala.PaymentLocationName</td><td><strong dir="ltr">@hawala.Amount.ToString("N0") @hawala.CurrencyCode</strong></td>
                                <td>@if(hawala.GeneratedSendHawalaId.HasValue){<span class="badge text-bg-primary">دریافتی + ارسالی</span>}else{<span class="badge text-bg-secondary">فقط دریافتی</span>}</td>
                                <td><span class="badge text-bg-light border text-dark">@AppDisplayText.Status(hawala.Status, "HawalaReceive")</span></td>
                                <td>
                                    @if (hawala.HawalaId.HasValue)
                                    {
                                        <div class="btn-group btn-group-sm" role="group" aria-label="عملیات حواله">
                                            <button class="btn btn-outline-warning" title="ویرایش" @onclick="() => EditImportedHawala(hawala.HawalaId.Value)"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger" title="حذف" disabled="@isHistoryBusy" @onclick="() => AskDeleteImportedHawala(hawala)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">حذف شده</span>
                                    }
                                </td></tr>
                        }</tbody>
                    </table></div>
                </div>
                <div class="modal-footer"><button class="btn btn-secondary" @onclick="() => selectedHistoryGroup = null">بستن</button></div>
            </div></div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (deleteImportRow is not null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">تأیید حذف حواله</h5><button type="button" class="btn-close" @onclick="CancelDeleteImportedHawala"></button></div>
                <div class="modal-body">حواله شماره <strong>@deleteImportRow.HawalaNumber</strong> و حواله ارسالی خودکار و ثبت‌های حسابداری وابسته حذف شوند؟</div>
                <div class="modal-footer"><button class="btn btn-secondary" disabled="@isHistoryBusy" @onclick="CancelDeleteImportedHawala">انصراف</button><button class="btn btn-danger" disabled="@isHistoryBusy" @onclick="DeleteImportedHawalaAsync">حذف</button></div>
            </div></div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (deleteBatch is not null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-danger">
                <div class="modal-header"><h5 class="modal-title text-danger">حذف کامل آپلود گروهی</h5><button type="button" class="btn-close" @onclick="CancelDeleteBatch"></button></div>
                <div class="modal-body">
                    <p>فایل <strong>@deleteBatch.FileName</strong> از تاریخچه حذف شود؟</p>
                    <div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle ms-1"></i>تمام <strong>@deleteBatch.RowCount.ToString("N0")</strong> ردیف و همه حواله‌های دریافتی و ارسالی و ثبت‌های حسابداری وابسته نیز حذف می‌شوند. این عملیات قابل بازگشت نیست.</div>
                </div>
                <div class="modal-footer"><button class="btn btn-secondary" disabled="@isHistoryBusy" @onclick="CancelDeleteBatch">انصراف</button><button class="btn btn-danger" disabled="@isHistoryBusy" @onclick="DeleteBatchAsync">حذف کامل فایل و حواله‌ها</button></div>
            </div></div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
    }
</div>

@code {
    [Parameter] public long CorrespondentId { get; set; }
    [Parameter] public long? PreviewBatchId { get; set; }
    private const long MaximumFileSize = 10 * 1024 * 1024;
    private List<CurrencyDto> currencies = [];
    private List<CorrespondentDto> activeCorrespondents = [];
    private HawalaImportPreviewDto? preview;
    private HawalaImportResultDto? result;
    private List<HawalaImportHistoryDto> importHistory = [];
    private HawalaImportDetailsDto? selectedHistory;
    private HawalaImportGroupDetailsDto? selectedHistoryGroup;
    private bool isHistoryBusy;
    private HawalaImportHawalaDetailsDto? deleteImportRow;
    private HawalaImportHistoryDto? deleteBatch;
    private readonly HashSet<string> locationsToCreate = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> destinationChoices = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> plannedNewCorrespondents = new(StringComparer.Ordinal);
    private string selectedOwnLocationName = string.Empty;
    private decimal? bulkCommissionAmount;
    private long bulkCommissionCurrencyId;
    private ImportErrorViewModel? importError;
    private bool isBusy;
    private int progressPercent;
    private string progressMessage = "در حال آماده‌سازی...";
    private bool IsPreviewPage => PreviewBatchId.HasValue;

    private bool CanConfirm => preview is not null && preview.InvalidRowCount == 0 &&
        !string.IsNullOrWhiteSpace(selectedOwnLocationName) &&
        preview.MissingLocations.All(locationsToCreate.Contains) &&
        preview.PaymentLocations.Where(x => !IsOwnLocation(x.Name)).All(x => !string.IsNullOrWhiteSpace(DestinationChoice(x.Name))) &&
        preview.Rows.Where(x => IsOutgoing(x) && x.AgentCommissionAmount is > 0)
            .All(x => x.AgentCommissionCurrencyId is > 0) && !isBusy;
    private string? ConfirmDisabledReason => preview is null
        ? "ابتدا فایل را انتخاب و بررسی کنید."
        : isBusy
            ? progressMessage
            : preview.InvalidRowCount > 0
                ? $"فایل دارای {preview.InvalidRowCount:N0} ردیف نامعتبر است؛ خطاهای جدول را اصلاح کنید."
                : string.IsNullOrWhiteSpace(selectedOwnLocationName)
                    ? "محل پرداخت خود صرافی را برای این فایل انتخاب کنید."
                : preview.MissingLocations.Any(x => !locationsToCreate.Contains(x))
                    ? "ایجاد تمام محل‌های پرداخت جدید را تأیید کنید."
                    : preview.PaymentLocations.Any(x => !IsOwnLocation(x.Name) && string.IsNullOrWhiteSpace(DestinationChoice(x.Name)))
                        ? "برای هر محل پرداخت غیر از دفتر خود صرافی، نمایندگی مسئول را انتخاب کنید."
                        : preview.Rows.Any(x => IsOutgoing(x) && x.AgentCommissionAmount is > 0 && x.AgentCommissionCurrencyId is not > 0)
                            ? "برای تمام کمیشن‌های واردشده، ارز کمیشن را انتخاب کنید."
                            : null;
    private bool AllLocationsSelected => preview is not null && preview.MissingLocations.All(locationsToCreate.Contains);
    private List<ValidationIssueViewModel> ValidationIssueGroups => preview?.Rows
        .Where(x => !x.IsValid)
        .SelectMany(row => SplitValidationErrors(row.ValidationErrors)
            .Select(message => new { row.ExcelRowNumber, Message = message }))
        .GroupBy(x => x.Message, StringComparer.Ordinal)
        .Select(group => new ValidationIssueViewModel(group.Key,
            group.Select(x => x.ExcelRowNumber).Distinct().OrderBy(x => x).ToList()))
        .OrderBy(x => x.RowNumbers[0])
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currencies = (await ReferenceDataCache.GetActiveCurrenciesAsync())
                .OrderBy(x => x.QuotationPriority).ThenBy(x => x.Code).ToList();
            activeCorrespondents = (await CorrespondentService.GetActiveAsync()).OrderBy(x => x.Name).ToList();
            if (!IsPreviewPage)
                await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, "بارگذاری ارزها، نمایندگی‌ها یا تاریخچه آپلود", false);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!PreviewBatchId.HasValue || preview?.BatchId == PreviewBatchId.Value)
            return;
        isBusy = true;
        progressMessage = "در حال بارگذاری پیش‌نمایش فایل...";
        try
        {
            preview = await HawalaImportService.GetPreviewAsync(PreviewBatchId.Value)
                ?? throw new InvalidOperationException("این پیش‌نمایش پیدا نشد یا قبلاً ثبت شده است.");
            InitializePreviewState();
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, progressMessage, false);
        }
        finally { isBusy = false; }
    }

    private async Task LoadHistoryAsync()
    {
        isHistoryBusy = true;
        try
        {
            importHistory = (await HawalaImportService.GetHistoryAsync()).ToList();
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, "بارگذاری تاریخچه آپلود گروهی", false);
        }
        finally { isHistoryBusy = false; }
    }

    private async Task OpenHistoryDetailsAsync(long batchId)
    {
        isHistoryBusy = true;
        selectedHistoryGroup = null;
        try
        {
            selectedHistory = await HawalaImportService.GetDetailsAsync(batchId);
            if (selectedHistory is null)
                throw new InvalidOperationException("جزئیات این فایل آپلودشده پیدا نشد.");
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, "بارگذاری جزئیات فایل آپلودشده", false);
        }
        finally { isHistoryBusy = false; }
    }

    private void CloseHistoryDetails()
    {
        selectedHistory = null;
        selectedHistoryGroup = null;
    }

    private void EditImportedHawala(long hawalaId) =>
        NavigationManager.NavigateTo($"/hawala-transactions?editId={hawalaId}");

    private void AskDeleteImportedHawala(HawalaImportHawalaDetailsDto hawala) => deleteImportRow = hawala;

    private void CancelDeleteImportedHawala() => deleteImportRow = null;

    private async Task DeleteImportedHawalaAsync()
    {
        if (deleteImportRow?.HawalaId is not long hawalaId || isHistoryBusy) return;
        isHistoryBusy = true;
        try
        {
            await HawalaService.DeleteHawalaAsync(hawalaId);
            deleteImportRow = null;
            selectedHistoryGroup = null;
            if (selectedHistory is not null)
                selectedHistory = await HawalaImportService.GetDetailsAsync(selectedHistory.BatchId);
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, "حذف حواله ثبت‌شده در آپلود گروهی", false);
        }
        finally
        {
            isHistoryBusy = false;
        }
    }

    private void AskDeleteBatch(HawalaImportHistoryDto batch) => deleteBatch = batch;

    private void CancelDeleteBatch() => deleteBatch = null;

    private async Task DeleteBatchAsync()
    {
        if (deleteBatch is null || isHistoryBusy) return;
        var batchId = deleteBatch.BatchId;
        isHistoryBusy = true;
        importError = null;
        try
        {
            await HawalaImportService.DeleteBatchAsync(batchId);
            deleteBatch = null;
            if (selectedHistory?.BatchId == batchId)
            {
                selectedHistory = null;
                selectedHistoryGroup = null;
            }
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            importError = BuildImportError(ex, "حذف کامل فایل آپلود گروهی", false);
        }
        finally
        {
            isHistoryBusy = false;
        }
    }

    private static string HistoryStatusText(string status) => status switch
    {
        "Posted" => "ثبت‌شده",
        "Preview" => "پیش‌نمایش",
        _ => AppDisplayText.Status(status)
    };

    private static string HistoryStatusClass(string status) => status switch
    {
        "Posted" => "text-bg-success",
        "Preview" => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private async Task PreviewFileAsync(InputFileChangeEventArgs args)
    {
        importError = null; result = null; isBusy = true; progressPercent = 1; progressMessage = "در حال آپلود فایل...";
        try
        {
            await using var stream = args.File.OpenReadStream(MaximumFileSize);
            preview = await HawalaImportService.PreviewAsync(stream, args.File.Name, CorrespondentId, CreateProgressReporter());
            InitializePreviewState();
            NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}/hawala-import/preview/{preview.BatchId}");
        }
        catch (Exception ex) { importError = BuildImportError(ex, progressMessage, false); preview = null; }
        finally { isBusy = false; }
    }

    private void InitializePreviewState()
    {
        if (preview is null) return;
        locationsToCreate.Clear();
        destinationChoices.Clear();
        plannedNewCorrespondents.Clear();
        selectedOwnLocationName = preview.PaymentLocations.FirstOrDefault(x =>
            x.PaymentLocationId == preview.OwnPaymentLocationId)?.Name
            ?? preview.OwnPaymentLocationName;
        foreach (var location in preview.PaymentLocations)
            destinationChoices[location.Name] = location.ResponsibleCorrespondentId.HasValue
                ? ExistingChoice(location.ResponsibleCorrespondentId.Value)
                : string.Empty;
        RefreshPreviewClassification();
    }

    private static void ToggleSet(HashSet<string> set, string value, ChangeEventArgs args)
    { if (args.Value is bool selected && selected) set.Add(value); else set.Remove(value); }

    private void ToggleAllLocations()
    {
        if (preview is null) return;
        if (AllLocationsSelected) locationsToCreate.Clear();
        else foreach (var value in preview.MissingLocations) locationsToCreate.Add(value);
    }

    private bool IsOwnLocation(string? name) =>
        !string.IsNullOrWhiteSpace(selectedOwnLocationName) &&
        PaymentLocationNameNormalizer.Normalize(name) ==
        PaymentLocationNameNormalizer.Normalize(selectedOwnLocationName);

    private bool IsOutgoing(HawalaImportRowDto row) => !IsOwnLocation(row.PaymentLocationName ?? row.PaymentLocationText);

    private string DestinationChoice(string name) => destinationChoices.GetValueOrDefault(name, string.Empty);
    private static string ExistingChoice(long id) => $"existing:{id}";

    private static long? TryGetExistingCorrespondentId(string choice) =>
        choice.StartsWith("existing:", StringComparison.Ordinal) &&
        long.TryParse(choice[9..], out var id) ? id : null;

    private string? GetNewCorrespondentName(string choice)
    {
        if (!choice.StartsWith("new:", StringComparison.Ordinal)) return null;
        return plannedNewCorrespondents.GetValueOrDefault(choice[4..]);
    }

    private void ChangeOwnLocation(ChangeEventArgs args)
    {
        selectedOwnLocationName = args.Value?.ToString() ?? string.Empty;
        RefreshPreviewClassification();
    }

    private void ChangeDestination(string name, string choice)
    {
        if (choice.StartsWith("new:", StringComparison.Ordinal))
        {
            var key = choice[4..];
            if (!plannedNewCorrespondents.ContainsKey(key))
                plannedNewCorrespondents[key] = name;
        }
        destinationChoices[name] = choice;
        RefreshPreviewClassification();
    }

    private void RefreshPreviewClassification()
    {
        if (preview is null) return;
        foreach (var row in preview.Rows)
        {
            row.RequiresOutgoingHawala = IsOutgoing(row);
            var key = row.PaymentLocationName ?? row.PaymentLocationText ?? string.Empty;
            var selected = DestinationChoice(key);
            var existingId = TryGetExistingCorrespondentId(selected);
            row.DestinationCorrespondentName = row.RequiresOutgoingHawala
                ? GetNewCorrespondentName(selected) is string newName ? $"نمایندگی جدید: {newName}"
                    : activeCorrespondents.FirstOrDefault(x => x.Id == existingId)?.Name
                : null;
        }
    }

    private void ApplyBulkCommission()
    {
        if (preview is null || bulkCommissionAmount is not > 0) return;
        foreach (var row in preview.Rows.Where(IsOutgoing)) { row.AgentCommissionAmount = bulkCommissionAmount; row.AgentCommissionCurrencyId = bulkCommissionCurrencyId > 0 ? bulkCommissionCurrencyId : row.CurrencyId; }
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm || preview is null) return;
        importError = null; isBusy = true; progressPercent = 1; progressMessage = "در حال آغاز ثبت گروهی...";
        try
        {
            result = await HawalaImportService.ConfirmAsync(new ConfirmHawalaImportDto
            {
                BatchId = preview.BatchId,
                OwnPaymentLocationName = selectedOwnLocationName,
                LocationsToCreate = locationsToCreate.ToList(),
                LocationMappings = preview.PaymentLocations.Where(x => !IsOwnLocation(x.Name))
                    .Select(x => new HawalaImportLocationMappingDto
                    {
                        PaymentLocationName = x.Name,
                        CorrespondentId = TryGetExistingCorrespondentId(DestinationChoice(x.Name)),
                        CreateCorrespondent = GetNewCorrespondentName(DestinationChoice(x.Name)) is not null,
                        NewCorrespondentName = GetNewCorrespondentName(DestinationChoice(x.Name))
                    }).ToList(),
                Commissions = preview.Rows.Where(IsOutgoing).Select(x => new HawalaImportCommissionDto
                { RowId = x.Id, Amount = x.AgentCommissionAmount, CurrencyId = x.AgentCommissionCurrencyId }).ToList()
            }, CreateProgressReporter());
            await LoadHistoryAsync();
            preview = null; locationsToCreate.Clear(); destinationChoices.Clear();
            plannedNewCorrespondents.Clear(); selectedOwnLocationName = string.Empty;
            NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}/hawala-import");
        }
        catch (Exception ex) { importError = BuildImportError(ex, progressMessage, true); }
        finally { isBusy = false; }
    }

    private IProgress<HawalaImportProgressDto> CreateProgressReporter() => new Progress<HawalaImportProgressDto>(update =>
    {
        progressPercent = update.Percent;
        progressMessage = update.Message;
        _ = InvokeAsync(StateHasChanged);
    });

    private void Reset() { preview = null; result = null; importError = null; locationsToCreate.Clear(); destinationChoices.Clear(); plannedNewCorrespondents.Clear(); selectedOwnLocationName = string.Empty; bulkCommissionAmount = null; bulkCommissionCurrencyId = 0; progressPercent = 0; progressMessage = "در حال آماده‌سازی..."; }
    private void BackToImport() { Reset(); NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}/hawala-import"); }
    private void BackToCorrespondent() => NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}");

    private static IEnumerable<string> SplitValidationErrors(string? errors) =>
        (errors ?? string.Empty).Split(" | ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string FormatRowNumbers(IReadOnlyCollection<int> rows)
    {
        const int visibleCount = 20;
        var text = string.Join("، ", rows.Take(visibleCount));
        return rows.Count > visibleCount ? $"{text} و {rows.Count - visibleCount:N0} ردیف دیگر" : text;
    }

    private static string GetValidationGuidance(string message)
    {
        if (message.Contains("همین فایل تکراری", StringComparison.Ordinal))
            return "یکی از ردیف‌های تکراری را حذف کنید یا شماره/رفرنس درست را در ستون اول یا دوم وارد کنید.";
        if (message.Contains("قبلاً برای این نمایندگی", StringComparison.Ordinal))
            return "سوابق نمایندگی را بررسی کنید. اگر همان حواله است آن را دوباره وارد نکنید؛ در غیر آن شماره یا رفرنس صحیح را در Excel اصلاح کنید.";
        if (message.Contains("شماره حواله", StringComparison.Ordinal))
            return "ستون اول باید یک شماره صحیح، بدون حروف و برای هر حواله دارای مقدار باشد.";
        if (message.Contains("رفرنس", StringComparison.Ordinal))
            return "رفرنس را در ستون دوم بررسی کنید و مقدار تکراری یا اشتباه را اصلاح نمایید.";
        if (message.Contains("فرستنده", StringComparison.Ordinal))
            return "نام فرستنده را در ستون سوم وارد کنید.";
        if (message.Contains("گیرنده", StringComparison.Ordinal))
            return "نام گیرنده را در ستون چهارم وارد کنید.";
        if (message.Contains("محل پرداخت", StringComparison.Ordinal))
            return "نام محل پرداخت را در ستون پنجم وارد کنید؛ املای آن را با محل‌های موجود یکسان نگه دارید.";
        if (message.Contains("کمیشن", StringComparison.Ordinal) && message.Contains("ارز", StringComparison.Ordinal))
            return "کد ارز کمیشن را در ستون نهم مانند USD یا AFN وارد کنید؛ اگر خالی باشد ارز خود حواله استفاده می‌شود.";
        if (message.Contains("کمیشن", StringComparison.Ordinal))
            return "مبلغ کمیشن ستون هشتم باید عددی و بزرگ‌تر از صفر باشد، یا برای نداشتن کمیشن خالی بماند.";
        if (message.Contains("ارز", StringComparison.Ordinal))
            return "کد ارز ستون هفتم را مانند USD، AFN یا AED وارد کنید و مطمئن شوید ارز در سیستم فعال است.";
        if (message.Contains("مبلغ", StringComparison.Ordinal))
            return "مبلغ ستون ششم باید عددی و بزرگ‌تر از صفر باشد.";
        return "مقادیر این ردیف را با ساختار ستون‌های راهنما مقایسه و اصلاح کنید.";
    }

    private ImportErrorViewModel BuildImportError(Exception exception, string lastStage, bool duringConfirm)
    {
        var root = exception.GetBaseException();
        var actions = new List<string>();
        string title;
        string message;

        if (root is SqlException { Number: -2 })
        {
            title = "پایگاه‌داده در زمان تعیین‌شده پاسخ نداد";
            message = duringConfirm
                ? "ثبت نهایی کامل نشد و تراکنش برگشت داده شد؛ روی دکمه ثبت چند بار کلیک نکنید."
                : "بررسی فایل در زمان تعیین‌شده کامل نشد.";
            actions.Add("چند لحظه صبر کنید و فقط یک‌بار دوباره تلاش کنید.");
            actions.Add("اگر خطا تکرار شد، آخرین مرحله و جزئیات فنی زیر را برای پشتیبانی بفرستید.");
        }
        else if (root is TaskCanceledException or OperationCanceledException)
        {
            title = "ارتباط صفحه هنگام انجام عملیات قطع شد";
            message = duringConfirm
                ? "نتیجه ثبت به صفحه برنگشت. ابتدا فهرست حواله‌ها را بررسی کنید و بدون بررسی دوباره ثبت نکنید."
                : "ارتباط صفحه پیش از تکمیل پیش‌نمایش قطع شد.";
            actions.Add("اتصال شبکه و بازبودن برنامه را بررسی کنید و صفحه را تازه‌سازی نمایید.");
            actions.Add(duringConfirm
                ? "در نمایندگی کویته، شماره‌های فایل را جستجو کنید؛ اگر ثبت نشده بود دوباره آپلود کنید."
                : "فایل را دوباره انتخاب کنید.");
        }
        else if (root is IOException or InvalidDataException)
        {
            title = "فایل Excel قابل خواندن نیست";
            message = "فایل باز، ناقص یا دارای قالب نامعتبر است.";
            actions.Add("فایل را در Excel باز کنید و با فرمت .xlsx ذخیره نمایید.");
            actions.Add("فایل را در Excel ببندید و دوباره انتخاب کنید.");
        }
        else if (root is InvalidOperationException)
        {
            title = duringConfirm ? "ثبت گروهی انجام نشد" : "فایل نیاز به اصلاح دارد";
            message = root.Message;
            actions.Add(duringConfirm
                ? "پیام بالا را اصلاح کنید؛ پیش‌نمایش فعلی حفظ شده و می‌توانید دوباره تأیید کنید."
                : "مقادیر فایل و تنظیمات نمایندگی را مطابق پیام بالا اصلاح و فایل را دوباره انتخاب کنید.");
        }
        else
        {
            title = duringConfirm ? "خطای غیرمنتظره در ثبت گروهی" : "خطای غیرمنتظره در بررسی فایل";
            message = "عملیات کامل نشد. اطلاعات واردشده را تغییر ندهید و جزئیات زیر را برای پشتیبانی بفرستید.";
            actions.Add("از پیام و آخرین مرحله تصویر بگیرید.");
            actions.Add("یک‌بار صفحه را تازه‌سازی و دوباره تلاش کنید.");
        }

        return new ImportErrorViewModel(title, message, lastStage, actions,
            $"{root.GetType().Name}: {root.Message}");
    }

    private sealed record ValidationIssueViewModel(string Message, List<int> RowNumbers);
    private sealed record ImportErrorViewModel(
        string Title,
        string Message,
        string LastStage,
        List<string> Actions,
        string TechnicalMessage);
}
