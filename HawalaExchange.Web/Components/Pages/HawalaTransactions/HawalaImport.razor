@page "/correspondents/{CorrespondentId:long}/hawala-import"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.Data.SqlClient
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject IHawalaImportService HawalaImportService
@inject HawalaExchange.Web.Services.UiReferenceDataCache ReferenceDataCache
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>آپلود گروهی حواله‌های دریافتی</PageTitle>

<div class="page-wrapper" dir="rtl">
    <AppPageHeader Title="آپلود گروهی حواله‌های دریافتی" Subtitle="بررسی فایل Excel و ساخت حواله ارسالی برای محل‌های پرداخت بیرون از دفتر صرافی" Icon="bi-file-earmark-spreadsheet">
        <Actions>
            <button class="btn btn-outline-secondary" disabled="@isBusy" title="@(isBusy ? "تا پایان عملیات ثبت منتظر بمانید." : null)" @onclick="BackToCorrespondent">
                <i class="bi bi-arrow-right ms-1"></i>بازگشت به نمایندگی
            </button>
        </Actions>
    </AppPageHeader>

    @if (importError is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading mb-1">@importError.Title</h5>
                    <div>@importError.Message</div>
                    @if (!string.IsNullOrWhiteSpace(importError.LastStage))
                    { <div class="small mt-2"><strong>آخرین مرحله:</strong> @importError.LastStage</div> }
                    @if (importError.Actions.Count > 0)
                    {
                        <div class="mt-2"><strong>برای رفع مشکل:</strong></div>
                        <ol class="mb-0 mt-1">
                            @foreach (var action in importError.Actions)
                            { <li>@action</li> }
                        </ol>
                    }
                    @if (!string.IsNullOrWhiteSpace(importError.TechnicalMessage))
                    {
                        <details class="mt-2"><summary class="small">جزئیات فنی برای پشتیبانی</summary><code class="d-block mt-1 text-wrap" dir="ltr">@importError.TechnicalMessage</code></details>
                    }
                </div>
                <button type="button" class="btn-close" aria-label="بستن" @onclick="() => importError = null"></button>
            </div>
        </div>
    }
    @if (result is not null)
    {
        <div class="alert alert-success mt-3">
            <h5 class="alert-heading">آپلود با موفقیت ثبت شد</h5>
            <div>@result.ImportedCount.ToString("N0") حواله دریافتی و @result.GeneratedSendCount.ToString("N0") حواله ارسالی ثبت گردید.</div>
            @if (result.MissingCommissionCount > 0)
            { <div class="mt-1">@result.MissingCommissionCount.ToString("N0") حواله ارسالی بدون کمیشن و در حالت انتظار قرار گرفت.</div> }
            @foreach (var total in result.Totals)
            { <span class="badge bg-success ms-2 mt-2">@total.Amount.ToString("N0") @total.CurrencyCode (@total.RowCount.ToString("N0") ردیف)</span> }
        </div>
    }

    <div class="card shadow-sm mt-3"><div class="card-body"><div class="row g-3 align-items-end">
        <div class="col-lg-9">
            <label class="form-label">فایل Excel بدون عنوان ستون</label>
            <InputFile class="form-control" OnChange="PreviewFileAsync" accept=".xlsx" disabled="@(isBusy || preview is not null)" />
            <div class="form-text">ستون‌ها: شماره، رفرنس، فرستنده، گیرنده، محل پرداخت، مبلغ، ارز، کمیشن عامل پرداخت (اختیاری)، ارز کمیشن (اختیاری). اگر ارز کمیشن خالی باشد، ارز حواله استفاده می‌شود.</div>
        </div>
        <div class="col-lg-3">@if (preview is not null){<button class="btn btn-outline-secondary w-100" @onclick="Reset" disabled="@isBusy"><i class="bi bi-arrow-repeat ms-1"></i>انتخاب فایل دیگر</button>}</div>
    </div></div></div>

    @if (isBusy)
    {
        <div class="card shadow-sm mt-3"><div class="card-body py-4">
            <div class="d-flex justify-content-between align-items-center mb-2"><strong>@progressMessage</strong><span dir="ltr">@progressPercent%</span></div>
            <div class="progress" style="height: 1.25rem;" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @($"{progressPercent}%")">@progressPercent%</div>
            </div>
        </div></div>
    }
    else if (preview is not null)
    {
        <div class="alert alert-info mt-3 mb-0">محل پرداخت دفتر خود صرافی: <strong>@preview.OwnPaymentLocationName</strong>. ردیف‌های این محل فقط دریافتی ثبت می‌شوند؛ سایر ردیف‌ها یک حواله ارسالی جفت‌شده نیز می‌سازند.</div>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><div class="card card-body"><small class="text-muted">تمام ردیف‌ها</small><strong class="fs-4">@preview.RowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body border-success"><small class="text-muted">معتبر</small><strong class="fs-4 text-success">@preview.ValidRowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body border-danger"><small class="text-muted">دارای خطا</small><strong class="fs-4 text-danger">@preview.InvalidRowCount.ToString("N0")</strong></div></div>
            <div class="col-md-3"><div class="card card-body"><small class="text-muted">حواله‌های ارسالی</small><strong class="fs-4">@preview.Rows.Count(x => x.RequiresOutgoingHawala).ToString("N0")</strong></div></div>
        </div>

        @if (ValidationIssueGroups.Count > 0)
        {
            <div class="card shadow-sm mt-3 border-danger">
                <div class="card-header bg-danger-subtle text-danger-emphasis"><strong><i class="bi bi-exclamation-octagon ms-1"></i>خطاهای فایل و روش اصلاح</strong></div>
                <div class="card-body">
                    <p class="mb-3">موارد زیر را در فایل Excel اصلاح کنید، فایل را ذخیره نمایید و سپس «انتخاب فایل دیگر» را بزنید.</p>
                    <div class="list-group list-group-flush">
                        @foreach (var issue in ValidationIssueGroups)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex flex-wrap justify-content-between gap-2">
                                    <strong class="text-danger">@issue.Message</strong>
                                    <span class="badge text-bg-danger">@issue.RowNumbers.Count.ToString("N0") ردیف</span>
                                </div>
                                <div class="small mt-1"><strong>ردیف‌های Excel:</strong> @FormatRowNumbers(issue.RowNumbers)</div>
                                <div class="small text-muted mt-1"><strong>راه اصلاح:</strong> @GetValidationGuidance(issue.Message)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (preview.MissingLocations.Count > 0)
        {
            <div class="card shadow-sm mt-3 border-warning"><div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center"><strong>محل‌های پرداخت جدید</strong><button type="button" class="btn btn-sm btn-outline-dark" @onclick="ToggleAllLocations">@(AllLocationsSelected ? "لغو انتخاب همه" : "انتخاب همه")</button></div><div class="card-body">
                <p class="mb-1">ایجاد این محل‌های پرداخت را تأیید کنید:</p>
                <p class="small text-muted mb-2">اگر نامی فقط از نظر املا با محل موجود تفاوت دارد، آن را ایجاد نکنید؛ نام محل را در Excel دقیقاً مانند نام ثبت‌شده اصلاح و فایل را دوباره انتخاب کنید.</p><div class="row g-2">
                @foreach (var location in preview.MissingLocations)
                { <div class="col-md-4"><label class="form-check border rounded p-2 pe-5 w-100"><input class="form-check-input" type="checkbox" checked="@locationsToCreate.Contains(location)" @onchange="args => ToggleSet(locationsToCreate, location, args)" /><span class="form-check-label">@location</span></label></div> }
                </div>
            </div></div>
        }

        @if (preview.MissingCorrespondents.Count > 0)
        {
            <div class="card shadow-sm mt-3 border-warning"><div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center"><strong>نمایندگی‌های محل پرداخت جدید</strong><button type="button" class="btn btn-sm btn-outline-dark" @onclick="ToggleAllCorrespondents">@(AllCorrespondentsSelected ? "لغو انتخاب همه" : "انتخاب همه")</button></div><div class="card-body">
                <p class="mb-2">برای ساخت حواله ارسالی، ایجاد نمایندگی‌های زیر را جداگانه تأیید کنید:</p><div class="row g-2">
                @foreach (var correspondent in preview.MissingCorrespondents)
                { <div class="col-md-4"><label class="form-check border rounded p-2 pe-5 w-100"><input class="form-check-input" type="checkbox" checked="@correspondentsToCreate.Contains(correspondent)" @onchange="args => ToggleSet(correspondentsToCreate, correspondent, args)" /><span class="form-check-label">@correspondent</span></label></div> }
                </div>
            </div></div>
        }

        @if (preview.Rows.Any(x => x.RequiresOutgoingHawala))
        {
            <div class="card shadow-sm mt-3"><div class="card-header"><strong>اعمال کمیشن یکسان روی تمام حواله‌های ارسالی</strong></div><div class="card-body row g-2 align-items-end">
                <div class="col-md-4"><label class="form-label">مبلغ کمیشن</label><InputNumber class="form-control" @bind-Value="bulkCommissionAmount" /></div>
                <div class="col-md-4"><label class="form-label">ارز کمیشن</label><select class="form-select" @bind="bulkCommissionCurrencyId"><option value="0">ارز خود هر حواله</option>@foreach (var currency in currencies){<option value="@currency.Id">@currency.Code - @currency.Name</option>}</select></div>
                <div class="col-md-4"><button class="btn btn-outline-primary w-100" @onclick="ApplyBulkCommission" disabled="@(bulkCommissionAmount is not > 0)">اعمال به همه حواله‌های ارسالی</button></div>
            </div></div>
        }

        <div class="card shadow-sm mt-3">
            <div class="card-header d-flex justify-content-between align-items-center"><div><strong>پیش‌نمایش فایل</strong> — @preview.CorrespondentName</div><button class="btn btn-success" @onclick="ConfirmAsync" disabled="@(!CanConfirm)" title="@ConfirmDisabledReason"><i class="bi bi-check2-circle ms-1"></i>تأیید و ثبت</button></div>
            @if (!CanConfirm){<div class="alert alert-warning rounded-0 mb-0">@ConfirmDisabledReason</div>}
            <div class="table-responsive" style="max-height: 560px;"><table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light sticky-top"><tr><th>ردیف</th><th>شماره / رفرنس</th><th>فرستنده / گیرنده</th><th>محل پرداخت</th><th>مبلغ</th><th>نوع ثبت</th><th>کمیشن عامل پرداخت</th><th>ارز کمیشن</th><th>بررسی</th></tr></thead>
                <tbody><Virtualize Items="@preview.Rows" Context="row" ItemSize="58" SpacerElement="tr">
                    <tr class="@(row.IsValid ? string.Empty : "table-danger")">
                        <td>@row.ExcelRowNumber</td><td><strong>@row.HawalaNumber</strong><br/><small>@row.ReferenceNumber</small></td><td>@row.SenderName<br/><small>@row.ReceiverName</small></td>
                        <td>@row.PaymentLocationText @if (!row.PaymentLocationId.HasValue){<span class="badge bg-warning text-dark">جدید</span>}</td><td dir="ltr">@row.Amount?.ToString("N0") @row.CurrencyCode</td>
                        <td>@if (row.RequiresOutgoingHawala){<span class="badge bg-primary">دریافتی + ارسالی</span><div class="small mt-1">به @(row.DestinationCorrespondentName ?? row.PaymentLocationText)</div>}else{<span class="badge bg-secondary">فقط دریافتی</span>}</td>
                        <td>@if (row.RequiresOutgoingHawala){<InputNumber class="form-control form-control-sm" @bind-Value="row.AgentCommissionAmount" placeholder="اختیاری"/>}else{<span>—</span>}</td>
                        <td>@if (row.RequiresOutgoingHawala){<select class="form-select form-select-sm" @bind="row.AgentCommissionCurrencyId"><option value="">انتخاب ارز</option>@foreach (var currency in currencies){<option value="@currency.Id">@currency.Code</option>}</select>}else{<span>—</span>}</td>
                        <td>@if (row.IsValid){<span class="text-success"><i class="bi bi-check-circle"></i> معتبر</span>}else{<span class="text-danger">@row.ValidationErrors</span>}</td>
                    </tr>
                </Virtualize></tbody>
            </table></div>
        </div>
    }
</div>

@code {
    [Parameter] public long CorrespondentId { get; set; }
    private const long MaximumFileSize = 10 * 1024 * 1024;
    private List<CurrencyDto> currencies = [];
    private HawalaImportPreviewDto? preview;
    private HawalaImportResultDto? result;
    private readonly HashSet<string> locationsToCreate = new(StringComparer.Ordinal);
    private readonly HashSet<string> correspondentsToCreate = new(StringComparer.Ordinal);
    private decimal? bulkCommissionAmount;
    private long bulkCommissionCurrencyId;
    private ImportErrorViewModel? importError;
    private bool isBusy;
    private int progressPercent;
    private string progressMessage = "در حال آماده‌سازی...";

    private bool CanConfirm => preview is not null && preview.InvalidRowCount == 0 && preview.MissingLocations.All(locationsToCreate.Contains) && preview.MissingCorrespondents.All(correspondentsToCreate.Contains) && preview.Rows.Where(x => x.RequiresOutgoingHawala && x.AgentCommissionAmount is > 0).All(x => x.AgentCommissionCurrencyId is > 0) && !isBusy;
    private string? ConfirmDisabledReason => preview is null
        ? "ابتدا فایل را انتخاب و بررسی کنید."
        : isBusy
            ? progressMessage
            : preview.InvalidRowCount > 0
                ? $"فایل دارای {preview.InvalidRowCount:N0} ردیف نامعتبر است؛ خطاهای جدول را اصلاح کنید."
                : preview.MissingLocations.Any(x => !locationsToCreate.Contains(x))
                    ? "ایجاد تمام محل‌های پرداخت جدید را تأیید کنید."
                    : preview.MissingCorrespondents.Any(x => !correspondentsToCreate.Contains(x))
                        ? "ایجاد تمام نمایندگی‌های جدید را تأیید کنید."
                        : preview.Rows.Any(x => x.RequiresOutgoingHawala && x.AgentCommissionAmount is > 0 && x.AgentCommissionCurrencyId is not > 0)
                            ? "برای تمام کمیشن‌های واردشده، ارز کمیشن را انتخاب کنید."
                            : null;
    private bool AllLocationsSelected => preview is not null && preview.MissingLocations.All(locationsToCreate.Contains);
    private bool AllCorrespondentsSelected => preview is not null && preview.MissingCorrespondents.All(correspondentsToCreate.Contains);
    private List<ValidationIssueViewModel> ValidationIssueGroups => preview?.Rows
        .Where(x => !x.IsValid)
        .SelectMany(row => SplitValidationErrors(row.ValidationErrors)
            .Select(message => new { row.ExcelRowNumber, Message = message }))
        .GroupBy(x => x.Message, StringComparer.Ordinal)
        .Select(group => new ValidationIssueViewModel(group.Key,
            group.Select(x => x.ExcelRowNumber).Distinct().OrderBy(x => x).ToList()))
        .OrderBy(x => x.RowNumbers[0])
        .ToList() ?? [];

    protected override async Task OnInitializedAsync()
    { try { currencies = (await ReferenceDataCache.GetActiveCurrenciesAsync()).OrderBy(x => x.QuotationPriority).ThenBy(x => x.Code).ToList(); } catch (Exception ex) { importError = BuildImportError(ex, "بارگذاری ارزهای فعال", false); } }

    private async Task PreviewFileAsync(InputFileChangeEventArgs args)
    {
        importError = null; result = null; isBusy = true; progressPercent = 1; progressMessage = "در حال آپلود فایل...";
        try { await using var stream = args.File.OpenReadStream(MaximumFileSize); preview = await HawalaImportService.PreviewAsync(stream, args.File.Name, CorrespondentId, CreateProgressReporter()); locationsToCreate.Clear(); correspondentsToCreate.Clear(); }
        catch (Exception ex) { importError = BuildImportError(ex, progressMessage, false); preview = null; }
        finally { isBusy = false; }
    }

    private static void ToggleSet(HashSet<string> set, string value, ChangeEventArgs args)
    { if (args.Value is bool selected && selected) set.Add(value); else set.Remove(value); }

    private void ToggleAllLocations()
    {
        if (preview is null) return;
        if (AllLocationsSelected) locationsToCreate.Clear();
        else foreach (var value in preview.MissingLocations) locationsToCreate.Add(value);
    }

    private void ToggleAllCorrespondents()
    {
        if (preview is null) return;
        if (AllCorrespondentsSelected) correspondentsToCreate.Clear();
        else foreach (var value in preview.MissingCorrespondents) correspondentsToCreate.Add(value);
    }

    private void ApplyBulkCommission()
    {
        if (preview is null || bulkCommissionAmount is not > 0) return;
        foreach (var row in preview.Rows.Where(x => x.RequiresOutgoingHawala)) { row.AgentCommissionAmount = bulkCommissionAmount; row.AgentCommissionCurrencyId = bulkCommissionCurrencyId > 0 ? bulkCommissionCurrencyId : row.CurrencyId; }
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm || preview is null) return;
        importError = null; isBusy = true; progressPercent = 1; progressMessage = "در حال آغاز ثبت گروهی...";
        try
        {
            result = await HawalaImportService.ConfirmAsync(new ConfirmHawalaImportDto { BatchId = preview.BatchId, LocationsToCreate = locationsToCreate.ToList(), CorrespondentsToCreate = correspondentsToCreate.ToList(), Commissions = preview.Rows.Where(x => x.RequiresOutgoingHawala).Select(x => new HawalaImportCommissionDto { RowId = x.Id, Amount = x.AgentCommissionAmount, CurrencyId = x.AgentCommissionCurrencyId }).ToList() }, CreateProgressReporter());
            preview = null; locationsToCreate.Clear(); correspondentsToCreate.Clear();
        }
        catch (Exception ex) { importError = BuildImportError(ex, progressMessage, true); }
        finally { isBusy = false; }
    }

    private IProgress<HawalaImportProgressDto> CreateProgressReporter() => new Progress<HawalaImportProgressDto>(update =>
    {
        progressPercent = update.Percent;
        progressMessage = update.Message;
        _ = InvokeAsync(StateHasChanged);
    });

    private void Reset() { preview = null; result = null; importError = null; locationsToCreate.Clear(); correspondentsToCreate.Clear(); bulkCommissionAmount = null; bulkCommissionCurrencyId = 0; progressPercent = 0; progressMessage = "در حال آماده‌سازی..."; }
    private void BackToCorrespondent() => NavigationManager.NavigateTo($"/correspondents/{CorrespondentId}");

    private static IEnumerable<string> SplitValidationErrors(string? errors) =>
        (errors ?? string.Empty).Split(" | ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string FormatRowNumbers(IReadOnlyCollection<int> rows)
    {
        const int visibleCount = 20;
        var text = string.Join("، ", rows.Take(visibleCount));
        return rows.Count > visibleCount ? $"{text} و {rows.Count - visibleCount:N0} ردیف دیگر" : text;
    }

    private static string GetValidationGuidance(string message)
    {
        if (message.Contains("همین فایل تکراری", StringComparison.Ordinal))
            return "یکی از ردیف‌های تکراری را حذف کنید یا شماره/رفرنس درست را در ستون اول یا دوم وارد کنید.";
        if (message.Contains("قبلاً برای این نمایندگی", StringComparison.Ordinal))
            return "سوابق نمایندگی را بررسی کنید. اگر همان حواله است آن را دوباره وارد نکنید؛ در غیر آن شماره یا رفرنس صحیح را در Excel اصلاح کنید.";
        if (message.Contains("شماره حواله", StringComparison.Ordinal))
            return "ستون اول باید یک شماره صحیح، بدون حروف و برای هر حواله دارای مقدار باشد.";
        if (message.Contains("رفرنس", StringComparison.Ordinal))
            return "رفرنس را در ستون دوم بررسی کنید و مقدار تکراری یا اشتباه را اصلاح نمایید.";
        if (message.Contains("فرستنده", StringComparison.Ordinal))
            return "نام فرستنده را در ستون سوم وارد کنید.";
        if (message.Contains("گیرنده", StringComparison.Ordinal))
            return "نام گیرنده را در ستون چهارم وارد کنید.";
        if (message.Contains("محل پرداخت", StringComparison.Ordinal))
            return "نام محل پرداخت را در ستون پنجم وارد کنید؛ املای آن را با محل‌های موجود یکسان نگه دارید.";
        if (message.Contains("کمیشن", StringComparison.Ordinal) && message.Contains("ارز", StringComparison.Ordinal))
            return "کد ارز کمیشن را در ستون نهم مانند USD یا AFN وارد کنید؛ اگر خالی باشد ارز خود حواله استفاده می‌شود.";
        if (message.Contains("کمیشن", StringComparison.Ordinal))
            return "مبلغ کمیشن ستون هشتم باید عددی و بزرگ‌تر از صفر باشد، یا برای نداشتن کمیشن خالی بماند.";
        if (message.Contains("ارز", StringComparison.Ordinal))
            return "کد ارز ستون هفتم را مانند USD، AFN یا AED وارد کنید و مطمئن شوید ارز در سیستم فعال است.";
        if (message.Contains("مبلغ", StringComparison.Ordinal))
            return "مبلغ ستون ششم باید عددی و بزرگ‌تر از صفر باشد.";
        return "مقادیر این ردیف را با ساختار ستون‌های راهنما مقایسه و اصلاح کنید.";
    }

    private ImportErrorViewModel BuildImportError(Exception exception, string lastStage, bool duringConfirm)
    {
        var root = exception.GetBaseException();
        var actions = new List<string>();
        string title;
        string message;

        if (root is SqlException { Number: -2 })
        {
            title = "پایگاه‌داده در زمان تعیین‌شده پاسخ نداد";
            message = duringConfirm
                ? "ثبت نهایی کامل نشد و تراکنش برگشت داده شد؛ روی دکمه ثبت چند بار کلیک نکنید."
                : "بررسی فایل در زمان تعیین‌شده کامل نشد.";
            actions.Add("چند لحظه صبر کنید و فقط یک‌بار دوباره تلاش کنید.");
            actions.Add("اگر خطا تکرار شد، آخرین مرحله و جزئیات فنی زیر را برای پشتیبانی بفرستید.");
        }
        else if (root is TaskCanceledException or OperationCanceledException)
        {
            title = "ارتباط صفحه هنگام انجام عملیات قطع شد";
            message = duringConfirm
                ? "نتیجه ثبت به صفحه برنگشت. ابتدا فهرست حواله‌ها را بررسی کنید و بدون بررسی دوباره ثبت نکنید."
                : "ارتباط صفحه پیش از تکمیل پیش‌نمایش قطع شد.";
            actions.Add("اتصال شبکه و بازبودن برنامه را بررسی کنید و صفحه را تازه‌سازی نمایید.");
            actions.Add(duringConfirm
                ? "در نمایندگی کویته، شماره‌های فایل را جستجو کنید؛ اگر ثبت نشده بود دوباره آپلود کنید."
                : "فایل را دوباره انتخاب کنید.");
        }
        else if (root is IOException or InvalidDataException)
        {
            title = "فایل Excel قابل خواندن نیست";
            message = "فایل باز، ناقص یا دارای قالب نامعتبر است.";
            actions.Add("فایل را در Excel باز کنید و با فرمت .xlsx ذخیره نمایید.");
            actions.Add("فایل را در Excel ببندید و دوباره انتخاب کنید.");
        }
        else if (root is InvalidOperationException)
        {
            title = duringConfirm ? "ثبت گروهی انجام نشد" : "فایل نیاز به اصلاح دارد";
            message = root.Message;
            actions.Add(duringConfirm
                ? "پیام بالا را اصلاح کنید؛ پیش‌نمایش فعلی حفظ شده و می‌توانید دوباره تأیید کنید."
                : "مقادیر فایل و تنظیمات نمایندگی را مطابق پیام بالا اصلاح و فایل را دوباره انتخاب کنید.");
        }
        else
        {
            title = duringConfirm ? "خطای غیرمنتظره در ثبت گروهی" : "خطای غیرمنتظره در بررسی فایل";
            message = "عملیات کامل نشد. اطلاعات واردشده را تغییر ندهید و جزئیات زیر را برای پشتیبانی بفرستید.";
            actions.Add("از پیام و آخرین مرحله تصویر بگیرید.");
            actions.Add("یک‌بار صفحه را تازه‌سازی و دوباره تلاش کنید.");
        }

        return new ImportErrorViewModel(title, message, lastStage, actions,
            $"{root.GetType().Name}: {root.Message}");
    }

    private sealed record ValidationIssueViewModel(string Message, List<int> RowNumbers);
    private sealed record ImportErrorViewModel(
        string Title,
        string Message,
        string LastStage,
        List<string> Actions,
        string TechnicalMessage);
}
