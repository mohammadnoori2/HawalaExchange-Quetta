@page "/hawala-receive"

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IHawalaService HawalaService
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject ICompanySettingService CompanySettingService
@inject IFileService FileService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-download"></i>
                حواله‌های دریافتی
                <span class="page-subtitle">حواله‌های دریافتی اجراشده و پرداخت‌شده</span>
            </h5>
        </div>

        <div class="page-actions">
            <button class="btn-modern btn-light-modern btn-rounded" @onclick="LoadData">
                <i class="bi bi-arrow-clockwise"></i>
                تازه‌سازی
            </button>
        </div>
    </div>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@hawalas.Count</div>
                        <div class="stat-label">اجرا شده</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4 align-items-end">
        <div class="col-md-7">
            <label class="form-label fw-bold">
                <i class="bi bi-search text-muted me-1"></i>
                جستجو
            </label>

            <input class="form-control"
                   placeholder="نمبر، فرستنده، گیرنده، نمبر متفرقه..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <div class="col-md-2">
            <button class="btn-modern btn-primary-modern w-100" @onclick="ApplyFilter">
                <i class="bi bi-search"></i>
                فیلتر
            </button>
        </div>

        <div class="col-md-2">
            <button class="btn-modern btn-light-modern w-100" @onclick="ResetFilter">
                <i class="bi bi-arrow-clockwise"></i>
                بازنشانی
            </button>
        </div>
    </div>

    <div class="table-card hawala-list-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i>
                    @filteredHawalas.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>نمبر</th>
                            <th>فرستنده</th>
                            <th>گیرنده</th>
                            <th>نماینده</th>
                            <th>مبلغ</th>
                            <th>کارمزد</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                            <th class="text-center" style="width:80px;">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="spinner-border text-primary"></div>
                                    <p class="text-muted mt-2">در حال بارگذاری...</p>
                                </td>
                            </tr>
                        }
                        else if (!pagedHawalas.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    هیچ حواله دریافتی یافت نشد.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (currentPage - 1) * pageSize + 1;

                            @foreach (var hawala in pagedHawalas)
                            {
                                <tr>
                                    <td>@rowIndex</td>

                                    <td>
                                        <strong>@hawala.Number</strong>
                                    </td>

                                    <td>@(hawala.SenderName ?? "-")</td>

                                    <td>@(hawala.ReceiverName ?? "-")</td>

                                    <td>@(hawala.CorrespondentName ?? "-")</td>

                                    <td dir="ltr" class="fw-bold text-primary">
                                        @MoneyFormatHelper.Format(hawala.FromAmount) @hawala.FromCurrencyCode
                                    </td>

                                    <td dir="ltr">
                                        @(hawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.CommissionAmount.Value) : "-")
                                        @hawala.CommissionCurrencyCode
                                    </td>

                                    <td>
                                        <span class="badge-modern @GetStatusBadge(hawala.Status)">
                                            @hawala.StatusName
                                        </span>
                                    </td>

                                    <td dir="ltr">
                                        @PersianDateHelper.ToPersianDateTime12(hawala.CreatedAt)
                                    </td>

                                    <td class="text-center operation-cell">
                                        <HawalaOperationMenu Hawala="hawala"
                                                             ShowEdit="true"
                                                             ShowPay="true"
                                                             ShowCancel="true"
                                                             ShowDelete="true"
                                                             OnView="ViewHawala"
                                                             OnEdit="OpenEditModal"
                                                             OnReceipt="OpenReceipt"
                                                             OnCopy="CopyHawalaInfo"
                                                             OnWhatsApp="ShareHawalaWhatsApp"
                                                             OnTelegram="ShareHawalaTelegram"
                                                             OnPay="OpenPayFromMenu"
                                                             OnCancel="ShowCancelConfirm"
                                                             OnDelete="ShowDeleteConfirm" />
                                    </td>
                                </tr>

                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedHawalas.Count</strong>
                    از <strong>@filteredHawalas.Count</strong>
                </span>
            </div>

            <div class="table-card-footer-right">
                @if (totalPages > 1)
                {
                    <ul class="pagination-modern">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>

                        @for (var i = 1; i <= totalPages; i++)
                        {
                            var pageNumber = i;

                            <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                    @pageNumber
                                </button>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<CreateHawalaModal IsVisible="@showEditModal"
                   IsVisibleChanged="@((bool value) => { showEditModal = value; StateHasChanged(); })"
                   IsEditMode="true"
                   EditId="@editId"
                   EditData="@editHawalaData"
                   OnEditSuccess="@OnHawalaEdited" />

@if (showPayModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-check-circle me-2"></i>
                        پرداخت حواله دریافتی
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="ClosePayModal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info">
                        پرداخت حواله نمبر:
                        <strong>@payHawalaNumber</strong>
                    </div>

                    <ReceiverPaymentFields Model="payDetails" Customers="customers" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            حساب پرداخت‌کننده <span class="text-danger">*</span>
                        </label>

                        <AccountSearchSelect Accounts="@paymentAccounts"
                                             @bind-Value="selectedPaymentAccountId"
                                             Placeholder="جستجوی حساب پرداخت‌کننده..." />

                        <small class="text-muted">
                            حساب انتخاب‌شده در لیجر طلبکار می‌شود.
                        </small>
                    </div>

                    <div class="alert alert-warning mb-0">
                        <strong>سند حسابداری:</strong>
                        <div class="mt-2" dir="ltr">
                            Pending Hawala Account: BadehKar |
                            Selected Payment Account: TalabKar
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="ClosePayModal">
                        انصراف
                    </button>

                    <button class="btn-modern btn-primary-modern"
                            @onclick="ConfirmPay"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }

                        تأیید پرداخت
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDetailModal && selectedHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i>
                        جزئیات حواله دریافتی
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDetailModal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نمبر</span>
                                <span class="info-value fw-bold">@selectedHawala.Number</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">@selectedHawala.StatusName</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">تاریخ</span>
                                <span class="info-value" dir="ltr">
                                    @PersianDateHelper.ToPersianDateTime12(selectedHawala.CreatedAt)
                                </span>
                            </div>
                        </div>

                        @if (selectedHawala.PaidAt.HasValue)
                        {
                            <div class="col-md-4">
                                <div class="info-card">
                                    <span class="info-label">تاریخ پرداخت</span>
                                    <span class="info-value" dir="ltr">
                                        @PersianDateHelper.ToPersianDateTime12(selectedHawala.PaidAt.Value)
                                    </span>
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">فرستنده</span>
                                <span class="info-value">@(selectedHawala.SenderName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">نماینده</span>
                                <span class="info-value">@(selectedHawala.CorrespondentName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">محل پرداخت</span>
                                <span class="info-value">@GetPaymentLocation(selectedHawala)</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">مبلغ</span>
                                <span class="info-value text-primary fw-bold" dir="ltr">
                                    @MoneyFormatHelper.Format(selectedHawala.FromAmount) @selectedHawala.FromCurrencyCode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">مبلغ دریافتی/پرداختی</span>
                                <span class="info-value text-success fw-bold" dir="ltr">
                                    @(selectedHawala.ToAmount.HasValue ? MoneyFormatHelper.Format(selectedHawala.ToAmount.Value) : "-") @selectedHawala.ToCurrencyCode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">کارمزد</span>
                                <span class="info-value" dir="ltr">
                                    @(selectedHawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(selectedHawala.CommissionAmount.Value) : "-")
                                    @selectedHawala.CommissionCurrencyCode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">کارمزد نماینده</span>
                                <span class="info-value" dir="ltr">
                                    @(selectedHawala.AgentCommissionAmount.HasValue ? MoneyFormatHelper.Format(selectedHawala.AgentCommissionAmount.Value) : "-")
                                    @selectedHawala.AgentCommissionCurrencyCode
                                </span>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <h6 class="text-primary fw-bold mb-0">
                                <i class="bi bi-person-vcard me-2"></i>
                                مشخصات کامل گیرنده
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">نام گیرنده</span>
                                <span class="info-value">@(selectedHawala.ReceiverName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">نام پدر</span>
                                <span class="info-value">@(selectedHawala.ReceiverFatherName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">شماره تماس</span>
                                <span class="info-value" dir="ltr">@(selectedHawala.ReceiverPhone ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">شماره تذکره</span>
                                <span class="info-value">@(selectedHawala.ReceiverTazkiraNumber ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-card">
                                <span class="info-label">آدرس گیرنده</span>
                                <span class="info-value">@(selectedHawala.ReceiverAddress ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-card">
                                <span class="info-label mb-2">عکس تذکره گیرنده</span>
                                @if (!string.IsNullOrWhiteSpace(selectedHawala.ReceiverTazkiraImagePath))
                                {
                                    var tazkiraImageUrl = FileService.GetFileUrl(selectedHawala.ReceiverTazkiraImagePath);
                                    <a href="@tazkiraImageUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="مشاهده عکس تذکره در اندازه کامل">
                                        <img src="@tazkiraImageUrl"
                                             alt="عکس تذکره گیرنده"
                                             class="img-fluid rounded border"
                                             style="width: 100%; max-height: 360px; object-fit: contain; background: #f8f9fa;" />
                                    </a>
                                    <small class="text-muted d-block mt-2">
                                        برای مشاهده در اندازه کامل روی عکس کلیک کنید.
                                    </small>
                                }
                                else
                                {
                                    <span class="info-value text-muted">عکس تذکره ثبت نشده است.</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedHawala.Notes))
                        {
                            <div class="col-12">
                                <div class="info-card">
                                    <span class="info-label">یادداشت</span>
                                    <span class="info-value">@selectedHawala.Notes</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="CloseDetailModal">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReceiptModal && receiptHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-receipt me-2"></i>
                        رسید حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseReceipt"></button>
                </div>

                <div class="modal-body">
                    <div id="hawalaReceiptPrintArea">
                        <HawalaReceipt Hawala="receiptHawala"
                                       Company="companySetting" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="CloseReceipt">
                        بستن
                    </button>

                    <button class="btn-modern btn-secondary-modern" @onclick="() => CopyHawalaInfo(receiptHawala.Id)">
                        <i class="bi bi-clipboard"></i>
                        کاپی
                    </button>

                    <button class="btn-modern btn-success-modern" @onclick="() => ShareHawalaWhatsApp(receiptHawala.Id)">
                        <i class="bi bi-whatsapp"></i>
                        واتساپ
                    </button>

                    <button class="btn-modern btn-primary-modern" @onclick="() => ShareHawalaTelegram(receiptHawala.Id)">
                        <i class="bi bi-telegram"></i>
                        تلگرام
                    </button>

                    <button class="btn-modern btn-primary-modern" @onclick="PrintReceipt">
                        <i class="bi bi-printer"></i>
                        چاپ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCancelModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        لغو حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseCancelModal"></button>
                </div>

                <div class="modal-body">
                    <p class="fw-bold mb-2">نوع لغو را انتخاب کنید:</p>
                    <div class="d-grid gap-2 mb-3">
                        <label class="border rounded p-3 d-flex gap-2 align-items-start">
                            <input type="radio" name="cancelModeReceive" checked="@cancelIncludesCommission"
                                   @onchange="() => cancelIncludesCommission = true" />
                            <span><strong>لغو با کارمزد</strong><br /><small class="text-muted">مبلغ حواله و تمام کارمزدها در لیجر معکوس می‌شوند.</small></span>
                        </label>
                        <label class="border rounded p-3 d-flex gap-2 align-items-start">
                            <input type="radio" name="cancelModeReceive" checked="@(!cancelIncludesCommission)"
                                   @onchange="() => cancelIncludesCommission = false" />
                            <span><strong>لغو بدون کارمزد</strong><br /><small class="text-muted">فقط مبلغ حواله معکوس می‌شود و کارمزدهای ثبت‌شده باقی می‌مانند.</small></span>
                        </label>
                    </div>
                    <p>دلیل لغو حواله را وارد کنید:</p>

                    <textarea class="form-control"
                              rows="3"
                              @bind="cancelReason"
                              placeholder="دلیل لغو..."></textarea>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn-modern btn-light-modern" @onclick="CloseCancelModal">
                        انصراف
                    </button>

                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmCancel">
                        تأیید لغو
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-trash me-2"></i>
                        حذف حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDeleteModal"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این حواله را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است.</p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn-modern btn-light-modern" @onclick="CloseDeleteModal">
                        انصراف
                    </button>

                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmDelete">
                        تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<HawalaDto> hawalas = new();
    private List<HawalaDto> filteredHawalas = new();
    private List<AccountDto> accounts = new();

    private HawalaDto? selectedHawala;
    private HawalaDto? receiptHawala;
    private CompanySettingDto companySetting = new();

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private bool isLoading = false;
    private bool showPayModal = false;
    private bool showEditModal = false;
    private bool showDetailModal = false;
    private bool showReceiptModal = false;
    private bool showCancelModal = false;
    private bool showDeleteModal = false;

    private long payHawalaId = 0;
    private long payHawalaNumber = 0;
    private long selectedPaymentAccountId = 0;
    private long editId = 0;
    private CreateHawalaDto? editHawalaData;
    private List<CustomerDto> customers = new();
    private PayHawalaDto payDetails = new();

    private long cancelId = 0;
    private long deleteId = 0;
    private string cancelReason = string.Empty;
    private bool cancelIncludesCommission = true;

    private string searchTerm = string.Empty;
    private int pageSize = 10;
    private int currentPage = 1;

    private List<HawalaDto> pagedHawalas =>
        filteredHawalas
            .OrderByDescending(x => x.CreatedAt)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int totalPages =>
        filteredHawalas.Count == 0
            ? 1
            : (int)Math.Ceiling((double)filteredHawalas.Count / pageSize);

    private List<AccountDto> paymentAccounts =>
        accounts
            .Where(IsPaymentAccount)
            .OrderBy(x => x.AccountCode)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadCustomers();
        await LoadData();
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();

            accounts = result
                .Where(x => !x.IsArchived)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    private async Task LoadCustomers()
    {
        customers = (await CustomerService.GetAllAsync())
            .Where(x => !x.IsArchived)
            .ToList();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;

            var filter = new HawalaFilterDto
            {
                HawalaType = "HawalaReceive",
                Status = "Paid",
                PageNumber = 1,
                PageSize = int.MaxValue,
                SortColumn = "CreatedAt",
                SortDirection = "desc"
            };

            var result = await HawalaService.GetHawalasAsync(filter);

            hawalas = result.Items
                .Where(x => x.Status == "Paid")
                .ToList();

            SearchLocal();

            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله‌های دریافتی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilter()
    {
        await LoadData();
    }

    private async Task ResetFilter()
    {
        searchTerm = string.Empty;

        await LoadData();
    }

    private void SearchLocal()
    {
        var query = hawalas.Where(x => x.Status == "Paid");

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();

            query = query.Where(x =>
                x.Number.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(x.SenderName) && x.SenderName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.ReceiverName) && x.ReceiverName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.ReferenceNumber) && x.ReferenceNumber.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.CorrespondentName) && x.CorrespondentName.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        filteredHawalas = query.ToList();
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
            currentPage = page;
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var hawala = await HawalaService.GetHawalaByIdAsync(id);
            var hawalaIdToEdit = id;

            if (hawala?.IsSystemGenerated == true && hawala.SourceHawalaId.HasValue)
            {
                hawalaIdToEdit = hawala.SourceHawalaId.Value;
                hawala = await HawalaService.GetHawalaByIdAsync(hawalaIdToEdit);
            }

            if (hawala == null)
            {
                validationErrors.Add("حواله برای ویرایش یافت نشد.");
                return;
            }

            editHawalaData = new CreateHawalaDto
            {
                Number = hawala.Number,
                HawalaType = hawala.HawalaType,
                CorrespondentId = hawala.CorrespondentId,
                SenderName = hawala.SenderName,
                SenderFatherName = hawala.SenderFatherName,
                SenderPhone = hawala.SenderPhone,
                SenderTazkiraNumber = hawala.SenderTazkiraNumber,
                SenderTazkiraImagePath = hawala.SenderTazkiraImagePath,
                SenderAddress = hawala.SenderAddress,
                ReceiverName = hawala.ReceiverName,
                ReceiverFatherName = hawala.ReceiverFatherName,
                ReceiverPhone = hawala.ReceiverPhone,
                ReceiverTazkiraNumber = hawala.ReceiverTazkiraNumber,
                ReceiverTazkiraImagePath = hawala.ReceiverTazkiraImagePath,
                ReceiverAddress = hawala.ReceiverAddress,
                FromCurrencyId = hawala.FromCurrencyId,
                FromAmount = hawala.FromAmount,
                ToCurrencyId = hawala.ToCurrencyId,
                ToAmount = hawala.ToAmount,
                ExchangeRate = hawala.ExchangeRate,
                CommissionAmount = hawala.CommissionAmount,
                CommissionCurrencyId = hawala.CommissionCurrencyId,
                AgentCommissionAmount = hawala.AgentCommissionAmount,
                AgentCommissionCurrencyId = hawala.AgentCommissionCurrencyId,
                ReferenceNumber = hawala.ReferenceNumber,
                Notes = hawala.Notes,
                Status = hawala.Status,
                PaymentLocationId = hawala.PaymentLocationId,
                FromAccountId = hawala.FromAccountId,
                GeneratedSendHawalaNumber = hawala.GeneratedSendHawalaNumber
            };

            editId = hawalaIdToEdit;
            showEditModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله برای ویرایش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnHawalaEdited(long id)
    {
        showEditModal = false;
        editId = 0;
        editHawalaData = null;
        successMessage = "حواله با موفقیت ویرایش شد.";
        await LoadData();
    }

    private async Task ViewHawala(long id)
    {
        try
        {
            selectedHawala = await HawalaService.GetHawalaByIdAsync(id);
            if (selectedHawala == null || selectedHawala.Status != "Paid")
            {
                validationErrors.Add("فقط جزئیات حواله‌های دریافتی اجراشده قابل مشاهده است.");
                selectedHawala = null;
                return;
            }

            showDetailModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در مشاهده حواله: {ex.Message}");
        }
    }

    private void CloseDetailModal()
    {
        selectedHawala = null;
        showDetailModal = false;
    }

    private void OpenPayFromMenu(HawalaDto hawala)
    {
        OpenPayModal(hawala.Id, hawala.Number);
    }

    private void OpenPayModal(long hawalaId, long hawalaNumber)
    {
        payHawalaId = hawalaId;
        payHawalaNumber = hawalaNumber;
        selectedPaymentAccountId = 0;
        var hawala = hawalas.FirstOrDefault(x => x.Id == hawalaId);
        payDetails = CreatePayDetails(hawala);
        validationErrors.Clear();
        successMessage = string.Empty;
        showPayModal = true;
    }

    private void ClosePayModal()
    {
        showPayModal = false;
        payHawalaId = 0;
        payHawalaNumber = 0;
        selectedPaymentAccountId = 0;
        payDetails = new PayHawalaDto();
    }

    private async Task ConfirmPay()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (selectedPaymentAccountId <= 0)
        {
            validationErrors.Add("انتخاب حساب پرداخت‌کننده الزامی است.");
            return;
        }

        try
        {
            isLoading = true;

            payDetails.PaidFromAccountId = selectedPaymentAccountId;
            await HawalaService.MarkAsPaidAsync(payHawalaId, payDetails);

            successMessage = "حواله با موفقیت پرداخت شد.";

            ClosePayModal();

            await LoadData();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در پرداخت حواله: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static PayHawalaDto CreatePayDetails(HawalaDto? hawala) => new()
    {
        ReceiverName = hawala?.ReceiverName ?? string.Empty,
        ReceiverFatherName = hawala?.ReceiverFatherName,
        ReceiverPhone = hawala?.ReceiverPhone,
        ReceiverTazkiraNumber = hawala?.ReceiverTazkiraNumber,
        ReceiverTazkiraImagePath = hawala?.ReceiverTazkiraImagePath,
        ReceiverAddress = hawala?.ReceiverAddress
    };

