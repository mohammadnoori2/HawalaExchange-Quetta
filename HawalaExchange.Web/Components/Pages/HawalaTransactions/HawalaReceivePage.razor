    private bool IsPaymentAccount(AccountDto account)
    {
        return string.Equals(account.AccountType, "Cash", StringComparison.OrdinalIgnoreCase)
            || string.Equals(account.AccountType, "Bank", StringComparison.OrdinalIgnoreCase)
            || string.Equals(account.AccountType, "Customer", StringComparison.OrdinalIgnoreCase)
            || string.Equals(account.AccountType, "Correspondent", StringComparison.OrdinalIgnoreCase);
    }

    private string GetAccountTypeName(string? type)
    {
        return type?.ToLower() switch
        {
            "cash" => "نقدی",
            "bank" => "بانک",
            "customer" => "مشتری",
            "correspondent" => "نماینده",
            "income" => "درآمد",
            "expense" => "مصرف",
            "equity" => "سرمایه",
            "pendinghawala" => "حواله‌های اجرا نشده",
            _ => type ?? "نامشخص"
        };
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "badge-warning",
            "Paid" => "badge-success",
            "Cancel" => "badge-danger",
            _ => "badge-secondary"
        };
    }

    private string GetPaymentLocation(HawalaDto hawala)
    {
        return hawala.PaymentLocationName
               ?? hawala.PaymentLocationAddress
               ?? hawala.PaymentLocation
               ?? "-";
    }
