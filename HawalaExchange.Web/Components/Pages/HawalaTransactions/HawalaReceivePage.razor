    private void OpenPayModal(long hawalaId, long hawalaNumber)
    {
        payHawalaId = hawalaId;
        payHawalaNumber = hawalaNumber;
        selectedPaymentAccountId = 0;
        var hawala = hawalas.FirstOrDefault(x => x.Id == hawalaId);
        payDetails = CreatePayDetails(hawala);
        validationErrors.Clear();
        successMessage = string.Empty;
        showPayModal = true;
    }

    private void ClosePayModal()
    {
        showPayModal = false;
        payHawalaId = 0;
        payHawalaNumber = 0;
        selectedPaymentAccountId = 0;
        payDetails = new PayHawalaDto();
    }

    private async Task ConfirmPay()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (selectedPaymentAccountId <= 0)
        {
            validationErrors.Add("انتخاب حساب پرداخت‌کننده الزامی است.");
            return;
        }

        try
        {
            isLoading = true;

            payDetails.PaidFromAccountId = selectedPaymentAccountId;
            await HawalaService.MarkAsPaidAsync(payHawalaId, payDetails);

            successMessage = "حواله با موفقیت پرداخت شد.";

            ClosePayModal();

            await LoadData();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در پرداخت حواله: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static PayHawalaDto CreatePayDetails(HawalaDto? hawala) => new()
    {
        ReceiverName = hawala?.ReceiverName ?? string.Empty,
        ReceiverFatherName = hawala?.ReceiverFatherName,
        ReceiverPhone = hawala?.ReceiverPhone,
        ReceiverTazkiraNumber = hawala?.ReceiverTazkiraNumber,
        ReceiverTazkiraImagePath = hawala?.ReceiverTazkiraImagePath,
        ReceiverAddress = hawala?.ReceiverAddress
    };

