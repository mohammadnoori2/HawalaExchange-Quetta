}

<!-- مودال تأیید لغو -->
@if (showCancelModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> لغو حواله
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseCancelModal()"></button>
                </div>
                <div class="modal-body">
                    <p class="fs-6">دلیل لغو حواله را وارد کنید:</p>
                    <textarea class="form-control" @bind="cancelReason" rows="3" placeholder="دلیل لغو ..."></textarea>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseCancelModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmCancel()">
                        <i class="bi bi-check-circle"></i> تأیید لغو
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید حذف
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDeleteModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این حواله را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDeleteModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete()">
                        <i class="bi bi-check-circle"></i> تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

