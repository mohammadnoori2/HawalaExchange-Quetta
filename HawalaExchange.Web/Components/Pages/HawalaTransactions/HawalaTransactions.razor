@page "/hawala-transactions"
@using Microsoft.JSInterop
@using HawalaExchange.Web.Helpers
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using HawalaExchange.Application.Services
@using HawalaExchange.Domain.Entities
@inject IJSRuntime JS
@inject ICompanySettingService CompanySettingService
@inject IHawalaService HawalaService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject IPaymentLocationService PaymentLocationService
@inject IWebHostEnvironment WebHostEnvironment
@inject IFileService FileService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-arrow-left-right"></i>
                مدیریت حواله‌ها
                <span class="page-subtitle">لیست و جستجوی حواله‌ها</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> حواله جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <div class="stat-number">@totalCount</div>
                        <div class="stat-label">تعداد کل</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success"><i class="bi bi-send"></i></div>
                    <div>
                        <div class="stat-number">@hawalaSendCount</div>
                        <div class="stat-label">حواله ارسال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info"><i class="bi bi-download"></i></div>
                    <div>
                        <div class="stat-number">@hawalaReceiveCount</div>
                        <div class="stat-label">حواله دریافت</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning"><i class="bi bi-asterisk"></i></div>
                    <div>
                        <div class="stat-number">@hawalaOtherCount</div>
                        <div class="stat-label">حواله متفرقه</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <div class="stat-number">@pendingCount</div>
                        <div class="stat-label">در انتظار</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-secondary">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #e9ecef; color: #6c757d;"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="stat-number">@paidCount</div>
                        <div class="stat-label">پرداخت شده</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- فیلترها -->
    <div class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold"><i class="bi bi-search text-muted me-1"></i> جستجو</label>
            <input type="text" class="form-control" placeholder="شماره، فرستنده، گیرنده، مرجع..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-tag text-muted me-1"></i> نوع حواله</label>
            <select class="form-select" @bind="filterHawalaType" @bind:event="oninput">
                <option value="">همه انواع</option>
                <option value="HawalaSend">حواله ارسال</option>
                <option value="HawalaReceive">حواله دریافت</option>
                <option value="HawalaOther">حواله متفرقه</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-circle text-muted me-1"></i> وضعیت</label>
            <select class="form-select" @bind="filterStatus" @bind:event="oninput">
                <option value="">همه وضعیت‌ها</option>
                <option value="Pending">در انتظار</option>
                <option value="Paid">پرداخت شده</option>
                <option value="Cancel">لغو شده</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-person text-muted me-1"></i> نماینده</label>
            <select class="form-select" @bind="filterCorrespondentId" @bind:event="oninput">
                <option value="0">همه نمایندگان</option>
                @foreach (var correspondent in correspondents)
                {
                    <option value="@correspondent.Id">@correspondent.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn-modern btn-primary-modern w-100" @onclick="ApplyFilters"><i class="bi bi-search"></i> فیلتر</button>
            <button class="btn-modern btn-light-modern w-100" @onclick="ResetFilters"><i class="bi bi-arrow-clockwise"></i> بازنشانی</button>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-info"><i class="bi bi-list-ul"></i> @filteredHawalas.Count</span>
            </div>
            <div class="table-card-header-right">
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th style="width:80px;" class="sortable-header" @onclick="@(() => SortBy("Number"))">
                                نمبر
                                @if (sortColumn == "Number")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("HawalaType"))">
                                نوع
                                @if (sortColumn == "HawalaType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("SenderName"))">
                                فرستنده
                                @if (sortColumn == "SenderName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("ReceiverName"))">
                                گیرنده
                                @if (sortColumn == "ReceiverName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("FromAmount"))">
                                مبلغ
                                @if (sortColumn == "FromAmount")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>کارمزد</th>
                            <th>نماینده</th>
                            <th class="sortable-header" @onclick="@(() => SortBy("Status"))">
                                وضعیت
                                @if (sortColumn == "Status")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center" style="width:80px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && filteredHawalas == null)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredHawalas.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ حواله‌ای یافت نشد</span>
                                        <p class="text-muted small">هیچ حواله‌ای در سیستم ثبت نشده است.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredHawalas.Count : pageSize) + 1;
                            @foreach (var hawala in filteredHawalas)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td><span class="fw-bold">@hawala.Number</span></td>
                                    <td>
                                        <span class="badge-modern @GetTypeBadge(hawala.HawalaType)">
                                            @hawala.HawalaTypeName
                                        </span>
                                    </td>
                                    <td><span class="fw-semibold">@(hawala.SenderName ?? "-")</span></td>
                                    <td><span class="fw-semibold">@(hawala.ReceiverName ?? "-")</span></td>
                                    <td dir="ltr" class="fw-bold text-primary">
                                        @hawala.FromAmount.ToString("N2") @hawala.FromCurrencyCode
                                    </td>
                                    <td dir="ltr">@hawala.CommissionAmount?.ToString("N2")</td>
                                    <td>@(hawala.CorrespondentName ?? "-")</td>
                                    <td>
                                        <span class="badge-modern @GetStatusBadge(hawala.Status)">
                                            @hawala.StatusName
                                        </span>
                                    </td>
                                    <td dir="ltr">@hawala.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-center operation-cell">
                                        <div class="operation-dropdown" @onclick:stopPropagation="true">
                                            <button type="button"
                                                    class="operation-dot-btn"
                                                    title="عملیات"
                                                    @onclick="() => ToggleOperationMenu(hawala.Id)">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>

                                            @if (openOperationMenuHawalaId == hawala.Id)
                                            {
                                                <div class="operation-menu" dir="rtl">
                                                    <button type="button"
                                                            class="operation-menu-item"
                                                            @onclick="async () => { CloseOperationMenu(); await ViewHawala(hawala.Id); }">
                                                        <i class="bi bi-eye text-info"></i>
                                                        مشاهده
                                                    </button>

                                                    <button type="button"
                                                            class="operation-menu-item"
                                                            @onclick="async () => { CloseOperationMenu(); await OpenReceipt(hawala.Id); }">
                                                        <i class="bi bi-receipt text-primary"></i>
                                                        رسید حواله
                                                    </button>

                                                    <button type="button"
                                                            class="operation-menu-item"
                                                            @onclick="async () => { CloseOperationMenu(); await CopyHawalaInfo(hawala.Id); }">
                                                        <i class="bi bi-clipboard text-secondary"></i>
                                                        کاپی معلومات
                                                    </button>

                                                    <button type="button"
                                                            class="operation-menu-item"
                                                            @onclick="async () => { CloseOperationMenu(); await ShareHawalaWhatsApp(hawala.Id); }">
                                                        <i class="bi bi-whatsapp text-success"></i>
                                                        ارسال واتساپ
                                                    </button>

                                                    <button type="button"
                                                            class="operation-menu-item"
                                                            @onclick="async () => { CloseOperationMenu(); await ShareHawalaTelegram(hawala.Id); }">
                                                        <i class="bi bi-telegram text-primary"></i>
                                                        ارسال تلگرام
                                                    </button>

                                                    @if (hawala.Status != "Paid" && hawala.Status != "Cancel")
                                                    {
                                                        <div class="operation-menu-divider"></div>

                                                        <button type="button"
                                                                class="operation-menu-item"
                                                                @onclick="async () => { CloseOperationMenu(); await OpenEditModal(hawala.Id); }">
                                                            <i class="bi bi-pencil text-warning"></i>
                                                            ویرایش
                                                        </button>
                                                    }

                                                    @if (hawala.Status == "Pending" && hawala.HawalaType == "HawalaReceive")
                                                    {
                                                        <button type="button"
                                                                class="operation-menu-item"
                                                                @onclick="() => { CloseOperationMenu(); OpenPayModal(hawala.Id, hawala.Number); }">
                                                            <i class="bi bi-check-circle text-success"></i>
                                                            پرداخت حواله
                                                        </button>
                                                    }

                                                    @if (hawala.Status == "Pending")
                                                    {
                                                        <button type="button"
                                                                class="operation-menu-item"
                                                                @onclick="() => { CloseOperationMenu(); ShowCancelConfirm(hawala.Id); }">
                                                            <i class="bi bi-x-circle text-danger"></i>
                                                            لغو حواله
                                                        </button>
                                                    }

                                                    @if (hawala.Status != "Paid")
                                                    {
                                                        <div class="operation-menu-divider"></div>

                                                        <button type="button"
                                                                class="operation-menu-item operation-menu-danger"
                                                                @onclick="() => { CloseOperationMenu(); ShowDeleteConfirm(hawala.Id); }">
                                                            <i class="bi bi-trash"></i>
                                                            حذف
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">نمایش <strong>@filteredHawalas.Count</strong> از <strong>@totalCount</strong> حواله</span>
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)"><i class="bi bi-chevron-left"></i></button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
            <div class="table-card-footer-right">
                <span class="badge-modern badge-success"><i class="bi bi-send"></i> ارسال: @hawalaSendCount</span>
                <span class="badge-modern badge-info"><i class="bi bi-download"></i> دریافت: @hawalaReceiveCount</span>
                <span class="badge-modern badge-warning"><i class="bi bi-asterisk"></i> متفرقه: @hawalaOtherCount</span>
                <span class="badge-modern badge-danger"><i class="bi bi-clock-history"></i> در انتظار: @pendingCount</span>
            </div>
        </div>
    </div>
</div>

@if (showReceiptModal && receiptHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-receipt me-2"></i>
                        رسید حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseReceipt"></button>
                </div>

                <div class="modal-body">
                    <div id="hawalaReceiptPrintArea">
                        <HawalaReceipt Hawala="receiptHawala"
                                       Company="companySetting" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseReceipt">
                        <i class="bi bi-x-circle"></i>
                        بستن
                    </button>

                    <button type="button"
                            class="btn-modern btn-secondary-modern"
                            @onclick="() => CopyHawalaInfo(receiptHawala.Id)">
                        <i class="bi bi-clipboard"></i>
                        کاپی
                    </button>

                    <button type="button"
                            class="btn-modern btn-success-modern"
                            @onclick="() => ShareHawalaWhatsApp(receiptHawala.Id)">
                        <i class="bi bi-whatsapp"></i>
                        واتساپ
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="() => ShareHawalaTelegram(receiptHawala.Id)">
                        <i class="bi bi-telegram"></i>
                        تلگرام
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="PrintReceipt">
                        <i class="bi bi-printer"></i>
                        چاپ
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@if (showPayModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-check-circle me-2"></i>
                        پرداخت حواله دریافتی
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="ClosePayModal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info">
                        شما در حال پرداخت حواله نمبر
                        <strong>@payHawalaNumber</strong>
                        هستید.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            حساب پرداخت‌کننده <span class="text-danger">*</span>
                        </label>

                        <select class="form-select" @bind="selectedPaymentAccountId">
                            <option value="0">انتخاب حساب پرداخت‌کننده</option>

                            @foreach (var account in paymentAccountsForHawalaReceive)
                            {
                                <option value="@account.Id">
                                    @account.AccountName (@account.AccountCode - @GetAccountTypeName(account.AccountType))
                                </option>
                            }
                        </select>

                        <small class="text-muted">
                            این حساب می‌تواند Cash، Bank یا Customer باشد.
                        </small>
                    </div>

                    <div class="alert alert-warning mb-0">
                        <strong>سند حسابداری پرداخت:</strong>
                        <div class="mt-2" dir="ltr">
                            Pending Hawala Account: BadehKar |
                            Selected Payment Account: TalabKar
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="ClosePayModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="ConfirmPayHawala"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }

                        تأیید پرداخت
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<!-- ============================================================ -->
<!-- مودال ایجاد/ویرایش حواله (اصلاح‌شده) -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش حواله" : "ایجاد حواله جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات حواله -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary"><i class="bi bi-arrow-left-right me-2"></i> اطلاعات حواله</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- نوع حواله -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">نوع حواله <span class="text-danger">*</span></label>
                                    <select class="form-select"
                                            value="@currentHawala.HawalaType"
                                            @onchange="(ChangeEventArgs e) => { currentHawala.HawalaType = e.Value?.ToString() ?? string.Empty; OnHawalaTypeChanged(e); }">
                                        <option value="">انتخاب نوع</option>
                                        <option value="HawalaSend">حواله ارسال</option>
                                        <option value="HawalaReceive">حواله دریافت</option>
                                        <option value="HawalaOther">حواله متفرقه</option>
                                    </select>
                                </div>
                                <!-- نماینده (اصلاح‌شده: بدون @bind، استفاده از value و @onchange) -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold"> نماینده <span class="text-danger">*</span></label>
                                    <select class="form-select"
                                            value="@currentHawala.CorrespondentId"
                                            @onchange="(ChangeEventArgs e) => {
                                            currentHawala.CorrespondentId = long.TryParse(e.Value?.ToString(), out long id) ? id : null;
                                            OnCorrespondentChanged(e);
                                        }">
                                    <option value="">انتخاب نماینده</option>
                                    @foreach (var correspondent in correspondents)
                                    {
                                        <option value="@correspondent.Id">@correspondent.Name (@correspondent.Code)</option>
                                    }
                                </select>
                            </div>
                            <!-- محل پرداخت -->
                            <!-- در بخش اطلاعات حواله -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-geo-alt text-muted me-1"></i> محل پرداخت
                                    @if (currentHawala.HawalaType == "HawalaSend")
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <select class="form-select" @bind="currentHawala.PaymentLocationId">
                                    <option value="">انتخاب محل پرداخت</option>
                                    @foreach (var location in paymentLocations)
                                    {
                                        <option value="@location.Id">@location.Name - @location.Address</option>
                                    }
                                </select>
                                @if (currentHawala.HawalaType == "HawalaSend")
                                {
                                    <small class="text-muted">محلی که گیرنده می‌تواند پول را دریافت کند.</small>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <!-- وضعیت -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-person text-muted me-1"></i> وضعیت
                                </label>
                                <select class="form-select" @bind="currentHawala.Status">
                                    <option value="Pending">در انتظار</option>
                                    <option value="Paid">پرداخت شده</option>
                                </select>
                            </div>
                            <!-- شماره مرجع -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-hash text-muted me-1"></i> شماره مرجع
                                </label>
                                <input type="text" class="form-control" @bind="currentHawala.ReferenceNumber" placeholder="شماره مرجع" />
                            </div>
                            <!-- ===== فیلد شماره (نمبر) اصلاح‌شده با long? ===== -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-hash text-muted me-1"></i> نمبر حواله

                                </label>
                                @if (isEditMode)
                                {
                                    <!-- در حالت ویرایش: غیرفعال و فقط نمایشی -->
                                    <input type="number" class="form-control bg-light" value="@currentHawala.Number" />
                                    <small class="text-muted">شماره قابل ویرایش نیست</small>
                                }
                                else
                                {
                                    <!-- در حالت ایجاد: قابل ویرایش، با مقدار پیش‌نمایش -->
                                    <input type="number" class="form-control" @bind="currentHawala.Number" />

                                }
                            </div>
                        </div>

                        <hr />
                        <h6 class="text-primary mb-3"><i class="bi bi-person"></i> اطلاعات فرستنده</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">نام فرستنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.SenderName" placeholder="نام فرستنده" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">نام پدر فرستنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.SenderFatherName" placeholder="نام پدر" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">تلفن فرستنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.SenderPhone" placeholder="تلفن" />
                            </div>
                        </div>
                        <div class="row">
                            <!-- ستون اول: شماره تذکره -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-card-text text-muted me-1"></i> شماره تذکره فرستنده
                                </label>
                                <input type="text" class="form-control" @bind="currentHawala.SenderTazkiraNumber" placeholder="شماره تذکره" />
                            </div>

                            <!-- ستون دوم: آپلود عکس تذکره -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-image text-muted me-1"></i> عکس تذکره فرستنده (اختیاری)
                                </label>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <InputFile class="form-control" style="flex:1;" OnChange="OnSenderTazkiraUpload" accept="image/*" />
                                    @if (!string.IsNullOrEmpty(currentHawala.SenderTazkiraImagePath))
                                    {
                                        <a href="@currentHawala.SenderTazkiraImagePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="RemoveSenderTazkira">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                                <small class="text-muted">فرمت‌های مجاز: jpg, png, jpeg (حداکثر ۱۰ مگابایت)</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">آدرس گیرنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverAddress" placeholder="آدرس" />
                            </div>
                        </div>

                        <hr />
                        <h6 class="text-primary mb-3"><i class="bi bi-person"></i> اطلاعات گیرنده</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">نام گیرنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverName" placeholder="نام گیرنده" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">نام پدر گیرنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverFatherName" placeholder="نام پدر" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">تلفن گیرنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverPhone" placeholder="تلفن" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-card-text text-muted me-1"></i> شماره تذکره گیرنده
                                </label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverTazkiraNumber" placeholder="شماره تذکره" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-image text-muted me-1"></i> عکس تذکره گیرنده (اختیاری)
                                </label>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <InputFile class="form-control" style="flex:1;" OnChange="OnReceiverTazkiraUpload" accept="image/*" />
                                    @if (!string.IsNullOrEmpty(currentHawala.ReceiverTazkiraImagePath))
                                    {
                                        <a href="@currentHawala.ReceiverTazkiraImagePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="RemoveReceiverTazkira">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                                <small class="text-muted">فرمت‌های مجاز: jpg, png, jpeg (حداکثر ۱۰ مگابایت)</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">آدرس گیرنده</label>
                                <input type="text" class="form-control" @bind="currentHawala.ReceiverAddress" placeholder="آدرس" />
                            </div>
                        </div>

                        <hr />
                        <h6 class="text-primary mb-3"><i class="bi bi-currency-exchange"></i> اطلاعات مالی</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-arrow-right text-muted me-1"></i> نوع ارز ارسالی <span class="text-danger">*</span>
                                </label>
                                <select class="form-select"
                                        value="@currentHawala.FromCurrencyId"
                                        @onchange="OnFromCurrencyChanged">
                                    <option value="0">انتخاب ارز</option>
                                    @foreach (var currency in currencies)
                                    {
                                        <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-calculator text-muted me-1"></i> روش محاسبه
                                    </label>

                                    <div class="d-flex gap-4 flex-wrap">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="calculationMode"
                                                   id="calcByRate"
                                                   value="RateToAmount"
                                                   checked="@(calculationMode == "RateToAmount")"
                                                   @onchange="OnCalculationModeChanged" />
                                            <label class="form-check-label" for="calcByRate">
                                                نرخ را وارد می‌کنم، مبلغ مقصد محاسبه شود
                                            </label>
                                        </div>

                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="calculationMode"
                                                   id="calcByAmount"
                                                   value="AmountToRate"
                                                   checked="@(calculationMode == "AmountToRate")"
                                                   @onchange="OnCalculationModeChanged" />
                                            <label class="form-check-label" for="calcByAmount">
                                                مبلغ مقصد را وارد می‌کنم، نرخ محاسبه شود
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cash-stack text-muted me-1"></i> مبلغ حواله <span class="text-danger">*</span>
                                </label>
                                <input type="number"
                                       step="0.01"
                                       class="form-control"
                                       value="@currentHawala.FromAmount"
                                       @oninput="OnFromAmountChanged"
                                       placeholder="مبلغ" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-arrow-left text-muted me-1"></i> نوع ارز دریافتی <span class="text-danger">*</span>
                                </label>
                                <select class="form-select"
                                        value="@currentHawala.ToCurrencyId"
                                        @onchange="OnToCurrencyChanged">
                                    <option value="0">انتخاب ارز</option>
                                    @foreach (var currency in currencies)
                                    {
                                        <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-cash-stack text-muted me-1"></i> مبلغ دریافتی
                                </label>
                                <input type="number"
                                       step="0.01"
                                       class="form-control"
                                       value="@currentHawala.ToAmount"
                                       @oninput="OnToAmountChanged"
                                       disabled="@(calculationMode == "RateToAmount" || AreCurrenciesSame())"
                                       placeholder="مبلغ مقصد" />
                                @if (AreCurrenciesSame())
                                {
                                    <small class="text-muted text-success">ارزها یکسان هستند، مبلغ برابر با مبلغ حواله است</small>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-arrow-left-right text-muted me-1"></i> نرخ تبدیل
                                </label>
                                <input type="number"
                                       step="0.0001"
                                       class="form-control"
                                       value="@currentHawala.ExchangeRate"
                                       @oninput="OnExchangeRateChanged"
                                       disabled="@(calculationMode == "AmountToRate" || AreCurrenciesSame())"
                                       placeholder="نرخ تبدیل" />
                                @if (AreCurrenciesSame())
                                {
                                    <small class="text-muted text-success">ارزها یکسان هستند، نرخ برابر ۱ است</small>
                                }
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-percent text-muted me-1"></i> کارمزد
                                </label>
                                <input type="number" step="0.01" class="form-control" @bind="currentHawala.CommissionAmount" placeholder="کارمزد" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-coin text-muted me-1"></i> ارز کارمزد
                                </label>
                                <select class="form-select" @bind="currentHawala.CommissionCurrencyId">
                                    <option value="0">انتخاب ارز</option>
                                    @foreach (var currency in currencies)
                                    {
                                        <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-percent text-muted me-1"></i> کارمزد نماینده
                                </label>
                                <input type="number" step="0.01" class="form-control" @bind="currentHawala.AgentCommissionAmount" placeholder="کارمزد نماینده" />
                            </div>
                        </div>

                        <!-- انتخاب حساب مبدأ (فقط برای حواله ارسالی) -->
                        @if (currentHawala.HawalaType == "HawalaSend")
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-wallet2 text-muted me-1"></i> حساب مبدأ (بدهکار) <span class="text-danger">*</span>
                                    </label>
                                    <div class="searchable-dropdown">
                                        <div class="searchable-dropdown-input"
                                             @onclick="() => showFromAccountDropdown = true">
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="جستجوی حساب مبدأ..."
                                                   value="@GetSelectedFromAccountText()"
                                                   @oninput="OnFromAccountSearchChanged"
                                                   @onfocus="() => showFromAccountDropdown = true" />
                                        </div>

                                        @if (showFromAccountDropdown)
                                        {
                                            <div class="searchable-dropdown-menu">
                                                @if (!FilteredFromAccounts.Any())
                                                {
                                                    <div class="searchable-dropdown-item text-muted">
                                                        حسابی یافت نشد
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var account in FilteredFromAccounts.Take(30))
                                                    {
                                                        <div class="searchable-dropdown-item"
                                                             @onclick="() => SelectFromAccount(account)">
                                                            <div class="fw-bold">
                                                                @account.AccountName
                                                            </div>
                                                            <small class="text-muted">
                                                                @account.AccountCode - @GetAccountTypeName(account.AccountType)
                                                            </small>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted">این حساب به مبلغ حواله و کارمزد بدهکار می‌شود.</small>
                                </div>
                            </div>
                        }

                        <!-- انتخاب حساب پرداخت‌کننده (فقط برای حواله دریافتی) -->
                        @if (currentHawala.HawalaType == "HawalaReceive" && currentHawala.Status == "Paid")
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-wallet2 text-muted me-1"></i> حساب پرداخت‌کننده  <span class="text-danger">*</span>
                                    </label>
                                    <div class="searchable-dropdown">
                                        <div class="searchable-dropdown-input"
                                             @onclick="() => showFromAccountDropdown = true">
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="جستجوی حساب مبدأ..."
                                                   value="@GetSelectedFromAccountText()"
                                                   @oninput="OnFromAccountSearchChanged"
                                                   @onfocus="() => showFromAccountDropdown = true" />
                                        </div>

                                        @if (showFromAccountDropdown)
                                        {
                                            <div class="searchable-dropdown-menu">
                                                @if (!FilteredFromAccounts.Any())
                                                {
                                                    <div class="searchable-dropdown-item text-muted">
                                                        حسابی یافت نشد
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var account in FilteredFromAccounts.Take(30))
                                                    {
                                                        <div class="searchable-dropdown-item"
                                                             @onclick="() => SelectFromAccount(account)">
                                                            <div class="fw-bold">
                                                                @account.AccountName
                                                            </div>
                                                            <small class="text-muted">
                                                                @account.AccountCode - @GetAccountTypeName(account.AccountType)
                                                            </small>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted">این حساب به مبلغ حواله بدهکار می‌شود.</small>
                                </div>
                            </div>
                        }

                        <!-- یادداشت‌ها -->
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-chat text-muted me-1"></i> یادداشت‌ها</label>
                                <textarea class="form-control" @bind="currentHawala.Notes" rows="2" placeholder="یادداشت‌های اضافی"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                @if (isEditMode)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <small>در حال ویرایش حواله با شناسه: <strong>@editId</strong></small>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                    <i class="bi bi-x-circle"></i> انصراف
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveHawala()" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-save"></i>
                    }
                    @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                </button>
            </div>
        </div>
    </div>
</div>
    }

<!-- ============================================================ -->
<!-- مودال نمایش جزئیات حواله -->
<!-- ============================================================ -->
@if (showDetailModal && selectedHawala != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i> جزئیات حواله
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- اطلاعات خلاصه -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نوع</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetTypeBadge(selectedHawala.HawalaType)">
                                        @selectedHawala.HawalaTypeName
                                    </span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">شماره (نمبر)</span>
                                <span class="info-value fw-bold">@selectedHawala.Number</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetStatusBadge(selectedHawala.Status)">
                                        @selectedHawala.StatusName
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- اطلاعات فرستنده و گیرنده -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">فرستنده</span>
                                <span class="info-value">@(selectedHawala.SenderName ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">نام پدر فرستنده</span>
                                <span class="info-value">@(selectedHawala.SenderFatherName ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">تلفن فرستنده</span>
                                <span class="info-value">@(selectedHawala.SenderPhone ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">گیرنده</span>
                                <span class="info-value">@(selectedHawala.ReceiverName ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
