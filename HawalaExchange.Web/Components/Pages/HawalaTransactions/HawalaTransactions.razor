                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseCancelModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmCancel()">
                        <i class="bi bi-check-circle"></i> تأیید لغو
                    </button>
                </div>
            </div>
        </div>
    </div>
}

