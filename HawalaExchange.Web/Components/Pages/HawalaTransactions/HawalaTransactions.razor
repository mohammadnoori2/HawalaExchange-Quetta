                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var company = await CompanySettingService.GetAsync();

            var text = HawalaShareHelper.BuildText(hawala, company);

            // Telegram native app deep link.
            // This should open Telegram Desktop/App if installed.
            var receiptUrl = NavigationManager.BaseUri.TrimEnd('/');

            var telegramAppUrl =
                "tg://msg_url" +
                "?url=" + Uri.EscapeDataString(receiptUrl) +
