                                   @onchange="() => cancelIncludesCommission = true" />
                            <span><strong>لغو با کارمزد</strong><br /><small class="text-muted">مبلغ حواله و تمام کارمزدها در لیجر معکوس می‌شوند.</small></span>
                        </label>
                        <label class="border rounded p-3 d-flex gap-2 align-items-start">
                            <input type="radio" name="cancelModeAll" checked="@(!cancelIncludesCommission)"
                                   @onchange="() => cancelIncludesCommission = false" />
                            <span><strong>لغو بدون کارمزد</strong><br /><small class="text-muted">فقط مبلغ حواله معکوس می‌شود و کارمزدهای ثبت‌شده باقی می‌مانند.</small></span>
                        </label>
                    </div>
                    <p class="fs-6">دلیل لغو حواله را وارد کنید:</p>
                    <textarea class="form-control" @bind="cancelReason" rows="3" placeholder="دلیل لغو ..."></textarea>
