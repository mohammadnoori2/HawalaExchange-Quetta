            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var company = await CompanySettingService.GetAsync();

            var text = HawalaShareHelper.BuildText(hawala, company);

            var url = "https://wa.me/?text=" + Uri.EscapeDataString(text);

            await JS.InvokeVoidAsync("hawalaTools.openShareUrl", url);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ارسال واتساپ: {ex.Message}");
