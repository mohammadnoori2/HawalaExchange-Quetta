@code {
    // ===== لیست‌ها =====
    private List<HawalaDto> filteredHawalas = new();
    private List<CorrespondentDto> correspondents = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();
    private List<PaymentLocationDto> paymentLocations = new();

    // ===== فیلترها =====
    private string searchTerm = "";
    private string filterHawalaType = "";
    private string filterStatus = "";
    private long filterCorrespondentId = 0;
    private long filterPaymentLocationId = 0;
    private long filterCurrencyId = 0;
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private DateTime filterFromDate = DateTime.MinValue;
    private DateTime filterToDate = DateTime.MinValue;
    private string filterValidationError = string.Empty;
    private CancellationTokenSource? filterChangeCts;

    // ===== صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
