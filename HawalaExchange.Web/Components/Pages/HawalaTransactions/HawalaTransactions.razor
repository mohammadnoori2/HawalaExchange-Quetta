@page "/hawala-transactions"
@using Microsoft.JSInterop
@using HawalaExchange.Web.Helpers
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Components.Shared.Modals
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@using HawalaExchange.Application.Services
@using HawalaExchange.Domain.Entities
@inject IJSRuntime JS
@inject ICompanySettingService CompanySettingService
@inject IHawalaService HawalaService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject IPaymentLocationService PaymentLocationService
@inject IWebHostEnvironment WebHostEnvironment
@inject IFileService FileService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-arrow-left-right"></i>
                مدیریت حواله‌ها
                <span class="page-subtitle">لیست و جستجوی حواله‌ها</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> حواله جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <div class="stat-number">@totalCount</div>
                        <div class="stat-label">تعداد کل</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success"><i class="bi bi-send"></i></div>
                    <div>
                        <div class="stat-number">@hawalaSendCount</div>
                        <div class="stat-label">حواله ارسال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info"><i class="bi bi-download"></i></div>
                    <div>
                        <div class="stat-number">@hawalaReceiveCount</div>
                        <div class="stat-label">حواله دریافت</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning"><i class="bi bi-asterisk"></i></div>
                    <div>
                        <div class="stat-number">@hawalaOtherCount</div>
                        <div class="stat-label">حواله متفرقه</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <div class="stat-number">@pendingCount</div>
                        <div class="stat-label">حواله‌های اجرا نشده</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card stat-card-secondary">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background: #e9ecef; color: #6c757d;"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="stat-number">@paidCount</div>
                        <div class="stat-label">پرداخت شده</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- فیلترها -->
    <div class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold"><i class="bi bi-search text-muted me-1"></i> جستجو</label>
            <input type="text" class="form-control" placeholder="نمبر، مبلغ، فرستنده، گیرنده، نمبر متفرقه..." @bind="searchTerm" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-tag text-muted me-1"></i> نوع حواله</label>
            <select class="form-select" @bind="filterHawalaType" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                <option value="">همه انواع</option>
                <option value="HawalaSend">حواله ارسال</option>
                <option value="HawalaReceive">حواله دریافت</option>
                <option value="HawalaOther">حواله متفرقه</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-circle text-muted me-1"></i> وضعیت</label>
            <select class="form-select" @bind="filterStatus" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                <option value="">همه وضعیت‌ها</option>
                <option value="Pending">@(filterHawalaType == "HawalaReceive" ? "حواله‌های اجرا نشده" : "در انتظار")</option>
                <option value="Paid">پرداخت شده</option>
                <option value="Cancel">لغو شده</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-person text-muted me-1"></i> نماینده</label>
            <select class="form-select" @bind="filterCorrespondentId" @bind:event="oninput" @bind:after="OnFilterChangedAsync">
                <option value="0">همه نمایندگان</option>
                @foreach (var correspondent in correspondents)
                {
                    <option value="@correspondent.Id">@correspondent.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold"><i class="bi bi-geo-alt text-muted me-1"></i> محل پرداخت</label>
            <select class="form-select" @bind="filterPaymentLocationId" @bind:after="OnFilterChangedAsync">
                <option value="0">همه محل‌ها</option>
                @foreach (var location in paymentLocations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-coin text-muted me-1"></i> ارز مبلغ</label>
            <select class="form-select" @bind="filterCurrencyId" @bind:after="OnFilterChangedAsync">
                <option value="0">همه ارزها</option>
                @foreach (var currency in currencies)
                {
                    <option value="@currency.Id">@currency.Code - @currency.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-cash text-muted me-1"></i> حداقل مبلغ</label>
            <NullableMoneyInput class="form-control" @bind-Value="filterMinAmount" @bind-Value:after="OnFilterChangedAsync" placeholder="از مبلغ" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-cash-stack text-muted me-1"></i> حداکثر مبلغ</label>
            <NullableMoneyInput class="form-control" @bind-Value="filterMaxAmount" @bind-Value:after="OnFilterChangedAsync" placeholder="تا مبلغ" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-calendar-event text-muted me-1"></i> از تاریخ ثبت</label>
            <PersianDatePicker @bind-Value="filterFromDate" @bind-Value:after="OnFilterChangedAsync" AllowEmpty="true" Placeholder="انتخاب تاریخ" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-calendar-check text-muted me-1"></i> تا تاریخ ثبت</label>
            <PersianDatePicker @bind-Value="filterToDate" @bind-Value:after="OnFilterChangedAsync" AllowEmpty="true" Placeholder="انتخاب تاریخ" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn-modern btn-light-modern w-100" @onclick="ResetFilters"><i class="bi bi-arrow-clockwise"></i> بازنشانی</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(filterValidationError))
    {
        <div class="alert alert-danger py-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @filterValidationError
        </div>
    }

    <!-- کارت جدول -->
    <div class="table-card hawala-list-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-info"><i class="bi bi-list-ul"></i> @filteredHawalas.Count</span>
            </div>
            <div class="table-card-header-right">
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th style="width:80px;" class="sortable-header" @onclick="@(() => SortBy("Number"))">
                                نمبر
                                @if (sortColumn == "Number")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("HawalaType"))">
                                نوع
                                @if (sortColumn == "HawalaType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("SenderName"))">
                                فرستنده
                                @if (sortColumn == "SenderName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("ReceiverName"))">
                                گیرنده
                                @if (sortColumn == "ReceiverName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("FromAmount"))">
                                مبلغ
                                @if (sortColumn == "FromAmount")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>کارمزد حواله</th>
                            <th>کارمزد نمایندگی</th>
                            <th>محل پرداخت</th>
                            <th>نماینده</th>
                            <th class="sortable-header" @onclick="@(() => SortBy("Status"))">
                                وضعیت
                                @if (sortColumn == "Status")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center" style="width:80px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && filteredHawalas == null)
                        {
                            <tr>
                                <td colspan="13" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!filteredHawalas.Any())
                        {
                            <tr>
                                <td colspan="13" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ حواله‌ای یافت نشد</span>
                                        <p class="text-muted small">هیچ حواله‌ای در سیستم ثبت نشده است.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredHawalas.Count : pageSize) + 1;
                            @foreach (var hawala in filteredHawalas)
                            {
                                <tr class="@(hawala.SettlementState == "Pending" ? "table-danger" : hawala.SettlementState == "Converted" ? "table-success" : null)">
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td><span class="fw-bold">@hawala.Number</span></td>
                                    <td>
                                        <span class="badge-modern @GetTypeBadge(hawala.HawalaType)">
                                            @hawala.HawalaTypeName
                                        </span>
                                    </td>
                                    <td><span class="fw-semibold">@(hawala.SenderName ?? "-")</span></td>
                                    <td><span class="fw-semibold">@(hawala.ReceiverName ?? "-")</span></td>
                                    <td dir="ltr" class="fw-bold text-primary">
                                        @MoneyFormatHelper.Format(hawala.FromAmount) @hawala.FromCurrencyCode
                                    </td>
                                    <td dir="ltr">
                                        @(hawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.CommissionAmount.Value) : "-")
                                        @hawala.CommissionCurrencyCode
                                    </td>
                                    <td dir="ltr">
                                        @(hawala.AgentCommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.AgentCommissionAmount.Value) : "-")
                                        @hawala.AgentCommissionCurrencyCode
                                    </td>
                                    <td>@(hawala.PaymentLocationName ?? "-")</td>
                                    <td>@(hawala.CorrespondentName ?? "-")</td>
                                    <td>
                                        <span class="badge-modern @GetStatusBadge(hawala.Status)">
                                            @hawala.StatusName
                                        </span>
                                    </td>
                                    <td dir="ltr">@PersianDateHelper.ToPersianDateTime12(hawala.CreatedAt)</td>
                                    <td class="text-center operation-cell">
                                        <HawalaOperationMenu Hawala="hawala"
                                                             ShowEdit="true"
                                                             ShowPay="true"
                                                             ShowCancel="true"
                                                             ShowDelete="true"
                                                             OnView="ViewHawala"
                                                             OnReceipt="OpenReceipt"
                                                             OnCopy="CopyHawalaInfo"
                                                             OnWhatsApp="ShareHawalaWhatsApp"
                                                             OnTelegram="ShareHawalaTelegram"
                                                             OnEdit="OpenEditModal"
                                                             OnPay="OpenPayFromMenu"
                                                             OnCancel="ShowCancelConfirm"
                                                             OnDelete="ShowDeleteConfirm" />
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">نمایش <strong>@filteredHawalas.Count</strong> از <strong>@totalCount</strong> حواله</span>
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)"><i class="bi bi-chevron-left"></i></button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== مودال رسید حواله ===== -->
@if (showReceiptModal && receiptHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-receipt me-2"></i>
                        رسید حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseReceipt"></button>
                </div>

                <div class="modal-body">
                    <div id="hawalaReceiptPrintArea">
                        <HawalaReceipt Hawala="receiptHawala"
                                       Company="companySetting" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseReceipt">
                        <i class="bi bi-x-circle"></i>
                        بستن
                    </button>

                    <button type="button"
                            class="btn-modern btn-secondary-modern"
                            @onclick="() => CopyHawalaInfo(receiptHawala.Id)">
                        <i class="bi bi-clipboard"></i>
                        کاپی
                    </button>

                    <button type="button"
                            class="btn-modern btn-success-modern"
                            @onclick="() => ShareHawalaWhatsApp(receiptHawala.Id)">
                        <i class="bi bi-whatsapp"></i>
                        واتساپ
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="() => ShareHawalaTelegram(receiptHawala.Id)">
                        <i class="bi bi-telegram"></i>
                        تلگرام
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="PrintReceipt">
                        <i class="bi bi-printer"></i>
                        چاپ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ===== مودال پرداخت حواله ===== -->
@if (showPayModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-check-circle me-2"></i>
                        پرداخت حواله دریافتی
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="ClosePayModal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info">
                        شما در حال پرداخت حواله نمبر
                        <strong>@payHawalaNumber</strong>
                        هستید.
                    </div>

                    <ReceiverPaymentFields Model="payDetails" Customers="customers" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            حساب پرداخت‌کننده <span class="text-danger">*</span>
                        </label>

                        <AccountSearchSelect Accounts="@paymentAccountsForHawalaReceive"
                                             @bind-Value="selectedPaymentAccountId"
                                             Placeholder="جستجوی حساب پرداخت‌کننده..." />

                        <small class="text-muted">
                            این حساب می‌تواند Cash، Bank یا Customer باشد.
                        </small>
                    </div>

                    <div class="alert alert-warning mb-0">
                        <strong>سند حسابداری پرداخت:</strong>
                        <div class="mt-2" dir="ltr">
                            Pending Hawala Account: BadehKar |
                            Selected Payment Account: TalabKar
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="ClosePayModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="ConfirmPayHawala"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }

                        تأیید پرداخت
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ===== کامپوننت مودال ایجاد/ویرایش حواله ===== -->
<CreateHawalaModal IsVisible="@showModal"
                   IsVisibleChanged="@((bool value) => { showModal = value; StateHasChanged(); })"
                   IsEditMode="@isEditMode"
                   EditId="@editId"
                   EditData="@editHawalaData"
                   OnSaveSuccess="@OnHawalaSaved"
                   OnEditSuccess="@OnHawalaEdited" />

<!-- ===== مودال نمایش جزئیات حواله ===== -->
@if (showDetailModal && selectedHawala != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i> جزئیات حواله
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- اطلاعات خلاصه -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نوع</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetTypeBadge(selectedHawala.HawalaType)">
                                        @selectedHawala.HawalaTypeName
                                    </span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">شماره (نمبر)</span>
                                <span class="info-value fw-bold">@selectedHawala.Number</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetStatusBadge(selectedHawala.Status)">
                                        @selectedHawala.StatusName
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- اطلاعات فرستنده و گیرنده -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="info-card">
