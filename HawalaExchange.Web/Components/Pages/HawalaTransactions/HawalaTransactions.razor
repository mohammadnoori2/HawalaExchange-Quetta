@code {
    // ===== لیست‌ها =====
    private List<HawalaDto> filteredHawalas = new();
    private List<CorrespondentDto> correspondents = new();
    private List<CurrencyDto> currencies = new();
    private List<AccountDto> accounts = new();

    // ===== فیلترها =====
    private string searchTerm = "";
    private string filterHawalaType = "";
    private string filterStatus = "";
    private long filterCorrespondentId = 0;

    // ===== صفحه‌بندی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    // ===== آمار =====
    private int totalCount = 0;
    private int totalPages = 1;
    private int hawalaSendCount = 0;
    private int hawalaReceiveCount = 0;
    private int hawalaOtherCount = 0;
    private int pendingCount = 0;
    private int paidCount = 0;

    // ===== مودال‌ها =====
    private bool showModal = false;
    private bool showDetailModal = false;
    private bool showCancelModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long cancelId = 0;
    private long deleteId = 0;
    private string cancelReason = "";

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private HawalaDto? selectedHawala = null;
    private CreateHawalaDto currentHawala = new();

    private string accountSearchText = "";

    private IEnumerable<AccountDto> FilteredAccounts =>
        string.IsNullOrWhiteSpace(accountSearchText)
            ? accounts
            : accounts.Where(a =>
                (a.AccountName != null && a.AccountName.Contains(accountSearchText, StringComparison.OrdinalIgnoreCase)) ||
                (a.AccountCode != null && a.AccountCode.Contains(accountSearchText, StringComparison.OrdinalIgnoreCase)) ||
                (a.AccountType != null && a.AccountType.Contains(accountSearchText, StringComparison.OrdinalIgnoreCase)));

    // ===== متدهای بارگذاری =====

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadAccounts();
        await LoadHawalas();
    }

    private async Task LoadLookupData()
    {
        try
        {
            correspondents = (await CorrespondentService.GetAllAsync()).ToList();
            currencies = (await CurrencyService.GetActiveCurrenciesAsync()).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            accounts = result.Where(a => !a.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    private async Task LoadHawalas()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var filter = new HawalaFilterDto
            {
                SearchTerm = string.IsNullOrEmpty(searchTerm) ? null : searchTerm,
                HawalaType = string.IsNullOrEmpty(filterHawalaType) ? null : filterHawalaType,
                Status = string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                CorrespondentId = filterCorrespondentId == 0 ? null : filterCorrespondentId,
                PageNumber = currentPage,
                PageSize = pageSize == 0 ? int.MaxValue : pageSize,
                SortColumn = sortColumn,
                SortDirection = sortAscending ? "asc" : "desc"
            };

            var result = await HawalaService.GetHawalasAsync(filter);

            filteredHawalas = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;

            var stats = await HawalaService.GetStatisticsAsync();
            hawalaSendCount = stats.HawalaSendCount;
            hawalaReceiveCount = stats.HawalaReceiveCount;
            hawalaOtherCount = stats.HawalaOtherCount;
            pendingCount = stats.PendingCount;
            paidCount = stats.PaidCount;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ===== متدهای فیلتر و صفحه‌بندی =====

    private void ApplyFilters()
    {
        currentPage = 1;
        _ = LoadHawalas();
    }

    private void ResetFilters()
    {
        searchTerm = "";
        filterHawalaType = "";
        filterStatus = "";
        filterCorrespondentId = 0;
        currentPage = 1;
        _ = LoadHawalas();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            _ = LoadHawalas();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        _ = LoadHawalas();
    }

    // ===== متدهای مودال =====

    private void OpenCreateModal()
    {
        currentHawala = new CreateHawalaDto
        {
            Status = "Pending",
            FromCurrencyId = 0,
            ToCurrencyId = 0,
            HawalaType = ""
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var hawala = await HawalaService.GetHawalaByIdAsync(id);
            if (hawala != null)
            {
                currentHawala = new CreateHawalaDto
                {
                    HawalaType = hawala.HawalaType,
                    CorrespondentId = hawala.CorrespondentId,
                    SenderName = hawala.SenderName,
                    SenderFatherName = hawala.SenderFatherName,
                    SenderPhone = hawala.SenderPhone,
                    SenderTazkiraNumber = hawala.SenderTazkiraNumber,
                    SenderAddress = hawala.SenderAddress,
                    ReceiverName = hawala.ReceiverName,
                    ReceiverFatherName = hawala.ReceiverFatherName,
                    ReceiverPhone = hawala.ReceiverPhone,
                    ReceiverTazkiraNumber = hawala.ReceiverTazkiraNumber,
                    ReceiverAddress = hawala.ReceiverAddress,
                    FromCurrencyId = hawala.FromCurrencyId,
                    FromAmount = hawala.FromAmount,
                    ToCurrencyId = hawala.ToCurrencyId,
                    ToAmount = hawala.ToAmount,
                    ExchangeRate = hawala.ExchangeRate,
                    CommissionAmount = hawala.CommissionAmount,
                    CommissionCurrencyId = hawala.CommissionCurrencyId,
                    AgentCommissionAmount = hawala.AgentCommissionAmount,
                    AgentCommissionCurrencyId = hawala.AgentCommissionCurrencyId,
                    ReferenceNumber = hawala.ReferenceNumber,
                    Notes = hawala.Notes,
                    Status = hawala.Status,
                    PaymentLocation = hawala.PaymentLocation,
                    FromAccountId = null // در ویرایش نمی‌توانیم حساب مبدأ را تغییر دهیم (یا می‌توانیم، اما اینجا خالی می‌گذاریم)
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewHawala(long id)
    {
        try
        {
            selectedHawala = await HawalaService.GetHawalaByIdAsync(id);
            showDetailModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedHawala = null;
        StateHasChanged();
    }

    private void ShowCancelConfirm(long id)
    {
        cancelId = id;
        cancelReason = "";
        showCancelModal = true;
        StateHasChanged();
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        cancelReason = "";
        StateHasChanged();
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    // ===== متدهای عملیاتی =====

    private async Task MarkAsPaid(long id)
    {
        try
        {
            await HawalaService.MarkAsPaidAsync(id);
            successMessage = "حواله با موفقیت پرداخت شد.";
            await LoadHawalas();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در پرداخت: {ex.Message}");
        }
    }

    private async Task ConfirmCancel()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(cancelReason))
            {
                validationErrors.Add("لطفاً دلیل لغو را وارد کنید.");
                StateHasChanged();
                return;
            }

            await HawalaService.CancelHawalaAsync(cancelId, cancelReason);
            successMessage = "حواله با موفقیت لغو شد.";
            showCancelModal = false;
            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در لغو: {ex.Message}");
            showCancelModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SaveHawala()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        // اعتبارسنجی
        if (string.IsNullOrEmpty(currentHawala.HawalaType))
            validationErrors.Add("نوع حواله الزامی است.");
        if (currentHawala.FromCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مبدأ الزامی است.");
        if (currentHawala.FromAmount <= 0)
            validationErrors.Add("مبلغ باید بزرگتر از صفر باشد.");
        if (currentHawala.ToCurrencyId == 0)
            validationErrors.Add("انتخاب ارز مقصد الزامی است.");
        if (currentHawala.HawalaType == "HawalaSend" && currentHawala.CorrespondentId == null)
            validationErrors.Add("برای حواله ارسال، انتخاب نماینده مقصد الزامی است.");
        if (currentHawala.HawalaType == "HawalaReceive" && currentHawala.CorrespondentId == null)
            validationErrors.Add("برای حواله دریافت، انتخاب نماینده فرستنده الزامی است.");
        if (currentHawala.HawalaType == "HawalaSend" && currentHawala.FromAccountId == null)
            validationErrors.Add("برای حواله ارسال، انتخاب حساب مبدأ الزامی است.");
        if (currentHawala.HawalaType == "HawalaReceive" && currentHawala.FromAccountId == null)
            validationErrors.Add("برای حواله دریافت، انتخاب حساب پرداخت‌کننده الزامی است.");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateDto = new UpdateHawalaDto
                {
                    SenderName = currentHawala.SenderName,
                    SenderFatherName = currentHawala.SenderFatherName,
                    SenderPhone = currentHawala.SenderPhone,
                    SenderTazkiraNumber = currentHawala.SenderTazkiraNumber,
                    SenderAddress = currentHawala.SenderAddress,
                    ReceiverName = currentHawala.ReceiverName,
                    ReceiverFatherName = currentHawala.ReceiverFatherName,
                    ReceiverPhone = currentHawala.ReceiverPhone,
                    ReceiverTazkiraNumber = currentHawala.ReceiverTazkiraNumber,
                    ReceiverAddress = currentHawala.ReceiverAddress,
                    ToAmount = currentHawala.ToAmount,
                    ExchangeRate = currentHawala.ExchangeRate,
                    CommissionAmount = currentHawala.CommissionAmount,
                    CommissionCurrencyId = currentHawala.CommissionCurrencyId,
                    AgentCommissionAmount = currentHawala.AgentCommissionAmount,
                    AgentCommissionCurrencyId = currentHawala.AgentCommissionCurrencyId,
                    ReferenceNumber = currentHawala.ReferenceNumber,
                    Notes = currentHawala.Notes,
                    PaymentLocation = currentHawala.PaymentLocation
                };
                await HawalaService.UpdateHawalaAsync(editId, updateDto);
                successMessage = "حواله با موفقیت ویرایش شد.";
            }
            else
            {
                await HawalaService.CreateHawalaAsync(currentHawala);
                successMessage = "حواله با موفقیت ایجاد شد.";
            }

            showModal = false;
            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await HawalaService.DeleteHawalaAsync(deleteId);
            successMessage = "حواله با موفقیت حذف شد.";
            showDeleteModal = false;
            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void OnHawalaTypeChanged()
    {
        // اگر نوع حواله تغییر کرد، نماینده و حساب مبدأ را ریست می‌کنیم

        currentHawala.CorrespondentId = null;
        currentHawala.FromAccountId = null;
        accountSearchText = "";

        StateHasChanged();
    }

    // ===== متدهای کمکی =====

    private string GetTypeBadge(string type)
    {
        return type switch
        {
            "HawalaSend" => "badge-success",
            "HawalaReceive" => "badge-info",
            "HawalaOther" => "badge-warning",
            _ => "badge-secondary"
        };
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "badge-warning",
            "Paid" => "badge-success",
            "Cancel" => "badge-danger",
            _ => "badge-secondary"
        };
    }

    private string GetAccountTypeName(string type)
    {
        return type?.ToLower() switch
        {
            "cash" => "نقدی",
            "bank" => "بانکی",
            "customer" => "مشتری",
            "correspondent" => "نماینده",
            "income" => "درآمد",
            "expense" => "هزینه",
            "equity" => "سرمایه",
            _ => type ?? "نامشخص"
        };
    }
}