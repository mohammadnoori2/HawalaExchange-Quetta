    // ===== آمار =====
    private int totalCount = 0;
    private int totalPages = 1;
    private int hawalaSendCount = 0;
    private int hawalaReceiveCount = 0;
    private int hawalaOtherCount = 0;
    private int pendingCount = 0;
    private int paidCount = 0;

    // ===== متغیرهای مودال ایجاد/ویرایش =====
    private bool showModal = false;
    private bool isEditMode = false;
    private long editId = 0;
    private CreateHawalaDto? editHawalaData = null;

    // ===== متغیرهای سایر مودال‌ها =====
    private bool showDetailModal = false;
    private bool showCancelModal = false;
    private bool showDeleteModal = false;
    private bool isLoading = false;
    private long cancelId = 0;
    private long deleteId = 0;
    private string cancelReason = "";
    private bool cancelIncludesCommission = true;

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private HawalaDto? selectedHawala = null;

    private long afnCurrencyId = 0;

    private bool showPayModal = false;
    private long payHawalaId = 0;
    private long payHawalaNumber = 0;
    private long selectedPaymentAccountId = 0;
    private List<CustomerDto> customers = new();
    private PayHawalaDto payDetails = new();

    private List<AccountDto> paymentAccountsForHawalaReceive =>
        accounts
            .Where(x =>
                x.AccountType == "Cash" ||
                x.AccountType == "Bank" ||
                x.AccountType == "Customer" ||
                x.AccountType == "Correspondent")
            .OrderBy(x => x.AccountCode)
            .ToList();

    private bool showReceiptModal = false;
    private HawalaDto? receiptHawala = null;
    private CompanySettingDto companySetting = new();

    // ===== متدهای کمکی برای نمایش =====

    private string GetPaymentLocation(HawalaDto hawala)
    {
        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName) &&
            !string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
        {
            return $"{hawala.PaymentLocationName} - {hawala.PaymentLocationAddress}";
        }

        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationName))
            return hawala.PaymentLocationName;

        if (!string.IsNullOrWhiteSpace(hawala.PaymentLocationAddress))
            return hawala.PaymentLocationAddress;

        return "-";
    }

    // ===== متدهای رسید =====

    private async Task OpenReceipt(long hawalaId)
    {
        try
        {
            validationErrors.Clear();
            successMessage = string.Empty;

            var hawala = await HawalaService.GetHawalaByIdAsync(hawalaId);

            if (hawala == null)
            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            receiptHawala = hawala;
            companySetting = await CompanySettingService.GetAsync();

            showReceiptModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در نمایش رسید: {ex.Message}");
        }
    }

    private void CloseReceipt()
    {
        showReceiptModal = false;
        receiptHawala = null;
        StateHasChanged();
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("hawalaTools.printElement", "hawalaReceiptPrintArea", 80);
    }

    private async Task CopyHawalaInfo(long hawalaId)
    {
        try
        {
            validationErrors.Clear();
            successMessage = string.Empty;

            var hawala = await HawalaService.GetHawalaByIdAsync(hawalaId);

            if (hawala == null)
            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var text = HawalaShareHelper.BuildText(hawala);

            var copied = await JS.InvokeAsync<bool>("hawalaTools.copyToClipboard", text);

            successMessage = copied
                ? "معلومات حواله با موفقیت کاپی شد."
                : "کاپی خودکار موفق نشد. لطفاً دوباره تلاش کنید.";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در کاپی معلومات حواله: {ex.Message}");
        }
    }

    private async Task ShareHawalaWhatsApp(long hawalaId)
    {
        try
        {
            var hawala = await HawalaService.GetHawalaByIdAsync(hawalaId);

            if (hawala == null)
            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var text = HawalaShareHelper.BuildText(hawala);

            var url = "https://wa.me/?text=" + Uri.EscapeDataString(text);

            await JS.InvokeVoidAsync("hawalaTools.openShareUrl", url);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ارسال واتساپ: {ex.Message}");
        }
    }

    private async Task ShareHawalaTelegram(long hawalaId)
    {
        try
        {
            var hawala = await HawalaService.GetHawalaByIdAsync(hawalaId);

            if (hawala == null)
            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var text = HawalaShareHelper.BuildText(hawala);

            var receiptUrl = NavigationManager.BaseUri.TrimEnd('/');

            var telegramAppUrl =
                "tg://msg_url" +
                "?url=" + Uri.EscapeDataString(receiptUrl) +
                "&text=" + Uri.EscapeDataString(text);

            await JS.InvokeVoidAsync("hawalaTools.openTelegramApp", telegramAppUrl);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در باز کردن تلگرام: {ex.Message}");
        }
    }

    // ===== متدهای بارگذاری =====

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadAccounts();
        await LoadCustomers();
        await LoadHawalas();
        await LoadPaymentLocations();
    }

    private async Task LoadLookupData()
    {
        try
        {
            correspondents = (await CorrespondentService.GetAllAsync()).ToList();
            currencies = (await CurrencyService.GetAllAsync())
                .OrderBy(x => x.Code)
                .ToList();
            var afn = currencies.FirstOrDefault(x => x.Code.Equals("AFN", StringComparison.OrdinalIgnoreCase));
            afnCurrencyId = afn?.Id ?? 0;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();
            accounts = result.Where(a => !a.IsArchived).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    private async Task LoadCustomers()
    {
        customers = (await CustomerService.GetAllAsync())
            .Where(x => !x.IsArchived)
            .ToList();
    }

    private async Task LoadHawalas()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            decimal? searchAmount = null;
            long searchNumber = 0;

            if (MoneyFormatHelper.TryParse(searchTerm, out var parsedSearchAmount))
            {
                searchAmount = parsedSearchAmount;
                if (parsedSearchAmount > 0 &&
                    parsedSearchAmount == decimal.Truncate(parsedSearchAmount) &&
                    parsedSearchAmount <= long.MaxValue)
                {
                    searchNumber = (long)parsedSearchAmount;
                }
            }

            var filter = new HawalaFilterDto
            {
                SearchTerm = string.IsNullOrEmpty(searchTerm) ? null : searchTerm,
                SearchAmount = searchAmount,
                Number = searchNumber,
                HawalaType = string.IsNullOrEmpty(filterHawalaType) ? null : filterHawalaType,
                Status = string.IsNullOrEmpty(filterStatus) ? null : filterStatus,
                CorrespondentId = filterCorrespondentId == 0 ? null : filterCorrespondentId,
                PaymentLocationId = filterPaymentLocationId == 0 ? null : filterPaymentLocationId,
                CurrencyId = filterCurrencyId == 0 ? null : filterCurrencyId,
                MinAmount = filterMinAmount,
                MaxAmount = filterMaxAmount,
                FromDate = filterFromDate == DateTime.MinValue ? null : filterFromDate.Date,
                ToDate = filterToDate == DateTime.MinValue ? null : filterToDate.Date,
                PageNumber = currentPage,
                PageSize = pageSize == 0 ? int.MaxValue : pageSize,
                SortColumn = sortColumn,
                SortDirection = sortAscending ? "asc" : "desc"
            };

            var result = await HawalaService.GetHawalasAsync(filter);

            filteredHawalas = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;

            var stats = await HawalaService.GetStatisticsAsync();
            hawalaSendCount = stats.HawalaSendCount;
            hawalaReceiveCount = stats.HawalaReceiveCount;
            hawalaOtherCount = stats.HawalaOtherCount;
            pendingCount = stats.PendingCount;
            paidCount = stats.PaidCount;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPaymentLocations()
    {
        try
        {
            var result = await PaymentLocationService.GetAllAsync();
            paymentLocations = result.OrderBy(x => x.Name).ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری آدرس‌ها: {ex.Message}");
        }
    }

    // ===== متدهای فیلتر و صفحه‌بندی =====

    private async Task OnFilterChangedAsync()
    {
        filterChangeCts?.Cancel();
        filterChangeCts?.Dispose();
        filterChangeCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(150, filterChangeCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        filterValidationError = string.Empty;

        if (filterMinAmount.HasValue && filterMaxAmount.HasValue &&
            filterMinAmount.Value > filterMaxAmount.Value)
        {
            filterValidationError = "حداقل مبلغ نمی‌تواند بیشتر از حداکثر مبلغ باشد.";
            return;
        }

        if (filterFromDate != DateTime.MinValue && filterToDate != DateTime.MinValue &&
            filterFromDate.Date > filterToDate.Date)
        {
            filterValidationError = "تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.";
            return;
        }

        currentPage = 1;
        await LoadHawalas();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        filterHawalaType = "";
        filterStatus = "";
        filterCorrespondentId = 0;
        filterPaymentLocationId = 0;
        filterCurrencyId = 0;
        filterMinAmount = null;
        filterMaxAmount = null;
        filterFromDate = DateTime.MinValue;
        filterToDate = DateTime.MinValue;
        filterValidationError = string.Empty;
        currentPage = 1;
        await LoadHawalas();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            _ = LoadHawalas();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        _ = LoadHawalas();
    }

    // ===== متدهای مودال ایجاد/ویرایش =====

    private void OpenCreateModal()
    {
        isEditMode = false;
        editId = 0;
        editHawalaData = null;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var hawala = await HawalaService.GetHawalaByIdAsync(id);
            var hawalaIdToEdit = id;
            if (hawala?.IsSystemGenerated == true && hawala.SourceHawalaId.HasValue)
            {
                hawalaIdToEdit = hawala.SourceHawalaId.Value;
                hawala = await HawalaService.GetHawalaByIdAsync(hawalaIdToEdit);
            }

            if (hawala != null)
            {
                editHawalaData = new CreateHawalaDto
                {
                    Number = hawala.Number,
                    HawalaType = hawala.HawalaType,
                    CorrespondentId = hawala.CorrespondentId,
                    SenderName = hawala.SenderName,
                    SenderFatherName = hawala.SenderFatherName,
                    SenderPhone = hawala.SenderPhone,
                    SenderTazkiraNumber = hawala.SenderTazkiraNumber,
                    SenderTazkiraImagePath = hawala.SenderTazkiraImagePath,
                    SenderAddress = hawala.SenderAddress,
                    ReceiverName = hawala.ReceiverName,
                    ReceiverFatherName = hawala.ReceiverFatherName,
                    ReceiverPhone = hawala.ReceiverPhone,
                    ReceiverTazkiraNumber = hawala.ReceiverTazkiraNumber,
                    ReceiverTazkiraImagePath = hawala.ReceiverTazkiraImagePath,
                    ReceiverAddress = hawala.ReceiverAddress,
                    FromCurrencyId = hawala.FromCurrencyId,
                    FromAmount = hawala.FromAmount,
                    ToCurrencyId = hawala.ToCurrencyId,
                    ToAmount = hawala.ToAmount,
                    ExchangeRate = hawala.ExchangeRate,
                    CommissionAmount = hawala.CommissionAmount,
                    CommissionCurrencyId = hawala.CommissionCurrencyId,
                    AgentCommissionAmount = hawala.AgentCommissionAmount,
                    AgentCommissionCurrencyId = hawala.AgentCommissionCurrencyId,
                    ReferenceNumber = hawala.ReferenceNumber,
                    Notes = hawala.Notes,
                    Status = hawala.Status,
                    PaymentLocationId = hawala.PaymentLocationId,
                    FromAccountId = hawala.FromAccountId,
                    GeneratedSendHawalaNumber = hawala.GeneratedSendHawalaNumber
                };

                isEditMode = true;
                editId = hawalaIdToEdit;
                showModal = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnHawalaSaved(CreateHawalaDto newHawala)
    {
        await LoadHawalas();
        StateHasChanged();
    }

    private async Task OnHawalaEdited(long id)
    {
        await LoadHawalas();
        StateHasChanged();
    }

    // ===== متدهای سایر مودال‌ها =====

    private async Task ViewHawala(long id)
    {
        try
        {
            selectedHawala = await HawalaService.GetHawalaByIdAsync(id);
            showDetailModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedHawala = null;
        StateHasChanged();
    }

    private void ShowCancelConfirm(long id)
    {
        cancelId = id;
        cancelReason = "";
        cancelIncludesCommission = true;
        showCancelModal = true;
        StateHasChanged();
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        cancelReason = "";
        cancelIncludesCommission = true;
        StateHasChanged();
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    // ===== متدهای عملیاتی =====

    private void OpenPayFromMenu(HawalaDto hawala)
    {
        OpenPayModal(hawala.Id, hawala.Number);
    }

    private void OpenPayModal(long hawalaId, long hawalaNumber)
    {
        payHawalaId = hawalaId;
        payHawalaNumber = hawalaNumber;
        selectedPaymentAccountId = 0;
        var hawala = filteredHawalas.FirstOrDefault(x => x.Id == hawalaId);
        payDetails = CreatePayDetails(hawala);
        validationErrors.Clear();
        successMessage = string.Empty;
        showPayModal = true;
        StateHasChanged();
    }

    private void ClosePayModal()
    {
        showPayModal = false;
        payHawalaId = 0;
        payHawalaNumber = 0;
        selectedPaymentAccountId = 0;
        payDetails = new PayHawalaDto();
        StateHasChanged();
    }

    private async Task ConfirmPayHawala()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (selectedPaymentAccountId <= 0)
        {
            validationErrors.Add("برای پرداخت حواله، انتخاب حساب پرداخت‌کننده الزامی است.");
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            payDetails.PaidFromAccountId = selectedPaymentAccountId;
            await HawalaService.MarkAsPaidAsync(payHawalaId, payDetails);

            successMessage = "حواله با موفقیت پرداخت شد.";

            showPayModal = false;
            payHawalaId = 0;
            payHawalaNumber = 0;
            selectedPaymentAccountId = 0;

            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در پرداخت حواله: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static PayHawalaDto CreatePayDetails(HawalaDto? hawala) => new()
    {
        ReceiverName = hawala?.ReceiverName ?? string.Empty,
        ReceiverFatherName = hawala?.ReceiverFatherName,
        ReceiverPhone = hawala?.ReceiverPhone,
        ReceiverTazkiraNumber = hawala?.ReceiverTazkiraNumber,
        ReceiverTazkiraImagePath = hawala?.ReceiverTazkiraImagePath,
        ReceiverAddress = hawala?.ReceiverAddress
    };

    private async Task ConfirmCancel()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(cancelReason))
            {
                validationErrors.Add("لطفاً دلیل لغو را وارد کنید.");
                StateHasChanged();
                return;
            }

            await HawalaService.CancelHawalaAsync(cancelId, new CancelHawalaDto
            {
                CancelReason = cancelReason,
                ReverseCommission = cancelIncludesCommission
            });
            successMessage = "حواله با موفقیت لغو شد.";
            showCancelModal = false;
            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در لغو: {ex.Message}");
            showCancelModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await HawalaService.DeleteHawalaAsync(deleteId);
            successMessage = "حواله با موفقیت حذف شد.";
            showDeleteModal = false;
            await LoadHawalas();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در حذف: {ex.Message}");
            showDeleteModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // ===== توابع کمکی =====

    private string GetTypeBadge(string type)
    {
        return type switch
        {
            "HawalaSend" => "badge-success",
            "HawalaReceive" => "badge-info",
            "HawalaOther" => "badge-warning",
            _ => "badge-secondary"
        };
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "badge-warning",
            "Paid" => "badge-success",
            "Cancel" => "badge-danger",
            _ => "badge-secondary"
        };
    }

    private string GetAccountTypeName(string type) => AppDisplayText.AccountType(type);
}
