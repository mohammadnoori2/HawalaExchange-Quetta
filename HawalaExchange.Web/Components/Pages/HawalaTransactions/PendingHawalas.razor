    private async Task ShareHawalaWhatsApp(long hawalaId)
    {
        try
        {
            var hawala = await HawalaService.GetHawalaByIdAsync(hawalaId);

            if (hawala == null)
            {
                validationErrors.Add("حواله یافت نشد.");
                return;
            }

            var text = HawalaShareHelper.BuildText(hawala);

            var url = "https://wa.me/?text=" + Uri.EscapeDataString(text);

            await JS.InvokeVoidAsync("hawalaTools.openShareUrl", url);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ارسال واتساپ: {ex.Message}");
        }
