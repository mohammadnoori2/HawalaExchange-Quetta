@page "/hawala-pending"

@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IHawalaService HawalaService
@inject IAccountService AccountService
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject ICurrencyService CurrencyService
@inject IPaymentLocationService PaymentLocationService
@inject ICompanySettingService CompanySettingService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-clock-history"></i>
                حواله‌های اجرا نشده
                <span class="page-subtitle">حواله‌های دریافتی که هنوز پرداخت نشده‌اند</span>
            </h5>
        </div>

        <PageHeaderStats AriaLabel="آمار حواله‌های اجرا نشده">
            <PageHeaderStat Label="اجرا نشده" Value="@hawalas.Count" Icon="bi-clock-history" Tone="danger" />
            <PageHeaderStat Label="مجموع مبلغ" Value="@(MoneyFormatHelper.Format(hawalas.Sum(x => x.FromAmount)))" Icon="bi-cash-stack" Tone="info" />
        </PageHeaderStats>
        <div class="page-actions">
            <button class="btn-modern btn-light-modern btn-rounded" @onclick="LoadData">
                <i class="bi bi-arrow-clockwise"></i>
                تازه‌سازی
            </button>
        </div>
    </div>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            @successMessage
        </div>
    }

    <CompactFilterBar AriaLabel="جستجو و فیلتر حواله‌های اجرا نشده"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || filterCorrespondentId != 0 || filterPaymentLocationId != 0 || filterCurrencyId != 0 || filterMinAmount.HasValue || filterMaxAmount.HasValue || filterFromDate != DateTime.MinValue || filterToDate != DateTime.MinValue)"
                      ActiveFilterCount="@((filterCurrencyId != 0 ? 1 : 0) + (filterMinAmount.HasValue ? 1 : 0) + (filterMaxAmount.HasValue ? 1 : 0) + (filterFromDate != DateTime.MinValue ? 1 : 0) + (filterToDate != DateTime.MinValue ? 1 : 0))"
                      Reset="ResetFilters">
        <SearchContent>
            <input type="text"
                   class="form-control"
                   placeholder="نمبر، مبلغ، فرستنده، گیرنده، نمبر متفرقه..."
                   @bind="searchTerm"
                   @bind:event="oninput"
                   @bind:after="OnFilterChangedAsync" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" aria-label="نمایندگی" @bind="filterCorrespondentId" @bind:after="OnFilterChangedAsync">
                <option value="0">همه نمایندگان</option>
                @foreach (var correspondent in correspondents)
                {
                    <option value="@correspondent.Id">@correspondent.Name</option>
                }
            </select>
            <select class="form-select compact-quick-filter" aria-label="محل پرداخت" @bind="filterPaymentLocationId" @bind:after="OnFilterChangedAsync">
                <option value="0">همه محل‌ها</option>
                @foreach (var location in paymentLocations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </QuickFilters>
        <AdvancedFilters>
            <div class="compact-filter-field">
                <label class="form-label">ارز مبلغ</label>
                <select class="form-select" @bind="filterCurrencyId" @bind:after="OnFilterChangedAsync">
                <option value="0">همه ارزها</option>
                @foreach (var currency in currencies)
                {
                    <option value="@currency.Id">@currency.Code - @currency.Name</option>
                }
                </select>
            </div>
            <div class="compact-filter-field"><label class="form-label">حداقل مبلغ</label><NullableMoneyInput class="form-control" @bind-Value="filterMinAmount" @bind-Value:after="OnFilterChangedAsync" placeholder="از مبلغ" /></div>
            <div class="compact-filter-field"><label class="form-label">حداکثر مبلغ</label><NullableMoneyInput class="form-control" @bind-Value="filterMaxAmount" @bind-Value:after="OnFilterChangedAsync" placeholder="تا مبلغ" /></div>
            <div class="compact-filter-field"><label class="form-label">از تاریخ ثبت</label><PersianDatePicker @bind-Value="filterFromDate" @bind-Value:after="OnFilterChangedAsync" AllowEmpty="true" Placeholder="انتخاب تاریخ" /></div>
            <div class="compact-filter-field"><label class="form-label">تا تاریخ ثبت</label><PersianDatePicker @bind-Value="filterToDate" @bind-Value:after="OnFilterChangedAsync" AllowEmpty="true" Placeholder="انتخاب تاریخ" /></div>
        </AdvancedFilters>
    </CompactFilterBar>

    @if (!string.IsNullOrWhiteSpace(filterValidationError))
    {
        <div class="alert alert-danger py-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @filterValidationError
        </div>
    }

    <div class="table-card hawala-list-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-danger">
                    <i class="bi bi-clock-history"></i>
                    @filteredHawalas.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th>نمبر</th>
                            <th>نمبر رفرنس</th>
                            <th>فرستنده</th>
                            <th>گیرنده</th>
                            <th>نماینده</th>
                            <th>مبلغ</th>
                            <th>کارمزد</th>
                            <th>تاریخ</th>
                            <th class="text-center" style="width:80px;">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="spinner-border text-primary"></div>
                                    <p class="text-muted mt-2">در حال بارگذاری...</p>
                                </td>
                            </tr>
                        }
                        else if (!pagedHawalas.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ حواله اجرا نشده‌ای یافت نشد</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (currentPage - 1) * pageSize + 1;

                            @foreach (var hawala in pagedHawalas)
                            {
                                <tr>
                                    <td>@rowIndex</td>

                                    <td>
                                        <strong>@hawala.Number</strong>
                                    </td>

                                    <td><span dir="ltr">@(hawala.ReferenceNumber ?? "-")</span></td>

                                    <td>@(hawala.SenderName ?? "-")</td>

                                    <td>@(hawala.ReceiverName ?? "-")</td>

                                    <td>@(hawala.CorrespondentName ?? "-")</td>

                                    <td dir="ltr" class="fw-bold text-primary">
                                        @MoneyFormatHelper.Format(hawala.FromAmount) @hawala.FromCurrencyCode
                                    </td>

                                    <td dir="ltr">
                                        @(hawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(hawala.CommissionAmount.Value) : "-")
                                        @hawala.CommissionCurrencyCode
                                    </td>

                                    <td><AppDateTime Value="@hawala.CreatedAt" /></td>

                                    <td class="text-center operation-cell">
                                        <HawalaOperationMenu Hawala="hawala"
                                                             ShowEdit="false"
                                                             ShowPay="true"
                                                             ShowCancel="true"
                                                             ShowDelete="true"
                                                             OnView="ViewHawala"
                                                             OnReceipt="OpenReceipt"
                                                             OnCopy="CopyHawalaInfo"
                                                             OnWhatsApp="ShareHawalaWhatsApp"
                                                             OnTelegram="ShareHawalaTelegram"
                                                             OnPay="OpenPayFromMenu"
                                                             OnCancel="ShowCancelConfirm"
                                                             OnDelete="ShowDeleteConfirm" />
                                    </td>
                                </tr>

                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedHawalas.Count</strong>
                    از <strong>@filteredHawalas.Count</strong>
                </span>
            </div>

            <div class="table-card-footer-right">
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>
            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد حواله در هر صفحه" />
        </div>
    </div>
</div>

@if (showPayModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-check-circle me-2"></i>
                        پرداخت حواله اجرا نشده
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="ClosePayModal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info mb-3">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <span class="d-block small text-muted">نمبر حواله</span>
                                <strong>@payHawalaNumber</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="d-block small text-muted">نام فرستنده</span>
                                <strong>@(payHawala?.SenderName ?? "-")</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="d-block small text-muted">مقدار حواله</span>
                                <strong dir="ltr">
                                    @(payHawala == null ? "-" : $"{MoneyFormatHelper.Format(payHawala.FromAmount)} {payHawala.FromCurrencyCode}")
                                </strong>
                            </div>
                        </div>
                    </div>

                    <ReceiverPaymentFields Model="payDetails" Customers="customers" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            حساب پرداخت‌کننده <span class="text-danger">*</span>
                        </label>

                        <AccountSearchSelect Accounts="@paymentAccounts"
                                             @bind-Value="selectedPaymentAccountId"
                                             Placeholder="جستجوی حساب پرداخت‌کننده..." />

                        <small class="text-muted">
                            حساب انتخاب‌شده در لیجر طلبکار می‌شود.
                        </small>
                    </div>

                    <PayoutAgentCommissionFields Model="payDetails" Currencies="currencies" />

                    <div class="alert alert-warning mb-0">
                        <strong>سند حسابداری:</strong>
                        <div class="mt-2">اصل حواله و کمیشن عامل پرداخت جداگانه ثبت می‌شوند؛ کمیشن در حساب هزینه قرار می‌گیرد.</div>
                    </div>
                </div>

                <div class="modal-footer">
                    <HawalaExecutionReceiptPrint Hawala="payHawala" Payment="payDetails" />

                    <button class="btn-modern btn-light-modern" @onclick="ClosePayModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button class="btn-modern btn-primary-modern"
                            @onclick="ConfirmPay"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }

                        تأیید پرداخت
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDetailModal && selectedHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i>
                        جزئیات حواله اجرا نشده
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDetailModal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نمبر</span>
                                <span class="info-value fw-bold">@selectedHawala.Number</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">نمبر رفرنس</span>
                                <span class="info-value" dir="ltr">@(selectedHawala.ReferenceNumber ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">@selectedHawala.StatusName</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="info-card">
                                <span class="info-label">تاریخ</span>
                                <span class="info-value"><AppDateTime Value="@selectedHawala.CreatedAt" /></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">فرستنده</span>
                                <span class="info-value">@(selectedHawala.SenderName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">گیرنده</span>
                                <span class="info-value">@(selectedHawala.ReceiverName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">نماینده</span>
                                <span class="info-value">@(selectedHawala.CorrespondentName ?? "-")</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">محل پرداخت</span>
                                <span class="info-value">@GetPaymentLocation(selectedHawala)</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">مبلغ</span>
                                <span class="info-value text-primary fw-bold" dir="ltr">
                                    @MoneyFormatHelper.Format(selectedHawala.FromAmount) @selectedHawala.FromCurrencyCode
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">کارمزد</span>
                                <span class="info-value" dir="ltr">
                                    @(selectedHawala.CommissionAmount.HasValue ? MoneyFormatHelper.Format(selectedHawala.CommissionAmount.Value) : "-")
                                    @selectedHawala.CommissionCurrencyCode
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedHawala.Notes))
                        {
                            <div class="col-12">
                                <div class="info-card">
                                    <span class="info-label">یادداشت</span>
                                    <span class="info-value">@selectedHawala.Notes</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="CloseDetailModal">
                        بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReceiptModal && receiptHawala != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-receipt me-2"></i>
                        رسید حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseReceipt"></button>
                </div>

                <div class="modal-body">
                    <div id="hawalaReceiptPrintArea">
                        <HawalaReceipt Hawala="receiptHawala"
                                       Company="companySetting" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="CloseReceipt">
                        بستن
                    </button>

                    <button class="btn-modern btn-secondary-modern" @onclick="() => CopyHawalaInfo(receiptHawala.Id)">
                        <i class="bi bi-clipboard"></i>
                        کاپی
                    </button>

                    <button class="btn-modern btn-success-modern" @onclick="() => ShareHawalaWhatsApp(receiptHawala.Id)">
                        <i class="bi bi-whatsapp"></i>
                        واتساپ
                    </button>

                    <button class="btn-modern btn-primary-modern" @onclick="() => ShareHawalaTelegram(receiptHawala.Id)">
                        <i class="bi bi-telegram"></i>
                        تلگرام
                    </button>

                    <button class="btn-modern btn-primary-modern" @onclick="PrintReceipt">
                        <i class="bi bi-printer"></i>
                        چاپ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showCancelModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        لغو حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseCancelModal"></button>
                </div>

                <div class="modal-body">
                    <p class="fw-bold mb-2">نوع لغو را انتخاب کنید:</p>
                    <div class="d-grid gap-2 mb-3">
                        <label class="border rounded p-3 d-flex gap-2 align-items-start">
                            <input type="radio" name="cancelModePending" checked="@cancelIncludesCommission"
                                   @onchange="() => cancelIncludesCommission = true" />
                            <span><strong>لغو با کارمزد</strong><br /><small class="text-muted">مبلغ حواله و تمام کارمزدها در لیجر معکوس می‌شوند.</small></span>
                        </label>
                        <label class="border rounded p-3 d-flex gap-2 align-items-start">
                            <input type="radio" name="cancelModePending" checked="@(!cancelIncludesCommission)"
                                   @onchange="() => cancelIncludesCommission = false" />
                            <span><strong>لغو بدون کارمزد</strong><br /><small class="text-muted">فقط مبلغ حواله معکوس می‌شود و کارمزدهای ثبت‌شده باقی می‌مانند.</small></span>
                        </label>
                    </div>
                    <p>دلیل لغو حواله را وارد کنید:</p>

                    <textarea class="form-control"
                              rows="3"
                              @bind="cancelReason"
                              placeholder="دلیل لغو..."></textarea>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn-modern btn-light-modern" @onclick="CloseCancelModal">
                        انصراف
                    </button>

                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmCancel">
                        تأیید لغو
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-trash me-2"></i>
                        حذف حواله
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDeleteModal"></button>
                </div>

                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">آیا مطمئن هستید که می‌خواهید این حواله را حذف کنید؟</p>
                    <p class="text-muted small">این عملیات غیرقابل بازگشت است.</p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn-modern btn-light-modern" @onclick="CloseDeleteModal">
                        انصراف
                    </button>

                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmDelete">
                        تأیید حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<HawalaDto> hawalas = new();
    private List<HawalaDto> filteredHawalas = new();
    private List<AccountDto> accounts = new();
    private List<CorrespondentDto> correspondents = new();
    private List<CurrencyDto> currencies = new();
    private List<PaymentLocationDto> paymentLocations = new();

    private HawalaDto? selectedHawala;
    private HawalaDto? receiptHawala;
    private CompanySettingDto companySetting = new();

    private List<string> validationErrors = new();
    private string successMessage = string.Empty;

    private bool isLoading = false;
    private bool showPayModal = false;
    private bool showDetailModal = false;
    private bool showReceiptModal = false;
    private bool showCancelModal = false;
    private bool showDeleteModal = false;

    private long payHawalaId = 0;
    private long payHawalaNumber = 0;
    private HawalaDto? payHawala;
    private long selectedPaymentAccountId = 0;
    private List<CustomerDto> customers = new();
    private PayHawalaDto payDetails = new();

    private long cancelId = 0;
    private long deleteId = 0;
    private string cancelReason = string.Empty;
    private bool cancelIncludesCommission = true;

    private string searchTerm = string.Empty;
    private long filterCorrespondentId = 0;
    private long filterPaymentLocationId = 0;
    private long filterCurrencyId = 0;
    private decimal? filterMinAmount;
    private decimal? filterMaxAmount;
    private DateTime filterFromDate = DateTime.MinValue;
    private DateTime filterToDate = DateTime.MinValue;
    private string filterValidationError = string.Empty;
    private CancellationTokenSource? filterChangeCts;

    private int pageSize = 10;
    private int currentPage = 1;

    private List<HawalaDto> pagedHawalas =>
        filteredHawalas
            .OrderByDescending(x => x.CreatedAt)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

    private int totalPages =>
        filteredHawalas.Count == 0
            ? 1
            : (int)Math.Ceiling((double)filteredHawalas.Count / pageSize);

    private List<AccountDto> paymentAccounts =>
        accounts
            .Where(IsPaymentAccount)
            .OrderBy(x => x.AccountCode)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterOptions();
        await LoadAccounts();
        await LoadCustomers();
        await LoadData();
    }

    private async Task LoadFilterOptions()
    {
        try
        {
            correspondents = (await CorrespondentService.GetAllAsync())
                .Where(x => !x.IsArchived)
                .OrderBy(x => x.Name)
                .ToList();
            currencies = (await CurrencyService.GetAllAsync())
                .OrderBy(x => x.Code)
                .ToList();
            paymentLocations = (await PaymentLocationService.GetAllAsync())
                .OrderBy(x => x.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری گزینه‌های فیلتر: {ex.Message}");
        }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await AccountService.GetAllAsync();

            accounts = result
                .Where(x => !x.IsArchived)
                .ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حساب‌ها: {ex.Message}");
        }
    }

    private async Task LoadCustomers()
    {
        customers = (await CustomerService.GetAllAsync())
            .Where(x => !x.IsArchived)
            .ToList();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;

            decimal? searchAmount = null;
            long searchNumber = 0;

            if (MoneyFormatHelper.TryParse(searchTerm, out var parsedSearchAmount))
            {
                searchAmount = parsedSearchAmount;
                if (parsedSearchAmount > 0 &&
                    parsedSearchAmount == decimal.Truncate(parsedSearchAmount) &&
                    parsedSearchAmount <= long.MaxValue)
                {
                    searchNumber = (long)parsedSearchAmount;
                }
            }

            var filter = new HawalaFilterDto
            {
                SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
                SearchAmount = searchAmount,
                Number = searchNumber,
                HawalaType = "HawalaReceive",
                Status = "Pending",
                CorrespondentId = filterCorrespondentId == 0 ? null : filterCorrespondentId,
                PaymentLocationId = filterPaymentLocationId == 0 ? null : filterPaymentLocationId,
                CurrencyId = filterCurrencyId == 0 ? null : filterCurrencyId,
                MinAmount = filterMinAmount,
                MaxAmount = filterMaxAmount,
                FromDate = filterFromDate == DateTime.MinValue ? null : filterFromDate.Date,
                ToDate = filterToDate == DateTime.MinValue ? null : filterToDate.Date,
                PageNumber = 1,
                PageSize = int.MaxValue,
                SortColumn = "CreatedAt",
                SortDirection = "desc"
            };

            var result = await HawalaService.GetHawalasAsync(filter);

            hawalas = result.Items.ToList();
            filteredHawalas = hawalas.ToList();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری حواله‌های اجرا نشده: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChangedAsync()
    {
        filterChangeCts?.Cancel();
        filterChangeCts?.Dispose();
        filterChangeCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(150, filterChangeCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        filterValidationError = string.Empty;

        if (filterMinAmount.HasValue && filterMaxAmount.HasValue &&
            filterMinAmount.Value > filterMaxAmount.Value)
        {
            filterValidationError = "حداقل مبلغ نمی‌تواند بیشتر از حداکثر مبلغ باشد.";
            return;
        }

        if (filterFromDate != DateTime.MinValue && filterToDate != DateTime.MinValue &&
            filterFromDate.Date > filterToDate.Date)
        {
            filterValidationError = "تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.";
            return;
        }

        await LoadData();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        filterCorrespondentId = 0;
        filterPaymentLocationId = 0;
        filterCurrencyId = 0;
        filterMinAmount = null;
        filterMaxAmount = null;
        filterFromDate = DateTime.MinValue;
        filterToDate = DateTime.MinValue;
        filterValidationError = string.Empty;
        await LoadData();
    }

    private void GoToPage(int page)
    {
