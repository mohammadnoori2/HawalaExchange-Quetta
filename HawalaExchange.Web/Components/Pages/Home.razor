@page "/"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared.Modals
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject ICurrencyService CurrencyService
@inject ICompanySettingService CompanySettingService
@inject IFinancialReportService FinancialReportService
@inject IJournalService JournalService
@inject ICashBalanceAlertService CashBalanceAlertService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize(Policy = "TenantBusiness")]

<PageTitle>داشبورد</PageTitle>

<div class="dashboard-wrapper dashboard-reference" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title dashboard-page-title"><i class="bi bi-bar-chart" aria-hidden="true"></i> داشبورد</h5>
            <span class="page-subtitle">
                آخرین فعالیت:
                <AppDateTime Value="@dashboard?.LastActivityAt" EmptyText="ثبت نشده" />
            </span>
        </div>
        <div class="page-actions quick-links">
            <button class="quick-link-btn quick-link-hawala" @onclick="OpenHawalaModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> ثبت حواله</button>
            <button class="quick-link-btn quick-link-exchange" @onclick="OpenExchangeModal"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> تبدیل پول</button>
            <button class="quick-link-btn quick-link-deposit" @onclick="OpenDepositWithdrawModal"><i class="bi bi-receipt" aria-hidden="true"></i> رسید / برد</button>
            <button class="quick-link-btn quick-link-pending" @onclick="NavigateToPendingHawalas"><i class="bi bi-send" aria-hidden="true"></i> اجرای حواله</button>
            <PageRefreshButton Refresh="RefreshPageDataAsync" Inline="true" />
        </div>
    </div>

    <div class="dashboard-kpi-row" aria-label="آمار داشبورد">
        <section class="dashboard-kpi dashboard-kpi-hawala"><div><i class="bi bi-send" aria-hidden="true"></i><h2>حواله</h2></div><strong>@MoneyFormatHelper.Format(dashboard?.HawalaCount ?? 0)</strong><i class="bi bi-graph-up-arrow kpi-watermark" aria-hidden="true"></i></section>
        <section class="dashboard-kpi dashboard-kpi-exchange"><div><i class="bi bi-arrow-left-right" aria-hidden="true"></i><h2>تبدیل پول</h2></div><strong>@MoneyFormatHelper.Format(dashboard?.ExchangeCount ?? 0)</strong><i class="bi bi-graph-up-arrow kpi-watermark" aria-hidden="true"></i></section>
        <section class="dashboard-kpi dashboard-kpi-profit @(NetProfit < 0 ? "is-negative" : "is-positive")"><div><i class="bi bi-database" aria-hidden="true"></i><h2>مفاد خالص</h2></div><strong dir="ltr">@MoneyFormatHelper.Format(NetProfit) @selectedCurrency</strong><i class="bi bi-graph-up-arrow kpi-watermark" aria-hidden="true"></i></section>
        <section class="dashboard-kpi dashboard-kpi-alert"><div><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><h2>هشدار صندوق</h2></div><strong>@cashBalanceAlerts.Count</strong><i class="bi bi-wallet2 kpi-watermark" aria-hidden="true"></i></section>
    </div>

    <div class="dashboard-summary-row">
        <section class="dashboard-summary-card dashboard-cash-summary" aria-label="موجودی صندوق">
        <div class="dashboard-summary-heading">
            <div class="table-card-header-left">
                <h2>
                    <i class="bi bi-safe2"></i>
                    موجودی فعلی صندوق‌ها
                </h2>
            </div>
        </div>
        <div class="dashboard-summary-body">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>صندوق</th>
                            <th>ارز</th>
                            <th>موجودی فعلی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!currentCashBalances.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    هنوز برای حساب صندوق هیچ معامله‌ای با ارز ثبت نشده است.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var balance in currentCashBalances)
                            {
                                <tr>
                                    <td class="fw-bold"><RecordDetailsLink Kind="Account" Id="balance.AccountId" Text="@balance.AccountName" /></td>
                                    <td><span class="badge-modern badge-info"><CurrencyBadge Code="@balance.CurrencyCode" /></span></td>
                                    <td dir="ltr" class="fw-bold @(balance.Balance >= 0 ? "text-success" : "text-danger")">
                                        @MoneyFormatHelper.Format(balance.Balance)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
        </div>
        </section>
        <section class="dashboard-summary-card dashboard-profit-summary" aria-label="مفاد و ضرر دوره">
            <div class="dashboard-summary-heading"><h2><i class="bi bi-bar-chart" aria-hidden="true"></i> مفاد/ضرر واقعی دوره</h2>
                <select class="form-select form-select-sm dashboard-profit-currency" aria-label="ارز محاسبه مفاد و ضرر" @onchange="OnCurrencyChanged" value="@selectedCurrency">
                    @foreach(var currency in currencies){<option value="@currency.Code">@currency.Code</option>}
                </select>
            </div>
            <div class="dashboard-summary-body"><table class="table table-sm mb-0"><tbody>
                <tr><th>مفاد / ضرر</th><td dir="ltr" class="dashboard-profit-value @(NetProfit >= 0 ? "text-success" : "text-danger")">@MoneyFormatHelper.Format(NetProfit)</td></tr>
                <tr><th>از تاریخ</th><td dir="ltr">@DisplayDates.Date(startDate)</td></tr>
                <tr><th>تا تاریخ</th><td dir="ltr">@DisplayDates.Date(endDate)</td></tr>
            </tbody></table></div>
        </section>
        <DashboardRatesPanel @ref="ratesPanel" Currencies="currencies" OnSaved="LoadDashboardAsync" />
    </div>

    <div class="charts-row">
        <div class="chart-box">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-graph-up"></i> فعالیت‌های روزانه واقعی</span>
            </div>
            <div class="chart-body"><canvas id="dailyChart" role="img" aria-label="نمودار فعالیت‌های روزانه واقعی"></canvas></div>
        </div>
        <div class="chart-box">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-bar-chart"></i> مفاد/ضرر هفتگی</span>
            </div>
            <div class="chart-body"><canvas id="periodicChart" role="img" aria-label="نمودار مفاد و ضرر هفتگی"></canvas></div>
        </div>
    </div>

    <div class="dashboard-lower-row">
        <div class="top-remain-card">
            <div class="top-remain-header">
                <div class="top-remain-heading">
                    <span class="top-remain-title"><i class="bi bi-people" aria-hidden="true"></i> @CounterpartyListTitle</span>
                    <span class="top-remain-sub">
                        ماندهٔ اصلی حساب‌ها به تفکیک ارز
                    </span>
                </div>
                <div class="top-remain-switch" role="group" aria-label="انتخاب نوع مانده حساب">
                    <button type="button"
                            class="top-remain-switch-btn @(counterpartyListMode == "debtors" ? "active debtors" : null)"
                            aria-pressed="@(counterpartyListMode == "debtors")"
                            @onclick="ShowTopDebtors">
                        بدهکاران
                    </button>
                    <button type="button"
                            class="top-remain-switch-btn @(counterpartyListMode == "creditors" ? "active creditors" : null)"
                            aria-pressed="@(counterpartyListMode == "creditors")"
                            @onclick="ShowTopCreditors">
                        طلبکاران
                    </button>
                </div>
            </div>
            <DashboardCounterpartyTable Groups="@(dashboard?.CounterpartiesByCurrency ?? [])" Creditors="@(counterpartyListMode == "creditors")" />
        </div>
        <div class="dashboard-side-column">
        <div class="transactions-card">
            <div class="section-title"><i class="bi bi-stack" aria-hidden="true"></i> فعالیت‌های ثبت‌شده</div>
            <div class="date-filter">
                <div class="date-input-group">
                    <label>از تاریخ:</label>
                    <PersianDatePicker @bind-Value="startDate"
                                       IncludeTime="false"
                                       CssClass="form-control form-control-sm" />
                </div>
                <div class="date-input-group">
                    <label>تا تاریخ:</label>
                    <PersianDatePicker @bind-Value="endDate"
                                       IncludeTime="false"
                                       CssClass="form-control form-control-sm" />
                </div>
                <button class="btn-filter" @onclick="ApplyDateFilter" disabled="@isLoading">
                    @(isLoading ? "..." : "اعمال")
                </button>
            </div>
            <PageHeaderStats AriaLabel="آمار فعالیت‌های ثبت‌شده">
                <PageHeaderStat Label="حواله" Value="@(dashboard?.HawalaCount ?? 0)" Icon="bi-send" />
                <PageHeaderStat Label="تبدیل پول" Value="@(dashboard?.ExchangeCount ?? 0)" Icon="bi-currency-exchange" Tone="info" />
                <PageHeaderStat Label="مجموع" Value="@(dashboard?.TotalActivityCount ?? 0)" Icon="bi-collection" Tone="warning" />
                <PageHeaderStat Label="عملیات حساب" Value="@(dashboard?.AccountOperationCount ?? 0)" Icon="bi-wallet2" Tone="success" />
                <PageHeaderStat Label="مصارف/سرمایه" Value="@((dashboard?.ExpenseCount ?? 0) + (dashboard?.CapitalInvestmentCount ?? 0))" Icon="bi-cash-stack" Tone="danger" />
            </PageHeaderStats>
            <div class="mini-chart-container"><canvas id="miniChart" role="img" aria-label="تعداد فعالیت‌های ثبت‌شده به تفکیک عملیات"></canvas></div>
        </div>

        </div>
    </div>

    <section class="dashboard-liquidity-extra" aria-label="جزئیات نقدینگی">
        <div class="liquidity-card">
            <div class="section-title">نقدینگی به ارزش @selectedCurrency</div>
            <div class="liquidity-tabs">
                <button class="tab-btn @(liquidityFilter == "all" ? "active" : "")" @onclick="SetAll">همه</button>
                <button class="tab-btn @(liquidityFilter == "treasury" ? "active" : "")" @onclick="SetTreasury">صندوق</button>
                <button class="tab-btn @(liquidityFilter == "bank" ? "active" : "")" @onclick="SetBank">بانک</button>
            </div>
            <div class="liquidity-items">
                @if (currentLiquidityItems.Any())
                {
                    @foreach (var item in currentLiquidityItems)
                    {
                        <div class="liquidity-item">
                            <span class="liquidity-currency">@item.AccountName (<CurrencyBadge Code="@item.CurrencyCode" />)</span>
                            <span class="liquidity-percent">@item.Percentage.ToString("N1")%</span>
                        </div>
                    }
                }
                else
                {
                    <div class="liquidity-item">ماندهٔ قابل محاسبه موجود نیست.</div>
                }
            </div>
            <div class="liquidity-chart-container"><canvas id="liquidityChart" role="img" aria-label="سهم حساب‌ها از نقدینگی"></canvas></div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    @if (dashboard?.Warnings.Any() == true)
    {
        <div class="alert alert-warning mt-3">
            <strong>محدودیت محاسبه:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var warning in dashboard.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }
</div>

<CreateHawalaModal IsVisible="@showHawalaModal"
                   IsVisibleChanged="@((bool value) => { showHawalaModal = value; StateHasChanged(); })"
                   IsEditMode="false"
                   OnSaveSuccess="@OnHawalaSaved" />

<MoneyExchangeModal IsVisible="@showExchangeModal"
                    IsVisibleChanged="@((bool value) => { showExchangeModal = value; StateHasChanged(); })"
                    IsEditMode="false"
                    OnSaveSuccess="@OnExchangeSaved" />

<DepositWithdrawModal IsVisible="@showDepositWithdrawModal"
                      IsVisibleChanged="@((bool value) => { showDepositWithdrawModal = value; StateHasChanged(); })"
                      IsEditMode="false"
                      OnSaveSuccess="@OnDepositWithdrawSaved" />

@code {
    private async Task RefreshPageDataAsync()
    {
        currencies = (await CurrencyService.GetAllAsync()).Where(x => x.IsActive).OrderBy(x => x.Code).ToList(); await LoadDashboardAsync();
        if (ratesPanel is not null) await ratesPanel.RefreshAsync();
    }
    private DateTime startDate = DateTime.Today.AddDays(-6);
    private DateTime endDate = DateTime.Today;
    private string selectedCurrency = "AFN";
    private string liquidityFilter = "all";
    private string counterpartyListMode = "debtors";
    private string? errorMessage;
    private bool isLoading;
    private bool chartsRendered;
    private bool showHawalaModal;
    private bool showExchangeModal;
    private bool showDepositWithdrawModal;
    private List<CurrencyDto> currencies = new();
    private DashboardRatesPanel? ratesPanel;
    private DashboardSummaryDto? dashboard;
    private List<DashboardLiquidityDto> currentLiquidityItems = new();
    private List<CurrentCashBalanceDto> currentCashBalances = new();
    private List<CashBalanceAlertDto> cashBalanceAlerts = new();

    private decimal NetProfit => dashboard?.NetProfit ?? 0;
    private IReadOnlyList<DashboardDebtorDto> CurrentCounterpartyItems =>
        counterpartyListMode == "creditors"
            ? dashboard?.TopCreditors ?? []
            : dashboard?.TopDebtors ?? [];
    private decimal CurrentCounterpartyTotal =>
        counterpartyListMode == "creditors"
            ? dashboard?.TotalCounterpartyPayables ?? 0
            : dashboard?.TotalCounterpartyReceivables ?? 0;
    private string CounterpartyListTitle =>
        counterpartyListMode == "creditors"
            ? "بیشترین طلبکاران"
            : "بیشترین بدهکاران";
    private string CounterpartyEmptyMessage =>
        counterpartyListMode == "creditors"
            ? "حساب طلبکاری موجود نیست."
            : "حساب بدهکاری موجود نیست.";

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrenciesAsync();
        await LoadDashboardAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dashboard != null && !chartsRendered)
        {
            chartsRendered = await RenderChartsAsync();
        }
    }

    private async Task LoadCurrenciesAsync()
    {
        currencies = (await CurrencyService.GetAllAsync())
            .Where(x => x.IsActive)
            .OrderBy(x => x.Code)
            .ToList();

        var setting = await CompanySettingService.GetAsync();
        selectedCurrency = currencies
            .FirstOrDefault(x => x.Id == setting.DefaultProfitCurrencyId)?.Code
            ?? currencies.FirstOrDefault(x => x.Code == "AFN")?.Code
            ?? currencies.FirstOrDefault()?.Code
            ?? string.Empty;
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            var currency = currencies.FirstOrDefault(x => x.Code == selectedCurrency);
            if (currency == null)
                throw new InvalidOperationException("ارز انتخاب‌شده معتبر نیست.");

            dashboard = await FinancialReportService.GetDashboardSummaryAsync(
                startDate,
                endDate,
                currency.Id);
            currentCashBalances = (await JournalService.GetCurrentCashBalancesAsync()).ToList();
            cashBalanceAlerts = (await CashBalanceAlertService.GetActiveAlertsAsync()).ToList();
            UpdateLiquidityItems();
            chartsRendered = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"داشبورد بارگذاری نشد: {ex.Message}";
            dashboard = null;
            currentLiquidityItems.Clear();
            currentCashBalances.Clear();
            cashBalanceAlerts.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<bool> RenderChartsAsync()
    {
        if (dashboard == null)
            return false;

        if (!await JSRuntime.TryInvokeUiVoidAsync(
            "renderDailyChart",
            "dailyChart",
            dashboard.DailyActivities.Select(x => DisplayDates.Date(x.Date)).ToArray(),
            dashboard.DailyActivities.Select(x => x.Value).ToArray())) return false;
        if (!await JSRuntime.TryInvokeUiVoidAsync(
            "renderPeriodicChart",
            "periodicChart",
            dashboard.WeeklyProfit.Select(x => x.Label).ToArray(),
            dashboard.WeeklyProfit.Select(x => x.Value).ToArray())) return false;
        if (!await JSRuntime.TryInvokeUiVoidAsync(
            "renderLiquidityChart",
            "liquidityChart",
            currentLiquidityItems.Select(x => $"{x.AccountName} ({x.CurrencyCode})").ToArray(),
            currentLiquidityItems.Select(x => x.Amount).ToArray())) return false;
        return await JSRuntime.TryInvokeUiVoidAsync(
            "renderMiniChart",
            "miniChart",
            new[] { "حواله", "تبدیل پول", "عملیات حساب", "مصارف", "سرمایه" },
            new decimal[]
            {
                dashboard.HawalaCount,
                dashboard.ExchangeCount,
                dashboard.AccountOperationCount,
                dashboard.ExpenseCount,
                dashboard.CapitalInvestmentCount
            });
    }

    private async Task OnCurrencyChanged(ChangeEventArgs args)
    {
        selectedCurrency = args.Value?.ToString() ?? selectedCurrency;
        await LoadDashboardAsync();
    }

    private async Task ApplyDateFilter()
    {
        await LoadDashboardAsync();
    }

    private void UpdateLiquidityItems()
    {
        var all = dashboard?.Liquidity ?? new List<DashboardLiquidityDto>();
        currentLiquidityItems = liquidityFilter switch
        {
            "treasury" => all.Where(x => x.AccountType.Equals("Cash", StringComparison.OrdinalIgnoreCase)).ToList(),
            "bank" => all.Where(x => x.AccountType.Equals("Bank", StringComparison.OrdinalIgnoreCase)).ToList(),
            _ => all.ToList()
        };
        chartsRendered = false;
    }

    private async Task SetLiquidityFilterAsync(string filter)
    {
        liquidityFilter = filter;
        UpdateLiquidityItems();
        await InvokeAsync(StateHasChanged);
    }

    private Task SetAll() => SetLiquidityFilterAsync("all");
    private Task SetTreasury() => SetLiquidityFilterAsync("treasury");
    private Task SetBank() => SetLiquidityFilterAsync("bank");
    private void ShowTopDebtors() => counterpartyListMode = "debtors";
    private void ShowTopCreditors() => counterpartyListMode = "creditors";

    private void NavigateToPendingHawalas() => NavigationManager.NavigateTo("/hawala-pending");
    private void OpenHawalaModal() => showHawalaModal = true;
    private void OpenExchangeModal() => showExchangeModal = true;
    private void OpenDepositWithdrawModal() => showDepositWithdrawModal = true;

    private Task OnHawalaSaved(CreateHawalaDto _) => LoadDashboardAsync();
    private Task OnExchangeSaved(CreateMoneyExchangeOperationDto _) => LoadDashboardAsync();
    private Task OnDepositWithdrawSaved(CreateAccountMoneyOperationDto _) => LoadDashboardAsync();
}
