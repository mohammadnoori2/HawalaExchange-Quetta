@page "/"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Components.Shared.Modals
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject ICurrencyService CurrencyService
@inject ICompanySettingService CompanySettingService
@inject IFinancialReportService FinancialReportService
@inject IJournalService JournalService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>داشبورد</PageTitle>

<div class="dashboard-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title"><i class="bi bi-speedometer2"></i> داشبورد</h5>
            <span class="page-subtitle">آخرین فعالیت: @lastActivityTime</span>
        </div>
        <PageHeaderStats AriaLabel="آمار داشبورد">
            <PageHeaderStat Label="حواله" Value="@(dashboard?.HawalaCount ?? 0)" Icon="bi-send" />
            <PageHeaderStat Label="تبدیل پول" Value="@(dashboard?.ExchangeCount ?? 0)" Icon="bi-currency-exchange" Tone="info" />
            <PageHeaderStat Label="مفاد خالص" Value="@($"{MoneyFormatHelper.Format(NetProfit)} {selectedCurrency}")" Icon="bi-graph-up-arrow" Tone="success" />
        </PageHeaderStats>
        <div class="page-actions quick-links">
            <button class="quick-link-btn quick-link-hawala" @onclick="OpenHawalaModal">ثبت حواله</button>
            <button class="quick-link-btn quick-link-exchange" @onclick="OpenExchangeModal">تبدیل پول</button>
            <button class="quick-link-btn quick-link-deposit" @onclick="OpenDepositWithdrawModal">رسید / برد</button>
            <button class="quick-link-btn quick-link-pending" @onclick="NavigateToPendingHawalas">اجرای حواله</button>
        </div>
    </div>

    <div class="dashboard-header">
        <div class="header-center">
            <div class="currency-selector">
                <select @onchange="OnCurrencyChanged" value="@selectedCurrency">
                    @foreach (var currency in currencies)
                    {
                        <option value="@currency.Code">@currency.Code</option>
                    }
                </select>
            </div>
        </div>

        <div class="header-right">
            <span class="badge-live">نرخ‌های ثبت‌شده</span>
        </div>
    </div>

    <div class="currency-rates-grid">
        @if (dashboard?.Rates.Any() == true)
        {
            @foreach (var rate in dashboard.Rates)
            {
                <div class="rate-card">
                    <div class="rate-pair">@rate.Pair</div>
                    <div class="rate-value">
                        <span>خرید @MoneyFormatHelper.Format(rate.BuyRate)</span>
                        <span>فروش @MoneyFormatHelper.Format(rate.SellRate)</span>
                    </div>
                    <div class="rate-change">@PersianDateHelper.ToPersianDate(rate.EffectiveDate)</div>
                </div>
            }
        }
        else
        {
            <div class="rate-card">
                <div class="rate-pair">نرخی ثبت نشده است</div>
                <div class="rate-change">نرخ‌ها را از بخش نرخ تبادله ثبت کنید.</div>
            </div>
        }
    </div>

    <div class="table-card mb-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-safe2"></i>
                    موجودی فعلی صندوق‌ها
                </h6>
            </div>
            <div class="table-card-header-right">
                <a class="btn btn-sm btn-outline-primary" href="/daily-journal">
                    مدیریت آغاز و پایان روز
                </a>
            </div>
        </div>
        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th>صندوق</th>
                            <th>کُد حساب</th>
                            <th>ارز</th>
                            <th>موجودی فعلی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!currentCashBalances.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    هنوز برای حساب صندوق هیچ معامله‌ای با ارز ثبت نشده است.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var balance in currentCashBalances)
                            {
                                <tr>
                                    <td class="fw-bold">@balance.AccountName</td>
                                    <td dir="ltr">@balance.AccountCode</td>
                                    <td><span class="badge-modern badge-info">@balance.CurrencyCode</span></td>
                                    <td dir="ltr" class="fw-bold @(balance.Balance >= 0 ? "text-success" : "text-danger")">
                                        @MoneyFormatHelper.Format(balance.Balance)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="chart-box">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-graph-up"></i> فعالیت‌های روزانه واقعی</span>
            </div>
            <div class="chart-body"><canvas id="dailyChart"></canvas></div>
        </div>
        <div class="chart-box">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-bar-chart"></i> مفاد/ضرر هفتگی</span>
            </div>
            <div class="chart-body"><canvas id="periodicChart"></canvas></div>
        </div>
    </div>

    <div class="provision-row">
        <div class="provision-card">
            <div class="provision-label">مفاد/ضرر واقعی دوره (@selectedCurrency)</div>
            <div class="provision-amount @(NetProfit >= 0 ? "text-success" : "text-danger")">
                @MoneyFormatHelper.Format(NetProfit)
            </div>
            <div class="provision-sub">از حساب‌های عواید و مصارف لیجر</div>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/reports/profit-loss">
                مشاهده صورت حساب مفاد و ضرر
            </a>
        </div>

        <div class="top-remain-card">
            <div class="top-remain-header">
                <div class="top-remain-heading">
                    <span class="top-remain-title">@CounterpartyListTitle</span>
                    <span class="top-remain-sub">
                        مجموع به @selectedCurrency: @MoneyFormatHelper.Format(CurrentCounterpartyTotal)
                    </span>
                </div>
                <div class="top-remain-switch" role="group" aria-label="انتخاب نوع مانده حساب">
                    <button type="button"
                            class="top-remain-switch-btn @(counterpartyListMode == "debtors" ? "active debtors" : null)"
                            aria-pressed="@(counterpartyListMode == "debtors")"
                            @onclick="ShowTopDebtors">
                        بدهکاران
                    </button>
                    <button type="button"
                            class="top-remain-switch-btn @(counterpartyListMode == "creditors" ? "active creditors" : null)"
                            aria-pressed="@(counterpartyListMode == "creditors")"
                            @onclick="ShowTopCreditors">
                        طلبکاران
                    </button>
                </div>
            </div>
            <div class="top-remain-list">
                <div class="remain-header-row">
                    <span>نام حساب</span>
                    <span>نوع حساب</span>
                    <span>مبلغ</span>
                </div>
                @if (CurrentCounterpartyItems.Any())
                {
                    @foreach (var item in CurrentCounterpartyItems)
                    {
                        <div class="remain-item">
                            <span class="remain-name">
                                <span class="remain-initial">@item.Initial</span>
                                <span>@item.Name</span>
                            </span>
                            <span class="remain-account-type">@item.AccountTypeName</span>
                            <span class="remain-amount @(counterpartyListMode == "debtors" ? "debtors" : "creditors")">
                                @MoneyFormatHelper.Format(item.Amount)
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="remain-empty">@CounterpartyEmptyMessage</div>
                }
            </div>
        </div>
    </div>

    <div class="bottom-row">
        <div class="transactions-card">
            <div class="section-title">فعالیت‌های ثبت‌شده</div>
            <div class="date-filter">
                <div class="date-input-group">
                    <label>از تاریخ:</label>
                    <PersianDatePicker @bind-Value="startDate"
                                       IncludeTime="false"
                                       CssClass="form-control form-control-sm" />
                </div>
                <div class="date-input-group">
                    <label>تا تاریخ:</label>
                    <PersianDatePicker @bind-Value="endDate"
                                       IncludeTime="false"
                                       CssClass="form-control form-control-sm" />
                </div>
                <button class="btn-filter" @onclick="ApplyDateFilter" disabled="@isLoading">
                    @(isLoading ? "..." : "اعمال")
                </button>
            </div>
            <PageHeaderStats AriaLabel="آمار فعالیت‌های ثبت‌شده">
                <PageHeaderStat Label="حواله" Value="@(dashboard?.HawalaCount ?? 0)" Icon="bi-send" />
                <PageHeaderStat Label="تبدیل پول" Value="@(dashboard?.ExchangeCount ?? 0)" Icon="bi-currency-exchange" Tone="info" />
                <PageHeaderStat Label="مجموع" Value="@(dashboard?.TotalActivityCount ?? 0)" Icon="bi-collection" Tone="warning" />
                <PageHeaderStat Label="عملیات حساب" Value="@(dashboard?.AccountOperationCount ?? 0)" Icon="bi-wallet2" Tone="success" />
                <PageHeaderStat Label="مصارف/سرمایه" Value="@((dashboard?.ExpenseCount ?? 0) + (dashboard?.CapitalInvestmentCount ?? 0))" Icon="bi-cash-stack" Tone="danger" />
            </PageHeaderStats>
            <div class="mini-chart-container"><canvas id="miniChart"></canvas></div>
        </div>

        <div class="liquidity-card">
            <div class="section-title">نقدینگی به ارزش @selectedCurrency</div>
            <div class="liquidity-tabs">
                <button class="tab-btn @(liquidityFilter == "all" ? "active" : "")" @onclick="SetAll">همه</button>
                <button class="tab-btn @(liquidityFilter == "treasury" ? "active" : "")" @onclick="SetTreasury">صندوق</button>
                <button class="tab-btn @(liquidityFilter == "bank" ? "active" : "")" @onclick="SetBank">بانک</button>
            </div>
            <div class="liquidity-items">
                @if (currentLiquidityItems.Any())
                {
                    @foreach (var item in currentLiquidityItems)
                    {
                        <div class="liquidity-item">
                            <span class="liquidity-currency">@item.AccountName (@item.CurrencyCode)</span>
                            <span class="liquidity-percent">@item.Percentage.ToString("N1")%</span>
                        </div>
                    }
                }
                else
                {
                    <div class="liquidity-item">ماندهٔ قابل محاسبه موجود نیست.</div>
                }
            </div>
            <div class="liquidity-chart-container"><canvas id="liquidityChart"></canvas></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    @if (dashboard?.Warnings.Any() == true)
    {
        <div class="alert alert-warning mt-3">
            <strong>محدودیت محاسبه:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var warning in dashboard.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }
</div>

<CreateHawalaModal IsVisible="@showHawalaModal"
                   IsVisibleChanged="@((bool value) => { showHawalaModal = value; StateHasChanged(); })"
                   IsEditMode="false"
                   OnSaveSuccess="@OnHawalaSaved" />

<MoneyExchangeModal IsVisible="@showExchangeModal"
                    IsVisibleChanged="@((bool value) => { showExchangeModal = value; StateHasChanged(); })"
                    IsEditMode="false"
                    OnSaveSuccess="@OnExchangeSaved" />

<DepositWithdrawModal IsVisible="@showDepositWithdrawModal"
                      IsVisibleChanged="@((bool value) => { showDepositWithdrawModal = value; StateHasChanged(); })"
                      IsEditMode="false"
                      OnSaveSuccess="@OnDepositWithdrawSaved" />

@code {
    private DateTime startDate = DateTime.Today.AddDays(-27);
    private DateTime endDate = DateTime.Today;
    private string selectedCurrency = "AFN";
    private string lastActivityTime = "--:--:--";
    private string liquidityFilter = "all";
    private string counterpartyListMode = "debtors";
    private string? errorMessage;
    private bool isLoading;
    private bool chartsRendered;
    private bool showHawalaModal;
    private bool showExchangeModal;
    private bool showDepositWithdrawModal;
    private List<CurrencyDto> currencies = new();
    private DashboardSummaryDto? dashboard;
    private List<DashboardLiquidityDto> currentLiquidityItems = new();
    private List<CurrentCashBalanceDto> currentCashBalances = new();

    private decimal NetProfit => dashboard?.NetProfit ?? 0;
    private IReadOnlyList<DashboardDebtorDto> CurrentCounterpartyItems =>
        counterpartyListMode == "creditors"
            ? dashboard?.TopCreditors ?? []
            : dashboard?.TopDebtors ?? [];
    private decimal CurrentCounterpartyTotal =>
        counterpartyListMode == "creditors"
            ? dashboard?.TotalCounterpartyPayables ?? 0
            : dashboard?.TotalCounterpartyReceivables ?? 0;
    private string CounterpartyListTitle =>
        counterpartyListMode == "creditors"
            ? "بیشترین طلبکاران"
            : "بیشترین بدهکاران";
    private string CounterpartyEmptyMessage =>
        counterpartyListMode == "creditors"
            ? "حساب طلبکاری موجود نیست."
            : "حساب بدهکاری موجود نیست.";

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrenciesAsync();
        await LoadDashboardAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dashboard != null && !chartsRendered)
        {
            await RenderChartsAsync();
            chartsRendered = true;
        }
    }

    private async Task LoadCurrenciesAsync()
    {
        currencies = (await CurrencyService.GetAllAsync())
            .Where(x => x.IsActive)
            .OrderBy(x => x.Code)
            .ToList();

        var setting = await CompanySettingService.GetAsync();
        selectedCurrency = currencies
            .FirstOrDefault(x => x.Id == setting.DefaultProfitCurrencyId)?.Code
            ?? currencies.FirstOrDefault(x => x.Code == "AFN")?.Code
            ?? currencies.FirstOrDefault()?.Code
            ?? string.Empty;
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            var currency = currencies.FirstOrDefault(x => x.Code == selectedCurrency);
            if (currency == null)
                throw new InvalidOperationException("ارز انتخاب‌شده معتبر نیست.");

            dashboard = await FinancialReportService.GetDashboardSummaryAsync(
                startDate,
                endDate,
                currency.Id);
            currentCashBalances = (await JournalService.GetCurrentCashBalancesAsync()).ToList();
            lastActivityTime = dashboard.LastActivityAt.HasValue
                ? PersianDateHelper.ToPersianDateTime12(dashboard.LastActivityAt.Value)
                : "--:--:--";
            UpdateLiquidityItems();
            chartsRendered = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"داشبورد بارگذاری نشد: {ex.Message}";
            dashboard = null;
            currentLiquidityItems.Clear();
            currentCashBalances.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RenderChartsAsync()
    {
        if (dashboard == null)
            return;

        await JSRuntime.InvokeVoidAsync(
            "renderDailyChart",
            "dailyChart",
            dashboard.DailyActivities.Select(x => x.Label).ToArray(),
            dashboard.DailyActivities.Select(x => x.Value).ToArray());
        await JSRuntime.InvokeVoidAsync(
            "renderPeriodicChart",
            "periodicChart",
            dashboard.WeeklyProfit.Select(x => x.Label).ToArray(),
            dashboard.WeeklyProfit.Select(x => x.Value).ToArray());
        await JSRuntime.InvokeVoidAsync(
            "renderLiquidityChart",
            "liquidityChart",
            currentLiquidityItems.Select(x => $"{x.AccountName} ({x.CurrencyCode})").ToArray(),
            currentLiquidityItems.Select(x => x.Amount).ToArray());
        await JSRuntime.InvokeVoidAsync(
            "renderMiniChart",
            "miniChart",
            new[] { "حواله", "تبدیل پول", "عملیات حساب", "مصارف", "سرمایه" },
            new decimal[]
            {
                dashboard.HawalaCount,
                dashboard.ExchangeCount,
                dashboard.AccountOperationCount,
                dashboard.ExpenseCount,
                dashboard.CapitalInvestmentCount
            });
    }

    private async Task OnCurrencyChanged(ChangeEventArgs args)
    {
        selectedCurrency = args.Value?.ToString() ?? selectedCurrency;
        await LoadDashboardAsync();
    }

    private async Task ApplyDateFilter()
    {
        await LoadDashboardAsync();
    }

    private void UpdateLiquidityItems()
    {
        var all = dashboard?.Liquidity ?? new List<DashboardLiquidityDto>();
        currentLiquidityItems = liquidityFilter switch
        {
            "treasury" => all.Where(x => x.AccountType.Equals("Cash", StringComparison.OrdinalIgnoreCase)).ToList(),
            "bank" => all.Where(x => x.AccountType.Equals("Bank", StringComparison.OrdinalIgnoreCase)).ToList(),
            _ => all.ToList()
        };
        chartsRendered = false;
    }

    private async Task SetLiquidityFilterAsync(string filter)
    {
        liquidityFilter = filter;
        UpdateLiquidityItems();
        await InvokeAsync(StateHasChanged);
    }

    private Task SetAll() => SetLiquidityFilterAsync("all");
    private Task SetTreasury() => SetLiquidityFilterAsync("treasury");
    private Task SetBank() => SetLiquidityFilterAsync("bank");
    private void ShowTopDebtors() => counterpartyListMode = "debtors";
    private void ShowTopCreditors() => counterpartyListMode = "creditors";

    private void NavigateToPendingHawalas() => NavigationManager.NavigateTo("/hawala-pending");
    private void OpenHawalaModal() => showHawalaModal = true;
    private void OpenExchangeModal() => showExchangeModal = true;
    private void OpenDepositWithdrawModal() => showDepositWithdrawModal = true;

    private Task OnHawalaSaved(CreateHawalaDto _) => LoadDashboardAsync();
    private Task OnExchangeSaved(CreateMoneyExchangeOperationDto _) => LoadDashboardAsync();
    private Task OnDepositWithdrawSaved(CreateAccountMoneyOperationDto _) => LoadDashboardAsync();
}
