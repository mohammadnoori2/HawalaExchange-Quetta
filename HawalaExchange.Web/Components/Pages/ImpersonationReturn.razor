@page "/impersonation/return"
@inherits ComponentBase
<div class="card m-3" dir="rtl"><div class="card-body">
    <h5>پایان ورود به‌جای کاربر</h5>
    <p>برای پایان نشست پشتیبانی و بازگشت به حساب اصلی مدیر، تأیید کنید. در صورت انقضای نشست مدیر، ورود مجدد لازم است.</p>
    <form method="post" action="/impersonation/stop" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn btn-warning">تأیید و بازگشت به مدیریت SaaS</button></form>
</div></div>
