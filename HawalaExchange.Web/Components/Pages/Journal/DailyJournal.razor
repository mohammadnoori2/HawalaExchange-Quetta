@page "/daily-journal"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@inject IJournalService JournalService
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>روزنامچه</PageTitle>

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-journal-text"></i>
                روزنامچه
                <span class="page-subtitle">هر عملیات در یک ردیف و تمام ثبت‌های لیجر آن در بخش جزئیات</span>
            </h5>
        </div>

        <div class="page-actions">
            <button class="btn-modern btn-light-modern btn-rounded" @onclick="LoadToday" disabled="@isLoading">
                <i class="bi bi-calendar-check"></i>
                نمایش امروز
            </button>
        </div>
    </div>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="table-card journal-filter-card mb-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-funnel"></i>
                    فیلترهای روزنامچه
                </h6>
            </div>
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-calendar-range"></i>
                    @GetPeriodLabel()
                </span>
            </div>
        </div>
        <div class="table-card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-xl-2 col-md-4">
                    <label class="form-label fw-bold">از تاریخ</label>
                    <PersianDatePicker @bind-Value="filterFromDate"
                                       IncludeTime="false"
                                       Placeholder="تاریخ شروع" />
                </div>
                <div class="col-xl-2 col-md-4">
                    <label class="form-label fw-bold">تا تاریخ</label>
                    <PersianDatePicker @bind-Value="filterToDate"
                                       IncludeTime="false"
                                       Placeholder="تاریخ پایان" />
                </div>
                <div class="col-xl-2 col-md-4">
                    <label class="form-label fw-bold">نوع عملیات</label>
                    <select class="form-select" @bind="filterSourceType" @bind:event="oninput">
                        <option value="">همه عملیات</option>
                        @foreach (var source in sourceTypes)
                        {
                            <option value="@source">@source</option>
                        }
                    </select>
                </div>
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-bold">حساب</label>
                    <select class="form-select" @bind="filterAccountName" @bind:event="oninput">
                        <option value="">همه حساب‌ها</option>
                        @foreach (var accountName in accountNames)
                        {
                            <option value="@accountName">@accountName</option>
                        }
                    </select>
                </div>
                <div class="col-xl-3 col-md-6">
                    <label class="form-label fw-bold">ارز</label>
                    <select class="form-select" @bind="filterCurrencyCode" @bind:event="oninput">
                        <option value="">همه ارزها</option>
                        @foreach (var currencyCode in currencyCodes)
                        {
                            <option value="@currencyCode">@currencyCode</option>
                        }
                    </select>
                </div>
                <div class="col-lg-8">
                    <label class="form-label fw-bold">جستجو</label>
                    <div class="search-modern journal-filter-search">
                        <span class="search-icon"><i class="bi bi-search"></i></span>
                        <input type="text"
                               class="search-input"
                               placeholder="شماره سند، شرح، حساب، ارز یا جزئیات..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                        <button class="search-btn" @onclick="ClearTextSearch" title="پاک‌کردن جستجو">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="d-flex gap-2">
                        <button class="btn-modern btn-primary-modern flex-fill"
                                @onclick="LoadJournal"
                                disabled="@isLoading">
                            <i class="bi bi-search"></i>
                            تطبیق تاریخ
                        </button>
                        <button class="btn-modern btn-light-modern flex-fill"
                                @onclick="ResetFilters"
                                disabled="@isLoading">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            بازنشانی
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary"><i class="bi bi-receipt"></i></div>
                    <div>
                        <div class="stat-number">@journal.Operations.Count</div>
                        <div class="stat-label">تعداد عملیات</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info"><i class="bi bi-list-ul"></i></div>
                    <div>
                        <div class="stat-number">@journal.Entries.Count</div>
                        <div class="stat-label">ردیف‌های لیجر</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success"><i class="bi bi-coin"></i></div>
                    <div>
                        <div class="stat-number">@journal.CurrencySummaries.Count</div>
                        <div class="stat-label">تعداد ارزها</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning"><i class="bi bi-calendar-date"></i></div>
                    <div>
                        <div class="stat-number journal-date-value">@GetPeriodLabel()</div>
                        <div class="stat-label">بازه گزارش</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-bar-chart"></i>
                    خلاصهٔ ردیف‌های لیجر به تفکیک ارز
                </h6>
            </div>
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">@journal.CurrencySummaries.Count</span>
            </div>
        </div>
        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ارز</th>
                            <th>تعداد ردیف لیجر</th>
                            <th>مجموع طلبکار</th>
                            <th>مجموع بدهکار</th>
                            <th>تفاوت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!journal.CurrencySummaries.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">برای بازه انتخاب‌شده خلاصه‌ای وجود ندارد.</td>
                            </tr>
                        }
                        else
                        {
                            var summaryIndex = 1;
                            @foreach (var item in journal.CurrencySummaries)
                            {
                                <tr>
                                    <td>@summaryIndex</td>
                                    <td><span class="badge-modern badge-info">@item.CurrencyCode</span></td>
                                    <td>@item.EntriesCount</td>
                                    <td dir="ltr" class="fw-bold text-success">@item.TotalTalabKar.ToString("N2")</td>
                                    <td dir="ltr" class="fw-bold text-danger">@item.TotalBadehKar.ToString("N2")</td>
                                    <td dir="ltr" class="fw-bold">@((item.TotalTalabKar - item.TotalBadehKar).ToString("N2"))</td>
                                </tr>
                                summaryIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-receipt"></i>
                    @filteredOperations.Count عملیات
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern journal-operation-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>تاریخ</th>
                            <th>شرح روزنامچه</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="text-muted mt-2">در حال بارگذاری روزنامچه...</p>
                                </td>
                            </tr>
                        }
                        else if (!pagedOperations.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">برای فیلترهای انتخاب‌شده عملیاتی یافت نشد</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = (currentPage - 1) *
                                (pageSize == 0 ? filteredOperations.Count : pageSize) + 1;

                            @foreach (var operation in pagedOperations)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td class="journal-row-date">
                                        <strong>@PersianDateHelper.ToPersianDate(operation.CreatedAt)</strong>
                                        <span>@PersianDateHelper.ToTime12(operation.CreatedAt)</span>
                                    </td>
                                    <td class="journal-sentence">
                                        <span class="badge-modern @GetSourceBadge(operation.SourceType)">
                                            @operation.SourceType
                                        </span>
                                        <span>@operation.SummarySentence</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary journal-details-button"
                                                @onclick="() => ShowDetails(operation)">
                                            <i class="bi bi-eye"></i>
                                            جزئیات
                                        </button>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedOperations.Count</strong> از <strong>@filteredOperations.Count</strong> عملیات
                </span>
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (var page = 1; page <= totalPages; page++)
                            {
                                var pageNumber = page;
                                <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
            <div class="table-card-footer-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-calendar-check"></i>
                    @GetPeriodLabel()
                </span>
            </div>
        </div>
    </div>
</div>

@if (selectedOperation != null)
{
    <div class="journal-modal-backdrop" @onclick="CloseDetails">
        <section class="journal-detail-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="journal-modal-header">
                <div>
                    <h5>
                        <i class="bi bi-receipt-cutoff"></i>
                        جزئیات کامل @selectedOperation.SourceType
                    </h5>
                    <div class="journal-modal-subtitle">
                        سند @selectedOperation.DocumentNumber ·
                        @PersianDateHelper.ToPersianDate(selectedOperation.CreatedAt)
                        @PersianDateHelper.ToTime12(selectedOperation.CreatedAt)
                    </div>
                </div>
                <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseDetails"></button>
            </header>

            <div class="journal-modal-body">
                <div class="journal-overview-grid">
                    <div><span>نوع عملیات</span><strong>@selectedOperation.SourceType</strong></div>
                    <div><span>شماره سند</span><strong>@selectedOperation.DocumentNumber</strong></div>
                    <div><span>تعداد حساب</span><strong>@selectedOperation.AccountNames.Count</strong></div>
                    <div><span>تعداد ثبت لیجر</span><strong>@selectedOperation.LedgerEntriesCount</strong></div>
                </div>

                @if (selectedOperation.SourceDetails.Any())
                {
                    <h6 class="journal-section-title">مشخصات عملیات</h6>
                    <div class="journal-source-details">
                        @foreach (var field in selectedOperation.SourceDetails)
                        {
                            <div>
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                }

                <h6 class="journal-section-title">خلاصهٔ گردش به تفکیک ارز</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle">
                        <thead>
                            <tr>
                                <th>ارز</th>
                                <th>مجموع طلبکار</th>
                                <th>مجموع بدهکار</th>
                                <th>تفاوت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var currency in selectedOperation.CurrencySummaries)
                            {
                                <tr>
                                    <td><span class="badge-modern badge-info">@currency.CurrencyCode</span></td>
                                    <td dir="ltr" class="text-success fw-bold">@currency.TotalTalabKar.ToString("N2")</td>
                                    <td dir="ltr" class="text-danger fw-bold">@currency.TotalBadehKar.ToString("N2")</td>
                                    <td dir="ltr">@((currency.TotalTalabKar - currency.TotalBadehKar).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h6 class="journal-section-title">تمام ثبت‌های مرتبط در لیجر</h6>
                <div class="table-responsive journal-ledger-table">
                    <table class="table table-bordered table-striped table-sm align-middle">
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>تاریخ</th>
                                <th>حساب</th>
                                <th>کُد حساب</th>
                                <th>ارز</th>
                                <th>طلبکار</th>
                                <th>بدهکار</th>
                                <th>توضیحات ثبت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in selectedOperation.LedgerEntries)
                            {
                                <tr>
                                    <td dir="ltr">@entry.Id</td>
                                    <td>
                                        @PersianDateHelper.ToPersianDate(entry.CreatedAt)
                                        <small class="d-block text-muted">@PersianDateHelper.ToTime12(entry.CreatedAt)</small>
                                    </td>
                                    <td>@entry.AccountName</td>
                                    <td dir="ltr">@entry.AccountCode</td>
                                    <td>@entry.CurrencyCode</td>
                                    <td dir="ltr" class="text-success">
                                        @(entry.TalabKar > 0 ? entry.TalabKar.ToString("N2") : "-")
                                    </td>
                                    <td dir="ltr" class="text-danger">
                                        @(entry.BadehKar > 0 ? entry.BadehKar.ToString("N2") : "-")
                                    </td>
                                    <td>@(entry.Description ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="journal-operation-description">
                    <span>شرح مجموعی عملیات</span>
                    <p>@selectedOperation.Description</p>
                </div>
            </div>

            <footer class="journal-modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDetails">بستن</button>
            </footer>
        </section>
    </div>
}

@code {
    private DailyJournalDto journal = new();
    private List<JournalOperationDto> filteredOperations = new();
    private JournalOperationDto? selectedOperation;
    private DateTime filterFromDate = DateTime.Today;
    private DateTime filterToDate = DateTime.Today;
    private List<string> validationErrors = new();
    private bool isLoading;
    private List<string> sourceTypes = new();
    private List<string> accountNames = new();
    private List<string> currencyCodes = new();
    private int pageSize = 20;
    private int currentPage = 1;

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    private string _filterSourceType = string.Empty;
    private string filterSourceType
    {
        get => _filterSourceType;
        set
        {
            if (_filterSourceType != value)
            {
                _filterSourceType = value;
                ApplyFilters();
            }
        }
    }

    private string _filterAccountName = string.Empty;
    private string filterAccountName
    {
        get => _filterAccountName;
        set
        {
            if (_filterAccountName != value)
            {
                _filterAccountName = value;
                ApplyFilters();
            }
        }
    }

    private string _filterCurrencyCode = string.Empty;
    private string filterCurrencyCode
    {
        get => _filterCurrencyCode;
        set
        {
            if (_filterCurrencyCode != value)
            {
                _filterCurrencyCode = value;
                ApplyFilters();
            }
        }
    }

    private List<JournalOperationDto> pagedOperations
    {
        get
        {
            var sorted = filteredOperations
                .OrderByDescending(x => x.CreatedAt)
                .ThenByDescending(x => x.SourceId)
                .ToList();
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            return sorted.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0
        ? 1
        : (int)Math.Ceiling((double)filteredOperations.Count / pageSize);

    protected override Task OnInitializedAsync() => LoadJournal();

    private async Task LoadToday()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        await LoadJournal();
    }

    private async Task LoadJournal()
    {
        try
        {
            isLoading = true;
            validationErrors.Clear();
            selectedOperation = null;
            if (filterFromDate.Date > filterToDate.Date)
            {
                validationErrors.Add("تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.");
                return;
            }

            journal = await JournalService.GetJournalAsync(filterFromDate, filterToDate);
            sourceTypes = journal.Operations
                .Select(x => x.SourceType)
                .Distinct()
                .OrderBy(x => x)
                .ToList();
            accountNames = journal.Operations
                .SelectMany(x => x.AccountNames)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .ToList();
            currencyCodes = journal.Operations
                .SelectMany(x => x.CurrencySummaries)
                .Select(x => x.CurrencyCode)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .ToList();

            if (!sourceTypes.Contains(_filterSourceType))
                _filterSourceType = string.Empty;
            if (!accountNames.Contains(_filterAccountName))
                _filterAccountName = string.Empty;
            if (!currencyCodes.Contains(_filterCurrencyCode))
                _filterCurrencyCode = string.Empty;

            ApplyFilters();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری روزنامچه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = journal.Operations.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(operation =>
                Contains(operation.SourceType, term) ||
                Contains(operation.DocumentNumber, term) ||
                Contains(operation.SummarySentence, term) ||
                Contains(operation.Description, term) ||
                operation.AccountNames.Any(x => Contains(x, term)) ||
                operation.CurrencySummaries.Any(x => Contains(x.CurrencyCode, term)) ||
                operation.SourceDetails.Any(x => Contains(x.Label, term) || Contains(x.Value, term)) ||
                operation.LedgerEntries.Any(x =>
                    Contains(x.AccountName, term) ||
                    Contains(x.AccountCode, term) ||
                    Contains(x.Description, term)));
        }

        if (!string.IsNullOrWhiteSpace(_filterSourceType))
            query = query.Where(x => x.SourceType == _filterSourceType);

        if (!string.IsNullOrWhiteSpace(_filterAccountName))
            query = query.Where(x => x.AccountNames.Contains(_filterAccountName));

        if (!string.IsNullOrWhiteSpace(_filterCurrencyCode))
        {
            query = query.Where(x =>
                x.CurrencySummaries.Any(currency =>
                    currency.CurrencyCode == _filterCurrencyCode));
        }

        filteredOperations = query.ToList();
        currentPage = 1;
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private void ClearTextSearch()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private async Task ResetFilters()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        _searchTerm = string.Empty;
        _filterSourceType = string.Empty;
        _filterAccountName = string.Empty;
        _filterCurrencyCode = string.Empty;
        await LoadJournal();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
            currentPage = page;
    }

    private void ShowDetails(JournalOperationDto operation) => selectedOperation = operation;
    private void CloseDetails() => selectedOperation = null;

    private string GetPeriodLabel()
    {
        var fromDate = journal.FromDate == default ? filterFromDate.Date : journal.FromDate.Date;
        var toDate = journal.ToDate == default ? filterToDate.Date : journal.ToDate.Date;
        return fromDate == toDate
            ? $"تاریخ {PersianDateHelper.ToPersianDate(fromDate)}"
            : $"از {PersianDateHelper.ToPersianDate(fromDate)} تا {PersianDateHelper.ToPersianDate(toDate)}";
    }

    private static string GetSourceBadge(string sourceType) => sourceType switch
    {
        "حواله" => "badge-primary",
        "ثبت سرمایه" => "badge-success",
        "مصرف" => "badge-danger",
        "واریز / برداشت" => "badge-info",
        "تبدیل پول" => "badge-warning",
        "انتقال" => "badge-secondary",
        "تراکنش" => "badge-secondary",
        _ => "badge-secondary"
    };
}
