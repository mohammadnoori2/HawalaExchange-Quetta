@page "/daily-journal"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@inject IJournalService JournalService
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>روزنامچه</PageTitle>

<div class="page-wrapper" dir="rtl">
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-journal-text"></i>
                روزنامچه
                <span class="page-subtitle">هر عملیات در یک ردیف و تمام ثبت‌های حسابداری آن در بخش جزئیات</span>
            </h5>
        </div>

        <PageHeaderStats AriaLabel="آمار روزنامچه">
            <PageHeaderStat Label="رسید" Value="@receiptRows.Count" Icon="bi-box-arrow-in-down" Tone="success" />
            <PageHeaderStat Label="برد" Value="@withdrawalRows.Count" Icon="bi-box-arrow-up" Tone="danger" />
            <PageHeaderStat Label="ارزها" Value="@journal.CurrencySummaries.Count" Icon="bi-coin" Tone="success" />
            <PageHeaderStat Label="بازه" Value="@GetPeriodLabel()" Icon="bi-calendar-date" Tone="warning" />
        </PageHeaderStats>
        <div class="page-actions">
            <button class="btn-modern btn-light-modern btn-rounded" @onclick="LoadToday" disabled="@isLoading">
                <i class="bi bi-calendar-check"></i>
                نمایش امروز
            </button>
        </div>
    </div>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-1"></i>
            @successMessage
        </div>
    }

    <CompactFilterBar AriaLabel="جستجو و فیلتر روزنامچه"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(filterSourceType) || !string.IsNullOrWhiteSpace(filterAccountName) || !string.IsNullOrWhiteSpace(filterCurrencyCode) || filterFromDate.Date != DateTime.Today || filterToDate.Date != DateTime.Today)"
                      ActiveFilterCount="@((!string.IsNullOrWhiteSpace(filterAccountName) ? 1 : 0) + (filterFromDate.Date != DateTime.Today ? 1 : 0) + (filterToDate.Date != DateTime.Today ? 1 : 0))"
                      Reset="ResetFilters">
        <SearchContent>
            <input type="text"
                   class="form-control"
                   placeholder="شماره سند، شرح، حساب، ارز یا جزئیات..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" aria-label="نوع عملیات" @bind="filterSourceType" @bind:event="oninput">
                <option value="">همه عملیات</option>
                @foreach (var source in sourceTypes)
                {
                    <option value="@source">@GetSourceTypeName(source)</option>
                }
            </select>
            <select class="form-select compact-quick-filter" aria-label="ارز" @bind="filterCurrencyCode" @bind:event="oninput">
                <option value="">همه ارزها</option>
                @foreach (var currencyCode in currencyCodes)
                {
                    <option value="@currencyCode">@currencyCode</option>
                }
            </select>
        </QuickFilters>
        <AdvancedFilters>
                <div class="compact-filter-field">
                    <label class="form-label">از تاریخ</label>
                    <PersianDatePicker @bind-Value="filterFromDate"
                                       @bind-Value:after="LoadJournal"
                                       IncludeTime="false"
                                       Placeholder="تاریخ شروع" />
                </div>
                <div class="compact-filter-field">
                    <label class="form-label">تا تاریخ</label>
                    <PersianDatePicker @bind-Value="filterToDate"
                                       @bind-Value:after="LoadJournal"
                                       IncludeTime="false"
                                       Placeholder="تاریخ پایان" />
                </div>
                <div class="compact-filter-field">
                    <label class="form-label">حساب</label>
                    <SearchableTextSelect Items="@accountNames"
                                          @bind-Value="filterAccountName"
                                          Placeholder="جستجوی حساب..."
                                          AllowClear="true"
                                          ClearText="همه حساب‌ها" />
                </div>
        </AdvancedFilters>
    </CompactFilterBar>

    <div class="table-card cash-day-card mb-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-safe2"></i>
                    موجودی صندوق
                </h6>
            </div>
            <div class="table-card-header-right">
                @if (IsSingleDay)
                {
                    <span class="badge-modern @(IsCashDayClosed ? "badge-success" : "badge-warning")">
                        @(IsCashDayClosed ? "روز بسته شده" : "روز باز است")
                    </span>
                }
            </div>
        </div>
        <div class="table-card-body">
            @if (!IsSingleDay)
            {
                <div class="alert alert-info m-3">
                    برای مشاهده و ویرایش موجودی آغاز صندوق، در فیلتر «از تاریخ» و «تا تاریخ» یک روز یکسان را انتخاب کنید.
                </div>
            }
            else if (isCashLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <span class="text-muted me-2">در حال بارگذاری موجودی صندوق...</span>
                </div>
            }
            else if (!cashDailyBalances.Any())
            {
                <div class="empty-state py-4">
                    <i class="bi bi-safe"></i>
                    <span class="text-muted">هنوز برای حساب صندوق هیچ معامله‌ای با ارز ثبت نشده است.</span>
                </div>
            }
            else
            {
                <div class="cash-day-note">
                    <div>
                        <strong>تاریخ:</strong>
                        @PersianDateHelper.ToPersianDate(SelectedCashDate)
                    </div>
                    <div>
                        موجودی فعلی روز = موجودی آغاز + گردش بدهکار صندوق − گردش طلبکار صندوق
                    </div>
                </div>

                <div class="table-scroll-wrapper">
                    <GlobalDataGrid class="table-modern table-striped-modern cash-day-table">
                        <thead>
                            <tr>
                                <th>صندوق</th>
                                <th>ارز</th>
                                <th>موجودی آغاز روز</th>
                                <th>گردش خالص روز</th>
                                <th>موجودی فعلی/پایان</th>
                                <th>موجودی پایان ذخیره‌شده</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var balance in cashDailyBalances)
                            {
                                <tr>
                                    <td>
                                        <strong>@balance.AccountName</strong>
                                        <small class="d-block text-muted" dir="ltr">@balance.AccountCode</small>
                                    </td>
                                    <td><span class="badge-modern badge-info">@balance.CurrencyCode</span></td>
                                    <td class="cash-opening-input">
                                        <MoneyInput class="form-control form-control-sm"
                                                    DecimalPlaces="@balance.DecimalPlaces"
                                                    Value="@balance.OpeningBalance"
                                                    ValueChanged="@((decimal value) => balance.OpeningBalance = value)"
                                                    min="0" />
                                    </td>
                                    <td dir="ltr" class="@(balance.DailyMovement >= 0 ? "text-success" : "text-danger") fw-bold">
                                        @MoneyFormatHelper.Format(balance.DailyMovement)
                                    </td>
                                    <td dir="ltr" class="fw-bold text-primary">
                                        @MoneyFormatHelper.Format(balance.CurrentBalance)
                                    </td>
                                    <td dir="ltr">
                                        @if (balance.IsClosed && balance.ClosingBalance.HasValue)
                                        {
                                            <span class="fw-bold text-success">
                                                @MoneyFormatHelper.Format(balance.ClosingBalance.Value)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">هنوز بسته نشده</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </GlobalDataGrid>
                </div>

                <div class="cash-day-actions">
                    <button class="btn-modern btn-primary-modern"
                            @onclick="SaveCashOpeningBalances"
                            disabled="@(isCashLoading || isLoading)">
                        <i class="bi bi-save"></i>
                        ذخیره تغییرات موجودی آغاز
                    </button>
                    <button class="btn-modern btn-success-modern"
                            @onclick="CloseCashDay"
                            disabled="@(isCashLoading || isLoading || SelectedCashDate > DateTime.Today)">
                        <i class="bi bi-calendar2-check"></i>
                        @(IsCashDayClosed
                            ? "به‌روزرسانی پایان روز و انتقال به فردا"
                            : "بستن روز و انتقال موجودی پایان به فردا")
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <h6 class="mb-0 text-primary">
                    <i class="bi bi-bar-chart"></i>
                    خلاصهٔ ثبت‌های حسابداری به تفکیک ارز
                </h6>
            </div>
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">@journal.CurrencySummaries.Count</span>
            </div>
        </div>
        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ارز</th>
                            <th>تعداد ثبت</th>
                            <th>مجموع طلبکار</th>
                            <th>مجموع بدهکار</th>
                            <th>تفاوت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!journal.CurrencySummaries.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">برای بازه انتخاب‌شده خلاصه‌ای وجود ندارد.</td>
                            </tr>
                        }
                        else
                        {
                            var summaryIndex = 1;
                            @foreach (var item in journal.CurrencySummaries)
                            {
                                <tr>
                                    <td>@summaryIndex</td>
                                    <td><span class="badge-modern badge-info">@item.CurrencyCode</span></td>
                                    <td>@item.EntriesCount</td>
                                    <td dir="ltr" class="fw-bold text-success">@MoneyFormatHelper.Format(item.TotalTalabKar)</td>
                                    <td dir="ltr" class="fw-bold text-danger">@MoneyFormatHelper.Format(item.TotalBadehKar)</td>
                                    <td dir="ltr" class="fw-bold">@MoneyFormatHelper.Format(item.TotalTalabKar - item.TotalBadehKar)</td>
                                </tr>
                                summaryIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>
    </div>

    <div class="journal-split-grid">
        <section class="table-card journal-movement-card journal-receipt-card">
            <div class="table-card-header">
                <div class="table-card-header-left">
                    <h6 class="mb-0 text-success">
                        <i class="bi bi-box-arrow-in-down"></i>
                        رسید
                        <small>پول واردشده به صندوق</small>
                    </h6>
                </div>
                <div class="table-card-header-right">
                    <span class="badge-modern badge-success">@receiptRows.Count مورد</span>
                </div>
            </div>
            <div class="table-card-body">
                <div class="table-scroll-wrapper">
                    <GlobalDataGrid class="table-modern table-striped-modern journal-movement-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>تاریخ</th>
                                <th>شرح</th>
                                <th>مبلغ رسید</th>
                                <th>جزئیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>
                            }
                            else if (!pagedReceiptRows.Any())
                            {
                                <tr><td colspan="5" class="text-center py-5 text-muted">پولی به صندوق وارد نشده است.</td></tr>
                            }
                            else
                            {
                                var receiptIndex = GetFirstRowNumber(receiptCurrentPage);
                                @foreach (var row in pagedReceiptRows)
                                {
                                    <tr>
                                        <td class="text-muted fw-bold">@receiptIndex</td>
                                        <td class="journal-row-date"><AppDateTime Value="@row.Operation.CreatedAt" ShowSeconds="true" /></td>
                                        <td class="journal-sentence">
                                            <span class="badge-modern @GetSourceBadge(row.Operation.SourceType)">@GetSourceTypeName(row.Operation.SourceType)</span>
                                            <span>@row.Operation.SummarySentence</span>
                                            <small class="journal-cash-accounts">صندوق: @string.Join("، ", row.AccountNames)</small>
                                        </td>
                                        <td class="journal-movement-amount">
                                            @foreach (var amount in row.Amounts)
                                            {
                                                <span dir="ltr"><strong>@MoneyFormatHelper.Format(amount.Amount)</strong> @amount.CurrencyCode</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary journal-icon-button" title="مشاهده جزئیات" @onclick="() => ShowDetails(row.Operation)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    receiptIndex++;
                                }
                            }
                        </tbody>
                    </GlobalDataGrid>
                </div>
            </div>
            <div class="table-card-footer journal-movement-footer">
                <span class="text-muted small">
                    نمایش <strong>@pagedReceiptRows.Count</strong> از <strong>@receiptRows.Count</strong>
                </span>
                <CompactPagination CurrentPage="receiptCurrentPage"
                                   TotalPages="receiptTotalPages"
                                   PageChanged="GoToReceiptPage" />
            </div>
        </section>

        <section class="table-card journal-movement-card journal-withdrawal-card">
            <div class="table-card-header">
                <div class="table-card-header-left">
                    <h6 class="mb-0 text-danger">
                        <i class="bi bi-box-arrow-up"></i>
                        برد
                        <small>پول برداشته‌شده از صندوق</small>
                    </h6>
                </div>
                <div class="table-card-header-right">
                    <span class="badge-modern badge-danger">@withdrawalRows.Count مورد</span>
                </div>
            </div>
            <div class="table-card-body">
                <div class="table-scroll-wrapper">
                    <GlobalDataGrid class="table-modern table-striped-modern journal-movement-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>تاریخ</th>
                                <th>شرح</th>
                                <th>مبلغ برد</th>
                                <th>جزئیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-danger"></div></td></tr>
                            }
                            else if (!pagedWithdrawalRows.Any())
                            {
                                <tr><td colspan="5" class="text-center py-5 text-muted">پولی از صندوق برداشته نشده است.</td></tr>
                            }
                            else
                            {
                                var withdrawalIndex = GetFirstRowNumber(withdrawalCurrentPage);
                                @foreach (var row in pagedWithdrawalRows)
                                {
                                    <tr>
                                        <td class="text-muted fw-bold">@withdrawalIndex</td>
                                        <td class="journal-row-date"><AppDateTime Value="@row.Operation.CreatedAt" ShowSeconds="true" /></td>
                                        <td class="journal-sentence">
                                            <span class="badge-modern @GetSourceBadge(row.Operation.SourceType)">@GetSourceTypeName(row.Operation.SourceType)</span>
                                            <span>@row.Operation.SummarySentence</span>
                                            <small class="journal-cash-accounts">صندوق: @string.Join("، ", row.AccountNames)</small>
                                        </td>
                                        <td class="journal-movement-amount">
                                            @foreach (var amount in row.Amounts)
                                            {
                                                <span dir="ltr"><strong>@MoneyFormatHelper.Format(amount.Amount)</strong> @amount.CurrencyCode</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary journal-icon-button" title="مشاهده جزئیات" @onclick="() => ShowDetails(row.Operation)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    withdrawalIndex++;
                                }
                            }
                        </tbody>
                    </GlobalDataGrid>
                </div>
            </div>
            <div class="table-card-footer journal-movement-footer">
                <span class="text-muted small">
                    نمایش <strong>@pagedWithdrawalRows.Count</strong> از <strong>@withdrawalRows.Count</strong>
                </span>
                <CompactPagination CurrentPage="withdrawalCurrentPage"
                                   TotalPages="withdrawalTotalPages"
                                   PageChanged="GoToWithdrawalPage" />
            </div>
        </section>
    </div>

    <div class="journal-split-controls">
        <span class="badge-modern badge-info">
            <i class="bi bi-calendar-check"></i>
            @GetPeriodLabel()
        </span>
        <PageSizeSelector @bind-Value="pageSize"
                          @bind-CurrentPage="receiptCurrentPage"
                          Changed="ResetMovementPages"
                          PersistenceKey="daily-journal-movements" />
    </div>
</div>

@if (selectedOperation != null)
{
    <div class="journal-modal-backdrop" @onclick="CloseDetails">
        <section class="journal-detail-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="journal-modal-header">
                <div>
                    <h5>
                        <i class="bi bi-receipt-cutoff"></i>
                        جزئیات کامل @GetSourceTypeName(selectedOperation.SourceType)
                    </h5>
                    <div class="journal-modal-subtitle d-flex align-items-center gap-2">
                        <span>سند @selectedOperation.DocumentNumber ·</span>
                        <AppDateTime Value="@selectedOperation.CreatedAt" ShowSeconds="true" />
                    </div>
                </div>
                <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseDetails"></button>
            </header>

            <div class="journal-modal-body">
                <div class="journal-overview-grid">
                    <div><span>نوع عملیات</span><strong>@GetSourceTypeName(selectedOperation.SourceType)</strong></div>
                    <div><span>شماره سند</span><strong>@selectedOperation.DocumentNumber</strong></div>
                    <div><span>تعداد حساب</span><strong>@selectedOperation.AccountNames.Count</strong></div>
                    <div><span>تعداد ثبت حسابداری</span><strong>@selectedOperation.LedgerEntriesCount</strong></div>
                </div>

                @if (selectedOperation.SourceDetails.Any())
                {
                    <h6 class="journal-section-title">مشخصات عملیات</h6>
                    <div class="journal-source-details">
                        @foreach (var field in selectedOperation.SourceDetails)
                        {
                            <div>
                                <span>@field.Label</span>
                                <strong>@field.Value</strong>
                            </div>
                        }
                    </div>
                }

                <h6 class="journal-section-title">خلاصهٔ گردش به تفکیک ارز</h6>
                <div class="table-responsive">
                    <GlobalDataGrid class="table table-bordered table-sm align-middle">
                        <thead>
                            <tr>
                                <th>ارز</th>
                                <th>مجموع طلبکار</th>
                                <th>مجموع بدهکار</th>
                                <th>تفاوت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var currency in selectedOperation.CurrencySummaries)
                            {
                                <tr>
                                    <td><span class="badge-modern badge-info">@currency.CurrencyCode</span></td>
                                    <td dir="ltr" class="text-success fw-bold">@MoneyFormatHelper.Format(currency.TotalTalabKar)</td>
                                    <td dir="ltr" class="text-danger fw-bold">@MoneyFormatHelper.Format(currency.TotalBadehKar)</td>
                                    <td dir="ltr">@MoneyFormatHelper.Format(currency.TotalTalabKar - currency.TotalBadehKar)</td>
                                </tr>
                            }
                        </tbody>
                    </GlobalDataGrid>
                </div>

                <h6 class="journal-section-title">تمام ثبت‌های حسابداری مرتبط</h6>
                <div class="table-responsive journal-ledger-table">
                    <GlobalDataGrid class="table table-bordered table-striped table-sm align-middle">
                        <thead>
                            <tr>
                                <th>شناسه</th>
                                <th>تاریخ</th>
                                <th>حساب</th>
                                <th>کُد حساب</th>
                                <th>ارز</th>
                                <th>طلبکار</th>
                                <th>بدهکار</th>
                                <th>توضیحات ثبت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in selectedOperation.LedgerEntries)
                            {
                                <tr>
                                    <td dir="ltr">@entry.Id</td>
                                    <td><AppDateTime Value="@entry.CreatedAt" ShowSeconds="true" /></td>
                                    <td>@entry.AccountName</td>
                                    <td dir="ltr">@entry.AccountCode</td>
                                    <td>@entry.CurrencyCode</td>
                                    <td dir="ltr" class="text-success">
                                        @(entry.TalabKar > 0 ? MoneyFormatHelper.Format(entry.TalabKar) : "-")
                                    </td>
                                    <td dir="ltr" class="text-danger">
                                        @(entry.BadehKar > 0 ? MoneyFormatHelper.Format(entry.BadehKar) : "-")
                                    </td>
                                    <td>@(entry.Description ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </GlobalDataGrid>
                </div>

                <div class="journal-operation-description">
                    <span>شرح مجموعی عملیات</span>
                    <p>@selectedOperation.Description</p>
                </div>
            </div>

            <footer class="journal-modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDetails">بستن</button>
            </footer>
        </section>
    </div>
}

@code {
    private DailyJournalDto journal = new();
    private List<JournalOperationDto> filteredOperations = new();
    private JournalOperationDto? selectedOperation;
    private DateTime filterFromDate = DateTime.Today;
    private DateTime filterToDate = DateTime.Today;
    private List<string> validationErrors = new();
    private bool isLoading;
    private List<string> sourceTypes = new();
    private List<string> accountNames = new();
    private List<string> currencyCodes = new();
    private List<CashDailyBalanceDto> cashDailyBalances = new();
    private List<CashJournalRow> receiptRows = new();
    private List<CashJournalRow> withdrawalRows = new();
    private int pageSize = 20;
    private int receiptCurrentPage = 1;
    private int withdrawalCurrentPage = 1;
    private bool isCashLoading;
    private string successMessage = string.Empty;

    private bool IsSingleDay => filterFromDate.Date == filterToDate.Date;
    private DateTime SelectedCashDate => filterFromDate.Date;
    private bool IsCashDayClosed =>
        cashDailyBalances.Count > 0 && cashDailyBalances.All(x => x.IsClosed);

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    private string _filterSourceType = string.Empty;
    private string filterSourceType
    {
        get => _filterSourceType;
        set
        {
            if (_filterSourceType != value)
            {
                _filterSourceType = value;
                ApplyFilters();
            }
        }
    }

    private string _filterAccountName = string.Empty;
    private string filterAccountName
    {
        get => _filterAccountName;
        set
        {
            if (_filterAccountName != value)
            {
                _filterAccountName = value;
                ApplyFilters();
            }
        }
    }

    private string _filterCurrencyCode = string.Empty;
    private string filterCurrencyCode
    {
        get => _filterCurrencyCode;
        set
        {
            if (_filterCurrencyCode != value)
            {
                _filterCurrencyCode = value;
                ApplyFilters();
            }
        }
    }

    private List<CashJournalRow> pagedReceiptRows => GetPage(receiptRows, receiptCurrentPage);
    private List<CashJournalRow> pagedWithdrawalRows => GetPage(withdrawalRows, withdrawalCurrentPage);
    private int receiptTotalPages => GetTotalPages(receiptRows.Count);
    private int withdrawalTotalPages => GetTotalPages(withdrawalRows.Count);

    protected override Task OnInitializedAsync() => LoadJournal();

    private async Task LoadToday()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        await LoadJournal();
    }

    private async Task LoadJournal()
    {
        try
        {
            isLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;
            selectedOperation = null;
            if (filterFromDate.Date > filterToDate.Date)
            {
                validationErrors.Add("تاریخ شروع نمی‌تواند بعد از تاریخ پایان باشد.");
                return;
            }

            journal = await JournalService.GetJournalAsync(filterFromDate, filterToDate);
            if (IsSingleDay)
                await LoadCashBalances();
            else
                cashDailyBalances.Clear();
            sourceTypes = journal.Operations
                .Select(x => x.SourceType)
                .Distinct()
                .OrderBy(x => x)
                .ToList();
            accountNames = journal.Operations
                .SelectMany(x => x.AccountNames)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .ToList();
            currencyCodes = journal.Operations
                .SelectMany(x => x.CurrencySummaries)
                .Select(x => x.CurrencyCode)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .ToList();

            if (!sourceTypes.Contains(_filterSourceType))
                _filterSourceType = string.Empty;
            if (!accountNames.Contains(_filterAccountName))
                _filterAccountName = string.Empty;
            if (!currencyCodes.Contains(_filterCurrencyCode))
                _filterCurrencyCode = string.Empty;

            ApplyFilters();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری روزنامچه: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCashBalances()
    {
        try
        {
            isCashLoading = true;
            cashDailyBalances = (await JournalService
                    .GetCashDailyBalancesAsync(SelectedCashDate))
                .ToList();
        }
        finally
        {
            isCashLoading = false;
        }
    }

    private async Task SaveCashOpeningBalances()
    {
        try
        {
            isCashLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;
            await JournalService.SaveCashOpeningBalancesAsync(
                SelectedCashDate,
                cashDailyBalances.Select(x => new UpdateCashOpeningBalanceDto
                {
                    AccountId = x.AccountId,
                    CurrencyId = x.CurrencyId,
                    OpeningBalance = x.OpeningBalance
                }).ToList());
            await LoadCashBalances();
            successMessage = "موجودی آغاز روز صندوق با موفقیت ذخیره شد.";
        }
        catch (Exception ex)
        {
            validationErrors.Add($"ذخیره موجودی آغاز روز انجام نشد: {ex.Message}");
        }
        finally
        {
            isCashLoading = false;
        }
    }

    private async Task CloseCashDay()
    {
        try
        {
            isCashLoading = true;
            validationErrors.Clear();
            successMessage = string.Empty;
            await JournalService.SaveCashOpeningBalancesAsync(
                SelectedCashDate,
                cashDailyBalances.Select(x => new UpdateCashOpeningBalanceDto
                {
                    AccountId = x.AccountId,
                    CurrencyId = x.CurrencyId,
                    OpeningBalance = x.OpeningBalance
                }).ToList());
            await JournalService.CloseCashDayAsync(SelectedCashDate);
            await LoadCashBalances();
            successMessage =
                $"روز بسته شد و موجودی پایان {PersianDateHelper.ToPersianDate(SelectedCashDate)} " +
                $"به عنوان موجودی آغاز {PersianDateHelper.ToPersianDate(SelectedCashDate.AddDays(1))} تعیین گردید.";
        }
        catch (Exception ex)
        {
            validationErrors.Add($"بستن روز انجام نشد: {ex.Message}");
        }
        finally
        {
            isCashLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var query = journal.Operations.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(operation =>
                Contains(operation.SourceType, term) ||
                Contains(operation.DocumentNumber, term) ||
                Contains(operation.SummarySentence, term) ||
                Contains(operation.Description, term) ||
                operation.AccountNames.Any(x => Contains(x, term)) ||
                operation.CurrencySummaries.Any(x => Contains(x.CurrencyCode, term)) ||
                operation.SourceDetails.Any(x => Contains(x.Label, term) || Contains(x.Value, term)) ||
                operation.LedgerEntries.Any(x =>
                    Contains(x.AccountName, term) ||
                    Contains(x.AccountCode, term) ||
                    Contains(x.Description, term)));
        }

        if (!string.IsNullOrWhiteSpace(_filterSourceType))
            query = query.Where(x => x.SourceType == _filterSourceType);

        if (!string.IsNullOrWhiteSpace(_filterAccountName))
            query = query.Where(x => x.AccountNames.Contains(_filterAccountName));

        if (!string.IsNullOrWhiteSpace(_filterCurrencyCode))
        {
            query = query.Where(x =>
                x.CurrencySummaries.Any(currency =>
                    currency.CurrencyCode == _filterCurrencyCode));
        }

        filteredOperations = query.ToList();
        receiptRows = BuildCashRows(filteredOperations, isReceipt: true);
        withdrawalRows = BuildCashRows(filteredOperations, isReceipt: false);
        ResetMovementPages();
    }

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private void ClearTextSearch()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private async Task ResetFilters()
    {
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        _searchTerm = string.Empty;
        _filterSourceType = string.Empty;
        _filterAccountName = string.Empty;
        _filterCurrencyCode = string.Empty;
        await LoadJournal();
    }

    private void GoToReceiptPage(int page)
    {
        if (page >= 1 && page <= receiptTotalPages)
            receiptCurrentPage = page;
    }

    private void GoToWithdrawalPage(int page)
    {
        if (page >= 1 && page <= withdrawalTotalPages)
            withdrawalCurrentPage = page;
    }

    private void ResetMovementPages()
    {
        receiptCurrentPage = 1;
        withdrawalCurrentPage = 1;
    }

    private int GetFirstRowNumber(int page) => pageSize == 0 ? 1 : ((page - 1) * pageSize) + 1;

    private int GetTotalPages(int count) => pageSize == 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling((double)count / pageSize));

    private List<CashJournalRow> GetPage(List<CashJournalRow> rows, int page)
    {
        if (pageSize == 0)
            return rows;

        return rows.Skip((page - 1) * pageSize).Take(pageSize).ToList();
    }

    private static List<CashJournalRow> BuildCashRows(
        IEnumerable<JournalOperationDto> operations,
        bool isReceipt)
    {
        var rows = new List<CashJournalRow>();
        foreach (var operation in operations
                     .OrderByDescending(x => x.CreatedAt)
                     .ThenByDescending(x => x.SourceId))
        {
            var cashEntries = operation.LedgerEntries
                .Where(x => x.IsCashAccount && (isReceipt ? x.BadehKar > 0 : x.TalabKar > 0))
                .ToList();
            if (cashEntries.Count == 0)
                continue;

            rows.Add(new CashJournalRow
            {
                Operation = operation,
                AccountNames = cashEntries
                    .Select(x => x.AccountName)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .ToList(),
                Amounts = cashEntries
                    .GroupBy(x => x.CurrencyCode)
                    .Select(group => new CashJournalAmount
                    {
                        CurrencyCode = group.Key,
                        Amount = group.Sum(x => isReceipt ? x.BadehKar : x.TalabKar)
                    })
                    .OrderBy(x => x.CurrencyCode)
                    .ToList()
            });
        }

        return rows;
    }

    private void ShowDetails(JournalOperationDto operation) => selectedOperation = operation;
    private void CloseDetails() => selectedOperation = null;

    private string GetPeriodLabel()
    {
        var fromDate = journal.FromDate == default ? filterFromDate.Date : journal.FromDate.Date;
        var toDate = journal.ToDate == default ? filterToDate.Date : journal.ToDate.Date;
        return fromDate == toDate
            ? $"تاریخ {PersianDateHelper.ToPersianDate(fromDate)}"
            : $"از {PersianDateHelper.ToPersianDate(fromDate)} تا {PersianDateHelper.ToPersianDate(toDate)}";
    }

    private static string GetSourceBadge(string sourceType) => sourceType switch
    {
        "حواله" => "badge-primary",
        "ثبت سرمایه" => "badge-success",
        "مصرف" => "badge-danger",
        "واریز / برداشت / پرداخت" => "badge-info",
        "تبدیل پول" => "badge-warning",
        "انتقال" => "badge-secondary",
        "تراکنش" => "badge-secondary",
        _ => "badge-secondary"
    };

    private static string GetSourceTypeName(string sourceType) =>
        sourceType == "واریز / برداشت / پرداخت" ? "رسید / برد" : sourceType;

    private sealed class CashJournalRow
    {
        public JournalOperationDto Operation { get; init; } = new();
        public List<string> AccountNames { get; init; } = new();
        public List<CashJournalAmount> Amounts { get; init; } = new();
    }

    private sealed class CashJournalAmount
    {
        public string CurrencyCode { get; init; } = string.Empty;
        public decimal Amount { get; init; }
    }
}
