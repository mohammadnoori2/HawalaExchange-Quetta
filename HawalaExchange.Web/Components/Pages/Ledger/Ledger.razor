@page "/ledger"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject ILedgerService LedgerService
@inject IAccountService AccountService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-journal"></i>
                دفتر کل
                <span class="page-subtitle">مشاهده و جستجوی تراکنش‌های دفتر کل</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-info-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> ثبت جدید
            </button>
            <button class="btn-modern btn-success-modern btn-rounded" @onclick="() => ExportToExcel()">
                <i class="bi bi-file-earmark-excel"></i> خروجی اکسل
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-journal"></i>
                    </div>
                    <div>
                        <div class="stat-number">@ledgerEntries.Count</div>
                        <div class="stat-label">تعداد کل تراکنش‌ها</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@ledgerEntries.Count(e => e.TalabKar > 0)</div>
                        <div class="stat-label">تعداد بدهکار</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@ledgerEntries.Count(e => e.BadehKar > 0)</div>
                        <div class="stat-label">تعداد بستانکار</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-currency-exchange"></i>
                    </div>
                    <div>
                        <div class="stat-number">@ledgerEntries.Select(e => e.CurrencyCode).Distinct().Count()</div>
                        <div class="stat-label">تعداد ارزها</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت فیلتر و جستجو -->
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">جستجو</label>
                    <input type="text" class="form-control" placeholder="شماره تراکنش، حساب..."
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">حساب</label>
                    <select class="form-select" @bind="filterAccountId" @bind:event="oninput">
                        <option value="0">همه حساب‌ها</option>
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">@account.AccountName (@account.AccountCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">ارز</label>
                    <select class="form-select" @bind="filterCurrencyId" @bind:event="oninput">
                        <option value="0">همه ارزها</option>
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">از تاریخ</label>
                    <PersianDatePicker @bind-Value="fromDate" IncludeTime="false" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">تا تاریخ</label>
                    <PersianDatePicker @bind-Value="toDate" IncludeTime="false" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary-modern btn-modern w-100" @onclick="ApplyFilters">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredEntries.Count
                </span>
                <span class="badge-modern badge-success">
                    <i class="bi bi-currency-dollar"></i> جمع بدهکار: @filteredEntries.Sum(e => e.TalabKar).ToString("N2")
                </span>
                <span class="badge-modern badge-danger">
                    <i class="bi bi-currency-dollar"></i> جمع بستانکار: @filteredEntries.Sum(e => e.BadehKar).ToString("N2")
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "TransactionNo" ? "active" : "")" @onclick="@(() => SortBy("TransactionNo"))">
                                شماره تراکنش
                                @if (sortColumn == "TransactionNo")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "AccountName" ? "active" : "")" @onclick="@(() => SortBy("AccountName"))">
                                حساب
                                @if (sortColumn == "AccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("CurrencyCode"))">
                                ارز
                                @if (sortColumn == "CurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "TalabKar" ? "active" : "")" @onclick="@(() => SortBy("TalabKar"))">
                                بدهکار
                                @if (sortColumn == "TalabKar")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "BadehKar" ? "active" : "")" @onclick="@(() => SortBy("BadehKar"))">
                                بستانکار
                                @if (sortColumn == "BadehKar")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CreatedAt" ? "active" : "")" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>توضیحات</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && ledgerEntries == null)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedEntries.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-journal"></i>
                                        <span class="fs-5 text-muted">هیچ تراکنشی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن تراکنش جدید، دکمه "ثبت جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredEntries.Count : pageSize) + 1;
                            @foreach (var entry in pagedEntries)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="fw-bold text-primary">@entry.TransactionNo</span>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="fw-semibold">@entry.AccountName</span>
                                            <br />
                                            <small class="text-muted">@entry.AccountCode</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@entry.CurrencyCode</span>
                                    </td>
                                    <td class="text-danger fw-bold">
                                        @(entry.TalabKar > 0 ? entry.TalabKar.ToString("N2") : "-")
                                    </td>
                                    <td class="text-success fw-bold">
                                        @(entry.BadehKar > 0 ? entry.BadehKar.ToString("N2") : "-")
                                    </td>
                                    <td dir="ltr">@PersianDateHelper.ToPersianDateTime12(entry.CreatedAt)</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(entry.Description))
                                        {
                                            <span class="text-muted small">@entry.Description</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewEntry(entry.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="action-btn action-btn-transaction" @onclick="() => ViewTransaction(entry.TransactionId)" title="مشاهده تراکنش">
                                                <i class="bi bi-receipt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedEntries.Count</strong> از <strong>@filteredEntries.Count</strong> تراکنش
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-arrow-up"></i> بدهکار: @filteredEntries.Sum(e => e.TalabKar).ToString("N2")
                </span>
                <span class="badge-modern badge-danger">
                    <i class="bi bi-arrow-down"></i> بستانکار: @filteredEntries.Sum(e => e.BadehKar).ToString("N2")
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- مودال ایجاد ورودی جدید دفتر کل -->
<!-- ============================================================ -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-journal-plus me-2"></i>
                        ثبت ورودی جدید دفتر کل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات ورودی -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-journal me-2"></i> اطلاعات ورودی
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-receipt text-muted me-1"></i> حساب <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" @bind="newEntry.AccountId">
                                        <option value="0">انتخاب حساب</option>
                                        @foreach (var account in accounts)
                                        {
                                            <option value="@account.Id">@account.AccountName (@account.AccountCode)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-currency-exchange text-muted me-1"></i> ارز <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" @bind="newEntry.CurrencyId">
                                        <option value="0">انتخاب ارز</option>
                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-up text-muted me-1"></i> بدهکار
                                    </label>
                                    <MoneyInput class="form-control"
                                                @bind-Value="newEntry.TalabKar" placeholder="مقدار بدهکار" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-down text-muted me-1"></i> بستانکار
                                    </label>
                                    <MoneyInput class="form-control"
                                                @bind-Value="newEntry.BadehKar" placeholder="مقدار بستانکار" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <input type="text" class="form-control" @bind="newEntry.Description" placeholder="توضیحات (اختیاری)" />
                                </div>
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <small>حداقل یکی از فیلدهای بدهکار یا بستانکار باید پر شود. مبالغ باید مثبت باشند.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveEntry()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        ثبت
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- مودال مشاهده جزئیات ورودی -->
<!-- ============================================================ -->
@if (showDetailModal && selectedEntry != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i> جزئیات ورودی دفتر کل
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">شماره تراکنش</span>
                                <span class="info-value">@selectedEntry.TransactionNo</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">حساب</span>
                                <span class="info-value">@selectedEntry.AccountName (@selectedEntry.AccountCode)</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">ارز</span>
                                <span class="info-value">@selectedEntry.CurrencyCode</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">تاریخ</span>
                                <span class="info-value" dir="ltr">@PersianDateHelper.ToPersianDateTime12(selectedEntry.CreatedAt)</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">بدهکار</span>
                                <span class="info-value text-danger fw-bold">@(selectedEntry.TalabKar > 0 ? selectedEntry.TalabKar.ToString("N2") : "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">بستانکار</span>
                                <span class="info-value text-success fw-bold">@(selectedEntry.BadehKar > 0 ? selectedEntry.BadehKar.ToString("N2") : "-")</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-12">
                            <div class="info-card">
                                <span class="info-label">توضیحات</span>
                                <span class="info-value">@(selectedEntry.Description ?? "-")</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDetailModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== لیست‌های اصلی =====
    private List<LedgerEntryDto> ledgerEntries = new();
    private List<LedgerEntryDto> filteredEntries = new();
    private List<AccountDto> accounts = new();
    private List<CurrencyDto> currencies = new();

    // ===== فیلترها =====
    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                ApplyFilters();
            }
        }
    }

    private long _filterAccountId = 0;
    private long filterAccountId
    {
        get => _filterAccountId;
        set
        {
            if (_filterAccountId != value)
            {
                _filterAccountId = value;
                ApplyFilters();
            }
        }
    }

    private long _filterCurrencyId = 0;
    private long filterCurrencyId
    {
        get => _filterCurrencyId;
        set
        {
            if (_filterCurrencyId != value)
            {
                _filterCurrencyId = value;
                ApplyFilters();
            }
        }
    }

    // اصلاح: استفاده از DateTime به جای string
    private DateTime _fromDate = DateTime.Now.AddMonths(-1);
    private DateTime fromDate
    {
        get => _fromDate;
        set
        {
            if (_fromDate != value)
            {
                _fromDate = value;
                ApplyFilters();
            }
        }
    }

    private DateTime _toDate = DateTime.Now;
    private DateTime toDate
    {
        get => _toDate;
        set
        {
            if (_toDate != value)
            {
                _toDate = value;
                ApplyFilters();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 20;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private List<LedgerEntryDto> pagedEntries
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredEntries;
            switch (sortColumn)
            {
                case "TransactionNo":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.TransactionNo).ToList() : filteredEntries.OrderByDescending(e => e.TransactionNo).ToList();
                    break;
                case "AccountName":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.AccountName).ToList() : filteredEntries.OrderByDescending(e => e.AccountName).ToList();
                    break;
                case "CurrencyCode":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.CurrencyCode).ToList() : filteredEntries.OrderByDescending(e => e.CurrencyCode).ToList();
                    break;
                case "TalabKar":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.TalabKar).ToList() : filteredEntries.OrderByDescending(e => e.TalabKar).ToList();
                    break;
                case "BadehKar":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.BadehKar).ToList() : filteredEntries.OrderByDescending(e => e.BadehKar).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? filteredEntries.OrderBy(e => e.CreatedAt).ToList() : filteredEntries.OrderByDescending(e => e.CreatedAt).ToList();
                    break;
                default:
                    sorted = filteredEntries.OrderByDescending(e => e.CreatedAt).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredEntries.Count / pageSize);

    // ===== وضعیت‌های مودال =====
    private bool showModal = false;
    private bool showDetailModal = false;
    private bool isLoading = false;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private LedgerEntryDto? selectedEntry = null;

    // ===== DTO جدید =====
    private CreateLedgerEntryDto newEntry = new();

    // ========== متدهای بارگذاری داده ==========

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadLedgerEntries();
    }

    private async Task LoadLookupData()
    {
        try
        {
            var accountResult = await AccountService.GetAllAsync();
            accounts = accountResult.ToList();

            var currencyResult = await CurrencyService.GetAllAsync();
            currencies = currencyResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadLedgerEntries()
    {
        try
        {
            isLoading = true;
            // استفاده از ToUniversalTime برای اطمینان از تطابق با UTC
            var result = await LedgerService.GetEntriesByDateRangeAsync(
                _fromDate.ToUniversalTime(),
                _toDate.ToUniversalTime().AddDays(1).AddSeconds(-1)
            );
            ledgerEntries = result.ToList();
            filteredEntries = ledgerEntries;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری دفتر کل: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== متدهای فیلتر ==========

    private void ApplyFilters()
    {
        var query = ledgerEntries.AsEnumerable();

        // جستجو
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(e =>
                e.TransactionNo.ToLower().Contains(term) ||
                e.AccountName.ToLower().Contains(term) ||
                e.AccountCode.ToLower().Contains(term) ||
                (e.Description != null && e.Description.ToLower().Contains(term))
            );
        }

        // فیلتر حساب
        if (_filterAccountId > 0)
        {
            query = query.Where(e => e.AccountId == _filterAccountId);
        }

        // فیلتر ارز
        if (_filterCurrencyId > 0)
        {
            query = query.Where(e => e.CurrencyId == _filterCurrencyId);
        }

        // فیلتر تاریخ
        query = query.Where(e => e.CreatedAt.Date >= _fromDate.Date && e.CreatedAt.Date <= _toDate.Date);

        filteredEntries = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    // ========== متدهای مودال ==========

    private void OpenCreateModal()
    {
        newEntry = new CreateLedgerEntryDto();
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task ViewEntry(long id)
    {
        try
        {
            selectedEntry = filteredEntries.FirstOrDefault(e => e.Id == id);
            if (selectedEntry != null)
            {
                showDetailModal = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedEntry = null;
        StateHasChanged();
    }

    private void ViewTransaction(long transactionId)
    {
        NavigationManager.NavigateTo($"/transactions/{transactionId}");
    }

    // ========== متد ذخیره‌سازی ==========

    private async Task SaveEntry()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (newEntry.AccountId == 0)
            validationErrors.Add("انتخاب حساب الزامی است");
        if (newEntry.CurrencyId == 0)
            validationErrors.Add("انتخاب ارز الزامی است");
        if (newEntry.TalabKar <= 0 && newEntry.BadehKar <= 0)
            validationErrors.Add("حداقل یکی از فیلدهای بدهکار یا بستانکار باید پر شود");
        if (newEntry.TalabKar < 0 || newEntry.BadehKar < 0)
            validationErrors.Add("مبالغ نمی‌توانند منفی باشند");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            await LedgerService.CreateLedgerEntryAsync(newEntry);
            successMessage = "ورودی با موفقیت ثبت شد";

            showModal = false;
            await LoadLedgerEntries();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ========== خروجی اکسل ==========

    private async Task ExportToExcel()
    {
        // این متد را می‌توانید برای خروجی اکسل پیاده‌سازی کنید
        // می‌توانید از کتابخانه‌هایی مانند EPPlus استفاده کنید
        await Task.CompletedTask;
    }
