@page "/payment-locations"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IPaymentLocationService PaymentLocationService
@inject ICorrespondentService CorrespondentService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>مدیریت محل‌های پرداخت</PageTitle>

<div class="page-wrapper">
    <AppPageHeader Title="مدیریت محل‌های پرداخت"
                   Subtitle="لیست و جستجوی آدرس‌های پرداخت حواله"
                   Icon="bi-geo-alt">
        <Stats>
            <PageHeaderStats AriaLabel="آمار محل‌های پرداخت">
                <PageHeaderStat Label="کل" Value="@paymentLocations.Count" Icon="bi-geo-alt" />
                <PageHeaderStat Label="فعال" Value="@paymentLocations.Count(location => location.IsActive)" Icon="bi-check-circle" Tone="success" />
                <PageHeaderStat Label="غیرفعال" Value="@paymentLocations.Count(location => !location.IsActive)" Icon="bi-slash-circle" Tone="danger" />
            </PageHeaderStats>
        </Stats>
        <Actions>
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> محل جدید
            </button>
        </Actions>
    </AppPageHeader>

    <CompactFilterBar AriaLabel="جستجو و فیلتر محل‌های پرداخت"
                      HasActiveFilters="@HasActiveFilters"
                      Reset="ResetFilters">
        <SearchContent>
            <input class="form-control"
                   placeholder="جستجو با نام، آدرس، تلفن یا مسئول..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter"
                    aria-label="وضعیت محل پرداخت"
                    @bind="statusFilter"
                    @bind:event="oninput"
                    @bind:after="ApplyFilters">
                <option value="">همه وضعیت‌ها</option>
                <option value="Active">فعال</option>
                <option value="Inactive">غیرفعال</option>
            </select>
        </QuickFilters>
    </CompactFilterBar>

    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredLocations.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th class="sortable-header @(sortColumn == "Name" ? "active" : "")" style="min-width:150px;" @onclick='() => SortBy("Name")'>
                                نام محل
                                @if (sortColumn == "Name")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th style="min-width:150px;">نمایندگی</th>
                            <th style="min-width:250px;">آدرس</th>
                            <th style="min-width:120px;">تلفن</th>
                            <th style="min-width:120px;">مسئول</th>
                            <th class="sortable-header @(sortColumn == "Status" ? "active" : "")" style="min-width:100px;" @onclick='() => SortBy("Status")'>
                                وضعیت
                                @if (sortColumn == "Status")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center" style="width:80px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr><td colspan="8" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                        }
                        else if (!pagedLocations.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ محل پرداختی یافت نشد</span>
                                        <p class="text-muted small">فیلترها را تغییر دهید یا یک محل جدید اضافه کنید.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredLocations.Count : pageSize) + 1;
                            @foreach (var location in pagedLocations)
                            {
                                <tr>
                                    <td>@rowIndex</td>
                                    <td><span class="fw-bold">@location.Name</span></td>
                                    <td>@(location.CorrespondentName ?? "تخصیص‌نیافته")</td>
                                    <td>@location.Address</td>
                                    <td>@location.Phone</td>
                                    <td>@location.ContactPerson</td>
                                    <td>
                                        <span class="badge-modern @(location.IsActive ? "badge-success" : "badge-danger")">
                                            @(location.IsActive ? "فعال" : "غیرفعال")
                                        </span>
                                    </td>
                                    <td class="text-center operation-cell">
                                        <AppActionMenu AriaLabel="@($"عملیات محل پرداخت {location.Name}")">
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => OpenEditModal(location.Id)">
                                                <i class="bi bi-pencil text-primary"></i>
                                                ویرایش
                                            </button>
                                            <button type="button" class="operation-menu-item" role="menuitem" @onclick="() => ToggleActive(location.Id)">
                                                <i class="bi @(location.IsActive ? "bi-eye-slash text-warning" : "bi-eye text-success")"></i>
                                                @(location.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")
                                            </button>
                                            <div class="operation-menu-divider"></div>
                                            <button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" @onclick="() => ShowDeleteConfirm(location.Id)">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </button>
                                        </AppActionMenu>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedLocations.Count</strong> از <strong>@filteredLocations.Count</strong> محل
                </span>
                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>
            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage"
                              AriaLabel="تعداد محل پرداخت در هر صفحه" />
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content payment-location-entry-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش آدرس" : "ایجاد آدرس جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">نمایندگی <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="currentLocation.CorrespondentId">
                                <option value="">انتخاب نمایندگی</option>
                                @foreach (var correspondent in availableCorrespondents)
                                {
                                    <option value="@correspondent.Id">@correspondent.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">نام محل <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="currentLocation.Name" placeholder="مثال: دفتر مرکزی" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">آدرس <span class="text-danger">*</span></label>
                            <textarea class="form-control" @bind="currentLocation.Address" rows="2" placeholder="آدرس کامل"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">تلفن</label>
                            <input type="text" class="form-control" @bind="currentLocation.Phone" placeholder="شماره تلفن" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">مسئول</label>
                            <input type="text" class="form-control" @bind="currentLocation.ContactPerson" placeholder="نام مسئول" />
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check form-switch payment-location-status-toggle">
                                <input class="form-check-input" type="checkbox" id="isActive" @bind="currentLocation.IsActive" />
                                <label class="form-check-label" for="isActive">
                                    @(currentLocation.IsActive ? "فعال" : "غیرفعال")
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="() => CloseModal()"><i class="bi bi-x-circle"></i> انصراف</button>
                    <button class="btn-modern btn-primary-modern" @onclick="() => SaveLocation()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {

                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید حذف -->
@if (showDeleteModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white"><i class="bi bi-exclamation-triangle"></i> تأیید حذف</h5>
                    <button class="btn-close btn-close-white" @onclick="() => CloseDeleteModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p>آیا مطمئن هستید که می‌خواهید این آدرس را حذف کنید؟</p>
                    <p class="text-muted small">در صورت استفاده در حواله‌ها، حذف امکان‌پذیر نیست.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn-modern btn-light-modern" @onclick="() => CloseDeleteModal()"><i class="bi bi-x-circle"></i> انصراف</button>
                    <button class="btn-modern btn-danger-modern" @onclick="() => ConfirmDelete()"><i class="bi bi-check-circle"></i> تأیید حذف</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PaymentLocationDto> paymentLocations = new();
    private List<PaymentLocationDto> filteredLocations = new();
    private List<CorrespondentDto> correspondents = new();
    private string _searchTerm = "";
    private string statusFilter = string.Empty;
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(statusFilter);
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm == value)
                return;

            _searchTerm = value;
            ApplyFilters();
        }
    }
    private List<PaymentLocationDto> pagedLocations
    {
        get
        {
            var sorted = sortColumn switch
            {
                "Status" => sortAscending
                    ? filteredLocations.OrderByDescending(location => location.IsActive).ThenBy(location => location.Name)
                    : filteredLocations.OrderBy(location => location.IsActive).ThenBy(location => location.Name),
                _ => sortAscending
                    ? filteredLocations.OrderBy(location => location.Name)
                    : filteredLocations.OrderByDescending(location => location.Name)
            };

            return pageSize == 0
                ? sorted.ToList()
                : sorted.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        }
    }
    private int totalPages => pageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)filteredLocations.Count / pageSize));
    private bool isLoading = false;
    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool isEditMode = false;
    private long editId = 0;
    private long deleteId = 0;
    private List<string> validationErrors = new();
    private string successMessage = "";
    private CreatePaymentLocationDto currentLocation = new();
    private IEnumerable<CorrespondentDto> availableCorrespondents =>
        correspondents.Where(x => !x.IsArchived || x.Id == currentLocation.CorrespondentId);

    protected override async Task OnInitializedAsync()
    {
        correspondents = (await CorrespondentService.GetAllAsync()).ToList();
        await LoadLocations();
    }

    private async Task LoadLocations()
    {
        try
        {
            isLoading = true;
            var result = await PaymentLocationService.GetAllAsync();
            paymentLocations = result.ToList();
            ApplyFilters();
        }
        catch { }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        var query = paymentLocations.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(location =>
                location.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (location.CorrespondentName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                location.Address.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (location.Phone?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (location.ContactPerson?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        query = statusFilter switch
        {
            "Active" => query.Where(location => location.IsActive),
            "Inactive" => query.Where(location => !location.IsActive),
            _ => query
        };

        filteredLocations = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        statusFilter = string.Empty;
        filteredLocations = paymentLocations;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages)
            return;

        currentPage = page;
        StateHasChanged();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentLocation = new CreatePaymentLocationDto { IsActive = true };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            var location = await PaymentLocationService.GetByIdAsync(id);
            if (location != null)
            {
                currentLocation = new CreatePaymentLocationDto
                {
                    CorrespondentId = location.CorrespondentId,
                    Name = location.Name,
                    Address = location.Address,
                    Phone = location.Phone,
                    ContactPerson = location.ContactPerson,
                    IsActive = location.IsActive
                };
                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                showModal = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task SaveLocation()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(currentLocation.Name))
            validationErrors.Add("نام محل الزامی است.");
        if (string.IsNullOrWhiteSpace(currentLocation.Address))
            validationErrors.Add("آدرس الزامی است.");
        if (!currentLocation.CorrespondentId.HasValue)
            validationErrors.Add("انتخاب نمایندگی الزامی است.");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateDto = new UpdatePaymentLocationDto
                {
                    CorrespondentId = currentLocation.CorrespondentId,
                    Name = currentLocation.Name,
                    Address = currentLocation.Address,
                    Phone = currentLocation.Phone,
                    ContactPerson = currentLocation.ContactPerson,
                    IsActive = currentLocation.IsActive
                };
                await PaymentLocationService.UpdateAsync(editId, updateDto);
            }
            else
            {
                await PaymentLocationService.CreateAsync(currentLocation);
            }

            showModal = false;
            await LoadLocations();
        }
        catch (Exception ex)
        {
            validationErrors.Add(ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleActive(long id)
    {
        try
        {
            await PaymentLocationService.ToggleActiveAsync(id);
            await LoadLocations();
        }
        catch { }
    }

    private void ShowDeleteConfirm(long id)
    {
        deleteId = id;
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await PaymentLocationService.DeleteAsync(deleteId);
            showDeleteModal = false;
            await LoadLocations();
        }
        catch (Exception ex)
        {
            validationErrors.Add(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }
}
