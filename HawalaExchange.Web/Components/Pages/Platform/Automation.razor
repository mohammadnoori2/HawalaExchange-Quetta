@page "/platform/automation"
@attribute [Authorize(Policy = "PlatformWrite")]
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@inject ISaasAutomationService AutomationService
@rendermode InteractiveServer

<PageTitle>اعلان‌ها و اتوماسیون SaaS</PageTitle>
<div class="page-wrapper">
    <div class="page-header">
        <div><h5 class="page-title"><i class="bi bi-bell"></i> اعلان‌ها و اتوماسیون SaaS</h5><span class="page-subtitle">صدور خودکار فاکتور، هشدار انقضا، بدهی و مصرف پلن</span></div>
        <PageHeaderStats AriaLabel="آمار اعلان‌ها">
            <PageHeaderStat Label="خوانده‌نشده" Value="@dashboard.UnreadCount" Icon="bi-bell" Tone="warning" />
            <PageHeaderStat Label="بحرانی" Value="@dashboard.CriticalCount" Icon="bi-exclamation-triangle" Tone="danger" />
            <PageHeaderStat Label="آخرین اجرا" Value="@(dashboard.Settings.LastRunAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "اجرا نشده")" Icon="bi-clock-history" Tone="info" />
        </PageHeaderStats>
        <div class="page-actions"><button class="btn-modern btn-primary-modern" disabled="@isRunning" @onclick="RunNowAsync"><i class="bi bi-play-circle"></i> اجرای اکنون</button></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }
    @if (isLoading) { <div class="modern-card p-5 text-center">در حال بارگذاری...</div> }
    else
    {
        <div class="modern-card mb-4"><div class="card-header"><h6 class="mb-0">تنظیمات اتوماسیون</h6></div><EditForm EditContext="settingsContext" FormName="saas-automation-settings"><DataAnnotationsValidator /><div class="card-body"><ValidationSummary class="text-danger" /><div class="row g-3">
            <div class="col-md-4 form-check form-switch ms-3"><InputCheckbox class="form-check-input" @bind-Value="settings.IsEnabled" /><label class="form-check-label">اتوماسیون فعال</label></div><div class="col-md-4 form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="settings.AutoCreateInvoices" /><label class="form-check-label">صدور خودکار فاکتور</label></div><div class="col-md-3 form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="settings.SendEmailNotifications" /><label class="form-check-label">ارسال ایمیل</label></div>
            <div class="col-md-3"><label class="form-label">فاصله اجرا (دقیقه)</label><InputNumber class="form-control" @bind-Value="settings.RunIntervalMinutes" /></div><div class="col-md-3"><label class="form-label">هشدار انقضا (روز)</label><InputNumber class="form-control" @bind-Value="settings.ExpiryWarningDays" /></div><div class="col-md-3"><label class="form-label">مهلت تنفس (روز)</label><InputNumber class="form-control" @bind-Value="settings.GracePeriodDays" /></div><div class="col-md-3"><label class="form-label">هشدار پایان مهلت (روز)</label><InputNumber class="form-control" @bind-Value="settings.GraceWarningDays" /></div>
            <div class="col-md-3"><label class="form-label">صدور قبل از پایان (روز)</label><InputNumber class="form-control" @bind-Value="settings.InvoiceLeadDays" /></div><div class="col-md-3"><label class="form-label">مهلت پرداخت فاکتور (روز)</label><InputNumber class="form-control" @bind-Value="settings.InvoiceDueDays" /></div><div class="col-md-3"><label class="form-label">آستانه هشدار مصرف (%)</label><InputNumber class="form-control" @bind-Value="settings.QuotaWarningPercent" /></div><div class="col-md-3 d-flex align-items-end"><button type="button" class="btn-modern btn-primary-modern w-100" @onclick="SaveSettingsAsync">ذخیره تنظیمات</button></div>
        </div></div></EditForm></div>
        <CompactFilterBar AriaLabel="جستجو و فیلتر اعلان‌ها" HasActiveFilters="@(!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(typeFilter))" Reset="ResetNotificationFilters">
            <SearchContent><input class="form-control" value="@search" @oninput="SearchChanged" placeholder="جستجوی اعلان یا صرافی..." /></SearchContent>
            <QuickFilters><select class="form-select compact-quick-filter" value="@typeFilter" @onchange="TypeChanged"><option value="">همه اعلان‌ها</option>@foreach (var type in Enum.GetValues<SaasNotificationType>()) { <option value="@((int)type)">@TypeText(type)</option> }</select></QuickFilters>
        </CompactFilterBar>
        <div class="modern-card"><div class="table-responsive"><table class="table modern-table mb-0"><thead><tr><th>زمان</th><th>صرافی</th><th>نوع</th><th>پیام</th><th>ارسال</th><th></th></tr></thead><tbody>@if (dashboard.Notifications.Count == 0) { <tr><td colspan="6" class="text-center py-5 text-muted">اعلانی وجود ندارد.</td></tr> } @foreach (var item in dashboard.Notifications) { <tr class="@(item.ReadAt == null ? "fw-semibold" : "")"><td>@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@item.TenantName</td><td><span class="badge-modern @SeverityBadge(item.Severity)">@TypeText(item.Type)</span></td><td><div>@item.Title</div><small class="text-muted">@item.Message</small></td><td>@DeliveryText(item.DeliveryStatus)</td><td>@if (item.ReadAt == null) { <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkReadAsync(item.Id)">خواندم</button> }</td></tr> }</tbody></table></div></div>
        <div class="modern-card mt-4"><div class="card-header"><h6 class="mb-0">تاریخچه اجرا</h6></div><div class="table-responsive"><table class="table modern-table mb-0"><thead><tr><th>شروع</th><th>وضعیت</th><th>اشتراک</th><th>فاکتور</th><th>اعلان</th></tr></thead><tbody>@foreach (var run in dashboard.Runs) { <tr><td>@run.StartedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@RunStatusText(run.Status)</td><td>@run.ProcessedSubscriptions</td><td>@run.CreatedInvoices</td><td>@run.CreatedNotifications</td></tr> }</tbody></table></div></div>
    }
</div>
@code {
    private SaasAutomationDashboardDto dashboard = new(); private SaasAutomationSettingsDto settings = new(); private EditContext settingsContext = default!; private string search="", typeFilter=""; private string? message; private bool isError,isLoading=true,isRunning;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { dashboard=await AutomationService.GetDashboardAsync(search,ParsedType()); settings=dashboard.Settings; settingsContext=new(settings); isLoading=false; }
    private async Task SaveSettingsAsync() { if(!settingsContext.Validate())return; try { settings=await AutomationService.SaveSettingsAsync(settings); settingsContext=new(settings); message="تنظیمات ذخیره شد.";isError=false;}catch(Exception ex){message=ex.Message;isError=true;} }
    private async Task RunNowAsync(){try{isRunning=true;var run=await AutomationService.RunAsync(true);message=$"اجرا کامل شد: {run.CreatedInvoices} فاکتور و {run.CreatedNotifications} اعلان.";isError=false;await LoadAsync();}catch(Exception ex){message=ex.Message;isError=true;}finally{isRunning=false;}}
    private async Task SearchChanged(ChangeEventArgs e){search=e.Value?.ToString()??"";dashboard=await AutomationService.GetDashboardAsync(search,ParsedType());} private async Task TypeChanged(ChangeEventArgs e){typeFilter=e.Value?.ToString()??"";dashboard=await AutomationService.GetDashboardAsync(search,ParsedType());}
    private async Task ResetNotificationFilters(){search="";typeFilter="";dashboard=await AutomationService.GetDashboardAsync();}
    private async Task MarkReadAsync(long id){await AutomationService.MarkReadAsync(id);await LoadAsync();} private SaasNotificationType? ParsedType()=>int.TryParse(typeFilter,out var x)?(SaasNotificationType)x:null;
    private static string TypeText(SaasNotificationType x)=>x switch{SaasNotificationType.SubscriptionExpiring=>"اشتراک به‌زودی پایان می‌یابد",SaasNotificationType.SubscriptionExpired=>"اشتراک پایان یافته",SaasNotificationType.GracePeriodEnding=>"مهلت استفاده رو به پایان است",SaasNotificationType.InvoiceCreated=>"فاکتور جدید",SaasNotificationType.PaymentOverdue=>"پرداخت عقب افتاده",SaasNotificationType.QuotaWarning=>"نزدیک محدودیت پلن",SaasNotificationType.SubscriptionRenewed=>"اشتراک تمدید شد",SaasNotificationType.SubscriptionSuspended=>"اشتراک متوقف شد",_=>"اعلان عمومی"};
    private static string RunStatusText(SaasAutomationRunStatus status)=>status switch{SaasAutomationRunStatus.Completed=>"با موفقیت تکمیل شد",SaasAutomationRunStatus.Running=>"در حال اجرا",SaasAutomationRunStatus.Failed=>"با خطا روبه‌رو شد",SaasAutomationRunStatus.Skipped=>"نیازی به اجرا نبود",_=>"وضعیت اجرا مشخص نیست"};
    private static string SeverityBadge(SaasNotificationSeverity x)=>x switch{SaasNotificationSeverity.Critical=>"badge-danger",SaasNotificationSeverity.Warning=>"badge-warning",SaasNotificationSeverity.Success=>"badge-success",_=>"badge-info"}; private static string DeliveryText(SaasNotificationDeliveryStatus x)=>x switch{SaasNotificationDeliveryStatus.Sent=>"ارسال شد",SaasNotificationDeliveryStatus.Skipped=>"فقط داخلی",SaasNotificationDeliveryStatus.Failed=>"ناموفق",_=>"در انتظار"};
}
