@page "/reports/customer-activities"
@page "/reports/correspondent-activities"
@page "/reports/account-activities"
@attribute [Authorize(Policy = "TenantBusiness")]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Helpers
@using HawalaExchange.Application.Interfaces.Services
@inject IExportService ExportService
@inject IBalanceService BalanceService
@inject IJSRuntime JSRuntime
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>@ReportTitle</PageTitle>

<div class="page-wrapper reports-page">
    <AppPageHeader Title="@ReportTitle"
                   Subtitle="@($"تمام فعالیت‌های مالی {OwnerType}")"
                   Icon="bi-clipboard-data">
        <Actions>
            <PageRefreshButton Refresh="RefreshPageDataAsync" Inline="true" />
            @if (!IsAccountReport && !IsCorrespondentReport && selectedCustomerId > 0)
            {
                <a class="btn-modern btn-light-modern" href="@($"/customers/{selectedCustomerId}")"><i class="bi bi-arrow-right" aria-hidden="true"></i> برگشت به مشتری</a>
            }
        </Actions>
    </AppPageHeader>

    <div class="table-card">
        <div class="table-card-body">
            @if (SelectedOwnerId <= 0)
            {
                <div class="alert alert-warning mb-0">
                    @OwnerType مشخص نشده است. گزارش را از صفحهٔ @OwnerType باز کنید.
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(customerName))
                {
                    <div class="alert alert-info py-2">
                        <i class="bi bi-person"></i> @OwnerType: <strong>@customerName</strong>
                    </div>
                }

                @if (customerBalance != null)
                {
                    <div class="alert alert-success py-2">
                        <i class="bi bi-wallet2"></i> مانده فعلی حساب (مستقل از بازه گزارش):
                        @foreach (var b in customerBalance)
                        {
                            <span class="badge-modern @(b.Balance > 0 ? "badge-success" : (b.Balance < 0 ? "badge-danger" : "badge-secondary")) ms-1">
                                @b.CurrencyCode: @MoneyFormatHelper.Format(Math.Abs(b.Balance)) (@BalanceStatus(b.Balance))
                            </span>
                        }
                    </div>
                }

                <div class="d-flex align-items-center gap-2 flex-wrap">
                <CompactFilterBar CssClass="mb-3 w-100" AriaLabel="جستجو و فیلتر صورت‌حساب" HasActiveFilters="@(!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(currency) || !string.IsNullOrWhiteSpace(direction) || ((fromDate != DateTime.MinValue ? 1 : 0) + (toDate != DateTime.MinValue ? 1 : 0) + (minAmount.HasValue ? 1 : 0) + (maxAmount.HasValue ? 1 : 0)) > 0)" ActiveFilterCount="@((fromDate != DateTime.MinValue ? 1 : 0) + (toDate != DateTime.MinValue ? 1 : 0) + (minAmount.HasValue ? 1 : 0) + (maxAmount.HasValue ? 1 : 0))" Reset="ResetFilters">
                    <SearchContent><input class="form-control" placeholder="جستجوی شماره سند یا شرح..." @bind="search" @bind:event="oninput" /></SearchContent>
                    <QuickFilters>
                        <div class="compact-filter-field"><label class="form-label">از تاریخ</label><PersianDatePicker @bind-Value="fromDate" AllowEmpty="true" /></div>
                        <div class="compact-filter-field"><label class="form-label">تا تاریخ</label><PersianDatePicker @bind-Value="toDate" AllowEmpty="true" /></div>
                        <input class="form-control compact-quick-filter" aria-label="ارز" placeholder="همه ارزها؛ مانند USD" @bind="currency" />
                        <select class="form-select compact-quick-filter" aria-label="بدهکاری / طلبکاری" @bind="direction"><option value="">بدهکاری و طلبکاری</option><option value="Credit">طلبکاری</option><option value="Debit">بدهکاری</option></select>
                    </QuickFilters>
                    <AdvancedFilters>
                        <div class="compact-filter-field"><label class="form-label">حداقل مبلغ</label><NullableMoneyInput class="form-control" @bind-Value="minAmount" /></div>
                        <div class="compact-filter-field"><label class="form-label">حداکثر مبلغ</label><NullableMoneyInput class="form-control" @bind-Value="maxAmount" /></div>
                    </AdvancedFilters>
                </CompactFilterBar>
                    <button class="btn-modern btn-primary-modern" disabled="@busy" @onclick="LoadPreviewAsync"><i class="bi bi-eye"></i> @(busy ? "در حال آماده‌سازی..." : "نمایش گزارش")</button>
                    <PermissionAction Actions="Export"><button class="btn-modern btn-primary-modern" disabled="@(busy || preview == null)" @onclick="ExportExcel">
                        <i class="bi bi-file-earmark-excel"></i> دانلود اکسل
                    </button></PermissionAction>
                    <PermissionAction Actions="Export"><button class="btn-modern btn-light-modern" disabled="@(busy || preview == null)" @onclick="ExportPdf">
                        <i class="bi bi-file-earmark-pdf"></i> دانلود PDF
                    </button></PermissionAction>
                    @if (!IsAccountReport && !IsCorrespondentReport)
                    {
                        <PermissionAction Actions="Export"><CustomerBalanceShare @key="selectedCustomerId" CustomerName="@customerName" Balances="customerBalance" Disabled="busy" /></PermissionAction>
                        <PermissionAction Actions="Export"><button type="button" class="btn-modern btn-light-modern" disabled="@(!CanCopyCustomerBalance)" @onclick="CopyCustomerBalanceAsync" title="کپی مانده فعلی هر ارز؛ مستقل از بازه گزارش و بدون جزئیات تراکنش‌ها">
                            <i class="bi bi-copy" aria-hidden="true"></i> کپی مانده
                        </button></PermissionAction>
                    }
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <span class="text-danger">@error</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(balanceCopyMessage))
                {
                    <div class="small mt-2 @(balanceCopyFallback.Length == 0 ? "text-success" : "text-danger")" role="status">@balanceCopyMessage</div>
                }
                @if (!string.IsNullOrEmpty(balanceCopyFallback))
                {
                    <textarea class="form-control mt-2" rows="5" readonly aria-label="متن مانده برای کپی دستی" value="@balanceCopyFallback"></textarea>
                }
            }
        </div>
    </div>
    @if (preview != null)
    {
        <div class="table-card mt-3"><div class="table-card-body">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
                <h5 class="mb-0">پیش‌نمایش @ReportTitle</h5>
            </div>
            <div class="alert alert-info py-2">@preview.CustomerName (@preview.CustomerCode) | از تاریخ: @RangeDate(preview.FromDate, "ابتدای حساب") تا تاریخ: @RangeDate(preview.ToDate, "آخرین فعالیت")</div>
            <p class="text-muted">این گزارش مربوط به آخرین اجرای «نمایش گزارش» است. پس از تغییر فیلترها دوباره آن را بزنید. خلاصه حساب شامل تمام فعالیت‌های بازه است؛ فیلترهای جزئی فقط ردیف‌ها را محدود می‌کنند.</p>
            <div class="table-responsive"><table class="table table-bordered text-center align-middle">
                <thead><tr><th>ارز</th><th>مانده قبل از شروع بازه</th><th>مجموع بدهکاری بازه</th><th>مجموع طلبکاری بازه</th><th>مانده پایان بازه</th></tr></thead>
                <tbody>@foreach (var balance in preview.Balances)
                {<tr><td>@balance.Currency</td><td><span dir="ltr">@MoneyFormatHelper.Format(Math.Abs(balance.Opening))</span> (@BalanceStatus(balance.Opening))</td><td dir="ltr">@MoneyFormatHelper.Format(balance.Debit)</td><td dir="ltr">@MoneyFormatHelper.Format(balance.Credit)</td><td><span dir="ltr">@MoneyFormatHelper.Format(Math.Abs(balance.Closing))</span> (@BalanceStatus(balance.Closing))</td></tr>}</tbody>
            </table></div>
            @if (preview.CorrespondentId.HasValue)
            {
                <div class="alert alert-warning py-2">کمیشن‌های زیر منتظر بستن دوره‌اند و در مانده حساب شامل نیستند.</div>
                <div class="table-responsive"><table class="table table-bordered text-center align-middle"><thead><tr><th>ارز</th><th>کمیشن منتظر بدهکار</th><th>کمیشن منتظر طلبکار</th></tr></thead><tbody>
                    @foreach (var balance in preview.Balances) {<tr><td>@balance.Currency</td><td dir="ltr">@MoneyFormatHelper.Format(balance.PendingDebit)</td><td dir="ltr">@MoneyFormatHelper.Format(balance.PendingCredit)</td></tr>}
                </tbody></table></div>
            }
            <div class="table-responsive"><table class="table table-bordered text-center align-middle">
                <thead><tr><th>ردیف</th><th>تاریخ</th><th>شرح</th><th>بدهکار</th><th>طلبکار</th><th>ارز</th><th>باقی‌مانده</th><th>وضعیت</th></tr></thead>
                <tbody>@foreach (var item in preview.Rows.Skip(previewPage * PreviewPageSize).Take(PreviewPageSize).Select((row, index) => new { Row = row, Number = previewPage * PreviewPageSize + index + 1 }))
                {<tr><td>@item.Number</td><td dir="ltr">@RangeDate(item.Row.Date, "—")</td><td>@if (item.Row.MoneyOperationType is "Deposit" or "Withdraw") {<span class="badge-modern @AccountOperationDisplay.Badge(item.Row.MoneyOperationType)">@AccountOperationDisplay.Name(item.Row.MoneyOperationType)</span>@item.Row.DisplayDescription[AccountOperationDisplay.Name(item.Row.MoneyOperationType).Length..]} else {@item.Row.DisplayDescription}</td><td dir="ltr">@MoneyFormatHelper.Format(item.Row.BadehKar)</td><td dir="ltr">@MoneyFormatHelper.Format(item.Row.TalabKar)</td><td>@item.Row.Currency</td><td dir="ltr">@MoneyFormatHelper.Format(Math.Abs(item.Row.RunningBalance))</td><td>@BalanceStatus(item.Row.RunningBalance)</td></tr>}
                @if (preview.Rows.Count == 0) {<tr><td colspan="8">در بازه و فیلتر انتخاب‌شده فعالیتی یافت نشد؛ مانده حساب در خلاصه نمایش داده شده است.</td></tr>}
                </tbody>
            </table></div>
            <div class="d-flex align-items-center gap-2"><button class="btn-modern btn-light-modern" disabled="@(previewPage == 0)" @onclick="() => previewPage--">قبلی</button><span>تعداد: @preview.Rows.Count</span><button class="btn-modern btn-light-modern" disabled="@((previewPage + 1) * PreviewPageSize >= preview.Rows.Count)" @onclick="() => previewPage++">بعدی</button></div>
        </div></div>
    }
</div>

@code {
    private string balanceCopyMessage = "", balanceCopyFallback = "";
    private bool copyingBalance;
    private bool CanCopyCustomerBalance => !busy && !copyingBalance && !IsAccountReport && !IsCorrespondentReport
        && selectedCustomerId > 0
        && !string.IsNullOrWhiteSpace(customerName) && customerBalance is { Count: > 0 };

    private async Task CopyCustomerBalanceAsync()
    {
        if (!CanCopyCustomerBalance) return;
        var customerId = selectedCustomerId;
        var text = CustomerBalanceShareText.Build(customerName, customerBalance);
        if (string.IsNullOrEmpty(text)) return;
        balanceCopyMessage = balanceCopyFallback = "";
        copyingBalance = true;
        var copied = false;
        try { copied = await JSRuntime.TryInvokeUiBooleanAsync("hawalaTools.copyToClipboard", text); }
        catch (JSException) { /* Show selectable text when clipboard access or the script is unavailable. */ }
        finally { copyingBalance = false; }
        if (selectedCustomerId != customerId || IsAccountReport || IsCorrespondentReport) return;
        balanceCopyMessage = copied ? "مانده حساب کپی شد." : "مرورگر اجازه کپی نداد؛ متن زیر را دستی کپی کنید.";
        balanceCopyFallback = copied ? "" : text;
    }

    private async Task RefreshPageDataAsync()
    {
        if (busy) return;
        if (selectedAccountId > 0) { await LoadAccountNameAsync(); if (preview != null) await LoadPreviewAsync(); return; }
        if (selectedCorrespondentId > 0) { await LoadCorrespondentNameAsync(); if (preview != null) await LoadPreviewAsync(); return; }
        if (selectedCustomerId > 0) { var fresh = await SafeGetCustomerAsync(selectedCustomerId); if (fresh != null) customerName = $"{fresh.FullName} ({fresh.CustomerCode})"; await LoadCustomerBalanceAsync(selectedCustomerId); if (preview != null) await LoadPreviewAsync(); }
    }
    [SupplyParameterFromQuery(Name = "customerId")]
    public long? CustomerIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "correspondentId")]
    public long? CorrespondentIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "accountId")]
    public long? AccountIdQuery { get; set; }
    private bool IsAccountReport => new Uri(NavigationManager.Uri).AbsolutePath.EndsWith("/reports/account-activities", StringComparison.OrdinalIgnoreCase);
    private bool IsCorrespondentReport => new Uri(NavigationManager.Uri).AbsolutePath == "/reports/correspondent-activities";
    private string OwnerType => IsAccountReport ? "حساب" : IsCorrespondentReport ? "نمایندگی" : "مشتری";
    private string ReportTitle => $"گزارش فعالیت {OwnerType}";
    private long selectedCorrespondentId;
    private long selectedAccountId;
    private long SelectedOwnerId => IsAccountReport ? selectedAccountId : IsCorrespondentReport ? selectedCorrespondentId : selectedCustomerId;

    private long selectedCustomerId = 0;
    private List<BalanceDto>? customerBalance;
    private string error = string.Empty;
    private string customerName = string.Empty;
    private DateTime fromDate = DateTime.MinValue, toDate = DateTime.MinValue;
    private string currency = "", direction = "", search = "";
    private decimal? minAmount, maxAmount;
    private CustomerActivityReportDto? preview;
    private bool busy;
    private int previewPage;
    private const int PreviewPageSize = 100;
    private string RangeDate(DateTime? date, string empty) => DisplayDates.Date(date.HasValue ? DateTime.SpecifyKind(date.Value, DateTimeKind.Utc).ToLocalTime() : null, empty);
    private static string BalanceStatus(decimal balance) => balance > 0 ? "طلبکار" : balance < 0 ? "بدهکار" : "تسویه";
    private ExportFilterDto CreateFilter() => new() { AccountId = IsAccountReport ? selectedAccountId : null, CustomerId = IsCorrespondentReport || IsAccountReport ? null : selectedCustomerId, CorrespondentId = IsCorrespondentReport ? selectedCorrespondentId : null,
        FromDate = fromDate == DateTime.MinValue ? null : fromDate.Date.ToUniversalTime(),
        ToDate = toDate == DateTime.MinValue ? null : toDate.Date.AddDays(1).ToUniversalTime().AddTicks(-1),
        CurrencyCode = currency, Search = search, Direction = direction, MinAmount = minAmount, MaxAmount = maxAmount };
    private async Task LoadPreviewAsync()
    {
        if (busy || SelectedOwnerId <= 0) return;
        busy = true; error = "";
        try { preview = await ExportService.GetCustomerActivitiesPreviewAsync(CreateFilter()); previewPage = 0; }
        catch (Exception ex) { preview = null; error = ex.Message; }
        finally { busy = false; }
    }
    private void ResetFilters() { fromDate = toDate = DateTime.MinValue; currency = direction = search = ""; minAmount = maxAmount = null; }

    protected override async Task OnParametersSetAsync()
    {
        await ApplyQueryPrefillAsync();
    }

    private async Task ApplyQueryPrefillAsync()
    {
        balanceCopyMessage = balanceCopyFallback = "";
        if (IsAccountReport)
        {
            var id = AccountIdQuery;
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.Uri);
            if (id is null or <= 0 && query.TryGetValue("accountId", out var value) && long.TryParse(value, out var parsed)) id = parsed;
            if (selectedAccountId != (id ?? 0) || selectedCustomerId != 0 || selectedCorrespondentId != 0) { preview = null; ResetFilters(); }
            selectedAccountId = id ?? 0; selectedCustomerId = selectedCorrespondentId = 0; customerBalance = null; customerName = "";
            if (selectedAccountId > 0) await LoadAccountNameAsync();
            return;
        }
        if (selectedAccountId != 0) { selectedAccountId = 0; preview = null; ResetFilters(); }
        if (IsCorrespondentReport)
        {
            var id = CorrespondentIdQuery;
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.Uri);
            if (id is null or <= 0 && query.TryGetValue("correspondentId", out var value) && long.TryParse(value, out var parsed)) id = parsed;
            if (selectedCustomerId != 0 || selectedCorrespondentId != (id ?? 0)) { preview = null; ResetFilters(); }
            selectedCustomerId = 0; selectedCorrespondentId = id ?? 0; customerBalance = null; customerName = "";
            if (selectedCorrespondentId > 0) await LoadCorrespondentNameAsync();
            return;
        }
        // در فاز interactive (بعد از prerender / ناوبری enhanced) پارامتر query
        // همیشه دوباره تزریق نمی‌شود، پس آن را مستقیم از URI هم می‌خوانیم.
        var customerId = CustomerIdQuery;
        if (customerId is null or <= 0)
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.Uri);
            // دقت: ایندکسر query[...] وقتی کلید نباشد KeyNotFoundException می‌دهد
            if (query.TryGetValue("customerId", out var customerIdValue)
                && long.TryParse(customerIdValue, out var parsed) && parsed > 0)
                customerId = parsed;
        }

        if (customerId is > 0)
        {
            if (selectedCorrespondentId != 0 || selectedCustomerId != customerId.Value) { preview = null; customerBalance = null; customerName = ""; ResetFilters(); }
            selectedCorrespondentId = 0;
            selectedCustomerId = customerId.Value;
            var customer = await SafeGetCustomerAsync(customerId.Value);
            if (selectedCustomerId != customerId.Value || IsAccountReport || IsCorrespondentReport) return;

            if (customer != null)
                customerName = $"{customer.FullName} ({customer.CustomerCode})";

            await LoadCustomerBalanceAsync(customerId.Value);
        }
        else
        {
            selectedCustomerId = selectedCorrespondentId = 0; preview = null; customerBalance = null; customerName = "";
        }
    }

    private async Task LoadCorrespondentNameAsync()
    {
        try { var owner = await CorrespondentService.GetByIdAsync(selectedCorrespondentId); customerName = owner == null ? "" : $"{owner.Name} ({owner.Code})"; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadAccountNameAsync()
    {
        try { var owner = await AccountService.GetByIdAsync(selectedAccountId); customerName = owner == null ? "" : $"{owner.AccountName} ({owner.AccountCode})"; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadCustomerBalanceAsync(long customerId)
    {
        try
        {
            var balance = await BalanceService.GetCustomerBalanceAsync(customerId);
            if (selectedCustomerId != customerId || IsAccountReport || IsCorrespondentReport) return;
            if (balance != null && balance.Balances.Any())
            {
                customerBalance = balance.Balances;
            }
            else
            {
                customerBalance = null;
            }
        }
        catch
        {
            customerBalance = null;
        }
    }

    private async Task<CustomerDto?> SafeGetCustomerAsync(long id)
    {
        try
        {
            return await CustomerService.GetByIdAsync(id);
        }
        catch
        {
            return null;
        }
    }

    private async Task Export(ExportFormat format)
    {
        if (busy || preview == null) return;
        error = string.Empty;

        if (SelectedOwnerId <= 0)
        {
            error = $"{OwnerType} را انتخاب کنید.";
            return;
        }

        try
        {
            busy = true;
            var (content, contentType, fileName) = await ExportService.ExportCustomerActivitiesPreviewAsync(preview, format);

            var base64 = Convert.ToBase64String(content);
            var url = $"data:{contentType};base64,{base64}";
            await JSRuntime.InvokeVoidAsync("hawalaTools.downloadFromDataUrl", url, fileName);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally { busy = false; }
    }

    private Task ExportExcel() => Export(ExportFormat.Excel);
    private Task ExportPdf() => Export(ExportFormat.Pdf);
}
