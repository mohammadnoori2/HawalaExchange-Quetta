@page "/reports"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject IReportService ReportService
@inject IBranchService BranchService
@inject ICustomerService CustomerService
@inject ICorrespondentService CorrespondentService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-file-earmark-text"></i>
                مدیریت گزارش‌ها
                <span class="page-subtitle">مشاهده و تحلیل گزارش‌های سیستم</span>
            </h5>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <a href="/reports/balance-sheet" class="text-decoration-none">
                <div class="info-card h-100 p-3" style="border-right: 4px solid #1a5c8a;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-bank2 fs-2 text-primary"></i>
                        <div>
                            <div class="fw-bold fs-5 text-dark">بیلانس شیت</div>
                            <div class="text-muted mt-1">دارایی‌ها، بدهی‌ها، سرمایه و تعدیلات ارزی از لیجر</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="/reports/profit-loss" class="text-decoration-none">
                <div class="info-card h-100 p-3" style="border-right: 4px solid #178552;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-graph-up-arrow fs-2 text-success"></i>
                        <div>
                            <div class="fw-bold fs-5 text-dark">صورت حساب مفاد و ضرر</div>
                            <div class="text-muted mt-1">عواید، مصارف، مالیات و مفاد/ضرر دوره از لیجر</div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- کارت اصلی -->
    <div class="table-card">
        <div class="card-header" style="background: #fafbfc; border-bottom: 1px solid var(--border-color); padding: 0.5rem 1rem;">
            <!-- ===== تب‌ها ===== -->
            <ul class="nav nav-tabs border-0" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "daily" ? "active" : "")" @onclick='() => SetTab("daily")'>
                        <i class="bi bi-calendar-day"></i> روزانه
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "transactions" ? "active" : "")" @onclick='() => SetTab("transactions")'>
                        <i class="bi bi-list-ul"></i> تراکنش‌ها
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "commission" ? "active" : "")" @onclick='() => SetTab("commission")'>
                        <i class="bi bi-coin"></i> کارمزد
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "trialbalance" ? "active" : "")" @onclick='() => SetTab("trialbalance")'>
                        <i class="bi bi-balance"></i> تراز آزمایشی
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "customer" ? "active" : "")" @onclick='() => SetTab("customer")'>
                        <i class="bi bi-person"></i> مشتری
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "correspondent" ? "active" : "")" @onclick='() => SetTab("correspondent")'>
                        <i class="bi bi-globe"></i> نماینده
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-3">
            <!-- ============================================= -->
            <!-- تب ۱: گزارش روزانه                           -->
            <!-- ============================================= -->
            @if (activeTab == "daily")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-date text-muted me-1"></i> تاریخ</label>
                            <PersianDatePicker @bind-Value="dailyDate" @bind-Value:after="LoadDailyReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-building text-muted me-1"></i> شعبه</label>
                            <select class="form-select" @bind="dailyBranchId" @bind:after="LoadDailyReport">
                                <option value="0">همه شعبه‌ها</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadDailyReport">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetDailyReport">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingDaily)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (dailyReport != null)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <div class="info-card">
                                    <span class="info-label">شعبه</span>
                                    <span class="info-value">@dailyReport.BranchName</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card">
                                    <span class="info-label">تاریخ</span>
                                    <span class="info-value" dir="ltr">@PersianDateHelper.ToPersianDate(dailyReport.Date)</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card">
                                    <span class="info-label">تعداد تراکنش</span>
                                    <span class="info-value">@dailyReport.TotalTransactions</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-card" style="border-right: 4px solid var(--success-color);">
                                    <span class="info-label">سود خالص</span>
                                    <span class="info-value text-success">@MoneyFormatHelper.Format(dailyReport.NetIncome)</span>
                                </div>
                            </div>
                        </div>

                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>مبلغ ارسال</th>
                                        <th>مبلغ دریافت</th>
                                        <th>کارمزد کل</th>
                                        <th>هزینه‌ها</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-primary">@MoneyFormatHelper.Format(dailyReport.TotalSendAmount)</td>
                                        <td class="fw-bold text-success">@MoneyFormatHelper.Format(dailyReport.TotalReceiveAmount)</td>
                                        <td class="fw-bold text-warning">@MoneyFormatHelper.Format(dailyReport.TotalCommission)</td>
                                        <td class="fw-bold text-danger">@MoneyFormatHelper.Format(dailyReport.TotalExpenses)</td>
                                    </tr>
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-calendar2-week"></i>
                            <span class="fs-5 text-muted">جهت نمایش گزارش، تاریخ و شعبه را انتخاب کنید.</span>
                        </div>
                    }
                </div>
            }

            <!-- ============================================= -->
            <!-- تب ۲: گزارش تراکنش‌ها                         -->
            <!-- ============================================= -->
            @if (activeTab == "transactions")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-start text-muted me-1"></i> از تاریخ</label>
                            <PersianDatePicker @bind-Value="txnFromDate" @bind-Value:after="LoadTransactionReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-end text-muted me-1"></i> تا تاریخ</label>
                            <PersianDatePicker @bind-Value="txnToDate" @bind-Value:after="LoadTransactionReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-building text-muted me-1"></i> شعبه</label>
                            <select class="form-select" @bind="txnBranchId" @bind:after="LoadTransactionReport">
                                <option value="0">همه</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-circle text-muted me-1"></i> وضعیت</label>
                            <select class="form-select" @bind="txnStatus" @bind:after="LoadTransactionReport">
                                <option value="">همه</option>
                                <option value="Pending">در انتظار</option>
                                <option value="Paid">پرداخت شده</option>
                                <option value="Cancel">لغو شده</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadTransactionReport">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetTransactionReport">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingTransactions)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (transactionReports.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th style="min-width: 100px;">شماره</th>
                                        <th>نوع</th>
                                        <th>مشتری</th>
                                        <th>فرستنده</th>
                                        <th>گیرنده</th>
                                        <th>از ارز</th>
                                        <th>مبلغ از</th>
                                        <th>به ارز</th>
                                        <th>مبلغ به</th>
                                        <th>کارمزد</th>
                                        <th>وضعیت</th>
                                        <th style="min-width: 120px;">تاریخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in transactionReports)
                                    {
                                        <tr>
                                            <td><span class="customer-code">@r.TransactionNo</span></td>
                                            <td>@GetTransactionTypeName(r.TransactionType)</td>
                                            <td>@r.CustomerName</td>
                                            <td>@r.SenderName</td>
                                            <td>@r.ReceiverName</td>
                                            <td>@r.FromCurrency</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.FromAmount)</td>
                                            <td>@r.ToCurrency</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.ToAmount)</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.Commission)</td>
                                            <td>@GetStatusBadge(r.Status)</td>
                                            <td><AppDateTime Value="@r.CreatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <span class="fs-5 text-muted">هیچ تراکنشی یافت نشد.</span>
                        </div>
                    }
                </div>
            }

            <!-- ============================================= -->
            <!-- تب ۳: گزارش کارمزد                           -->
            <!-- ============================================= -->
            @if (activeTab == "commission")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-start text-muted me-1"></i> از تاریخ</label>
                            <PersianDatePicker @bind-Value="commFromDate" @bind-Value:after="LoadCommissionReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-end text-muted me-1"></i> تا تاریخ</label>
                            <PersianDatePicker @bind-Value="commToDate" @bind-Value:after="LoadCommissionReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-building text-muted me-1"></i> شعبه</label>
                            <select class="form-select" @bind="commBranchId" @bind:after="LoadCommissionReport">
                                <option value="0">همه</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadCommissionReport">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetCommissionReport">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingCommission)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (commissionReports.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>تاریخ</th>
                                        <th>شعبه</th>
                                        <th>کارمزد کل</th>
                                        <th>کارمزد نماینده</th>
                                        <th>کارمزد خالص</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in commissionReports)
                                    {
                                        <tr>
                                            <td dir="ltr">@PersianDateHelper.ToPersianDate(r.Date)</td>
                                            <td>@r.BranchName</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.TotalCommission)</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.TotalAgentCommission)</td>
                                            <td dir="ltr" class="fw-bold text-success">@MoneyFormatHelper.Format(r.NetCommission)</td>
                                        </tr>
                                    }
                                    <tr class="table-active fw-bold">
                                        <td colspan="2">مجموع</td>
                                        <td>@MoneyFormatHelper.Format(commissionReports.Sum(x => x.TotalCommission))</td>
                                        <td>@MoneyFormatHelper.Format(commissionReports.Sum(x => x.TotalAgentCommission))</td>
                                        <td class="text-success">@MoneyFormatHelper.Format(commissionReports.Sum(x => x.NetCommission))</td>
                                    </tr>
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-coin"></i>
                            <span class="fs-5 text-muted">هیچ داده‌ای یافت نشد.</span>
                        </div>
                    }
                </div>
            }

            <!-- ============================================= -->
            <!-- تب ۴: تراز آزمایشی                           -->
            <!-- ============================================= -->
            @if (activeTab == "trialbalance")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-date text-muted me-1"></i> تاریخ (تا)</label>
                            <PersianDatePicker @bind-Value="tbAsOfDate" @bind-Value:after="LoadTrialBalance" IncludeTime="false" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-building text-muted me-1"></i> شعبه</label>
                            <select class="form-select" @bind="tbBranchId" @bind:after="LoadTrialBalance">
                                <option value="0">همه</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadTrialBalance">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetTrialBalance">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingTB)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (trialBalance.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>کد حساب</th>
                                        <th>نام حساب</th>
                                        <th>بدهکار</th>
                                        <th>بستانکار</th>
                                        <th>مانده</th>
                                        <th>نوع مانده</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in trialBalance)
                                    {
                                        <tr>
                                            <td><span class="customer-code">@r.AccountCode</span></td>
                                            <td>@r.AccountName</td>
                                            <td class="text-danger">@MoneyFormatHelper.Format(r.TotalDebit)</td>
                                            <td class="text-success">@MoneyFormatHelper.Format(r.TotalCredit)</td>
                                            <td class="fw-bold">@MoneyFormatHelper.Format(r.Balance)</td>
                                            <td>
                                                <span class="badge-modern @(r.BalanceType == "Debit" ? "badge-danger" : "badge-success")">
                                                    @(r.BalanceType == "Debit" ? "بدهکار" : "بستانکار")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-balance"></i>
                            <span class="fs-5 text-muted">هیچ داده‌ای یافت نشد.</span>
                        </div>
                    }
                </div>
            }

            <!-- ============================================= -->
            <!-- تب ۵: گزارش مشتری                           -->
            <!-- ============================================= -->
            @if (activeTab == "customer")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-person text-muted me-1"></i> مشتری</label>
                            <select class="form-select" @bind="custCustomerId" @bind:after="LoadCustomerReport">
                                <option value="0">انتخاب مشتری</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.FullName (@c.CustomerCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-start text-muted me-1"></i> از تاریخ</label>
                            <PersianDatePicker @bind-Value="custFromDate" @bind-Value:after="LoadCustomerReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-end text-muted me-1"></i> تا تاریخ</label>
                            <PersianDatePicker @bind-Value="custToDate" @bind-Value:after="LoadCustomerReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-5 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadCustomerReport">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetCustomerReport">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingCustomer)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (customerReports.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>شماره</th>
                                        <th>نوع</th>
                                        <th>فرستنده</th>
                                        <th>گیرنده</th>
                                        <th>مبلغ</th>
                                        <th>کارمزد</th>
                                        <th>وضعیت</th>
                                        <th>تاریخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in customerReports)
                                    {
                                        <tr>
                                            <td><span class="customer-code">@r.TransactionNo</span></td>
                                            <td>@GetTransactionTypeName(r.TransactionType)</td>
                                            <td>@r.SenderName</td>
                                            <td>@r.ReceiverName</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.FromAmount)</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.Commission)</td>
                                            <td>@GetStatusBadge(r.Status)</td>
                                            <td><AppDateTime Value="@r.CreatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-person"></i>
                            <span class="fs-5 text-muted">هیچ تراکنشی برای این مشتری یافت نشد.</span>
                        </div>
                    }
                </div>
            }

            <!-- ============================================= -->
            <!-- تب ۶: گزارش نماینده                         -->
            <!-- ============================================= -->
            @if (activeTab == "correspondent")
            {
                <div>
                    <div class="row g-3 mb-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold"><i class="bi bi-globe text-muted me-1"></i> نماینده</label>
                            <select class="form-select" @bind="corrCorrespondentId" @bind:after="LoadCorrespondentReport">
                                <option value="0">انتخاب نماینده</option>
                                @foreach (var c in correspondents)
                                {
                                    <option value="@c.Id">@c.Name (@c.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-start text-muted me-1"></i> از تاریخ</label>
                            <PersianDatePicker @bind-Value="corrFromDate" @bind-Value:after="LoadCorrespondentReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold"><i class="bi bi-calendar-end text-muted me-1"></i> تا تاریخ</label>
                            <PersianDatePicker @bind-Value="corrToDate" @bind-Value:after="LoadCorrespondentReport" IncludeTime="false" />
                        </div>
                        <div class="col-md-5 d-flex align-items-end gap-2">
                            <button class="btn-modern btn-primary-modern" @onclick="LoadCorrespondentReport">
                                <i class="bi bi-search"></i> نمایش
                            </button>
                            <button class="btn-modern btn-light-modern" @onclick="ResetCorrespondentReport">
                                <i class="bi bi-arrow-clockwise"></i> بازنشانی
                            </button>
                        </div>
                    </div>

                    @if (isLoadingCorrespondent)
                    {
                        <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (correspondentReports.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>شماره</th>
                                        <th>نوع</th>
                                        <th>فرستنده</th>
                                        <th>گیرنده</th>
                                        <th>مبلغ</th>
                                        <th>کارمزد</th>
                                        <th>وضعیت</th>
                                        <th>تاریخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in correspondentReports)
                                    {
                                        <tr>
                                            <td><span class="customer-code">@r.TransactionNo</span></td>
                                            <td>@GetTransactionTypeName(r.TransactionType)</td>
                                            <td>@r.SenderName</td>
                                            <td>@r.ReceiverName</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.FromAmount)</td>
                                            <td dir="ltr">@MoneyFormatHelper.Format(r.Commission)</td>
                                            <td>@GetStatusBadge(r.Status)</td>
                                            <td><AppDateTime Value="@r.CreatedAt" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-globe"></i>
                            <span class="fs-5 text-muted">هیچ تراکنشی برای این نماینده یافت نشد.</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ===== داده‌های کمکی =====
    private List<BranchDto> branches = new();
    private List<CustomerDto> customers = new();
    private List<CorrespondentDto> correspondents = new();

    // ===== تب فعال =====
    private string activeTab = "daily";

    // ===== فیلدهای گزارش روزانه =====
    private DateTime dailyDate = DateTime.Today;
    private long dailyBranchId = 0;
    private bool isLoadingDaily = false;
    private DailyReportDto? dailyReport = null;

    // ===== فیلدهای گزارش تراکنش‌ها =====
    private DateTime txnFromDate = DateTime.Today.AddDays(-30);
    private DateTime txnToDate = DateTime.Today;
    private long txnBranchId = 0;
    private string txnStatus = "";
    private bool isLoadingTransactions = false;
    private List<TransactionReportDto> transactionReports = new();

    // ===== فیلدهای گزارش کارمزد =====
    private DateTime commFromDate = DateTime.Today.AddDays(-30);
    private DateTime commToDate = DateTime.Today;
    private long commBranchId = 0;
    private bool isLoadingCommission = false;
    private List<CommissionReportDto> commissionReports = new();

    // ===== فیلدهای تراز آزمایشی =====
    private DateTime tbAsOfDate = DateTime.Today;
    private long tbBranchId = 0;
    private bool isLoadingTB = false;
    private List<TrialBalanceDto> trialBalance = new();

    // ===== فیلدهای گزارش مشتری =====
    private long custCustomerId = 0;
    private DateTime custFromDate = DateTime.Today.AddDays(-30);
    private DateTime custToDate = DateTime.Today;
    private bool isLoadingCustomer = false;
    private List<TransactionReportDto> customerReports = new();

    // ===== فیلدهای گزارش نماینده =====
    private long corrCorrespondentId = 0;
    private DateTime corrFromDate = DateTime.Today.AddDays(-30);
    private DateTime corrToDate = DateTime.Today;
    private bool isLoadingCorrespondent = false;
    private List<TransactionReportDto> correspondentReports = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadDailyReport();
    }

    private async Task LoadLookupData()
    {
        try
        {
            branches = (await BranchService.GetAllAsync()).ToList();
            customers = (await CustomerService.GetAllAsync()).ToList();
            correspondents = (await CorrespondentService.GetAllAsync()).ToList();
        }
        catch { }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
        switch (tab)
        {
            case "daily": _ = LoadDailyReport(); break;
            case "transactions": _ = LoadTransactionReport(); break;
            case "commission": _ = LoadCommissionReport(); break;
            case "trialbalance": _ = LoadTrialBalance(); break;
            case "customer": break;
            case "correspondent": break;
        }
    }

    // ===== گزارش روزانه =====
    private async Task LoadDailyReport()
    {
        if (dailyBranchId == 0)
        {
            dailyBranchId = branches.FirstOrDefault()?.Id ?? 0;
        }
        if (dailyBranchId == 0) return;

        isLoadingDaily = true;
        StateHasChanged();
        try
        {
            dailyReport = await ReportService.GetDailyReportAsync(dailyDate, dailyBranchId);
        }
        catch
        {
            dailyReport = null;
        }
        finally
        {
            isLoadingDaily = false;
            StateHasChanged();
        }
    }

    private void ResetDailyReport()
    {
        dailyDate = DateTime.Today;
        dailyBranchId = 0;
        dailyReport = null;
        StateHasChanged();
    }

    // ===== گزارش تراکنش‌ها =====
    private async Task LoadTransactionReport()
    {
        isLoadingTransactions = true;
        StateHasChanged();
        try
        {
            long? branchId = txnBranchId == 0 ? (long?)null : txnBranchId;
            string? status = string.IsNullOrEmpty(txnStatus) ? null : txnStatus;
            var result = await ReportService.GetTransactionReportAsync(txnFromDate, txnToDate, branchId, status);
            transactionReports = result.ToList();
        }
        catch
        {
            transactionReports = new();
        }
        finally
        {
            isLoadingTransactions = false;
            StateHasChanged();
        }
    }

    private void ResetTransactionReport()
    {
        txnFromDate = DateTime.Today.AddDays(-30);
        txnToDate = DateTime.Today;
        txnBranchId = 0;
        txnStatus = "";
        transactionReports = new();
        StateHasChanged();
    }

    // ===== گزارش کارمزد =====
    private async Task LoadCommissionReport()
    {
        isLoadingCommission = true;
        StateHasChanged();
        try
        {
            long? branchId = commBranchId == 0 ? (long?)null : commBranchId;
            var result = await ReportService.GetCommissionReportAsync(commFromDate, commToDate, branchId);
            commissionReports = result.ToList();
        }
        catch
        {
            commissionReports = new();
        }
        finally
        {
            isLoadingCommission = false;
            StateHasChanged();
        }
    }

    private void ResetCommissionReport()
    {
        commFromDate = DateTime.Today.AddDays(-30);
        commToDate = DateTime.Today;
        commBranchId = 0;
        commissionReports = new();
        StateHasChanged();
    }

    // ===== تراز آزمایشی =====
    private async Task LoadTrialBalance()
    {
        isLoadingTB = true;
        StateHasChanged();
        try
        {
            long? branchId = tbBranchId == 0 ? (long?)null : tbBranchId;
            var result = await ReportService.GetTrialBalanceAsync(tbAsOfDate, branchId);
            trialBalance = result.ToList();
        }
        catch
        {
            trialBalance = new();
        }
        finally
        {
            isLoadingTB = false;
            StateHasChanged();
        }
    }

    private void ResetTrialBalance()
    {
        tbAsOfDate = DateTime.Today;
        tbBranchId = 0;
        trialBalance = new();
        StateHasChanged();
    }

    // ===== گزارش مشتری =====
    private async Task LoadCustomerReport()
    {
        if (custCustomerId == 0) return;
        isLoadingCustomer = true;
        StateHasChanged();
        try
        {
            var result = await ReportService.GetCustomerTransactionReportAsync(custCustomerId, custFromDate, custToDate);
            customerReports = result.ToList();
        }
        catch
        {
            customerReports = new();
        }
        finally
        {
            isLoadingCustomer = false;
            StateHasChanged();
        }
    }

    private void ResetCustomerReport()
    {
        custCustomerId = 0;
        custFromDate = DateTime.Today.AddDays(-30);
        custToDate = DateTime.Today;
        customerReports = new();
        StateHasChanged();
    }

    // ===== گزارش نماینده =====
    private async Task LoadCorrespondentReport()
    {
        if (corrCorrespondentId == 0) return;
        isLoadingCorrespondent = true;
        StateHasChanged();
        try
        {
            var result = await ReportService.GetCorrespondentTransactionReportAsync(corrCorrespondentId, corrFromDate, corrToDate);
            correspondentReports = result.ToList();
        }
        catch
        {
            correspondentReports = new();
        }
        finally
        {
            isLoadingCorrespondent = false;
            StateHasChanged();
        }
    }

    private void ResetCorrespondentReport()
    {
        corrCorrespondentId = 0;
        corrFromDate = DateTime.Today.AddDays(-30);
        corrToDate = DateTime.Today;
        correspondentReports = new();
        StateHasChanged();
    }

    // ===== متدهای کمکی =====
    private string GetTransactionTypeName(string type) => AppDisplayText.TransactionType(type);

    private MarkupString GetStatusBadge(string status)
    {
        var badge = status switch
        {
            "Pending" => "<span class='badge-modern badge-warning'>در انتظار</span>",
            "Paid" => "<span class='badge-modern badge-success'>پرداخت شده</span>",
            "Cancel" => "<span class='badge-modern badge-danger'>لغو شده</span>",
            _ => $"<span class='badge-modern badge-secondary'>{status}</span>"
        };
        return new MarkupString(badge);
    }
}
