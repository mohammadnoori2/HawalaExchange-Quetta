@page "/tenants"
@attribute [Authorize(Policy = "PlatformWrite")]
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject ITenantAdministrationService TenantService
@inject ISaasAdministrationService SaasService
@inject ICurrentTenant CurrentTenant
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>مدیریت صرافی‌ها</PageTitle>

<div class="page-wrapper">
    <div class="page-header">
        <div>
            <h5 class="page-title"><i class="bi bi-buildings"></i> مدیریت صرافی‌ها</h5>
            <span class="page-subtitle">هر صرافی داده‌ها، شعبه‌ها و کاربران مستقل دارد</span>
        </div>
        <div class="page-actions">
            <ArchiveViewToggle @bind-ShowArchived="showArchived"
                               ArchivedCount="@tenants.Count(x => x.IsArchived)" />
            <button class="btn-modern btn-primary-modern" @onclick="OpenCreate">
                <i class="bi bi-plus-circle"></i> صرافی جدید
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <CompactFilterBar AriaLabel="جستجوی صرافی‌ها"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm))"
                      Reset="ResetTenantSearch">
        <SearchContent>
                <input class="form-control-modern" value="@searchTerm" @oninput="OnSearchChanged"
                       placeholder="جستجو بر اساس نام صرافی..." />
        </SearchContent>
    </CompactFilterBar>

    <div class="modern-card">
        <div class="table-responsive">
            <GlobalDataGrid class="table modern-table mb-0">
                <thead>
                    <tr>
                        <th>نام صرافی</th>
                        <th>شعبه‌ها</th>
                        <th>کاربران</th>
                        <th>تاریخ ایجاد</th>
                        <th>وضعیت</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="6" class="text-center py-5">در حال بارگذاری...</td></tr>
                    }
                    else if (!FilteredTenants.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">صرافی‌ای یافت نشد.</td></tr>
                    }
                    else
                    {
                        @foreach (var tenant in FilteredTenants)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @tenant.Name
                                    @if (tenant.Id == CurrentTenant.TenantId)
                                    {
                                        <span class="badge-modern badge-info ms-1">صرافی جاری</span>
                                    }
                                </td>
                                <td>@tenant.BranchCount</td>
                                <td>@tenant.UserCount</td>
                                <td>@tenant.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                <td>
                                    <span class="badge-modern @(tenant.IsArchived ? "badge-archived" : tenant.IsActive ? "badge-success" : "badge-secondary")">
                                        @(tenant.IsArchived ? "بایگانی" : tenant.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (tenant.IsArchived)
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleTenantArchiveAsync(tenant)">
                                            <i class="bi bi-arrow-counterclockwise"></i> خروج از بایگانی
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(tenant)">
                                            <i class="bi bi-pencil-square"></i> مدیریت
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleTenantArchiveAsync(tenant)">
                                            <i class="bi bi-archive"></i> بایگانی
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </GlobalDataGrid>
        </div>
    </div>
</div>

@if (showCreate)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable tenant-management-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ایجاد صرافی مستقل</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <EditForm EditContext="createEditContext" FormName="create-tenant" class="tenant-modal-form">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />
                        <div class="alert alert-info py-2">
                            نام کاربری و ایمیل مدیر باید در کل سیستم یکتا باشند.
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-name">نام صرافی <span class="tenant-required">*</span></label>
                                <input id="tenant-name" class="form-control" @bind="createModel.Name" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.Name)" />
                            </div>
                            <div class="col-md-6"><label class="form-label">نام قانونی</label><input class="form-control" @bind="createModel.LegalName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام مسئول تماس</label><input class="form-control" @bind="createModel.ContactName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">شماره تماس</label><input class="form-control" @bind="createModel.ContactPhone" @bind:event="oninput" /></div>
                            <div class="col-12"><label class="form-label">ایمیل تماس</label><input type="email" class="form-control" @bind="createModel.ContactEmail" @bind:event="oninput" /></div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-name">نام مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-name" class="form-control" @bind="createModel.AdminFullName" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminFullName)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-user">نام کاربری مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-user" class="form-control" autocomplete="off" @bind="createModel.AdminUserName" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminUserName)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-email">ایمیل مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-email" type="email" class="form-control" @bind="createModel.AdminEmail" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminEmail)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-password">رمز عبور مدیر <span class="tenant-required">*</span></label>
                                <div class="input-group" dir="ltr">
                                    <input id="tenant-admin-password" type="@(showCreatePassword ? "text" : "password")" class="form-control" autocomplete="new-password" @bind="createModel.AdminPassword" @bind:event="oninput" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreatePassword = !showCreatePassword"
                                            aria-label="@(showCreatePassword ? "پنهان‌کردن رمز" : "نمایش رمز")">
                                        <i class="bi @(showCreatePassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => createModel.AdminPassword)" />
                                <div class="form-text">حداقل ۶ نویسه و شامل حرف بزرگ، حرف کوچک و عدد باشد.</div>
                            </div>
                            <div class="col-12"><hr /><h6>اشتراک اولیه</h6></div>
                            <div class="col-md-6">
                                <label class="form-label">پلن اشتراک <span class="tenant-required">*</span></label>
                                <InputSelect class="form-select" @bind-Value="createModel.PlanId">
                                    <option value="0">انتخاب پلن</option>
                                    @foreach (var plan in plans.Where(x => x.IsActive))
                                    {
                                        <option value="@plan.Id">@plan.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">دوره پرداخت <span class="tenant-required">*</span></label>
                                <InputSelect class="form-select" @bind-Value="createModel.BillingCycle">
                                    <option value="@BillingCycle.Monthly">ماهانه</option>
                                    <option value="@BillingCycle.Quarterly">سه‌ماهه</option>
                                    <option value="@BillingCycle.SemiAnnual">شش‌ماهه</option>
                                    <option value="@BillingCycle.Annual">سالانه</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6"><label class="form-label">تاریخ شروع <span class="tenant-required">*</span></label><InputDate class="form-control" @bind-Value="createModel.SubscriptionStartAt" /></div>
                            <div class="col-md-6"><label class="form-label">تاریخ پایان <span class="tenant-required">*</span></label><InputDate class="form-control" @bind-Value="createModel.SubscriptionEndAt" /></div>
                            <div class="col-md-6">
                                <label class="form-label">مبلغ توافق‌شده و ارز <span class="tenant-required">*</span></label>
                                <div class="tenant-money-field">
                                    <InputSelect class="tenant-money-currency" @bind-Value="createModel.SubscriptionCurrencyCode">
                                        @foreach (var currency in SubscriptionCurrencies)
                                        {
                                            <option value="@currency.Code">@currency.Name</option>
                                        }
                                    </InputSelect>
                                    <MoneyInput class="tenant-money-amount" @bind-Value="createModel.AgreedPrice" placeholder="مبلغ" />
                                </div>
                                <ValidationMessage For="@(() => createModel.AgreedPrice)" />
                                <ValidationMessage For="@(() => createModel.SubscriptionCurrencyCode)" />
                            </div>
                            <div class="col-md-6 form-check form-switch mt-5"><InputCheckbox class="form-check-input" @bind-Value="createModel.AutoRenew" /><label class="form-check-label">تمدید خودکار</label></div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(createError))
                    {
                        <div class="alert alert-danger mx-3 mb-0" role="alert" aria-live="assertive">@createError</div>
                    }
                    <div class="modal-footer">
                        <button type="button" class="btn-modern btn-light-modern" @onclick="CloseCreate">انصراف</button>
                        <button type="button" class="btn-modern btn-primary-modern" disabled="@isSaving" @onclick="CreateAsync">
                            @(isSaving ? "در حال ایجاد..." : "ایجاد صرافی")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showEdit)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable tenant-management-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">مدیریت صرافی</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <EditForm EditContext="updateEditContext" FormName="update-tenant" class="tenant-modal-form">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />
                        <h6 class="mb-3">مشخصات صرافی</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="edit-tenant-name">نام صرافی</label>
                                <input id="edit-tenant-name" class="form-control" @bind="updateModel.Name" @bind:event="oninput" />
                                <ValidationMessage For="@(() => updateModel.Name)" />
                            </div>
                            <div class="col-md-6"><label class="form-label">نام قانونی</label><input class="form-control" @bind="updateModel.LegalName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام مسئول تماس</label><input class="form-control" @bind="updateModel.ContactName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">شماره تماس</label><input class="form-control" @bind="updateModel.ContactPhone" @bind:event="oninput" /></div>
                            <div class="col-12"><label class="form-label">ایمیل تماس</label><input type="email" class="form-control" @bind="updateModel.ContactEmail" @bind:event="oninput" /></div>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <InputCheckbox id="edit-tenant-active" class="form-check-input" @bind-Value="updateModel.IsActive" disabled="@(editingTenantId == CurrentTenant.TenantId)" />
                            <label class="form-check-label" for="edit-tenant-active">صرافی فعال باشد</label>
                        </div>
                        @if (editingTenantId == CurrentTenant.TenantId)
                        {
                            <div class="form-text">برای جلوگیری از قطع دسترسی، صرافی جاری قابل غیرفعال‌سازی نیست.</div>
                        }
                        <hr />
                        <h6 class="mb-3">مشخصات مدیر صرافی</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">نام مدیر</label><input class="form-control" @bind="updateModel.AdminFullName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام کاربری مدیر</label><input class="form-control" autocomplete="off" @bind="updateModel.AdminUserName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">ایمیل مدیر</label><input type="email" class="form-control" @bind="updateModel.AdminEmail" @bind:event="oninput" /></div>
                            <div class="col-md-6">
                                <label class="form-label">رمز عبور جدید مدیر</label>
                                <div class="input-group" dir="ltr">
                                    <input type="@(showEditPassword ? "text" : "password")" class="form-control" autocomplete="new-password" @bind="updateModel.NewAdminPassword" @bind:event="oninput" placeholder="برای عدم تغییر خالی بگذارید" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showEditPassword = !showEditPassword"
                                            aria-label="@(showEditPassword ? "پنهان‌کردن رمز" : "نمایش رمز")">
                                        <i class="bi @(showEditPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => updateModel.NewAdminPassword)" />
                            </div>
                        </div>
                        <hr />
                        <h6 class="mb-3">مدیریت اشتراک</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">پلن</label><InputSelect class="form-select" @bind-Value="subscriptionModel.PlanId">@foreach (var plan in plans) { <option value="@plan.Id">@plan.Name</option> }</InputSelect></div>
                            <div class="col-md-6"><label class="form-label">وضعیت</label><InputSelect class="form-select" @bind-Value="subscriptionModel.Status"><option value="@SubscriptionStatus.Active">فعال</option><option value="@SubscriptionStatus.Trial">آزمایشی</option><option value="@SubscriptionStatus.Suspended">تعلیق‌شده</option><option value="@SubscriptionStatus.Cancelled">لغوشده</option><option value="@SubscriptionStatus.Expired">منقضی</option></InputSelect></div>
                            <div class="col-md-6"><label class="form-label">شروع</label><InputDate class="form-control" @bind-Value="subscriptionModel.StartAt" /></div>
                            <div class="col-md-6"><label class="form-label">پایان/تمدید تا</label><InputDate class="form-control" @bind-Value="subscriptionModel.EndAt" /></div>
                            <div class="col-md-6"><label class="form-label">پایان دوره آزمایشی</label><InputDate class="form-control" @bind-Value="subscriptionModel.TrialEndAt" /></div>
                            <div class="col-md-6"><label class="form-label">پایان دوره مهلت</label><InputDate class="form-control" @bind-Value="subscriptionModel.GracePeriodEndAt" /></div>
                            <div class="col-md-6"><label class="form-label">دوره پرداخت</label><InputSelect class="form-select" @bind-Value="subscriptionModel.BillingCycle"><option value="@BillingCycle.Monthly">ماهانه</option><option value="@BillingCycle.Quarterly">سه‌ماهه</option><option value="@BillingCycle.SemiAnnual">شش‌ماهه</option><option value="@BillingCycle.Annual">سالانه</option></InputSelect></div>
                            <div class="col-md-4"><label class="form-label">مبلغ</label><InputNumber class="form-control" @bind-Value="subscriptionModel.AgreedPrice" /></div>
                            <div class="col-md-4">
                                <label class="form-label">ارز</label>
                                <InputSelect class="form-select" @bind-Value="subscriptionModel.CurrencyCode">
                                    @foreach (var currency in SubscriptionCurrencies)
                                    {
                                        <option value="@currency.Code">@currency.Name (@currency.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 form-check form-switch mt-5"><InputCheckbox class="form-check-input" @bind-Value="subscriptionModel.AutoRenew" /><label class="form-check-label">تمدید خودکار</label></div>
                            <div class="col-12"><label class="form-label">یادداشت مدیریتی</label><InputTextArea class="form-control" @bind-Value="subscriptionModel.AdministrativeNote" /></div>
                            <div class="col-12"><label class="form-label">دلیل تعلیق</label><InputTextArea class="form-control" @bind-Value="subscriptionModel.SuspensionReason" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-modern btn-light-modern" @onclick="CloseEdit">انصراف</button>
                        <button type="button" class="btn-modern btn-primary-modern" disabled="@isSaving" @onclick="UpdateAsync">
                            @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<TenantDto> tenants = [];
    private List<SubscriptionPlanDto> plans = [];
    private List<SaasTenantDto> saasTenants = [];
    private CreateTenantDto createModel = new();
    private UpdateTenantDto updateModel = new();
    private ChangeSubscriptionDto subscriptionModel = new();
    private EditContext createEditContext = default!;
    private EditContext updateEditContext = default!;
    private long editingTenantId;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private bool showArchived;
    private bool showCreate;
    private bool showEdit;
    private bool showCreatePassword;
    private bool showEditPassword;
    private bool isError;
    private string? message;
    private string? createError;

    private static readonly (string Code, string Name)[] SubscriptionCurrencies =
    [
        ("AFN", "افغانی"),
        ("USD", "دالر امریکا"),
        ("EUR", "یورو"),
        ("AED", "درهم امارات"),
        ("IRR", "ریال ایران"),
        ("PKR", "روپیه پاکستان")
    ];

    private IEnumerable<TenantDto> FilteredTenants
    {
        get
        {
            var query = tenants.Where(x => x.IsArchived == showArchived);
            return string.IsNullOrWhiteSpace(searchTerm)
                ? query
                : query.Where(x => x.Name.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        plans = (await SaasService.GetPlansAsync(false)).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        tenants = (await TenantService.GetAllAsync()).ToList();
        saasTenants = (await SaasService.GetTenantsAsync(includeArchived: true)).ToList();
        isLoading = false;
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
    }

    private void ResetTenantSearch()
    {
        searchTerm = string.Empty;
    }

    private void OpenCreate()
    {
        var start = DateTime.UtcNow.Date;
        createModel = new CreateTenantDto
        {
            PlanId = plans.FirstOrDefault(x => x.IsActive)?.Id ?? 0,
            SubscriptionStartAt = start,
            SubscriptionEndAt = start.AddMonths(1),
            SubscriptionCurrencyCode = plans.FirstOrDefault(x => x.IsActive)?.CurrencyCode ?? "USD"
        };
        createEditContext = new EditContext(createModel);
        showCreatePassword = false;
        message = null;
        createError = null;
        showCreate = true;
    }

    private void CloseCreate() => showCreate = false;

    private void OpenEdit(TenantDto tenant)
    {
        editingTenantId = tenant.Id;
        updateModel = new UpdateTenantDto
        {
            Name = tenant.Name,
            LegalName = tenant.LegalName,
            ContactName = tenant.ContactName,
            ContactEmail = tenant.ContactEmail,
            ContactPhone = tenant.ContactPhone,
            AdminUserId = tenant.AdminUserId ?? 0,
            AdminFullName = tenant.AdminFullName,
            AdminUserName = tenant.AdminUserName,
            AdminEmail = tenant.AdminEmail,
            IsActive = tenant.IsActive
        };
        var subscription = saasTenants.FirstOrDefault(x => x.Id == tenant.Id);
        var start = subscription?.SubscriptionStartAt ?? DateTime.UtcNow.Date;
        subscriptionModel = new ChangeSubscriptionDto
        {
            PlanId = subscription?.PlanId ?? plans.FirstOrDefault()?.Id ?? 0,
            Status = subscription?.SubscriptionStatus ?? SubscriptionStatus.Active,
            BillingCycle = subscription?.BillingCycle ?? BillingCycle.Monthly,
            StartAt = start,
            EndAt = subscription?.SubscriptionEndAt ?? start.AddMonths(1),
            TrialEndAt = subscription?.TrialEndAt,
            GracePeriodEndAt = subscription?.GracePeriodEndAt,
            AutoRenew = subscription?.AutoRenew ?? false,
            AgreedPrice = subscription?.AgreedPrice ?? 0,
            CurrencyCode = subscription?.CurrencyCode ?? plans.FirstOrDefault(x => x.Id == subscription?.PlanId)?.CurrencyCode ?? "USD",
            AdministrativeNote = subscription?.AdministrativeNote,
            SuspensionReason = subscription?.SuspensionReason
        };
        updateEditContext = new EditContext(updateModel);
        showEditPassword = false;
        message = null;
        showEdit = true;
    }

    private void CloseEdit() => showEdit = false;

    private async Task ToggleTenantArchiveAsync(TenantDto tenant)
    {
        var action = tenant.IsArchived ? "از بایگانی خارج" : "بایگانی";
        if (!await JS.InvokeAsync<bool>("confirm", $"آیا صرافی «{tenant.Name}» {action} شود؟"))
            return;

        try
        {
            isSaving = true;
            if (tenant.IsArchived)
                await TenantService.UnarchiveAsync(tenant.Id);
            else
                await TenantService.ArchiveAsync(tenant.Id);

            message = tenant.IsArchived
                ? $"صرافی «{tenant.Name}» از بایگانی خارج شد."
                : $"صرافی «{tenant.Name}» بایگانی شد.";
            isError = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateAsync()
    {
        createError = null;
        if (!createEditContext.Validate()) return;

        try
        {
            isSaving = true;
            var created = await TenantService.CreateAsync(createModel);
            message = $"صرافی «{created.Name}» ایجاد شد و اکنون مدیر آن می‌تواند فقط با نام کاربری وارد شود.";
            isError = false;
            showCreate = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateAsync()
    {
        if (!updateEditContext.Validate()) return;

        try
        {
            isSaving = true;
            var updated = await TenantService.UpdateAsync(editingTenantId, updateModel);
            await SaasService.ChangeSubscriptionAsync(editingTenantId, subscriptionModel);
            message = $"اطلاعات صرافی «{updated.Name}» ذخیره شد.";
            isError = false;
            showEdit = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
