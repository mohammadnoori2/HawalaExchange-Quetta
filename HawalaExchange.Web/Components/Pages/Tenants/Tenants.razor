@page "/tenants"
@page "/tenants/{DetailTenantId:long}"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformWrite")]
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject ITenantAdministrationService TenantService
@inject ISaasAdministrationService SaasService
@inject ICurrentTenant CurrentTenant
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HawalaExchange.Web.Services.ImpersonationSessionStore Impersonation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@rendermode InteractiveServer

<PageRefreshButton Refresh="RefreshPageDataAsync" />
<PageTitle>@(SelectedTenant?.Name ?? "مدیریت صرافی‌ها")</PageTitle>

<div class="page-wrapper">
@if (DetailTenantId > 0)
{
    <div class="page-header"><div><h1 class="page-title">@(SelectedTenant?.Name ?? "جزئیات صرافی")</h1><span class="page-subtitle">تمام اطلاعات و عملیات همین صرافی — کد @DetailTenantId</span></div><a class="btn btn-outline-secondary" href="@ListUrl">برگشت به لیست صرافی‌ها</a></div>
    @if (!string.IsNullOrWhiteSpace(message)){<div role="alert" class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>}
    @if (SelectedTenant is { } selected)
    {
        <section class="modern-card p-3 mb-3" aria-label="خلاصه صرافی">
            <div class="platform-tenant-facts"><span>وضعیت صرافی: <strong>@(selected.IsArchived ? "بایگانی" : selected.IsActive ? "فعال" : "غیرفعال")</strong></span><span>اشتراک: @SubscriptionLabel(Saas(selected.Id)?.SubscriptionStatus)</span><span><SubscriptionExpiry EndAt="Saas(selected.Id)?.SubscriptionEndAt" /></span><span>تماس: @(selected.ContactPhone ?? "—")</span><span>ایمیل: @(selected.ContactEmail ?? "—")</span><span>تاریخ ایجاد: @DisplayDates.Date(selected.CreatedAt)</span><span>شعبه‌ها: @selected.BranchCount</span></div>
            <div class="d-flex gap-2 flex-wrap mt-3">
                @if(!selected.IsArchived){<button class="btn btn-primary" disabled="@isSaving" @onclick="()=>OpenEdit(selected)">مشخصات و تمدید اشتراک</button><AuthorizeView Policy="PlatformImpersonate"><button class="btn btn-outline-warning" disabled="@(!selected.IsActive || isSaving)" @onclick="()=>OpenImpersonation(selected)">ورود به‌جای کاربر</button></AuthorizeView>}
                <button class="btn @(selected.IsArchived ? "btn-outline-success" : "btn-outline-danger")" disabled="@isSaving" @onclick="()=>ToggleTenantArchiveAsync(selected)">@(selected.IsArchived ? "خروج از بایگانی" : "بایگانی صرافی")</button>
            </div>
        </section>
        @if(!selected.IsArchived){<AuthorizeView Policy="PlatformImpersonate"><HawalaExchange.Web.Components.Pages.Platform.TenantManagement @key="DetailTenantId" @ref="managementPanel" TenantId="DetailTenantId" Embedded="true" Renew="()=>OpenEdit(selected)" /></AuthorizeView>}
    }
    else if(!isLoading){<div class="alert alert-warning">صرافی موردنظر یافت نشد.</div>}
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">صرافی‌ها و اشتراک‌ها</h1>
            <span class="page-subtitle">هر صرافی داده‌ها، شعبه‌ها و کاربران مستقل دارد</span>
        </div>
    </div>
        <div class="page-actions platform-list-toolbar">
            <button class="btn-modern btn-primary-modern" @onclick="OpenCreate"><i class="bi bi-plus-circle"></i> صرافی جدید</button>
            <ArchiveViewToggle @bind-ShowArchived="showArchived" @bind-ShowArchived:after="PersistFilters"
                               ArchivedCount="@tenants.Count(x => x.IsArchived)" />
        </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
    }

    <CompactFilterBar AriaLabel="جستجوی صرافی‌ها"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || filter != "all" || planFilter > 0)"
                      Reset="ResetTenantSearch">
        <SearchContent>
                <input class="form-control-modern" value="@searchTerm" @oninput="OnSearchChanged"
                       aria-label="جستجوی صرافی" placeholder="نام، کد صرافی، ایمیل یا شماره تماس..." />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" aria-label="وضعیت صرافی و اشتراک" @bind="filter" @bind:after="PersistFilters"><option value="all">همه وضعیت‌ها</option><option value="soon">پایان اشتراک تا 30 روز</option><option value="expired">اشتراک منقضی‌شده</option><option value="inactive">صرافی غیرفعال</option><option value="suspended">اشتراک تعلیق‌شده</option></select>
            <select class="form-select compact-quick-filter" aria-label="پلن اشتراک" @bind="planFilter" @bind:after="PersistFilters"><option value="0">همه پلن‌ها</option>@foreach(var plan in plans){<option value="@plan.Id">@plan.Name</option>}</select>
            <select class="form-select compact-quick-filter" aria-label="مرتب‌سازی صرافی‌ها" @bind="sort" @bind:after="PersistFilters"><option value="expiry">نزدیک‌ترین انقضا</option><option value="name">نام صرافی</option><option value="activity">آخرین فعالیت</option></select>
        </QuickFilters>
    </CompactFilterBar>

    <div class="modern-card">
        <div class="table-responsive">
            <GlobalDataGrid EnableSorting="false" class="table modern-table mb-0">
                <thead>
                    <tr>
                        <th>شماره ردیف</th>
                        <th>نام صرافی / تماس</th>
                        <th>پلن</th>
                        <th>کاربران</th>
                        <th>وضعیت</th>
                        <th>اعتبار اشتراک</th>
                        <th>آخرین فعالیت</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="7" class="text-center py-5">در حال بارگذاری...</td></tr>
                    }
                    else if (!FilteredTenants.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">صرافی‌ای یافت نشد.</td></tr>
                    }
                    else
                    {
                        @foreach (var (tenant, index) in FilteredTenants.Select((tenant,index)=>(tenant,index)))
                        {
                            <tr>
                                <td>@((index + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                                <td class="fw-bold">
                                    <a data-tenant-detail="@tenant.Id" href="@DetailUrl(tenant.Id)">@tenant.Name</a><div class="small text-muted" dir="ltr">@tenant.ContactPhone</div>
                                    @if (tenant.Id == CurrentTenant.TenantId)
                                    {
                                        <span class="badge-modern badge-info ms-1">صرافی جاری</span>
                                    }
                                </td>
                                <td>@(Saas(tenant.Id)?.PlanName ?? "بدون پلن")</td>
                                <td>@tenant.UserCount</td>
                                <td>
                                    <span class="badge-modern @(tenant.IsArchived ? "badge-archived" : tenant.IsActive ? "badge-success" : "badge-secondary")">
                                        @(tenant.IsArchived ? "بایگانی" : tenant.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </td>
                                <td data-sort-value="@saasTenants.FirstOrDefault(x=>x.Id==tenant.Id)?.SubscriptionEndAt?.ToString("yyyyMMddHHmmss", System.Globalization.CultureInfo.InvariantCulture)"><SubscriptionExpiry EndAt="saasTenants.FirstOrDefault(x=>x.Id==tenant.Id)?.SubscriptionEndAt" /></td>
                                <td data-sort-value="@Saas(tenant.Id)?.LastActivityAt?.ToString("O",System.Globalization.CultureInfo.InvariantCulture)"><AppDateTime Value="Saas(tenant.Id)?.LastActivityAt" Use24Hour="true" EmptyText="فعالیتی ثبت نشده" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </GlobalDataGrid>
        </div>
    </div>
}
</div>

@if (showCreate)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable tenant-management-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ایجاد صرافی مستقل</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <EditForm EditContext="createEditContext" FormName="create-tenant" class="tenant-modal-form">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <nav class="platform-section-nav" aria-label="مراحل ایجاد صرافی">@for(var i=1;i<=4;i++){var step=i;<button type="button" disabled="@(isSaving || step>createStep)" aria-current="@(createStep==step?"step":null)" @onclick="()=>createStep=step">@step. @CreateSteps[step-1]</button>}</nav>
                        <ValidationSummary class="text-danger" />
                        <div class="alert alert-info py-2">
                            نام کاربری و ایمیل مدیر باید در کل سیستم یکتا باشند.
                        </div>
                        <div class="row g-3" hidden="@(createStep!=1)">
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-name">نام صرافی <span class="tenant-required">*</span></label>
                                <input id="tenant-name" class="form-control" @bind="createModel.Name" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.Name)" />
                            </div>
                            <div class="col-md-6"><label class="form-label">نام قانونی</label><input class="form-control" @bind="createModel.LegalName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام مسئول تماس</label><input class="form-control" @bind="createModel.ContactName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">شماره تماس</label><input class="form-control" @bind="createModel.ContactPhone" @bind:event="oninput" /></div>
                            <div class="col-12"><label class="form-label">ایمیل تماس</label><input type="email" class="form-control" @bind="createModel.ContactEmail" @bind:event="oninput" /></div>
                        </div>
                        <div class="row g-3" hidden="@(createStep!=2)">
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-name">نام مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-name" class="form-control" @bind="createModel.AdminFullName" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminFullName)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-user">نام کاربری مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-user" class="form-control" autocomplete="off" @bind="createModel.AdminUserName" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminUserName)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-email">ایمیل مدیر <span class="tenant-required">*</span></label>
                                <input id="tenant-admin-email" type="email" class="form-control" @bind="createModel.AdminEmail" @bind:event="oninput" />
                                <ValidationMessage For="@(() => createModel.AdminEmail)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="tenant-admin-password">رمز عبور مدیر <span class="tenant-required">*</span></label>
                                <div class="input-group" dir="ltr">
                                    <input id="tenant-admin-password" type="@(showCreatePassword ? "text" : "password")" class="form-control" autocomplete="new-password" @bind="createModel.AdminPassword" @bind:event="oninput" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreatePassword = !showCreatePassword"
                                            aria-label="@(showCreatePassword ? "پنهان‌کردن رمز" : "نمایش رمز")">
                                        <i class="bi @(showCreatePassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => createModel.AdminPassword)" />
                                <div class="form-text">حداقل 6 نویسه و شامل حرف بزرگ، حرف کوچک و عدد باشد.</div>
                            </div>
                        </div>
                        <div class="row g-3" hidden="@(createStep!=3)">
                            <div class="col-12"><h6>اشتراک اولیه</h6></div>
                            <div class="col-md-6">
                                <label class="form-label">پلن اشتراک <span class="tenant-required">*</span></label>
                                <InputSelect class="form-select" @bind-Value="createModel.PlanId">
                                    <option value="0">انتخاب پلن</option>
                                    @foreach (var plan in plans.Where(x => x.IsActive))
                                    {
                                        <option value="@plan.Id">@plan.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">دوره پرداخت <span class="tenant-required">*</span></label>
                                <InputSelect class="form-select" @bind-Value="createModel.BillingCycle">
                                    <option value="@BillingCycle.Monthly">ماهانه</option>
                                    <option value="@BillingCycle.Quarterly">سه‌ماهه</option>
                                    <option value="@BillingCycle.SemiAnnual">شش‌ماهه</option>
                                    <option value="@BillingCycle.Annual">سالانه</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6"><label class="form-label">تاریخ شروع <span class="tenant-required">*</span></label><DualDatePicker class="form-control" @bind-Value="createModel.SubscriptionStartAt" /></div>
                            <div class="col-md-6"><label class="form-label">تاریخ پایان <span class="tenant-required">*</span></label><DualDatePicker class="form-control" @bind-Value="createModel.SubscriptionEndAt" /><small class="text-muted"><SubscriptionExpiry EndAt="createModel.SubscriptionEndAt" /></small></div>
                            <div class="col-md-6">
                                <label class="form-label">مبلغ توافق‌شده و ارز <span class="tenant-required">*</span></label>
                                <div class="tenant-money-field">
                                    <InputSelect class="tenant-money-currency" @bind-Value="createModel.SubscriptionCurrencyCode">
                                        @foreach (var currency in SubscriptionCurrencies)
                                        {
                                            <option value="@currency.Code">@currency.Name</option>
                                        }
                                    </InputSelect>
                                    <MoneyInput class="tenant-money-amount" @bind-Value="createModel.AgreedPrice" placeholder="مبلغ" />
                                </div>
                                <ValidationMessage For="@(() => createModel.AgreedPrice)" />
                                <ValidationMessage For="@(() => createModel.SubscriptionCurrencyCode)" />
                            </div>
                            <div class="col-md-6 form-check form-switch mt-5"><InputCheckbox class="form-check-input" @bind-Value="createModel.AutoRenew" /><label class="form-check-label">تمدید خودکار</label></div>
                        </div>
                        @if(createStep==4){<section aria-label="بررسی نهایی"><h6>بررسی اطلاعات پیش از ایجاد</h6><p>صرافی: <strong>@createModel.Name</strong></p><p>مسئول تماس: @createModel.ContactName — @createModel.ContactPhone</p><p>ادمین: @createModel.AdminFullName — @createModel.AdminUserName — @createModel.AdminEmail</p><p>پلن: @plans.FirstOrDefault(x=>x.Id==createModel.PlanId)?.Name</p><p>اعتبار اشتراک: <SubscriptionExpiry EndAt="createModel.SubscriptionEndAt" /></p><p>مبلغ: @createModel.AgreedPrice.ToString("N0",System.Globalization.CultureInfo.InvariantCulture) @createModel.SubscriptionCurrencyCode</p><p class="text-muted">تا کلیک روی «ایجاد صرافی»، هیچ اطلاعاتی ثبت نمی‌شود.</p></section>}
                    </div>
                    @if (!string.IsNullOrWhiteSpace(createError))
                    {
                        <div class="alert alert-danger mx-3 mb-0" role="alert" aria-live="assertive">@createError</div>
                    }
                    <div class="modal-footer">
                        <button type="button" class="btn-modern btn-light-modern" disabled="@isSaving" @onclick="CloseCreate">انصراف</button>
                        @if(createStep>1){<button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="()=>createStep--">مرحله قبل</button>}
                        @if(createStep<4){<button type="button" class="btn btn-primary" @onclick="NextCreateStep">ادامه</button>}else{
                        <button type="button" class="btn-modern btn-primary-modern" disabled="@isSaving" @onclick="CreateAsync">
                            @(isSaving ? "در حال ایجاد..." : "ایجاد صرافی")
                        </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showEdit)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable tenant-management-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">مدیریت صرافی</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <EditForm EditContext="updateEditContext" FormName="update-tenant" class="tenant-modal-form">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />
                        <h6 class="mb-3">مشخصات صرافی</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="edit-tenant-name">نام صرافی</label>
                                <input id="edit-tenant-name" class="form-control" @bind="updateModel.Name" @bind:event="oninput" />
                                <ValidationMessage For="@(() => updateModel.Name)" />
                            </div>
                            <div class="col-md-6"><label class="form-label">نام قانونی</label><input class="form-control" @bind="updateModel.LegalName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام مسئول تماس</label><input class="form-control" @bind="updateModel.ContactName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">شماره تماس</label><input class="form-control" @bind="updateModel.ContactPhone" @bind:event="oninput" /></div>
                            <div class="col-12"><label class="form-label">ایمیل تماس</label><input type="email" class="form-control" @bind="updateModel.ContactEmail" @bind:event="oninput" /></div>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <InputCheckbox id="edit-tenant-active" class="form-check-input" @bind-Value="updateModel.IsActive" disabled="@(editingTenantId == CurrentTenant.TenantId)" />
                            <label class="form-check-label" for="edit-tenant-active">صرافی فعال باشد</label>
                        </div>
                        @if (editingTenantId == CurrentTenant.TenantId)
                        {
                            <div class="form-text">برای جلوگیری از قطع دسترسی، صرافی جاری قابل غیرفعال‌سازی نیست.</div>
                        }
                        <hr />
                        <h6 class="mb-3">مشخصات مدیر صرافی</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">نام مدیر</label><input class="form-control" @bind="updateModel.AdminFullName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">نام کاربری مدیر</label><input class="form-control" autocomplete="off" @bind="updateModel.AdminUserName" @bind:event="oninput" /></div>
                            <div class="col-md-6"><label class="form-label">ایمیل مدیر</label><input type="email" class="form-control" @bind="updateModel.AdminEmail" @bind:event="oninput" /></div>
                            <div class="col-md-6">
                                <label class="form-label">رمز عبور جدید مدیر</label>
                                <div class="input-group" dir="ltr">
                                    <input type="@(showEditPassword ? "text" : "password")" class="form-control" autocomplete="new-password" @bind="updateModel.NewAdminPassword" @bind:event="oninput" placeholder="برای عدم تغییر خالی بگذارید" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showEditPassword = !showEditPassword"
                                            aria-label="@(showEditPassword ? "پنهان‌کردن رمز" : "نمایش رمز")">
                                        <i class="bi @(showEditPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => updateModel.NewAdminPassword)" />
                            </div>
                        </div>
                        <hr />
                        <h6 class="mb-3">مدیریت اشتراک</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">پلن</label><InputSelect class="form-select" @bind-Value="subscriptionModel.PlanId">@foreach (var plan in plans) { <option value="@plan.Id">@plan.Name</option> }</InputSelect></div>
                            <div class="col-md-6"><label class="form-label">وضعیت</label><InputSelect class="form-select" @bind-Value="subscriptionModel.Status"><option value="@SubscriptionStatus.Active">فعال</option><option value="@SubscriptionStatus.Trial">آزمایشی</option><option value="@SubscriptionStatus.Suspended">تعلیق‌شده</option><option value="@SubscriptionStatus.Cancelled">لغوشده</option><option value="@SubscriptionStatus.Expired">منقضی</option></InputSelect></div>
                            <div class="col-md-6"><label class="form-label">شروع</label><DualDatePicker class="form-control" @bind-Value="subscriptionModel.StartAt" /></div>
                            <div class="col-md-6"><label class="form-label">پایان/تمدید تا</label><DualDatePicker class="form-control" @bind-Value="subscriptionModel.EndAt" /><small class="text-muted"><SubscriptionExpiry EndAt="subscriptionModel.EndAt" /></small></div>
                            <div class="col-md-6"><label class="form-label">پایان دوره آزمایشی</label><DualDatePicker class="form-control" @bind-Value="subscriptionModel.TrialEndAt" /></div>
                            <div class="col-md-6"><label class="form-label">پایان دوره مهلت</label><DualDatePicker class="form-control" @bind-Value="subscriptionModel.GracePeriodEndAt" /></div>
                            <div class="col-md-6"><label class="form-label">دوره پرداخت</label><InputSelect class="form-select" @bind-Value="subscriptionModel.BillingCycle"><option value="@BillingCycle.Monthly">ماهانه</option><option value="@BillingCycle.Quarterly">سه‌ماهه</option><option value="@BillingCycle.SemiAnnual">شش‌ماهه</option><option value="@BillingCycle.Annual">سالانه</option></InputSelect></div>
                            <div class="col-md-4"><label class="form-label">مبلغ</label><InputNumber class="form-control financial-value-input" @bind-Value="subscriptionModel.AgreedPrice" /></div>
                            <div class="col-md-4">
                                <label class="form-label">ارز</label>
                                <InputSelect class="form-select" @bind-Value="subscriptionModel.CurrencyCode">
                                    @foreach (var currency in SubscriptionCurrencies)
                                    {
                                        <option value="@currency.Code">@currency.Name (@currency.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4 form-check form-switch mt-5"><InputCheckbox class="form-check-input" @bind-Value="subscriptionModel.AutoRenew" /><label class="form-check-label">تمدید خودکار</label></div>
                            <div class="col-12"><label class="form-label">یادداشت مدیریتی</label><InputTextArea class="form-control" @bind-Value="subscriptionModel.AdministrativeNote" /></div>
                            <div class="col-12"><label class="form-label">دلیل تعلیق</label><InputTextArea class="form-control" @bind-Value="subscriptionModel.SuspensionReason" /></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-modern btn-light-modern" @onclick="CloseEdit">انصراف</button>
                        <button type="button" class="btn-modern btn-primary-modern" disabled="@isSaving" @onclick="UpdateAsync">
                            @(isSaving ? "در حال ذخیره..." : "ذخیره تغییرات")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showImpersonation)
{
    <div class="modal show d-block" tabindex="-1" dir="rtl" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5>ورود به‌جای کاربر — @impersonationTenantName</h5><button type="button" class="btn-close" @onclick="()=>showImpersonation=false"></button></div>
            <form method="post" action="/impersonation/start" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="tenantId" value="@impersonationTenantId" />
                <div class="modal-body">
                    <div class="alert alert-warning">تا 30 دقیقه، مطابق صلاحیت‌های کاربر انتخاب‌شده عمل می‌کنید. عملیات مالی واقعی است و ورود شما ثبت می‌شود. این تغییر ورود، روی تب‌های دیگر همین مرورگر نیز اثر می‌گذارد.</div>
                    <label class="form-label">کاربر فعال</label>
                    <select class="form-select mb-3" name="userId" required><option value="">انتخاب کاربر</option>
                        @foreach(var user in impersonationTargets){<option value="@user.Id">@user.Name (@user.UserName)</option>}
                    </select>
                    <label class="form-label">دلیل ورود برای پشتیبانی</label>
                    <textarea name="reason" class="form-control" required minlength="3" maxlength="500" rows="3"></textarea>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" @onclick="()=>showImpersonation=false">انصراف</button><button type="submit" class="btn btn-warning" disabled="@(impersonationTargets.Count==0)">تأیید و ورود</button></div>
            </form>
        </div></div>
    </div>
}

@code {
    private int createStep=1;
    private static readonly string[] CreateSteps=["اطلاعات صرافی","ادمین اولیه","اشتراک","بررسی نهایی"];
    private void NextCreateStep()
    {
        var names=createStep switch {1=>new[]{nameof(createModel.Name),nameof(createModel.LegalName),nameof(createModel.ContactName),nameof(createModel.ContactEmail),nameof(createModel.ContactPhone)},2=>new[]{nameof(createModel.AdminFullName),nameof(createModel.AdminUserName),nameof(createModel.AdminEmail),nameof(createModel.AdminPassword)},_=>new[]{nameof(createModel.PlanId),nameof(createModel.AgreedPrice),nameof(createModel.SubscriptionCurrencyCode)}};
        var errors=new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        foreach(var name in names) System.ComponentModel.DataAnnotations.Validator.TryValidateProperty(typeof(CreateTenantDto).GetProperty(name)!.GetValue(createModel),new System.ComponentModel.DataAnnotations.ValidationContext(createModel){MemberName=name},errors);
        if(createStep==3 && createModel.SubscriptionEndAt<=createModel.SubscriptionStartAt) errors.Add(new("تاریخ پایان باید بعد از تاریخ شروع باشد."));
        createError=errors.Count>0?string.Join("؛ ",errors.Select(x=>x.ErrorMessage)):null;
        if(errors.Count==0) createStep++;
    }
    [Parameter] public long DetailTenantId { get; set; }
    [SupplyParameterFromQuery(Name="q")] public string searchTerm { get; set; } = "";
    [SupplyParameterFromQuery(Name="status")] public string filter { get; set; } = "all";
    [SupplyParameterFromQuery(Name="plan")] public long planFilter { get; set; }
    [SupplyParameterFromQuery(Name="archived")] public bool showArchived { get; set; }
    [SupplyParameterFromQuery(Name="sort")] public string sort { get; set; } = "expiry";
    private HawalaExchange.Web.Components.Pages.Platform.TenantManagement? managementPanel;
    private TenantDto? SelectedTenant => tenants.FirstOrDefault(x=>x.Id==DetailTenantId);
    private long previousDetail;
    protected override void OnParametersSet()
    {
        if(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/')=="tenants") DetailTenantId=0;
        searchTerm??="";filter??="all";sort??="expiry";
        if(previousDetail!=DetailTenantId){showCreate=showEdit=showImpersonation=false;managementPanel=null;message=null;previousDetail=DetailTenantId;}
    }
    private SaasTenantDto? Saas(long id) => saasTenants.FirstOrDefault(x=>x.Id==id);
    private string FilterQuery => $"?q={Uri.EscapeDataString(searchTerm ?? "")}&status={Uri.EscapeDataString(filter ?? "all")}&plan={planFilter}&archived={showArchived.ToString().ToLowerInvariant()}&sort={Uri.EscapeDataString(sort ?? "expiry")}";
    private void PersistFilters() { if(DetailTenantId==0 && Navigation.ToBaseRelativePath(Navigation.Uri)!=ListUrl.TrimStart('/')) Navigation.NavigateTo(ListUrl,replace:true); }
    private string ListUrl => "/tenants" + FilterQuery;
    private string DetailUrl(long id) => $"/tenants/{id}" + FilterQuery;
    private static string SubscriptionLabel(SubscriptionStatus? status) => status switch { SubscriptionStatus.Active or SubscriptionStatus.ExpiringSoon=>"فعال",SubscriptionStatus.Trial=>"آزمایشی",SubscriptionStatus.Expired=>"منقضی‌شده",SubscriptionStatus.Suspended=>"تعلیق‌شده",SubscriptionStatus.Cancelled=>"لغوشده",_=>"ثبت نشده" };
    private bool showImpersonation;
    private long impersonationTenantId;
    private string impersonationTenantName="";
    private IReadOnlyList<HawalaExchange.Web.Services.ImpersonationTarget> impersonationTargets=[];
    private async Task OpenImpersonation(TenantDto tenant)
    {
        try
        {
            impersonationTargets=await Impersonation.GetTargetsAsync((await Authentication.GetAuthenticationStateAsync()).User,tenant.Id);
            impersonationTenantId=tenant.Id; impersonationTenantName=tenant.Name; showImpersonation=true;
        }
        catch(Exception error) { message=error.Message; isError=true; }
    }
    private async Task RefreshPageDataAsync()
    {
        await LoadAsync();
        if(managementPanel is not null) await managementPanel.RefreshEmbeddedAsync();
    }
    private List<TenantDto> tenants = [];
    private List<SubscriptionPlanDto> plans = [];
    private List<SaasTenantDto> saasTenants = [];
    private CreateTenantDto createModel = new();
    private UpdateTenantDto updateModel = new();
    private ChangeSubscriptionDto subscriptionModel = new();
    private EditContext createEditContext = default!;
    private EditContext updateEditContext = default!;
    private long editingTenantId;
    private bool isLoading = true;
    private bool isSaving;
    private bool showCreate;
    private bool showEdit;
    private bool showCreatePassword;
    private bool showEditPassword;
    private bool isError;
    private string? message;
    private string? createError;

    private static readonly (string Code, string Name)[] SubscriptionCurrencies =
    [
        ("AFN", "افغانی"),
        ("USD", "دالر امریکا"),
        ("EUR", "یورو"),
        ("AED", "درهم امارات"),
        ("IRR", "ریال ایران"),
        ("PKR", "روپیه پاکستان")
    ];

    private IEnumerable<TenantDto> FilteredTenants
    {
        get
        {
            var query = tenants.Where(x => x.IsArchived == showArchived);
            if(!string.IsNullOrWhiteSpace(searchTerm))
                query=query.Where(x=>new[]{x.Name,x.Id.ToString(System.Globalization.CultureInfo.InvariantCulture),x.ContactName,x.ContactEmail,x.ContactPhone,x.AdminEmail,x.AdminFullName}.Any(v=>v?.Contains(searchTerm.Trim(),StringComparison.OrdinalIgnoreCase)==true));
            if(planFilter>0) query=query.Where(x=>Saas(x.Id)?.PlanId==planFilter);
            var now=DateTime.UtcNow;
            query=filter switch {
                "soon"=>query.Where(x=>Saas(x.Id)?.SubscriptionEndAt is DateTime end && end>=now && end<=now.AddDays(30)),
                "expired"=>query.Where(x=>Saas(x.Id)?.SubscriptionStatus==SubscriptionStatus.Expired || Saas(x.Id)?.SubscriptionEndAt<now),
                "inactive"=>query.Where(x=>!x.IsActive),
                "suspended"=>query.Where(x=>Saas(x.Id)?.SubscriptionStatus==SubscriptionStatus.Suspended),_=>query};
            return sort switch { "name"=>query.OrderBy(x=>x.Name),"activity"=>query.OrderByDescending(x=>Saas(x.Id)?.LastActivityAt),_=>query.OrderBy(x=>Saas(x.Id)?.SubscriptionEndAt??DateTime.MaxValue).ThenBy(x=>x.Name)};
        }
    }

    protected override async Task OnInitializedAsync()
    {
        plans = (await SaasService.GetPlansAsync(false)).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        tenants = (await TenantService.GetAllAsync()).ToList();
        saasTenants = (await SaasService.GetTenantsAsync(includeArchived: true)).ToList();
        isLoading = false;
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        PersistFilters();
    }

    private void ResetTenantSearch()
    {
        searchTerm = string.Empty;
        filter="all";planFilter=0;sort="expiry";PersistFilters();
    }

    private void OpenCreate()
    {
        createStep=1;
        var start = DateTime.UtcNow.Date;
        createModel = new CreateTenantDto
        {
            PlanId = plans.FirstOrDefault(x => x.IsActive)?.Id ?? 0,
            SubscriptionStartAt = start,
            SubscriptionEndAt = start.AddMonths(1),
            SubscriptionCurrencyCode = plans.FirstOrDefault(x => x.IsActive)?.CurrencyCode ?? "USD"
        };
        createEditContext = new EditContext(createModel);
        showCreatePassword = false;
        message = null;
        createError = null;
        showCreate = true;
    }

    private void CloseCreate() => showCreate = false;

    private void OpenEdit(TenantDto tenant)
    {
        editingTenantId = tenant.Id;
        updateModel = new UpdateTenantDto
        {
            Name = tenant.Name,
            LegalName = tenant.LegalName,
            ContactName = tenant.ContactName,
            ContactEmail = tenant.ContactEmail,
            ContactPhone = tenant.ContactPhone,
            AdminUserId = tenant.AdminUserId ?? 0,
            AdminFullName = tenant.AdminFullName,
            AdminUserName = tenant.AdminUserName,
            AdminEmail = tenant.AdminEmail,
            IsActive = tenant.IsActive
        };
        var subscription = saasTenants.FirstOrDefault(x => x.Id == tenant.Id);
        var start = subscription?.SubscriptionStartAt ?? DateTime.UtcNow.Date;
        subscriptionModel = new ChangeSubscriptionDto
        {
            PlanId = subscription?.PlanId ?? plans.FirstOrDefault()?.Id ?? 0,
            Status = subscription?.SubscriptionStatus ?? SubscriptionStatus.Active,
            BillingCycle = subscription?.BillingCycle ?? BillingCycle.Monthly,
            StartAt = start,
            EndAt = subscription?.SubscriptionEndAt ?? start.AddMonths(1),
            TrialEndAt = subscription?.TrialEndAt,
            GracePeriodEndAt = subscription?.GracePeriodEndAt,
            AutoRenew = subscription?.AutoRenew ?? false,
            AgreedPrice = subscription?.AgreedPrice ?? 0,
            CurrencyCode = subscription?.CurrencyCode ?? plans.FirstOrDefault(x => x.Id == subscription?.PlanId)?.CurrencyCode ?? "USD",
            AdministrativeNote = subscription?.AdministrativeNote,
            SuspensionReason = subscription?.SuspensionReason
        };
        updateEditContext = new EditContext(updateModel);
        showEditPassword = false;
        message = null;
        showEdit = true;
    }

    private void CloseEdit() => showEdit = false;

    private async Task ToggleTenantArchiveAsync(TenantDto tenant)
    {
        var action = tenant.IsArchived ? "از بایگانی خارج" : "بایگانی";
        if (!await JS.ConfirmOrCancelAsync($"آیا صرافی «{tenant.Name}» {action} شود؟"))
            return;

        try
        {
            isSaving = true;
            if (tenant.IsArchived)
                await TenantService.UnarchiveAsync(tenant.Id);
            else
                await TenantService.ArchiveAsync(tenant.Id);

            message = tenant.IsArchived
                ? $"صرافی «{tenant.Name}» از بایگانی خارج شد."
                : $"صرافی «{tenant.Name}» بایگانی شد.";
            isError = false;
            await LoadAsync();
            if(managementPanel is not null) await managementPanel.RefreshEmbeddedAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CreateAsync()
    {
        createError = null;
        if (!createEditContext.Validate()) return;

        try
        {
            isSaving = true;
            var created = await TenantService.CreateAsync(createModel);
            message = $"صرافی «{created.Name}» ایجاد شد و اکنون مدیر آن می‌تواند فقط با نام کاربری وارد شود.";
            isError = false;
            showCreate = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            createError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateAsync()
    {
        if (!updateEditContext.Validate()) return;

        try
        {
            if(!await JS.ConfirmOrCancelAsync($"ذخیره تغییرات صرافی «{updateModel.Name}» (کد {editingTenantId})، اطلاعات مدیر و اشتراک را تأیید می‌کنید؟ وضعیت صرافی: {(updateModel.IsActive?"فعال":"غیرفعال")}{(!string.IsNullOrWhiteSpace(updateModel.NewAdminPassword)?" — رمز مدیر نیز تغییر می‌کند و نشست‌های قبلی نامعتبر می‌شوند.":"")}"))return;
            isSaving = true;
            var updated = await TenantService.UpdateAsync(editingTenantId, updateModel);
            await SaasService.ChangeSubscriptionAsync(editingTenantId, subscriptionModel);
            if(managementPanel is not null) await managementPanel.RefreshEmbeddedAsync();
            message = $"اطلاعات صرافی «{updated.Name}» ذخیره شد.";
            isError = false;
            showEdit = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}
