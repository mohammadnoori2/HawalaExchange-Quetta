@page "/transactions"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject ITransactionService TransactionService
@inject IBranchService BranchService
@inject ICustomerService CustomerService
@inject ICurrencyService CurrencyService
@inject ICorrespondentService CorrespondentService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]
<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-receipt"></i>
                مدیریت تراکنش‌ها
                <span class="page-subtitle">لیست و جستجوی تراکنش‌ها</span>
            </h5>
        </div>
        <PageHeaderStats AriaLabel="آمار تراکنش‌ها">
            <PageHeaderStat Label="کل" Value="@(transactions?.Count ?? 0)" Icon="bi-receipt" />
            <PageHeaderStat Label="پرداخت" Value="@(transactions?.Count(t => t.Status == "Paid") ?? 0)" Icon="bi-check-circle" Tone="success" />
            <PageHeaderStat Label="در انتظار" Value="@(transactions?.Count(t => t.Status == "Pending") ?? 0)" Icon="bi-clock-history" Tone="warning" />
            <PageHeaderStat Label="لغو" Value="@(transactions?.Count(t => t.Status == "Cancel") ?? 0)" Icon="bi-x-circle" Tone="danger" />
        </PageHeaderStats>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> تراکنش جدید
            </button>
        </div>
    </div>

    <CompactFilterBar AriaLabel="جستجو و فیلتر تراکنش‌ها"
                      HasActiveFilters="@(!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(filterStatus) || !string.IsNullOrWhiteSpace(filterType))"
                      Reset="ClearSearch">
        <SearchContent>
            <input class="form-control" placeholder="جستجو با شماره، مشتری یا نوع تراکنش..."
                   @bind="searchTerm" @bind:event="oninput" />
        </SearchContent>
        <QuickFilters>
            <select class="form-select compact-quick-filter" @bind="filterStatus" @bind:event="oninput">
                <option value="">همه وضعیت‌ها</option>
                <option value="Pending">در انتظار</option>
                <option value="Paid">پرداخت شده</option>
                <option value="Cancel">لغو شده</option>
            </select>
            <select class="form-select compact-quick-filter" @bind="filterType" @bind:event="oninput">
                <option value="">همه انواع</option>
                <option value="Exchange">تبدیل ارز</option>
                <option value="Transfer">انتقال</option>
                <option value="Expense">هزینه</option>
                <option value="Adjustment">تعدیل</option>
            </select>
        </QuickFilters>
    </CompactFilterBar>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredTransactions.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <GlobalDataGrid class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header" @onclick="@(() => SortBy("TransactionNo"))">
                                شماره تراکنش
                                @if (sortColumn == "TransactionNo")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("TransactionType"))">
                                نوع
                                @if (sortColumn == "TransactionType")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CustomerFullName"))">
                                مشتری
                                @if (sortColumn == "CustomerFullName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("BranchName"))">
                                شعبه
                                @if (sortColumn == "BranchName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("Status"))">
                                وضعیت
                                @if (sortColumn == "Status")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CreatedByName"))">
                                ایجاد کننده
                                @if (sortColumn == "CreatedByName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && transactions == null)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedTransactions.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ تراکنشی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن تراکنش جدید، دکمه "تراکنش جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredTransactions.Count : pageSize) + 1;
                            @foreach (var transaction in pagedTransactions)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@transaction.TransactionNo</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern @GetTypeBadge(transaction.TransactionType)">
                                            @GetTransactionTypeName(transaction.TransactionType)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@(transaction.CustomerFullName ?? "-")</span>
                                    </td>
                                    <td>@transaction.BranchName</td>
                                    <td>
                                        <span class="badge-modern @GetStatusBadge(transaction.Status)">
                                            @GetStatusName(transaction.Status)
                                        </span>
                                    </td>
                                    <td>@transaction.CreatedByName</td>
                                    <td dir="ltr">@PersianDateHelper.ToPersianDateTime12(transaction.CreatedAt)</td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewTransaction(transaction.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            @if (transaction.Status == "Pending")
                                            {
                                                <button class="action-btn action-btn-unarchive" @onclick="() => MarkAsPaid(transaction.Id)" title="پرداخت">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                                <button class="action-btn action-btn-delete" @onclick="() => ShowCancelModal(transaction.Id)" title="لغو">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                            @if (transaction.Status != "Cancel")
                                            {
                                                <button class="action-btn action-btn-print" @onclick="() => ShowReverseModal(transaction.Id)" title="برگشت">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </GlobalDataGrid>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedTransactions.Count</strong> از <strong>@filteredTransactions.Count</strong> تراکنش
                </span>

                <CompactPagination CurrentPage="currentPage"
                                   TotalPages="totalPages"
                                   PageChanged="GoToPage" />
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-check-circle"></i> پرداخت شده: @transactions.Count(t => t.Status == "Paid")
                </span>
                <span class="badge-modern badge-warning">
                    <i class="bi bi-clock-history"></i> در انتظار: @transactions.Count(t => t.Status == "Pending")
                </span>
                <span class="badge-modern badge-danger">
                    <i class="bi bi-x-circle"></i> لغو شده: @transactions.Count(t => t.Status == "Cancel")
                </span>
            </div>
            <PageSizeSelector @bind-Value="pageSize"
                              @bind-CurrentPage="currentPage" />
        </div>
    </div>
</div>

<!-- مودال ایجاد/ویرایش تراکنش -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" >
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش تراکنش" : "ایجاد تراکنش جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-receipt me-2"></i> اطلاعات تراکنش
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-tag text-muted me-1"></i> نوع تراکنش <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" @bind="currentTransaction.TransactionType">
                                        <option value="">انتخاب نوع</option>
                                        <option value="Exchange">تبدیل ارز</option>
                                        <option value="Transfer">انتقال</option>
                                        <option value="Expense">هزینه</option>
                                        <option value="Adjustment">تعدیل</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-building text-muted me-1"></i> شعبه <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" @bind="currentTransaction.BranchId">
                                        <option value="0">انتخاب شعبه</option>
                                        @foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person text-muted me-1"></i> مشتری
                                    </label>
                                    <select class="form-select" @bind="currentTransaction.CustomerId">
                                        <option value="">بدون مشتری</option>
                                        @foreach (var customer in customers)
                                        {
                                            <option value="@customer.Id">@customer.FullName (@customer.CustomerCode)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <textarea class="form-control" @bind="currentTransaction.Remarks" rows="2" placeholder="توضیحات اضافی"></textarea>
                                </div>
                            </div>

                            <hr />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-primary">
                                    <i class="bi bi-list-ul me-2"></i> جزئیات تراکنش
                                </h6>
                                <button type="button" class="btn-modern btn-success-modern btn-sm" @onclick="AddDetail">
                                    <i class="bi bi-plus-circle"></i> افزودن جزئیات
                                </button>
                            </div>

                            @for (int i = 0; i < currentTransaction.TransactionDetails.Count; i++)
                            {
                                var detail = currentTransaction.TransactionDetails[i];
                                <div class="border rounded p-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0 text-primary">جزئیات @(i + 1)</h6>
                                        <button type="button" class="btn-close" @onclick='() => RemoveDetail(i)'></button>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">از ارز</label>
                                            <select class="form-select" @bind="detail.FromCurrencyId">
                                                <option value="">انتخاب</option>
                                                @foreach (var currency in currencies)
                                                {
                                                    <option value="@currency.Id">@currency.Code</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">مبلغ از</label>
                                            <NullableMoneyInput class="form-control" @bind-Value="detail.FromAmount" />
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">به ارز</label>
                                            <select class="form-select" @bind="detail.ToCurrencyId">
                                                <option value="">انتخاب</option>
                                                @foreach (var currency in currencies)
                                                {
                                                    <option value="@currency.Id">@currency.Code</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">مبلغ به</label>
                                            <NullableMoneyInput class="form-control" @bind-Value="detail.ToAmount" />
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">نرخ تبدیل</label>
                                            <NullableMoneyInput DecimalPlaces="4" class="form-control" @bind-Value="detail.ExchangeRate" />
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">مبلغ انتقال</label>
                                            <NullableMoneyInput class="form-control" @bind-Value="detail.TransferAmount" />
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">کارمزد</label>
                                            <MoneyInput class="form-control" @bind-Value="detail.CommissionAmount" />
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <label class="form-label fw-bold small">ارز کارمزد</label>
                                            <select class="form-select" @bind="detail.CommissionCurrencyId">
                                                <option value="">انتخاب</option>
                                                @foreach (var currency in currencies)
                                                {
                                                    <option value="@currency.Id">@currency.Code</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (!currentTransaction.TransactionDetails.Any())
                            {
                                <p class="text-muted text-center py-3">هیچ جزئیاتی اضافه نشده است.</p>
                            }
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش تراکنش با شناسه: <strong>@editId</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveTransaction()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال لغو/برگشت تراکنش -->
@if (showActionModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> @(actionType == "cancel" ? "لغو تراکنش" : "برگشت تراکنش")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseActionModal()"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p>@(actionType == "cancel" ? "لطفاً دلیل لغو را وارد کنید:" : "آیا مطمئن هستید که می‌خواهید این تراکنش را برگشت دهید؟")</p>
                    @if (actionType == "cancel")
                    {
                        <textarea class="form-control" @bind="cancelReason" rows="3" placeholder="دلیل لغو..."></textarea>
                    }
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseActionModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="() => ConfirmAction()">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال نمایش جزئیات تراکنش -->
@if (showDetailModal && selectedTransaction != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-receipt me-2"></i> جزئیات تراکنش
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">شماره تراکنش</span>
                                <span class="info-value">@selectedTransaction.TransactionNo</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">نوع</span>
                                <span class="info-value">@GetTransactionTypeName(selectedTransaction.TransactionType)</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">وضعیت</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetStatusBadge(selectedTransaction.Status)">
                                        @GetStatusName(selectedTransaction.Status)
                                    </span>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">شعبه</span>
                                <span class="info-value">@selectedTransaction.BranchName</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">مشتری</span>
                                <span class="info-value">@(selectedTransaction.CustomerFullName ?? "نامشخص")</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">ایجاد کننده</span>
                                <span class="info-value">@selectedTransaction.CreatedByName</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-card">
                                <span class="info-label">تاریخ ایجاد</span>
                                <span class="info-value" dir="ltr">@PersianDateHelper.ToPersianDateTime12(selectedTransaction.CreatedAt)</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(selectedTransaction.Remarks))
                        {
                            <div class="col-md-3">
                                <div class="info-card">
                                    <span class="info-label">توضیحات</span>
                                    <span class="info-value">@selectedTransaction.Remarks</span>
                                </div>
                            </div>
                        }
                    </div>

                    <hr />

                    <h6 class="text-primary mb-3">
                        <i class="bi bi-list-ul me-2"></i> جزئیات تراکنش
                    </h6>

                    @if (selectedTransaction.TransactionDetails != null && selectedTransaction.TransactionDetails.Any())
                    {
                        <div class="table-scroll-wrapper">
                            <GlobalDataGrid class="table-modern table-striped-modern">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>از ارز</th>
                                        <th>مبلغ از</th>
                                        <th>به ارز</th>
                                        <th>مبلغ به</th>
                                        <th>نرخ</th>
                                        <th>کارمزد</th>
                                        <th>فرستنده</th>
                                        <th>گیرنده</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < selectedTransaction.TransactionDetails.Count; i++)
                                    {
                                        var d = selectedTransaction.TransactionDetails[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@d.FromCurrencyCode</td>
                                            <td>@(d.FromAmount.HasValue ? MoneyFormatHelper.Format(d.FromAmount.Value) : "-")</td>
                                            <td>@d.ToCurrencyCode</td>
                                            <td>@(d.ToAmount.HasValue ? MoneyFormatHelper.Format(d.ToAmount.Value) : "-")</td>
                                            <td>@(d.ExchangeRate.HasValue ? MoneyFormatHelper.Format(d.ExchangeRate.Value) : "-")</td>
                                            <td>@MoneyFormatHelper.Format(d.CommissionAmount)</td>
                                            <td>@d.SenderName</td>
                                            <td>@d.ReceiverName</td>
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">هیچ جزئیاتی برای این تراکنش ثبت نشده است.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDetailModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TransactionDto> transactions = new();
    private List<TransactionDto> filteredTransactions = new();
    private List<BranchDto> branches = new();
    private List<CustomerDto> customers = new();
    private List<CurrencyDto> currencies = new();
    private List<CorrespondentDto> correspondents = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchTransactions();
            }
        }
    }

    private string _filterStatus = "";
    private string filterStatus
    {
        get => _filterStatus;
        set
        {
            if (_filterStatus != value)
            {
                _filterStatus = value;
                SearchTransactions();
            }
        }
    }

    private string _filterType = "";
    private string filterType
    {
        get => _filterType;
        set
        {
            if (_filterType != value)
            {
                _filterType = value;
                SearchTransactions();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "CreatedAt";
    private bool sortAscending = false;

    private List<TransactionDto> pagedTransactions
    {
        get
        {
            var sorted = filteredTransactions;
            switch (sortColumn)
            {
                case "TransactionNo":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.TransactionNo).ToList() : filteredTransactions.OrderByDescending(t => t.TransactionNo).ToList();
                    break;
                case "TransactionType":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.TransactionType).ToList() : filteredTransactions.OrderByDescending(t => t.TransactionType).ToList();
                    break;
                case "CustomerFullName":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.CustomerFullName).ToList() : filteredTransactions.OrderByDescending(t => t.CustomerFullName).ToList();
                    break;
                case "BranchName":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.BranchName).ToList() : filteredTransactions.OrderByDescending(t => t.BranchName).ToList();
                    break;
                case "Status":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.Status).ToList() : filteredTransactions.OrderByDescending(t => t.Status).ToList();
                    break;
                case "CreatedByName":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.CreatedByName).ToList() : filteredTransactions.OrderByDescending(t => t.CreatedByName).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? filteredTransactions.OrderBy(t => t.CreatedAt).ToList() : filteredTransactions.OrderByDescending(t => t.CreatedAt).ToList();
                    break;
                default:
                    sorted = filteredTransactions.OrderByDescending(t => t.CreatedAt).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredTransactions.Count / pageSize);

    private bool showModal = false;
    private bool showActionModal = false;
    private bool showDetailModal = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private long editId = 0;
    private long actionId = 0;
    private string actionType = "";
    private string cancelReason = "";
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private TransactionDto? selectedTransaction = null;

    private CreateTransactionDto currentTransaction = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadTransactions();
    }

    private async Task LoadLookupData()
    {
        try
        {
            var branchResult = await BranchService.GetAllAsync();
            branches = branchResult.ToList();

            var customerResult = await CustomerService.GetAllAsync();
            customers = customerResult.ToList();

            var currencyResult = await CurrencyService.GetAllAsync();
            currencies = currencyResult.ToList();

            var correspondentResult = await CorrespondentService.GetAllAsync();
            correspondents = correspondentResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadTransactions()
    {
        try
        {
            isLoading = true;
            var result = await TransactionService.GetAllAsync();
            transactions = result.ToList();
            filteredTransactions = transactions;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری تراکنش‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchTransactions()
    {
        var query = transactions.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(t =>
                t.TransactionNo.ToLower().Contains(term) ||
                (t.CustomerFullName != null && t.CustomerFullName.ToLower().Contains(term)) ||
                t.TransactionType.ToLower().Contains(term)
            );
        }

        if (!string.IsNullOrEmpty(_filterStatus))
        {
            query = query.Where(t => t.Status == _filterStatus);
        }

        if (!string.IsNullOrEmpty(_filterType))
        {
            query = query.Where(t => t.TransactionType == _filterType);
        }

        filteredTransactions = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        _filterStatus = "";
        _filterType = "";
        filteredTransactions = transactions;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentTransaction = new CreateTransactionDto
        {
            TransactionDetails = new List<CreateTransactionDetailDto>()
        };
        isEditMode = false;
        editId = 0;
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private async Task OpenEditModal(long id)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var transaction = await TransactionService.GetByIdAsync(id);
            if (transaction != null)
            {
                currentTransaction = new CreateTransactionDto
                {
                    TransactionType = transaction.TransactionType,
                    BranchId = transaction.BranchId,
                    CustomerId = transaction.CustomerId,
                    CustomerFullName = transaction.CustomerFullName,
                    Remarks = transaction.Remarks,
                    TransactionDetails = transaction.TransactionDetails?.Select(d => new CreateTransactionDetailDto
                    {
                        FromCurrencyId = d.FromCurrencyId,
                        FromAmount = d.FromAmount,
                        ToCurrencyId = d.ToCurrencyId,
                        ToAmount = d.ToAmount,
                        ExchangeRate = d.ExchangeRate,
                        TransferAmount = d.TransferAmount,
                        CommissionCurrencyId = d.CommissionCurrencyId,
                        CommissionAmount = d.CommissionAmount,
                        AgentCommissionCurrencyId = d.AgentCommissionCurrencyId,
                        AgentCommissionAmount = d.AgentCommissionAmount,
                        CorrespondentId = d.CorrespondentId,
                        SenderName = d.SenderName,
                        SenderPhone = d.SenderPhone,
                        SenderTazkiraNumber = d.SenderTazkiraNumber,
                        ReceiverName = d.ReceiverName,
                        ReceiverPhone = d.ReceiverPhone,
                        ReceiverTazkiraNumber = d.ReceiverTazkiraNumber,
                        ReferenceNumber = d.ReferenceNumber,
                        Notes = d.Notes
                    }).ToList() ?? new List<CreateTransactionDetailDto>()
                };

                isEditMode = true;
                editId = id;
                validationErrors.Clear();
                successMessage = string.Empty;
                showModal = true;
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری تراکنش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void AddDetail()
    {
        currentTransaction.TransactionDetails.Add(new CreateTransactionDetailDto());
        StateHasChanged();
    }

    private void RemoveDetail(int index)
    {
        if (currentTransaction.TransactionDetails.Count > 1)
        {
            currentTransaction.TransactionDetails.RemoveAt(index);
            StateHasChanged();
        }
        else
        {
            validationErrors.Add("حداقل یک جزئیات باید وجود داشته باشد.");
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveTransaction()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrEmpty(currentTransaction.TransactionType))
            validationErrors.Add("نوع تراکنش الزامی است");
        if (currentTransaction.BranchId == 0)
            validationErrors.Add("انتخاب شعبه الزامی است");
        if (!currentTransaction.TransactionDetails.Any())
            validationErrors.Add("حداقل یک جزئیات باید اضافه شود");

        foreach (var detail in currentTransaction.TransactionDetails)
        {
            if (!detail.FromCurrencyId.HasValue && !detail.ToCurrencyId.HasValue)
                validationErrors.Add("حداقل یکی از ارزها باید انتخاب شود");
        }

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var updateRequest = new UpdateTransactionDto
                {
                    Remarks = currentTransaction.Remarks,
                    TransactionDetails = currentTransaction.TransactionDetails,
                    Transfers = currentTransaction.Transfers,
                    Expenses = currentTransaction.Expenses
                };
                await TransactionService.UpdateAsync(editId, updateRequest);
                successMessage = "تراکنش با موفقیت ویرایش شد";
            }
            else
            {
                var result = await TransactionService.ProcessExchangeAsync(currentTransaction);
                successMessage = $"تراکنش با شماره {result?.TransactionNo} با موفقیت ایجاد شد";
            }

            showModal = false;
            await LoadTransactions();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task MarkAsPaid(long id)
    {
        try
        {
            await TransactionService.MarkAsPaidAsync(id);
            successMessage = "تراکنش با موفقیت پرداخت شد";
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در پرداخت: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ShowCancelModal(long id)
    {
        actionId = id;
        actionType = "cancel";
        cancelReason = "";
        showActionModal = true;
        StateHasChanged();
    }

    private void ShowReverseModal(long id)
    {
        actionId = id;
        actionType = "reverse";
        cancelReason = "";
        showActionModal = true;
        StateHasChanged();
    }

    private void CloseActionModal()
    {
        showActionModal = false;
        StateHasChanged();
    }

    private async Task ConfirmAction()
    {
        try
        {
            if (actionType == "cancel")
            {
                if (string.IsNullOrWhiteSpace(cancelReason))
                {
                    validationErrors.Add("دلیل لغو الزامی است");
                    StateHasChanged();
                    return;
                }
                await TransactionService.CancelTransactionAsync(actionId, new CancelTransactionDto { CancelReason = cancelReason });
                successMessage = "تراکنش با موفقیت لغو شد";
            }
            else if (actionType == "reverse")
            {
                await TransactionService.ReverseTransactionAsync(actionId, new CancelTransactionDto { CancelReason = "برگشت تراکنش" });
                successMessage = "تراکنش با موفقیت برگشت داده شد";
            }

            showActionModal = false;
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showActionModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ViewTransaction(long id)
    {
        try
        {
            isLoading = true;
            selectedTransaction = await TransactionService.GetByIdAsync(id);
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedTransaction = null;
        StateHasChanged();
    }

    private string GetTransactionTypeName(string type) => AppDisplayText.TransactionType(type);

    private string GetStatusName(string status) => AppDisplayText.Status(status);

    private string GetTypeBadge(string type)
    {
        return type switch
        {
            "Exchange" => "badge-primary",
            "Transfer" => "badge-info",
            "Expense" => "badge-danger",
            "Adjustment" => "badge-warning",
            _ => "badge-secondary"
        };
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => "badge-warning",
            "Paid" => "badge-success",
            "Cancel" => "badge-danger",
            _ => "badge-secondary"
        };
    }
