    private async Task ConfirmAction()
    {
        try
        {
            if (actionType == "cancel")
            {
                if (string.IsNullOrWhiteSpace(cancelReason))
                {
                    validationErrors.Add("دلیل لغو الزامی است");
                    StateHasChanged();
                    return;
                }
                await TransactionService.CancelTransactionAsync(actionId, new CancelTransactionDto { CancelReason = cancelReason });
                successMessage = "تراکنش با موفقیت لغو شد";
            }
            else if (actionType == "reverse")
            {
                await TransactionService.ReverseTransactionAsync(actionId, new CancelTransactionDto { CancelReason = "برگشت تراکنش" });
                successMessage = "تراکنش با موفقیت برگشت داده شد";
            }

            showActionModal = false;
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showActionModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

