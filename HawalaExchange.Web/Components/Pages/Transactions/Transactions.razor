    private string GetTransactionTypeName(string type)
    {
        return type switch
        {
            "HawalaSend" => "حواله ارسال",
            "HawalaReceive" => "حواله دریافت",
            "Exchange" => "تبدیل ارز",
            "Transfer" => "انتقال",
            "Expense" => "هزینه",
            "Adjustment" => "تعدیل",
            _ => type ?? "نامشخص"
        };
    }

    private MarkupString GetStatusBadge(string status)
    {
        string badge = status switch
        {
            "Pending" => "<span class='badge bg-warning text-dark px-3 py-2'>در انتظار</span>",
            "Paid" => "<span class='badge bg-success px-3 py-2'>پرداخت شده</span>",
            "Cancel" => "<span class='badge bg-danger px-3 py-2'>لغو شده</span>",
            _ => $"<span class='badge bg-secondary px-3 py-2'>{status}</span>"
        };
        return new MarkupString(badge);
    }
