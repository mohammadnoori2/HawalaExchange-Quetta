@page "/transfers"
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Authorization
@inject ITransferService TransferService
@inject ITransactionService TransactionService
@inject IAccountService AccountService
@inject ICurrencyService CurrencyService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-arrow-left-right"></i>
                مدیریت انتقال‌ها
                <span class="page-subtitle">لیست و جستجوی انتقال‌ها</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="() => OpenCreateModal()">
                <i class="bi bi-plus-circle"></i> انتقال جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                    <div>
                        <div class="stat-number">@transfers.Count</div>
                        <div class="stat-label">تعداد انتقال‌ها</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-cash"></i>
                    </div>
                    <div>
                        <div class="stat-number">@transfers.Count(t => t.TransferMethod == "Cash")</div>
                        <div class="stat-label">نقدی</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-bank"></i>
                    </div>
                    <div>
                        <div class="stat-number">@transfers.Count(t => t.TransferMethod == "Bank")</div>
                        <div class="stat-label">بانکی</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-warning">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning">
                        <i class="bi bi-globe"></i>
                    </div>
                    <div>
                        <div class="stat-number">@transfers.Count(t => t.TransferMethod == "Hawala")</div>
                        <div class="stat-label">حواله</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <!-- جستجو -->
                <div class="search-modern">
                    <span class="search-icon"><i class="bi bi-search"></i></span>
                    <input type="text" class="search-input" placeholder="جستجو (حساب مبدأ، مقصد، ارز، روش، شماره مرجع)..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="search-btn" @onclick="() => ClearSearch()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- فیلتر روش انتقال -->
                <div class="filter-selector">
                    <select class="form-select form-select-sm" 
                            @bind="filterMethod" @bind:event="oninput">
                        <option value="">همه روش‌ها</option>
                        <option value="Cash">نقدی</option>
                        <option value="Bank">بانکی</option>
                        <option value="Hawala">حواله</option>
                    </select>
                </div>

                <!-- انتخاب تعداد نمایش -->
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>

            <div class="table-card-header-right">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredTransfers.Count
                </span>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header @(sortColumn == "FromAccountName" ? "active" : "")" @onclick="@(() => SortBy("FromAccountName"))">
                                از حساب
                                @if (sortColumn == "FromAccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "ToAccountName" ? "active" : "")" @onclick="@(() => SortBy("ToAccountName"))">
                                به حساب
                                @if (sortColumn == "ToAccountName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "CurrencyCode" ? "active" : "")" @onclick="@(() => SortBy("CurrencyCode"))">
                                ارز
                                @if (sortColumn == "CurrencyCode")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "Amount" ? "active" : "")" @onclick="@(() => SortBy("Amount"))">
                                مبلغ
                                @if (sortColumn == "Amount")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header @(sortColumn == "TransferMethod" ? "active" : "")" @onclick="@(() => SortBy("TransferMethod"))">
                                روش انتقال
                                @if (sortColumn == "TransferMethod")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>شماره مرجع</th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && transfers == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedTransfers.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ انتقالی یافت نشد</span>
                                        <p class="text-muted small">برای افزودن انتقال جدید، دکمه "انتقال جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredTransfers.Count : pageSize) + 1;
                            @foreach (var transfer in pagedTransfers)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <span class="customer-code">@transfer.FromAccountName</span>
                                    </td>
                                    <td>
                                        <span class="customer-code">@transfer.ToAccountName</span>
                                    </td>
                                    <td>
                                        <span class="badge-modern badge-info">@transfer.CurrencyCode</span>
                                    </td>
                                    <td dir="ltr" class="fw-bold text-primary">@MoneyFormatHelper.Format(transfer.Amount)</td>
                                    <td>
                                        <span class="badge-modern @GetTransferMethodBadge(transfer.TransferMethod)">
                                            @GetTransferMethodName(transfer.TransferMethod)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="overflow-ellipsis" style="max-width: 120px;">@(transfer.ReferenceNumber ?? "-")</span>
                                    </td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewTransfer(transfer.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedTransfers.Count</strong> از <strong>@filteredTransfers.Count</strong> انتقال
                </span>

                <!-- صفحه‌بندی -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-cash"></i> نقدی: @transfers.Count(t => t.TransferMethod == "Cash")
                </span>
                <span class="badge-modern badge-info">
                    <i class="bi bi-bank"></i> بانکی: @transfers.Count(t => t.TransferMethod == "Bank")
                </span>
                <span class="badge-modern badge-warning">
                    <i class="bi bi-globe"></i> حواله: @transfers.Count(t => t.TransferMethod == "Hawala")
                </span>
            </div>
        </div>
    </div>
</div>

<!-- مودال ایجاد انتقال جدید -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-plus-circle me-2"></i> ایجاد انتقال جدید
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseModal()"></button>
                </div>
                <div class="modal-body">
                    <!-- پیام‌های خطا -->
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <!-- اطلاعات انتقال -->
                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary">
                                <i class="bi bi-arrow-left-right me-2"></i> اطلاعات انتقال
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-right text-muted me-1"></i> روش انتقال <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select"
                                            @bind="currentTransfer.TransferMethod">
                                        <option value="">انتخاب روش</option>
                                        <option value="Cash">نقدی</option>
                                        <option value="Bank">بانکی</option>
                                        <option value="Hawala">حواله</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-right-circle text-muted me-1"></i> حساب مبدأ <span class="text-danger">*</span>
                                    </label>
                                    <AccountSearchSelect Accounts="@accounts"
                                                         @bind-Value="currentTransfer.FromAccountId"
                                                         Placeholder="جستجوی حساب مبدأ..." />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-arrow-left-circle text-muted me-1"></i> حساب مقصد <span class="text-danger">*</span>
                                    </label>
                                    <AccountSearchSelect Accounts="@accounts"
                                                         @bind-Value="currentTransfer.ToAccountId"
                                                         Placeholder="جستجوی حساب مقصد..." />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-coin text-muted me-1"></i> ارز <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select"
                                            @bind="currentTransfer.CurrencyId">
                                        <option value="0">انتخاب ارز</option>
                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-cash-stack text-muted me-1"></i> مبلغ <span class="text-danger">*</span>
                                    </label>
                                    <MoneyInput class="form-control"
                                                @bind-Value="currentTransfer.Amount" placeholder="مبلغ انتقال" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash text-muted me-1"></i> شماره مرجع
                                    </label>
                                    <input type="text" class="form-control" @bind="currentTransfer.ReferenceNumber" placeholder="شماره مرجع (اختیاری)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-chat text-muted me-1"></i> توضیحات
                                    </label>
                                    <input type="text" class="form-control" @bind="currentTransfer.Remarks" placeholder="توضیحات اضافی" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseModal()">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="() => SaveTransfer()" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        ایجاد
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال مشاهده جزئیات انتقال -->
@if (showDetailModal && selectedTransfer != null)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #0dcaf0, #0a9ec4);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-info-circle me-2"></i> جزئیات انتقال
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => CloseDetailModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">شناسه انتقال</span>
                                <span class="info-value">@selectedTransfer.Id</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">روش انتقال</span>
                                <span class="info-value">
                                    <span class="badge-modern @GetTransferMethodBadge(selectedTransfer.TransferMethod)">
                                        @GetTransferMethodName(selectedTransfer.TransferMethod)
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">حساب مبدأ</span>
                                <span class="info-value">@selectedTransfer.FromAccountName</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">حساب مقصد</span>
                                <span class="info-value">@selectedTransfer.ToAccountName</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">ارز</span>
                                <span class="info-value">@selectedTransfer.CurrencyCode</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">مبلغ</span>
                                <span class="info-value text-primary fw-bold">@MoneyFormatHelper.Format(selectedTransfer.Amount)</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">شماره مرجع</span>
                                <span class="info-value">@(selectedTransfer.ReferenceNumber ?? "-")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <span class="info-label">توضیحات</span>
                                <span class="info-value">@(selectedTransfer.Remarks ?? "-")</span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="() => CloseDetailModal()">
                        <i class="bi bi-x-circle"></i> بستن
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TransferDto> transfers = new();
    private List<TransferDto> filteredTransfers = new();
    private List<TransactionDto> transactions = new();
    private List<AccountDto> accounts = new();
    private List<CurrencyDto> currencies = new();

    private string _searchTerm = string.Empty;
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            if (_searchTerm != value)
            {
                _searchTerm = value;
                SearchTransfers();
            }
        }
    }

    private string _filterMethod = "";
    private string filterMethod
    {
        get => _filterMethod;
        set
        {
            if (_filterMethod != value)
            {
                _filterMethod = value;
                SearchTransfers();
            }
        }
    }

    // ===== متغیرهای صفحه‌بندی و مرتب‌سازی =====
    private int pageSize = 10;
    private int currentPage = 1;
    private string sortColumn = "TransferMethod";
    private bool sortAscending = true;

    private List<TransferDto> pagedTransfers
    {
        get
        {
            // مرتب‌سازی
            var sorted = filteredTransfers;
            switch (sortColumn)
            {
                case "FromAccountName":
                    sorted = sortAscending ? filteredTransfers.OrderBy(t => t.FromAccountName).ToList() : filteredTransfers.OrderByDescending(t => t.FromAccountName).ToList();
                    break;
                case "ToAccountName":
                    sorted = sortAscending ? filteredTransfers.OrderBy(t => t.ToAccountName).ToList() : filteredTransfers.OrderByDescending(t => t.ToAccountName).ToList();
                    break;
                case "CurrencyCode":
                    sorted = sortAscending ? filteredTransfers.OrderBy(t => t.CurrencyCode).ToList() : filteredTransfers.OrderByDescending(t => t.CurrencyCode).ToList();
                    break;
                case "Amount":
                    sorted = sortAscending ? filteredTransfers.OrderBy(t => t.Amount).ToList() : filteredTransfers.OrderByDescending(t => t.Amount).ToList();
                    break;
                case "TransferMethod":
                    sorted = sortAscending ? filteredTransfers.OrderBy(t => t.TransferMethod).ToList() : filteredTransfers.OrderByDescending(t => t.TransferMethod).ToList();
                    break;
                default:
                    sorted = filteredTransfers.OrderByDescending(t => t.TransferMethod).ToList();
                    break;
            }

            // صفحه‌بندی
            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

    private int totalPages => pageSize == 0 ? 1 : (int)Math.Ceiling((double)filteredTransfers.Count / pageSize);

    private bool showModal = false;
    private bool showDetailModal = false;
    private bool isLoading = false;
    private List<string> validationErrors = new();
    private string successMessage = string.Empty;
    private TransferDto? selectedTransfer = null;

    private CreateTransferDto currentTransfer = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupData();
        await LoadTransfers();
    }

    private async Task LoadLookupData()
    {
        try
        {
            var transactionResult = await TransactionService.GetAllAsync();
            transactions = transactionResult.ToList();

            var accountResult = await AccountService.GetAllAsync();
            accounts = accountResult.ToList();

            var currencyResult = await CurrencyService.GetAllAsync();
            currencies = currencyResult.ToList();
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
        }
    }

    private async Task LoadTransfers()
    {
        try
        {
            isLoading = true;
            var result = await TransferService.GetAllAsync();
            transfers = result.ToList();
            filteredTransfers = transfers;
            currentPage = 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری انتقال‌ها: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchTransfers()
    {
        var query = transfers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLower();
            query = query.Where(t =>
                (t.FromAccountName != null && t.FromAccountName.ToLower().Contains(term)) ||
                (t.ToAccountName != null && t.ToAccountName.ToLower().Contains(term)) ||
                (t.CurrencyCode != null && t.CurrencyCode.ToLower().Contains(term)) ||
                (t.ReferenceNumber != null && t.ReferenceNumber.ToLower().Contains(term)) ||
                t.TransferMethod.ToLower().Contains(term)
            );
        }

        if (!string.IsNullOrEmpty(_filterMethod))
        {
            query = query.Where(t => t.TransferMethod == _filterMethod);
        }

        filteredTransfers = query.ToList();
        currentPage = 1;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        filterMethod = "";
        filteredTransfers = transfers;
        currentPage = 1;
        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void OpenCreateModal()
    {
        currentTransfer = new CreateTransferDto
        {
            FromAccountId = 0,
            ToAccountId = 0,
            CurrencyId = 0,
            Amount = 0,
            TransferMethod = "",
            ReferenceNumber = "",
            Remarks = ""
        };
        validationErrors.Clear();
        successMessage = string.Empty;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveTransfer()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        
        if (currentTransfer.FromAccountId == 0)
            validationErrors.Add("انتخاب حساب مبدأ الزامی است");
        if (currentTransfer.ToAccountId == 0)
            validationErrors.Add("انتخاب حساب مقصد الزامی است");
        if (currentTransfer.FromAccountId == currentTransfer.ToAccountId)
            validationErrors.Add("حساب مبدأ و مقصد نمی‌توانند یکسان باشند");
        if (currentTransfer.CurrencyId == 0)
            validationErrors.Add("انتخاب ارز الزامی است");
        if (currentTransfer.Amount <= 0)
            validationErrors.Add("مبلغ باید بزرگتر از صفر باشد");
        if (string.IsNullOrWhiteSpace(currentTransfer.TransferMethod))
            validationErrors.Add("انتخاب روش انتقال الزامی است");

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            var result = await TransferService.CreateTransferAsync(currentTransfer);
            successMessage = $"انتقال با شناسه {result.Id} با موفقیت ایجاد شد";

            showModal = false;
            await LoadTransfers();
        }
        catch (InvalidOperationException ex)
        {
            validationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewTransfer(long id)
    {
        try
        {
            isLoading = true;
            selectedTransfer = await TransferService.GetTransferByIdAsync(id);
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری جزئیات: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedTransfer = null;
        StateHasChanged();
    }

    private string GetTransferMethodName(string method)
    {
        return method switch
        {
            "Cash" => "نقدی",
            "Bank" => "بانکی",
            "Hawala" => "حواله",
            _ => method ?? "نامشخص"
        };
    }

    private string GetTransferMethodBadge(string method)
    {
        return method switch
        {
            "Cash" => "badge-success",
            "Bank" => "badge-info",
            "Hawala" => "badge-warning",
            _ => "badge-secondary"
        };
    }
}
