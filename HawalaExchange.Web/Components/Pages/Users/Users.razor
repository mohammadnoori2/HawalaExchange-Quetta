    private async Task LoadUsers()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var query = UserManager.Users.AsQueryable();

            if (!string.IsNullOrEmpty(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(u =>
                    u.UserName != null && u.UserName.ToLower().Contains(term) ||
                    (u.FullName != null && u.FullName.ToLower().Contains(term)) ||
                    (u.Email != null && u.Email.ToLower().Contains(term)));
            }

            if (!string.IsNullOrEmpty(filterRole))
            {
                var usersInRole = await UserManager.GetUsersInRoleAsync(filterRole);
                var userIds = usersInRole.Select(u => u.Id).ToList();
                query = query.Where(u => userIds.Contains(u.Id));
            }

            if (!string.IsNullOrEmpty(filterStatus))
            {
                var isActive = bool.Parse(filterStatus);
                query = query.Where(u => u.IsActive == isActive);
            }

            if (filterBranchId > 0)
            {
                query = query.Where(u => u.BranchId == filterBranchId);
            }

            query = sortAscending
                ? query.OrderBy(u => EF.Property<object>(u, sortColumn))
                : query.OrderByDescending(u => EF.Property<object>(u, sortColumn));

            var dbUsers = await query.ToListAsync();
            totalCount = dbUsers.Count;

            var pagedDbUsers = dbUsers
                .Skip((currentPage - 1) * (pageSize == 0 ? totalCount : pageSize))
                .Take(pageSize == 0 ? totalCount : pageSize)
                .ToList();

            users = new List<UserDto>();
            foreach (var user in pagedDbUsers)
            {
                var userRoles = await UserManager.GetRolesAsync(user);
                var branchName = branches.FirstOrDefault(b => b.Id == user.BranchId)?.Name ?? "-";

                users.Add(new UserDto
                {
                    Id = user.Id,
                    UserName = user.UserName,
                    Email = user.Email,
                    FullName = user.FullName,
                    BranchId = user.BranchId,
                    BranchName = branchName,
                    IsActive = user.IsActive,
                    CreatedAt = user.CreatedAt,
                    Roles = userRoles.ToArray()
                });
            }

            filteredUsers = users;
            totalPages = pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در بارگذاری کاربران: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        filterRole = "";
        filterStatus = "";
        filterBranchId = 0;
        currentPage = 1;
        await LoadUsers();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            _ = LoadUsers();
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        _ = LoadUsers();
    }

