    private void ShowResetPasswordModal(long id)
    {
        resetPasswordUserId = id;
        resetPasswordUserName = users.FirstOrDefault(u => u.Id == id)?.FullName ?? "";
        resetPasswordNewPassword = "";
        resetPasswordConfirmPassword = "";
