        showResetPasswordModal = true;
        StateHasChanged();
    }

    private async Task ConfirmResetPassword()
    {
        if (string.IsNullOrEmpty(resetPasswordNewPassword))
        {
            resetPasswordError = "لطفاً رمز عبور جدید را وارد کنید.";
            StateHasChanged();
            return;
        }

        if (resetPasswordNewPassword.Length < 6)
        {
            resetPasswordError = "رمز عبور باید حداقل 6 کاراکتر باشد.";
            StateHasChanged();
            return;
        }

        if (resetPasswordNewPassword != resetPasswordConfirmPassword)
        {
            resetPasswordError = "رمز عبور و تکرار آن مطابقت ندارند.";
            StateHasChanged();
            return;
        }

        try
        {
            isResetPasswordSubmitting = true;
            StateHasChanged();

            var user = await UserManager.FindByIdAsync(resetPasswordUserId.ToString());
            if (user == null)
            {
                resetPasswordError = "کاربر یافت نشد";
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var result = await UserManager.ResetPasswordAsync(user, token, resetPasswordNewPassword);

            if (result.Succeeded)
            {
                successMessage = "رمز عبور با موفقیت بازنشانی شد.";
                showResetPasswordModal = false;
                await LoadUsers();
            }
            else
            {
                resetPasswordError = string.Join(" - ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            resetPasswordError = $"خطا: {ex.Message}";
        }
        finally
        {
            isResetPasswordSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task SaveUser()
    {
        validationErrors.Clear();
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(currentUser.FullName))
            validationErrors.Add("نام کامل الزامی است");

        if (string.IsNullOrWhiteSpace(currentUser.Email))
            validationErrors.Add("ایمیل الزامی است");

        if (!isEditMode && string.IsNullOrWhiteSpace(currentUser.UserName))
            validationErrors.Add("نام کاربری الزامی است");

        if (currentUser.BranchId == 0)
            validationErrors.Add("انتخاب شعبه الزامی است");

        if (string.IsNullOrWhiteSpace(currentUser.Role))
            validationErrors.Add("انتخاب نقش الزامی است");

        if (!isEditMode)
        {
            if (string.IsNullOrWhiteSpace(currentUser.Password))
                validationErrors.Add("رمز عبور الزامی است");

            if (currentUser.Password != currentUser.ConfirmPassword)
                validationErrors.Add("رمز عبور و تکرار آن مطابقت ندارند");

            if (currentUser.Password.Length < 6)
                validationErrors.Add("رمز عبور باید حداقل 6 کاراکتر باشد");
        }

        if (validationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            if (isEditMode)
            {
                var user = await UserManager.FindByIdAsync(editId.ToString());
                if (user == null)
                {
                    validationErrors.Add("کاربر یافت نشد");
                    return;
                }

                user.FullName = currentUser.FullName;
                user.BranchId = currentUser.BranchId ?? 1;
                user.Email = currentUser.Email;

                var currentRoles = await UserManager.GetRolesAsync(user);
                await UserManager.RemoveFromRolesAsync(user, currentRoles);
                await UserManager.AddToRoleAsync(user, currentUser.Role);

                var result = await UserManager.UpdateAsync(user);
                if (result.Succeeded)
                {
                    successMessage = "کاربر با موفقیت ویرایش شد";
                }
                else
                {
                    validationErrors.AddRange(result.Errors.Select(e => e.Description));
                }
            }
            else
            {
                var user = new ApplicationUser
                {
                    UserName = currentUser.UserName,
                    Email = currentUser.Email,
                    FullName = currentUser.FullName,
                    BranchId = currentUser.BranchId ?? 1,
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow
                };

                var result = await UserManager.CreateAsync(user, currentUser.Password);
                if (result.Succeeded)
                {
                    await UserManager.AddToRoleAsync(user, currentUser.Role);
                    successMessage = "کاربر با موفقیت ایجاد شد";
                }
                else
                {
                    validationErrors.AddRange(result.Errors.Select(e => e.Description));
                }
            }

            if (string.IsNullOrEmpty(validationErrors.FirstOrDefault()))
            {
                showModal = false;
                await LoadUsers();
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

