@page "/users"
@attribute [Authorize(Roles = "Admin,Manager")]

@using HawalaExchange.Application.Interfaces.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HawalaExchange.Domain.Entities
@using HawalaExchange.Application.DTOs
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole<long>> RoleManager
@inject IBranchService BranchService
@inject NavigationManager NavigationManager
@inject ILogger<Users> Logger
@rendermode InteractiveServer

<div class="page-wrapper">
    <!-- هدر صفحه -->
    <div class="page-header">
        <div>
            <h5 class="page-title">
                <i class="bi bi-people"></i>
                مدیریت کاربران
                <span class="page-subtitle">لیست و جستجوی کاربران</span>
            </h5>
        </div>
        <div class="page-actions">
            <button class="btn-modern btn-primary-modern btn-rounded" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle"></i> کاربر جدید
            </button>
        </div>
    </div>

    <!-- کارت آماری -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <div class="stat-number">@totalCount</div>
                        <div class="stat-label">تعداد کاربران</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-success">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@users.Count(u => u.IsActive)</div>
                        <div class="stat-label">فعال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-danger">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon danger">
                        <i class="bi bi-slash-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number">@users.Count(u => !u.IsActive)</div>
                        <div class="stat-label">غیرفعال</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card stat-card-info">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon info">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-number">@users.Count(u => u.CreatedAt.Date == DateTime.Today)</div>
                        <div class="stat-label">ایجاد امروز</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- فیلترها -->
    <div class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold"><i class="bi bi-search text-muted me-1"></i> جستجو</label>
            <input type="text" class="form-control" placeholder="نام، نام کاربری، ایمیل..."
                   @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-tag text-muted me-1"></i> نقش</label>
            <select class="form-select" @bind="filterRole" @bind:event="oninput">
                <option value="">همه نقش‌ها</option>
                @foreach (var role in roles)
                {
                    <option value="@role">@GetRoleName(role)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-circle text-muted me-1"></i> وضعیت</label>
            <select class="form-select" @bind="filterStatus" @bind:event="oninput">
                <option value="">همه</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold"><i class="bi bi-building text-muted me-1"></i> شعبه</label>
            <select class="form-select" @bind="filterBranchId" @bind:event="oninput">
                <option value="0">همه شعبه‌ها</option>
                @foreach (var branch in branches)
                {
                    <option value="@branch.Id">@branch.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn-modern btn-primary-modern w-100" @onclick="ApplyFilters">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <button class="btn-modern btn-light-modern w-100" @onclick="ResetFilters">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- کارت جدول -->
    <div class="table-card">
        <div class="table-card-header">
            <div class="table-card-header-left">
                <span class="badge-modern badge-info">
                    <i class="bi bi-list-ul"></i> @filteredUsers.Count
                </span>
            </div>
            <div class="table-card-header-right">
                <div class="page-size-selector">
                    <span class="text-muted small">تعداد نمایش:</span>
                    <select class="select-page-size" @bind="pageSize" @bind:event="oninput">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="30">30</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="0">همه</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-card-body">
            <div class="table-scroll-wrapper">
                <table class="table-modern table-striped-modern">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="sortable-header" @onclick="@(() => SortBy("FullName"))">
                                نام کامل
                                @if (sortColumn == "FullName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("UserName"))">
                                نام کاربری
                                @if (sortColumn == "UserName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("Email"))">
                                ایمیل
                                @if (sortColumn == "Email")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th>نقش‌ها</th>
                            <th class="sortable-header" @onclick="@(() => SortBy("BranchName"))">
                                شعبه
                                @if (sortColumn == "BranchName")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("IsActive"))">
                                وضعیت
                                @if (sortColumn == "IsActive")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="sortable-header" @onclick="@(() => SortBy("CreatedAt"))">
                                تاریخ ایجاد
                                @if (sortColumn == "CreatedAt")
                                {
                                    <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                }
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && users == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="loading-state">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">در حال بارگذاری...</span>
                                        </div>
                                        <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (!pagedUsers.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fs-5 text-muted">هیچ کاربری یافت نشد</span>
                                        <p class="text-muted small">برای افزودن کاربر جدید، دکمه "کاربر جدید" را کلیک کنید</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIndex = (currentPage - 1) * (pageSize == 0 ? filteredUsers.Count : pageSize) + 1;
                            @foreach (var user in pagedUsers)
                            {
                                <tr>
                                    <td><span class="fw-bold text-muted">@rowIndex</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar avatar-primary">
                                                @user.FullName?.Substring(0, Math.Min(2, user.FullName?.Length ?? 0)).ToUpper()
                                            </div>
                                            <span class="fw-semibold">@user.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="customer-code">@user.UserName</span>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge-modern @GetRoleBadge(role)">
                                                @GetRoleName(role)
                                            </span>
                                        }
                                    </td>
                                    <td>@(user.BranchName ?? "-")</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge-modern badge-active">
                                                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-archived">
                                                <i class="bi bi-slash-circle"></i> غیرفعال
                                            </span>
                                        }
                                    </td>
                                    <td dir="ltr">@user.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <div class="action-group justify-content-center">
                                            <button class="action-btn action-btn-view" @onclick="() => ViewUser(user.Id)" title="مشاهده">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="action-btn action-btn-edit" @onclick="() => OpenEditModal(user.Id)" title="ویرایش">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (user.IsActive)
                                            {
                                                <button class="action-btn action-btn-delete" @onclick="() => ShowDeactivateConfirm(user.Id)" title="غیرفعال‌سازی">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn action-btn-unarchive" @onclick="() => ShowActivateConfirm(user.Id)" title="فعال‌سازی">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            }
                                            <button class="action-btn action-btn-print" @onclick="() => ShowResetPasswordModal(user.Id)" title="بازنشانی رمز">
                                                <i class="bi bi-key"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-card-footer">
            <div class="table-card-footer-left">
                <span class="text-muted small">
                    نمایش <strong>@pagedUsers.Count</strong> از <strong>@filteredUsers.Count</strong> کاربر
                </span>

                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination-modern">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <div class="table-card-footer-right">
                <span class="badge-modern badge-success">
                    <i class="bi bi-check-circle"></i> فعال: @users.Count(u => u.IsActive)
                </span>
                <span class="badge-modern badge-danger">
                    <i class="bi bi-slash-circle"></i> غیرفعال: @users.Count(u => !u.IsActive)
                </span>
            </div>
        </div>
    </div>
</div>

<!-- مودال‌ها -->
@if (showModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);" dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "ویرایش کاربر" : "ایجاد کاربر جدید")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i> لطفاً خطاهای زیر را اصلاح کنید:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i> @successMessage
                        </div>
                    }

                    <div class="modern-card mb-4">
                        <div class="card-header">
                            <h6 class="text-primary"><i class="bi bi-person-badge me-2"></i> اطلاعات کاربر</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">نام کامل <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" @bind="currentUser.FullName" placeholder="نام و نام خانوادگی" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">نام کاربری <span class="text-danger">*</span></label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" class="form-control bg-light" value="@userNameDisplay" disabled readonly />
                                        <small class="text-muted">نام کاربری قابل ویرایش نیست</small>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" @bind="currentUser.UserName" placeholder="نام کاربری" />
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">ایمیل <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" @bind="currentUser.Email" placeholder="example@email.com" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">شعبه <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="currentUser.BranchId">
                                        <option value="0">انتخاب شعبه</option>
                                        @foreach (var branch in branches)
                                        {
                                            <option value="@branch.Id">@branch.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">نقش <span class="text-danger">*</span></label>
                                    <select class="form-select" @bind="currentUser.Role">
                                        <option value="">انتخاب نقش</option>
                                        <option value="Admin">مدیر</option>
                                        <option value="Manager">سرپرست</option>
                                        <option value="Cashier">صندوقدار</option>
                                        <option value="Supervisor">ناظر</option>
                                    </select>
                                </div>
                            </div>

                            @if (!isEditMode)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">رمز عبور <span class="text-danger">*</span></label>
                                        <input type="password" class="form-control" @bind="currentUser.Password" placeholder="رمز عبور" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">تکرار رمز عبور <span class="text-danger">*</span></label>
                                        <input type="password" class="form-control" @bind="currentUser.ConfirmPassword" placeholder="تکرار رمز عبور" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(currentUser.Password) && !string.IsNullOrEmpty(currentUser.ConfirmPassword) && currentUser.Password != currentUser.ConfirmPassword)
                                {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle"></i> رمز عبور و تکرار آن مطابقت ندارند.
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    <small>برای تغییر رمز عبور، از گزینه «بازنشانی رمز عبور» در بخش مدیریت کاربران استفاده کنید.</small>
                                </div>
                            }
                        </div>
                    </div>

                    @if (isEditMode)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <small>در حال ویرایش کاربر: <strong>@userNameDisplay</strong></small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseModal">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="SaveUser" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        @(isEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال تأیید -->
@if (showConfirmModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-exclamation-triangle me-2"></i> تأیید عملیات
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseConfirmModal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-question-circle fs-1 text-warning d-block mb-3"></i>
                    <p class="fs-5">@confirmMessage</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseConfirmModal">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-danger-modern" @onclick="ConfirmAction">
                        <i class="bi bi-check-circle"></i> تأیید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- مودال بازنشانی رمز -->
@if (showResetPasswordModal)
{
    <div class="modal show d-block modal-modern" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #6f42c1, #5a32a3);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-key me-2"></i> بازنشانی رمز عبور
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseResetPasswordModal"></button>
                </div>
                <div class="modal-body">
                    <p>رمز عبور جدید برای کاربر <strong>@resetPasswordUserName</strong> را وارد کنید:</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">رمز عبور جدید <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" @bind="resetPasswordNewPassword" placeholder="رمز عبور جدید" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">تکرار رمز عبور <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" @bind="resetPasswordConfirmPassword" placeholder="تکرار رمز عبور" />
                    </div>
                    @if (!string.IsNullOrEmpty(resetPasswordError))
                    {
                        <div class="alert alert-danger">@resetPasswordError</div>
                    }
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseResetPasswordModal">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button" class="btn-modern btn-primary-modern" @onclick="ConfirmResetPassword" disabled="@isResetPasswordSubmitting">
                        @if (isResetPasswordSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        بازنشانی
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> users = new();
    private List<UserDto> filteredUsers = new();
    private List<BranchDto> branches = new();
    private List<string> roles = new();

    private string searchTerm = string.Empty;
    private string filterRole = "";
    private string filterStatus = "";
    private long filterBranchId = 0;

    private int pageSize = 10;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private string sortColumn = "FullName";
    private bool sortAscending = true;

    private List<UserDto> pagedUsers
    {
        get
        {
            var sorted = filteredUsers;
            switch (sortColumn)
            {
                case "FullName":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.FullName).ToList() : filteredUsers.OrderByDescending(u => u.FullName).ToList();
                    break;
                case "UserName":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.UserName).ToList() : filteredUsers.OrderByDescending(u => u.UserName).ToList();
                    break;
                case "Email":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.Email).ToList() : filteredUsers.OrderByDescending(u => u.Email).ToList();
                    break;
                case "BranchName":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.BranchName).ToList() : filteredUsers.OrderByDescending(u => u.BranchName).ToList();
                    break;
                case "IsActive":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.IsActive).ToList() : filteredUsers.OrderByDescending(u => u.IsActive).ToList();
                    break;
                case "CreatedAt":
                    sorted = sortAscending ? filteredUsers.OrderBy(u => u.CreatedAt).ToList() : filteredUsers.OrderByDescending(u => u.CreatedAt).ToList();
                    break;
                default:
                    sorted = filteredUsers.OrderByDescending(u => u.CreatedAt).ToList();
                    break;
            }

            if (pageSize == 0)
            {
                currentPage = 1;
                return sorted;
            }

            var skip = (currentPage - 1) * pageSize;
            return sorted.Skip(skip).Take(pageSize).ToList();
        }
    }

