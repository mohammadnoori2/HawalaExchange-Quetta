    private async Task ConfirmAction()
    {
        try
        {
            var user = await UserManager.FindByIdAsync(confirmId.ToString());
            if (user == null)
            {
                validationErrors.Add("کاربر یافت نشد");
                return;
            }

            if (confirmActionType == "deactivate")
                user.IsActive = false;
            else if (confirmActionType == "activate")
                user.IsActive = true;

            var result = await UserManager.UpdateAsync(user);
            if (result.Succeeded)
            {
                successMessage = $"کاربر با موفقیت {(confirmActionType == "deactivate" ? "غیرفعال" : "فعال")} شد";
                showConfirmModal = false;
                await LoadUsers();
            }
            else
            {
                validationErrors.AddRange(result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            validationErrors.Add($"خطا در عملیات: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetRoleName(string role)
    {
        return role?.ToLower() switch
        {
            "admin" => "مدیر",
            "manager" => "سرپرست",
            "cashier" => "صندوقدار",
            "supervisor" => "ناظر",
            _ => role ?? "نامشخص"
        };
    }

    private string GetRoleBadge(string role)
    {
        return role?.ToLower() switch
        {
            "admin" => "badge-danger",
            "manager" => "badge-warning",
            "cashier" => "badge-info",
            "supervisor" => "badge-secondary",
            _ => "badge-primary"
        };
    }
