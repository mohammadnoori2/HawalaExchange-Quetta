@using HawalaExchange.Application.DTOs
@using System.Text.Json

<div class="searchable-dropdown" data-account-search data-account-options="@optionsJson"
     data-account-value="@Value" data-account-revision="@acknowledgedRevision"
     data-account-limit="@MaxResults" data-account-clear="@AllowClear.ToString().ToLowerInvariant()"
     data-account-show-code="@ShowAccountCode.ToString().ToLowerInvariant()"
     data-account-clear-text="@ClearText">
    <div class="searchable-dropdown-input">
        <input type="text" class="@CssClass" placeholder="@Placeholder" aria-label="@Placeholder" autocomplete="off"
               disabled="@Disabled" data-account-query role="combobox" aria-autocomplete="list"
               aria-expanded="false" aria-controls="@listId" />
    </div>
    <input type="hidden" data-account-commit @onchange="HandleSelectionAsync" />
    <div id="@listId" class="searchable-dropdown-menu searchable-dropdown-menu-floating"
         data-account-results popover="manual" role="listbox"></div>
</div>

@if (ShowBalanceSummary)
{
    <AccountBalanceSummary AccountId="@Value" />
}

@code {
    [Parameter] public IEnumerable<AccountDto>? Accounts { get; set; }
    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter] public EventCallback<AccountDto> OnSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "جستجوی حساب...";
    [Parameter] public string CssClass { get; set; } = "form-control";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool ShowBalanceSummary { get; set; } = true;
    [Parameter] public bool ShowAccountCode { get; set; } = true;
    [Parameter] public string ClearText { get; set; } = "همه حساب‌ها";
    [Parameter] public int MaxResults { get; set; } = 30;

    private readonly string listId = $"account-options-{Guid.NewGuid():N}";
    private readonly SemaphoreSlim selectionGate = new(1, 1);
    private long lastClientRevision;
    private long acknowledgedRevision;
    private List<AccountDto> accountList = [];
    private string optionsJson = "[]";

    protected override void OnParametersSet()
    {
        accountList = (Accounts ?? []).Where(x => !x.IsArchived).ToList();
        optionsJson = JsonSerializer.Serialize(accountList.Select(x => new {
            id = x.Id.ToString(System.Globalization.CultureInfo.InvariantCulture),
            name = x.AccountName, code = x.AccountCode, reference = x.ReferenceName,
            type = AppDisplayText.AccountType(x.AccountType),
            display = ShowAccountCode ? $"{x.AccountName} ({x.AccountCode})" : x.AccountName
        }));
    }

    private async Task HandleSelectionAsync(ChangeEventArgs args)
    {
        SelectionMessage? message;
        try { message = JsonSerializer.Deserialize<SelectionMessage>(args.Value?.ToString() ?? ""); }
        catch (JsonException) { return; }
        if (message is null || message.revision <= 0) return;
        await selectionGate.WaitAsync();
        try
        {
            if (message.revision <= lastClientRevision) return;
            lastClientRevision = message.revision;
            if (Disabled || !long.TryParse(message.id, out var id) || id < 0) return;
            var account = accountList.FirstOrDefault(x => x.Id == id);
            if (id != 0 && account is null) return;
            Value = id;
            await ValueChanged.InvokeAsync(id);
            if (account is not null) await OnSelected.InvokeAsync(account);
        }
        finally
        {
            acknowledgedRevision = lastClientRevision;
            selectionGate.Release();
        }
    }

    private sealed class SelectionMessage
    {
        public string? id { get; set; }
        public long revision { get; set; }
    }
}
