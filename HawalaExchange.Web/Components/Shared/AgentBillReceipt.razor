@using System.Globalization
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Services
@namespace HawalaExchange.Web.Components.Shared
@inherits HawalaExchange.Web.Components.DateAwareComponent
<article class="hawala-receipt agent-bill-receipt" dir="rtl">
    <header class="receipt-brand @(string.IsNullOrWhiteSpace(Company.LogoPath) ? "receipt-no-logo" : "")">
        <div class="receipt-brand-copy"><h3>@Company.CompanyName</h3><div class="receipt-kind">@(Bill.Status == "Cancelled" ? "رسید / بیل لغوشده" : Bill.IsHistoricalReceipt ? "رسید تسویه قبلی عامل" : Bill.Status == "Paid" ? "رسید پرداخت بیل عامل" : "بیل پرداخت عامل")</div></div>
        @if (!string.IsNullOrWhiteSpace(Company.LogoPath)) { <img src="@Company.LogoPath" class="receipt-logo" alt="لوگوی صرافی" /> }
    </header>
    <table class="receipt-table agent-bill-summary"><colgroup><col style="width:44%" /><col style="width:56%" /></colgroup><tbody>
        @if (Bill.IsHistoricalReceipt)
        {
            <tr><td colspan="2">بابت تسویه قبلی — بدون ثبت حسابداری جدید</td></tr>
        }
        <tr><th>تاریخ:</th><td dir="ltr">@DisplayDates.TimestampDate(Bill.PaidAt ?? Bill.CreatedAt)</td></tr>
        <tr><th>تعداد حواله:</th><td>@Bill.Items.Count.ToString(CultureInfo.InvariantCulture)</td></tr>
        <tr><th>از درک حواله‌های:</th><td>
            @for (var i = 0; i < Bill.Items.Count; i++)
            {
                var row = Bill.Items[i];
                if (i > 0) { <span>، </span> }
                <bdi dir="ltr">@row.Number.ToString(CultureInfo.InvariantCulture) / @(string.IsNullOrWhiteSpace(row.ReferenceNumber) ? "—" : row.ReferenceNumber)</bdi>
            }
        </td></tr>
        <tr><th>محل پرداخت:</th><td>@PaymentLocations</td></tr>
        @if (Bill.CancelledAt.HasValue) { <tr><th>تاریخ لغو:</th><td>@DisplayDates.DateTime(Bill.CancelledAt, true, true)</td></tr> }
        @foreach (var total in Bill.Totals)
        {
            <tr><th>مجموع اصل:</th><td dir="ltr">@total.Principal.ToWholeMoney() @total.CurrencyCode</td></tr>
            <tr><th>مجموع کمیشن عامل:</th><td dir="ltr">@total.AgentCommission.ToWholeMoney() @total.CurrencyCode</td></tr>
            <tr><th>مبلغ قابل پرداخت:</th><td class="receipt-amount" dir="ltr">@total.Total.ToWholeMoney() @total.CurrencyCode</td></tr>
        }
    </tbody></table>
    @if (Bill.Status == "Cancelled") { <p class="receipt-strong">این بیل لغو شده و برای دریافت پول معتبر نیست.</p> }
    @if (!string.IsNullOrWhiteSpace(Bill.Notes)) { <div>@Bill.Notes</div> }
    <section class="execution-signature"><strong>امضا یا اثر انگشت دریافت‌کننده پول</strong></section>
    <div class="receipt-company-contact">@Company.Address @Company.PhoneNumber</div>
</article>
@code {
    [Parameter, EditorRequired] public AgentBillDto Bill { get; set; } = new();
    [Parameter] public CompanySettingDto Company { get; set; } = new();
    private string PaymentLocations => string.Join("، ", Bill.Items.Select(row =>
        string.IsNullOrWhiteSpace(row.PaymentLocation) ? "نامشخص" : row.PaymentLocation.Trim()).Distinct());
}
