@namespace HawalaExchange.Web.Components.Shared
@inherits ComponentBase
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HawalaExchange.Web.Services.UiConnectionState Connection
@inject ILogger<AppActionMenu> Logger
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Components.Server.CircuitOptions> CircuitOptions

<div class="configurable-action-menu" @onclick:stopPropagation="true"
     data-action-preference-key="@effectivePreferenceKey"
     data-action-menu-id="@menuId"
     data-action-quick-host-id="@quickHostId">
    <div id="@quickHostId" class="operation-quick-actions" aria-label="عملیات بیرون از منو"></div>

    <div class="operation-dropdown">
        <button id="@buttonId"
                type="button"
                class="operation-dot-btn"
                title="@Title"
                aria-label="@AriaLabel"
                aria-haspopup="menu"
                aria-expanded="false"
                data-operation-menu-toggle="@menuId">
            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
        </button>

        <div id="@menuId"
             class="operation-menu @MenuCssClass operation-menu-closed"
             dir="rtl"
             role="menu">
            @if (isConfiguring)
            {
                <div class="operation-menu-settings" @onclick:stopPropagation="true">
                    <div class="operation-menu-settings-title">
                        <strong>عملیات این صفحه</strong>
                        <small>این انتخاب روی تمام ردیف‌های همین صفحه اعمال می‌شود.</small>
                    </div>

                    @foreach (var option in availableActions)
                    {
                        <label class="operation-menu-setting-option">
                            <input type="checkbox"
                                   checked="@selectedActionKeys.Contains(option.Key)"
                                   @onchange="args => SetActionSelection(option.Key, args.Value as bool? == true)" />
                            <i class="@option.IconClass"></i>
                            <span>@option.Label</span>
                        </label>
                    }

                    @if (availableActions.Count == 0)
                    {
                        <div class="text-muted small py-2">در این منو گزینه‌ای وجود ندارد.</div>
                    }

                    <div class="operation-menu-settings-actions">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveSettingsAsync">ذخیره</button>
                        <button type="button" class="btn btn-sm btn-light" @onclick="CancelSettingsAsync">انصراف</button>
                    </div>
                </div>
            }
            else
            {
                <div class="operation-menu-items">
                    @ChildContent
                </div>
                <div class="operation-menu-divider operation-menu-settings-divider"></div>
                <button type="button"
                        class="operation-menu-item operation-menu-configure-button"
                        role="menuitem"
                        @onclick:stopPropagation="true"
                        @onclick="OpenSettingsAsync">
                    <i class="bi bi-sliders text-primary"></i>
                    تنظیم عملیات این صفحه
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; } = "عملیات";

    [Parameter]
    public string AriaLabel { get; set; } = "عملیات";

    [Parameter]
    public string MenuCssClass { get; set; } = string.Empty;

    [Parameter]
    public string? PreferenceKey { get; set; }

    [Parameter]
    public IReadOnlyList<string> DefaultQuickActions { get; set; } = Array.Empty<string>();

    private readonly string instanceId = Guid.NewGuid().ToString("N");
    private bool isOpen;
    private bool positionAfterRender;
    private bool refreshQuickActionsAfterRender = true;
    private bool isConfiguring;
    private bool disposed;
    private bool preparing;
    private bool prepareAfterCurrent;
    private readonly CancellationTokenSource lifetime = new();
    private List<ActionMenuOption> availableActions = new();
    private HashSet<string> selectedActionKeys = new(StringComparer.Ordinal);
    private DotNetObjectReference<AppActionMenu>? dotNetReference;
    private string buttonId => $"app-action-button-{instanceId}";
    private string menuId => $"app-action-menu-{instanceId}";
    private string quickHostId => $"app-action-quick-{instanceId}";
    private string effectivePreferenceKey
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(PreferenceKey))
                return PreferenceKey.Trim();

            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relativePath.Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(path))
                return "home";

            var normalizedSegments = path
                .Split('/', StringSplitOptions.RemoveEmptyEntries)
                .Select(segment => long.TryParse(segment, out _) || Guid.TryParse(segment, out _)
                    ? "{id}"
                    : segment);
            return string.Join('/', normalizedSegments);
        }
    }

    protected override void OnInitialized() => Connection.Changed += ConnectionChanged;

    private void ConnectionChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            refreshQuickActionsAfterRender = true;
            positionAfterRender = isOpen;
            if (Connection.IsConnected)
            {
                if (preparing) prepareAfterCurrent = true;
                else StateHasChanged();
            }
        });
    }

    private async Task<(bool Success, T? Value)> TryInvokeAsync<T>(string identifier, params object?[] arguments)
    {
        if (disposed || !Connection.IsConnected) return (false, default);
        var connectionToken = Connection.ConnectionToken;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token, connectionToken);
        // Supplying our own token bypasses JSRuntime's implicit timeout, so retain the configured limit explicitly.
        cancellation.CancelAfter(CircuitOptions.Value.JSInteropDefaultCallTimeout);
        try
        {
            var value = await JS.InvokeAsync<T>(identifier, cancellation.Token, arguments);
            return (!disposed && !cancellation.IsCancellationRequested, value);
        }
        catch (JSDisconnectedException)
        {
            if (!disposed) refreshQuickActionsAfterRender = true;
            return (false, default);
        }
        catch (OperationCanceledException)
        {
            if (!disposed)
            {
                refreshQuickActionsAfterRender = true;
                if (!lifetime.IsCancellationRequested && !connectionToken.IsCancellationRequested)
                    Logger.LogWarning("Browser UI call {Identifier} timed out; menu will retry on reconnect or next interaction.", identifier);
            }
            return (false, default);
        }
        // Other JS exceptions are intentionally not swallowed: broken scripts must remain observable.
    }

    private async Task ToggleAsync()
    {
        if (disposed) return;
        if (isOpen)
        {
            await CloseMenuAsync();
            return;
        }

        isOpen = true;
        positionAfterRender = true;
        refreshQuickActionsAfterRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || !Connection.IsConnected || preparing) return;
        preparing = true;
        try
        {
            if (firstRender || refreshQuickActionsAfterRender)
            {
                var sync = await TryInvokeAsync<object>(
                    "hawalaTools.syncOperationMenuQuickActions",
                    menuId,
                    quickHostId,
                    effectivePreferenceKey,
                    DefaultQuickActions);
                if (!sync.Success) return;
                refreshQuickActionsAfterRender = false;
            }

            if (!isOpen || !positionAfterRender)
                return;

            dotNetReference ??= DotNetObjectReference.Create(this);
            var opened = await TryInvokeAsync<object>("hawalaTools.refreshOperationMenu", buttonId, menuId, dotNetReference);
            if (opened.Success) positionAfterRender = false;
        }
        finally
        {
            preparing = false;
            if (prepareAfterCurrent && !disposed && Connection.IsConnected)
            {
                prepareAfterCurrent = false;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public Task CloseFromJs() => disposed ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (disposed) return;
        isOpen = false;
        isConfiguring = false;
        positionAfterRender = false;
        StateHasChanged();
    });

    private async Task CloseMenuAsync()
    {
        if (disposed || !isOpen)
            return;

        isOpen = false;
        isConfiguring = false;
        positionAfterRender = false;
        await TryInvokeAsync<object>("hawalaTools.closeOperationMenu", menuId);
    }

    private async Task OpenSettingsAsync()
    {
        // Ordinary opening is local to the browser; only the settings editor needs server state.
        if (!isOpen) await ToggleAsync();
        dotNetReference ??= DotNetObjectReference.Create(this);
        var result = await TryInvokeAsync<List<ActionMenuOption>>(
            "hawalaTools.getOperationMenuOptions",
            menuId,
            effectivePreferenceKey,
            DefaultQuickActions,
            dotNetReference);

        if (!result.Success) return;
        var options = result.Value ?? [];

        availableActions = options;
        selectedActionKeys = options
            .Where(x => x.Selected)
            .Select(x => x.Key)
            .ToHashSet(StringComparer.Ordinal);
        isConfiguring = true;
        positionAfterRender = true;
    }

    private void SetActionSelection(string key, bool selected)
    {
        if (selected)
            selectedActionKeys.Add(key);
        else
            selectedActionKeys.Remove(key);
    }

    private async Task SaveSettingsAsync()
    {
        var saved = await TryInvokeAsync<object>(
            "hawalaTools.saveOperationMenuPreferences",
            effectivePreferenceKey,
            selectedActionKeys.ToArray());
        if (!saved.Success) return;
        isConfiguring = false;
        refreshQuickActionsAfterRender = true;
        positionAfterRender = true;
    }

    private Task CancelSettingsAsync()
    {
        if (disposed) return Task.CompletedTask;
        isConfiguring = false;
        refreshQuickActionsAfterRender = true;
        positionAfterRender = true;
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        Connection.Changed -= ConnectionChanged;
        lifetime.Cancel();

        try
        {
            if (dotNetReference is not null && Connection.IsConnected)
            {
                using var cleanup = new CancellationTokenSource(TimeSpan.FromSeconds(2));
                await JS.InvokeVoidAsync("hawalaTools.closeOperationMenu", cleanup.Token, menuId);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (OperationCanceledException) { }
        catch (JSException error) { Logger.LogError(error, "Could not clean up browser operation menu."); }
        finally
        {
            dotNetReference?.Dispose();
            dotNetReference = null;
            lifetime.Dispose();
        }
    }

    private sealed class ActionMenuOption
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string IconClass { get; set; } = "bi bi-lightning";
        public bool Selected { get; set; }
    }
}
