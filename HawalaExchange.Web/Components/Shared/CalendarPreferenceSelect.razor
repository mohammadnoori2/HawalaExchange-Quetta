@using Microsoft.AspNetCore.Components
@namespace HawalaExchange.Web.Components.Shared
@inherits ComponentBase

<select id="@Id" class="form-select" value="@SelectedCalendar" @onchange="OnSelectionChanged" disabled="@Disabled">
    <option value="Persian">شمسی</option>
    <option value="Gregorian">میلادی</option>
</select>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Value { get; set; } = true;
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string SelectedCalendar => Value ? "Persian" : "Gregorian";

    internal Task OnSelectionChanged(ChangeEventArgs args)
    {
        if (Disabled) return Task.CompletedTask;
        return args.Value?.ToString() switch
        {
            "Persian" => ValueChanged.InvokeAsync(true),
            "Gregorian" => ValueChanged.InvokeAsync(false),
            _ => Task.CompletedTask
        };
    }
}
