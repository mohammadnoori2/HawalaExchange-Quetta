@using HawalaExchange.Application.DTOs

<h6 class="fw-bold mb-3">مجموع هر ارز و مبنای دالری</h6>
<div class="table-responsive mb-4">
    <table class="table table-sm table-bordered align-middle">
        <thead><tr><th>ارز</th><th>تعداد حواله</th><th>مجموع مبلغ حواله‌ها</th><th>مبنای دالری (USD)</th></tr></thead>
        <tbody>
            @foreach (var currency in Items.GroupBy(x => x.CurrencyCode).OrderBy(x => x.Key))
            {
                <tr>
                    <td>@currency.Key</td><td>@currency.Count()</td>
                    <td dir="ltr">@currency.Sum(x => x.SourceAmount).ToWholeMoney() @currency.Key</td>
                    <td dir="ltr">@currency.Sum(x => x.AfnEquivalent).ToWholeMoney() USD</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3">مجموع مبنای دالری</th><th dir="ltr">@Items.Sum(x => x.AfnEquivalent).ToWholeMoney() USD</th></tr></tfoot>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CorrespondentCommissionItemDto> Items { get; set; } = [];
}
