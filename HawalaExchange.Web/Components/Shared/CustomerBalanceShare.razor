@using Microsoft.AspNetCore.Components
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Helpers
@namespace HawalaExchange.Web.Components.Shared
@inherits ComponentBase

@if (Disabled || string.IsNullOrEmpty(ShareText))
{
    <button type="button" class="btn-modern btn-light-modern" disabled title="ابتدا مانده حساب مشتری باید بارگذاری شود.">
        <i class="bi bi-whatsapp" aria-hidden="true"></i> ارسال مانده به واتساپ
    </button>
}
else
{
    <details class="customer-balance-share" @key="CustomerName">
        <summary class="btn-modern btn-light-modern"><i class="bi bi-whatsapp text-success" aria-hidden="true"></i> ارسال مانده به واتساپ</summary>
        <div class="border rounded p-3 mt-2" aria-label="پیش‌نمایش ارسال مانده مشتری">
            <p class="small text-muted">فقط مانده فعلی هر ارز ارسال می‌شود؛ مستقل از بازه گزارش و بدون جزئیات تراکنش‌ها. گیرنده و ارسال نهایی را در واتساپ انتخاب کنید.</p>
            <pre class="mb-3" dir="rtl" style="white-space:pre-wrap;overflow-wrap:anywhere">@ShareText</pre>
            <a class="btn-modern btn-primary-modern" href="@CustomerBalanceShareText.WhatsAppUrl(ShareText)" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">
                <i class="bi bi-whatsapp" aria-hidden="true"></i> باز کردن واتساپ
            </a>
        </div>
    </details>
}

@code {
    [Parameter, EditorRequired] public string CustomerName { get; set; } = "";
    [Parameter] public IReadOnlyList<BalanceDto>? Balances { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string ShareText => CustomerBalanceShareText.Build(CustomerName, Balances);
}
