@inherits ComponentBase
@using HawalaExchange.Application.DTOs
<div class="dashboard-counterparty-scroll" role="region" aria-label="مانده حساب‌ها به تفکیک ارز" tabindex="0">
    <table class="table dashboard-counterparty-table mb-0">
        <thead><tr><th scope="col">نام حساب</th><th scope="col">نوع حساب</th>
            @foreach(var currency in Columns) { <th scope="col"><CurrencyBadge Code="@currency.CurrencyCode" /></th> }
        </tr></thead>
        <tbody>
            @foreach(var account in Rows)
            {
                <tr><th scope="row"><RecordDetailsLink Kind="Account" Id="account.AccountId" Text="@account.Name" /></th><td>@account.AccountTypeName</td>
                    @foreach(var currency in Columns)
                    {
                        var net=currency.AccountBalances.GetValueOrDefault(account.AccountId);
                        var amount=Creditors?Math.Max(-net,0):Math.Max(net,0);
                        <td dir="ltr" class="@(Creditors?"text-success":"text-danger")">@(amount>0?MoneyFormatHelper.Format(amount):"—")</td>
                    }
                </tr>
            }
            @if(Rows.Count==0) { <tr><td colspan="@(Columns.Count+2)" class="text-muted">@(Creditors?"حساب طلبکاری موجود نیست.":"حساب بدهکاری موجود نیست.")</td></tr> }
        </tbody>
        <tfoot><tr><th scope="row" colspan="2">مجموع همه حساب‌ها</th>
            @foreach(var currency in Columns)
            { <td dir="ltr">@MoneyFormatHelper.Format(Creditors?currency.TotalPayables:currency.TotalReceivables)</td> }
        </tr></tfoot>
    </table>
</div>
@code {
    [Parameter] public List<DashboardCounterpartyCurrencyDto> Groups { get; set; } = [];
    [Parameter] public bool Creditors { get; set; }
    private List<DashboardDebtorDto> Rows { get; set; } = [];
    private List<DashboardCounterpartyCurrencyDto> Columns { get; set; } = [];
    protected override void OnParametersSet()
    {
        Rows=Groups.SelectMany(x=>Creditors?x.TopCreditors:x.TopDebtors).DistinctBy(x=>x.AccountId).ToList();
        Columns=Groups.Where(x=>Creditors?x.TotalPayables>0:x.TotalReceivables>0)
            .OrderBy(x=>x.CurrencyCode,StringComparer.OrdinalIgnoreCase).ToList();
    }
}
