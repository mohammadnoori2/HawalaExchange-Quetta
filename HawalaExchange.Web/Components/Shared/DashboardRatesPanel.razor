@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@implements IDisposable
@inject IExchangeRateService RatesService
@inject IUserPermissionService Permissions
<section class="dashboard-summary-card" aria-label="نرخ اسعار">
    <div class="dashboard-summary-heading"><h2><i class="bi bi-coin" aria-hidden="true"></i> نرخ اسعار</h2></div>
    @if(!string.IsNullOrEmpty(error)){<div class="alert alert-danger m-2" role="alert">@error</div>}
    <div class="dashboard-summary-body">
        <table class="table table-sm mb-0"><thead><tr><th>ارزها</th><th>خرید</th><th>فروش</th><th>تاریخ / وضعیت</th></tr></thead><tbody>
        @if(data is not null)
        {
            @foreach(var rate in data.Rates)
            {
                <tr><td><CurrencyBadge Code="@rate.FromCurrencyCode" /> / <CurrencyBadge Code="@rate.ToCurrencyCode" /></td>
                    <td dir="ltr">@MoneyFormatHelper.Format(rate.BuyRate,8)</td><td dir="ltr">@MoneyFormatHelper.Format(rate.SellRate,8)</td>
                    <td><span dir="ltr">@DisplayDates.Date(rate.EffectiveDate)</span>
                    @if(rate.EffectiveDate.Date==data.Today){<small class="d-block text-success">نرخ امروز</small>}
                    else{<small class="d-block text-muted">آخرین نرخ؛ نرخ امروز ثبت نشده</small><PermissionView Permission="Rates.Create"><button type="button" class="btn btn-sm btn-link p-0" disabled="@busy" @onclick="() => OpenToday(rate)">افزودن نرخ امروز</button></PermissionView>}
                    </td></tr>
            }
            @if(data.Rates.Count==0)
            {<tr><td colspan="4"><div class="dashboard-rate-empty-content"><i class="bi bi-coin dashboard-rate-empty-icon" aria-hidden="true"></i><span class="text-muted">هنوز نرخی ثبت نشده است.</span>
                <PermissionView Permission="Rates.Create"><button type="button" class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="() => OpenToday(null)">افزودن نرخ امروز</button></PermissionView>
            </div></td></tr>}
        }
        else if(busy){<tr><td colspan="4">در حال بارگذاری…</td></tr>}
        </tbody></table>
    </div>
</section>
<ExchangeRateModal Visible="showModal" CurrentRate="request" Currencies="Currencies" Busy="saving" Errors="errors" OnClose="Close" OnSave="Save" />
@code {
    [Parameter] public List<CurrencyDto> Currencies { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    private DashboardExchangeRatesDto? data;
    private CreateExchangeRateDto request = new();
    private List<string> errors = [];
    private bool busy,saving,showModal,disposed;
    private string? error;
    protected override Task OnInitializedAsync()=>RefreshAsync();
    public async Task RefreshAsync()
    {
        if(busy || disposed)return;
        busy=true;error=null;
        try{await Permissions.RefreshAsync();if(!Permissions.Can("Rates.View")){data=null;error="صلاحیت مشاهده نرخ‌ها را ندارید.";return;}
            var result=await RatesService.GetDashboardRatesAsync();if(!disposed)data=result;}
        catch(Exception ex){error=$"نرخ‌ها بارگذاری نشد: {ex.Message}";}
        finally{busy=false;}
    }
    private async Task OpenToday(ExchangeRateDto? rate)
    {
        if(busy||saving)return;
        await RefreshAsync();
        if(disposed || data is null || error is not null || !Permissions.Can("Rates.Create"))return;
        request=new(){EffectiveDate=data.LocalNow,FromCurrencyId=rate?.FromCurrencyId??0,ToCurrencyId=rate?.ToCurrencyId??0};
        errors.Clear();showModal=true;
    }
    private void Close(){if(!saving)showModal=false;}
    private async Task Save()
    {
        if(saving || disposed)return;errors.Clear();
        if(request.FromCurrencyId<=0 || request.ToCurrencyId<=0 || !Currencies.Any(x=>x.Id==request.FromCurrencyId) || !Currencies.Any(x=>x.Id==request.ToCurrencyId))errors.Add("ارز مبدأ و مقصد را انتخاب کنید.");
        if(request.FromCurrencyId==request.ToCurrencyId)errors.Add("ارز مبدأ و مقصد نمی‌توانند یکسان باشند.");
        if(request.BuyRate<=0 || request.SellRate<=0)errors.Add("نرخ خرید و فروش باید بزرگتر از صفر باشد.");
        if(request.EffectiveDate==default)errors.Add("تاریخ مؤثر را انتخاب کنید.");
        if(errors.Count>0)return;
        saving=true;
        try{await RatesService.CreateAsync(request);showModal=false;await RefreshAsync();if(!disposed)await OnSaved.InvokeAsync();}
        catch(Exception ex){errors.Add($"ثبت نرخ انجام نشد: {ex.Message}");}
        finally{saving=false;}
    }
    public void Dispose()=>disposed=true;
}
