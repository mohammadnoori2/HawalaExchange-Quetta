@using HawalaExchange.Application.DTOs

<div class="debt-limit-fields">
    <small class="debt-limit-help text-muted">حذف یک ارز یعنی بدهکاری آن ارز نامحدود است.</small>

    <div class="debt-limit-grid">
        @foreach (var item in Limits)
        {
            var currency = GetCurrency(item.CurrencyId);
            <div class="debt-limit-item" @key="item">
                <div class="debt-limit-controls">
                    <select class="debt-limit-currency"
                            value="@item.CurrencyId"
                            @onchange="args => ChangeCurrency(item, args.Value?.ToString())"
                            aria-label="واحد پولی سقف بدهکاری">
                        <option value="0">انتخاب ارز</option>
                        @foreach (var option in Currencies.Where(option => option.IsActive))
                        {
                            <option value="@option.Id" disabled="@IsCurrencyUsedByAnotherRow(option.Id, item)">@option.Name</option>
                        }
                    </select>

                    <MoneyInput class="debt-limit-amount" @bind-Value="item.BadehkarLimit"
                                min="0" placeholder="مبلغ سقف" />
                </div>

                @if (item.BadehkarLimit > 0)
                {
                    <small class="debt-limit-words">
                        @DariNumberToWords.ToWords(item.BadehkarLimit) @(currency?.Name ?? string.Empty)
                    </small>
                }
            </div>
        }
    </div>

    <div class="debt-limit-actions">
        <button type="button" class="debt-limit-icon debt-limit-delete"
                title="حذف آخرین ارز" aria-label="حذف آخرین ارز"
                disabled="@(Limits.Count == 0)" @onclick="RemoveLastRow">
            <i class="bi bi-trash"></i>
        </button>
        <button type="button" class="debt-limit-icon"
                title="افزودن ارز دیگر" aria-label="افزودن ارز دیگر" @onclick="AddRow">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<DebtLimitInputDto> Limits { get; set; } = new();
    [Parameter, EditorRequired] public IEnumerable<CurrencyDto> Currencies { get; set; } = [];

    protected override void OnParametersSet()
    {
        EnsureBlankRow();
    }

    private CurrencyDto? GetCurrency(long currencyId) =>
        Currencies.FirstOrDefault(currency => currency.Id == currencyId);

    private bool IsCurrencyUsedByAnotherRow(long currencyId, DebtLimitInputDto current) =>
        Limits.Any(item => !ReferenceEquals(item, current) && item.CurrencyId == currencyId);

    private void ChangeCurrency(DebtLimitInputDto item, string? value)
    {
        item.CurrencyId = long.TryParse(value, out var currencyId) ? currencyId : 0;
        item.IsEnabled = item.CurrencyId > 0;
    }

    private void AddRow()
    {
        if (Limits.Any(item => item.CurrencyId <= 0) ||
            Limits.GroupBy(item => item.CurrencyId).Any(group => group.Key > 0 && group.Count() > 1))
            return;

        Limits.Add(NewRow());
    }

    private void RemoveLastRow()
    {
        if (Limits.Count > 0)
            Limits.RemoveAt(Limits.Count - 1);

        EnsureBlankRow();
    }

    private void EnsureBlankRow()
    {
        if (Limits.Count == 0)
            Limits.Add(NewRow());
    }

    private static DebtLimitInputDto NewRow() => new()
    {
        IsEnabled = false,
        BadehkarLimit = 0
    };
}
