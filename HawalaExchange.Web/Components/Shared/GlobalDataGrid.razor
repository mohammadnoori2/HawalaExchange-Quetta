@implements IAsyncDisposable
@inject IJSRuntime JS

<table @ref="tableElement"
       @attributes="AdditionalAttributes"
       data-global-grid="true">
    @ChildContent
</table>

@code {
    private ElementReference tableElement;
    private IJSObjectReference? module;

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool EnableSorting { get; set; } = true;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!EnableSorting)
            return;

        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/global-data-grid.js");
            await module.InvokeVoidAsync("initialize", tableElement);
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended while the page was changing.
        }
        catch (InvalidOperationException)
        {
            // JavaScript is unavailable during static server-side rendering.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
            return;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection has already closed.
        }
    }
}
