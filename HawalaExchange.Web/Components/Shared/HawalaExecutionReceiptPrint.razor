@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Application.Services
@using HawalaExchange.Web.Helpers
@using Microsoft.JSInterop
@inject ICompanySettingService CompanySettingService
@inject IJSRuntime JS

@if (Hawala != null)
{
    <button type="button" class="@ButtonClass" disabled="@(printing || loadingCompany)" data-receipt-print-target="@(companyLoaded && Hawala.Status == "Paid" ? printAreaId : null)" @onclick="PrintAsync">
        @if (printing)
        {
            <span class="spinner-border spinner-border-sm"></span>
        }
        else
        {
            <i class="bi bi-printer"></i>
        }
        چاپ رسید اجرا
    </button>
    @if (!AutoPrint)
    {
        <label class="small ms-2"><input type="checkbox" @bind="showSendingCorrespondent" /> نمایش نمایندگی ارسال‌کننده</label>
    }

    @if (!string.IsNullOrWhiteSpace(printError))
    {
        <div class="alert alert-warning mt-2" role="status">@printError</div>
    }

    <div class="position-fixed" style="left:-10000px;top:0;width:72mm" aria-hidden="true">
        <div id="@printAreaId">
            <HawalaReceipt Hawala="Hawala" Company="company" Payment="Payment" ExecutionMode="true" ExecutionAt="ExecutionTime" ShowSendingCorrespondent="showSendingCorrespondent" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public HawalaDto? Hawala { get; set; }
    [Parameter] public PayHawalaDto Payment { get; set; } = new();
    [Parameter] public bool AutoPrint { get; set; }
    [Parameter] public string ButtonClass { get; set; } = "btn-modern btn-light-modern";

    private readonly string printAreaId = $"hawala-execution-receipt-{Guid.NewGuid():N}";
    private CompanySettingDto company = new();
    private DateTime previewExecutionTime = DateTime.UtcNow;
    private bool printing;
    private bool companyLoaded, loadingCompany;
    private bool showSendingCorrespondent;
    private bool printRequested;
    private long? autoPrintedHawalaId;
    private string? printError;


    protected override async Task OnParametersSetAsync()
    {
        if (Hawala is not null && !companyLoaded && !loadingCompany)
        {
            loadingCompany = true;
            try { company = await CompanySettingService.GetAsync(); companyLoaded = true; }
            catch { printError = "اطلاعات سربرگ آماده نشد؛ برای تلاش مجدد دکمه چاپ را بزنید."; }
            finally { loadingCompany = false; }
        }
        if (AutoPrint && Hawala is { Status: "Paid" } && autoPrintedHawalaId != Hawala.Id)
        {
            // A rerender or a print failure must never replay a financial action or print request.
            autoPrintedHawalaId = Hawala.Id;
            await PrintAsync();
        }
    }

    private DateTime ExecutionTime => Hawala?.PaidAt ?? previewExecutionTime;

    private async Task PrintAsync()
    {
        if (Hawala == null || printing)
            return;

        try
        {
            printing = true;
            printError = null;
            previewExecutionTime = DateTime.UtcNow;
            if (!companyLoaded) { company = await CompanySettingService.GetAsync(); companyLoaded = true; }
            printRequested = true;
        }
        catch
        {
            printing = false;
            printError = "نمایش رسید ممکن نشد؛ برای تلاش دوباره «چاپ رسید اجرا» را بزنید. نیازی به اجرای دوباره حواله نیست.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!printRequested)
            return;

        printRequested = false;
        try
        {
            if (!await JS.TryInvokeUiVoidAsync("hawalaTools.printElement", printAreaId, 72, true))
                printError = "ارتباط با مرورگر قطع شد؛ برای نمایش رسید دوباره «چاپ رسید اجرا» را بزنید.";
        }
        catch (JSException)
        {
            printError = "پیش‌نمایش چاپ باز نشد؛ برای تلاش دوباره «چاپ رسید اجرا» را بزنید. نیازی به اجرای دوباره حواله نیست.";
        }
        finally
        {
            printing = false;
            StateHasChanged();
        }
    }

}
