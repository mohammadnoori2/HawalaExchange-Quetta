@using HawalaExchange.Application.DTOs
@using HawalaExchange.Web.Components.Shared.Modals
@using HawalaExchange.Application.Interfaces.Services
@inject IMoneyExchangeOperationService ExchangeService

<div class="hawala-quick-actions" @onclick:stopPropagation="true">
    <AppActionMenu Title="سایر عملیات"
                   AriaLabel="@($"سایر عملیات حواله {Hawala.Number}")"
                   DefaultQuickActions="@defaultQuickActions">
        <PermissionView Permission="Hawalas.Export"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="copy" @onclick="CopyAsync">
            <i class="bi bi-clipboard text-secondary"></i>
            کاپی معلومات
        </button></PermissionView>

        @if (ShowEdit && Hawala.Status != "Cancel" && Hawala.CompensatesHawalaId is null)
        {
            <PermissionView Permission="Hawalas.Edit"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="edit" @onclick="EditAsync">
                <i class="bi bi-pencil text-warning"></i>
                ویرایش
            </button></PermissionView>
        }
        @if (ShowDelete && !Hawala.HasPeriodicCommissionHistory && Hawala.CancellationAccountingMode is null && Hawala.CompensatesHawalaId is null)
        {
            <PermissionView Permission="Hawalas.Delete"><button type="button" class="operation-menu-item operation-menu-danger" role="menuitem" data-action-key="delete" @onclick="DeleteAsync">
                <i class="bi bi-trash"></i>
                حذف
            </button></PermissionView>
        }
        else if (ShowDelete && Hawala.HasPeriodicCommissionHistory)
        {
            <div class="operation-menu-item text-muted" title="حواله دارای سابقه کمیشن دوره‌ای قابل حذف نیست.">
                <i class="bi bi-lock"></i>
                حذف غیرفعال
            </div>
        }

        <div class="operation-menu-divider"></div>
        @if(Hawala.CorrespondentId.HasValue && Hawala.Status!="Cancel" && (Hawala.HawalaType is "HawalaReceive" or "HawalaSend"))
        {
            <PermissionView Permission="Exchanges.Create"><button class="operation-menu-item" type="button" disabled="@Hawala.HasIndependentExchange" @onclick="() => showExchange=true">تبدیل حواله به ارز انتخابی</button></PermissionView>
            @if(Hawala.HasIndependentExchange){<PermissionView Permission="Exchanges.View"><button class="operation-menu-item" @onclick="ViewExchange">جزئیات تبدیل اسعار</button></PermissionView>}
        }
        <button type="button" class="operation-menu-item" role="menuitem" data-action-key="view" @onclick="ViewAsync">
            <i class="bi bi-eye text-info"></i>
            مشاهده
        </button>

        <PermissionView Permission="Hawalas.Export"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="receipt" @onclick="ReceiptAsync">
            <i class="bi bi-receipt text-primary"></i>
            رسید حواله
        </button></PermissionView>

        <PermissionView Permission="Hawalas.Export"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="whatsapp" @onclick="WhatsAppAsync">
            <i class="bi bi-whatsapp text-success"></i>
            ارسال واتساپ
        </button></PermissionView>

        <PermissionView Permission="Hawalas.Export"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="telegram" @onclick="TelegramAsync">
            <i class="bi bi-telegram text-primary"></i>
            ارسال تلگرام
        </button></PermissionView>

        @if (ShowPay && Hawala.Status == "Pending" && Hawala.HawalaType == "HawalaReceive")
        {
            <PermissionView Permission="HawalaExecution.Execute"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="pay" @onclick="PayAsync">
                <i class="bi bi-check-circle text-success"></i>
                @PayButtonText
            </button></PermissionView>
        }

        @if (ShowCancel && Hawala.CompensatesHawalaId is null && (Hawala.Status != "Cancel" || Hawala.CancellationAccountingMode == "ManualPending"))
        {
            <PermissionView Permission="Hawalas.Delete"><button type="button" class="operation-menu-item" role="menuitem" data-action-key="cancel" @onclick="CancelAsync">
                <i class="bi bi-x-circle text-danger"></i>
                @(Hawala.CancellationAccountingMode == "ManualPending" ? "ثبت حواله جبرانی لغو" : "لغو حواله")
            </button></PermissionView>
        }
    </AppActionMenu>
    @if(exchangeError!=null){<div class="text-danger small" role="alert">@exchangeError</div>}
</div>
<MoneyExchangeModal IsVisible="showExchange" IsVisibleChanged="value => showExchange=value" LinkedHawalaId="Hawala.Id" OnSaveSuccess="ExchangeSaved" />
@if(exchangeDetails!=null){
<div class="modal d-block" role="dialog" aria-modal="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>تبدیل مستقل حواله @Hawala.Number</h5></div><div class="modal-body">
<div dir="ltr">@exchangeDetails.FromAmount @exchangeDetails.FromCurrencyCode → @exchangeDetails.ToAmount @exchangeDetails.ToCurrencyCode</div>
<div>نرخ هر 1 واحد ارز مبدأ: @(exchangeDetails.ToAmount/exchangeDetails.FromAmount)</div><div>@DisplayDates.DateTime(exchangeDetails.ExchangeDate)</div><p>@exchangeDetails.Description</p>
@if(exchangeError!=null){<div class="alert alert-danger">@exchangeError</div>}
</div><div class="modal-footer"><button class="btn btn-secondary" @onclick="()=>exchangeDetails=null">بستن</button><PermissionView Permission="Exchanges.Delete"><button class="btn btn-outline-danger" @onclick="()=>confirmRemove=true">حذف تبدیل</button>@if(confirmRemove){<button class="btn btn-danger" @onclick="RemoveExchange">تأیید حذف و برگشت اثر تبدیل</button>}</PermissionView></div></div></div></div><div class="modal-backdrop fade show"></div>
}

@code {
    private bool showExchange;
    private MoneyExchangeOperationDto? exchangeDetails;
    private string? exchangeError;
    private bool confirmRemove;
    private async Task ViewExchange(){exchangeError=null;confirmRemove=false;try{exchangeDetails=await ExchangeService.GetByLinkedHawalaAsync(Hawala.Id);}catch(Exception ex){exchangeError=ex.Message;}}
    private async Task RemoveExchange(){try{await ExchangeService.DeleteAsync(exchangeDetails!.Id);exchangeDetails=null;Hawala.HasIndependentExchange=false;await OnExchangeSaved.InvokeAsync();}catch(Exception ex){exchangeError=ex.Message;}}
    [Parameter] public EventCallback OnExchangeSaved { get; set; }
    private async Task ExchangeSaved(CreateMoneyExchangeOperationDto _) { Hawala.HasIndependentExchange=true; await OnExchangeSaved.InvokeAsync(); }
    [Parameter] public HawalaDto Hawala { get; set; } = new();

    [Parameter] public bool ShowEdit { get; set; } = false;
    [Parameter] public bool ShowPay { get; set; } = true;
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public bool ShowDelete { get; set; } = true;
    [Parameter] public string PayButtonText { get; set; } = "پرداخت حواله";

    [Parameter] public EventCallback<long> OnView { get; set; }
    [Parameter] public EventCallback<long> OnReceipt { get; set; }
    [Parameter] public EventCallback<long> OnCopy { get; set; }
    [Parameter] public EventCallback<long> OnWhatsApp { get; set; }
    [Parameter] public EventCallback<long> OnTelegram { get; set; }
    [Parameter] public EventCallback<long> OnEdit { get; set; }
    [Parameter] public EventCallback<HawalaDto> OnPay { get; set; }
    [Parameter] public EventCallback<long> OnCancel { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    private static readonly IReadOnlyList<string> defaultQuickActions = ["copy", "edit", "delete"];

    private async Task ViewAsync()
    {
        await OnView.InvokeAsync(Hawala.Id);
    }

    private async Task ReceiptAsync()
    {
        await OnReceipt.InvokeAsync(Hawala.Id);
    }

    private async Task CopyAsync()
    {
        await OnCopy.InvokeAsync(Hawala.Id);
    }

    private async Task WhatsAppAsync()
    {
        await OnWhatsApp.InvokeAsync(Hawala.Id);
    }

    private async Task TelegramAsync()
    {
        await OnTelegram.InvokeAsync(Hawala.Id);
    }

    private async Task EditAsync()
    {
        await OnEdit.InvokeAsync(Hawala.Id);
    }

    private async Task PayAsync()
    {
        await OnPay.InvokeAsync(Hawala);
    }

    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync(Hawala.Id);
    }

    private async Task DeleteAsync()
    {
        await OnDelete.InvokeAsync(Hawala.Id);
    }
}
