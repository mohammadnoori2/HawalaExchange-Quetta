@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Services
@using HawalaExchange.Web.Helpers

<div class="hawala-receipt" dir="rtl">
    <div class="receipt-header">
        <div class="receipt-company">
            @if (!string.IsNullOrWhiteSpace(Company.LogoPath))
            {
                <img src="@Company.LogoPath" class="receipt-logo" />
            }

            <div>
                @if (!string.IsNullOrWhiteSpace(Company.CompanyName))
                {
                    <h4>@Company.CompanyName</h4>
                }

                @if (!string.IsNullOrWhiteSpace(Company.Address))
                {
                    <div class="receipt-muted">@Company.Address</div>
                }

                @if (!string.IsNullOrWhiteSpace(Company.PhoneNumber))
                {
                    <div class="receipt-muted">شماره تماس: @Company.PhoneNumber</div>
                }
            </div>
        </div>

        <div class="receipt-title-box">
            <h5>@GetReceiptTitle()</h5>
            <div>نمبر: <strong>@Hawala.Number</strong></div>
            <div dir="ltr">@PersianDateHelper.ToPersianDateTime12(Hawala.CreatedAt)</div>
        </div>
    </div>

    <hr />

    @if (HasMainReceiptInformation())
    {
        <div class="receipt-section">
            <h6>معلومات گیرنده</h6>

            <div class="receipt-grid">
            @if (!string.IsNullOrWhiteSpace(Hawala.SenderName))
            {
                <div><strong>فرستنده:</strong> @Hawala.SenderName</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.SenderFatherName))
            {
                <div><strong>پدر فرستنده:</strong> @Hawala.SenderFatherName</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverName))
            {
                <div><strong>گیرنده:</strong> @Hawala.ReceiverName</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverFatherName))
            {
                <div><strong>پدر گیرنده:</strong> @Hawala.ReceiverFatherName</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverPhone))
            {
                <div><strong>تلفن:</strong> @Hawala.ReceiverPhone</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverTazkiraNumber))
            {
                <div><strong>شماره تذکره:</strong> @Hawala.ReceiverTazkiraNumber</div>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverAddress))
            {
                <div class="receipt-full"><strong>آدرس:</strong> @Hawala.ReceiverAddress</div>
            }
            @if (Hawala.ToAmount.HasValue)
            {
                <div>
                    <strong>مبلغ پرداختی:</strong>
                    <span dir="ltr">@MoneyFormatHelper.Format(Hawala.ToAmount.Value) @GetCurrencyName(Hawala.ToCurrencyName, Hawala.ToCurrencyCode)</span>
                </div>

                <div class="receipt-full">
                    <strong>مبلغ به حروف:</strong>
                    @DariNumberToWords.ToWords(Hawala.ToAmount.Value)
                    @GetCurrencyName(Hawala.ToCurrencyName, Hawala.ToCurrencyCode)
                </div>
            }
            </div>
        </div>
    }

    @if (Hawala.CommissionAmount is > 0 || HasPaymentLocation())
    {
        <div class="receipt-section">
            <h6>معلومات حواله</h6>

            <div class="receipt-grid">
                @if (Hawala.CommissionAmount is > 0)
                {
                    <div>
                        <strong>کارمزد:</strong>
                        @MoneyFormatHelper.Format(Hawala.CommissionAmount.Value) @GetCurrencyName(Hawala.CommissionCurrencyName, Hawala.CommissionCurrencyCode)
                    </div>
                }

                @if (HasPaymentLocation())
                {
                    <div>
                        <strong>محل پرداخت:</strong>
                        @GetPaymentLocation()
                    </div>
                }
            </div>
        </div>
    }

    @if (Hawala.PaidAt.HasValue)
    {
        <div class="receipt-section">
            <strong>تاریخ پرداخت:</strong>
            <span dir="ltr">@PersianDateHelper.ToPersianDateTime12(Hawala.PaidAt.Value)</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Hawala.Notes))
    {
        <div class="receipt-section">
            <strong>یادداشت:</strong>
            <div>@Hawala.Notes</div>
        </div>
    }

    <div class="receipt-footer">
        @(string.IsNullOrWhiteSpace(Company.FooterNote) ? "نوت: سند فقط جهت معلومات مشتری میباشد و هیچ گونه ارزش پولی ندارد." : Company.FooterNote)
    </div>
</div>

<style>
    .hawala-receipt {
        background: #fff;
        color: #111827;
        padding: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        font-size: 14px;
    }

    .receipt-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .receipt-company {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .receipt-logo {
        width: 76px;
        height: 76px;
        object-fit: contain;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 5px;
    }

    .receipt-muted {
        color: #6b7280;
        font-size: 13px;
    }

    .receipt-title-box {
        text-align: center;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 10px 18px;
        min-width: 210px;
    }

        .receipt-title-box h5 {
            margin-bottom: 8px;
            color: #2563eb;
            font-weight: 700;
        }

    .receipt-status-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 16px;
    }

    .receipt-section {
        margin-top: 16px;
    }

        .receipt-section h6 {
            color: #2563eb;
            font-weight: 700;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 6px;
            margin-bottom: 10px;
        }

    .receipt-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px 18px;
    }

    .receipt-full {
        grid-column: 1 / -1;
    }

    .receipt-signatures {
        display: flex;
        justify-content: space-between;
        margin-top: 50px;
        padding: 0 40px;
    }

        .receipt-signatures div {
            width: 180px;
            border-top: 1px solid #111827;
            text-align: center;
            padding-top: 7px;
        }

    .receipt-footer {
        text-align: center;
        color: #6b7280;
        margin-top: 22px;
        font-size: 13px;
    }

    
</style>

@code {
    [Parameter] public HawalaDto Hawala { get; set; } = new();

    [Parameter] public CompanySettingDto Company { get; set; } = new();

    private string GetReceiptTitle()
    {
        return Hawala.HawalaType switch
        {
            "HawalaSend" => "رسید حواله ارسالی",
            "HawalaReceive" => "رسید حواله دریافتی",
            "HawalaOther" => "رسید حواله متفرقه",
            _ => "رسید حواله"
        };
    }

    private string GetPaymentLocation()
    {
        if (!string.IsNullOrWhiteSpace(Hawala.PaymentLocationName) &&
            !string.IsNullOrWhiteSpace(Hawala.PaymentLocationAddress))
        {
            return $"{Hawala.PaymentLocationName} - {Hawala.PaymentLocationAddress}";
        }

        if (!string.IsNullOrWhiteSpace(Hawala.PaymentLocationName))
            return Hawala.PaymentLocationName;

        if (!string.IsNullOrWhiteSpace(Hawala.PaymentLocationAddress))
            return Hawala.PaymentLocationAddress;

        return "-";
    }

    private bool HasPaymentLocation() =>
        !string.IsNullOrWhiteSpace(Hawala.PaymentLocationName) ||
        !string.IsNullOrWhiteSpace(Hawala.PaymentLocationAddress);

    private bool HasMainReceiptInformation() =>
        !string.IsNullOrWhiteSpace(Hawala.SenderName) ||
        !string.IsNullOrWhiteSpace(Hawala.SenderFatherName) ||
        !string.IsNullOrWhiteSpace(Hawala.ReceiverName) ||
        !string.IsNullOrWhiteSpace(Hawala.ReceiverFatherName) ||
        !string.IsNullOrWhiteSpace(Hawala.ReceiverPhone) ||
        !string.IsNullOrWhiteSpace(Hawala.ReceiverTazkiraNumber) ||
        !string.IsNullOrWhiteSpace(Hawala.ReceiverAddress) ||
        Hawala.ToAmount.HasValue;

    private static string GetCurrencyName(string? name, string? code)
    {
        return !string.IsNullOrWhiteSpace(name)
            ? name
            : code ?? "-";
    }
}
