@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Services
@using HawalaExchange.Web.Helpers

<article class="hawala-receipt" dir="rtl">
    @if (ShowCompanyHeader)
    {
        <header class="receipt-brand">
            <div class="receipt-brand-copy">
                @if (!string.IsNullOrWhiteSpace(Company.CompanyName))
                {
                    <h3>@Company.CompanyName</h3>
                }
                <div class="receipt-kind">@GetReceiptTitle()</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Company.LogoPath))
            {
                <img src="@Company.LogoPath" class="receipt-logo" alt="لوگوی صرافی" />
            }
        </header>
    }

    <h4 class="receipt-heading">مشخصات حواله</h4>

    <table class="receipt-table">
        <tbody>
            <tr>
                <th>تاریخ حواله:</th>
                <td>
                    <span>@PersianDateHelper.ToPersianDate(Hawala.CreatedAt)</span>
                    <span class="receipt-time" dir="ltr">@Hawala.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                </td>
            </tr>
            <tr>
                <th>نمبر حواله:</th>
                <td class="receipt-strong">
                    <span>@Hawala.Number</span>
                    @if (!string.IsNullOrWhiteSpace(Hawala.ReferenceNumber))
                    {
                        <span class="receipt-reference">@Hawala.ReferenceNumber</span>
                    }
                </td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(Hawala.SenderName))
            {
                <tr><th>فرستنده:</th><td>@Hawala.SenderName</td></tr>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.SenderFatherName))
            {
                <tr><th>پدر فرستنده:</th><td>@Hawala.SenderFatherName</td></tr>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverName))
            {
                <tr>
                    <th>گیرنده:</th>
                    <td>
                        @Hawala.ReceiverName
                        @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverFatherName))
                        {
                            <span> ولد @Hawala.ReceiverFatherName</span>
                        }
                    </td>
                </tr>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverPhone))
            {
                <tr><th>شماره تماس:</th><td dir="ltr">@Hawala.ReceiverPhone</td></tr>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverTazkiraNumber))
            {
                <tr><th>شماره تذکره:</th><td>@Hawala.ReceiverTazkiraNumber</td></tr>
            }
            @if (Hawala.ToAmount.HasValue)
            {
                <tr>
                    <th>مبلغ پرداختی:</th>
                    <td class="receipt-amount" dir="ltr">
                        @MoneyFormatHelper.Format(Hawala.ToAmount.Value)
                        @GetCurrencyName(Hawala.ToCurrencyName, Hawala.ToCurrencyCode)
                    </td>
                </tr>
                <tr>
                    <th>مبلغ به حروف:</th>
                    <td>
                        @DariNumberToWords.ToWords(Hawala.ToAmount.Value)
                        @GetCurrencyName(Hawala.ToCurrencyName, Hawala.ToCurrencyCode)
                    </td>
                </tr>
            }
            @if (Hawala.CommissionAmount is > 0)
            {
                <tr>
                    <th>کارمزد:</th>
                    <td dir="ltr">
                        @MoneyFormatHelper.Format(Hawala.CommissionAmount.Value)
                        @GetCurrencyName(Hawala.CommissionCurrencyName, Hawala.CommissionCurrencyCode)
                    </td>
                </tr>
            }
            @if (HasPaymentLocation())
            {
                <tr><th>محل پرداخت:</th><td>@GetPaymentLocation()</td></tr>
            }
            @if (!string.IsNullOrWhiteSpace(Hawala.ReceiverAddress))
            {
                <tr><th>آدرس گیرنده:</th><td>@Hawala.ReceiverAddress</td></tr>
            }
            @if (HasUserNote())
            {
                <tr><th>یادداشت:</th><td>@Hawala.Notes</td></tr>
            }
        </tbody>
    </table>

    @if (HasCompanyContactInformation())
    {
        <section class="receipt-company-contact">
            @if (!string.IsNullOrWhiteSpace(Company.Address))
            {
                <div class="receipt-company-address">آدرس: @Company.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(Company.PhoneNumber))
            {
                <div class="receipt-company-phone">شماره تلفون: <span dir="ltr">@Company.PhoneNumber</span></div>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Company.FooterNote))
    {
        <div class="receipt-custom-note">@Company.FooterNote</div>
    }

    <footer class="receipt-legal-note">
        این رسید فقط جهت اطلاع مشتری میباشد و هیچ سند پولی شده نمی تواند.
    </footer>
</article>

<style>
    .hawala-receipt {
        width: 80mm;
        max-width: 100%;
        margin: 0 auto;
        padding: 4.5mm;
        background: #fff;
        color: #171717;
        border: 1.5px solid #c99a10;
        border-radius: 2px;
        font-family: Tahoma, Arial, sans-serif;
        font-size: 12px;
        line-height: 1.55;
        box-sizing: border-box;
    }

    .receipt-brand {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 24mm;
        align-items: center;
        gap: 3mm;
        padding: 1mm 1mm 2.5mm;
    }

    .receipt-brand-copy {
        text-align: center;
    }

    .receipt-brand-copy h3 {
        margin: 0 0 1.5mm;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.65;
    }

    .receipt-kind {
        font-size: 13px;
        font-weight: 700;
    }

    .receipt-logo {
        width: 22mm;
        height: 22mm;
        object-fit: contain;
    }

    .receipt-heading {
        margin: 0 0 2mm;
        text-align: center;
        font-size: 15px;
        font-weight: 800;
    }

    .receipt-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .receipt-table th,
    .receipt-table td {
        border: 1px solid #555;
        padding: 1.3mm 1.6mm;
        vertical-align: middle;
        overflow-wrap: anywhere;
    }

    .receipt-table th {
        width: 31%;
        text-align: right;
        font-weight: 800;
        background: #faf8ef;
    }

    .receipt-table td {
        text-align: right;
    }

    .receipt-time {
        float: left;
    }

    .receipt-strong,
    .receipt-amount {
        font-size: 13px;
        font-weight: 800;
    }

    .receipt-reference {
        display: block;
        margin-top: .5mm;
        font-size: 11px;
        font-weight: 600;
    }

    .receipt-company-contact {
        padding: 3mm 1.5mm 1mm;
        text-align: center;
        font-size: 11px;
    }

    .receipt-company-address {
        margin-bottom: 1.5mm;
        font-weight: 600;
    }

    .receipt-company-phone {
        font-weight: 700;
    }

    .receipt-custom-note {
        margin-top: 2.5mm;
        padding-top: 2mm;
        border-top: 1px dashed #aaa;
        text-align: center;
        font-size: 10px;
    }

    .receipt-legal-note {
        margin-top: 3mm;
        padding: 2.5mm 2mm 0;
        border-top: 1px solid #c99a10;
        text-align: center;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.8;
    }

    @@media print {
        .hawala-receipt {
            width: 80mm;
            max-width: 80mm;
            margin: 0;
            box-shadow: none;
            break-inside: avoid;
        }
    }
</style>

@code {
    [Parameter] public HawalaDto Hawala { get; set; } = new();

    [Parameter] public CompanySettingDto Company { get; set; } = new();

    [Parameter] public bool ShowCompanyHeader { get; set; } = true;

    private string GetReceiptTitle() => Hawala.HawalaType switch
    {
        "HawalaSend" => "رسید حواله ارسالی",
        "HawalaReceive" => "رسید حواله دریافتی",
        "HawalaOther" => "رسید حواله متفرقه",
        _ => "رسید حواله"
    };

    private string GetPaymentLocation()
    {
        if (!string.IsNullOrWhiteSpace(Hawala.PaymentLocationName) &&
            !string.IsNullOrWhiteSpace(Hawala.PaymentLocationAddress))
        {
            return $"{Hawala.PaymentLocationName} - {Hawala.PaymentLocationAddress}";
        }

        if (!string.IsNullOrWhiteSpace(Hawala.PaymentLocationName))
            return Hawala.PaymentLocationName;

        return Hawala.PaymentLocationAddress ?? string.Empty;
    }

    private bool HasPaymentLocation() =>
        !string.IsNullOrWhiteSpace(Hawala.PaymentLocationName) ||
        !string.IsNullOrWhiteSpace(Hawala.PaymentLocationAddress);

    private bool HasCompanyContactInformation() =>
        !string.IsNullOrWhiteSpace(Company.Address) ||
        !string.IsNullOrWhiteSpace(Company.PhoneNumber);

    private bool HasUserNote() =>
        !string.IsNullOrWhiteSpace(Hawala.Notes) &&
        !(Hawala.IsSystemGenerated &&
          Hawala.SourceHawalaId.HasValue &&
          Hawala.Notes.StartsWith(
              "حواله ارسالی خودکار بابت پرداخت حواله دریافتی شماره",
              StringComparison.Ordinal));

    private static string GetCurrencyName(string? name, string? code) =>
        !string.IsNullOrWhiteSpace(name) ? name : code ?? string.Empty;
}
