@* Components/Shared/Modals/AccountDetailsModal.razor *@
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@inject IBalanceService BalanceService
@inject IJournalService JournalService
@inject IMoneyExchangeOperationService MoneyExchangeOperationService
@inject IAccountMoneyOperationService AccountMoneyOperationService
@inject ITransferService TransferService
@implements IDisposable

@if (IsVisible && Account != null)
{
    <div class="@(PageMode ? "account-view-page" : "modal show d-block modal-modern")"
         tabindex="-1"
         style="@(PageMode ? null : "background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);")"
         dir="rtl">
        <div class="@(PageMode ? "account-view-page-shell" : "modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable account-view-dialog")">
            <div class="@(PageMode ? "account-view-page-content" : "modal-content account-view-modal")">
                <div class="@(PageMode ? "account-view-page-header" : "modal-header account-view-header")">
                    <div class="account-view-title">
                        <h5 class="@(PageMode ? "mb-0" : "modal-title text-white mb-0")">@ViewTitle</h5>
                        <small>@(string.IsNullOrWhiteSpace(ViewSubtitle) ? $"{Account.AccountName} · {Account.AccountCode}" : ViewSubtitle)</small>
                    </div>
                    <div class="account-view-header-actions">
                        @HeaderActions
                        @if (PageMode && UseActionsMenu)
                        {
                            <AccountActionsMenu IsArchived="@ActionArchived"
                                                CanUseFinancialActions="@(ShowFinancialActions && !ActionArchived)"
                                                CanEdit="@OnEditRequested.HasDelegate"
                                                CanArchive="@OnArchiveToggleRequested.HasDelegate"
                                                ShowTransactions="@ShowTransactionsInActionsMenu"
                                                ShowReports="@ShowReportsInActionsMenu"
                                                OnViewTransactions="OnViewTransactions"
                                                OnReports="OnViewReports"
                                                OnExchange="OpenCreateExchange"
                                                OnTransfer="OpenCreateTransfer"
                                                OnReceiptOrWithdrawal="OpenCreateAccountOperation"
                                                OnEdit="RequestEditAsync"
                                                OnArchive="RequestArchiveToggleAsync"
                                                OnBack="Close" />
                        }
                        else
                        {
                            @if (PageMode && ShowFinancialActions && !ActionArchived)
                            {
                                <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreateExchange">
                                    تبادله اسعار
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenCreateTransfer">
                                    انتقال بین حساب
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenCreateAccountOperation">
                                    رسید / برد
                                </button>
                            }
                            @if (!ActionArchived && OnEditRequested.HasDelegate)
                            {
                                <button type="button"
                                        class="btn btn-sm @(PageMode ? "btn-outline-primary" : "btn-light")"
                                        @onclick="RequestEditAsync">
                                    @EditButtonText
                                </button>
                            }
                            @if (OnArchiveToggleRequested.HasDelegate)
                            {
                                <button type="button"
                                        class="btn btn-sm @(ActionArchived ? "btn-outline-success" : (PageMode ? "btn-outline-danger" : "btn-warning"))"
                                        @onclick="RequestArchiveToggleAsync">
                                    @(ActionArchived ? UnarchiveButtonText : ArchiveButtonText)
                                </button>
                            }
                            @if (PageMode)
                            {
                                @if (ShowBackButton)
                                {
                                    <button type="button" class="btn btn-sm btn-light border" @onclick="Close">
                                        @BackButtonText
                                    </button>
                                }
                            }
                            else
                            {
                                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                            }
                        }
                    </div>
                </div>
                <div class="@(PageMode ? "account-view-page-body" : "modal-body")">
                    @if (ValidationErrors.Any())
                    {
                        <div class="alert alert-danger">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> خطاها:</h6>
                            <ul class="mb-0">
                                @foreach (var error in ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-1"></i> @SuccessMessage
                        </div>
                    }

                    @ProfileSummary

                    <!-- اطلاعات خلاصه حساب -->
                    @if (ShowAccountFacts)
                    {
                        <div class="account-facts-grid mb-2">
                            <div class="account-fact">
                                <span>کد حساب</span>
                                <strong>@Account.AccountCode</strong>
                            </div>
                            <div class="account-fact">
                                <span>نام حساب</span>
                                <strong>@Account.AccountName</strong>
                            </div>
                            <div class="account-fact">
                                <span>نوع حساب</span>
                                <strong>@GetAccountTypeName(Account.AccountType)</strong>
                            </div>
                            <div class="account-fact">
                                <span>وضعیت</span>
                                @if (Account.IsArchived)
                                {
                                    <strong class="text-warning">بایگانی شده</strong>
                                }
                                else
                                {
                                    <strong class="text-success">فعال</strong>
                                }
                            </div>
                            <div class="account-fact">
                                <span>نوع مرجع</span>
                                <strong>@(string.IsNullOrEmpty(Account.ReferenceType) ? "—" : GetReferenceTypeName(Account.ReferenceType))</strong>
                            </div>
                            <div class="account-fact">
                                <span>شناسه مرجع</span>
                                <strong>@(Account.ReferenceId?.ToString() ?? "—")</strong>
                            </div>
                            <div class="account-fact">
                                <span>سری کد</span>
                                @{
                                    var prefix = Account.AccountCode.Length > 0 ? Account.AccountCode[0].ToString() : "";
                                }
                                <strong>سری @prefix</strong>
                            </div>
                            <div class="account-fact">
                                <span>تاریخ ایجاد</span>
                                <strong><AppDateTime Value="@Account.CreatedAt" /></strong>
                            </div>
                        </div>
                    }

                    <!-- جمع‌بندی موجودی -->
                    <div class="modern-card account-balance-card mb-2">
                        <div class="card-header">
                            <h6 class="text-white">
                                <i class="bi bi-calculator me-2"></i> جمع‌بندی موجودی به تفکیک ارز
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (IsBalanceLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (BalanceSummary.Any())
                            {
                                <div class="account-balance-grid">
                                    @foreach (var item in BalanceSummary)
                                    {
                                        var status = item.Balance > 0 ? "طلبکار" : (item.Balance < 0 ? "بدهکار" : "تسویه");
                                        var valueClass = item.Balance > 0 ? "text-success" : (item.Balance < 0 ? "text-danger" : "text-muted");
                                        <div class="account-balance-item">
                                            <strong>@item.CurrencyCode</strong>
                                            <span class="@valueClass">@MoneyFormatHelper.Format(Math.Abs(item.Balance))</span>
                                            <small>@status</small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state py-3">
                                    <i class="bi bi-inbox"></i>
                                    <span class="text-muted">هیچ تراکنشی برای این حساب یافت نشد</span>
                                </div>
                            }
                        </div>
                    </div>

                    @AdditionalContent

                    <!-- عملیات مرتبط با حساب -->
                    <div class="modern-card account-operations-card">
                        <div class="card-header">
                            <h6 class="text-white">
                                <i class="bi bi-list-ul me-2"></i> معاملات و عملیات حساب
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (!PageMode)
                            {
                                <div class="account-operation-actions d-flex flex-wrap gap-2 mb-2">
                                    <button class="btn btn-sm btn-primary" @onclick="OpenCreateExchange">
                                        <i class="bi bi-currency-exchange"></i> تبادله اسعار
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="OpenCreateTransfer">
                                        <i class="bi bi-arrow-left-right"></i> انتقال بین حساب
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="OpenCreateAccountOperation">
                                        <i class="bi bi-cash-stack"></i> رسید / برد
                                    </button>
                                </div>
                            }

                            <CompactFilterBar AriaLabel="جستجو و فیلتر معاملات حساب"
                                              CssClass="account-operation-filters mb-2"
                                              HasActiveFilters="@HasActiveOperationFilters"
                                              ActiveFilterCount="@AdvancedOperationFilterCount"
                                              Reset="ResetOperationFilters">
                                <SearchContent>
                                    <input type="text"
                                           class="form-control"
                                           aria-label="جستجوی معاملات حساب"
                                           placeholder="جستجو با شماره یا شرح عملیات..."
                                           @bind="OperationSearchTerm"
                                           @bind:event="oninput"
                                           @bind:after="OnOperationSearchChangedAsync" />
                                </SearchContent>
                                <QuickFilters>
                                    <select class="form-select compact-quick-filter"
                                            aria-label="نوع معامله"
                                            @bind="OperationFilter"
                                            @bind:event="oninput"
                                            @bind:after="OnOperationFilterChangedAsync">
                                        <option value="All">همه معاملات</option>
                                        <option value="تبدیل پول">تبادله اسعار</option>
                                        <option value="انتقال">انتقال بین حساب</option>
                                        <option value="واریز / برداشت / پرداخت">رسید / برد</option>
                                        <option value="Other">سایر عملیات</option>
                                    </select>
                                </QuickFilters>
                                <AdvancedFilters>
                                    <div class="compact-filter-field">
                                        <label class="form-label">ارز</label>
                                        <select class="form-select" @bind="OperationCurrencyFilter" @bind:event="oninput" @bind:after="OnOperationFilterChangedAsync">
                                            <option value="">همه ارزها</option>
                                            @foreach (var currencyCode in operationCurrencyCodes)
                                            {
                                                <option value="@currencyCode">@currencyCode</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="compact-filter-field">
                                        <label class="form-label">از تاریخ</label>
                                        <PersianDatePicker @bind-Value="OperationFromDate" @bind-Value:after="OnOperationFilterChangedAsync"
                                                           IncludeTime="false"
                                                           AllowEmpty="true"
                                                           Placeholder="انتخاب تاریخ" />
                                    </div>
                                    <div class="compact-filter-field">
                                        <label class="form-label">تا تاریخ</label>
                                        <PersianDatePicker @bind-Value="OperationToDate" @bind-Value:after="OnOperationFilterChangedAsync"
                                                           IncludeTime="false"
                                                           AllowEmpty="true"
                                                           Placeholder="انتخاب تاریخ" />
                                    </div>
                                </AdvancedFilters>
                            </CompactFilterBar>

                            @if (IsOperationsLoading)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                    </div>
                                </div>
                            }
                            else if (Operations.Any())
                            {
                                <div class="account-operation-list d-flex flex-column gap-2">
                                    @foreach (var operation in Operations)
                                    {
                                        <article class="account-operation-row border rounded-3 p-2 bg-white">
                                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <span class="badge-modern @GetOperationBadge(operation.SourceType)">
                                                        @GetSourceTypeName(operation.SourceType)
                                                    </span>
                                                    <span class="text-muted small"><AppDateTime Value="@operation.CreatedAt" /></span>
                                                    <span class="text-muted small">شماره @operation.DocumentNumber</span>
                                                </div>

                                                @if (CanModifyOperation(operation))
                                                {
                                                    <div class="action-group">
                                                        <button class="action-btn action-btn-edit"
                                                                title="ویرایش"
                                                                @onclick="() => EditOperationAsync(operation)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="action-btn action-btn-delete"
                                                                title="حذف"
                                                                @onclick="() => AskDeleteOperation(operation)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>

                                            <p class="mb-1 fw-semibold">@operation.SummarySentence</p>

                                            @if (operationDetailsLoading.Contains(operation.OperationKey))
                                            {
                                                <div class="text-primary small"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری جزئیات...</div>
                                            }
                                            else if (loadedOperationDetails.Contains(operation.OperationKey))
                                            {
                                                <details>
                                                    <summary class="text-primary small" style="cursor:pointer">نمایش جزئیات عملیات</summary>
                                                    <div class="row g-2 mt-2">
                                                        @foreach (var detail in operation.SourceDetails)
                                                        {
                                                            <div class="col-md-6">
                                                                <div class="bg-light rounded p-2">
                                                                    <span class="text-muted small">@detail.Label:</span>
                                                                    <strong class="ms-1">@detail.Value</strong>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => LoadOperationDetailsAsync(operation)">
                                                    نمایش جزئیات عملیات
                                                </button>
                                            }
                                        </article>
                                    }
                                </div>
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                                    <span class="text-muted small">نمایش @Operations.Count از @operationsTotalCount عملیات · صفحه @operationPage از @operationTotalPages</span>
                                    <CompactPagination CurrentPage="operationPage" TotalPages="operationTotalPages" PageChanged="GoToOperationPageAsync" />
                                    <PageSizeSelector @bind-Value="operationPageSize"
                                                      @bind-CurrentPage="operationPage"
                                                      Changed="OnOperationPageSizeChangedAsync"
                                                      Sizes="@operationPageSizes"
                                                      ShowAll="false"
                                                      PersistPreference="false"
                                                      AriaLabel="تعداد عملیات در هر صفحه" />
                                </div>
                            }
                            else
                            {
                                <div class="empty-state py-3">
                                    <i class="bi bi-journal"></i>
                                    <span class="text-muted">هیچ تراکنشی برای این حساب ثبت نشده است</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<MoneyExchangeModal IsVisible="@showExchangeModal"
                    IsVisibleChanged="@((bool value) => showExchangeModal = value)"
                    IsEditMode="@isExchangeEditMode"
                    EditId="@operationEditId"
                    EditData="@exchangeEditData"
                    InitialAccountId="@Account?.Id"
                    OnSaveSuccess="@OnExchangeSaved"
                    OnEditSuccess="@OnOperationEdited" />

<DepositWithdrawModal IsVisible="@showAccountOperationModal"
                      IsVisibleChanged="@((bool value) => showAccountOperationModal = value)"
                      IsEditMode="@isAccountOperationEditMode"
                      EditId="@operationEditId"
                      EditData="@accountOperationEditData"
                      InitialAccountId="@Account?.Id"
                      OnSaveSuccess="@OnAccountOperationSaved"
                      OnEditSuccess="@OnOperationEdited" />

<TransferModal IsVisible="@showTransferModal"
               IsVisibleChanged="@((bool value) => showTransferModal = value)"
               IsEditMode="@isTransferEditMode"
               EditId="@operationEditId"
               EditData="@transferEditData"
               InitialAccountId="@Account?.Id"
               OnSaveSuccess="@OnTransferSaved"
               OnEditSuccess="@OnOperationEdited" />

@if (showDeleteOperationModal && operationToDelete != null)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.6);"
         dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-danger">
                    <h5 class="modal-title text-white">تأیید حذف معامله</h5>
                    <button class="btn-close btn-close-white" @onclick="CancelDeleteOperation"></button>
                </div>
                <div class="modal-body">
                    <p>آیا این عملیات و تمام ثبت‌های حسابداری مرتبط با آن حذف گردد؟</p>
                    <p class="mb-0 fw-semibold">@operationToDelete.SummarySentence</p>
                </div>
                <div class="modal-footer">
                    <button class="btn-modern btn-light-modern" @onclick="CancelDeleteOperation">انصراف</button>
                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmDeleteOperationAsync">
                        <i class="bi bi-trash"></i> حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== پارامترها =====
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public AccountDto? Account { get; set; }
    [Parameter] public bool PageMode { get; set; }
    [Parameter] public string ViewTitle { get; set; } = "مشاهده حساب";
    [Parameter] public string? ViewSubtitle { get; set; }
    [Parameter] public string EditButtonText { get; set; } = "ویرایش حساب";
    [Parameter] public string ArchiveButtonText { get; set; } = "بایگانی حساب";
    [Parameter] public string UnarchiveButtonText { get; set; } = "خروج از بایگانی";
    [Parameter] public string BackButtonText { get; set; } = "بازگشت";
    [Parameter] public bool ShowAccountFacts { get; set; } = true;
    [Parameter] public bool ShowFinancialActions { get; set; } = true;
    [Parameter] public bool ShowBackButton { get; set; } = true;
    [Parameter] public bool UseActionsMenu { get; set; }
    [Parameter] public bool ShowTransactionsInActionsMenu { get; set; }
    [Parameter] public bool ShowReportsInActionsMenu { get; set; }
    [Parameter] public bool? ActionEntityArchived { get; set; }
    [Parameter] public IReadOnlyList<BalanceDto>? InitialBalances { get; set; }
    [Parameter] public AccountOperationsPageDto? InitialOperationsPage { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ProfileSummary { get; set; }
    [Parameter] public RenderFragment? AdditionalContent { get; set; }
    [Parameter] public EventCallback<long> OnEditRequested { get; set; }
    [Parameter] public EventCallback<long> OnArchiveToggleRequested { get; set; }
    [Parameter] public EventCallback OnViewTransactions { get; set; }
    [Parameter] public EventCallback OnViewReports { get; set; }

    private List<string> ValidationErrors { get; set; } = new();
    private string SuccessMessage { get; set; } = string.Empty;
    private bool IsBalanceLoading { get; set; } = false;
    private bool IsOperationsLoading { get; set; } = false;
    private List<BalanceDto> BalanceSummary { get; set; } = new();
    private List<JournalOperationDto> Operations { get; set; } = new();
    private List<string> operationCurrencyCodes = new();
    private readonly HashSet<string> loadedOperationDetails = new(StringComparer.Ordinal);
    private readonly HashSet<string> operationDetailsLoading = new(StringComparer.Ordinal);
    private static readonly IReadOnlyList<int> operationPageSizes = [10, 20, 50, 100];
    private int operationPage = 1;
    private int operationPageSize = 10;
    private int operationsTotalCount;
    private int operationTotalPages = 1;
    private int operationLoadVersion;
    private CancellationTokenSource? operationLoadCts;
    private CancellationTokenSource? operationSearchCts;
    private string OperationFilter { get; set; } = "All";
    private string OperationSearchTerm { get; set; } = string.Empty;
    private string OperationCurrencyFilter { get; set; } = string.Empty;
    private DateTime OperationFromDate { get; set; } = DateTime.MinValue;
    private DateTime OperationToDate { get; set; } = DateTime.MinValue;

    private bool showExchangeModal;
    private bool isExchangeEditMode;
    private CreateMoneyExchangeOperationDto? exchangeEditData;
    private bool showAccountOperationModal;
    private bool isAccountOperationEditMode;
    private CreateAccountMoneyOperationDto? accountOperationEditData;
    private bool showTransferModal;
    private bool isTransferEditMode;
    private CreateTransferDto? transferEditData;
    private long operationEditId;
    private bool showDeleteOperationModal;
    private JournalOperationDto? operationToDelete;
    private long? loadedAccountId;
    private bool wasVisible;
    private bool ActionArchived => ActionEntityArchived ?? Account?.IsArchived ?? false;

    private bool HasActiveOperationFilters =>
        !string.IsNullOrWhiteSpace(OperationSearchTerm) ||
        OperationFilter != "All" ||
        AdvancedOperationFilterCount > 0;

    private int AdvancedOperationFilterCount =>
        (!string.IsNullOrWhiteSpace(OperationCurrencyFilter) ? 1 : 0) +
        (OperationFromDate != DateTime.MinValue ? 1 : 0) +
        (OperationToDate != DateTime.MinValue ? 1 : 0);

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible || Account == null)
        {
            wasVisible = false;
            return;
        }

        var shouldLoad = !wasVisible || loadedAccountId != Account.Id;
        wasVisible = true;
        loadedAccountId = Account.Id;

        if (shouldLoad)
        {
            ResetOperationFiltersState();
            if (InitialBalances is not null && InitialOperationsPage is not null)
                ApplyInitialData();
            else
                await LoadAccountData(Account.Id);
        }
    }

    private void ApplyInitialData()
    {
        BalanceSummary = InitialBalances!.ToList();
        Operations = InitialOperationsPage!.Items.Take(InitialOperationsPage.PageSize).ToList();
        operationCurrencyCodes = InitialOperationsPage.AvailableCurrencyCodes.ToList();
        operationsTotalCount = InitialOperationsPage.TotalCount;
        operationPage = InitialOperationsPage.PageNumber;
        operationPageSize = InitialOperationsPage.PageSize;
        operationTotalPages = Math.Max(1, InitialOperationsPage.TotalPages);
        loadedOperationDetails.Clear();
        operationDetailsLoading.Clear();
        IsBalanceLoading = false;
        IsOperationsLoading = false;
    }

    private async Task LoadAccountData(long accountId)
    {
        if (accountId <= 0)
        {
            BalanceSummary.Clear();
            Operations.Clear();
            operationCurrencyCodes.Clear();
            operationsTotalCount = 0;
            operationTotalPages = 1;
            return;
        }

        try
        {
            IsBalanceLoading = true;
            ValidationErrors.Clear();
            StateHasChanged();

            var balanceResult = await BalanceService.GetAccountBalanceAsync(accountId);
            BalanceSummary = balanceResult.ToList();
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در بارگذاری مانده حساب: {ex.Message}");
        }
        finally
        {
            IsBalanceLoading = false;
            StateHasChanged();
        }

        await StartOperationLoadAsync();
    }

    private async Task LoadOperationsAsync(long accountId, CancellationToken cancellationToken = default)
    {
        var loadVersion = ++operationLoadVersion;
        try
        {
            IsOperationsLoading = true;
            var result = await JournalService.GetAccountOperationsPageAsync(new AccountOperationsFilterDto
            {
                AccountId = accountId,
                SearchTerm = string.IsNullOrWhiteSpace(OperationSearchTerm) ? null : OperationSearchTerm.Trim(),
                SourceType = OperationFilter == "All" ? null : OperationFilter,
                CurrencyCode = string.IsNullOrWhiteSpace(OperationCurrencyFilter) ? null : OperationCurrencyFilter,
                FromDate = OperationFromDate == DateTime.MinValue ? null : OperationFromDate,
                ToDate = OperationToDate == DateTime.MinValue ? null : OperationToDate,
                PageNumber = operationPage,
                PageSize = operationPageSize
            }, cancellationToken);
            if (loadVersion != operationLoadVersion)
                return;

            Operations = result.Items.Take(result.PageSize).ToList();
            operationCurrencyCodes = result.AvailableCurrencyCodes;
            operationsTotalCount = result.TotalCount;
            operationTotalPages = Math.Max(1, result.TotalPages);
            loadedOperationDetails.Clear();
            operationDetailsLoading.Clear();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در بارگذاری عملیات حساب: {ex.Message}");
        }
        finally
        {
            if (loadVersion == operationLoadVersion)
            {
                IsOperationsLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnOperationSearchChangedAsync()
    {
        operationSearchCts?.Cancel();
        operationSearchCts?.Dispose();
        operationLoadCts?.Cancel();
        operationLoadCts?.Dispose();
        operationLoadCts = null;
        operationSearchCts = new CancellationTokenSource();
        var debounce = operationSearchCts;
        try
        {
            await Task.Delay(300, debounce.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        operationPage = 1;
        await StartOperationLoadAsync(debounce.Token);
    }

    private async Task OnOperationFilterChangedAsync()
    {
        CancelPendingOperationLoads();
        operationPage = 1;
        await StartOperationLoadAsync();
    }

    private async Task ResetOperationFilters()
    {
        CancelPendingOperationLoads();
        ResetOperationFiltersState();
        await StartOperationLoadAsync();
    }

    private void ResetOperationFiltersState()
    {
        OperationSearchTerm = string.Empty;
        OperationFilter = "All";
        OperationCurrencyFilter = string.Empty;
        OperationFromDate = DateTime.MinValue;
        OperationToDate = DateTime.MinValue;
        operationPage = 1;
    }

    private async Task GoToOperationPageAsync(int page)
    {
        if (page < 1 || page > operationTotalPages || page == operationPage)
            return;
        CancelPendingOperationLoads();
        operationPage = page;
        await StartOperationLoadAsync();
    }

    private async Task OnOperationPageSizeChangedAsync()
    {
        CancelPendingOperationLoads();
        operationPage = 1;
        await StartOperationLoadAsync();
    }

    private async Task StartOperationLoadAsync(CancellationToken cancellationToken = default)
    {
        if (Account is null || Account.Id <= 0)
            return;
        operationLoadCts?.Cancel();
        operationLoadCts?.Dispose();
        operationLoadCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        await LoadOperationsAsync(Account.Id, operationLoadCts.Token);
    }

    private async Task LoadOperationDetailsAsync(JournalOperationDto operation)
    {
        if (Account is null || operationDetailsLoading.Contains(operation.OperationKey))
            return;
        try
        {
            operationDetailsLoading.Add(operation.OperationKey);
            var detailed = await JournalService.GetAccountOperationDetailsAsync(
                Account.Id, operation.OperationKey);
            if (detailed is null)
                throw new InvalidOperationException("جزئیات عملیات یافت نشد.");

            var index = Operations.FindIndex(x => x.OperationKey == operation.OperationKey);
            if (index >= 0)
                Operations[index] = detailed;
            loadedOperationDetails.Add(operation.OperationKey);
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در بارگذاری جزئیات عملیات: {ex.Message}");
        }
        finally
        {
            operationDetailsLoading.Remove(operation.OperationKey);
        }
    }

    private void CancelPendingOperationLoads()
    {
        operationSearchCts?.Cancel();
        operationSearchCts?.Dispose();
        operationSearchCts = null;
        operationLoadCts?.Cancel();
        operationLoadCts?.Dispose();
        operationLoadCts = null;
    }

    private async Task RequestEditAsync()
    {
        if (Account != null)
            await OnEditRequested.InvokeAsync(Account.Id);
    }

    private async Task RequestArchiveToggleAsync()
    {
        if (Account != null)
            await OnArchiveToggleRequested.InvokeAsync(Account.Id);
    }

    private void OpenCreateExchange()
    {
        isExchangeEditMode = false;
        operationEditId = 0;
        exchangeEditData = null;
        showExchangeModal = true;
    }

    private void OpenCreateAccountOperation()
    {
        isAccountOperationEditMode = false;
        operationEditId = 0;
        accountOperationEditData = null;
        showAccountOperationModal = true;
    }

    private void OpenCreateTransfer()
    {
        isTransferEditMode = false;
        operationEditId = 0;
        transferEditData = null;
        showTransferModal = true;
    }

    private async Task EditOperationAsync(JournalOperationDto operation)
    {
        if (!operation.SourceId.HasValue)
            return;

        try
        {
            ValidationErrors.Clear();
            operationEditId = operation.SourceId.Value;

            if (operation.SourceType == "تبدیل پول")
            {
                var source = await MoneyExchangeOperationService.GetByIdAsync(operationEditId)
                    ?? throw new KeyNotFoundException("تبادله اسعار یافت نشد.");
                exchangeEditData = new CreateMoneyExchangeOperationDto
                {
                    ExchangeDate = source.ExchangeDate,
                    FromAccountId = source.FromAccountId,
                    FromCurrencyId = source.FromCurrencyId,
                    FromAmount = source.FromAmount,
                    ToAccountId = source.ToAccountId,
                    ToCurrencyId = source.ToCurrencyId,
                    ToAmount = source.ToAmount,
                    ExchangeRate = source.ExchangeRate,
                    OperationType = source.OperationType,
                    ProfitCurrencyId = source.ProfitCurrencyId ?? 0,
                    CommissionAmount = source.CommissionAmount,
                    ExternalFeeAmount = source.ExternalFeeAmount,
                    Description = source.Description
                };
                isExchangeEditMode = true;
                showExchangeModal = true;
            }
            else if (operation.SourceType == "واریز / برداشت / پرداخت")
            {
                var source = await AccountMoneyOperationService.GetByIdAsync(operationEditId)
                    ?? throw new KeyNotFoundException("عملیات رسید یا برد یافت نشد.");
                accountOperationEditData = new CreateAccountMoneyOperationDto
                {
                    OperationType = source.OperationType,
                    OperationDate = source.OperationDate,
                    AccountId = source.AccountId,
                    CashOrBankAccountId = source.CashOrBankAccountId,
                    CurrencyId = source.CurrencyId,
                    Amount = source.Amount,
                    Description = source.Description
                };
                isAccountOperationEditMode = true;
                showAccountOperationModal = true;
            }
            else if (operation.SourceType == "انتقال")
            {
                var source = await TransferService.GetTransferByIdAsync(operationEditId)
                    ?? throw new KeyNotFoundException("انتقال یافت نشد.");
                transferEditData = new CreateTransferDto
                {
                    FromAccountId = source.FromAccountId,
                    ToAccountId = source.ToAccountId,
                    CurrencyId = source.CurrencyId,
                    Amount = source.Amount,
                    ProfitCurrencyId = source.ProfitCurrencyId,
                    ProfitCurrencyAmount = source.ProfitCurrencyAmount,
                    TransferMethod = source.TransferMethod,
                    ReferenceNumber = source.ReferenceNumber,
                    Remarks = source.Remarks
                };
                isTransferEditMode = true;
                showTransferModal = true;
            }
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در بازکردن معامله: {ex.Message}");
        }
    }

    private void AskDeleteOperation(JournalOperationDto operation)
    {
        operationToDelete = operation;
        showDeleteOperationModal = true;
    }

    private void CancelDeleteOperation()
    {
        showDeleteOperationModal = false;
        operationToDelete = null;
    }

    private async Task ConfirmDeleteOperationAsync()
    {
        if (operationToDelete?.SourceId is not long sourceId || Account == null)
            return;

        try
        {
            if (operationToDelete.SourceType == "تبدیل پول")
                await MoneyExchangeOperationService.DeleteAsync(sourceId);
            else if (operationToDelete.SourceType == "واریز / برداشت / پرداخت")
                await AccountMoneyOperationService.DeleteAsync(sourceId);
            else if (operationToDelete.SourceType == "انتقال")
                await TransferService.DeleteTransferAsync(sourceId);
            else
                throw new InvalidOperationException("حذف این نوع عملیات از بخش حساب پشتیبانی نمی‌شود.");

            SuccessMessage = "معامله و تمام ثبت‌های حسابداری مرتبط با موفقیت حذف شد.";
            CancelDeleteOperation();
            await LoadAccountData(Account.Id);
        }
        catch (Exception ex)
        {
            CancelDeleteOperation();
            ValidationErrors.Add($"خطا در حذف معامله: {ex.Message}");
        }
    }

    private Task OnExchangeSaved(CreateMoneyExchangeOperationDto _) => ReloadOperationsAsync();

    private Task OnAccountOperationSaved(CreateAccountMoneyOperationDto _) => ReloadOperationsAsync();

    private Task OnTransferSaved(CreateTransferDto _) => ReloadOperationsAsync();

    private Task OnOperationEdited(long _) => ReloadOperationsAsync();

    private async Task ReloadOperationsAsync()
    {
        if (Account != null)
        {
            SuccessMessage = "عملیات با موفقیت ذخیره شد.";
            await LoadAccountData(Account.Id);
        }
    }

    private async Task Close()
    {
        CancelPendingOperationLoads();
        showExchangeModal = false;
        showAccountOperationModal = false;
        showTransferModal = false;
        CancelDeleteOperation();
        wasVisible = false;
        loadedAccountId = null;
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        StateHasChanged();
    }

    public void Dispose() => CancelPendingOperationLoads();

    private string GetAccountTypeName(string type) => AppDisplayText.AccountType(type);

    private string GetReferenceTypeName(string type) => AppDisplayText.ReferenceType(type);

    private static bool CanModifyOperation(JournalOperationDto operation) =>
        operation.SourceId.HasValue &&
        operation.SourceType is "تبدیل پول" or "انتقال" or "واریز / برداشت / پرداخت";

    private static string GetOperationBadge(string sourceType)
    {
        return sourceType switch
        {
            "تبدیل پول" => "badge-primary",
            "انتقال" => "badge-warning",
            "واریز / برداشت / پرداخت" => "badge-success",
            "حواله" => "badge-info",
            "مصرف" => "badge-danger",
            "ثبت سرمایه" => "badge-dark",
            _ => "badge-secondary"
        };
    }

    private static string GetSourceTypeName(string sourceType) =>
        sourceType == "واریز / برداشت / پرداخت" ? "رسید / برد" : sourceType;
}
