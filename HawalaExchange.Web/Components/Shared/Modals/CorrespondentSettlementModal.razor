@using HawalaExchange.Application.DTOs
@namespace HawalaExchange.Web.Components.Shared.Modals
@inherits HawalaExchange.Web.Components.DateAwareComponent
@using Microsoft.AspNetCore.Components
@using HawalaExchange.Web.Components.Shared
@using HawalaExchange.Web.Helpers
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Application.Services
@inject ICorrespondentSettlementService SettlementService

@if (IsVisible)
{
    <div class="modal show d-block" tabindex="-1" dir="rtl" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">تبدیل به ارز توافقی</h5>
                        @if (preview != null)
                        {
                            <small class="text-muted">@preview.CorrespondentName · ارز توافقی: @preview.TargetCurrencyCode</small>
                        }
                    </div>
                    <button type="button" class="btn-close" disabled="@saving" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    @if (!AccountMode && !string.IsNullOrWhiteSpace(SelectionNotice))
                    { <div class="alert alert-warning py-2">@SelectionNotice</div> }
                    @if (loading)
                    {
                        <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
                    }
                    else if (!string.IsNullOrWhiteSpace(error))
                    {
                        <div class="alert alert-danger mb-0">@error</div>
                    }
                    @if (!loading && preview != null)
                    {
                        @if (AccountMode)
                        {
                            <label class="form-label">تاریخ نرخ تبدیل مانده حساب</label>
                            <PersianDatePicker MaxDate="DateTime.Today" Disabled="@saving" @bind-Value="balanceRateDate"
                                               @bind-Value:after="ReloadBalanceRatesAsync" />
                        }
                        <div class="alert alert-info py-2">
                            @if (AccountMode)
                            {
                                <span>فقط ارزهای انتخاب‌شده به ارز توافقی تبدیل می‌شوند؛ ماندهٔ سایر ارزها بدون تغییر می‌ماند.</span>
                            }
                            else
                            {
                                <span>برای هر روز و ارز یک نرخ وارد کنید. هر روز مستقل ثبت می‌شود؛ همین تبدیل و نرخ، مبنای محاسبه کمیشن خواهد بود.</span>
                            }
                        </div>
                        <div class="form-text mb-2">نرخ‌های قبلاً استفاده‌شده هنگام تبدیل پُر می‌شوند. نرخ جداگانه‌ای برای کمیشن ثبت نمی‌شود؛ تبدیل‌ها و کمیشن‌های قبلی بدون برگشت رسمی دوباره محاسبه نمی‌شوند.</div>
                        @if (!string.IsNullOrWhiteSpace(completedDaysMessage)) { <div class="alert alert-success">@completedDaysMessage</div> }
                        <label class="form-check mb-2"><input class="form-check-input" type="checkbox" @bind="confirmDifferentRate" disabled="@saving" /> نرخ متفاوت همین روز را تأیید می‌کنم؛ نرخ فقط برای حواله‌های این عملیات است و تبدیل‌ها و کمیشن‌های قبلی تغییر نمی‌کنند.</label>
                        @if (AccountMode && rateGroups.Count > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">@SelectedGroupCount ارز از @rateGroups.Count انتخاب شده</span>
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@saving" @onclick="ToggleSelectAll">
                                    <i class="bi @(AllGroupsSelected ? "bi-square" : "bi-check2-square")"></i>
                                    @(AllGroupsSelected ? "لغو انتخاب همه" : "انتخاب همه")
                                </button>
                            </div>
                        }
                        <div class="table-responsive">
                            <GlobalDataGrid class="table table-sm align-middle">
                                <thead><tr>@if (AccountMode) { <th class="text-center">انتخاب</th> }<th>تاریخ نرخ</th><th>ارز فعلی</th><th>تعداد حواله</th><th>مجموع مبلغ فعلی</th><th>نرخ تبدیل</th><th>مجموع به @preview.TargetCurrencyCode</th>@if (!AccountMode){<th>ثبت روز</th>}</tr></thead>
                                <tbody>
                                    @foreach (var group in rateGroups)
                                    {
                                        <tr>
                                            @if (AccountMode)
                                            {
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" disabled="@saving" @bind="group.IsSelected" />
                                                </td>
                                            }
                                            <td>@DisplayDates.Date(group.RateDate)</td>
                                            <td class="fw-bold">@group.CurrencyCode</td>
                                            <td>@(AccountMode ? "مانده حساب" : $"{group.Items.Select(x => x.HawalaId).Distinct().Count()} حواله")</td>
                                            <td dir="ltr" class="fw-bold">@MoneyFormatHelper.Format(GetSourceTotal(group)) @group.CurrencyCode</td>
                                            <td style="min-width:9rem">
                                                <input type="number" lang="en" min="0.00000001" step="any" class="form-control form-control-sm financial-value-input"
                                                       disabled="@(saving || AccountMode && !group.IsSelected)"
                                                       @bind="group.Rate" @bind:event="oninput" @bind:after="() => ApplyGroupRate(group)" />
                                                <small class="text-muted" dir="ltr">@RateDirection(group)</small>
                                            </td>
                                            <td dir="ltr" class="fw-bold text-success">
                                                @(!AccountMode || group.IsSelected
                                                    ? group.Items.All(x => x.Rate > 0) ? $"{MoneyFormatHelper.Format(GetTargetTotal(group))} {preview.TargetCurrencyCode}" : "—"
                                                    : "انتخاب نشده")
                                            </td>
                                            @if (!AccountMode)
                                            { <td>@if (group == rateGroups.First(x=>x.RateDate==group.RateDate)) { <button class="btn btn-sm btn-outline-primary" disabled="@saving" @onclick="() => SubmitDayAsync(group.RateDate)">ثبت تبدیل همین روز</button> }</td> }
                                        </tr>
                                    }
                                </tbody>
                            </GlobalDataGrid>
                        </div>
                        @if (SelectedInputs.Count > 0 && SelectedInputs.All(x => x.Rate > 0))
                        {
                            <div class="alert alert-success py-2 d-flex justify-content-between align-items-center">
                                <span>مجموع نهایی به ارز توافقی</span>
                                <strong dir="ltr">@MoneyFormatHelper.Format(GetOverallTargetTotal()) @preview.TargetCurrencyCode</strong>
                            </div>
                        }
                        <label class="form-label">یادداشت (اختیاری)</label>
                        <textarea class="form-control" rows="2" maxlength="500" disabled="@saving" @bind="note"></textarea>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light border" disabled="@saving" @onclick="CloseAsync">انصراف</button>
                    <button class="btn btn-primary" disabled="@(saving || loading || preview == null || SelectedInputs.Count == 0)" @onclick="SubmitAsync">
                        @(saving ? "در حال ثبت..." : AccountMode ? $"تبدیل به {preview?.TargetCurrencyCode}" : "ثبت همه روزها (جداگانه)")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter, EditorRequired] public long CorrespondentId { get; set; }
    [Parameter] public bool AccountMode { get; set; }
    [Parameter] public IReadOnlyList<HawalaDto> SelectedHawalas { get; set; } = [];
    [Parameter] public string? SelectionNotice { get; set; }
    [Parameter] public EventCallback<CorrespondentSettlementResultDto> OnConverted { get; set; }

    private CorrespondentSettlementPreviewDto? preview;
    private readonly List<RateInput> rateInputs = [];
    private readonly List<RateGroup> rateGroups = [];
    private bool loading;
    private bool saving;
    private string error = string.Empty;
    private string? note;
    private bool wasVisible;
    private bool confirmDifferentRate;
    private string completedDaysMessage = "";
    private DateTime balanceRateDate = DateTime.Today;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !wasVisible)
            await PrepareAsync();
        wasVisible = IsVisible;
    }

    private async Task PrepareAsync()
    {
        loading = true;
        error = string.Empty;
        note = null;
        preview = null;
        balanceRateDate = DateTime.Today;
        rateInputs.Clear();
        rateGroups.Clear();
        confirmDifferentRate = false;
        completedDaysMessage = "";
        try
        {
            preview = await SettlementService.GetPreviewAsync(CorrespondentId);
            if (AccountMode)
            {
                rateInputs.AddRange(preview.Balances.Select(x => new RateInput
                {
                    CurrencyId = x.SourceCurrencyId,
                    RateDate = balanceRateDate,
                    CurrencyCode = x.SourceCurrencyCode,
                    SourceQuotationPriority = x.SourceQuotationPriority,
                    SourceAmount = Math.Abs(x.NetAmount),
                    Description = x.TalabKar > 0
                        ? $"طلبکار: {x.TalabKar:N2}"
                        : $"بدهکار: {x.BadehKar:N2}"
                }));
            }
            else
            {
                var hawalaBalances = await SettlementService.GetHawalaPreviewAsync(
                    CorrespondentId,
                    SelectedHawalas.Where(x => x.SettlementState == "Pending").Select(x => x.Id).ToArray());
                rateInputs.AddRange(hawalaBalances.Select(x => new RateInput
                    {
                        HawalaId = x.HawalaId,
                        HawalaNumber = x.HawalaNumber,
                        RateDate = x.RateDate,
                        CurrencyId = x.SourceCurrencyId,
                        CurrencyCode = x.SourceCurrencyCode,
                        SourceQuotationPriority = x.SourceQuotationPriority,
                        SourceAmount = Math.Abs(x.NetAmount),
                        Description = x.TalabKar > 0
                            ? $"طلبکار: {x.TalabKar:N2}"
                            : $"بدهکار: {x.BadehKar:N2}"
                    }));
            }

            rateGroups.AddRange(rateInputs
                .GroupBy(x => new { x.CurrencyId, x.CurrencyCode, x.RateDate })
                .OrderBy(x=>x.Key.RateDate).ThenBy(x=>x.Key.CurrencyCode).Select(x => new RateGroup
                {
                    CurrencyId = x.Key.CurrencyId,
                    CurrencyCode = x.Key.CurrencyCode,
                    RateDate = x.Key.RateDate,
                    Items = x.ToList(),
                    IsSelected = !AccountMode
                }));

            await LoadDailyRatesAsync();

            if (rateInputs.Count == 0)
                error = AccountMode ? "مانده‌ای برای تبدیل وجود ندارد." : "حوالهٔ تبدیل‌نشده‌ای انتخاب نشده است.";
        }
        catch (Exception ex)
        {
            preview = null;
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private Task SubmitAsync() => SubmitDayAsync(null);

    private async Task SubmitDayAsync(DateTime? onlyDay)
    {
        if (saving) return;
        error = string.Empty;
        if (SelectedInputs.Count == 0)
        {
            error = AccountMode ? "حداقل یک ارز را برای تبدیل انتخاب کنید." : "حداقل یک حواله را انتخاب کنید.";
            return;
        }

        if (AccountMode && SelectedInputs.Any(x => x.Rate.GetValueOrDefault() <= 0))
        {
            error = "برای همه ردیف‌ها نرخ معتبر وارد کنید.";
            return;
        }

        try
        {
            saving = true;
            if (AccountMode)
            {
                var result = await SettlementService.ConvertBalanceAsync(new ConvertCorrespondentBalanceDto
                {
                    ConfirmDifferentDailyRate = confirmDifferentRate,
                    CorrespondentId = CorrespondentId,
                    RateDate = balanceRateDate,
                    Rates = SelectedInputs.Select(x => new SettlementRateDto
                    {
                        SourceCurrencyId = x.CurrencyId,
                        Rate = x.Rate!.Value
                    }).ToList(),
                    Note = note
                });
                await OnConverted.InvokeAsync(result);
                await CloseAsync();
                return;
            }
            var days = rateGroups.Select(x=>x.RateDate).Distinct().Where(x=>onlyDay==null || x==onlyDay).OrderBy(x=>x).ToArray();
            var errors = new List<string>();
            foreach (var day in days)
            {
                var inputs = rateInputs.Where(x=>x.RateDate==day).ToList();
                try
                {
                    if (inputs.Any(x=>x.Rate.GetValueOrDefault()<=0)) throw new InvalidOperationException("نرخ همه ارزهای این روز را وارد کنید.");
                    var result = await SettlementService.ConvertHawalasAsync(new ConvertHawalasToSettlementDto
                    {
                        ConfirmDifferentDailyRate = confirmDifferentRate, CorrespondentId = CorrespondentId,
                        HawalaIds = inputs.Select(x=>x.HawalaId!.Value).Distinct().ToList(),
                        HawalaRates = inputs.Select(x=>new HawalaSettlementRateDto { HawalaId=x.HawalaId!.Value, SourceCurrencyId=x.CurrencyId, Rate=x.Rate!.Value }).ToList(), Note=note
                    });
                    // Remove successful days before refreshing the parent: a retry cannot re-submit them.
                    rateInputs.RemoveAll(x=>x.RateDate==day); rateGroups.RemoveAll(x=>x.RateDate==day);
                    completedDaysMessage += $" {DisplayDates.Date(day)}: {result.HawalaCount} حواله ثبت شد؛";
                    await OnConverted.InvokeAsync(result);
                }
                catch(Exception ex) { errors.Add($"{DisplayDates.Date(day)}: {ex.Message}"); }
            }
            error = string.Join("؛ ",errors);
            if (rateInputs.Count==0) await CloseAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private static decimal GetSourceTotal(RateGroup group) => group.Items.Sum(x => x.SourceAmount);

    private async Task ReloadBalanceRatesAsync()
    {
        loading = true;
        error = string.Empty;
        try
        {
            foreach (var group in rateGroups)
            {
                group.RateDate = balanceRateDate.Date;
                foreach (var item in group.Items)
                    item.RateDate = balanceRateDate.Date;
            }
            await LoadDailyRatesAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadDailyRatesAsync()
    {
        if (preview == null)
            return;
        foreach (var day in rateGroups.GroupBy(x => x.RateDate))
        {
            var rates = await SettlementService.GetRatesAsync(CorrespondentId, day.Key, day.Key);
            foreach (var group in day)
            {
                group.Rate = rates.FirstOrDefault(x=>x.SourceCurrencyId==group.CurrencyId && x.TargetCurrencyId==preview.TargetCurrencyId)?.ExchangeRate;
                ApplyGroupRate(group);
            }
        }
    }

    private string RateDirection(RateGroup group)
        => preview==null ? "" : group.Items[0].SourceQuotationPriority<preview.TargetQuotationPriority ||
            group.Items[0].SourceQuotationPriority==preview.TargetQuotationPriority && string.CompareOrdinal(group.CurrencyCode,preview.TargetCurrencyCode)<0
            ? $"1 {group.CurrencyCode} = … {preview.TargetCurrencyCode}" : $"1 {preview.TargetCurrencyCode} = … {group.CurrencyCode}";

    private decimal GetTargetTotal(RateGroup group) => group.Items.Sum(ConvertInput);

    private decimal GetOverallTargetTotal() => SelectedInputs.Sum(ConvertInput);

    private List<RateInput> SelectedInputs => AccountMode
        ? rateGroups.Where(x => x.IsSelected).SelectMany(x => x.Items).ToList()
        : rateInputs;

    private int SelectedGroupCount => rateGroups.Count(x => x.IsSelected);

    private bool AllGroupsSelected => rateGroups.Count > 0 && rateGroups.All(x => x.IsSelected);

    private void ToggleSelectAll()
    {
        var select = !AllGroupsSelected;
        foreach (var group in rateGroups)
            group.IsSelected = select;
    }

    private void ApplyGroupRate(RateGroup group)
    {
        foreach (var item in group.Items)
            item.Rate = group.Rate;
    }

    private decimal ConvertInput(RateInput item)
    {
        if (preview == null || item.Rate.GetValueOrDefault() <= 0 || item.SourceAmount <= 0)
            return 0;

        var converted = CurrencyQuotationCalculator.ConvertFromAmount(
            item.CurrencyId,
            item.CurrencyCode,
            item.SourceQuotationPriority,
            item.SourceAmount,
            preview.TargetCurrencyId,
            preview.TargetCurrencyCode,
            preview.TargetQuotationPriority,
            item.Rate!.Value);
        return decimal.Round(
            converted.ToAmount,
            Math.Clamp(preview.TargetDecimalPlaces, 0, 8),
            MidpointRounding.AwayFromZero);
    }

    private async Task CloseAsync()
    {
        wasVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private sealed class RateInput
    {
        public DateTime RateDate { get; set; }
        public long? HawalaId { get; init; }
        public long? HawalaNumber { get; init; }
        public long CurrencyId { get; init; }
        public string CurrencyCode { get; init; } = string.Empty;
        public int SourceQuotationPriority { get; init; }
        public decimal SourceAmount { get; init; }
        public string Description { get; init; } = string.Empty;
        public decimal? Rate { get; set; }
    }

    private sealed class RateGroup
    {
        public DateTime RateDate { get; set; }
        public long CurrencyId { get; init; }
        public string CurrencyCode { get; init; } = string.Empty;
        public List<RateInput> Items { get; init; } = [];
        public decimal? Rate { get; set; }
        public bool IsSelected { get; set; }
    }
}
