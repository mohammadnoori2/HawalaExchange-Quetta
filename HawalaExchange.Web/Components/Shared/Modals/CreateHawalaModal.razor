    private async Task DuplicateOperation()
    {
        if (CreatedHawala == null)
        {
            await JS.InvokeVoidAsync("alert", "هیچ حواله‌ای برای تکرار وجود ندارد");
            return;
        }

        try
        {
            // ===== 1. کپی کردن داده‌ها =====
            var hawalaToCopy = new CreateHawalaDto
            {
                HawalaType = CreatedHawala.HawalaType,
                CorrespondentId = CreatedHawala.CorrespondentId,
                FromCurrencyId = CreatedHawala.FromCurrencyId,
                ToCurrencyId = CreatedHawala.ToCurrencyId,
                FromAmount = CreatedHawala.FromAmount,
                ToAmount = CreatedHawala.ToAmount,
                ExchangeRate = CreatedHawala.ExchangeRate,
                CommissionAmount = CreatedHawala.CommissionAmount,
                CommissionCurrencyId = CreatedHawala.CommissionCurrencyId,
                AgentCommissionAmount = CreatedHawala.AgentCommissionAmount,
                AgentCommissionCurrencyId = CreatedHawala.AgentCommissionCurrencyId,
                SenderName = CreatedHawala.SenderName,
                SenderFatherName = CreatedHawala.SenderFatherName,
                SenderPhone = CreatedHawala.SenderPhone,
                SenderTazkiraNumber = CreatedHawala.SenderTazkiraNumber,
                SenderAddress = CreatedHawala.SenderAddress,
                ReceiverName = CreatedHawala.ReceiverName,
                ReceiverFatherName = CreatedHawala.ReceiverFatherName,
                ReceiverPhone = CreatedHawala.ReceiverPhone,
                ReceiverTazkiraNumber = CreatedHawala.ReceiverTazkiraNumber,
                ReceiverAddress = CreatedHawala.ReceiverAddress,
                ReferenceNumber = CreatedHawala.ReferenceNumber,
                Notes = CreatedHawala.Notes,
                PaymentLocationId = CreatedHawala.PaymentLocationId,
                FromAccountId = CreatedHawala.FromAccountId,
                Number = 0,
                Status = "Pending"
            };

            // ===== 2. بستن مودال موفقیت =====
            ShowSuccessModal = false;
            CreatedHawala = null;

            // ===== 3. بستن کامل مودال ایجاد (با notify به والد) =====
            IsVisible = false;
            await IsVisibleChanged.InvokeAsync(false);
            StateHasChanged();

            // ===== 4. انتظار برای بسته شدن کامل مودال =====
            await Task.Delay(300);

            // ===== 5. ریست کردن همه چیز =====
            fromAccountSearchText = "";
            showFromAccountDropdown = false;
            CalculationMode = "RateToAmount";
            ValidationErrors.Clear();
            SuccessMessage = string.Empty;

            // ===== 6. تنظیم داده‌های جدید =====
            CurrentHawala = hawalaToCopy;

            // ===== 7. دریافت شماره پیشنهادی =====
            if (CurrentHawala.CorrespondentId.HasValue && !string.IsNullOrEmpty(CurrentHawala.HawalaType))
            {
                var nextNumber = await HawalaService.GetNextNumberAsync(
                    CurrentHawala.CorrespondentId.Value,
                    CurrentHawala.HawalaType);
                CurrentHawala.Number = nextNumber > 0 ? nextNumber : 1;
            }

            // ===== 8. باز کردن مودال =====
            IsVisible = true;
            await IsVisibleChanged.InvokeAsync(true);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطا در تکرار عملیات: {ex.Message}");
        }
    }

    private void GoToHawalaDetails()
    {
        if (CreatedHawala == null)
        {
            return;
        }

        // ذخیره شماره حواله
        var number = CreatedHawala.Number;

        // بستن مودال موفقیت (داده‌ها باقی می‌مانند)
        ShowSuccessModal = false;
        StateHasChanged();

        // هدایت به صفحه جزئیات حواله
        NavigationManager.NavigateTo($"/hawala-transactions?view={number}");
    }

    private string GetCorrespondentName(long? correspondentId)
    {
        if (!correspondentId.HasValue) return "-";
        var correspondent = CorrespondentsList.FirstOrDefault(c => c.Id == correspondentId.Value);
        return correspondent?.Name ?? "-";
    }

    private string GetHawalaTypeName(string type)
    {
        return type switch
        {
            "HawalaSend" => "حواله ارسال",
            "HawalaReceive" => "حواله دریافت",
            "HawalaOther" => "حواله متفرقه",
            _ => type
        };
    }

    private string GetCurrencyCode(long? currencyId)
    {
        if (!currencyId.HasValue) return "-";
        var currency = CurrenciesList.FirstOrDefault(c => c.Id == currencyId.Value);
        return currency?.Code ?? "-";
    }

    private string GetPaymentLocationName(long? paymentLocationId)
    {
        if (!paymentLocationId.HasValue) return "-";
        var location = PaymentLocationsList.FirstOrDefault(l => l.Id == paymentLocationId.Value);
        return location?.Name ?? "-";
    }

