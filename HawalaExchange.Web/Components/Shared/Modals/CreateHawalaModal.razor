    private void ResetHawala()
    {
        CurrentHawala = new CreateHawalaDto
        {
            Status = "Pending",
            FromCurrencyId = AfnCurrencyId,
            ToCurrencyId = AfnCurrencyId,
            CommissionCurrencyId = AfnCurrencyId,
            AgentCommissionCurrencyId = AfnCurrencyId,
            HawalaType = "",
            Number = 0
        };
        CalculationMode = "RateToAmount";
        fromAccountSearchText = "";
