                .receipt-full {{
                    grid-column: 1 / -1;
                }}
                .receipt-signatures {{
                    display: flex;
                    justify-content: space-between;
                    margin-top: 50px;
                    padding: 0 20px;
                }}
                .receipt-signatures div {{
                    width: 160px;
                    border-top: 1px solid #111827;
                    text-align: center;
                    padding-top: 7px;
                    font-size: 13px;
                }}
                .receipt-footer {{
                    text-align: center;
                    color: #6b7280;
                    margin-top: 22px;
