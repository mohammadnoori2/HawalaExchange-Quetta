                }}
                .receipt-label {{
                    font-weight: bold;
                    color: #555;
                }}
                .receipt-value {{
                    color: #000;
                }}
                .receipt-amount {{
                    font-weight: bold;
                    color: #2563eb;
                }}
                .receipt-currency {{
                    font-weight: bold;
                    color: #6b7280;
                }}
                .receipt-badge {{
                    display: inline-block;
                    padding: 2px 12px;
                    border-radius: 12px;
