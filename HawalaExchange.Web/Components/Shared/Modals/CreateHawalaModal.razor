                    color: #1e40af;
                }}
                .receipt-badge-secondary {{
                    background: #e5e7eb;
                    color: #374151;
                }}
                @media print {{
                    body {{ margin: 0; padding: 10px; }}
                    .receipt-container {{ border: none; box-shadow: none; }}
                    .receipt-signatures div {{ border-top-color: #000; }}
                }}
            </style>
        </head>
        <body>
            <div class='receipt-container'>
