                        <div><span class='receipt-label'>شماره تذکره:</span> <span class='receipt-value'>{(string.IsNullOrEmpty(hawala.ReceiverTazkiraNumber) ? "-" : hawala.ReceiverTazkiraNumber)}</span></div>
                        <div class='receipt-full'><span class='receipt-label'>آدرس:</span> <span class='receipt-value'>{(string.IsNullOrEmpty(hawala.ReceiverAddress) ? "-" : hawala.ReceiverAddress)}</span></div>
