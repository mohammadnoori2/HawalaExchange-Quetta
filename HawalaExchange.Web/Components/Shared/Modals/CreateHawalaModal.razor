                    gap: 14px;
                }}
                .receipt-company-info h4 {{
                    margin: 0;
                    color: #111827;
                }}
                .receipt-company-info .receipt-muted {{
                    color: #6b7280;
                    font-size: 13px;
                }}
                .receipt-title-box {{
                    text-align: center;
                    border: 1px solid #d1d5db;
                    border-radius: 12px;
                    padding: 10px 18px;
                    min-width: 160px;
                }}
                .receipt-title-box h5 {{
                    margin: 0 0 8px 0;
                    color: #2563eb;
                    font-weight: 700;
                }}
                .receipt-title-box div {{
                    font-size: 14px;
                }}
                .receipt-divider {{
                    border: none;
                    border-top: 1px solid #e5e7eb;
                    margin: 15px 0;
                }}
                .receipt-status-row {{
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 10px;
                    margin-bottom: 16px;
                    background: #f9fafb;
                    padding: 10px;
                    border-radius: 8px;
                }}
                .receipt-status-row div {{
                    font-size: 13px;
                }}
                .receipt-section {{
                    margin-top: 16px;
                }}
                .receipt-section h6 {{
                    color: #2563eb;
                    font-weight: 700;
                    border-bottom: 1px solid #e5e7eb;
                    padding-bottom: 6px;
                    margin: 0 0 10px 0;
                }}
                .receipt-grid {{
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 8px 18px;
                }}
                .receipt-grid div {{
                    font-size: 14px;
