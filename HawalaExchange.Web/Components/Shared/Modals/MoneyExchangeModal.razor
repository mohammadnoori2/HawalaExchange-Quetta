@* Components/Shared/Modals/MoneyExchangeModal.razor *@
@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services
@using HawalaExchange.Application.Services
@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Components.Forms

@inject IMoneyExchangeOperationService MoneyExchangeOperationService
@inject ICurrencyService CurrencyService
@inject IAccountService AccountService

@if (IsVisible)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(IsEditMode ? "ویرایش تبدیل پول" : "ثبت تبدیل پول جدید")
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    @if (ValidationErrors.Any())
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <h6 class="alert-heading">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                لطفاً خطاهای زیر را اصلاح کنید:
                            </h6>

                            <ul class="mb-0">
                                @foreach (var error in ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i>
                            @SuccessMessage
                        </div>
                    }

                    @if (IsDataLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">در حال بارگذاری...</span>
                            </div>
                            <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
                        </div>
                    }
                    else
                    {
                        <div class="modern-card mb-4">
                            <div class="card-header">
                                <h6 class="text-primary">
                                    <i class="bi bi-currency-exchange me-2"></i>
                                    اطلاعات تبدیل
                                </h6>
                            </div>

                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">مالک پول</label>
                                        <select class="form-select"
                                                value="@CurrentExchange.OperationType"
                                                @onchange="OnOperationTypeChanged">
                                            <option value="Treasury">سرمایه خود صراف</option>
                                            <option value="Customer">پول مشتری</option>
                                        </select>
                                        <small class="text-muted">پول مشتری وارد موجودی و مفاد سرمایه صراف نمی‌شود.</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">ارز محاسبه مفاد <span class="text-danger">*</span></label>
                                        <select class="form-select" @bind="CurrentExchange.ProfitCurrencyId">
                                            <option value="0">انتخاب ارز</option>
                                            @foreach (var currency in CurrenciesList)
                                            {
                                                <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">روش محاسبه مبلغ</label>
                                        <div class="alert alert-light border mb-0 py-2">
                                            یکی از دو مبلغ و نرخ را وارد کنید؛ مبلغ مقابل بر اساس جهت canonical جفت‌ارز محاسبه می‌شود.
                                        </div>
                                    </div>

                                    <div class="col-md-6 mt-3">
                                        <label class="form-label fw-bold">تاریخ و زمان تبدیل</label>

                                        <PersianDatePicker @bind-Value="ExchangeDateLocal"
                                                           IncludeTime="true"
                                                           Placeholder="انتخاب تاریخ شمسی" />
                                    </div>

                                    <div class="col-md-6 mt-3">
                                        <label class="form-label fw-bold">توضیحات</label>
                                        <input type="text"
                                               class="form-control"
                                               @bind="CurrentExchange.Description"
                                               placeholder="مثلاً تبدیل افغانی به دالر" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100">
                                            <h6 class="text-danger mb-3">
                                                <i class="bi bi-arrow-up-circle"></i>
                                                بخش پرداختی
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">
                                                    حساب پرداخت‌کننده <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select" @bind="CurrentExchange.FromAccountId">
                                                    <option value="0">انتخاب حساب</option>
                                                    @if (AccountsList != null && AccountsList.Any())
                                                    {
                                                        @foreach (var account in AvailableAccounts)
                                                        {
                                                            <option value="@account.Id">
                                                                @account.AccountName (@account.AccountCode - @GetAccountTypeName(account.AccountType))
                                                            </option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="0" disabled>هیچ حسابی یافت نشد</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">
                                                    ارز پرداختی <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select"
                                                        value="@CurrentExchange.FromCurrencyId"
                                                        @onchange="OnFromCurrencyChanged">
                                                    <option value="0">انتخاب ارز</option>
                                                    @if (CurrenciesList != null && CurrenciesList.Any())
                                                    {
                                                        @foreach (var currency in CurrenciesList)
                                                        {
                                                            <option value="@currency.Id">
                                                                @currency.Code - @currency.Name
                                                            </option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="0" disabled>هیچ ارزی یافت نشد</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-0">
                                                <label class="form-label fw-bold">
                                                    مبلغ پرداختی <span class="text-danger">*</span>
                                                </label>

                                                <MoneyInput class="form-control"
                                                            Value="CurrentExchange.FromAmount"
                                                            ValueChanged="OnFromAmountChanged"
                                                            placeholder="مثلاً 7,000" />
                                                <small class="text-muted">با ویرایش این مبلغ، مبلغ دریافتی خودکار به‌روزرسانی می‌شود.</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="border rounded p-3 h-100">
                                            <h6 class="text-success mb-3">
                                                <i class="bi bi-arrow-down-circle"></i>
                                                بخش دریافتی
                                            </h6>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">
                                                    حساب دریافت‌کننده <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select" @bind="CurrentExchange.ToAccountId">
                                                    <option value="0">انتخاب حساب</option>
                                                    @if (AccountsList != null && AccountsList.Any())
                                                    {
                                                        @foreach (var account in AvailableAccounts)
                                                        {
                                                            <option value="@account.Id">
                                                                @account.AccountName (@account.AccountCode - @GetAccountTypeName(account.AccountType))
                                                            </option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="0" disabled>هیچ حسابی یافت نشد</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">
                                                    ارز دریافتی <span class="text-danger">*</span>
                                                </label>

                                                <select class="form-select"
                                                        value="@CurrentExchange.ToCurrencyId"
                                                        @onchange="OnToCurrencyChanged">
                                                    <option value="0">انتخاب ارز</option>
                                                    @if (CurrenciesList != null && CurrenciesList.Any())
                                                    {
                                                        @foreach (var currency in CurrenciesList)
                                                        {
                                                            <option value="@currency.Id">
                                                                @currency.Code - @currency.Name
                                                            </option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="0" disabled>هیچ ارزی یافت نشد</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-0">
                                                <label class="form-label fw-bold">
                                                    مبلغ دریافتی <span class="text-danger">*</span>
                                                </label>

                                                <MoneyInput class="form-control"
                                                            Value="CurrentExchange.ToAmount"
                                                            ValueChanged="OnToAmountChanged"
                                                            placeholder="مثلاً 100" />
                                                <small class="text-muted">با ویرایش این مبلغ، مبلغ پرداختی خودکار به‌روزرسانی می‌شود.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">
                                            نرخ تبدیل <span class="text-danger">*</span>
                                        </label>

                                        <MoneyInput class="form-control"
                                                    DecimalPlaces="8"
                                                    Value="CurrentExchange.ExchangeRate"
                                                    ValueChanged="OnExchangeRateChanged"
                                                    placeholder="مثلاً 84" />
                                        <small class="text-muted">@RateMeaning</small>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">کمیسیون (ارز مفاد)</label>
                                        <MoneyInput class="form-control"
                                                    @bind-Value="CurrentExchange.CommissionAmount"
                                                    placeholder="0" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">هزینه خارجی (ارز مفاد)</label>
                                        <MoneyInput class="form-control"
                                                    @bind-Value="CurrentExchange.ExternalFeeAmount"
                                                    placeholder="0" />
                                    </div>
                                    <div class="col-12">
                                        <div class="alert alert-info mb-0 mt-md-4">
                                            <strong>سند حسابداری:</strong>
                                            <div class="mt-2">
                                                حساب دریافت‌کننده بدهکار می‌شود و حساب پرداخت‌کننده طلبکار می‌شود.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (IsEditMode)
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i>
                                <small>
                                    در حال ویرایش تبدیل با شناسه:
                                    <strong>@EditId</strong>
                                </small>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-modern btn-light-modern"
                            @onclick="CloseModal">
                        <i class="bi bi-x-circle"></i>
                        انصراف
                    </button>

                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            @onclick="SaveExchange"
                            disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi @(IsEditMode ? "bi-pencil" : "bi-save")"></i>
                        }

                        @(IsEditMode ? "به‌روزرسانی" : "ایجاد")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ===== پارامترها =====
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool IsEditMode { get; set; } = false;
    [Parameter] public long EditId { get; set; } = 0;
    [Parameter] public CreateMoneyExchangeOperationDto? EditData { get; set; }
    [Parameter] public EventCallback<CreateMoneyExchangeOperationDto> OnSaveSuccess { get; set; }
    [Parameter] public EventCallback<long> OnEditSuccess { get; set; }

    // ===== متغیرها =====
    private CreateMoneyExchangeOperationDto CurrentExchange { get; set; } = new();
    private List<CurrencyDto> CurrenciesList { get; set; } = new();
    private List<AccountDto> AccountsList { get; set; } = new();
    private IEnumerable<AccountDto> AvailableAccounts =>
        CurrentExchange.OperationType == "Customer"
            ? AccountsList.Where(x => x.AccountType == "Customer")
            : AccountsList.Where(x => x.AccountType is "Cash" or "Bank");

    private List<string> ValidationErrors { get; set; } = new();
    private string SuccessMessage { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = false;
    private bool IsDataLoading { get; set; } = true;

    private DateTime ExchangeDateLocal { get; set; } = DateTime.Now;
    private AmountInputSource LastEditedAmount { get; set; } = AmountInputSource.From;

    // ===== متدهای چرخه حیات =====

    private bool wasVisible;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible)
        {
            wasVisible = false;
            return;
        }

        if (wasVisible)
        {
            return;
        }

        wasVisible = true;

        if (!CurrenciesList.Any() || !AccountsList.Any())
        {
            await LoadLookupData();
        }

        if (IsEditMode && EditData != null)
        {
            LastEditedAmount = AmountInputSource.From;
            CurrentExchange = new CreateMoneyExchangeOperationDto
            {
                ExchangeDate = EditData.ExchangeDate,
                FromAccountId = EditData.FromAccountId,
                FromCurrencyId = EditData.FromCurrencyId,
                FromAmount = EditData.FromAmount,
                ToAccountId = EditData.ToAccountId,
                ToCurrencyId = EditData.ToCurrencyId,
                ToAmount = EditData.ToAmount,
                ExchangeRate = EditData.ExchangeRate,
                OperationType = EditData.OperationType,
                ProfitCurrencyId = EditData.ProfitCurrencyId,
                CommissionAmount = EditData.CommissionAmount,
                ExternalFeeAmount = EditData.ExternalFeeAmount,
                Description = EditData.Description
            };

            ExchangeDateLocal = EditData.ExchangeDate.ToLocalTime();
            CalculateCounterAmount();
        }
        else if (!IsEditMode)
        {
            ResetExchange();
        }

        ValidationErrors.Clear();
        SuccessMessage = string.Empty;
        StateHasChanged();
    }

    // ===== متدهای بارگذاری =====

    private async Task LoadLookupData()
    {
        try
        {
            IsDataLoading = true;
            StateHasChanged();

            CurrenciesList = (await CurrencyService.GetActiveCurrenciesAsync()).ToList();
            AccountsList = (await AccountService.GetAllAsync())
                .Where(x => !x.IsArchived)
                .OrderBy(x => x.AccountCode)
                .ToList();

            IsDataLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            IsDataLoading = false;
            ValidationErrors.Add($"خطا در بارگذاری داده‌های کمکی: {ex.Message}");
            StateHasChanged();
        }
    }

    // ===== متدهای اصلی =====

    private void ResetExchange()
    {
        var afn = CurrenciesList.FirstOrDefault(x =>
            x.Code.Equals("AFN", StringComparison.OrdinalIgnoreCase));

        var usd = CurrenciesList.FirstOrDefault(x =>
            x.Code.Equals("USD", StringComparison.OrdinalIgnoreCase));

        var cash = AccountsList.FirstOrDefault(x =>
            x.AccountType == "Cash");

        CurrentExchange = new CreateMoneyExchangeOperationDto
        {
            FromAccountId = cash?.Id ?? 0,
            ToAccountId = cash?.Id ?? 0,
            FromCurrencyId = afn?.Id ?? 0,
            ToCurrencyId = usd?.Id ?? 0,
            FromAmount = 0,
            ToAmount = 0,
            ExchangeRate = 0,
            OperationType = "Treasury",
            ProfitCurrencyId = afn?.Id ?? 0,
            CommissionAmount = 0,
            ExternalFeeAmount = 0,
            ExchangeDate = DateTime.UtcNow,
            Description = "ثبت تبدیل پول"
        };

        LastEditedAmount = AmountInputSource.From;
        ExchangeDateLocal = DateTime.Now;
    }

    private async Task CloseModal()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        ValidationErrors.Clear();
        SuccessMessage = string.Empty;
        StateHasChanged();
    }

    private async Task SaveExchange()
    {
        ValidationErrors.Clear();
        SuccessMessage = string.Empty;

        CalculateCounterAmount();
        ValidateForm();

        if (ValidationErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            IsLoading = true;
            StateHasChanged();

            CurrentExchange.ExchangeDate = ExchangeDateLocal.ToUniversalTime();

            if (IsEditMode)
            {
                var updateDto = new UpdateMoneyExchangeOperationDto
                {
                    ExchangeDate = CurrentExchange.ExchangeDate,
                    FromAccountId = CurrentExchange.FromAccountId,
                    FromCurrencyId = CurrentExchange.FromCurrencyId,
                    FromAmount = CurrentExchange.FromAmount,
                    ToAccountId = CurrentExchange.ToAccountId,
                    ToCurrencyId = CurrentExchange.ToCurrencyId,
                    ToAmount = CurrentExchange.ToAmount,
                    ExchangeRate = CurrentExchange.ExchangeRate,
                    OperationType = CurrentExchange.OperationType,
                    ProfitCurrencyId = CurrentExchange.ProfitCurrencyId,
                    CommissionAmount = CurrentExchange.CommissionAmount,
                    ExternalFeeAmount = CurrentExchange.ExternalFeeAmount,
                    Description = CurrentExchange.Description
                };

                await MoneyExchangeOperationService.UpdateAsync(EditId, updateDto);
                SuccessMessage = "تبدیل پول با موفقیت ویرایش شد.";
                await OnEditSuccess.InvokeAsync(EditId);
            }
            else
            {
                await MoneyExchangeOperationService.CreateAsync(CurrentExchange);
                SuccessMessage = "تبدیل پول با موفقیت ثبت شد.";
                await OnSaveSuccess.InvokeAsync(CurrentExchange);
            }

            await Task.Delay(1500);
            await CloseModal();
        }
        catch (InvalidOperationException ex)
        {
            ValidationErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در ذخیره‌سازی: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void ValidateForm()
    {
        if (CurrentExchange.FromAccountId <= 0)
            ValidationErrors.Add("انتخاب حساب پرداخت‌کننده الزامی است.");

        if (CurrentExchange.ToAccountId <= 0)
            ValidationErrors.Add("انتخاب حساب دریافت‌کننده الزامی است.");

        if (CurrentExchange.FromCurrencyId <= 0)
            ValidationErrors.Add("انتخاب ارز پرداختی الزامی است.");

        if (CurrentExchange.ToCurrencyId <= 0)
            ValidationErrors.Add("انتخاب ارز دریافتی الزامی است.");

        if (CurrentExchange.FromCurrencyId == CurrentExchange.ToCurrencyId)
            ValidationErrors.Add("ارز پرداختی و ارز دریافتی نباید یکی باشد.");

        if (CurrentExchange.FromAmount <= 0)
            ValidationErrors.Add("مبلغ پرداختی باید بزرگتر از صفر باشد.");

        if (CurrentExchange.ToAmount <= 0)
            ValidationErrors.Add("مبلغ دریافتی باید بزرگتر از صفر باشد.");

        if (CurrentExchange.ExchangeRate <= 0)
            ValidationErrors.Add("نرخ تبدیل باید بزرگتر از صفر باشد.");

        if (CurrentExchange.OperationType == "Customer" &&
            CurrentExchange.FromAccountId != CurrentExchange.ToAccountId)
            ValidationErrors.Add("برای پول مشتری، حساب پرداخت‌کننده و دریافت‌کننده باید همان حساب مشتری باشد.");

        if (CurrentExchange.ProfitCurrencyId <= 0)
            ValidationErrors.Add("انتخاب ارز محاسبه مفاد الزامی است.");

        if (CurrentExchange.CommissionAmount < 0 || CurrentExchange.ExternalFeeAmount < 0)
            ValidationErrors.Add("کمیسیون و هزینه خارجی نمی‌تواند منفی باشد.");
    }

    // ===== متدهای محاسبه =====

    private void OnOperationTypeChanged(ChangeEventArgs args)
    {
        CurrentExchange.OperationType = args.Value?.ToString() ?? "Treasury";
        var account = AvailableAccounts.FirstOrDefault();
        CurrentExchange.FromAccountId = account?.Id ?? 0;
        CurrentExchange.ToAccountId = account?.Id ?? 0;
    }

    private void OnFromAmountChanged(decimal amount)
    {
        if (CurrentExchange.FromAmount == amount)
            return;

        LastEditedAmount = AmountInputSource.From;
        CurrentExchange.FromAmount = amount;
        CalculateCounterAmount();
        StateHasChanged();
    }

    private void OnToAmountChanged(decimal amount)
    {
        if (CurrentExchange.ToAmount == amount)
            return;

        LastEditedAmount = AmountInputSource.To;
        CurrentExchange.ToAmount = amount;
        CalculateCounterAmount();
        StateHasChanged();
    }

    private void OnExchangeRateChanged(decimal rate)
    {
        CurrentExchange.ExchangeRate = rate;
        CalculateCounterAmount();
        StateHasChanged();
    }

    private void OnFromCurrencyChanged(ChangeEventArgs args)
    {
        CurrentExchange.FromCurrencyId = long.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        CalculateCounterAmount();
    }

    private void OnToCurrencyChanged(ChangeEventArgs args)
    {
        CurrentExchange.ToCurrencyId = long.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        CalculateCounterAmount();
    }

    private string RateMeaning { get; set; } = "پس از انتخاب ارزها و ورود نرخ نمایش داده می‌شود.";

    private void CalculateCounterAmount()
    {
        var from = CurrenciesList.FirstOrDefault(x => x.Id == CurrentExchange.FromCurrencyId);
        var to = CurrenciesList.FirstOrDefault(x => x.Id == CurrentExchange.ToCurrencyId);
        if (from == null || to == null || from.Id == to.Id || CurrentExchange.ExchangeRate <= 0)
        {
            ClearCalculatedAmount();
            RateMeaning = "پس از انتخاب ارزها و ورود یکی از مبلغ‌ها و نرخ نمایش داده می‌شود.";
            return;
        }

        CurrencyConversionResult result;

        if (LastEditedAmount == AmountInputSource.From)
        {
            if (CurrentExchange.FromAmount <= 0)
            {
                CurrentExchange.ToAmount = 0;
                return;
            }

            result = CurrencyQuotationCalculator.ConvertFromAmount(
                from.Id, from.Code, from.QuotationPriority, CurrentExchange.FromAmount,
                to.Id, to.Code, to.QuotationPriority, CurrentExchange.ExchangeRate);
            CurrentExchange.ToAmount = Math.Round(result.ToAmount, to.DecimalPlaces);
        }
        else
        {
            if (CurrentExchange.ToAmount <= 0)
            {
                CurrentExchange.FromAmount = 0;
                return;
            }

            result = CurrencyQuotationCalculator.ConvertFromAmount(
                to.Id, to.Code, to.QuotationPriority, CurrentExchange.ToAmount,
                from.Id, from.Code, from.QuotationPriority, CurrentExchange.ExchangeRate);
            CurrentExchange.FromAmount = Math.Round(result.ToAmount, from.DecimalPlaces);
        }

        RateMeaning = $"1 {result.BaseCurrencyCode} = {CurrentExchange.ExchangeRate:N8} {result.QuoteCurrencyCode}";
    }

    private void ClearCalculatedAmount()
    {
        if (LastEditedAmount == AmountInputSource.From)
            CurrentExchange.ToAmount = 0;
        else
            CurrentExchange.FromAmount = 0;
    }

    private enum AmountInputSource
    {
        From,
        To
    }

    // ===== توابع کمکی =====

    private string GetAccountTypeName(string? type)
    {
        return type?.ToLower() switch
        {
            "cash" => "نقدی",
            "bank" => "بانک",
            "customer" => "مشتری",
            "correspondent" => "نماینده",
            "income" => "درآمد",
            "expense" => "مصرف",
