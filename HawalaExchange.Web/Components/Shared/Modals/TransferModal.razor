@using HawalaExchange.Application.DTOs
@using HawalaExchange.Application.Interfaces.Services

@inject ITransferService TransferService
@inject IAccountService AccountService
@inject ICurrencyService CurrencyService
@inject ICompanySettingService CompanySettingService

@if (IsVisible)
{
    <div class="modal show d-block modal-modern"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.55); backdrop-filter: blur(4px);"
         dir="rtl">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content transfer-entry-modal">
                <div class="modal-header gradient">
                    <h5 class="modal-title text-white">
                        <i class="bi @(IsEditMode ? "bi-pencil-square" : "bi-arrow-left-right") me-2"></i>
                        @(IsEditMode ? "ویرایش انتقال بین حساب‌ها" : "انتقال جدید بین حساب‌ها")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAsync"></button>
                </div>

                <div class="modal-body">
                    @if (ValidationErrors.Count > 0)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ValidationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (IsDataLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">حساب مبدأ <span class="text-danger">*</span></label>
                                 <AccountSearchSelect Accounts="@Accounts"
                                                      @bind-Value="CurrentTransfer.FromAccountId"
                                                      ShowAccountCode="false"
                                                      Placeholder="جستجوی حساب مبدأ..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">حساب مقصد <span class="text-danger">*</span></label>
                                 <AccountSearchSelect Accounts="@Accounts"
                                                      @bind-Value="CurrentTransfer.ToAccountId"
                                                      ShowAccountCode="false"
                                                      Placeholder="جستجوی حساب مقصد..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">ارز <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="CurrentTransfer.CurrencyId">
                                    <option value="0">انتخاب ارز</option>
                                    @foreach (var currency in Currencies)
                                    {
                                        <option value="@currency.Id">@currency.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">مبلغ <span class="text-danger">*</span></label>
                                <MoneyInput class="form-control"
                                            @bind-Value="CurrentTransfer.Amount"
                                            placeholder="مبلغ انتقال" />
                            </div>
                            @if (RequiresCostBasis)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">
                                        ارزش انتقالی در ارز اصلی <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" min="0" step="0.0001" class="form-control" dir="ltr"
                                           @bind="CurrentTransfer.ProfitCurrencyAmount"
                                           placeholder="بهای تمام‌شده مجموع ارز انتقالی" />
                                    <div class="form-text">
                                        بهای تاریخی این ارز را وارد کنید؛ انتقال به صندوق به خودی خود مفاد ایجاد نمی‌کند.
                                        @if (TransferCostRate is > 0)
                                        {
                                            <span> نرخ بهای واحد: @MoneyFormatHelper.Format(TransferCostRate.Value) در ارز اصلی</span>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <label class="form-label fw-bold">روش انتقال <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="CurrentTransfer.TransferMethod">
                                    <option value="">انتخاب روش</option>
                                    <option value="Cash">نقدی</option>
                                    <option value="Bank">بانکی</option>
                                    <option value="Hawala">حواله</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">توضیحات</label>
                                <textarea class="form-control" rows="2" @bind="CurrentTransfer.Remarks"></textarea>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-modern btn-light-modern" @onclick="CloseAsync">
                        <i class="bi bi-x-circle"></i> انصراف
                    </button>
                    <button type="button"
                            class="btn-modern btn-primary-modern"
                            disabled="@(IsLoading || IsDataLoading)"
                            @onclick="SaveAsync">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-save"></i>
                        }
                        ذخیره
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public long EditId { get; set; }
    [Parameter] public CreateTransferDto? EditData { get; set; }
    [Parameter] public long? InitialAccountId { get; set; }
    [Parameter] public EventCallback<CreateTransferDto> OnSaveSuccess { get; set; }
    [Parameter] public EventCallback<long> OnEditSuccess { get; set; }

    private CreateTransferDto CurrentTransfer { get; set; } = new();
    private List<AccountDto> Accounts { get; set; } = new();
    private List<CurrencyDto> Currencies { get; set; } = new();
    private List<string> ValidationErrors { get; } = new();
    private bool IsLoading;
    private bool IsDataLoading = true;
    private bool wasVisible;
    private long? DefaultProfitCurrencyId;

    private bool RequiresCostBasis
    {
        get
        {
            var from = Accounts.FirstOrDefault(x => x.Id == CurrentTransfer.FromAccountId);
            var to = Accounts.FirstOrDefault(x => x.Id == CurrentTransfer.ToAccountId);
            return IsCorrespondent(from) && !IsCorrespondent(to) &&
                   DefaultProfitCurrencyId.HasValue &&
                   CurrentTransfer.CurrencyId > 0 &&
                   CurrentTransfer.CurrencyId != DefaultProfitCurrencyId.Value;
        }
    }

    private decimal? TransferCostRate => CurrentTransfer.Amount > 0 && CurrentTransfer.ProfitCurrencyAmount is > 0
        ? CurrentTransfer.ProfitCurrencyAmount.Value / CurrentTransfer.Amount
        : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible)
        {
            wasVisible = false;
            return;
        }

        if (wasVisible)
            return;

        wasVisible = true;
        ValidationErrors.Clear();
        await LoadLookupsAsync();

        if (IsEditMode && EditData != null)
        {
            CurrentTransfer = new CreateTransferDto
            {
                FromAccountId = EditData.FromAccountId,
                ToAccountId = EditData.ToAccountId,
                CurrencyId = EditData.CurrencyId,
                Amount = EditData.Amount,
                ProfitCurrencyId = EditData.ProfitCurrencyId ?? DefaultProfitCurrencyId,
                ProfitCurrencyAmount = EditData.ProfitCurrencyAmount,
                TransferMethod = EditData.TransferMethod,
                ReferenceNumber = EditData.ReferenceNumber,
                Remarks = EditData.Remarks
            };
        }
        else
        {
            CurrentTransfer = new CreateTransferDto
            {
                FromAccountId = InitialAccountId ?? 0,
                ProfitCurrencyId = DefaultProfitCurrencyId,
                TransferMethod = "Cash"
            };
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            IsDataLoading = true;
            Accounts = (await AccountService.GetAllAsync())
                .Where(x => !x.IsArchived)
                .OrderBy(x => x.AccountCode)
                .ToList();
            Currencies = (await CurrencyService.GetActiveCurrenciesAsync())
                .OrderBy(x => x.Code)
                .ToList();
            var setting = await CompanySettingService.GetAsync();
            DefaultProfitCurrencyId = setting.DefaultProfitCurrencyId;
        }
        catch (Exception ex)
        {
            ValidationErrors.Add($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            IsDataLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        ValidationErrors.Clear();
        Validate();
        if (ValidationErrors.Count > 0)
            return;

        try
        {
            IsLoading = true;
            if (IsEditMode)
            {
                await TransferService.UpdateTransferAsync(EditId, new UpdateTransferDto
                {
                    FromAccountId = CurrentTransfer.FromAccountId,
                    ToAccountId = CurrentTransfer.ToAccountId,
                    CurrencyId = CurrentTransfer.CurrencyId,
                    Amount = CurrentTransfer.Amount,
                    ProfitCurrencyId = CurrentTransfer.ProfitCurrencyId ?? DefaultProfitCurrencyId,
                    ProfitCurrencyAmount = RequiresCostBasis ? CurrentTransfer.ProfitCurrencyAmount : null,
                    TransferMethod = CurrentTransfer.TransferMethod,
                    ReferenceNumber = CurrentTransfer.ReferenceNumber,
                    Remarks = CurrentTransfer.Remarks
                });
                await OnEditSuccess.InvokeAsync(EditId);
            }
            else
            {
                await TransferService.CreateTransferAsync(CurrentTransfer);
                await OnSaveSuccess.InvokeAsync(CurrentTransfer);
            }

            await CloseAsync();
        }
        catch (Exception ex)
        {
            ValidationErrors.Add(ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Validate()
    {
        if (CurrentTransfer.FromAccountId <= 0)
            ValidationErrors.Add("انتخاب حساب مبدأ الزامی است.");
        if (CurrentTransfer.ToAccountId <= 0)
            ValidationErrors.Add("انتخاب حساب مقصد الزامی است.");
        if (CurrentTransfer.FromAccountId == CurrentTransfer.ToAccountId)
            ValidationErrors.Add("حساب مبدأ و مقصد نمی‌توانند یکسان باشند.");
        if (CurrentTransfer.CurrencyId <= 0)
            ValidationErrors.Add("انتخاب ارز الزامی است.");
        if (CurrentTransfer.Amount <= 0)
            ValidationErrors.Add("مبلغ باید بزرگتر از صفر باشد.");
        if (RequiresCostBasis && CurrentTransfer.ProfitCurrencyAmount is not > 0)
            ValidationErrors.Add("ارزش انتقالی در ارز اصلی الزامی است.");
        if (string.IsNullOrWhiteSpace(CurrentTransfer.TransferMethod))
            ValidationErrors.Add("انتخاب روش انتقال الزامی است.");
    }

    private static bool IsCorrespondent(AccountDto? account) =>
        account != null && (string.Equals(account.AccountType, "Correspondent", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(account.ReferenceType, "Correspondent", StringComparison.OrdinalIgnoreCase));

    private async Task CloseAsync()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }
}
