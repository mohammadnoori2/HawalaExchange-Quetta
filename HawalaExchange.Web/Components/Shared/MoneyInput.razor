@using HawalaExchange.Web.Helpers
@using Microsoft.AspNetCore.Components
@namespace HawalaExchange.Web.Components.Shared
@inherits ComponentBase

<input @attributes="AdditionalAttributes" type="text" value="@initialDisplayValue" inputmode="decimal" dir="ltr" lang="en"
       data-money-input data-money-value="@displayValue" data-money-decimals="@DecimalPlaces"
       data-money-nullable="false" data-money-revision="@revision" @onchange="HandleChange" />

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public int DecimalPlaces { get; set; } = 0;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string displayValue = string.Empty;
    private string? initialDisplayValue;
    private long revision;

    protected override void OnParametersSet()
    {
        displayValue = MoneyFormatHelper.Format(Value, DecimalPlaces);
        initialDisplayValue ??= displayValue;
    }

    private async Task HandleChange(ChangeEventArgs args)
    {
        revision++;
        var text = args.Value?.ToString();
        decimal value;
        if (string.IsNullOrWhiteSpace(text) || text is "-" or "." or "-.") value = 0;
        else if (!MoneyFormatHelper.TryParse(text, out value))
        {
            displayValue = MoneyFormatHelper.Format(Value, DecimalPlaces);
            return;
        }
        value = DecimalPlaces == 0 ? HawalaExchange.Application.Services.AmountValueHelper.RoundConvertedAmount(value) : value;
        displayValue = MoneyFormatHelper.Format(value, DecimalPlaces);
        await ValueChanged.InvokeAsync(value);
    }
}
