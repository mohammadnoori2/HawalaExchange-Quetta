@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using HawalaExchange.Infrastructure.Data
@using HawalaExchange.Web.Services
@namespace HawalaExchange.Web.Components.Shared
@inherits HawalaExchange.Web.Components.DateAwareComponent
@inject ApplicationDbContext Context
@inject UiReferenceDataCache ReferenceData

<div class="d-flex justify-content-end align-items-center gap-2 mb-2" dir="rtl">
    <button type="button" class="btn-modern btn-light-modern" disabled="@(busy || Disabled)" @onclick="RefreshAsync" title="خواندن دوباره داده‌ها از دیتابیس؛ بدون بارگذاری مجدد صفحه">
        @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
        else { <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> }
        @(busy ? "در حال بروزرسانی..." : "بروزرسانی")
    </button>
    @if (!string.IsNullOrWhiteSpace(error)) { <span class="text-danger small" role="alert">@error</span> }
</div>

@code {
    [Parameter, EditorRequired] public EventCallback Refresh { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool busy;
    private string error = "";
    private async Task RefreshAsync()
    {
        if (busy || Disabled) return;
        busy = true; error = "";
        try
        {
            // Detach only unchanged cached entities; never discard pending EF edits.
            foreach (var entry in Context.ChangeTracker.Entries().Where(x => x.State == EntityState.Unchanged).ToList())
                entry.State = EntityState.Detached;
            ReferenceData.Invalidate();
            await DisplayDates.ReloadAsync();
            await Refresh.InvokeAsync();
        }
        catch (Exception ex) { error = $"بروزرسانی انجام نشد: {ex.Message}"; }
        finally { busy = false; }
    }
}
