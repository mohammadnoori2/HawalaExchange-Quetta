@using HawalaExchange.Web.Helpers

<input type="text"
       class="@CssClass"
       value="@textValue"
       placeholder="@Placeholder"
       disabled="@Disabled"
       @onchange="OnChanged" />

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <small class="text-danger d-block mt-1">@errorMessage</small>
}

@code {
    [Parameter] public DateTime Value { get; set; }

    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }

    [Parameter] public bool IncludeTime { get; set; } = false;

    [Parameter] public string CssClass { get; set; } = "form-control";

    [Parameter] public string Placeholder { get; set; } = "مثلاً 1405/04/20";

    [Parameter] public bool Disabled { get; set; } = false;

    private string textValue = string.Empty;
    private string errorMessage = string.Empty;

    protected override void OnParametersSet()
    {
        textValue = IncludeTime
            ? PersianDateHelper.ToPersianDateTime(Value)
            : PersianDateHelper.ToPersianDate(Value);
    }

    private async Task OnChanged(ChangeEventArgs e)
    {
        errorMessage = string.Empty;
        textValue = e.Value?.ToString() ?? string.Empty;

        var isValid = IncludeTime
            ? PersianDateHelper.TryParsePersianDateTime(textValue, out var parsedDateTime)
            : PersianDateHelper.TryParsePersianDate(textValue, out parsedDateTime);

        if (!isValid)
        {
            errorMessage = IncludeTime
                ? "تاریخ و زمان معتبر نیست. نمونه: 1405/04/20 14:30"
                : "تاریخ معتبر نیست. نمونه: 1405/04/20";

            return;
        }

        await ValueChanged.InvokeAsync(parsedDateTime);
    }
}