@using System.Globalization
@using HawalaExchange.Web.Helpers

<div class="persian-date-picker-wrapper" dir="rtl">
    <div class="input-group">
        <input type="text"
               id="@Id"
               class="@CssClass"
               value="@displayText"
               placeholder="@Placeholder"
               readonly
               disabled="@Disabled"
               aria-label="@Placeholder"
               @onclick="OpenCalendar" />

        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@Disabled"
                aria-label="باز کردن تقویم شمسی و میلادی"
                @onclick="OpenCalendar">
            <i class="bi bi-calendar3"></i>
        </button>

        @if (AllowEmpty && Value != DateTime.MinValue)
        {
            <button type="button"
                    class="btn btn-outline-secondary"
                    title="پاک کردن تاریخ"
                    disabled="@Disabled"
                    @onclick="ClearDate">
                <i class="bi bi-x-lg"></i>
            </button>
        }
    </div>

    @if (Value != DateTime.MinValue)
    {
        <div class="calendar-date-equivalents" aria-live="polite">
            <span>شمسی: <b dir="ltr">@DualCalendarDateHelper.PersianText(Value, IncludeTime)</b></span>
            <span>میلادی: <b dir="ltr">@DualCalendarDateHelper.GregorianText(Value, IncludeTime)</b></span>
        </div>
    }

    @if (showCalendar)
    {
        <div class="persian-calendar-backdrop" @onclick="CloseCalendar"></div>

        <div class="persian-calendar-modal shadow-lg" dir="rtl" role="dialog" aria-label="انتخاب تاریخ شمسی یا میلادی">
            <div class="calendar-modes" role="group" aria-label="نوع تقویم">
                <button type="button" class="btn btn-sm @(!gregorianMode ? "btn-primary" : "btn-outline-primary")" aria-pressed="@(!gregorianMode)" @onclick="() => ChangeCalendar(false)">شمسی</button>
                <button type="button" class="btn btn-sm @(gregorianMode ? "btn-primary" : "btn-outline-primary")" aria-pressed="@gregorianMode" @onclick="() => ChangeCalendar(true)">میلادی</button>
            </div>
            <div class="calendar-header">
                <button type="button"
                        class="btn btn-sm btn-light"
                        @onclick="PreviousMonth">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <strong>
                    @(gregorianMode ? ViewFirstDay.ToString("MMMM yyyy", CultureInfo.InvariantCulture) : $"{MonthNames[viewMonth - 1]} {viewYear.ToString(CultureInfo.InvariantCulture)}")
                </strong>

                <button type="button"
                        class="btn btn-sm btn-light"
                        @onclick="NextMonth">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <div class="calendar-month-equivalent" dir="ltr">@MonthEquivalent</div>
            <div class="calendar-day-legend">عدد بزرگ: @(gregorianMode ? "میلادی" : "شمسی") · عدد کوچک: @(gregorianMode ? "شمسی" : "میلادی")</div>

            <div class="calendar-weekdays">
                <span>ش</span>
                <span>ی</span>
                <span>د</span>
                <span>س</span>
                <span>چ</span>
                <span>پ</span>
                <span>ج</span>
            </div>

            <div class="calendar-days">
                @foreach (var dayInfo in CalendarDays)
                {
                    if (dayInfo.Day == 0)
                    {
                        <span class="calendar-day empty"></span>
                    }
                    else
                    {
                        <button type="button"
                                class="calendar-day @GetDayCss(dayInfo.Date!.Value)"
                                disabled="@(!IsSelectable(dayInfo.Date!.Value))"
                                title="@($"شمسی {DualCalendarDateHelper.PersianText(dayInfo.Date!.Value)} | میلادی {DualCalendarDateHelper.GregorianText(dayInfo.Date!.Value)}")"
                                @onclick="() => SelectDay(dayInfo.Date!.Value)">
                            <span>@dayInfo.Day.ToString(CultureInfo.InvariantCulture)</span>
                            <small>@dayInfo.AlternateDay.ToString(CultureInfo.InvariantCulture)</small>
                        </button>
                    }
                }
            </div>

            @if (IncludeTime)
            {
                <div class="calendar-time border-top pt-2 mt-3">
                    <label class="small text-muted mb-2 d-block">
                        انتخاب زمان
                    </label>

                    <div class="d-flex gap-2 align-items-center justify-content-center">
                        <select class="form-select form-select-sm"
                                style="width: 75px;"
                                value="@hour12"
                                @onchange="OnHourChanged">
                            @for (var h = 1; h <= 12; h++)
                            {
                                <option value="@h">@h.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>

                        <span>:</span>

                        <select class="form-select form-select-sm"
                                style="width: 75px;"
                                value="@minute"
                                @onchange="OnMinuteChanged">
                            @for (var m = 0; m <= 59; m++)
                            {
                                <option value="@m">@m.ToString("00", CultureInfo.InvariantCulture)</option>
                            }
                        </select>

                        <select class="form-select form-select-sm"
                                style="width: 85px;"
                                value="@amPm"
                                @onchange="OnAmPmChanged">
                            <option value="AM">AM</option>
                            <option value="PM">PM</option>
                        </select>
                    </div>
                </div>
            }

            <div class="calendar-footer">
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        disabled="@(!IsSelectable(DateTime.Today))"
                        @onclick="SelectToday">
                    امروز
                </button>

                <button type="button"
                        class="btn btn-sm btn-primary"
                        @onclick="CloseCalendar">
                    تأیید
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime Value { get; set; }

    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }

    [Parameter] public bool IncludeTime { get; set; } = false;

    [Parameter] public string CssClass { get; set; } = "form-control";

    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ شمسی یا میلادی";

    [Parameter] public bool AllowEmpty { get; set; } = false;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }

    private readonly PersianCalendar persianCalendar = new();

    private bool showCalendar = false;
    private bool gregorianMode;

    private int viewYear;
    private int viewMonth;

    private int selectedPersianYear;
    private int selectedPersianMonth;
    private int selectedPersianDay;

    private int hour12 = 12;
    private int minute = 0;
    private string amPm = "AM";

    private string displayText = string.Empty;

    private static readonly string[] MonthNames =
    {
        "حمل",
        "ثور",
        "جوزا",
        "سرطان",
        "اسد",
        "سنبله",
        "میزان",
        "عقرب",
        "قوس",
        "جدی",
        "دلو",
        "حوت"
    };

    private IReadOnlyList<DualCalendarDay> CalendarDays => DualCalendarDateHelper.MonthDays(viewYear, viewMonth, gregorianMode);
    private DateTime ViewFirstDay => DualCalendarDateHelper.FirstDay(viewYear, viewMonth, gregorianMode);
    private string MonthEquivalent
    {
        get
        {
            var days = CalendarDays.Where(x => x.Date.HasValue).ToArray();
            var first = days[0].Date!.Value;
            var last = days[^1].Date!.Value;
            return gregorianMode
                ? $"{DualCalendarDateHelper.PersianText(first)} — {DualCalendarDateHelper.PersianText(last)}"
                : $"{DualCalendarDateHelper.GregorianText(first)} — {DualCalendarDateHelper.GregorianText(last)}";
        }
    }

    protected override void OnParametersSet()
    {
        var date = Value == DateTime.MinValue ? DateTime.Now : DualCalendarDateHelper.LocalDate(Value);

        selectedPersianYear = persianCalendar.GetYear(date);
        selectedPersianMonth = persianCalendar.GetMonth(date);
        selectedPersianDay = persianCalendar.GetDayOfMonth(date);

        if (viewYear == 0 || viewMonth == 0)
        {
            viewYear = selectedPersianYear;
            viewMonth = selectedPersianMonth;
        }

        SetTimeFromValue(date);
        displayText = Value == DateTime.MinValue
            ? string.Empty
            : FormatDisplayText(date);
    }

    private void OpenCalendar()
    {
        if (Disabled) return;
        SetView(Value == DateTime.MinValue ? DateTime.Now : DualCalendarDateHelper.LocalDate(Value));
        showCalendar = true;
    }

    private void CloseCalendar()
    {
        showCalendar = false;
    }

    private async Task ClearDate()
    {
        if (Disabled) return;
        showCalendar = false;
        displayText = string.Empty;
        await ValueChanged.InvokeAsync(DateTime.MinValue);
    }

    private async Task SelectToday()
    {
        var today = DateTime.Now;

        SetView(today);

        SetTimeFromValue(today);

        await SelectPersianDate(
            persianCalendar.GetYear(today),
            persianCalendar.GetMonth(today),
            persianCalendar.GetDayOfMonth(today));
    }

    private async Task SelectDay(DateTime date)
    {
        if (!IsSelectable(date)) return;
        await SelectPersianDate(persianCalendar.GetYear(date), persianCalendar.GetMonth(date), persianCalendar.GetDayOfMonth(date));

        if (!IncludeTime)
        {
            showCalendar = false;
        }
    }

    private async Task SelectPersianDate(int year, int month, int day)
    {
        var selectedDate = BuildSelectedDate(year, month, day);
        if (!IsSelectable(selectedDate)) return;

        selectedPersianYear = year;
        selectedPersianMonth = month;
        selectedPersianDay = day;

        UpdateDisplayText(selectedDate);

        await ValueChanged.InvokeAsync(selectedDate);
    }

    private void PreviousMonth()
    {
        ShiftMonth(-1);
    }

    private void NextMonth()
    {
        ShiftMonth(1);
    }

    private void ChangeCalendar(bool gregorian)
    {
        if (gregorian == gregorianMode) return;
        var anchor = ViewFirstDay;
        if (Value != DateTime.MinValue)
        {
            var selected = DualCalendarDateHelper.LocalDate(Value);
            if (gregorianMode ? selected.Year == viewYear && selected.Month == viewMonth
                : persianCalendar.GetYear(selected) == viewYear && persianCalendar.GetMonth(selected) == viewMonth)
                anchor = selected;
        }
        gregorianMode = gregorian;
        SetView(anchor);
        displayText = Value == DateTime.MinValue ? string.Empty : FormatDisplayText(Value);
    }

    private void SetView(DateTime date)
    {
        viewYear = gregorianMode ? date.Year : persianCalendar.GetYear(date);
        viewMonth = gregorianMode ? date.Month : persianCalendar.GetMonth(date);
    }

    private void ShiftMonth(int direction)
    {
        try { SetView(gregorianMode ? ViewFirstDay.AddMonths(direction) : persianCalendar.AddMonths(ViewFirstDay, direction)); }
        catch (ArgumentOutOfRangeException) { }
    }

    private bool IsSelectable(DateTime date) => !Disabled &&
        (!MinDate.HasValue || date.Date >= MinDate.Value.Date) && (!MaxDate.HasValue || date.Date <= MaxDate.Value.Date);

    private string GetDayCss(DateTime date) =>
        (Value != DateTime.MinValue && date.Date == DualCalendarDateHelper.LocalDate(Value).Date ? " selected" : "") +
        (date.Date == DateTime.Today ? " today" : "");

    private void SetTimeFromValue(DateTime date)
    {
        var hour = date.Hour;

        amPm = hour >= 12 ? "PM" : "AM";

        hour12 = hour % 12;

        if (hour12 == 0)
            hour12 = 12;

        minute = date.Minute;
    }

    private DateTime BuildSelectedDate(int year, int month, int day)
    {
        var hour24 = ConvertTo24Hour(hour12, amPm);

        return persianCalendar.ToDateTime(
            year,
            month,
            day,
            IncludeTime ? hour24 : 0,
            IncludeTime ? minute : 0,
            0,
            0);
    }

    private async Task UpdateSelectedDateWithTime()
    {
        if (selectedPersianYear <= 0 ||
            selectedPersianMonth <= 0 ||
            selectedPersianDay <= 0)
        {
            return;
        }

        var selectedDate = BuildSelectedDate(
            selectedPersianYear,
            selectedPersianMonth,
            selectedPersianDay);
        if (!IsSelectable(selectedDate)) return;

        UpdateDisplayText(selectedDate);

        await ValueChanged.InvokeAsync(selectedDate);
    }

    private async Task OnHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            hour12 = value;
            await UpdateSelectedDateWithTime();
        }
    }

    private async Task OnMinuteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            minute = value;
            await UpdateSelectedDateWithTime();
        }
    }

    private async Task OnAmPmChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (value == "AM" || value == "PM")
        {
            amPm = value;
            await UpdateSelectedDateWithTime();
        }
    }

    private void UpdateDisplayText(DateTime date)
    {
        displayText = FormatDisplayText(date);
    }

    private string FormatDisplayText(DateTime date)
    {
        return gregorianMode ? DualCalendarDateHelper.GregorianText(date, IncludeTime)
            : DualCalendarDateHelper.PersianText(date, IncludeTime);
    }

    private static int ConvertTo24Hour(int hour, string period)
    {
        if (period == "AM")
        {
            return hour == 12 ? 0 : hour;
        }

        return hour == 12 ? 12 : hour + 12;
    }

}
