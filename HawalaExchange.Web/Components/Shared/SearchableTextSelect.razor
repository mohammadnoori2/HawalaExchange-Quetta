<div class="searchable-dropdown">
    <div class="searchable-dropdown-input" @onclick="Open">
        <input type="text"
               class="@CssClass"
               value="@DisplayText"
               placeholder="@Placeholder"
               autocomplete="off"
               disabled="@Disabled"
               @oninput="HandleInputAsync"
               @onfocus="Open"
               @onblur="Close"
               @onkeydown="HandleKeyDownAsync"
               @onkeydown:stopPropagation="true" />
    </div>

    @if (isOpen && !Disabled)
    {
        <div class="searchable-dropdown-menu">
            @if (AllowClear)
            {
                <button type="button"
                        class="searchable-dropdown-item searchable-dropdown-clear"
                        @onmousedown:preventDefault="true"
                        @onclick="ClearAsync">
                    <i class="bi bi-x-circle me-1"></i>
                    @ClearText
                </button>
            }

            @if (!MatchingItems.Any())
            {
                <div class="searchable-dropdown-item text-muted">موردی یافت نشد</div>
            }
            else
            {
                @foreach (var item in MatchingItems.Take(MaxResults))
                {
                    <button type="button"
                            class="searchable-dropdown-item"
                            @onmousedown:preventDefault="true"
                            @onclick="() => SelectAsync(item)">
                        @item
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<string>? Items { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "جستجو...";
    [Parameter] public string CssClass { get; set; } = "form-control";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public string ClearText { get; set; } = "همه موارد";
    [Parameter] public int MaxResults { get; set; } = 30;

    private string searchText = string.Empty;
    private bool isOpen;
    private bool hasObservedValue;
    private string lastObservedValue = string.Empty;

    private IEnumerable<string> MatchingItems =>
        (Items ?? Array.Empty<string>())
            .Where(item => string.IsNullOrWhiteSpace(searchText) ||
                           item.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private string DisplayText =>
        !string.IsNullOrWhiteSpace(searchText) ? searchText : Value;

    private void Open()
    {
        if (!Disabled)
            isOpen = true;
    }

    private void Close()
    {
        searchText = string.Empty;
        isOpen = false;
    }

    protected override void OnParametersSet()
    {
        if (!hasObservedValue)
        {
            lastObservedValue = Value;
            hasObservedValue = true;
            return;
        }

        if (string.Equals(lastObservedValue, Value, StringComparison.Ordinal))
            return;

        lastObservedValue = Value;
        searchText = string.Empty;
        isOpen = false;
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        isOpen = true;

        if (!string.IsNullOrEmpty(Value))
        {
            Value = string.Empty;
            lastObservedValue = string.Empty;
            await ValueChanged.InvokeAsync(string.Empty);
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            isOpen = false;
            return;
        }

        if (args.Key != "Enter")
            return;

        var matches = MatchingItems.Take(2).ToList();
        if (matches.Count == 1)
            await SelectAsync(matches[0]);
    }

    private async Task SelectAsync(string item)
    {
        Value = item;
        lastObservedValue = item;
        searchText = string.Empty;
        isOpen = false;
        await ValueChanged.InvokeAsync(item);
    }

    private async Task ClearAsync()
    {
        Value = string.Empty;
        lastObservedValue = string.Empty;
        searchText = string.Empty;
        isOpen = false;
        await ValueChanged.InvokeAsync(string.Empty);
    }
}
