<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <base href="/" />
    <link rel="stylesheet" href="/assets/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="/assets/styles/app.css" />
    <link rel="stylesheet" href="/preview-fields.css" />
    <style>
        @@font-face{font-family:PickerPreview;src:url('/assets/fonts/Vazirmatn-Regular.ttf') format('truetype');font-display:swap}
        body,input,select,button{font-family:PickerPreview,Tahoma,sans-serif!important}
        .picker-demo{max-width:850px;margin:32px auto;padding:0 16px}
        .picker-demo h1{font-size:1.5rem}.picker-demo p{color:var(--app-muted)}
        .picker-demo section{background:white;border:1px solid var(--app-border);border-radius:12px;padding:20px;margin:20px 0}
        .demo-values{background:var(--app-primary-soft);padding:12px;border-radius:8px;font-size:13px}
        .demo-values span{display:block}.demo-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
        .demo-grid label{display:block;margin-bottom:6px}.demo-grid small{display:block;margin-top:8px;color:var(--app-muted)}
        .calendar-month-year .form-select{border-color:var(--app-border)}
        .date-picker-icon{color:var(--app-primary)}
        .date-picker-calendar:empty::before{content:'▦';font-size:19px}.date-picker-calendar::after{content:'▦';font-size:19px}
        .date-picker-clear::after{content:'×';font-size:19px}
        .calendar-header>button::after{font-size:20px;line-height:1}.calendar-header>button:first-child::after{content:'›'}.calendar-header>button:last-child::after{content:'‹'}
        .demo-dialog{border:1px solid var(--app-border);border-radius:12px;width:min(95vw,620px);max-height:90dvh;overflow:auto;background:white;padding:20px}
        @@media(max-width:600px){.demo-grid{grid-template-columns:1fr}.picker-demo{margin-top:20px}.picker-demo section{padding:16px}}
    </style>
    <HeadOutlet />
</head>
<body><PreviewRoutes @rendermode="InteractiveServer" /><script src="/preview-forms.js"></script><script src="_framework/blazor.web.js"></script></body>
</html>
